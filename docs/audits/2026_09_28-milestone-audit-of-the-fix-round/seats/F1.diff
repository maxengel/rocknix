index 0000000000..71d8838556
--- /dev/null
+++ b/projects/ROCKNIX/packages/hardware/quirks/platforms/GENERIC_X64/097-retired-rescue-masks
@@ -0,0 +1,35 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+### Takes back, once, the rescue and emergency masks an earlier quirk set.
+#
+# Until 2026-09, 097-disable-rescue-completely ran `systemctl mask` on
+# rescue.target, emergency.target, rescue.service and emergency.service at
+# every boot. systemctl writes a mask into this image's unit directory,
+# /storage/.config/system.d, so the masks outlived the quirk, and a boot whose
+# local filesystems fail stops with no emergency target to reach -- the
+# behaviour every other ROCKNIX device keeps. (Its stub targets under /lib
+# never existed: /lib is the read-only image.) Only a mask -- a link to
+# /dev/null -- is removed; a unit of somebody's own under one of these names
+# is theirs. It runs until the four are gone, says on the journal what it
+# unmasked, and then stops for good (STAMP): a mask somebody makes afterwards
+# is theirs. (A downgrade to a build that still has the old quirk masks them
+# again, and they then stay; remove STAMP to take them back once more.)
+STAMP=/storage/.cache/retired-rescue-masks
+[ -e "${STAMP}" ] && exit 0
+D=/storage/.config/system.d
+masked() { [ -L "${D}/${1}" ] && [ "$(readlink "${D}/${1}")" = /dev/null ]; }
+GONE=""
+for unit in rescue.target emergency.target rescue.service emergency.service; do
+  if masked "${unit}"; then
+    rm -f "${D}/${unit}"
+    masked "${unit}" || GONE="${GONE} ${unit}"
+  fi
+done
+[ -n "${GONE}" ] && echo "097-retired-rescue-masks: unmasked what an earlier build masked:${GONE}" >&2
+for unit in rescue.target emergency.target rescue.service emergency.service; do
+  masked "${unit}" && exit 0
+done
+mkdir -p "${STAMP%/*}" && echo "the rescue and emergency masks an earlier build set were taken back" > "${STAMP}"
+exit 0
diff --git a/tools/last-good-scripts-test b/tools/last-good-scripts-test
index 15d2cf4550..e8223ae9d6 100755
--- a/tools/last-good-scripts-test
+++ b/tools/last-good-scripts-test
@@ -3011,4 +3011,608 @@ ckf() { # ckf <raw bytes> <exe> <CORE_MIN_FREE_KB>
 ckf 65536 retroarch $(( XFREE - 512 )); printf '%s' "${NOTE}" | grep '^dump' | grep -q 'NOT KEPT' && printf '%s' "${NOTE}" | grep '^dump' | grep -q 'plus the 1048576 byte cap'; check $? "with free space above the floor but under the floor plus the cap, the dump is refused and the note names both (audit #258, the seat's G-03; the old test admitted it)" "free ${XFREE} KB; note: $(printf '%s' "${NOTE}" | grep '^dump' | cut -c1-140)"
