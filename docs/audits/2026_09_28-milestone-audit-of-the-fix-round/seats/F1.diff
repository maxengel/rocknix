-ExecStart=/bin/true
-RemainAfterExit=yes
-
-[Install]
-WantedBy=multi-user.target
-EOF
-
-# Fix 2: Create robust journald configuration for GENERIC_X64
-mkdir -p /etc/systemd/journald.conf.d
-
-cat <<EOF >/etc/systemd/journald.conf.d/00-generic-x64-base.conf
-[Journal]
-# Base configuration for GENERIC_X64
-Storage=persistent
-Compress=no
-Seal=no
-SplitMode=none
-
-# Prevent EPOLLHUP errors by using conservative limits
-SystemMaxUse=32M
-SystemKeepFree=64M
-SystemMaxFileSize=4M
-RuntimeMaxUse=16M
-RuntimeKeepFree=32M
-RuntimeMaxFileSize=2M
