+#      record -- the one line an earlier build wrote); anything else is
+#      somebody's and stays.
+F1H="${F1}/h"; mkdir -p "${F1H}/q"
+src_of "${F1_QREL}/platforms/GENERIC_X64/095-cloud-ssh" "${F1H}/q/095-cloud-ssh"
+f1_sys "${F1H}/p10022"; f1_sys "${F1H}/p10023"; printf '10023' > "${F1H}/p10023/firmware/qemu_fw_cfg/by_name/opt/org.rocknix.cloud_ssh_port/raw"
+f1_sys "${F1H}/none"; rm -rf "${F1H}/none/firmware/qemu_fw_cfg"
+# An mv that dies with the quirk right after it puts cloud_setup_ssh in
+# place: a boot cut short between the command and its record (the audit's
+# G-F1-04). Every other mv passes through.
+mkdir -p "${F1H}/killmv"
+cat > "${F1H}/killmv/mv" <<'EOS'
+#!/bin/bash
+for a in "$@"; do last="$a"; done
+if [ -x /lgst/busybox ]; then /lgst/busybox mv "$@"; else /usr/bin/mv "$@"; fi; rc=$?
+[ "${last##*/}" = cloud_setup_ssh ] && kill -9 "${PPID}"
+exit "${rc}"
+EOS
+chmod +x "${F1H}/killmv/mv"
+f1_ssh() { # <storage> <sys> [kill]: one boot's run of the quirk
+    local kill=(); [ "${3:-}" = kill ] && kill=(--ro-bind "${F1H}/killmv" /shim)
+    bwrap --die-with-parent --tmpfs / --ro-bind /usr /usr "${F1BB[@]}" "${kill[@]}" \
+        --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
+        --bind "${1}" /storage --ro-bind "${2}" /sys --ro-bind "${F1H}/q" /q \
+        --tmpfs /run --tmpfs /tmp --dev /dev --proc /proc --setenv PATH "${F1PATH}" \
+        bash /q/095-cloud-ssh > "${F1H}/out" 2>&1
+}
+F1_GEN="ssh -L 53682:localhost:53682 -p 10022 root@127.0.0.1"; F1_HAND="ssh -p 2222 root@192.168.64.5"
+f1_ov() { cat "${1}/.config/cloud_setup_ssh" 2>/dev/null || echo "(no file)"; }
+f1_storage "${F1H}/a"; f1_ssh "${F1H}/a" "${F1H}/p10022"
+[ "$(f1_ov "${F1H}/a")" = "${F1_GEN}" ]; check $? "with the forwarded port on fw_cfg the guest gets the loopback command" "the override: $(f1_ov "${F1H}/a"); $(head -c 120 "${F1H}/out")"
+f1_ssh "${F1H}/a" "${F1H}/p10023"; F1_S1=$(f1_ov "${F1H}/a"); f1_ssh "${F1H}/a" "${F1H}/none"
+[ "${F1_S1}" = "${F1_GEN/10022/10023}" ] && [ "$(f1_ov "${F1H}/a")" = "(no file)" ]; check $? "and its own command follows the port, and goes when fw_cfg carries none" "port 10023: ${F1_S1}; no port: $(f1_ov "${F1H}/a")"
+f1_storage "${F1H}/b"; echo "${F1_HAND}" > "${F1H}/b/.config/cloud_setup_ssh"; f1_ssh "${F1H}/b" "${F1H}/p10022"; F1_S2=$(f1_ov "${F1H}/b"); f1_ssh "${F1H}/b" "${F1H}/none"
+[ "${F1_S2}" = "${F1_HAND}" ] && [ "$(f1_ov "${F1H}/b")" = "${F1_HAND}" ]
+check $? "a command written by hand survives a boot with the port on fw_cfg and one without (the README's manual fallback)" "the hand-written '${F1_HAND}' became '${F1_S2}' with the port and '$(f1_ov "${F1H}/b")' without"
+f1_storage "${F1H}/c"; f1_ssh "${F1H}/c" "${F1H}/p10022"; echo "${F1_HAND}" > "${F1H}/c/.config/cloud_setup_ssh"; f1_ssh "${F1H}/c" "${F1H}/p10022"
+[ "$(f1_ov "${F1H}/c")" = "${F1_HAND}" ]; check $? "and so does one written over the quirk's own command" "the quirk's command, then a hand edit: '$(f1_ov "${F1H}/c")' after a boot"
+# Already written: an earlier build's command has no record, and its shape
+# is one a tester may write by hand (the audit's G-F1-03). With no record,
+# the file is taken only when it is exactly the command this boot writes --
+# taking it changes nothing now, and the record starts; then it follows the
+# port. A loopback command on another port, or with no port on fw_cfg, is
+# left as somebody's.
+f1_storage "${F1H}/d"; echo "${F1_GEN}" > "${F1H}/d/.config/cloud_setup_ssh"; f1_ssh "${F1H}/d" "${F1H}/p10022"; f1_ssh "${F1H}/d" "${F1H}/p10023"; F1_S3=$(f1_ov "${F1H}/d")
+[ "${F1_S3}" = "${F1_GEN/10022/10023}" ]; check $? "an earlier build's unrecorded command, met on its own port, is taken and then follows the port" "the unrecorded 10022 command after a 10022 boot and a 10023 boot: ${F1_S3}"
+F1_OWN="ssh -L 53682:localhost:53682 -p 2222 root@127.0.0.1"
+f1_storage "${F1H}/e"; echo "${F1_OWN}" > "${F1H}/e/.config/cloud_setup_ssh"; f1_ssh "${F1H}/e" "${F1H}/p10022"; F1_S4=$(f1_ov "${F1H}/e"); f1_ssh "${F1H}/e" "${F1H}/none"
+[ "${F1_S4}" = "${F1_OWN}" ] && [ "$(f1_ov "${F1H}/e")" = "${F1_OWN}" ]
+check $? "a loopback command a tester wrote for a forward of their own survives a boot with a port and one without (the audit's G-F1-03)" "the tester's '-p 2222 root@127.0.0.1' became '${F1_S4}' with port 10022 and '$(f1_ov "${F1H}/e")' without"
+# fw_cfg's value is a port or it is not one: six digits are refused, not
+# cut to five (the audit's G-F1-07 on the gpt side, G-F1-06 on the claude
+# side).
+f1_sys "${F1H}/p6"; printf '100000' > "${F1H}/p6/firmware/qemu_fw_cfg/by_name/opt/org.rocknix.cloud_ssh_port/raw"
+f1_storage "${F1H}/g"; f1_ssh "${F1H}/g" "${F1H}/p6"
+[ "$(f1_ov "${F1H}/g")" = "(no file)" ]; check $? "a six-digit fw_cfg port is refused, not cut to five digits (the audit's G-F1-07)" "fw_cfg 100000 gave: $(f1_ov "${F1H}/g")"
+# A boot cut short right after the new command is in place leaves the next
+# boot still knowing the command is the quirk's (the audit's G-F1-04).
+f1_storage "${F1H}/k"; f1_ssh "${F1H}/k" "${F1H}/p10022"; f1_ssh "${F1H}/k" "${F1H}/p10023" kill; F1_S5=$(f1_ov "${F1H}/k"); f1_ssh "${F1H}/k" "${F1H}/none"
+[ "${F1_S5}" = "${F1_GEN/10022/10023}" ] && [ "$(f1_ov "${F1H}/k")" = "(no file)" ]
+check $? "a boot killed right after it put a new command in place leaves it the quirk's: the next boot without a port removes it (the audit's G-F1-04)" "killed after the 10023 write: '${F1_S5}'; the next boot with no port: '$(f1_ov "${F1H}/k")'"
+f1_storage "${F1H}/f"; f1_ssh "${F1H}/f" "${F1H}/p10022"; F1_F0=$(cd "${F1H}/f/.config" && ls -A | LC_ALL=C sort | xargs sha256sum 2>/dev/null); f1_ssh "${F1H}/f" "${F1H}/p10022"
+[ "${F1_F0}" = "$(cd "${F1H}/f/.config" && ls -A | LC_ALL=C sort | xargs sha256sum 2>/dev/null)" ] && [ ! -s "${F1H}/out" ]; check $? "a second boot on the same port changes nothing and says nothing" "a second boot changed /storage/.config or said: $(head -c 160 "${F1H}/out")"
+
+# F1i. #308 claude F-VM-08 and F-VM-16: the GENERIC_X64 emulator configs the
+#      image installs carried other devices' hardware. (Cemu, RPCS3, xemu,
+#      Dolphin and Supermodel, the rest the seats named, are not in the
+#      GENERIC_X64 SYSTEM at 7911c53bb4.)
+F1I="${F1}/i"; mkdir -p "${F1I}"; F1EMU=projects/ROCKNIX/packages/emulators/standalone
+# mupen64plus: [Input-SDL-Control1] named SM8250's pad. Under mode = 2
+# (fully automatic) input-sdl never looks the name up -- it compares it in
+# mode 1 only -- and writes "" itself when no pad is found, so "" is the
+# value the file means.
+src_of "${F1EMU}/mupen64plus-sa/mupen64plus-sa-core/config/GENERIC_X64/mupen64plus.cfg" "${F1I}/mupen64plus.cfg"
+F1_M64N=$(awk '/^\[/{s=$0} s=="[Input-SDL-Control1]" && /^name = /{print; exit}' "${F1I}/mupen64plus.cfg")
+[ "${F1_M64N}" = 'name = ""' ]; check $? "mupen64plus's Control1 names no handheld's pad: name = \"\", what mode 2 writes itself (#308 claude F-VM-08)" "mupen64plus's Control1: ${F1_M64N:-no name line}"
+# flycast: [window] carried a 1080p handheld's 1920x1080. On this build
+# (USE_GLES off) fullscreen is SDL's desktop fullscreen, which takes the
+# output's size, so the numbers only ever sized a window nobody opens; the
+# window keeps fullscreen and loses the handheld's size.
+src_of "${F1EMU}/flycast-sa/config/GENERIC_X64/emu.cfg" "${F1I}/emu.cfg"
+F1_FW=$(awk '/^\[/{s=$0} s=="[window]" && /^(width|height) = /' "${F1I}/emu.cfg" | tr '\n' ' ')
+[ -z "${F1_FW}" ] && awk '/^\[/{s=$0} s=="[window]" && $0=="fullscreen = yes"{f=1} END{exit !f}' "${F1I}/emu.cfg"
+check $? "flycast's [window] keeps fullscreen and carries no handheld's 1920x1080 (#308 claude F-VM-16)" "flycast's [window]: ${F1_FW:-no size}, fullscreen $(grep -c '^fullscreen = yes$' "${F1I}/emu.cfg")"
+# m8c: the Anbernic INIs are chosen by QUIRK_DEVICE (the model the device
+# reports), which no x86_64 machine reports; GENERIC_X64 ships config.ini.
+F1M8=projects/ROCKNIX/packages/apps/m8c/config/GENERIC_X64
+if [ "${OLD}" -eq 1 ]; then F1_M8=$(git -C "${ROOT}" ls-tree --name-only "${BASE_REF}:${F1M8}" 2>/dev/null | tr '\n' '|')
+else F1_M8=$(ls -1 "${ROOT}/${F1M8}" 2>/dev/null | tr '\n' '|'); fi
+[ "${F1_M8}" = "config.ini|" ]; check $? "m8c's GENERIC_X64 config is config.ini alone, no pad file for an Anbernic model (#308 claude F-VM-08)" "m8c's GENERIC_X64 config: ${F1_M8}"
+
+# F1j. #307 PL-076: the x64 RetroArch profile carried the armhf buildbot as
+#      core_updater_buildbot_url, a key the pinned RetroArch (1.22.2) does
+#      not read -- it reads core_updater_buildbot_cores_url, which the
+#      profile sets to "". The dead line goes.
+src_of "${F1RA:-projects/ROCKNIX/packages/emulators/libretro/retroarch/sources/GENERIC_X64/retroarch.cfg}" "${F1}/retroarch-076.cfg"
+! grep -q '^core_updater_buildbot_url' "${F1}/retroarch-076.cfg"; check $? "the GENERIC_X64 RetroArch profile carries no core_updater_buildbot_url, a key RetroArch does not read (#307 PL-076)" "the GENERIC_X64 profile still carries $(grep '^core_updater_buildbot_url' "${F1}/retroarch-076.cfg")"
+
 if [ "${FAIL}" -eq 0 ]; then echo "PASSED"; exit 0; else echo "${FAIL} CHECK(S) FAILED"; exit 1; fi
