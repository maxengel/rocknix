+# Started means listening: Type=simple counts the service up the moment its
+# process forks, seconds before Python has bound the port on a handheld, and
+# enable routes the emulators to it as soon as `systemctl start` returns; a
+# launch meeting a refused connection loses achievements for its session.
+# Bounded at thirty looks a second apart; a proxy that never listens fails
+# the start, and enable puts the device back as it was (#308 F-RA-26).
+ExecStartPost=/usr/bin/raofflineproxy-ctl listening --wait 30
 Restart=on-failure
 RestartSec=5
 TimeoutStopSec=15
-StartLimitInterval=60
-StartLimitBurst=5
 
 [Install]
 WantedBy=multi-user.target
