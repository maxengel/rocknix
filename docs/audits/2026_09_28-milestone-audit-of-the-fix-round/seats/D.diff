+++ b/projects/ROCKNIX/packages/network/raofflineproxy/system.d/raofflineproxy.service
@@ -9,10 +9,19 @@ ConditionPathExists=/storage/.cache/services/raofflineproxy.conf
 # interface list and system.cfg to be in place. network-base.service by name,
 # as avahi does: network.target does not order after the units wanted by it.
 After=network.target network-base.service rocknix-sysconfig.service
-# Up before a game can be launched, so an emulator's first RetroAchievements
-# call finds the port listening rather than refused -- a refused connection
-# makes rcheevos disable achievements for the whole session.
+# Up -- listening, through ExecStartPost below -- before a game can be
+# launched, so an emulator's first RetroAchievements call finds the port
+# listening rather than refused: a refused connection makes rcheevos disable
+# achievements for the whole session.
 Before=emustation.service essway.service
+# Five starts, then no more: in [Unit], where systemd has read the start
+# limit since 230 (#308 F-RA-20). A failed start lasts the readiness wait
+# (ExecStartPost, 30 s) and RestartSec (5 s), so the interval has to hold
+# five of them -- at sixty seconds no more than two fit, the limit never
+# tripped, and a proxy that could never listen restarted for ever (audit of
+# the fixes, claude G-D-05). 5 x 35 = 175; three hundred leaves room.
+StartLimitIntervalSec=300
+StartLimitBurst=5
 
 [Service]
 Type=simple
@@ -22,11 +31,16 @@ Environment=XDG_CONFIG_HOME=/storage/.config
 # Measured upstream on a 103 MB device: 32 -> 19 MB RSS.
