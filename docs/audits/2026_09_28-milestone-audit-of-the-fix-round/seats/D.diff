+DCFG_ON='system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\nglobal.retroachievements.username=QA\nglobal.retroachievements.token=FIXTURETOKEN\n'
+# A run of the ctl in the background, as the interface starts one: stdout and
+# stderr to ${DD}/bg.out and bg.err, the exit code to bg.rc when it ends.
+dbg() { # <verb...>
+    rm -f "${DD}/bg.rc"
+    ( bwrap --die-with-parent --tmpfs / --tmpfs /usr "${USR_BINDS[@]}" "${TBB[@]}" \
+        --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
+        --ro-bind /etc /etc --ro-bind "${T}/profile" /etc/profile \
+        --bind "${TS}" /storage --ro-bind "${T}/repo" /repo --ro-bind "${T}/shim" /shim --ro-bind "${CLIENT}" /client --ro-bind "${T}/pypath" /pypath \
+        --bind "${TR}" /run --tmpfs /var --bind "${T}/varrun" /var/run \
+        --dev /dev --proc /proc --tmpfs /tmp --setenv PYTHONPATH /client:/pypath "${TENV[@]}" \
+        bash /repo/raofflineproxy-ctl "$@" > "${DD}/bg.out" 2> "${DD}/bg.err"; echo $? > "${DD}/bg.rc" ) &
