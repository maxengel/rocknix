+# F2-13. #308 4-backup-restore claude F-BR-10: packages/compress/zip, which
+# the fork restored on 2026-08-26 after upstream dropped it, is shadowed
+# since upstream reintroduced zip as projects/ROCKNIX/packages/compress/zip
+# (b289e35685): get_pkg_directory takes the project recipe, so the fork's
+# copy -- same steps, the same patch byte for byte -- is never built, only
+# hashed into zip's stamp. One recipe for zip, and it is the one built.
+echo "  F2-13. zip has one recipe, the one the build uses (#308 F-BR-10)"
+if [ "${OLD}" -eq 1 ]; then
+    F2_OUT="$(git -C "${ROOT}" ls-tree -r --name-only "${BASE_REF}" -- packages projects | grep -c '/zip/package\.mk$')"
+else
