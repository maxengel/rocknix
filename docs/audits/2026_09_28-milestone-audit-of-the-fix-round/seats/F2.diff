+# ---- audit #307, stream F2 ----
+# Stream F2's cases: the recipes, the RetroArch patches and the rotation-table
+# generators (#307 PL-002, PL-032, PL-043; #308's rows in those files). Every
+# case reads its files through src_of, so under
+#     BASE_REF=417dcd8610 tools/last-good-scripts-test --old
+# they grade the tree the audit read: 37 checks FAIL there, every case at
+# least once, and the six that PASS both ways are the controls (a stamp that
+# must not move, a payload that must be kept, the tree still compiling).
+F2="${TMP}/f2"; mkdir -p "${F2}"
+F2_LR=projects/ROCKNIX/packages/emulators/libretro
+
+# F2-1. A shared rotation generator is part of the stamp of every core whose
+# table it writes (#307 PL-002). calculate_stamp is config/functions' own; the
+# two package-cache lookups answer from a fixture tree holding the five
+# recipes and the two generators as the tree has them. Editing a generator
+# must move the stamp of each core that runs it -- that is what makes
+# scripts/build rebuild the core -- and leave the other family's alone.
+echo "  F2-1. a rotation generator is in the build stamp of every core whose table it writes (#307 PL-002)"
+FX="${F2}/stamp"; FXR="${FX}/root"; mkdir -p "${FXR}/${F2_LR}"
+for p in fbalpha2012-lr fbalpha2019-lr fbneo-lr mame2003-plus-lr mame2010-lr; do
+    mkdir -p "${FXR}/${F2_LR}/${p}"; src_of "${F2_LR}/${p}/package.mk" "${FXR}/${F2_LR}/${p}/package.mk"
+done
+for g in rotation-table-fba.py rotation-table-mame.py; do src_of "${F2_LR}/${g}" "${FXR}/${F2_LR}/${g}"; done
+src_of config/functions "${FX}/functions"
+awk '/^calculate_stamp\(\) *\{/{p=1} p{print} p&&/^\}/{p=0}' "${FX}/functions" > "${FX}/calculate_stamp.sh"
+f2_stamp() { # <package>: the stamp scripts/build compares, from the recipe as source_package loads it
+    ( set +u; cd "${FXR}" || exit 1
+      ROOT="${FXR}"; PROJECT_DIR="${FXR}/projects"; PROJECT=ROCKNIX; DEVICE=H700; ARCH=aarch64; TARGET_ARCH=aarch64; TARGET_FPU=neon-fp-armv8
+      get_pkg_directory() { echo "${FXR}/${F2_LR}/${1%:*}"; }
