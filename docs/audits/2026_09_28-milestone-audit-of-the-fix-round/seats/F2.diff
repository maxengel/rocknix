+      PKG_DIR="${FXR}/${F2_LR}/${1}"
+      . "${PKG_DIR}/package.mk" >/dev/null 2>&1
+      . "${FX}/calculate_stamp.sh"
+      calculate_stamp ) 2>/dev/null
+}
+declare -A F2_S0
