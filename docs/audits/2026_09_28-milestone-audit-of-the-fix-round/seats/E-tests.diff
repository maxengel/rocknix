+    CloudLastRun exitRun; exitRun.ran = true; exitRun.when = 2000; exitRun.outcome = "COMPLETED";
+    gStamps["sync-manual"] = manual;
+    gStamps["sync-exit"] = exitRun;
+    const std::string why = cloudLastRunWhy("sync-manual");
+    int failures = 0;
