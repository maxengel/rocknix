+
+	const int rc = inChildWithin(5, [&] {
+		PidLock lock(lockPath);
+		return lock.acquire(300) ? 1 : 0;
+	});
+	CHECK(rc == 0);
+	CHECK(get(lockPath) == stale);   // not removed, not taken
+}
