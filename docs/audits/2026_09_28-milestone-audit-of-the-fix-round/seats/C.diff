+def fake_sysfs(d, key_codes, abs_codes, name="Test Pad"):
+    root = os.path.join(d, "sys-input")
+    dev = os.path.join(root, "event3", "device")
+    os.makedirs(os.path.join(dev, "capabilities"))
+
+    def words(codes):
+        top = max(codes) if codes else 0
+        out = []
+        for w in range(top // 64, -1, -1):
+            value = sum(1 << (c - w * 64) for c in codes if w * 64 <= c < (w + 1) * 64)
+            out.append("%x" % value)
+        return " ".join(out) + "\n"
+    with open(os.path.join(dev, "capabilities", "key"), "w") as h:
+        h.write(words(key_codes))
+    with open(os.path.join(dev, "capabilities", "abs"), "w") as h:
+        h.write(words(abs_codes))
+    with open(os.path.join(dev, "name"), "w") as h:
+        h.write(name + "\n")
+    return root
