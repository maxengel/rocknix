+cat > "${C3}/cloud_oauth_test.py" <<'EOPY'
+#!/usr/bin/env python3
+# cloud_oauth, graded in-process and as processes, inside a bwrap sandbox with
+# its own pid and network namespaces (so the /proc walks, the port binds and
+# the kills reach nothing outside it). No uinput, no sysfs, no sway: those are
+# patched per test.
+#
+#   cloud_oauth_test.py run <cloud_oauth> <workdir>     every test, P/F lines, END
+#   cloud_oauth_test.py drive <cloud_oauth> <workdir> <command...>
+#                                                       cloud_oauth's main() with
+#                                                       the sandbox patches
+import http.client
+import importlib.machinery
+import importlib.util
+import json as real_json
+import os
+import signal
+import socket
+import struct
+import subprocess
+import sys
+import tempfile
+import threading
+import time
+
+MODE, REPO, WORK = sys.argv[1], sys.argv[2], sys.argv[3]
+TESTS = []
+
+def test(fn):
+    TESTS.append(fn)
+    return fn
+
+def load(tag="t"):
+    """A fresh copy of the module, its paths pointed into the sandbox."""
+    loader = importlib.machinery.SourceFileLoader("cloud_oauth_" + tag, REPO)
+    spec = importlib.util.spec_from_loader(loader.name, loader)
+    m = importlib.util.module_from_spec(spec)
+    loader.exec_module(m)
+    d = tempfile.mkdtemp(dir=WORK, prefix=tag + ".")
+    m.STATE_DIR = os.path.join(d, "state")
+    os.makedirs(m.STATE_DIR)
+    m.LOG_FILE = os.path.join(d, "cloud_sync.log")
+    m.UINPUT = "/nonexistent/uinput"
+    return m, d
+
+def result(ok, good, bad):
+    print(("P " + good) if ok else ("F " + bad), flush=True)
+
+def completed(args, rc, out="", err=""):
+    return subprocess.CompletedProcess(args, rc, out, err)
+
+class FakeSP:
+    """subprocess, with run() answered by a table: (argv prefix) -> callable."""
+    PIPE, STDOUT, DEVNULL = subprocess.PIPE, subprocess.STDOUT, subprocess.DEVNULL
+    TimeoutExpired, SubprocessError = subprocess.TimeoutExpired, subprocess.SubprocessError
+    CompletedProcess = subprocess.CompletedProcess
+    Popen = subprocess.Popen
+
+    def __init__(self, answers):
+        self.answers = answers
+        self.calls = []
+
+    def run(self, args, **kw):
+        self.calls.append(list(args))
+        for prefix, answer in self.answers:
+            if list(args[1:1 + len(prefix)]) == list(prefix):
+                return answer(args)
+        return completed(args, 0)
+
+def log_text(m):
+    try:
+        return open(m.LOG_FILE).read()
+    except OSError:
+        return ""
+
+def pid_alive(pid):
+    try:
+        with open("/proc/%d/stat" % pid) as h:
+            return h.read().split(") ")[-1].split()[0] != "Z"
+    except OSError:
+        return False
+
+def wait_for(pred, seconds, step=0.1):
+    end = time.time() + seconds
+    while time.time() < end:
+        if pred():
+            return True
+        time.sleep(step)
+    return pred()
+
+def fake_authorize(script):
