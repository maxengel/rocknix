-case ",$ONLY," in *,scripts,*)    run_suite scripts    "$OUT/scripts.log"    "$ROOT/tools/last-good-scripts-test" ;; esac
+# The scripts harness carries cancel checks that send SIGINT to a run; a
+# background job (this runner under setsid -f, or a harness waiter) has
+# SIGINT ignored at entry, which a child shell cannot undo. Python can:
