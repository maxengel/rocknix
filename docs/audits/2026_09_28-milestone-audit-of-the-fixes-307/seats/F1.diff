-#!/bin/sh
-# SPDX-License-Identifier: GPL-2.0
-# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)
-#
-# In-place bootloader update for GENERIC_X64 (syslinux BIOS + GRUB UEFI on a
-# FAT/ESP boot partition). Every copy is guarded so a missing file is a no-op.
-
-[ -z "$SYSTEM_ROOT" ] && SYSTEM_ROOT=""
-[ -z "$BOOT_ROOT" ] && BOOT_ROOT="/flash"
-
-BL="$SYSTEM_ROOT/usr/share/bootloader"
-
-# mount $BOOT_ROOT rw
-mount -o remount,rw "$BOOT_ROOT"
-
-# syslinux (BIOS) support files at the FAT root
-for f in ldlinux.c32 ldlinux.sys libcom32.c32 libutil.c32; do
-  [ -f "$BL/$f" ] && echo "Updating $f..." && cp "$BL/$f" "$BOOT_ROOT/"
-done
-[ -f "$BL/syslinux.cfg" ] && echo "Updating syslinux.cfg..." && cp "$BL/syslinux.cfg" "$BOOT_ROOT/"
-
-# GRUB/syslinux UEFI loader + config on the ESP
-if [ -f "$BL/bootx64.efi" ] || [ -f "$BL/ldlinux.e64" ] || [ -f "$BL/grub.cfg" ]; then
-  mkdir -p "$BOOT_ROOT/EFI/BOOT"
-  [ -f "$BL/bootx64.efi" ] && echo "Updating UEFI loader..." && cp "$BL/bootx64.efi" "$BOOT_ROOT/EFI/BOOT/"
-  [ -f "$BL/ldlinux.e64" ] && cp "$BL/ldlinux.e64" "$BOOT_ROOT/EFI/BOOT/"
-  [ -f "$BL/grub.cfg" ] && echo "Updating grub.cfg..." && cp "$BL/grub.cfg" "$BOOT_ROOT/EFI/BOOT/"
-fi
-
-# mount $BOOT_ROOT ro
-sync
-mount -o remount,ro "$BOOT_ROOT"
-
-echo "UPDATE" > /storage/.boot.hint
diff --git a/projects/ROCKNIX/devices/GENERIC_X64/filesystem/usr/lib/systemd/system/serial-debug-shell.service b/projects/ROCKNIX/devices/GENERIC_X64/filesystem/usr/lib/systemd/system/serial-debug-shell.service
index 0ea3399475..1e08b193df 100644
--- a/projects/ROCKNIX/devices/GENERIC_X64/filesystem/usr/lib/systemd/system/serial-debug-shell.service
+++ b/projects/ROCKNIX/devices/GENERIC_X64/filesystem/usr/lib/systemd/system/serial-debug-shell.service
@@ -1,13 +1,26 @@
-# GENERIC_X64 is a VM/QA target: provide an autologin root shell on the
-# serial console (ttyS0, already on the kernel cmdline via EXTRA_CMDLINE) so
-# contributors can inspect boot/graphics state in QEMU/UTM/VirtualBox. ROCKNIX
-# strips all getty units, so this uses systemd's debug-shell pattern (a plain
-# /bin/sh bound to the tty) instead of a getty/login.
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+#
+# A root shell on the serial console, with no login: the developers' way into
+# a QA guest (tools/vm-serial; SSH is off on a fresh image). GENERIC_X64 is a
+# developer's tool and never a gameplay image (D-QA-053), and this unit is why
+# it must not become one unchanged. ROCKNIX strips every getty unit, so this is
+# systemd's debug-shell pattern -- a plain /bin/sh bound to the tty -- rather
+# than a getty and a login.
+#
+# It starts only on a virtual machine: ConditionVirtualization=vm has no |, so
+# it must hold as well as one of the console conditions (both always met here,
+# since EXTRA_CMDLINE puts console=ttyS0,115200 on every boot). GENERIC_X64
+# installed on hardware with a serial header does not open the shell.
 [Unit]
 Description=Serial debug root shell on ttyS0 (GENERIC_X64 VM testing)
 After=rocknix-automount.service
+ConditionVirtualization=vm
 ConditionKernelCommandLine=|console=ttyS0
 ConditionKernelCommandLine=|console=ttyS0,115200
+# A [Unit] key: the shell outlives an isolate (it sat under [Service] until
+# 2026-09, where systemd ignores it).
+IgnoreOnIsolate=yes
 
 [Service]
 Environment=TERM=vt100
@@ -23,7 +36,6 @@ TTYPath=/dev/ttyS0
 TTYReset=yes
 TTYVHangup=yes
 KillMode=process
-IgnoreOnIsolate=yes
 
 [Install]
 WantedBy=rocknix.target
