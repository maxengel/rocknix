-EOF
-
-# Create run-systemd-journal-stdout.mount
-cat <<EOF >/etc/systemd/system/run-systemd-journal-stdout.mount
-[Unit]
-Description=Runtime Directory for systemd journal stdout
-After=run-systemd-journal.mount
-Before=systemd-journald.service
-ConditionPathExists=!/run/systemd/journal/stdout
-
-[Mount]
