@@ -8,6 +8,10 @@
       x86_64)
         TARGET_KERNEL_ARCH="x86"
         TARGET_KERNEL_PATCH_ARCH="x86_64"
+        # x86-64-v3 (Haswell/Excavator or newer: AVX2, BMI2, FMA). The VM
+        # profile's CPU model is Haswell-v4 for this reason; an older CPU
