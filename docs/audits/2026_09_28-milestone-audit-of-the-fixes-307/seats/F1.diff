-
-# Create run-systemd-journal.mount
-cat <<EOF >/etc/systemd/system/run-systemd-journal.mount
-[Unit]
-Description=Runtime Directory for systemd journal
-Before=systemd-journald.service
-ConditionPathExists=!/run/systemd/journal
-
-[Mount]
