-d /run/systemd/journal 0755 root root - -
-d /run/systemd/journal/socket 0755 root root - -
-d /run/systemd/journal/stdout 0755 root root - -
-d /run/systemd/sessions 0755 root root - -
-d /run/systemd/users 0755 root root - -
-d /run/systemd/shutdown 0755 root root - -
