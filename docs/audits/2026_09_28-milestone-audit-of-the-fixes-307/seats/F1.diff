-DefaultDependencies=no
-
-[Service]
-Type=oneshot
-RemainAfterExit=yes
-ExecStart=/bin/sh -c 'mkdir -p /run/systemd/journal /run/systemd/sessions /run/systemd/users /run/systemd/shutdown /var/lib/systemd /var/lib/systemd/linger'
-ExecStart=/bin/sh -c 'chmod 755 /run/systemd/journal /run/systemd/sessions /run/systemd/users /run/systemd/shutdown /var/lib/systemd /var/lib/systemd/linger'
