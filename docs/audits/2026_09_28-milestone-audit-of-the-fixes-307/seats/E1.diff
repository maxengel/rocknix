+	// the saves and content parts finished this run and keep their outcome.
+	const std::vector<StampText> stamps = {
+		{ "last-backup",          "1789000040 0" },
+		{ "last-content-backup",  "1789000090 0" },
+		{ "last-settings-backup", "1789000120 130" },
