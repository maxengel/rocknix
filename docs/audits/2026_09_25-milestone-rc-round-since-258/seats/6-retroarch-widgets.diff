diff --git a/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0011-video-thread-wrapper-serialise-posters.patch b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0011-video-thread-wrapper-serialise-posters.patch
new file mode 100644
index 0000000000..604f302d0c
--- /dev/null
+++ b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0011-video-thread-wrapper-serialise-posters.patch
@@ -0,0 +1,80 @@
+From: Max Engel <max@awecelot.com>
+Date: Mon, 8 Sep 2026 05:10:00 +0000
+Subject: [PATCH] video_thread_wrapper: one poster at a time on the command mailbox
+
+The wrapper's command mailbox holds one packet (cmd_data / send_cmd /
+reply_cmd) and video_thread_wait_reply matches on the command *type*.
+Two threads posting the same type concurrently -- the main thread
+uploading an achievement badge (rcheevos_get_badge_texture ->
+gfx_display_reset_textures_list -> video_driver_texture_load ->
+video_thread_texture_handle) while the automatic-screenshot task reads
+the frame through the same wrapper -- wake each other: the second poster
+returns with the first's reply, its stack-allocated gl3_texture_cmd_t
+dies, and the video thread then executes a packet whose data pointer is
+into that dead frame. On an Anbernic RG35XX SP (H700, glcore, threaded
+video) RetroArch 1.22.2 segfaults in video_texture_load_wrap_gl3_mipmap
+at the instant an achievement unlocks with automatic screenshot on --
+three times in one evening, once with a core dump:
+
+    #0  video_texture_load_wrap_gl3_mipmap ()   ldr x0,[x0] with x0 = 0xffff00000002 (cmd->gl)
+    #1  video_thread_loop ()                    CMD_CUSTOM_COMMAND
+    #2  thread_wrap ()
+
+A mutex, user_lock, serialises posters: only one thread is inside
+send-and-wait at a time. The video thread never takes it, so a poster
+blocked on it cannot deadlock against the thread it waits for, and a
+thread cannot re-enter it while blocked in wait_reply. Every marshalled
+entry point in 1.22.2 goes through video_thread_send_and_wait_user_to_thread.
+
+--- a/gfx/video_thread_wrapper.h	2026-09-08 04:27:17.741913066 +0000
++++ b/gfx/video_thread_wrapper.h	2026-09-08 04:27:17.749330632 +0000
+@@ -173,6 +173,15 @@
+    retro_time_t last_time;
+ 
+    slock_t *lock;
++   /* Serialises the threads that post commands to the video thread.
++    * The command mailbox (cmd_data/send_cmd/reply_cmd) holds one packet,
++    * and wait_reply matches on the command type, so two threads posting
++    * the same type concurrently -- the main thread uploading an
++    * achievement badge while the screenshot task reads the frame -- wake
++    * each other and the video thread then runs a packet whose data
++    * pointer belongs to a caller that has already returned. Only one
++    * poster is inside send-and-wait at a time. */
++   slock_t *user_lock;
+    scond_t *cond_cmd;
+    scond_t *cond_thread;
+    sthread_t *thread;
+--- a/gfx/video_thread_wrapper.c	2026-09-08 04:27:17.741945545 +0000
++++ b/gfx/video_thread_wrapper.c	2026-09-08 04:27:17.749792421 +0000
+@@ -93,8 +93,14 @@
+ /* user -> thread */
+ static void video_thread_send_and_wait_user_to_thread(thread_video_t *thr, thread_packet_t *pkt)
+ {
++   /* One poster at a time: see user_lock in the header. Never taken by
++    * the video thread itself, so a poster blocked here cannot deadlock
++    * against the thread it is waiting for; a second poster waits for
++    * the first's reply to be consumed before its packet goes in. */
++   slock_lock(thr->user_lock);
+    video_thread_send_packet(thr, pkt);
+    video_thread_wait_reply(thr, pkt);
++   slock_unlock(thr->user_lock);
+ }
+ 
+ static void thread_update_driver_state(thread_video_t *thr)
+@@ -697,6 +703,8 @@
+ 
+    if (!(thr->lock        = slock_new()))
+       return false;
++   if (!(thr->user_lock   = slock_new()))
++      return false;
+    if (!(thr->alpha_lock  = slock_new()))
+       return false;
+    if (!(thr->frame.lock  = slock_new()))
+@@ -863,6 +871,7 @@
+ 
+       slock_free(thr->frame.lock);
+       slock_free(thr->alpha_lock);
++      slock_free(thr->user_lock);
+       slock_free(thr->lock);
+       scond_free(thr->cond_cmd);
+       scond_free(thr->cond_thread);
diff --git a/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0014-widgets-backdrop-follows-the-font.patch b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0014-widgets-backdrop-follows-the-font.patch
new file mode 100644
index 0000000000..478fc7aca0
--- /dev/null
+++ b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0014-widgets-backdrop-follows-the-font.patch
@@ -0,0 +1,243 @@
+From: Max Engel <max@awecelot.com>
+Date: Tue, 15 Sep 2026 05:43:27 +0000
+Subject: [PATCH] gfx_widgets: size a notification's backdrop for the font it is drawn with
+
+The maintainer, on the RG SP (640x480, ozone; fork #194): the translucent
+backdrop behind the RetroAchievements login toast did not cover the whole
+text.
+
+A notification's backdrop is sized from msg->width, which
+gfx_widgets_msg_queue_push measures with the msg_queue font of that moment
+and nothing measures again. The fork's 0001-Increase-ozone-widget_size.patch
+multiplies the widget scale by 1.5 under ozone in gfx_widgets_iterate alone;
+gfx_widgets_context_reset kept the unmultiplied value. So every context
+reset -- start-up, and each video reinit (a core's SET_SYSTEM_AV_INFO, a
+fullscreen toggle) -- lays the widgets out at the small scale, and the next
+frame lays them out again at the large one: two font rebuilds, and between
+them a window in which a message pushed is measured with the small font and
+drawn with the large one.
+
+At 640x480 on the KMS context (no DPI, so the pixel scale: 0.363, times 1.5
+0.545) the msg_queue font is 9 px in the first layout (the 9 px floor) and
+10 px in the second. `RetroAchievements: Logged in as "MaxEngel".` in the
+shipped widget font (xmb/monochrome/font.ttf, video_font_path) measures
+199 px with the one and 226 px with the other, against the 17 px a single
+line's backdrop extends past its text: the text runs about 10 px past the
+backdrop. A message pushed from a task callback -- the login toast comes
+from rcheevos_client_http_task_callback, run by task_queue_check after
+runloop_iterate -- is measured with the layout that iteration left behind;
+a context reset inside the iteration (a core's SET_SYSTEM_AV_INFO in its
+first frames is common) leaves the small one, and the next iteration's
+gfx_widgets_iterate rebuilds the fonts at the large one before the toast is
+drawn. The offline proxy answers the login at loopback speed, so its
+callback is among the first task_queue_check runs; an online answer takes
+hundreds of milliseconds and lands after such a window, which is why the
+defect showed offline. Which reset stands in front of the toast on the RG
+SP is for the VM frame to confirm (#194); the fix does not depend on the
+answer.
+
+Two changes, both in gfx_widgets.c:
+
+- gfx_widgets_get_scale_factor derives the widget scale in one place, and
+  gfx_widgets_context_reset and gfx_widgets_iterate both use it, so a reset
+  lays out once, at the scale the frame loop keeps. At a reset the menu
+  driver is not initialised yet (drivers_init brings the widgets up before
+  the menu, and a reinit tears the menu down first), so menu_driver_id
+  reads UNKNOWN there; the configured driver name
+  (settings->arrays.menu_driver) says what it is about to be.
+
+- gfx_widgets_msg_queue_measure measures a plain notification's width with
+  the current msg_queue font -- the longest line, plus the same half padding
+  the push adds -- as the message leaves the queue in gfx_widgets_iterate,
+  and for every message on screen in gfx_widgets_layout once the fonts are
+  rebuilt (under current_msgs_lock, which gfx_widgets_frame holds while it
+  draws). Task notifications are left alone: their width follows the task's
+  title through the push's update branch.
+
+The first removes the trigger the fork introduced; the second makes the
+outcome independent of any re-layout at all -- a change of resolution while
+a toast is up, say. Stock RetroArch carries the same latent assumption but
+never re-lays out at a moment a message could be in flight, which is why
+this is a fork patch and not (yet) an upstream one.
+
+diff --git a/gfx/gfx_widgets.c b/gfx/gfx_widgets.c
+index ed06d55..c5b37b2 100644
+--- a/gfx/gfx_widgets.c
++++ b/gfx/gfx_widgets.c
+@@ -189,6 +189,45 @@ static void msg_widget_msg_transition_animation_done(void *userdata)
+    msg->msg_transition_animation = 0.0f;
+ }
+ 
++/* ROCKNIX: the widget scale factor, derived in one place.
++ *
++ * 0001-Increase-ozone-widget_size.patch multiplies the scale by 1.5 under
++ * ozone, and did so in gfx_widgets_iterate alone. gfx_widgets_context_reset
++ * kept the unmultiplied value, so every context reset -- start-up, and each
++ * video reinit: a core's SET_SYSTEM_AV_INFO, a fullscreen toggle -- laid the
++ * widgets out at the small scale and the next frame laid them out again at
++ * the large one. Two font rebuilds, and between them a window in which a
++ * notification pushed was measured with the small msg_queue font and drawn
++ * with the large one (see gfx_widgets_msg_queue_measure). At a context
++ * reset the menu driver is not initialised yet (drivers_init brings the
++ * widgets up first and the menu after, and a reinit tears the menu down
++ * before that), so p_disp->menu_driver_id reads UNKNOWN there; the
++ * configured driver name says what it is about to be. */
++static float gfx_widgets_get_scale_factor(
++      gfx_display_t *p_disp,
++      settings_t *settings,
++      unsigned width, unsigned height, bool fullscreen)
++{
++   float scale_factor;
++   bool  ozone;
++#ifdef HAVE_XMB
++   if (p_disp->menu_driver_id == MENU_DRIVER_ID_XMB)
++      scale_factor = gfx_display_get_widget_pixel_scale(
++            p_disp, settings, width, height, fullscreen);
++   else
++#endif
++      scale_factor = gfx_display_get_dpi_scale(
++            p_disp, settings, width, height, fullscreen, true);
++
++   ozone =    (p_disp->menu_driver_id == MENU_DRIVER_ID_OZONE)
++           || (   (p_disp->menu_driver_id == MENU_DRIVER_ID_UNKNOWN)
++               && string_is_equal(settings->arrays.menu_driver, "ozone"));
++   if (ozone)
++      scale_factor = scale_factor * 1.500f;
++
++   return scale_factor;
++}
++
+ /* Forward declaration: msg_queue_free is defined further below
+  * (around line 550) but is needed by msg_queue_push for the
+  * race-loss rollback path added in the producer-locking fix. */
+@@ -876,6 +915,48 @@ static void gfx_widgets_font_init(
+    font_data->usage_count        = 0;
+ }
+ 
++/* ROCKNIX: a notification's backdrop is sized from msg->width, which
++ * gfx_widgets_msg_queue_push measured with the msg_queue font of that
++ * moment and nothing measured again. A font rebuilt in between --
++ * gfx_widgets_layout, after a change of scale or of size -- draws the text
++ * at a size the width was never measured for, and the backdrop ends before
++ * the text does (ROCKNIX fork #194: the RetroAchievements login toast on a
++ * 640x480 panel -- 199 px measured with the 9 px font a context reset lays
++ * out, 226 px drawn with the 10 px font of the frame after, past a 17 px
++ * margin). So the width follows the font: measured again as the message
++ * leaves the queue, and again for every message on screen when the layout
++ * runs. Plain notifications only -- a task's width follows its title
++ * through gfx_widgets_msg_queue_push's update branch. */
++static void gfx_widgets_msg_queue_measure(
++      dispgfx_widget_t *p_dispwidget,
++      disp_widget_msg_t *msg)
++{
++   const char *line = msg->msg;
++   unsigned width   = 0;
++
++   if (msg->task_ptr || !line || !*line)
++      return;
++
++   /* The longest line: a wrapped message carries one '\n' */
++   while (*line)
++   {
++      const char *end = strchr(line, '\n');
++      size_t len      = end ? (size_t)(end - line) : strlen(line);
++      int w           = font_driver_get_message_width(
++            p_dispwidget->gfx_widget_fonts.msg_queue.font,
++            line, len, 1.0f);
++      if (w > (int)width)
++         width = (unsigned)w;
++      if (!end)
++         break;
++      line = end + 1;
++   }
++
++   msg->width       = width + (p_dispwidget->simple_widget_padding / 2);
++   msg->text_height = p_dispwidget->gfx_widget_fonts.msg_queue.line_height
++         * (strchr(msg->msg, '\n') ? 2 : 1);
++}
++
+ static void gfx_widgets_layout(
+       gfx_display_t *p_disp,
+       dispgfx_widget_t *p_dispwidget,
+@@ -943,6 +1024,22 @@ static void gfx_widgets_layout(
+ 
+    gfx_widgets_update_icon_layout(p_dispwidget);
+ 
++   /* ROCKNIX: the fonts have just been rebuilt; the messages on screen
++    * were measured with the old ones (gfx_widgets_msg_queue_measure) */
++   if (p_dispwidget->current_msgs_size)
++   {
++#ifdef HAVE_THREADS
++      slock_lock(p_dispwidget->current_msgs_lock);
++#endif
++      for (i = 0; i < p_dispwidget->current_msgs_size; i++)
++         if (p_dispwidget->current_msgs[i])
++            gfx_widgets_msg_queue_measure(p_dispwidget,
++                  p_dispwidget->current_msgs[i]);
++#ifdef HAVE_THREADS
++      slock_unlock(p_dispwidget->current_msgs_lock);
++#endif
++   }
++
+    p_dispwidget->divider_width_1px                = 1;
+    if (p_dispwidget->last_scale_factor > 1.0f)
+       p_dispwidget->divider_width_1px             = (unsigned)(p_dispwidget->last_scale_factor + 0.5f);
+@@ -977,18 +1074,10 @@ void gfx_widgets_iterate(
+    volatile float scale_factor      = 0.0f;
+    gfx_display_t *p_disp            = (gfx_display_t*)data_disp;
+    settings_t *settings             = (settings_t*)settings_data;
+-#ifdef HAVE_XMB
+-   enum menu_driver_id_type type    = p_disp->menu_driver_id;
+-   if (type == MENU_DRIVER_ID_XMB)
+-      scale_factor                  = gfx_display_get_widget_pixel_scale(p_disp, settings, width, height, fullscreen);
+-   else
+-#endif
+-      scale_factor                  = gfx_display_get_dpi_scale(
+-            p_disp,
+-            settings, width, height, fullscreen, true);
+ 
+-      if (p_disp->menu_driver_id == MENU_DRIVER_ID_OZONE)
+-         scale_factor = scale_factor * 1.500f;
++   /* ROCKNIX: the same derivation as gfx_widgets_context_reset's */
++   scale_factor                     = gfx_widgets_get_scale_factor(
++         p_disp, settings, width, height, fullscreen);
+ 
+    /* Check whether screen dimensions or menu scale
+     * factor have changed */
+@@ -1057,6 +1146,10 @@ void gfx_widgets_iterate(
+ 
+          if (msg_widget)
+          {
++            /* ROCKNIX: measured now, with the font it is drawn with
++             * (gfx_widgets_msg_queue_measure) */
++            gfx_widgets_msg_queue_measure(p_dispwidget, msg_widget);
++
+             /* Task messages always appear from the bottom of the screen, append it */
+             if (p_dispwidget->msg_queue_tasks_count == 0 || msg_widget->task_ptr)
+                p_dispwidget->current_msgs[p_dispwidget->current_msgs_size] = msg_widget;
+@@ -2179,19 +2272,12 @@ static void gfx_widgets_context_reset(
+    /* Update scaling/dimensions */
+    p_dispwidget->last_video_width     = width;
+    p_dispwidget->last_video_height    = height;
+-#ifdef HAVE_XMB
+-   if (p_disp->menu_driver_id == MENU_DRIVER_ID_XMB)
+-      p_dispwidget->last_scale_factor = gfx_display_get_widget_pixel_scale(
+-            p_disp, settings,
+-            p_dispwidget->last_video_width,
+-            p_dispwidget->last_video_height, fullscreen);
+-   else
+-#endif
+-      p_dispwidget->last_scale_factor = gfx_display_get_dpi_scale(
+-                     p_disp, settings,
+-                     p_dispwidget->last_video_width,
+-                     p_dispwidget->last_video_height,
+-                     fullscreen, true);
++   /* ROCKNIX: the same derivation as gfx_widgets_iterate's, so the layout
++    * below is the one the frame loop keeps (gfx_widgets_get_scale_factor) */
++   p_dispwidget->last_scale_factor    = gfx_widgets_get_scale_factor(
++         p_disp, settings,
++         p_dispwidget->last_video_width,
++         p_dispwidget->last_video_height, fullscreen);
+ 
+    gfx_widgets_layout(p_disp, p_dispwidget,
+          is_threaded, dir_assets, font_path);
diff --git a/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0015-video-thread-wrapper-run-a-command-once.patch b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0015-video-thread-wrapper-run-a-command-once.patch
new file mode 100644
index 0000000000..e52555e670
--- /dev/null
+++ b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0015-video-thread-wrapper-run-a-command-once.patch
@@ -0,0 +1,89 @@
+video_thread_wrapper: run a posted command once, not once per wake
+
+The video thread's loop wakes for either a command or a frame update,
+then copies thr->cmd_data and dispatches it unconditionally. Whether
+there is anything to run is inferred afterwards from the packet's own
+type -- and cmd_data.type is cleared by the POSTER, in
+video_thread_wait_reply, after it wakes.
+
+So between video_thread_reply() and the poster being scheduled,
+cmd_data still holds the command that just finished. A frame update
+arriving in that window wakes the loop, which copies that completed
+packet and runs its method a second time. Every caller of
+video_thread_texture_handle passes the address of a local --
+gl3_load_texture and twenty-odd siblings across gl1, gl2, gl3, vulkan,
+d3d8..d3d12 and rsx -- so the second run dereferences a dead stack
+frame.
+
+Captured on an Anbernic RG SP (H700, glcore, threaded video) with a
+core dump: SIGSEGV in video_texture_load_wrap_gl3_mipmap+0xc, the
+ldr x0,[x0] of cmd->gl, x0 = 0xffff0000000b, lr in video_thread_loop's
+CMD_CUSTOM_COMMAND case -- while the posting thread sat in
+rc_evaluate_trigger, long returned from its post. The build carried the
+poster lock from #19518, which closes a different hole: that one was
+two posters colliding, this is one packet executed twice.
+
+The same doubling reaches font_driver_release_renderer_state, whose
+method is renderer->free(). A doubled dispatch there is a double free,
+which corrupts the heap and surfaces later somewhere unrelated.
+
+send_cmd is set to CMD_VIDEO_NONE by video_thread_reply when a command
+completes, so it is the one flag the consumer owns; the fix reads it
+while the lock is held and gates the dispatch on it.
+
+Proved by a fixture that extracts send_packet, wait_reply, reply,
+send_and_wait_user_to_thread and this dequeue verbatim from the source
+and drives them with a poster whose cmd is a local and a thread setting
+frame.updated: as shipped, 2000 posts ran the method 2017 times; with
+the gate, exactly 2000.
+
+Written for ROCKNIX (fork maxengel/rocknix#211, #225). Upstream-bound.
+
+--- a/gfx/video_thread_wrapper.c
++++ b/gfx/video_thread_wrapper.c
+@@ -431,6 +431,7 @@
+ {
+    thread_packet_t pkt;
+    bool updated;
++   bool have_cmd;
+    thread_video_t *thr = (thread_video_t*)data;
+ 
+    for (;;)
+@@ -441,13 +442,36 @@
+ 
+       updated = thr->frame.updated;
+ 
++      /* Whether there is a command to run is decided here, while the lock
++       * is held, and not from the packet's own type afterwards.
++       *
++       * cmd_data.type is cleared by the POSTER, in video_thread_wait_reply,
++       * after it wakes -- so between video_thread_reply() and the poster
++       * being scheduled, cmd_data still holds the command that has just
++       * finished. A frame update arriving in that window wakes this loop,
++       * which would copy that completed packet and run its method a second
++       * time. By then the poster has usually returned, and every caller of
++       * video_thread_texture_handle passes the address of a LOCAL (see
++       * gl3_load_texture and its twenty-odd siblings), so the second run
++       * dereferences a dead stack frame.
++       *
++       * That is fork issue maxengel/rocknix#211: RetroArch segfaulting in
++       * video_texture_load_wrap_gl3_mipmap at cmd->gl, with the posting
++       * thread already elsewhere, on a build that carries the poster lock
++       * from libretro/RetroArch#19518. The same doubling reaches
++       * font_driver_release_renderer_state, where the method is a free.
++       *
++       * send_cmd is set to CMD_VIDEO_NONE by video_thread_reply when a
++       * command completes, so it is the one flag the consumer owns. */
++      have_cmd = (thr->send_cmd != CMD_VIDEO_NONE);
++
+       /* To avoid race condition where send_cmd is updated
+        * right after the switch is checked. */
+       pkt     = thr->cmd_data;
+ 
+       slock_unlock(thr->lock);
+ 
+-      if (video_thread_handle_packet(thr, &pkt))
++      if (have_cmd && video_thread_handle_packet(thr, &pkt))
+          return;
+ 
+       if (updated)
diff --git a/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0016-widgets-message-queue-floor.patch b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0016-widgets-message-queue-floor.patch
new file mode 100644
index 0000000000..6be30d160e
--- /dev/null
+++ b/projects/ROCKNIX/packages/emulators/libretro/retroarch/patches/0016-widgets-message-queue-floor.patch
@@ -0,0 +1,97 @@
+widgets: the message queue is never drawn under 14 px
+
+The widget fonts are sized from the panel's pixel diagonal against 1080p
+(the KMS context reports no DPI), times the widget factor, times 1.5 for
+ozone. On a 640x480 handheld that puts the message-queue font at 10.9 px,
+and FreeType rasterises it at 10: every vertical stem of Inter falls
+under a pixel and is drawn as two grey half-columns, while the
+achievement banner beside it, at 17 px, has stems of 1.4 px and reads
+sharp. The general 9 px floor is too low to help; on a 480x320 panel the
+queue sits at that floor already.
+
+So gfx_widgets_font_init takes the floor as a parameter: the regular and
+bold faces keep 9, the message queue gets 14, where Inter's stems cross a
+whole pixel. Nothing changes on a panel whose computed size is already
+14 or more (720p and up).
+
+Measured on a 640x480 guest, 2026-09-24 (fork #251): at 10 px, 41 strokes
+on the x-height row, none with a fully-lit pixel, mean stem 0.76 px; at
+15 px, 46 strokes, 10 solid, 1.40 px; the banner's 17 px, 1.37 px.
+Switching FreeType's hinting interpreter changed no pixel.
+
+--- a/gfx/gfx_widgets.c	2026-09-24 01:08:39.921338109 +0000
++++ b/gfx/gfx_widgets.c	2026-09-24 01:08:39.934486699 +0000
+@@ -44,6 +44,15 @@
+ 
+ #define BASE_FONT_SIZE      32.0f
+ #define MSG_QUEUE_FONT_SIZE 20.0f
++/* The smallest face the message queue is drawn at, in pixels. On a small
++ * panel the scale from the pixel diagonal puts this font under a pixel of
++ * stem width (10.9 px on a 640x480 handheld: no stroke owns a whole
++ * pixel), and the general 9 px floor below is too low to help. Inter's
++ * stems cross one pixel near 13 px (13: 88% of strokes on a whole pixel,
++ * 14: 87%, tools/font-stems), so 13 keeps every queue notification
++ * readable on 480x320 and 640x480 panels and changes nothing where the
++ * computed size is already larger (ROCKNIX fork, #251; 14 until #296). */
++#define MSG_QUEUE_MIN_SIZE  13.0f
+ 
+ static dispgfx_widget_t dispwidget_st = {0}; /* uint64_t alignment */
+ static uint64_t widget_icon_load_gen  = 0;
+@@ -880,14 +888,15 @@
+       gfx_display_t *p_disp,
+       dispgfx_widget_t *p_dispwidget,
+       gfx_widget_font_data_t *font_data,
+-      bool is_threaded, char *font_path, float font_size)
++      bool is_threaded, char *font_path, float font_size,
