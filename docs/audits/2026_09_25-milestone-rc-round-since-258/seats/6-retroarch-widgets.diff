+@@ -290,7 +291,15 @@
+          && state_slot < 1000)
+    {
+       runloop_state_t *runloop_st  = runloop_state_get_ptr();
+-      runloop_st->entry_state_slot = state_slot;
++      /* The log remembers the slot the game was last left on, and restoring
