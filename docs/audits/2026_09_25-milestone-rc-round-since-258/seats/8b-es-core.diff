+		// The time half alone, as toLocalTimeString writes it after the date.
+		std::string DateTime::localClockText(const tm& clockTstruct)
+		{
+			const bool twelveHour = Settings::ClockMode12();
+			char markerBuf[32];
+			size_t markerLen = 0;
+			if (twelveHour)
