+		//   key=x, secret=x, psk=x, pin=x      then =: devpassword, cheevos_token,
+		//                                      wifi.key, ScreenScraperPass, api-key
+		//   ?y=x, &t=x, &p=x                   RetroAchievements' one-letter query
