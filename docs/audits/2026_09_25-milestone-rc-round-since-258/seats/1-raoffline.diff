++def _pooled_connection(scheme: str, host: str, timeout: float, fresh: bool = False):
++    connections = getattr(_pool, "connections", None)
++    if connections is None:
++        connections = _pool.connections = {}
++    key = (scheme, host)
++    existing = connections.get(key)
++    if fresh and existing is not None:
++        try:
++            existing.close()
++        except Exception:
++            pass
++        existing = None
++        connections.pop(key, None)
++    if existing is None:
++        if scheme == "https":
++            existing = http.client.HTTPSConnection(host, timeout=timeout)
++        else:
++            existing = http.client.HTTPConnection(host, timeout=timeout)
++        connections[key] = existing
++    return existing
++
++
++def _drop_connection(scheme: str, host: str) -> None:
++    connections = getattr(_pool, "connections", None) or {}
++    connection = connections.pop((scheme, host), None)
++    if connection is not None:
++        try:
++            connection.close()
++        except Exception:
++            pass
