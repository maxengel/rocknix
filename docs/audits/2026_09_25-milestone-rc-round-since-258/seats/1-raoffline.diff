+     build_unlocks_array,
+     cache_session,
+@@ -80,6 +81,9 @@ FAKE_OFFLINE_SUCCESS_ACTIONS = {"ping", "postactivity"}
+ REFRESH_PLAYED_WINDOW_DAYS = 7
+ ONLINE_REFRESH_IDLE_DELAY_SECONDS = 5 * 60
+ REFRESH_PLAYED_WINDOW_MS = REFRESH_PLAYED_WINDOW_DAYS * 24 * 60 * 60 * 1000
++# Fetches that fail in a row before a refresh pass gives up (the link, the
++# server); a refused sign-in ends a pass at once, without a request per game.
++REFRESH_MAX_FAILURES_IN_A_ROW = 3
+ ALWAYS_TRY_UPSTREAM_ACTIONS = {"login", "login2"}
+ # A 4xx RetroAchievements sends for a dorequest.php call it understood but
+ # cannot satisfy -- 404 "Unknown game" for a hash with no set, 400 for a bad
+@@ -1054,35 +1058,50 @@ class PeriodicRefresh(threading.Thread):
+         self.stop_event.set()
+ 
+     def run(self) -> None:
++        # A pass that fails -- a request that raised, the store unreadable
++        # for a moment -- costs that pass and nothing more: the thread lives
++        # for the service's lifetime, and with it the eviction it carries.
++        # Without this it dies on the first exception, silently, with
++        # Restart=on-failure none the wiser, and the service runs on with no
++        # refresh and no eviction until its next start.
+         while not self.stop_event.wait(self.interval_seconds):
+-            if not self.server.is_online():
