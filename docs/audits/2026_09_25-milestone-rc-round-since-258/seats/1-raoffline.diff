++# ROCKNIX (fork #190, #199): the request header that asks for the store and
++# nothing else. On a dorequest.php call it is served by handle_offline_request
++# whatever this process believes about the link; on an image it is the
++# store's copy or a 404, at once.
++STORE_ONLY_HEADER = "X-RA-Store-Only"
+ 
+ 
