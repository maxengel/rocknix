@@ -0,0 +1,10 @@
+# Boot-time reconcile of the OFFLINE RETROACHIEVEMENTS toggle (fork #165):
+# 099-networkservices reads STATE, rewrites the marker the unit conditions
+# on and starts or stops the daemon. system.cfg is the record that travels
+# in a settings backup; the marker under /storage/.cache does not, so a
+# restored device with the toggle on gets its marker and its service back at
+# the next boot without being asked anything.
+STATE=$(get_setting global.retroachievements.offlineproxy)
+SVC="raofflineproxy"
+CONF="raofflineproxy.conf"
+DAEMONS=("raofflineproxy")
diff --git a/projects/ROCKNIX/packages/network/raofflineproxy/package.mk b/projects/ROCKNIX/packages/network/raofflineproxy/package.mk
new file mode 100644
index 0000000000..c2d8ff319a
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/raofflineproxy/package.mk
@@ -0,0 +1,153 @@
+# SPDX-License-Identifier: GPL-2.0-or-later
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+PKG_NAME="raofflineproxy"
+# Pinned by full commit (packages/README.md): main at 2026-09-26 (fork #293; 0711f0b of 2026-09-23 before, fork #259).
+# Since the previous pin (4e9bab48, 2026-09-20) the Linux side refreshes only
+# the games played in the last seven days (59b167c), keeps every cached
+# game's rows until the game is deleted rather than evicting them after sixty
+# days (59b167c, e25b276), caches gameid lookups, and moves the rcheevos
+# submodule to 1433173 (095867d; raofflineproxy-rcheevos follows it). libchdr
+# is unchanged at 8e7b8bd. Patch 005 kept its exception boundary and dropped
+# its bound on the pass; 006 retired, upstream now does more than it did
+# (D-RA-029). APP_VERSION still reads 1.13.0-alpha1.
+PKG_VERSION="c1bd3724d18e8c0ce67c3d62852e6eaf83e3a302"
+PKG_SHA256="0729719d8ea7fd23a4669f79849ce0c8d1d9d811e978ac1c60bc1ed97a9d5d19"
+# GPLv3 text with no "or any later version" grant in the sources.
+PKG_LICENSE="GPL-3.0-only"
+PKG_SITE="https://github.com/misantronic/RAOfflineProxy"
+PKG_URL="${PKG_SITE}/archive/${PKG_VERSION}.tar.gz"
+# Python3 is the interpreter, and its host build carries the compileall that
+# python_compile runs; the service itself is stdlib-only (argparse, sqlite3,
+# ssl, hmac, http, socketserver, ...), all of it in the image's lib-dynload.
+# raofflineproxy-rcheevos and raofflineproxy-libchdr are the two submodules
+# the proxy's tarball leaves empty, pinned to the commits it names; make_target
+# below compiles them with the glue into libraproxy_rchash.so (fork #179).
+PKG_DEPENDS_TARGET="toolchain Python3 raofflineproxy-rcheevos raofflineproxy-libchdr"
+PKG_LONGDESC="RAOfflineProxy: a loopback proxy between the emulators and retroachievements.org that caches game data and queues casual awards earned without a connection, and sends them when one returns. Approved by RetroAchievements.org; casual (softcore) achievements only."
+PKG_TOOLCHAIN="manual"
+PKG_BUILD_FLAGS="+pic"
+
+# OFFLINE RETROACHIEVEMENTS (fork #163/#165, D-RA-001, D-RA-002).
+#
+# What ships is the service and nothing around it: linux/raofflineproxy as a
+# Python module in the image's site-packages, byte-compiled like the stdlib
+# (the image carries .pyc only and the root filesystem is read-only, so
+# uncompiled sources would recompile at every start), a systemd unit gated on
+# the same kind of marker avahi and sshd use, and raofflineproxy-ctl, the
+# fork's launcher that EmulationStation's toggle drives. Not shipped: the
+# self-extracting bundle, the pygame menu and its SDL driver matrix, the
+# Tools entry, the boot hook, and the upstream config patchers -- on ROCKNIX
+# setsettings.sh rebuilds RetroArch's cheevos keys from system.cfg at every
+# launch, so the OS owns the launch-time config and points the emulators at
+# the proxy itself (setsettings.sh set_cheevos, cheevos_ppsspp.sh).
+#
+# SCAN GAMES FOR OFFLINE ACHIEVEMENTS (fork #179, D-RA-010) adds the one
+# native piece the client needs and the tarball does not carry built (and,
+# since fork #184 / D-RA-013, raofflineproxy-cache-indexed, which caches a
+# game the interface's own index identified without hashing it again):
+# libraproxy_rchash.so, rcheevos' rc_hash with the libchdr CHD reader and the
+# LZMA SDK 7z reader behind one C entry point (third_party/rcheevos_glue),
+# which rom_hashing.py loads through ctypes to identify a ROM the way
+# RetroArch does. Without it every ROM the scan looks at fails to hash. The
+# recipe is upstream's linux/build_rchash.sh -- the same defines, the same
+# source list -- run with the target compiler instead of zig, and the two
+# submodule trees come from the raofflineproxy-rcheevos and
+# raofflineproxy-libchdr packages. Checked against the QA ROMs before it
+# went in: the library hashes the NES fixture to a49d6f153d642026643a162b6df7af99,
+# the hash RetroArch itself logged for it (#179 evidence, 2026-09-14).
+
+make_target() {
+  local RC="$(get_build_dir raofflineproxy-rcheevos)"
+  local CHDR="$(get_build_dir raofflineproxy-libchdr)"
+  local GLUE="${PKG_BUILD}/third_party/rcheevos_glue"
+  local LZMA_SDK="${PKG_BUILD}/third_party/lzma-sdk"
+  mkdir -p "${PKG_BUILD}/.${TARGET_NAME}"
+  ${CC} ${CFLAGS} ${LDFLAGS} -shared -Os -fPIC \
+    -DRC_HASH_NO_ENCRYPTED \
+    -DZ7_PPMD_SUPPORT \
+    -DWANT_RAW_DATA_SECTOR=1 \
+    -DWANT_SUBCODE=1 \
+    -DVERIFY_BLOCK_CRC=1 \
+    -I"${RC}/include" -I"${RC}/src" -I"${RC}/src/rhash" \
+    -I"${GLUE}" -I"${GLUE}/shim" \
+    -I"${CHDR}/include" -I"${CHDR}/src" \
+    -I"${CHDR}/deps/miniz-3.1.2" -I"${CHDR}/deps/lzma-26.02/include" -I"${CHDR}/deps/zstd-1.5.7" \
+    -I"${LZMA_SDK}" \
+    -o "${PKG_BUILD}/.${TARGET_NAME}/libraproxy_rchash.so" \
+    "${RC}/src/rhash/hash.c" \
+    "${RC}/src/rhash/hash_rom.c" \
+    "${RC}/src/rhash/hash_disc.c" \
+    "${RC}/src/rhash/hash_zip.c" \
+    "${RC}/src/rhash/cdreader.c" \
+    "${RC}/src/rhash/md5.c" \
+    "${RC}/src/rc_compat.c" \
+    "${GLUE}/chd_stream.c" \
+    "${GLUE}/cdfs_chd.c" \
+    "${GLUE}/cdfs_pbp.c" \
+    "${GLUE}/strl_compat.c" \
+    "${GLUE}/sevenzip.c" \
+    "${GLUE}/rchash_glue.c" \
+    "${CHDR}/src/libchdr_bitstream.c" \
+    "${CHDR}/src/libchdr_cdrom.c" \
+    "${CHDR}/src/libchdr_chd.c" \
+    "${CHDR}/src/libchdr_codec_avhuff.c" \
+    "${CHDR}/src/libchdr_codec_cdfl.c" \
+    "${CHDR}/src/libchdr_codec_cdlz.c" \
+    "${CHDR}/src/libchdr_codec_cdzl.c" \
+    "${CHDR}/src/libchdr_codec_cdzs.c" \
+    "${CHDR}/src/libchdr_codec_flac.c" \
+    "${CHDR}/src/libchdr_codec_huff.c" \
+    "${CHDR}/src/libchdr_codec_lzma.c" \
+    "${CHDR}/src/libchdr_codec_zlib.c" \
+    "${CHDR}/src/libchdr_codec_zstd.c" \
+    "${CHDR}/src/libchdr_flac.c" \
+    "${CHDR}/src/libchdr_huffman.c" \
+    "${CHDR}/deps/miniz-3.1.2/miniz.c" \
+    "${CHDR}/deps/lzma-26.02/src/LzmaDec.c" \
+    "${CHDR}/deps/zstd-1.5.7/zstddeclib.c" \
+    "${LZMA_SDK}"/*.c
+}
+
+makeinstall_target() {
+  local SITE="${INSTALL}/usr/lib/${PKG_PYTHON_VERSION}/site-packages"
+  mkdir -p "${SITE}"
+  cp -r "${PKG_BUILD}/linux/raofflineproxy" "${SITE}/raofflineproxy"
+  rm -rf "${SITE}/raofflineproxy/__pycache__"
+  # The SDL menu's fonts and donation QR images. menu_sdl.py only names the
+  # paths at import; nothing on this image draws that menu.
+  rm -rf "${SITE}/raofflineproxy/assets"
+  rm -f "${SITE}"/raofflineproxy/font-mono*.ttf
+  python_compile "${SITE}/raofflineproxy"
+
+  mkdir -p "${INSTALL}/usr/bin"
+  cp "${PKG_DIR}/sources/raofflineproxy-ctl" "${INSTALL}/usr/bin/raofflineproxy-ctl"
+  chmod 0755 "${INSTALL}/usr/bin/raofflineproxy-ctl"
+  # The scan's worker (fork #184, D-RA-013): caches a game the interface's
+  # index already identified from its id and hash, and hands the rest to the
+  # client's own hashing path. The ctl looks for it beside itself.
+  cp "${PKG_DIR}/sources/raofflineproxy-cache-indexed" "${INSTALL}/usr/bin/raofflineproxy-cache-indexed"
+  chmod 0755 "${INSTALL}/usr/bin/raofflineproxy-cache-indexed"
+
+  # The images of what is cached, fetched until none is missing (#212): the
+  # same action as caching the achievements, run at the end of a scan and a
+  # top-up and available on its own as `raofflineproxy-ctl images`.
+  cp "${PKG_DIR}/sources/raofflineproxy-cache-images" "${INSTALL}/usr/bin/raofflineproxy-cache-images"
+  chmod 0755 "${INSTALL}/usr/bin/raofflineproxy-cache-images"
+  cp "${PKG_DIR}/sources/raofflineproxy-refresh" "${INSTALL}/usr/bin/raofflineproxy-refresh"
+  chmod 0755 "${INSTALL}/usr/bin/raofflineproxy-refresh"
+
+  # /usr/lib is the first system path rom_hashing.py's loader tries after the
+  # module's own directory.
+  mkdir -p "${INSTALL}/usr/lib"
+  cp "${PKG_BUILD}/.${TARGET_NAME}/libraproxy_rchash.so" "${INSTALL}/usr/lib/libraproxy_rchash.so"
+  chmod 0644 "${INSTALL}/usr/lib/libraproxy_rchash.so"
+}
+
+post_install() {
+  # Enabled in the image; the unit's ConditionPathExists on
+  # /storage/.cache/services/raofflineproxy.conf is the off-switch, and
+  # raofflineproxy-ctl (and, at boot, /usr/lib/autostart/daemons) owns that
+  # marker.
+  enable_service raofflineproxy.service
+}
diff --git a/projects/ROCKNIX/packages/network/raofflineproxy/patches/001-dorequest-4xx-passthrough.patch b/projects/ROCKNIX/packages/network/raofflineproxy/patches/001-dorequest-4xx-passthrough.patch
new file mode 100644
index 0000000000..42c6039bb9
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/raofflineproxy/patches/001-dorequest-4xx-passthrough.patch
@@ -0,0 +1,63 @@
+proxy_service: pass a 4xx from dorequest.php through instead of answering 503
+
+RetroAchievements answers a dorequest.php call it understood but cannot
+satisfy with a 4xx whose body names the reason -- 404 with
+{"Success":false,"Error":"Unknown game",...} for a hash that has no
+achievement set, 400 for a malformed parameter. handle_online_request turned
+every non-2xx into 503 {"Success":false,"Error":"upstream unavailable"}, so
+an emulator behind the proxy reports "Load failed (-27): upstream
+unavailable" for a ROM the server had in fact answered about, where the same
+launch without the proxy reads "Load failed (-29): Unknown game". The player
+is sent looking for a connection problem that does not exist, and the
+message is false: upstream answered.
+
+Pass a 4xx from dorequest.php through as it came, status and body, except
+401 and 403. An auth failure keeps today's 503, so this change touches
+nothing about how the proxy handles credentials (the login actions' cached
+responses, the token the flusher carries). 5xx and network errors keep the
+503 and the offline path as before; forward_to_upstream and the login and
+award paths already passed an http_error through unchanged, so this brings
+the general online path in line with them.
+
+Seen on ROCKNIX (fork issue maxengel/rocknix#166) with the proxy at
+64d03d30633ca6e7719c26d732cef3c97dedcc27: RetroArch through the proxy logged
+"Load failed (-27): upstream unavailable" for a fixture ROM RA answered 404
+for, and "Load failed (-29): Unknown game" without it. Offered upstream
+as-is (ROCKNIX D-RA-002: whatever the fork changes in the proxy goes back).
+
+--- a/linux/raofflineproxy/proxy_service.py
++++ b/linux/raofflineproxy/proxy_service.py
+@@ -81,6 +81,20 @@ REFRESH_PLAYED_WINDOW_DAYS = 7
+ ONLINE_REFRESH_IDLE_DELAY_SECONDS = 5 * 60
+ REFRESH_PLAYED_WINDOW_MS = REFRESH_PLAYED_WINDOW_DAYS * 24 * 60 * 60 * 1000
+ ALWAYS_TRY_UPSTREAM_ACTIONS = {"login", "login2"}
++# A 4xx RetroAchievements sends for a dorequest.php call it understood but
++# cannot satisfy -- 404 "Unknown game" for a hash with no set, 400 for a bad
++# parameter -- carries the reason the emulator shows the player, and passes
++# through as it came. 401 and 403 do not: an auth failure keeps the 503, so
++# nothing about how credentials are handled changes here.
++AUTH_FAILURE_STATUSES = {401, 403}
++
++
++def is_passthrough_client_error(path: str, status: int) -> bool:
++    return (
++        path.startswith("/dorequest.php")
++        and 400 <= status < 500
++        and status not in AUTH_FAILURE_STATUSES
++    )
+ 
+ 
+ def is_static_asset_request(path: str) -> bool:
+@@ -527,6 +541,12 @@ class ProxyRuntimeServer(ThreadingTCPServer):
+             return self.handle_offline_request(path, raw_body, action)
+ 
+         if upstream[0] != "success":
++            if upstream[0] == "http_error" and is_passthrough_client_error(
++                path, upstream[1]
++            ):
++                return raw_response_bytes(
++                    upstream[1], upstream[3], upstream[4], upstream[2]
++                )
+             return error_json(503, "upstream unavailable")
+ 
+         status_code = upstream[1]
diff --git a/projects/ROCKNIX/packages/network/raofflineproxy/patches/002-no-synthetic-casual-only-achievement.patch b/projects/ROCKNIX/packages/network/raofflineproxy/patches/002-no-synthetic-casual-only-achievement.patch
new file mode 100644
index 0000000000..1a3dde30f7
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/raofflineproxy/patches/002-no-synthetic-casual-only-achievement.patch
@@ -0,0 +1,59 @@
+rom_cache: drop RetroAchievements' client warning from achievementsets too
+
+RetroAchievements answers achievementsets for a client it allows only casual
+unlocks from -- RAOfflineProxy's User-Agent suffix is registered that way --
+with a synthetic achievement prepended to the first set: CLIENT_WARNING_ID
+101000001, "Warning: Casual Only" / "Hardcore unlocks cannot be earned using
+this emulator.", MemAddr 1=1.300. so it pops five seconds in, 0 points
+(RAWeb app/Connect/Actions/GetAchievementSetsAction.php and
+CreateWarningAchievementAction.php). The server builds it with
+Flags = FLAG_PROMOTED (3), the same flag as a core achievement.
+
+The proxy already strips that id from patch, unlocks and startsession
+responses (filter_warning_achievement_from_*), and rom_browser and storage
+know the id too. The achievementsets filter, filter_warning_achievement_
+definitions, keeps achievements by Flags == 3 alone -- so the server's
+warning passes through it, online and from the cache, and an emulator on
+the achievementsets API (RetroArch 1.22) sees every set one larger than the
+site shows, awards 101000001 at every launch ("Achievement 101000001
+awarded, new score: 0") with an unlock toast, and forwards that award to
+RetroAchievements each time, since the server never records it as unlocked.
+
+Drop the warning id in that filter as well, before the Flags test. Cached
+achievementsets bodies are filtered on the way out (handle_offline_request
+and the online path both go through filter_warning_achievements_for_action),
+so a cache that already holds the warning serves sets without it from the
+next launch; nothing else awards or re-awards the id once the emulator no
+longer sees it. The Flags filter is unchanged.
+
+Seen on ROCKNIX (fork issue maxengel/rocknix#166) with the proxy at
+64d03d30633ca6e7719c26d732cef3c97dedcc27: three homebrew sets read 29/7/13
+through the proxy against 28/6/12 direct, the extra being 101000001, awarded
+five seconds into every proxied session. The Android filter
+(ProxyServer.kt filterWarningAchievementDefinitions) has the same shape and
+the same gap. Offered upstream as-is (ROCKNIX D-RA-002, D-RA-003: whatever
+the fork changes in the proxy goes back).
+
+--- a/linux/raofflineproxy/rom_cache.py
++++ b/linux/raofflineproxy/rom_cache.py
+@@ -37,6 +37,12 @@ def filter_warning_achievement_ids(ids: list[int]) -> list[int]:
+ 
+ 
+ def filter_warning_achievement_definitions(payload: dict) -> dict:
++    # RetroAchievements prepends its client warning (CLIENT_WARNING_ID,
++    # "Warning: Casual Only" for a client it allows casual unlocks from) to
++    # the first set with Flags=3, the same flag as a core achievement, so the
++    # Flags filter below keeps it. Drop it by id as the patch, unlocks and
++    # startsession filters do, or the emulator counts it in the set and
++    # awards it a few seconds into every session.
+     filtered_payload = json.loads(json.dumps(payload))
+ 
+     sets = filtered_payload.get("Sets")
+@@ -53,6 +59,7 @@ def filter_warning_achievement_definitions(payload: dict) -> dict:
+                 achievement
+                 for achievement in achievements
+                 if isinstance(achievement, dict)
++                and achievement.get("ID") != WARNING_ACHIEVEMENT_ID
+                 and achievement.get("Flags", RC_ACHIEVEMENT_FLAG_CORE) == RC_ACHIEVEMENT_FLAG_CORE
+             ]
+ 
diff --git a/projects/ROCKNIX/packages/network/raofflineproxy/patches/003-flush-stamp.patch b/projects/ROCKNIX/packages/network/raofflineproxy/patches/003-flush-stamp.patch
new file mode 100644
index 0000000000..bcc47036d5
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/raofflineproxy/patches/003-flush-stamp.patch
@@ -0,0 +1,81 @@
+flusher: leave a stamp after a flush that sent awards, for the OS to read
+
+An OS that integrates the service natively wants to tell the player, on a
+surface of its own, that the awards earned without a connection have now
+reached RetroAchievements. The service knows exactly when that happens --
+flush_pending_awards logs "Flush complete: ... flushed=N" -- but a log is not
+a signal another process can consume: it rotates, it holds every request
+line, and reading it back for one event is guesswork.
+
+So, after a flush that sent at least one award, write <CONFIG_DIR>/last-flush
+holding one line, "<epoch> <flushed>", whole or not at all (a temp file and
+os.replace, as es_export does for cached_game_ids.txt). A flush that sent
+nothing writes nothing: a stamp means awards went. The reader removes the
+file once it has said so, which is what makes the message fire once per
+flush rather than once per look. Nothing in the service reads it.
+
+Written for ROCKNIX (fork issue maxengel/rocknix#173), whose EmulationStation
+reads and clears the stamp when its next sync card runs: "OFFLINE
+ACHIEVEMENTS HAVE BEEN SENT TO RETROACHIEVEMENTS." Offered upstream as-is
+(ROCKNIX D-RA-002: whatever the fork changes in the proxy goes back); the
+same file would serve the KNULLI integration, which already reads
+cached_game_ids.txt.
+
+--- a/linux/raofflineproxy/flusher.py
++++ b/linux/raofflineproxy/flusher.py
+@@ -2,13 +2,14 @@ from __future__ import annotations
+ 
+ import json
+ import logging
++import os
+ import time
+ from dataclasses import dataclass
+ 
+ from . import cache_keys
+ from .auth import resolve_credentials
+ from .award_signing import public_key_base64, sign_award, verify_award
+-from .config import FALLBACK_USER_AGENT, MAX_PROXY_PORT, upstream_host
++from .config import CONFIG_DIR, FALLBACK_USER_AGENT, MAX_PROXY_PORT, upstream_host
+ from .network import build_api_url, http_post
+ from .rom_cache import (
+     CacheGameAuthError,
+@@ -39,6 +40,11 @@ from .utils import (
+ MAX_RETRIES = 5
+ GENESIS_HASH = "genesis"
+ MAX_AWARD_OFFSET_SECONDS = 14 * 24 * 60 * 60
++# "<epoch> <flushed>", written after a flush that sent at least one award, for
++# an OS integration to read (and remove, once it has told the player) -- the
++# same kind of file as es_export's cached_game_ids.txt. The log says the same
++# thing, but a log is not a signal anyone else can consume.
++FLUSH_STAMP_FILE = CONFIG_DIR / "last-flush"
+ LOGGER = logging.getLogger("raofflineproxy")
+ 
+ 
+@@ -486,6 +492,8 @@ def flush_pending_awards(storage: Storage, config_data: dict) -> FlushOutcome:
+         skipped_stale,
+         pending_remaining,
+     )
++    if flushed:
++        write_flush_stamp(flushed)
+ 
+     return FlushOutcome(
+         flushed=flushed,
+@@ -496,6 +504,18 @@ def flush_pending_awards(storage: Storage, config_data: dict) -> FlushOutcome:
+     )
+ 
+ 
++def write_flush_stamp(flushed: int) -> None:
++    # Whole or not at all: a reader on another thread or in another process
++    # must never see half a line.
++    try:
++        CONFIG_DIR.mkdir(parents=True, exist_ok=True)
++        tmp_path = FLUSH_STAMP_FILE.with_name(FLUSH_STAMP_FILE.name + ".tmp")
++        tmp_path.write_text(f"{int(time.time())} {int(flushed)}\n")
++        os.replace(tmp_path, FLUSH_STAMP_FILE)
++    except Exception:
++        LOGGER.exception("Failed to write the flush stamp")
++
++
+ def purge_processed_awards_if_safe(storage: Storage) -> None:
+     if storage.pending_awards_exist_by_status(PENDING_AWARD_STATUS_PENDING):
+         return
