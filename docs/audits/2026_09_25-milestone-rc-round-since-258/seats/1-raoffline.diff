++            # <target>.tmp, so one's rename moved the other's half-written
++            # bytes into place and one's cleanup unlinked the other's file.
++            # os.replace, so the second to finish overwrites the first's
++            # identical bytes rather than failing on an existing target.
++            tmp = target.with_name(
