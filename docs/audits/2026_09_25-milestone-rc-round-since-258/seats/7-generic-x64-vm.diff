+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
+
+### GENERIC_X64 ROCKNIX service fixes
+### Addresses ROCKNIX-specific service failures seen in boot logs
+
+# Fix rocknix-automount service issues
+if [ -f /usr/lib/systemd/system/rocknix-automount.service ]; then
+    # Create override directory
+    mkdir -p /etc/systemd/system/rocknix-automount.service.d
+    
+    cat <<EOF >/etc/systemd/system/rocknix-automount.service.d/10-generic-x64.conf
+[Unit]
+# Add dependencies to ensure proper startup order
+After=systemd-udevd.service systemd-journald.service
+Wants=systemd-udevd.service
+
+[Service]
+# Increase timeout for slower desktop hardware
+TimeoutStartSec=30s
+TimeoutStopSec=15s
+
+# Restart policy for failed mounts
+Restart=on-failure
+RestartSec=5s
+EOF
+fi
+
+# Fix plymouth communication issues
+if [ -f /usr/lib/systemd/system/plymouth-start.service ]; then
+    mkdir -p /etc/systemd/system/plymouth-start.service.d
+    
+    cat <<EOF >/etc/systemd/system/plymouth-start.service.d/10-generic-x64.conf
+[Unit]
+# Reduce plymouth dependency conflicts
+ConditionKernelCommandLine=!plymouth.enable=0
+
+[Service]
+# Handle communication failures gracefully
+ExecStartPre=/bin/sh -c 'test -e /dev/fb0 || exit 0'
+TimeoutStartSec=10s
+EOF
+fi
+
+# Create additional D-Bus service coordination
+mkdir -p /etc/systemd/system/dbus.service.d
+
+cat <<EOF >/etc/systemd/system/dbus.service.d/10-generic-x64.conf
+[Unit]
+# Improve D-Bus startup coordination with systemd services
+After=systemd-journald.service systemd-hostnamed.service
+Before=systemd-logind.service
+
+[Service]
+# Handle D-Bus communication timeouts better
+TimeoutStartSec=15s
+Restart=on-failure
+RestartSec=2s
+EOF
+
+# Fix systemd-hostnamed persistent issues
+mkdir -p /etc/systemd/system/systemd-hostnamed.service.d
+
+cat <<EOF >/etc/systemd/system/systemd-hostnamed.service.d/20-generic-x64-enhanced.conf
+[Unit]
+# Enhanced coordination with D-Bus and journald
+After=systemd-journald.service dbus.service
+Requisite=dbus.service
+
+[Service]
+# More aggressive restart and timeout handling
+TimeoutStartSec=10s
+TimeoutStopSec=5s
+Restart=always
+RestartSec=1s
+StartLimitBurst=10
+StartLimitIntervalSec=60s
+
+# Ensure clean process management
+KillMode=mixed
+KillSignal=SIGTERM
+FinalKillSignal=SIGKILL
+SendSIGKILL=yes
+EOF
+
+# Enhanced journald configuration for early boot
+mkdir -p /etc/systemd/journald.conf.d
+
+cat <<EOF >/etc/systemd/journald.conf.d/10-generic-x64-early.conf
+[Journal]
+# Early boot journald fixes for EPOLLHUP issues
+Storage=persistent
+Compress=no
+Seal=no
+SplitMode=none
+
+# Conservative limits to avoid file descriptor exhaustion
+SystemMaxUse=32M
+SystemKeepFree=64M
+RuntimeMaxUse=16M
+RuntimeKeepFree=32M
+
+# Reduce EPOLLHUP triggers
+SyncIntervalSec=10min
+RateLimitInterval=60s
+RateLimitBurst=1000
+
+# Disable problematic features
+ForwardToSocket=no
+Audit=no
+EOF
+
+echo "ROCKNIX service fixes applied for GENERIC_X64"
