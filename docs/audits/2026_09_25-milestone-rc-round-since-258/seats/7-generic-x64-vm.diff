+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
+
+### GENERIC_X64 Complete Rescue Mode Disable
+### Prevents hardcoded path issues by completely disabling rescue functionality
+
+echo "Completely disabling rescue modes for GENERIC_X64..."
+
+# Remove rescue and emergency targets/services entirely
+systemctl mask rescue.target
+systemctl mask emergency.target
+systemctl mask rescue.service
+systemctl mask emergency.service
+
+# Create stub services that just continue to default.target
+mkdir -p /lib/systemd/system
+
+# Replace rescue.target with a stub that goes to default.target
+cat <<EOF >/lib/systemd/system/rescue.target
+[Unit]
+Description=Rescue Mode (Disabled - GENERIC_X64)
+Requires=sysinit.target
+After=sysinit.target
+AllowIsolate=yes
+DefaultDependencies=no
+
+[Install]
+Alias=rescue.target
+EOF
+
+# Replace emergency.target with a stub that goes to default.target
+cat <<EOF >/lib/systemd/system/emergency.target
+[Unit]
+Description=Emergency Mode (Disabled - GENERIC_X64)
+Requires=sysinit.target
+After=sysinit.target
+AllowIsolate=yes
+DefaultDependencies=no
+
+[Install]
+Alias=emergency.target
+EOF
+
+echo "Rescue modes completely disabled for GENERIC_X64"
\ No newline at end of file
