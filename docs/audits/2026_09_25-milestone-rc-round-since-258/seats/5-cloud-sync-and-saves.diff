+
+usage() {
+    sed -n '/^# Exactly one mode per invocation:/,/^# never branches/p' "$0" | sed 's/^# \{0,1\}//'
+}
+
+usage_error() {
+    echo "cloud_capture: $1" >&2
+    log_message "usage: $1" "false" "ERROR"
+    MODE="${MODE:-usage}"
