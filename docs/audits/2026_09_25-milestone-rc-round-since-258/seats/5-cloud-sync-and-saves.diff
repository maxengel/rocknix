+	CHECK(unit.kind == ProtocolKind::Unit);
+	CHECK(unit.text == "nes");
+	CHECK(unit.number == 2);
+	CHECK(unit.count == 5);
+
+	// A phase announces itself with its counts empty ("SAVES||"): one item,
