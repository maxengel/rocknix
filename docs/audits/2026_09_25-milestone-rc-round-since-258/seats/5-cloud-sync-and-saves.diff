   cp ${PKG_BUILD}/${PKG_RCLONE} ${INSTALL}/usr/bin/
   chmod 0755 ${INSTALL}/usr/bin/*
   cp cloud_sync-rules.txt ${INSTALL}/usr/config/
@@ -47,7 +87,13 @@ makeinstall_target() {
