+	// A hyphen inside a word is not a trailing clause.
+	CHECK(shortenWhy("YOUR SIGN-IN MAY HAVE EXPIRED") == "");
+
+	// The dash wins over the others, and the parenthesis over the stop.
+	CHECK(shortenWhy("A - B (C). D") == "A");
