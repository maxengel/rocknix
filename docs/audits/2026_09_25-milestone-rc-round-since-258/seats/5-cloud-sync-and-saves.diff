+	CHECK(classifyProtocolLine(">>> unit nes|x|y").number == 0);
+	CHECK(classifyProtocolLine(">>> unit nes|x|y").count == 0);
+	CHECK(classifyProtocolLine(">>> unit |2|5").text == "");
