+
+int phaseBar(Phase phase, int percentInPhase)
+{
+	const int p = percentInPhase > 100 ? 100 : percentInPhase;
+	switch (phase)
+	{
+		case Phase::Receiving: return p < 0 ? 0 : p / 2;
+		case Phase::Sending:   return p < 0 ? 50 : 50 + p / 2;
+		default:               return p < 0 ? -1 : p;
+	}
+}
