+TEST_CASE("shortenWhy drops the part that can go")
+{
+	// D-UI-035's worked example: a trailing clause after a dash.
+	CHECK(shortenWhy("COULDN'T REACH YOUR CLOUD - CHECK YOUR SIGN-IN") == "COULDN'T REACH YOUR CLOUD");
