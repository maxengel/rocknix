--- /dev/null
+++ b/projects/ROCKNIX/packages/ui/emulationstation/config/common/es_savestates.cfg
@@ -0,0 +1,26 @@
+<?xml version="1.0"?>
+<!--
+  Save state layout for EmulationStation's save state manager (es-app/src/SaveStateConfigFile.cpp).
+
+  Batocera's libretro entry (package/batocera/emulationstation/batocera-emulationstation/
+  es_savestates.cfg), under the emulator name ROCKNIX's es_systems.cfg gives RetroArch:
+  "retroarch", where Batocera's systems say "libretro" (SaveStateRepository::isEnabled tests
+  the same name). Every other attribute is Batocera's, verbatim.
+
+  With this file present the interface hands the launcher "-state_slot N -state_file <file>"
+  and parks nothing; runemu.sh and setsettings.sh turn a .auto file into RetroArch's
+  savestate_auto_load and any other into its entry slot, "-e N", so the slot you launch is
+  the one RetroArch loads and the exit auto save is RetroArch's own, kept whatever tile the
+  game was started from (fork #196, D-UI-057). Without it the interface falls back to its
+  built-in layout, whose "racommands" path restores the pre-launch auto save at exit and
+  loses the quit state.
+
+  Managed with the OS, like es_systems.cfg: userconfig-setup leaves it out of the
+  first-boot copy and links it into /storage/.config/emulationstation; post-update
+  moves any copy aside (last_es_savestates.cfg) and links it after every update. Both
+  paths end on the link (audit #258 PL-001: the first-boot exclusion was missing, so a
+  fresh device held a copy until its first update).
+-->
+<savestates>
+  <emulator name="retroarch"   directory="{{system}}" file="{{romfilename}}.state{{slot}}" image="{{romfilename}}.state{{slot}}.png" nofileextension="true" firstslot="0" autosave="true" autosave_file="{{romfilename}}.state.auto" autosave_image="{{romfilename}}.state.auto.png" incremental="true" />
+</savestates>


