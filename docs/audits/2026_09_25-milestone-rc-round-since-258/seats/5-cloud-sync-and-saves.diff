+}
+
+# ---------------------------------------------------------------------------
+# STEP 0 -- parse
+# ---------------------------------------------------------------------------
+SYSTEM=""; ROM=""; EMULATOR=""; CORE=""; STARTED=""; EXITCODE="?"
+HAVE_SYSTEM=0; HAVE_ROM=0; HAVE_EMU=0; HAVE_CORE=0; HAVE_STARTED=0; HAVE_EXIT=0
+RETIRE_PATHS=()
+RETIRE_ACCEPTED=()   # the --retire arguments retire_rel accepted; the only ones --unlink may remove
+UNLINK=0; ADOPT_DEST=""; ADOPT_SRC=""
+# The argv as given, kept whole for the one re-run a lost write earns.
+ORIG_ARGS=("$@")
+
+set_mode() {
+    if [ -n "${MODE}" ] && [ "${MODE}" != "$1" ]; then
+        usage_error "--${MODE} and --$1 are different modes; pass one"
+    fi
+    MODE="$1"
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --system)   [ $# -ge 2 ] || usage_error "--system needs a value"; SYSTEM="$2"; HAVE_SYSTEM=1; shift 2 ;;
+        --rom)      [ $# -ge 2 ] || usage_error "--rom needs a value"; ROM="$2"; HAVE_ROM=1; shift 2 ;;
+        --emulator) [ $# -ge 2 ] || usage_error "--emulator needs a value"; EMULATOR="$2"; HAVE_EMU=1; shift 2 ;;
+        --core)     [ $# -ge 2 ] || usage_error "--core needs a value"; CORE="$2"; HAVE_CORE=1; shift 2 ;;
+        --started)  [ $# -ge 2 ] || usage_error "--started needs a value"; STARTED="$2"; HAVE_STARTED=1; shift 2 ;;
+        --exit)     [ $# -ge 2 ] || usage_error "--exit needs a value"; EXITCODE="$2"; HAVE_EXIT=1; shift 2 ;;
+        --rescan)   set_mode "rescan"; shift ;;
+        --full)     set_mode "full"; shift ;;
+        --retire)
+            set_mode "retire"; shift
+            # The paths follow, --unlink among them or before them: the
+            # manager sends `--retire --unlink STATE PNG` (CAP13 caught the
+            # first cut collecting nothing past --unlink and exiting 2).
+            while [ $# -gt 0 ]; do
+                case "$1" in
+                    --unlink) UNLINK=1; shift ;;
+                    --*) break ;;
+                    *)   RETIRE_PATHS+=("$1"); shift ;;
+                esac
+            done
+            ;;
+        --unlink)   UNLINK=1; shift ;;
+        --adopt)    set_mode "adopt"; [ $# -ge 2 ] || usage_error "--adopt needs a PATH"; ADOPT_DEST="$2"; shift 2 ;;
+        --from)     [ $# -ge 2 ] || usage_error "--from needs a PATH"; ADOPT_SRC="$2"; shift 2 ;;
+        -h|--help)  usage; exit 0 ;;
+        *)          usage_error "unknown argument: $1" ;;
+    esac
+done
+
+[ -n "${MODE}" ] || MODE="exit"
+
+case "${MODE}" in
+    exit)
+        [ "${HAVE_SYSTEM}" -eq 1 ]  || usage_error "--system is required"
+        [ "${HAVE_ROM}" -eq 1 ]     || usage_error "--rom is required"
+        [ "${HAVE_EMU}" -eq 1 ]     || usage_error "--emulator is required"
+        [ "${HAVE_CORE}" -eq 1 ]    || usage_error "--core is required (an empty value records the emulator's name)"
+        [ "${HAVE_STARTED}" -eq 1 ] || usage_error "--started EPOCH is required (0 records every member)"
+        case "${STARTED}" in ''|*[!0-9]*) usage_error "--started must be a non-negative integer, got '${STARTED}'" ;; esac
+        [ -n "${SYSTEM}" ]   || usage_error "--system must not be empty"
+        [ -n "${ROM}" ]      || usage_error "--rom must not be empty"
+        if [ -z "${EMULATOR}" ]; then
+            # A system with no <emulators> element (tools, imageviewer) exits
+            # through the same path with an empty pair. Nothing there writes
+            # a save, so there is nothing to record and no failure to stamp.
+            log_debug "no emulator for ${SYSTEM}; nothing recorded"
+            finish 0
+        fi
+        case "${EMULATOR}" in
+            __all__) usage_error "--emulator ${EMULATOR} is not an emulator" ;;
+        esac
+        # Section 6: core is never empty; a standalone is its own core.
+        [ -n "${CORE}" ] || CORE="${EMULATOR}"
+        ;;
+    rescan)
+        [ "${HAVE_SYSTEM}" -eq 1 ] || usage_error "--rescan needs --system"
+        [ "${HAVE_ROM}" -eq 1 ]    || usage_error "--rescan needs --rom"
+        [ -n "${SYSTEM}" ]   || usage_error "--system must not be empty"
+        [ -n "${ROM}" ]      || usage_error "--rom must not be empty"
+        if [ "${HAVE_EMU}" -eq 1 ] || [ "${HAVE_CORE}" -eq 1 ] || [ "${HAVE_STARTED}" -eq 1 ] || [ "${HAVE_EXIT}" -eq 1 ]; then
+            usage_error "--rescan takes no --emulator/--core/--started/--exit: no game ran, there is no frozen pair"
+        fi
+        ;;
+    full)
+        if [ "${HAVE_SYSTEM}" -eq 1 ] || [ "${HAVE_ROM}" -eq 1 ] || [ "${HAVE_EMU}" -eq 1 ] \
+            || [ "${HAVE_CORE}" -eq 1 ] || [ "${HAVE_STARTED}" -eq 1 ] || [ "${HAVE_EXIT}" -eq 1 ]; then
+            usage_error "--full takes no game context"
+        fi
+        ;;
+    retire)
+        [ "${#RETIRE_PATHS[@]}" -gt 0 ] || usage_error "--retire needs at least one PATH"
+        if [ "${HAVE_SYSTEM}" -eq 1 ] || [ "${HAVE_ROM}" -eq 1 ] || [ "${HAVE_EMU}" -eq 1 ] \
+            || [ "${HAVE_CORE}" -eq 1 ] || [ "${HAVE_STARTED}" -eq 1 ] || [ "${HAVE_EXIT}" -eq 1 ]; then
+            usage_error "--retire takes no game context"
+        fi
+        ;;
+    adopt)
+        [ -n "${ADOPT_DEST}" ] || usage_error "--adopt needs a PATH"
+        [ -n "${ADOPT_SRC}" ]  || usage_error "--adopt needs --from PATH"
+        { [ "${HAVE_SYSTEM}" -eq 1 ] && [ -n "${SYSTEM}" ]; } || usage_error "--adopt needs --system"
+        { [ "${HAVE_ROM}" -eq 1 ] && [ -n "${ROM}" ]; }       || usage_error "--adopt needs --rom"
+        if [ "${HAVE_EMU}" -eq 1 ] || [ "${HAVE_CORE}" -eq 1 ] || [ "${HAVE_STARTED}" -eq 1 ] || [ "${HAVE_EXIT}" -eq 1 ]; then
+            usage_error "--adopt takes no --emulator/--core/--started/--exit: no game ran"
+        fi
+        ;;
+esac
+if [ "${UNLINK}" -eq 1 ] && [ "${MODE}" != "retire" ]; then
+    usage_error "--unlink goes with --retire"
+fi
+if [ -n "${ADOPT_SRC}" ] && [ "${MODE}" != "adopt" ]; then
+    usage_error "--from goes with --adopt"
+fi
+
+# Exit mode's stdout is EmulationStation's pipe; keep it empty. The other
+# modes talk when somebody is at a terminal.
+if [ "${MODE}" != "exit" ] && [ -t 1 ]; then
+    ECHO_TO_SCREEN="true"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 0 -- preflight
+# ---------------------------------------------------------------------------
+[ -x "${JQ}" ] || JQ="$(command -v jq 2>/dev/null)"
+if [ -z "${JQ}" ] || [ ! -x "${JQ}" ]; then
+    log_error "jq is not on this image; nothing recorded"
+    finish 1 "jq-missing"
+fi
+
+if [ -z "${HW_DEVICE}" ]; then
+    HW_DEVICE="$(grep -m1 '^HW_DEVICE=' /etc/os-release 2>/dev/null | cut -d'"' -f2)"
+    export HW_DEVICE
+fi
+
+ROOT="$(saves_path)"
+ROOT="${ROOT%/}"
+if [ ! -d "${ROOT}" ]; then
+    log_error "saves folder ${ROOT} is not present; nothing recorded"
+    finish 1 "saves-root-missing"
+fi
+
+# The root-relative form of a --retire argument, or 1 for a path outside the
+# saves folder and 2 for one that is not plain (.., ., //).
+retire_rel() {
+    local p="$1"
+    case "${p}" in
+        "${ROOT}/"*) p="${p#"${ROOT}/"}" ;;
+        /*) return 1 ;;
+    esac
+    case "/${p}/" in *"/../"*|*"/./"*|"//"*) return 2 ;; esac
+    printf '%s' "${p}"
+}
+
+# --retire: which arguments this run may act on is decided here, before the
+# manifest is opened, so finish() knows what --unlink may remove however the
+# record goes -- D-CLOUD-133 keeps the deletion whatever the record said,
+# D-CLOUD-053 keeps every write of this script under the saves folder, and a
+# path that fails retire_rel is refused both the row (below) and the rm.
+if [ "${MODE}" = "retire" ]; then
+    for _raw in "${RETIRE_PATHS[@]}"; do
+        retire_rel "${_raw}" >/dev/null && RETIRE_ACCEPTED+=("${_raw}")
+    done
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 3 (exit/rescan) -- locate the unit. Before the device id, the stage
+# and the card check on purpose: an exit of an emulator with no layout row
+# (ppsspp-sa, flycast-sa, every standalone but N64) then costs a stat and a
+# sed, not an ethtool walk over every interface and a blkid.
+# ---------------------------------------------------------------------------
+# Versioned members of the scanned unit(s): rel path -> kind / slot / unit.
+declare -A M_KIND M_SLOT M_UNIT
+M_PATHS=()
+PRE_EXISTING=0
+
+# The layout row for --emulator: candidate paths, kept when they are regular
+# files. The unit is what the emulator writes, keyed by the emulator that
+# wrote it, so a libretro exit cannot stamp a standalone's files.
+add_member() {
+    local rel="$1" kind="$2" slot="$3" unit="$4"
+    [ -f "${ROOT}/${rel}" ] || return 0
+    [ -n "${M_KIND[${rel}]}" ] && return 0
+    M_PATHS+=("${rel}")
+    M_KIND["${rel}"]="${kind}"
+    M_SLOT["${rel}"]="${slot}"
+    M_UNIT["${rel}"]="${unit}"
+}
+
+# Row `retroarch` (libretro): the in-game save beside the ROM, the states in
+# the flat per-system directory (setsettings.sh forces savestate_directory to
+# savestates/<system> whatever subfolder the ROM sits in).
+row_retroarch() {
+    local system="$1" romstem="$2" dir="$3" unit="$4" f n rest slot
+    add_member "${dir}${romstem}.srm" "save" "-" "${unit}"
+    # Only the trailing * expands; the quoted stem is literal even as a glob,
+    # so "<stem>x.state9" is never matched.
+    shopt -s nullglob
+    for f in "${ROOT}/savestates/${system}/${romstem}".state*; do
+        n="${f##*/}"
+        case "${n}" in
+            "${romstem}.state"*) rest="${n#"${romstem}.state"}" ;;
+            *) continue ;;
+        esac
+        # .state, .state<N>, .state.auto and each one's .png; nothing else --
+        # not .state.auto.bak (ES's launch-time swap), not .state12.auto.
+        [[ "${rest}" =~ ^([0-9]*|\.auto)(\.png)?$ ]] || continue
+        case "${rest}" in
+            *.png) continue ;;   # a sidecar: declared, never an entry
+        esac
+        if [ "${rest}" = ".auto" ]; then
+            add_member "savestates/${system}/${n}" "auto" "-" "${unit}"
+        else
+            [ -n "${rest}" ] && slot="$(( 10#${rest} ))" || slot=0
+            add_member "savestates/${system}/${n}" "state" "${slot}" "${unit}"
+        fi
+    done
+    shopt -u nullglob
+}
+
+# Row `mupen64plus` (standalone N64). Every shipped mupen64plus.cfg sets
+# SaveSRAMPath beside the ROM; <romdir>/save/ is the directory the allowlist
+# has named for years, admitted so a config pointing there is not unrecorded.
+row_mupen64plus() {
+    local romstem="$1" dir="$2" unit="$3" ext
+    for ext in eep mpk sra fla; do
+        add_member "${dir}${romstem}.${ext}" "save" "-" "${unit}"
+        add_member "${dir}save/${romstem}.${ext}" "save" "-" "${unit}"
+    done
+}
+
+# `__all__` is the internal key --rescan walks every row under; exit mode
+# refuses it as an --emulator value, so it can never be recorded.
+locate_unit() {
+    local system="$1" rom="$2" emulator="$3"
+    local rom_base romstem romdir rel unit dir
+    rom_base="${rom##*/}"
+    romstem="${rom_base%.*}"
+    case "${rom}" in
+        "${ROOT}/"*)
+            rel="${rom#"${ROOT}/"}"
+            case "${rel}" in
+                */*) romdir="${rel%/*}" ;;
+                *)   romdir="" ;;
+            esac
+            ;;
+        *) romdir="${system}" ;;
+    esac
+    unit="${system}:${romstem}"
+    UNIT="${unit}"
+    dir="${romdir:+${romdir}/}"
+    case "${emulator}" in
+        retroarch)   row_retroarch "${system}" "${romstem}" "${dir}" "${unit}" ;;
+        mupen64plus) row_mupen64plus "${romstem}" "${dir}" "${unit}" ;;
+        __all__)     row_retroarch "${system}" "${romstem}" "${dir}" "${unit}"
+                     row_mupen64plus "${romstem}" "${dir}" "${unit}" ;;
+        *)           return 1 ;;
+    esac
+    return 0
+}
+
+# A state's sidecar: its relative path when the file exists now, else "".
+screenshot_of() {
+    local rel="$1" kind="$2"
+    case "${kind}" in
+        state|auto) [ -f "${ROOT}/${rel}.png" ] && printf '%s' "${rel}.png" ;;
+    esac
+    return 0
+}
+
+# The root-relative form of an absolute path under the saves folder, or 1
+# for one outside it and 2 for one that is not plain (.., ., //).
+rel_of() {
+    local p="$1"
+    case "${p}" in
+        "${ROOT}/"*) p="${p#"${ROOT}/"}" ;;
+        /*) return 1 ;;
+    esac
+    case "/${p}/" in *"/../"*|*"/./"*|"//"*) return 2 ;; esac
+    printf '%s' "${p}"
+}
+
+# Version order, so a downward renumber is resolved lowest slot first
+# (state2 before state10); byte order would put state10 first. busybox sort
+# has no -V (CONFIG_FEATURE_SORT_BIG is unset) and /usr/bin/sort is GNU on
+# this image; asserted rather than assumed, so a sort without -V degrades to
+# byte order instead of to a silent empty run.
+if printf 'a\n' | LC_ALL=C sort -V >/dev/null 2>&1; then
+    sort_paths() { LC_ALL=C sort -V; }
+else
+    sort_paths() { LC_ALL=C sort; }
+    log_debug "sort has no -V; members are processed in byte order"
+fi
+
+case "${MODE}" in
+    exit|rescan|adopt)
+        # --rescan has no --emulator (no game ran), so it walks every row: a
+        # member may now sit at a path with no entry after a renumber, and a
+        # MOVE is the only op allowed to adopt it.
+        if ! locate_unit "${SYSTEM}" "${ROM}" "${EMULATOR:-__all__}"; then
+            log_debug "no unit layout for emulator ${EMULATOR}; nothing recorded"
+            finish 0
+        fi
+        if [ "${#M_PATHS[@]}" -eq 0 ]; then
+            log_debug "no members on disk for ${UNIT}"
+            finish 0
+        fi
+        ;;
+esac
+ADOPT_REL=""; ADOPT_SRC_REL=""
+if [ "${MODE}" = "adopt" ]; then
+    # Both paths must be this unit's: the copy the manager made, and the
+    # slot it was made from. The layout row decides membership, so a path
+    # that is not a state of this game is not adopted by any argument.
+    ADOPT_REL="$(rel_of "${ADOPT_DEST}")" || { log_warn "${ADOPT_DEST} is not a plain path under ${ROOT}; nothing recorded"; finish 1 "adopt-outside-root"; }
+    ADOPT_SRC_REL="$(rel_of "${ADOPT_SRC}")" || { log_warn "${ADOPT_SRC} is not a plain path under ${ROOT}; nothing recorded"; finish 1 "adopt-outside-root"; }
+    if [ -z "${M_KIND[${ADOPT_REL}]}" ]; then
+        log_warn "${ADOPT_REL} is not a member of ${UNIT} on disk; nothing recorded"
+        finish 3 "adopt-not-a-member"
+    fi
+    case "${M_KIND[${ADOPT_REL}]}" in
+        state|auto) ;;
+        *) log_warn "${ADOPT_REL} is a ${M_KIND[${ADOPT_REL}]}, not a state; nothing recorded"; finish 3 "adopt-not-a-member" ;;
+    esac
+fi
+
+DEVICE_ID_BIN="$(_sib cloud_device_id)"
+DEVICE_ID=""
+if [ -x "${DEVICE_ID_BIN}" ]; then
+    DEVICE_ID="$("${DEVICE_ID_BIN}" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')"
+else
+    log_warn "cloud_device_id is missing beside $0 and in /usr/bin"
+fi
+if [ -z "${DEVICE_ID}" ]; then
+    DEVICE_ID="device-unknown"
+    log_warn "device id could not be read; recording as ${DEVICE_ID}"
+fi
+MANIFEST="${CACHE}/manifest-${DEVICE_ID}.json"
+
+mkdir -p "${STAGE}" 2>/dev/null
+if [ ! -d "${STAGE}" ] || [ ! -w "${STAGE}" ] || [ ! -w "${CACHE}" ]; then
+    log_error "${STAGE} is not writable; nothing recorded"
+    finish 1 "stage-unwritable"
+fi
+
+# The working copy follows a healed id (#86). cloud_device_id renames a
+# device whose stored hash was the shared constant, and the call above is
+# where that happens on the boot pass -- so the manifest written under the
+# old id, with every save's provenance recorded since #21, would sit unread
+# beside an empty manifest-<new id>.json. Read both shapes, write the new
+# one: when nothing sits under the current id, the first manifest found
+# under a name this device was healed away from (cloud_device_id --previous,
+# .previous lines first) is renamed to the current name. Every file in this
+# directory was written by this device, so a manifest named for one of those
+# ids is this device's own. Once, and never over an existing file; a second
+# run finds the current name present and does nothing. A helper from before
+# --previous existed answers it with the current id, which is skipped.
+if [ ! -e "${MANIFEST}" ] && [ -x "${DEVICE_ID_BIN}" ]; then
+    while IFS= read -r _prev; do
+        [ -n "${_prev}" ] || continue
+        [ "${_prev}" != "${DEVICE_ID}" ] || continue
+        _old="${CACHE}/manifest-${_prev}.json"
+        [ -f "${_old}" ] || continue
+        if [ ! -e "${MANIFEST}" ] && mv -f "${_old}" "${MANIFEST}" 2>/dev/null && [ -f "${MANIFEST}" ]; then
+            log_info "adopted ${_old} as ${MANIFEST}: the device id was healed (#86) and the working copy follows it"
+        elif [ -f "${MANIFEST}" ]; then
+            # The boot pass and a game-exit capture can both be here; the
+            # second finds the rename done.
+            log_debug "${MANIFEST} appeared while adopting ${_old}; a concurrent run got there first"
+        else
+            log_warn "could not adopt ${_old} as ${MANIFEST}; starting from an empty document"
+        fi
+        break
+    done < <("${DEVICE_ID_BIN}" --previous 2>/dev/null | tr -cd 'A-Za-z0-9_.\n-')
+fi
+
+# A killed run's litter: every scratch file carries its writer's pid.
+for _f in "${STAGE}"/.tmp.* "${CACHE}"/.ops.* "${CACHE}"/.cand.* "${CACHE}"/.canon.* "${CACHE}"/.manifest.* "${CACHE}"/.capture-failures.* "${CACHE}"/.last-capture.*; do
+    [ -e "${_f}" ] || continue
+    _pid="${_f##*/}"; _pid="${_pid#.*.}"; _pid="${_pid%%.*}"
+    case "${_pid}" in ''|*[!0-9]*) continue ;; esac
+    [ "${_pid}" = "$$" ] && continue
+    [ -d "/proc/${_pid}" ] && continue
+    rm -f "${_f}" 2>/dev/null
+done
+
+OPS="${CACHE}/.ops.$$"
+CAND="${CACHE}/.cand.$$"
+CANON_A="${CACHE}/.canon.$$.a"
+CANON_B="${CACHE}/.canon.$$.b"
+: > "${OPS}"
+
+cleanup() {
+    rm -f "${OPS}" "${CAND}" "${CANON_A}" "${CANON_B}" "${STAGE}"/.tmp.$$.* 2>/dev/null
+}
+trap cleanup EXIT
+
+# ---------------------------------------------------------------------------
+# STEP 1 -- card context (informational; the one refusal is a flip mid-run)
+# ---------------------------------------------------------------------------
+SAVES_ROOT_BIN="$(_sib cloud_saves_root)"
+IDENT0=""
+if [ -x "${SAVES_ROOT_BIN}" ]; then
+    if [ "${MODE}" = "full" ]; then
+        _out="$("${SAVES_ROOT_BIN}" check --wait 10 2>&1)"
+    else
+        _out="$("${SAVES_ROOT_BIN}" check 2>&1)"
+    fi
+    _rc=$?
+    if [ "${_rc}" -eq 0 ]; then
+        IDENT0="$(printf '%s\n' "${_out}" | tail -n 1)"
+        # Anything before the identity is the wait notice.
+        printf '%s\n' "${_out}" | sed '$d' | while IFS= read -r _line; do
+            [ -n "${_line}" ] && log_info "${_line}"
+        done
+    else
+        # The file an emulator wrote is real and its claim belongs in the
+        # manifest (I5); the card is noted, the run continues.
+        CARD="!card"
+        printf '%s\n' "${_out}" | while IFS= read -r _line; do
+            case "${_line}" in
+                ''|"Nothing was transferred"*) ;;
+                *) log_warn "${_line}" ;;
+            esac
+        done
+        IDENT0="$("${SAVES_ROOT_BIN}" identity 2>/dev/null)"
+    fi
+else
+    log_warn "cloud_saves_root is missing beside $0 and in /usr/bin; the card is not checked this run"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 2 -- load the manifest
+# ---------------------------------------------------------------------------
+SRC="/dev/null"
+LIVE0=""
+MANIFEST_EXISTED=0
+MANIFEST_REV1=0
+if [ -f "${MANIFEST}" ]; then
+    MANIFEST_EXISTED=1
+    if "${JQ}" -e 'type == "object" and ((.schema // 1) <= 1) and ((.entries // {}) | type) == "object"' "${MANIFEST}" >/dev/null 2>&1; then
+        SRC="${MANIFEST}"
+        if ! "${JQ}" -e '((.units | type) == "object") and ((.retired | type) == "array")' "${MANIFEST}" >/dev/null 2>&1; then
+            MANIFEST_REV1=1
+        fi
+    else
+        _schema="$("${JQ}" -r 'if type == "object" then (.schema // 1) else "bad" end' "${MANIFEST}" 2>/dev/null)"
+        case "${_schema}" in
+            ''|*[!0-9]*) _schema="bad" ;;
+        esac
+        if [ "${_schema}" != "bad" ] && [ "${_schema}" -gt 1 ]; then
+            log_error "${MANIFEST} was written by a newer schema (${_schema}); nothing recorded"
+            finish 1 "schema-newer"
+        fi
+        _aside="${MANIFEST}.corrupt-$(date +%s)"
+        if mv -f "${MANIFEST}" "${_aside}" 2>/dev/null; then
+            log_error "${MANIFEST} would not parse; moved aside to ${_aside} and starting from an empty document"
+        else
+            log_error "${MANIFEST} would not parse and could not be moved aside; starting from an empty document"
+        fi
+    fi
+    LIVE0="$(stat -c '%i %Y' "${MANIFEST}" 2>/dev/null)"
+fi
+
+# ---------------------------------------------------------------------------
+# Computed once per run: the device object, the clock, the pin map.
+# ---------------------------------------------------------------------------
+NOW="$(date -u +%FT%TZ)"
+_z="$(date +%z)"
+LOCAL_NOW="$(date +%FT%T)${_z:0:3}:${_z:3:2}"
+SYNCED="false"
+[ "$(timedatectl show -p NTPSynchronized --value 2>/dev/null)" = "yes" ] && SYNCED="true"
+
+DEVICE_LABEL=""
+[ -x "${DEVICE_ID_BIN}" ] && DEVICE_LABEL="$("${DEVICE_ID_BIN}" --label 2>/dev/null | tr -cd 'A-Za-z0-9_.-')"
+[ -n "${DEVICE_LABEL}" ] || DEVICE_LABEL="unknown"
+DEVICE_MODEL=""
+for _m in /proc/device-tree/model /sys/firmware/devicetree/base/model; do
+    [ -r "${_m}" ] && DEVICE_MODEL="$(tr -d '\0' < "${_m}" 2>/dev/null)"
+    [ -n "${DEVICE_MODEL}" ] && break
+done
+[ -n "${DEVICE_MODEL}" ] || DEVICE_MODEL="unknown"
+DEVICE_FAMILY="$(grep -m1 '^HW_DEVICE=' /etc/os-release 2>/dev/null | cut -d'"' -f2)"
+[ -n "${DEVICE_FAMILY}" ] || DEVICE_FAMILY="unknown"
+OS_VERSION_STR="$(grep -m1 '^OS_VERSION=' /etc/os-release 2>/dev/null | cut -d'"' -f2)"
+[ -n "${OS_VERSION_STR}" ] || OS_VERSION_STR="unknown"
+DEVICE_JSON="$("${JQ}" -nc --arg id "${DEVICE_ID}" --arg label "${DEVICE_LABEL}" --arg model "${DEVICE_MODEL}" \
+    --arg family "${DEVICE_FAMILY}" --arg os "${OS_VERSION_STR}" \
+    '{id: $id, label: $label, model: $model, family: $family, os_version: $os}')"
+
+# The core's package, exceptions first; then the pin for that package. awk's
+# `$1 == p` is an exact field match, never a pattern.
+core_package() {
+    local core="$1" pkg
+    case "${core}" in
+        ffmpeg|idtech)                                      pkg="" ;;
+        bsnes_hd_beta)                                      pkg="bsnes-hd-lr" ;;
+        DoubleCherryGB)                                     pkg="doublecherrygb-lr" ;;
+        melondsds)                                          pkg="melonds-ds-lr" ;;
+        mupen64plus_next)                                   pkg="mupen64plus-nx-lr" ;;
+        neocd)                                              pkg="neocd_lr" ;;
+        pcsx_rearmed|pcsx_rearmed32)                        pkg="pcsx_rearmed-lr" ;;
+        same_cdi)                                           pkg="same_cdi-lr" ;;
+        snes9x2005_plus)                                    pkg="snes9x2005_plus-lr" ;;
+        smsplus)                                            pkg="smsplus-gx-lr" ;;
+        vice_x64|vice_x128|vice_xpet|vice_xplus4|vice_xvic) pkg="vice-lr" ;;
+        x1)                                                 pkg="xmil-lr" ;;
+        boom3_xp)                                           pkg="boom3-lr" ;;
+        *-sa)                                               pkg="${core}" ;;
+        *)                                                  pkg="${core//_/-}-lr" ;;
+    esac
+    printf '%s' "${pkg}"
+}
+
+core_build_of() {
+    local core="$1" pkg build=""
+    pkg="$(core_package "${core}")"
+    if [ -n "${pkg}" ]; then
+        build="$(awk -v p="${pkg}" '$1 == p { print $2; exit }' "${PINS}" 2>/dev/null)"
+        [ -n "${build}" ] || log_debug "no pin for ${pkg} in ${PINS}"
+    fi
+    [ -n "${build}" ] || build="unknown"
+    printf '%s' "${build}"
+}
+
+core_display_version_of() {
+    sed -n 's/^display_version *= *"\(.*\)"$/\1/p' "${INFO_DIR}/$1_libretro.info" 2>/dev/null | head -1
+}
+
+CORE_BUILD="unknown"
+CORE_DISPLAY=""
+if [ "${MODE}" = "exit" ]; then
+    CORE_BUILD="$(core_build_of "${CORE}")"
+    CORE_DISPLAY="$(core_display_version_of "${CORE}")"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 4 (early) -- every claim in the manifest, one jq call, keyed by path.
+# Fields are joined with \u0001 (not a tab: consecutive tabs collapse under
+# read) so an empty one cannot shift the columns.
+# ---------------------------------------------------------------------------
+declare -A E_SHA E_SIZE E_MTIME E_SLOT E_SHOT E_KIND E_UNIT E_SYSTEM E_ROM E_UNIT_DERIVED
+E_PATHS=()
+if [ "${SRC}" != "/dev/null" ]; then
+    while IFS=$'\001' read -r _p _sha _size _mtime _slot _shot _kind _unit _sys _rom; do
+        [ -n "${_p}" ] || continue
+        E_PATHS+=("${_p}")
+        E_SHA["${_p}"]="${_sha}"
+        E_SIZE["${_p}"]="${_size}"
+        E_MTIME["${_p}"]="${_mtime}"
+        E_SLOT["${_p}"]="${_slot}"
+        E_SHOT["${_p}"]="${_shot}"
+        E_KIND["${_p}"]="${_kind}"
+        E_UNIT["${_p}"]="${_unit}"
+        E_SYSTEM["${_p}"]="${_sys}"
+        E_ROM["${_p}"]="${_rom}"
+        # A rev 1 entry has no unit; its system and rom (both rev 1 fields)
+        # derive the key exit mode would have written, so the upgrade in
+        # place declares it rather than filing it under "-".
+        if [ "${_unit}" = "-" ] && [ "${_sys}" != "-" ] && [ "${_rom}" != "-" ]; then
+            E_UNIT["${_p}"]="${_sys}:${_rom%.*}"
+            E_UNIT_DERIVED["${_p}"]=1
+        fi
+    done < <("${JQ}" -r '.entries // {} | to_entries[]
+        | [ .key,
+            (.value.sha256 // "-"),
+            ((.value.size // -1) | tostring),
+            (.value.mtime // "-"),
+            ((.value.slot // "-") | tostring),
+            (.value.screenshot // "-"),
+            (.value.kind // "-"),
+            (.value.unit // "-"),
+            (.value.system // "-"),
+            (.value.rom // "-") ]
+        | join("\u0001")' "${SRC}" 2>/dev/null)
+fi
+
+# ---------------------------------------------------------------------------
+# Op rendering. Strings through --arg, numbers/bools/nulls through --argjson:
+# `--arg 604` would make the size the string "604".
+# ---------------------------------------------------------------------------
+emit_op() {
+    printf '%s\n' "$1" >> "${OPS}"
+}
+
+# A full entry (entry_fields). $12 empty -> screenshot null; $13 empty ->
+# replaces null; $14 empty -> core_display_version null; $11 "-" -> slot null.
+render_entry() {
+    local kind="$1" sha="$2" size="$3" mtime="$4" system="$5" rom="$6" emulator="$7" core="$8" \
+          core_build="$9" unit="${10}" slot="${11}" shot="${12}" replaces="${13}" display="${14}" \
+          captured_at="${15}" captured_local="${16}" synced="${17}"
+    local slot_json="null"
+    case "${slot}" in ''|-|*[!0-9]*) slot_json="null" ;; *) slot_json="$(( 10#${slot} ))" ;; esac
+    "${JQ}" -nc --arg kind "${kind}" --arg sha "${sha}" --argjson size "${size}" --arg mtime "${mtime}" \
+        --arg captured_at "${captured_at}" --arg captured_local "${captured_local}" --argjson synced "${synced}" \
+        --arg system "${system}" --arg rom "${rom}" --arg emulator "${emulator}" --arg core "${core}" \
+        --arg core_build "${core_build}" --arg display "${display}" --argjson slot "${slot_json}" \
+        --arg shot "${shot}" --arg replaces "${replaces}" --arg unit "${unit}" \
+        '{ kind: $kind, sha256: $sha, size: $size, mtime: $mtime,
+           captured_at: $captured_at, captured_local: $captured_local, clock_synced: $synced,
+           system: $system, rom: $rom, emulator: $emulator, core: $core,
+           core_build: $core_build,
+           core_display_version: (if $display == "" then null else $display end),
+           slot: $slot,
+           screenshot: (if $shot == "" then null else $shot end),
+           replaces: (if $replaces == "" then null else $replaces end),
+           remote_hash: null, unit: $unit, producer: null, published_at: null, pub: null }'
+}
+
+op_put() {
+    local path="$1" entry="$2"
+    emit_op "$("${JQ}" -nc --arg path "${path}" --argjson entry "${entry}" '{op: "put", path: $path, entry: $entry}')"
+}
+
+op_meta() {
+    local path="$1" size="$2" mtime="$3" shot="$4"
+    emit_op "$("${JQ}" -nc --arg path "${path}" --argjson size "${size}" --arg mtime "${mtime}" --arg shot "${shot}" \
+        '{op: "meta", path: $path, size: $size, mtime: $mtime, screenshot: (if $shot == "" then null else $shot end)}')"
+}
+
+op_move() {
+    local from="$1" to="$2" size="$3" mtime="$4" kind="$5" slot="$6" shot="$7"
+    local slot_json="null"
+    case "${slot}" in ''|-|*[!0-9]*) slot_json="null" ;; *) slot_json="$(( 10#${slot} ))" ;; esac
+    emit_op "$("${JQ}" -nc --arg from "${from}" --arg to "${to}" --argjson size "${size}" --arg mtime "${mtime}" \
+        --arg kind "${kind}" --argjson slot "${slot_json}" --arg shot "${shot}" \
+        '{op: "move", from: $from, to: $to, size: $size, mtime: $mtime, kind: $kind, slot: $slot,
+          screenshot: (if $shot == "" then null else $shot end)}')"
+}
+
+# A copy the manager made: the source's entry at a new path, with the new
+# file's own size, mtime, slot and thumbnail, a fresh captured_at, and
+# nothing inherited that belongs to the source's placement (replaces, pub).
+op_copy() {
+    local from="$1" to="$2" size="$3" mtime="$4" kind="$5" slot="$6" shot="$7"
+    local slot_json="null"
+    case "${slot}" in ''|-|*[!0-9]*) slot_json="null" ;; *) slot_json="$(( 10#${slot} ))" ;; esac
+    emit_op "$("${JQ}" -nc --arg from "${from}" --arg to "${to}" --argjson size "${size}" --arg mtime "${mtime}" \
+        --arg kind "${kind}" --argjson slot "${slot_json}" --arg shot "${shot}" \
+        --arg at "${NOW}" --arg local "${LOCAL_NOW}" --argjson synced "${SYNCED}" \
+        '{op: "copy", from: $from, to: $to, size: $size, mtime: $mtime, kind: $kind, slot: $slot,
+          screenshot: (if $shot == "" then null else $shot end), at: $at, local: $local, synced: $synced}')"
+}
+
+op_retire() {
+    local path="$1" sha="$2"
+    emit_op "$("${JQ}" -nc --arg path "${path}" --arg sha "${sha}" --arg at "${NOW}" \
+        '{op: "retire", path: $path, sha256: $sha, at: $at}')"
+}
+
+# The rev 1 -> rev 2 upgrade of one entry: its derived unit, stamped only
+# when the entry still exists after the other ops.
+op_unit() {
+    local path="$1" unit="$2"
+    emit_op "$("${JQ}" -nc --arg path "${path}" --arg unit "${unit}" '{op: "unit", path: $path, unit: $unit}')"
+}
+
+mtime_iso() {
+    date -u -d "@$1" +%FT%TZ 2>/dev/null
+}
+
+# ---------------------------------------------------------------------------
+# STEP 6 -- the seal: an independent copy, hashed, content-addressed. Sets
+# SEAL_SHA / SEAL_SIZE / SEAL_EPOCH; returns 1 when the member is skipped.
+# ---------------------------------------------------------------------------
+SEAL_N=0
+SEAL_SHA=""; SEAL_SIZE=""; SEAL_EPOCH=""
+seal() {
+    local src="$1" tmp s1 s2 try sha size epoch
+    SEAL_SHA=""; SEAL_SIZE=""; SEAL_EPOCH=""
+    try=0
+    while [ "${try}" -lt "${SEAL_RETRIES}" ]; do
+        try=$(( try + 1 ))
+        SEAL_N=$(( SEAL_N + 1 ))
+        tmp="${STAGE}/.tmp.$$.${SEAL_N}"
+        s1="$(stat -c '%s %Y' "${src}" 2>/dev/null)"
+        [ -n "${s1}" ] || { log_error "could not stat ${src}; not recorded this run"; return 1; }
+        if ! cp -p "${src}" "${tmp}" 2>/dev/null; then
+            rm -f "${tmp}" 2>/dev/null
+            log_error "could not copy ${src} into ${STAGE}; not recorded this run"
+            return 1
+        fi
+        s2="$(stat -c '%s %Y' "${src}" 2>/dev/null)"
+        if [ "${s1}" = "${s2}" ]; then
+            break
+        fi
+        rm -f "${tmp}" 2>/dev/null
+        tmp=""
+    done
+    if [ -z "${tmp}" ] || [ ! -f "${tmp}" ]; then
+        log_warn "${src} changed while it was being sealed ${SEAL_RETRIES} times; not recorded this run"
+        return 1
+    fi
+    # Cheap invariant, kept: the seal is a new inode with no other name.
+    # Device and inode together -- an inode number means nothing across
+    # filesystems, and the source is often a second card whose numbers are
+    # synthesised, so a bare match would refuse a valid seal by coincidence.
+    if [ "$(stat -c '%d %i' "${tmp}" 2>/dev/null)" = "$(stat -c '%d %i' "${src}" 2>/dev/null)" ] \
+        || [ "$(stat -c %h "${tmp}" 2>/dev/null)" != "1" ]; then
+        rm -f "${tmp}" 2>/dev/null
+        log_error "seal of ${src} shares the source inode; not recorded this run"
+        return 1
+    fi
+    sha="$( set -o pipefail; sha256sum "${tmp}" | cut -c1-64 )"
+    if [ "${#sha}" -ne 64 ]; then
+        rm -f "${tmp}" 2>/dev/null
+        log_error "hashing the seal of ${src} produced no hash; not recorded this run"
+        return 1
+    fi
+    case "${sha}" in
+        *[!0-9a-f]*)
+            rm -f "${tmp}" 2>/dev/null
+            log_error "hashing the seal of ${src} produced '${sha}'; not recorded this run"
+            return 1
+            ;;
+    esac
+    read -r size epoch <<EOF
+$(stat -c '%s %Y' "${tmp}" 2>/dev/null)
+EOF
+    if [ -e "${STAGE}/${sha}" ]; then
+        rm -f "${tmp}" 2>/dev/null
+    elif ! mv -f "${tmp}" "${STAGE}/${sha}" 2>/dev/null; then
+        rm -f "${tmp}" 2>/dev/null
+        log_error "could not place the seal of ${src} at ${STAGE}/${sha}; not recorded this run"
+        return 1
+    fi
+    SEAL_SHA="${sha}"; SEAL_SIZE="${size}"; SEAL_EPOCH="${epoch}"
+    return 0
+}
+
+# A verify pass hashes every claimed path, and most of them are unchanged.
+# Hash the live file first: bytes the stage already holds (content-addressed,
+# so the name is the proof), or the very version the entry at this path
+# already claims, need no copy -- which keeps --rescan cheap on the
+# manager's thread and the boot --full cheap on the card. Anything else, and
+# a file that moved under the hash, falls through to seal(), whose guard is
+# what makes a torn read impossible to record. Same out-variables as seal().
+known_hash() {
+    local src="$1" rel="$2" s1 s2 sha size epoch
+    SEAL_SHA=""; SEAL_SIZE=""; SEAL_EPOCH=""
+    s1="$(stat -c '%s %Y' "${src}" 2>/dev/null)"
+    [ -n "${s1}" ] || return 1
+    sha="$( set -o pipefail; sha256sum "${src}" 2>/dev/null | cut -c1-64 )"
+    s2="$(stat -c '%s %Y' "${src}" 2>/dev/null)"
+    [ "${s1}" = "${s2}" ] || return 1
+    [ "${#sha}" -eq 64 ] || return 1
+    case "${sha}" in *[!0-9a-f]*) return 1 ;; esac
+    if [ ! -f "${STAGE}/${sha}" ] && [ "${E_SHA[${rel}]}" != "${sha}" ]; then
+        return 1
+    fi
+    read -r size epoch <<EOF
+${s2}
+EOF
+    SEAL_SHA="${sha}"; SEAL_SIZE="${size}"; SEAL_EPOCH="${epoch}"
+    return 0
+}
+
+# ---------------------------------------------------------------------------
+# STEP 3 (full) -- the claimed paths. --full enumerates no directory and
+# adopts no path that has no entry; exit and rescan located their unit
+# before the device and card steps above.
+# ---------------------------------------------------------------------------
+if [ "${MODE}" = "full" ]; then
+    if [ -z "$(find "${ROOT}" -type f -print -quit 2>/dev/null)" ]; then
+        log_error "saves folder ${ROOT} holds no files; a full pass over an empty root is refused, nothing recorded"
+        finish 1 "empty-root"
+    fi
+    for _p in "${E_PATHS[@]}"; do
+        [ -f "${ROOT}/${_p}" ] || continue
+        if [ "${E_UNIT[${_p}]}" = "-" ]; then
+            # A rev 1 entry with neither a unit nor the system and rom to
+            # derive one from: there is no honest key to file it under.
+            log_debug "${_p} has no unit and none can be derived; not hashed by --full"
+            continue
+        fi
+        M_PATHS+=("${_p}")
+        M_KIND["${_p}"]="${E_KIND[${_p}]}"
+        M_SLOT["${_p}"]="${E_SLOT[${_p}]}"
+        M_UNIT["${_p}"]="${E_UNIT[${_p}]}"
+    done
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 5 -- the changed set, then STEP 6 -- seal each candidate
+# ---------------------------------------------------------------------------
+declare -A C_SHA C_SIZE C_EPOCH C_MT
+C_PATHS=()
+SCANNED_UNITS=()
+declare -A SCANNED_UNIT_SEEN
+
+SORTED=()
+if [ "${#M_PATHS[@]}" -gt 0 ]; then
+    mapfile -t SORTED < <(printf '%s\n' "${M_PATHS[@]}" | sort_paths)
+    # A sort that returned nothing would make this run an I8-shaped no-op
+    # with exit 0 -- a guard that fails open. Count what came back.
+    if [ "${#SORTED[@]}" -ne "${#M_PATHS[@]}" ]; then
+        log_error "sorting ${#M_PATHS[@]} member path(s) returned ${#SORTED[@]}; nothing recorded this run"
+        finish 1 "sort-failed"
+    fi
+fi
+
+if [ "${MODE}" = "exit" ] || [ "${MODE}" = "rescan" ] || [ "${MODE}" = "full" ]; then
+    for _m in "${SORTED[@]}"; do
+        [ -n "${_m}" ] || continue
+        _u="${M_UNIT[${_m}]}"
+        if [ -z "${SCANNED_UNIT_SEEN[${_u}]}" ]; then
+            SCANNED_UNIT_SEEN["${_u}"]=1
+            SCANNED_UNITS+=("${_u}")
+        fi
+        read -r _size _epoch <<EOF
+$(stat -c '%s %Y' "${ROOT}/${_m}" 2>/dev/null)
+EOF
+        [ -n "${_epoch}" ] || continue
+        _mt="$(mtime_iso "${_epoch}")"
+        _changed=0
+        if [ -z "${E_SHA[${_m}]}" ]; then
+            case "${MODE}" in
+                exit)
+                    if [ "${_epoch}" -ge "${STARTED}" ]; then
+                        _changed=1
+                    else
+                        PRE_EXISTING=$(( PRE_EXISTING + 1 ))
+                    fi
+                    ;;
+                *) _changed=1 ;;
+            esac
+        elif [ "${MODE}" = "full" ] || [ "${MODE}" = "rescan" ]; then
+            # A verify pass hashes every claimed path: --rescan is --full
+            # narrowed to one unit, and a renumber keeps sizes and mtimes
+            # (renameFile), so size+mtime cannot see which slot moved.
+            _changed=1
+        elif [ "${_size}" != "${E_SIZE[${_m}]}" ] || [ "${_mt}" != "${E_MTIME[${_m}]}" ]; then
+            # Exit mode is size+mtime by requirement; the equal-size,
+            # equal-mtime rewrite is the full pass's job (A2).
+            _changed=1
+        fi
+        [ "${_changed}" -eq 1 ] || continue
+        _known=0
+        case "${MODE}" in
+            rescan|full) known_hash "${ROOT}/${_m}" "${_m}" && _known=1 ;;
+        esac
+        if [ "${_known}" -eq 1 ] || seal "${ROOT}/${_m}"; then
+            C_PATHS+=("${_m}")
+            C_SHA["${_m}"]="${SEAL_SHA}"
+            C_SIZE["${_m}"]="${SEAL_SIZE}"
+            C_EPOCH["${_m}"]="${SEAL_EPOCH}"
+            C_MT["${_m}"]="$(mtime_iso "${SEAL_EPOCH}")"
+        else
+            RC=1; REASON="seal-failed"
+        fi
+    done
+fi
+
+if [ "${PRE_EXISTING}" -gt 0 ]; then
+    log_info "${PRE_EXISTING} pre-existing file(s) of ${UNIT} have no entry and were not stamped"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 7 -- classify: META, then MOVE, then PUT. Destinations in ascending
+# order; a move source must be a same-unit entry whose bytes are no longer
+# where the entry says (its path vanished, or it is itself a candidate that
+# hashed differently).
+# ---------------------------------------------------------------------------
+declare -A MOVED_FROM MOVED_TO MOVE_SRC PUT_AT
+N_PUT=0; N_MOVE=0; N_META=0; N_RETIRE=0; N_COPY=0
+
+# Does the entry at path q still describe the bytes on disk at q?
+entry_holds() {
+    local q="$1"
+    [ -f "${ROOT}/${q}" ] || return 1
+    if [ -n "${C_SHA[${q}]}" ]; then
+        [ "${C_SHA[${q}]}" = "${E_SHA[${q}]}" ] && return 0
+        return 1
+    fi
+    return 0
+}
+
+# Same-unit entries carrying hash $2 that no longer hold their bytes, best
+# first: a vanished source, then the lowest slot, then the first path. One
+# key per candidate, sorted once; the path is the last field because it may
+# contain spaces.
+find_move_source() {
+    local dest="$1" sha="$2" unit="$3" q present slot
+    for q in "${E_PATHS[@]}"; do
+        [ "${q}" = "${dest}" ] && continue
+        [ "${E_SHA[${q}]}" = "${sha}" ] || continue
+        [ "${E_UNIT[${q}]}" = "${unit}" ] || continue
+        [ -n "${MOVED_FROM[${q}]}" ] && continue
+        entry_holds "${q}" && continue
+        present=0; [ -f "${ROOT}/${q}" ] && present=1
+        slot="${E_SLOT[${q}]}"
+        case "${slot}" in ''|-|*[!0-9]*) slot=999999999 ;; esac
+        printf '%d %012d %s\n' "${present}" "$(( 10#${slot} ))" "${q}"
+    done | LC_ALL=C sort | head -n 1 | cut -d' ' -f3-
+}
+
+for _p in "${C_PATHS[@]}"; do
+    _sha="${C_SHA[${_p}]}"
+    _size="${C_SIZE[${_p}]}"
+    _mt="${C_MT[${_p}]}"
+    _kind="${M_KIND[${_p}]}"
+    _slot="${M_SLOT[${_p}]}"
+    _unit="${M_UNIT[${_p}]}"
+    _shot="$(screenshot_of "${_p}" "${_kind}")"
+
+    # (a) META: the same version at the same path.
+    if [ -n "${E_SHA[${_p}]}" ] && [ "${E_SHA[${_p}]}" = "${_sha}" ]; then
+        _eshot="${E_SHOT[${_p}]}"; [ "${_eshot}" = "-" ] && _eshot=""
+        if [ "${_size}" != "${E_SIZE[${_p}]}" ] || [ "${_mt}" != "${E_MTIME[${_p}]}" ] || [ "${_shot}" != "${_eshot}" ]; then
+            op_meta "${_p}" "${_size}" "${_mt}" "${_shot}"
+            N_META=$(( N_META + 1 ))
+        fi
+        continue
+    fi
+
+    # (b) MOVE: a same-unit version whose bytes are no longer at its path.
+    _from="$(find_move_source "${_p}" "${_sha}" "${_unit}")"
+    if [ -n "${_from}" ]; then
+        op_move "${_from}" "${_p}" "${_size}" "${_mt}" "${_kind}" "${_slot}" "${_shot}"
+        MOVED_FROM["${_from}"]=1
+        MOVED_TO["${_p}"]=1
+        MOVE_SRC["${_p}"]="${_from}"
+        N_MOVE=$(( N_MOVE + 1 ))
+        continue
+    fi
+
+    # (c) PUT.
+    _replaces="${E_SHA[${_p}]}"
+    [ "${_replaces}" = "-" ] && _replaces=""
+    case "${MODE}" in
+        exit)
+            _entry="$(render_entry "${_kind}" "${_sha}" "${_size}" "${_mt}" "${SYSTEM}" "${ROM##*/}" \
+                "${EMULATOR}" "${CORE}" "${CORE_BUILD}" "${_unit}" "${_slot}" "${_shot}" "${_replaces}" \
+                "${CORE_DISPLAY}" "${NOW}" "${LOCAL_NOW}" "${SYNCED}")"
+            ;;
+        rescan|full)
+            if [ -z "${E_SHA[${_p}]}" ]; then
+                # No entry and no version to move: not this session's to
+                # claim. It stays unknown provenance, hashed locally (section 4).
+                log_debug "${_p} has no entry and matches no version of ${_unit}; not adopted by --${MODE}"
+                continue
+            fi
+            # A new version at a claimed path: the session that wrote it was
+            # not observed, so its provenance is unknown, never inherited.
+            _sys="${E_SYSTEM[${_p}]}"; [ "${_sys}" = "-" ] && _sys="${SYSTEM:-unknown}"
+            _rom="${E_ROM[${_p}]}";    [ "${_rom}" = "-" ] && _rom="${ROM##*/}"; [ -n "${_rom}" ] || _rom="unknown"
+            _ek="${E_KIND[${_p}]}";    [ "${_ek}" = "-" ] && _ek="${_kind}"
+            _es="${E_SLOT[${_p}]}"
+            _entry="$(render_entry "${_ek}" "${_sha}" "${_size}" "${_mt}" "${_sys}" "${_rom}" \
+                "unknown" "unknown" "unknown" "${_unit}" "${_es}" "${_shot}" "${_replaces}" \
+                "" "${NOW}" "${LOCAL_NOW}" "${SYNCED}")"
+            ;;
+    esac
+    [ -n "${_entry}" ] || { log_error "could not render the entry for ${_p}; not recorded this run"; RC=1; REASON="render-failed"; continue; }
+    op_put "${_p}" "${_entry}"
+    PUT_AT["${_p}"]=1
+    N_PUT=$(( N_PUT + 1 ))
+done
+
+# A destination that already held a different version, whose own entry was
+# neither moved on nor retired: the manifest is keyed by path, there is
+# nowhere to keep two, and no retire record was written for it.
+for _p in "${!MOVED_TO[@]}"; do
+    [ -n "${E_SHA[${_p}]}" ] && [ "${E_SHA[${_p}]}" != "-" ] || continue
+    [ "${E_SHA[${_p}]}" = "${C_SHA[${_p}]}" ] && continue
+    [ -n "${MOVED_FROM[${_p}]}" ] && continue
+    log_warn "version ${E_SHA[${_p}]} displaced at ${_p} without a retire record"
+done
+
+# Screenshot refresh for every state/auto entry of a scanned unit that no op
+# above touched, and the vanished-but-claimed count per unit.
+if [ "${MODE}" = "exit" ] || [ "${MODE}" = "rescan" ] || [ "${MODE}" = "full" ]; then
+    declare -A VANISHED_COUNT
+    for _p in "${E_PATHS[@]}"; do
+        _u="${E_UNIT[${_p}]}"
+        [ -n "${SCANNED_UNIT_SEEN[${_u}]}" ] || continue
+        [ -n "${MOVED_FROM[${_p}]}" ] && continue
+        [ -n "${MOVED_TO[${_p}]}" ] && continue
+        [ -n "${PUT_AT[${_p}]}" ] && continue
+        if [ ! -f "${ROOT}/${_p}" ]; then
+            VANISHED_COUNT["${_u}"]=$(( ${VANISHED_COUNT[${_u}]:-0} + 1 ))
+        fi
+        _ek="${E_KIND[${_p}]}"
+        case "${_ek}" in state|auto) ;; *) continue ;; esac
+        _shot="$(screenshot_of "${_p}" "${_ek}")"
+        _eshot="${E_SHOT[${_p}]}"; [ "${_eshot}" = "-" ] && _eshot=""
+        [ "${_shot}" = "${_eshot}" ] && continue
+        # Only the screenshot moves; size and mtime are the entry's own.
+        [ -n "${C_SHA[${_p}]}" ] && continue   # already carried a meta op
+        _esize="${E_SIZE[${_p}]}"; case "${_esize}" in ''|-|*[!0-9]*) _esize=0 ;; esac
+        op_meta "${_p}" "${_esize}" "${E_MTIME[${_p}]}" "${_shot}"
+        N_META=$(( N_META + 1 ))
+    done
+    for _u in "${!VANISHED_COUNT[@]}"; do
+        log_warn "${VANISHED_COUNT[${_u}]} member(s) of ${_u} are claimed but not on disk; no retire record"
+    done
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 7b -- --adopt: the copy the save-state manager made (#206)
+# ---------------------------------------------------------------------------
+# Exit mode records only what a launch wrote; the verify passes adopt no path
+# without an entry. A slot copied in the manager was neither, so no mode ever
+# recorded it and the manifest-driven sync would never move it. The manager
+# made it, so the manager records it: the source's version at the new path
+# when the bytes are the source's recorded version, else -- the source had no
+# entry, or changed under the copy -- a version of unknown provenance, hashed,
+# the words rescan uses for a version it did not see written. Attribution
+# stays honest: nothing is guessed about who wrote the bytes.
+if [ "${MODE}" = "adopt" ]; then
+    _dest="${ADOPT_REL}"; _srcrel="${ADOPT_SRC_REL}"
+    if [ "${_dest}" = "${_srcrel}" ]; then
+        log_warn "${_dest} copied onto itself; nothing recorded"
+        finish 0
+    fi
+    _dstat="$(stat -c '%s %Y' "${ROOT}/${_dest}" 2>/dev/null)"
+    if [ -z "${_dstat}" ]; then
+        log_warn "${_dest} is not on disk; nothing recorded"
+        finish 0
+    fi
+    _dshot="$(screenshot_of "${_dest}" "${M_KIND[${_dest}]}")"
+    if known_hash "${ROOT}/${_dest}" "${_dest}" || seal "${ROOT}/${_dest}"; then
+        _dsha="${SEAL_SHA}"; _dsize="${SEAL_SIZE}"; _dmt="$(mtime_iso "${SEAL_EPOCH}")"
+    else
+        finish 1 "seal-failed"
+    fi
+    if [ -n "${E_SHA[${_srcrel}]}" ] && [ "${E_SHA[${_srcrel}]}" != "-" ] && [ "${E_SHA[${_srcrel}]}" = "${_dsha}" ]; then
+        op_copy "${_srcrel}" "${_dest}" "${_dsize}" "${_dmt}" "${M_KIND[${_dest}]}" "${M_SLOT[${_dest}]}" "${_dshot}"
+        N_COPY=1
+        log_info "${_dest} is a copy of ${_srcrel}: the same version, recorded at the new path"
+    else
+        _entry="$(render_entry "${M_KIND[${_dest}]}" "${_dsha}" "${_dsize}" "${_dmt}" "${SYSTEM}" "${ROM##*/}" \
+            "unknown" "unknown" "unknown" "${UNIT}" "${M_SLOT[${_dest}]}" "${_dshot}" "" \
+            "" "${NOW}" "${LOCAL_NOW}" "${SYNCED}")"
+        [ -n "${_entry}" ] || { log_error "could not render the entry for ${_dest}; not recorded this run"; finish 1 "render-failed"; }
+        op_put "${_dest}" "${_entry}"
+        N_PUT=1
+        log_info "${_dest} was copied from ${_srcrel}, which has no recorded version with these bytes: recorded with unknown provenance"
+    fi
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 8 -- --retire PATH...  (called BEFORE the files are unlinked)
+# ---------------------------------------------------------------------------
+# A thumbnail: <state>.png, by the name row_retroarch admits or by the kind
+# of the entry it sits beside.
+is_thumbnail() {
+    local rel="$1" owner="${1%.png}"
+    [ "${rel}" != "${owner}" ] || return 1
+    [[ "${rel}" =~ \.state([0-9]*|\.auto)\.png$ ]] && return 0
+    case "${E_KIND[${owner}]}" in state|auto) return 0 ;; esac
+    return 1
+}
+
+if [ "${MODE}" = "retire" ]; then
+    # Which of this run's paths carry an entry: a thumbnail handed over
+    # beside its state (GuiSaveState passes both) leaves members with the
+    # state's entry and needs no op of its own.
+    declare -A RETIRING
+    for _raw in "${RETIRE_PATHS[@]}"; do
+        _p="$(retire_rel "${_raw}")" || continue
+        [ -n "${E_SHA[${_p}]}" ] && [ "${E_SHA[${_p}]}" != "-" ] && RETIRING["${_p}"]=1
+    done
+    for _raw in "${RETIRE_PATHS[@]}"; do
+        _p="$(retire_rel "${_raw}")"
+        case $? in
+            1)  log_warn "${_raw} is outside the saves folder ${ROOT}; not recorded"
+                RC=1; REASON="retire-outside-root"
+                continue ;;
+            2)  log_warn "${_raw} is not a plain path under ${ROOT}; not recorded"
+                RC=1; REASON="retire-outside-root"
+                continue ;;
+        esac
+        if is_thumbnail "${_p}"; then
+            # D-CLOUD-059: a thumbnail is a declared member with no entry, so
+            # there is no version to retire and no row to write -- a row keyed
+            # on its file hash would be a version nothing ever recorded. Its
+            # membership is derived from its state's screenshot; alone, that
+            # is what is set to null, which is what drops it from members.
+            _owner="${_p%.png}"
+            if [ -n "${RETIRING[${_owner}]}" ]; then
+                log_debug "thumbnail ${_p} goes with its state; no row of its own"
+            elif [ "${E_SHOT[${_owner}]:--}" = "${_p}" ]; then
+                _esize="${E_SIZE[${_owner}]}"; case "${_esize}" in ''|-|*[!0-9]*) _esize=0 ;; esac
+                op_meta "${_owner}" "${_esize}" "${E_MTIME[${_owner}]}" ""
+                N_META=$(( N_META + 1 ))
+                log_info "thumbnail ${_p} dropped from the members of ${E_UNIT[${_owner}]}; a thumbnail has no version to retire (D-CLOUD-059)"
+            else
+                log_info "thumbnail ${_p} is not a declared member; nothing recorded"
+            fi
+            continue
+        fi
+        _sha="${E_SHA[${_p}]}"
+        [ "${_sha}" = "-" ] && _sha=""
+        if [ -z "${_sha}" ] && [ -f "${ROOT}/${_p}" ]; then
+            _sha="$( set -o pipefail; sha256sum "${ROOT}/${_p}" 2>/dev/null | cut -c1-64 )"
+            case "${_sha}" in *[!0-9a-f]*) _sha="" ;; esac
+            [ "${#_sha}" -eq 64 ] || _sha=""
+        fi
+        if [ -z "${_sha}" ]; then
+            log_info "nothing known about ${_p}; not recorded"
+            continue
+        fi
+        op_retire "${_p}" "${_sha}"
+        N_RETIRE=$(( N_RETIRE + 1 ))
+    done
+fi
+
+# A rev 1 manifest's entries gain their derived unit on the first write (the
+# upgrade in place); after that I8 keeps every run quiet. A moved entry is
+# copied from the document as loaded, so its destination needs the stamp too.
+declare -A UNIT_FILL
+for _p in "${!E_UNIT_DERIVED[@]}"; do
+    [ -n "${PUT_AT[${_p}]}" ] && continue
+    [ -n "${MOVED_FROM[${_p}]}" ] && continue
+    UNIT_FILL["${_p}"]="${E_UNIT[${_p}]}"
+done
+for _p in "${!MOVED_TO[@]}"; do
+    [ -n "${E_UNIT_DERIVED[${MOVE_SRC[${_p}]}]}" ] && UNIT_FILL["${_p}"]="${M_UNIT[${_p}]}"
+done
+for _p in "${!UNIT_FILL[@]}"; do
+    op_unit "${_p}" "${UNIT_FILL[${_p}]}"
+done
+
+# ---------------------------------------------------------------------------
+# STEP 9 -- merge: one jq program over the ops
+# ---------------------------------------------------------------------------
+if [ ! -s "${OPS}" ]; then
+    # Nothing to write, nothing to log (I8).
+    [ "${MODE}" != "retire" ] && log_debug "nothing changed for ${UNIT:-the claimed paths}"
+    finish "${RC}"
+fi
+
+# Moves read their source from the document as loaded and delete only the
+# sources that are neither destinations nor paths that received a version of
+# their own this run (`cp -p state1 state2` then new bytes at state1 is a
+# move AND a put; the put must survive), so a renumber chain resolves
+# whatever order its ops arrived in. `units` is derived from `entries` on
+# every write: an entry's path is always in its unit's members, a vanished
+# but claimed member stays declared (which is what torn detection needs), and
+# a thumbnail leaves the moment its state's screenshot is null.
+read -r -d '' MERGE_JQ <<'EOF'
+def members:
+  [ .entries | to_entries[]
+    | select(.value.unit != null)
+    | { u: .value.unit,
+        m: ([.key] + (if .value.screenshot == null then [] else [.value.screenshot] end)) } ]
+  | group_by(.u)
+  | map({ key: .[0].u, value: { members: (map(.m) | add | unique) } })
+  | from_entries;
+(try input catch null)
+| (if type == "object" then . else {} end)
+| .schema  = 1
+| .entries = (.entries // {})
+| .retired = (.retired // [])
+| . as $doc
+| ([ $ops[] | select(.op == "move") | .from ]
+   - [ $ops[] | select(.op == "move") | .to ]
+   - [ $ops[] | select(.op == "put" or .op == "meta") | .path ]) as $dead
+| reduce $ops[] as $o (.;
+      if   $o.op == "put"  then .entries[$o.path] = $o.entry
+      elif $o.op == "meta" then (if .entries[$o.path] != null then .entries[$o.path] |= (.size = $o.size | .mtime = $o.mtime | .screenshot = $o.screenshot) else . end)
+      elif $o.op == "move" then .entries[$o.to] = ($doc.entries[$o.from] + { size: $o.size, mtime: $o.mtime, kind: $o.kind, slot: $o.slot, screenshot: $o.screenshot })
+      elif $o.op == "copy" then .entries[$o.to] = ($doc.entries[$o.from] + { size: $o.size, mtime: $o.mtime, kind: $o.kind, slot: $o.slot, screenshot: $o.screenshot,
+                                                                            captured_at: $o.at, captured_local: $o.local, clock_synced: $o.synced,
+                                                                            replaces: null, remote_hash: null, producer: null, published_at: null, pub: null })
+      elif $o.op == "retire" then (.retired += [{ sha256: $o.sha256, path: $o.path, retires_pub: (.entries[$o.path].pub // null), at: $o.at }])
+                                | del(.entries[$o.path])
+      elif $o.op == "unit" then (if .entries[$o.path] != null then .entries[$o.path].unit = $o.unit else . end)
+      else . end)
+| reduce $dead[] as $d (.; del(.entries[$d]))
+| .units   = members
+| .retired = (.retired | sort_by(.at) | if length > $max then .[length - $max:] else . end)
+| .device  = $device
+EOF
+
+if ! "${JQ}" -n -S --slurpfile ops "${OPS}" --argjson device "${DEVICE_JSON}" --argjson max "${RETIRED_MAX}" \
+        "${MERGE_JQ}" "${SRC}" > "${CAND}" 2>/dev/null \
+    || [ ! -s "${CAND}" ] || ! "${JQ}" -e 'type == "object" and (.entries | type) == "object"' "${CAND}" >/dev/null 2>&1; then
+    log_error "merging ${N_PUT} new, ${N_MOVE} moved, ${N_COPY} copied, ${N_META} metadata, ${N_RETIRE} retired into ${MANIFEST} failed; the previous manifest is intact"
+    finish 1 "merge-failed"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 10 -- I8, the concurrency check, the card check, the atomic write
+# ---------------------------------------------------------------------------
+if [ "${SRC}" != "/dev/null" ]; then
+    "${JQ}" -S -c . "${SRC}" > "${CANON_A}" 2>/dev/null
+    "${JQ}" -S -c . "${CAND}" > "${CANON_B}" 2>/dev/null
+    if [ -s "${CANON_A}" ] && [ -s "${CANON_B}" ] && cmp -s "${CANON_A}" "${CANON_B}"; then
+        finish "${RC}"
+    fi
+fi
+
+TMP="$(mktemp -p "${CACHE}" ".manifest.$$.XXXXXX" 2>/dev/null)"
+if [ -z "${TMP}" ] || [ ! -f "${TMP}" ]; then
+    log_error "could not create a temporary file in ${CACHE}; nothing recorded"
+    finish 1 "cache-unwritable"
+fi
+"${JQ}" -S --arg now "${NOW}" '.generated_at = $now' "${CAND}" > "${TMP}" 2>/dev/null
+if [ ! -s "${TMP}" ] || ! "${JQ}" -e . "${TMP}" >/dev/null 2>&1; then
+    rm -f "${TMP}" 2>/dev/null
+    log_error "the new manifest for ${MANIFEST} did not render; the previous manifest is intact"
+    finish 1 "render-failed"
+fi
+
+if [ "$(stat -c '%i %Y' "${MANIFEST}" 2>/dev/null)" != "${LIVE0}" ]; then
+    rm -f "${TMP}" 2>/dev/null
+    if [ -z "${CLOUD_CAPTURE_RETRY}" ] && [ "${MODE}" != "full" ]; then
+        # Another writer -- the detached boot --full, or the manager's
+        # --retire beside an exit capture -- landed between this run's load
+        # and its rename. Its document is the truth now; re-run once against
+        # it rather than discard a first version nothing else will record
+        # (a member with no entry and an mtime below the next --started is
+        # never stamped). Seals are content-addressed, so the second pass
+        # re-uses them. exec runs no EXIT trap, hence cleanup by hand.
+        log_info "${MANIFEST} changed underneath; re-running once against the new document"
+        cleanup
+        CLOUD_CAPTURE_RETRY=1 exec "$0" "${ORIG_ARGS[@]}"
+    fi
+    log_error "${MANIFEST} changed underneath; this run was discarded"
+    finish 1 "manifest-moved"
+fi
+if [ -x "${SAVES_ROOT_BIN}" ] && [ -n "${IDENT0}" ]; then
+    if [ "$("${SAVES_ROOT_BIN}" identity 2>/dev/null)" != "${IDENT0}" ]; then
+        rm -f "${TMP}" 2>/dev/null
+        log_error "the saves folder ${ROOT} changed cards during the scan; this run was discarded"
+        finish 1 "card-changed"
+    fi
+fi
+if ! mv -f "${TMP}" "${MANIFEST}" 2>/dev/null; then
+    rm -f "${TMP}" 2>/dev/null
+    log_error "could not rename ${TMP} onto ${MANIFEST}; the previous manifest is intact"
+    finish 1 "rename-failed"
+fi
+[ "${MANIFEST_REV1}" -eq 1 ] && log_warn "${MANIFEST} was a rev 1 manifest; upgraded in place (units, retired added)"
+
+# ---------------------------------------------------------------------------
+# STEP 11 -- stage GC, and the price
+# ---------------------------------------------------------------------------
+declare -A STAGE_REF
+while IFS= read -r _ref; do
+    [ -n "${_ref}" ] && STAGE_REF["${_ref}"]=1
+done < <("${JQ}" -r '.entries[] | select(.pub == null) | .sha256 // empty' "${MANIFEST}" 2>/dev/null)
+for _f in "${STAGE}"/*; do
+    [ -f "${_f}" ] || continue
+    _n="${_f##*/}"
+    case "${_n}" in .tmp.*) continue ;; esac
+    [ -n "${STAGE_REF[${_n}]}" ] || rm -f "${_f}" 2>/dev/null
+done
+_kb="$(du -sk "${STAGE}" 2>/dev/null | cut -f1)"
+case "${_kb}" in ''|*[!0-9]*) _kb=0 ;; esac
+if [ $(( _kb * 1024 )) -gt "${STAGE_MAX_BYTES}" ]; then
+    _cnt="$(ls -1 "${STAGE}" 2>/dev/null | wc -l | tr -d ' ')"
+    log_warn "${STAGE} holds $(( _kb * 1024 )) bytes in ${_cnt} file(s), over its ${STAGE_MAX_BYTES}-byte ceiling; nothing pruned (every seal is still referenced by an unpublished version)"
+fi
+
+# ---------------------------------------------------------------------------
+# STEP 12 -- the summary, then the stamp
+# ---------------------------------------------------------------------------
+case "${MODE}" in
+    exit)   log_info "recorded ${N_PUT} new, ${N_MOVE} moved, ${N_META} metadata, ${N_RETIRE} retired for ${UNIT} (core ${CORE}, build ${CORE_BUILD}, exit ${EXITCODE}, $(elapsed_ms) ms)" ;;
+    rescan) log_info "recorded ${N_PUT} new, ${N_MOVE} moved, ${N_META} metadata, ${N_RETIRE} retired for ${UNIT} (--rescan, $(elapsed_ms) ms)" ;;
+    full)   log_info "recorded ${N_PUT} new, ${N_MOVE} moved, ${N_META} metadata, ${N_RETIRE} retired over ${#M_PATHS[@]} claimed path(s) (--full, $(elapsed_ms) ms)" ;;
+    retire) log_info "recorded ${N_RETIRE} retired, ${N_META} thumbnail(s) dropped from members (--retire$([ "${UNLINK}" -eq 1 ] && printf ' --unlink'), $(elapsed_ms) ms)" ;;
+    adopt)  log_info "recorded ${N_COPY} copied, ${N_PUT} new for ${UNIT} (--adopt, $(elapsed_ms) ms)" ;;
+esac
+finish "${RC}"
diff --git a/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_backup b/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_backup
new file mode 100755
index 0000000000..9f7ad5ca4c
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_backup
@@ -0,0 +1,600 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+# cloud_content_backup - push game content (ROMs, BIOS, ...) to the cloud.
+#
+# Mirror of cloud_content_restore: an explicit, user-initiated copy of chosen
+# local directories from /storage/roms to the cloud content root. Copy-only -
+# it never deletes anything on the remote. Save/state/screenshot directories
+# are excluded here; they travel via the saves sync.
+#
+# Usage:
+#   cloud_content_backup --list           print local content directories
+#   cloud_content_backup --list-sizes     print them as name|bytes
+#   cloud_content_backup <dir> [<dir>..]  copy local dirs to the cloud
+#   cloud_content_backup --all            copy all local content directories
+#
+# The remote content root defaults to the remote's root; set CONTENT_REMOTE in
+# /storage/.config/cloud_sync.conf to point somewhere else (e.g. "GAMES").
+
+. /etc/profile
+
+LOG_FILE="/var/log/cloud_sync.log"
+SCRIPT_NAME=$(basename "$0")
+DEST="/storage/roms"
+
+# The exit that means "nothing ran: another cloud sync holds the lock", which
+# EmulationStation names (SKIPPED - ANOTHER CLOUD SYNC IS RUNNING). It was 3
+# until 2026-09-09, which is also rclone's "directory not found", so a failed
+# unit carrying rclone's code to the final exit read as a sync that was never
+# running (#99, blindspot 33). sysexits.h's EX_TEMPFAIL sits above everything
+# rclone returns (0-9) and below the 128+signal range, so nothing this script
+# forwards can produce it. The same two numbers (75, and 69 for no network --
+# raised here when the link goes away under a running unit, see
+# stop_no_network) are what EmulationStation reads; scripts and ES ship
+# together.
+readonly EXIT_LOCK_HELD=75 EXIT_NO_NETWORK=69
+
+log_message() {
+    echo "[$(date "+%Y-%m-%d %H:%M:%S")] [INFO] [${SCRIPT_NAME}] ${1}" >> ${LOG_FILE}
+}
+
+# One cloud transfer at a time, whoever asked for it.
+#
+# Three callers can start one: EmulationStation at boot (the startup sync,
+# which ran headless from autostart/102-cloud-saves until #94), EmulationStation
+# after a game exits, and a person in the menu. Until
+# 2026-09-04 the game-exit path was an OS hook with a pgrep guard; moving it
+# into ES kept the visible progress and dropped the guard, so exiting a game
+# during the boot sync started a second rclone against the same remote. Two
+# writers on one folder is how a mirror deleted another handheld's saves
+# (D-CLOUD-014); two copies racing is milder, and still nothing anybody asked
+# for.
+#
+# The lock lives here, in the script, so no caller has to know about the
+# others. /var/run is tmpfs, so a lock cannot survive a reboot and go stale.
+# Non-blocking, because a request that queues silently behind a twenty-minute
+# transfer looks exactly like one that hung. Exit EXIT_LOCK_HELD (75) means
+# "skipped: another sync is running" -- the UI names it, and no last-run stamp
+# is written for work that did not happen.
+#
+# The descriptor is this shell's and nothing else's. A shell redirection
+# carries no close-on-exec, so `exec 9>` hands fd 9 to every child the
+# script starts, and rclone then holds the lock for the whole of a transfer
+# (watched in /proc on the VM, #124). While the script outlives its
+# children that is invisible, because bash waits for each of them before it
+# exits. The moment it does not -- killed or orphaned while rclone is still
+# copying, a child left in the background -- the lock outlives the run that
+# took it and every sync afterwards is refused with "another cloud sync is
+# running" when nothing is running at all. So the body runs with fd 9
+# closed ("9>&-"): bash keeps the lock on a descriptor of its own, which it
+# does mark close-on-exec, and nothing this script starts can see it.
+#
+# The refusal also waits a moment before saying no, as belt and braces for
+# a holder this script does not own: a descriptor leaked by an older build,
+# or a process in the act of exiting, frees itself in milliseconds, while a
+# real concurrent transfer does not. One second of patience turns a raced
+# skip into a run that works and costs a genuinely blocked run one second.
+CLOUD_SYNC_LOCK=/var/run/cloud_sync.lock
+take_cloud_lock() {
+    local tries=0
+    exec 9>"${CLOUD_SYNC_LOCK}"
+    while ! flock -n 9; do
+        if [ "${tries}" -ge 4 ]; then
+            echo "Skipped: another cloud sync is already running. Try again when it's done."
+            log_message "skipped: another cloud sync holds ${CLOUD_SYNC_LOCK}"
+            exit "${EXIT_LOCK_HELD}"
+        fi
+        tries=$((tries + 1))
+        sleep 0.25
+    done
+}
+
+if [ ! -e "/storage/.config/rclone/rclone.conf" ]; then
+    echo ">>> why YOUR CLOUD STORAGE ISN'T SET UP YET"
+    echo "Your cloud storage isn't set up yet. Set it up under GAME SETTINGS > MANAGE CLOUD STORAGE first."
+    exit 1
+fi
+
+[ -f /storage/.config/cloud_sync.conf ] && source /storage/.config/cloud_sync.conf
+
+REMOTENAME=$(rclone listremotes | head -1)
+if [ -z "${REMOTENAME}" ]; then
+    echo ">>> why YOUR CLOUD STORAGE ISN'T SET UP YET"
+    echo "Your cloud storage isn't set up yet. Set it up under GAME SETTINGS > MANAGE CLOUD STORAGE first."
+    exit 1
+fi
+
+ROOT="${REMOTENAME}${CONTENT_REMOTE:+${CONTENT_REMOTE}/}"
+
+# The bound on every rclone command below that opens a socket: RCLONE_NET_OPTS
+# from cloud_sync.conf, or the same shipped values when the config has no
+# such line yet -- this script reads the config without running
+# cloud_sync_helper, so on the first run after an update it may not, and the
+# bound is a guard that a missing line must not switch off. The reasoning
+# for the numbers is beside the option in cloud_sync.conf.defaults; the
+# short version is that rclone's own defaults (60 s connect, 5 min idle, 10
+# low-level retries, 3 whole-run retries) hold a run for over ten minutes
+# on a link that drops mid-run (#101, #102, #103). Keep the fallback in step
+# with the default.
+RCLONE_NET_OPTS_FALLBACK="--contimeout 15s --timeout 30s --low-level-retries 10 --retries 1"
+_net_opts=$(echo "${RCLONE_NET_OPTS:-}" | tr '\n\\' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')
+[ -n "${_net_opts}" ] || _net_opts="${RCLONE_NET_OPTS_FALLBACK}"
+read -r -a RCLONE_NET_OPTS_ARRAY <<< "${_net_opts}"
+# A probe is a single listing that exists to answer quickly: one attempt,
+# tighter than the transfers (the same values the saves scripts probe with).
+readonly -a RCLONE_PROBE_OPTS=(--contimeout 10s --timeout 20s --low-level-retries 1 --retries 1)
+# A listing's bound (#143): three low-level retries, not a transfer's ten --
+# rclone's S3 backend hands the count to the AWS SDK as attempts with
+# exponential backoff (see cloud_backup for the measurement).
+readonly -a RCLONE_LIST_OPTS=(--contimeout 15s --timeout 30s --low-level-retries 3 --retries 1)
+
+# Whole or not at all: to a temporary name beside the stamp, then renamed
+# over it, as ThreadedCloudSync::recordOutcome does. A kill mid-write leaves
+# the previous stamp; it used to leave an empty file (D-CLOUD-078, #105).
+# LAST_WHY, when a `>>> why` line was printed, becomes the stamp's third
+# field as a token (spaces to underscores) for the row to read (D-UI-028).
+LAST_WHY=""
+write_stamp() {
+    local file="$1" line="$2" tmp
+    mkdir -p "$(dirname "${file}")" 2>/dev/null
+    tmp="${file}.tmp.$$"
+    { printf '%s\n' "${line}" > "${tmp}"; } 2>/dev/null \
+        && mv -f "${tmp}" "${file}" 2>/dev/null \
+        || rm -f "${tmp}" 2>/dev/null
+}
+record_outcome() { # <stamp-name> <rc>
+    local why=""
+    case "$2" in
+        0|9|"${EXIT_NO_NETWORK}"|"${EXIT_LOCK_HELD}") ;;
+        *) [ -n "${LAST_WHY}" ] && why=" $(printf '%s' "${LAST_WHY}" | tr ' ' '_')" ;;
+    esac
+    write_stamp "/storage/.cache/cloud_sync/last-$1" "$(date +%s) $2${why}"
+}
+
+# Why a unit did not finish, in the player's words (D-UI-028, D-CLOUD-077):
+# one `>>> why <SENTENCE>` protocol line per failing unit, which the page
+# and the card read; rclone's code stays in the log. The sentences are the
+# vocabulary table's in es-native-ui.md.
+say_why() {
+    LAST_WHY="$1"
+    echo ">>> why $1"
+    log_message "why: $1"
+}
+why_for() {
+    case "$1" in
+        3|4) echo "COULDN'T FIND YOUR CLOUD FOLDER" ;;
+        5)   echo "YOUR CLOUD STOPPED ANSWERING" ;;
+        6)   echo "SOME FILES DIDN'T FINISH" ;;
+        7|8) echo "YOUR CLOUD WOULDN'T TAKE THE FILES" ;;
+        130) echo "IT WAS STOPPED" ;;
+        *)   echo "SOMETHING WENT WRONG" ;;
+    esac
+}
+
+has_default_route() {
+    ip -4 route show default 2>/dev/null | grep -q . \
+        || ip -6 route show default 2>/dev/null | grep -q .
+}
+
+# Is the network gone? Asked after rclone failed, so the run can say why it
+# ended rather than hand up a code that reads as FAILED and sends somebody
+# to a log. Gone: no default route, or a route through which neither the
+# remote nor anything else answers a bounded probe. Not gone: the remote
+# answers again (a blip rclone did not survive), or the internet answers
+# while the remote does not (the provider, or the sign-in) -- that is
+# rclone's failure to report, and the caller passes rclone's code through
+# as before. The same three questions cloud_backup asks (#101, #103).
+network_gone() {
+    has_default_route || return 0
+    rclone lsd "${REMOTENAME}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1 && return 1
+    ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 && return 1
+    ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1 && return 1
+    return 0
+}
+
+# The network went away under a running unit. Says so, records that the run
+# did not complete -- never a 0, which would read as a backup that happened
+# -- and exits EXIT_NO_NETWORK, which EmulationStation names (SKIPPED - NO
+# NETWORK CONNECTION on the card, SKIPPED, NO NETWORK on the row). No
+# further unit is attempted: each would stall for another minute against
+# the same dead link. rclone copy writes each file under a temporary name
+# and renames it when complete, so nothing partial is left in the cloud.
+stop_no_network() {
+    local rc="$1" unit="$2"
+    echo "Couldn't finish: lost the network while backing up ${unit}. Try again when you're online."
+    log_message "stopped: the network went away while backing up ${unit} (rclone exit ${rc}); exit ${EXIT_NO_NETWORK}"
+    record_outcome content-backup "${EXIT_NO_NETWORK}"
+    exit "${EXIT_NO_NETWORK}"
+}
+
+# What this device calls a game system.
+#
+# EmulationStation declares one <path> per system, and on a handheld those are
+# the /storage/roms subdirectories that hold games. Deriving the list from the
+# device's own config means it is right per device -- an H700 has 122, a
+# Snapdragon target has more -- and it never drifts, because the image that
+# adds a system also adds it here.
+#
+# Match on <path>, not <name>: they differ for a dozen systems (ES calls the
+# folder "coleco" and the system "colecovision", "fbneo"/"fbn", "pc88"/"pc-88"),
+# and matching names silently drops those folders from the backup.
+ES_SYSTEMS=""
+for c in /storage/.config/emulationstation/es_systems.cfg \
+         /usr/config/emulationstation/es_systems.cfg; do
+    [ -r "${c}" ] && { ES_SYSTEMS="${c}"; break; }
+done
+
+system_folders() {
+    [ -n "${ES_SYSTEMS}" ] || return 0
+    sed -n 's:.*<path>/storage/roms/\([^</]*\).*:\1:p' "${ES_SYSTEMS}" | sort -u
+}
+
+# Local content directories, by allowlist.
+#
+# This used to be a denylist -- everything under /storage/roms except four
+# names -- so any directory that appeared there was uploaded as though it were
+# a game system. That is the same shape of mistake as a denylist sync filter:
+# what gets included is decided by what happens to be on the disk rather than
+# by anything anyone chose. bezels, themes, music and a stray scummvm folder
+# were all being swept up that way, none of them systems (ES keeps scummvm's
+# games in /storage/.config/scummvm/games and music's playlists in
+# /storage/.config/gmu/playlists -- the /storage/roms folders of those names
+# are leftovers).
+#
+# In scope: the systems ES declares, and bios. Everything else is out, and
+# stays out until somebody decides otherwise.
+# The content-tier files under a directory, as one find(1) definition.
+#
+# Extra find arguments are appended, so a caller can list them, count them or
+# total their sizes without restating the exclusions. "Does this hold
+# anything?" and "how much does it hold?" answering about different file sets
+# is exactly how a badge ends up contradicting the size printed next to it.
+#
+# Kept in step with SAVE_EXCLUDES and CONFLICT_EXCLUDES below by hand -- there
+# is no shared parser, and a pattern added there must be added here. The
+# conflict patterns matter as much as the save ones: without them --list-sizes
+# counts another sync client's duplicate as content this device holds, and the
+# picker's badge reports a size the cloud will never agree with.
+content_files() {
+    local dir="$1"; shift
+    # One rule for both sides (D-CLOUD-048), set by MEDIA_MODE (D-CLOUD-050):
+    #   roms  -- ROMs and BIOS only: the scraper's folders and the game list
+    #            are neither listed nor moved
+    #   with  -- ROMs and game content together
+    #   only  -- game content alone: the scraper's folders and gamelist.xml
+    # The game list is game content (D-CLOUD-049): the scraper writes it
+    # beside the artwork, and a restored-then-scraped device must read as
+    # matching its cloud under ROMs alone.
+    local -a media=()
+    local d
+    case "${MEDIA_MODE:-roms}" in
+        roms) for d in ${MEDIA_DIRS:-images videos manuals screenshots fanart boxart wheel mix maps media}; do media+=( ! -path "${dir%/}/${d}/*" ); done
+              media+=( ! -path "${dir%/}/gamelist.xml" ) ;;
+        only) media+=( "(" -path "${dir%/}/gamelist.xml" )
+              for d in ${MEDIA_DIRS:-images videos manuals screenshots fanart boxart wheel mix maps media}; do media+=( -o -path "${dir%/}/${d}/*" ); done
+              media+=( ")" ) ;;
+    esac
+    find "${dir}" -type f \
+        ! -name '*.srm' ! -name '*.sav' ! -name '*.fs' ! -name '*.state*' \
+        ! -name '*.auto' ! -name '*.dsv*' ! -name '*.eep' ! -name '*.mpk' \
+        ! -name '*.sra' ! -name '*.mcd' ! -name '*.mcr' \
+        ! -path '*/save/*' ! -path '*/memcards/*' \
+        ! -path '*/shared/savefiles/*' ! -path '*/PPSSPP/*' \
+        ! -path '*conflicted copy*' ! -name '*.sync-conflict-*' \
+        "${media[@]}" "$@" 2>/dev/null
+}
+
+# Does this directory hold anything the content tier would actually transfer?
+has_content() {
+    content_files "$1" | head -1 | grep -q .
+}
+
+# How many bytes of it. Compared against the cloud's own total to answer
+# whether a system on this device matches what is stored -- an equal total is
+# not proof of identical files (see #53), so the caller must not phrase it as
+# one, but a different total is proof they differ, which is the case worth
+# flagging.
+content_bytes() {
+    content_files "$1" -exec stat -c '%s' {} + \
+        | awk '{ t += $1 } END { print t+0 }'
+}
+
+list_local_dirs() {
+    local allow
+    allow=$(system_folders)
+    for d in "${DEST}"/*/; do
+        [ -d "${d}" ] || continue
+        base=$(basename "${d}")
+        # The saves sync owns these, and ES declares screenshots and
+        # savestates as systems of its own -- so the allowlist alone lets them
+        # through, and content sync would upload the same files the saves sync
+        # is already keeping, into a second place, under different rules.
+        # Membership of the content tier is the intersection: a system ES
+        # declares, and not something another tier already owns.
+        case "${base}" in
+            savefiles|savestates|screenshots|backup) continue ;;
+        esac
+        if [ "${base}" != "bios" ]; then
+            printf '%s\n' "${allow}" | grep -qxF "${base}" || continue
+        fi
+        # Skip a directory with nothing this tier would carry.
+        #
+        # "Not empty" is the wrong test: RetroArch writes .srm and .state next
+        # to the ROM, so a system whose only contents are saves looks populated
+        # while a content transfer would send nothing from it. That made --list
+        # claim the device "has" GBA when what it had was GBA saves, and the
+        # picker's badge repeated the claim.
+        #
+        has_content "${d}" || continue
+        echo "${base}"
+    done
+}
+
+# Where a local directory belongs in the cloud.
+#
+# The cloud layout is for a person looking at it on a computer, not a mirror of
+# the device's storage. There, "bios" is just another folder beside the game
+# systems, which is an accident of how the handheld stores things and tells a
+# reader nothing. Two named folders do: ROMs and BIOS.
+remote_for() {
+    case "$1" in
+        bios) echo "${ROOT}BIOS" ;;
+        *)    echo "${ROOT}ROMs/$1" ;;
+    esac
+}
+
+# The systems this device syncs, chosen once and changeable. See
+# cloud_content_restore for why this lives in /storage/.cache rather than in
+# anything the settings backup captures. A device that does not want PS2 coming
+# down does not want it going up either, so both directions read the same file.
+SELECTION="/storage/.cache/cloud_sync/content-systems"
+
+selected_systems() {
+    [ -r "${SELECTION}" ] || return 0
+    grep -v '^[[:space:]]*$' "${SELECTION}" 2>/dev/null
+}
+
+# --with-media: include scraped game content (D-CLOUD-048). Off by default:
+# the scraper's folders under a system are neither moved nor counted unless
+# the switch is on, so a restored-then-scraped device does not read as
+# "different" from its cloud copy. Taken from anywhere on the command line.
+MEDIA_MODE=roms
+_ARGS=()
+for _a in "$@"; do
+    case "${_a}" in
+        --with-media) MEDIA_MODE=with ;;
+        --media-only) MEDIA_MODE=only ;;
+        *) _ARGS+=("${_a}") ;;
+    esac
+done
+set -- "${_ARGS[@]}"
+MEDIA_DIRS="images videos manuals screenshots fanart boxart wheel mix maps media"
+# What the main rclone pass carries, per mode. The game list never rides the
+# main pass: it has its own --update pass below (newest wins), which runs
+# only when game content is in scope.
+MEDIA_EXCLUDES=()
+case "${MEDIA_MODE}" in
+    roms) for _d in ${MEDIA_DIRS}; do MEDIA_EXCLUDES+=(--exclude "/${_d}/**"); done ;;
+    only) for _d in ${MEDIA_DIRS}; do MEDIA_EXCLUDES+=(--include "/${_d}/**"); done ;;
+esac
+
+case "${1}" in
+    --selected)
+        # Only the selected systems that this device actually has content for.
+        mapfile -t ALLDIRS < <(list_local_dirs)
+        DIRS=()
+        for d in "${ALLDIRS[@]}"; do
+            selected_systems | grep -qxF "${d}" && DIRS+=("${d}")
+        done
+        # BIOS is not a system and not a pick (D-CLOUD-043): it comes with
+        # the ROMs tier whenever this device holds any, exactly as restore
+        # brings it whenever the cloud does. Found in the VM on 2026-09-06:
+        # a device's BIOS folder never went up once the picker stopped
+        # listing it. Not with game content alone -- BIOS is not that.
+        if [ "${MEDIA_MODE}" != only ] && printf '%s\n' "${ALLDIRS[@]}" | grep -qx bios \
+            && ! printf '%s\n' "${DIRS[@]}" | grep -qx bios; then
+            DIRS+=("bios")
+        fi
+        if [ ${#DIRS[@]} -eq 0 ]; then
+            echo "Nothing to back up: none of the systems you picked have anything on this device."
+            exit 1
+        fi
+    ;;
+    --list)
+        list_local_dirs
+        exit $?
+    ;;
+    --list-sizes)
+        # name|bytes for what this device holds, the mirror of
+        # cloud_content_restore --scan. The picker needs both sides to say
+        # whether a system here matches the copy in the cloud.
+        while IFS= read -r base; do
+            [ -n "${base}" ] || continue
+            printf '%s|%s\n' "${base}" "$(content_bytes "${DEST}/${base}")"
+        done < <(list_local_dirs)
+        exit 0
+    ;;
+    --all)
+        mapfile -t DIRS < <(list_local_dirs)
+        if [ ${#DIRS[@]} -eq 0 ]; then
+            echo "There are no ROMs or BIOS files on this device to back up."
+            exit 1
+        fi
+    ;;
+    "")
+        echo "Usage: ${SCRIPT_NAME} --list | --list-sizes | --all | <dir> [<dir>...]" >&2
+        exit 1
+    ;;
+    *)
+        DIRS=("$@")
+    ;;
+esac
+
+# Another sync client's unresolved dispute is not our content.
+#
+# Dropbox and Nextcloud rename the losing side of a concurrent write to
+# "X (Someone's conflicted copy 2026-09-03)"; Syncthing appends
+# ".sync-conflict-<date>". Carrying those onto a handheld doubles the storage
+# for no benefit -- the player cannot resolve a conflict from a games menu --
+# and it makes the artifacts immortal: a device that downloaded them uploads
+# them again on the next backup, so deleting them in the cloud looks like the
+# provider putting them back. That happened here, to 271 directories of BIOS
+# (2026-09-04).
+#
+# Resolution belongs on the computer where both sides can be seen. We decline
+# to move them in either direction, which is also the only way a cleanup on
+# one side stays done.
+CONFLICT_EXCLUDES=(
+    --exclude "**conflicted copy**"
+    --exclude "**.sync-conflict-**"
+)
+
+# gamelist.xml travels on its own terms.
+#
+# It is the scraping payload -- names, descriptions, genres, ratings, media
+# paths and the cheevos hashes that cost a hash of every ROM -- and all of that
+# is device-independent, so sharing it means scraping once rather than once per
+# handheld. Paths inside it are relative ("./Mega Man 3 (USA).zip"), so it
+# carries across devices unchanged.
+#
+# It degrades well in both directions, which is why this is safe at all:
+#
+#   * Reading, EmulationStation builds its list from the filesystem first and
+#     skips any entry whose ROM is absent ("does not exist ... Ignoring"), so a
+#     52-entry list on a handheld holding 10 of those games shows 10 games and
+#     no phantoms. That holds while ParseGamelistOnly is false, which is the
+#     default.
+#   * Writing, updateGamelist re-reads the file and rewrites only the entries
+#     whose metadata changed, preserving entries for ROMs this device does not
+#     have -- deliberately, per its own comment.
+#
+# What neither of those protects against is rclone, which replaces a file
+# wholesale. A device that scans its own ROMs and uploads before it has ever
+# restored would push a thin list over a rich one. That is an ordering problem,
+# not a merge problem, and --update solves it: skip when the destination is
+# newer, so the freshest list wins rather than the last writer.
+#
+# Hence a separate pass. --update on the whole content transfer would also
+# apply to ROMs, where "destination is newer" is not a reason to skip a file
+# somebody deliberately re-uploaded.
+#
+# Three fields remain genuinely per-device -- playcount, lastplayed and
+# gametime, which EmulationStation itself marks isStatistic and refuses to let
+# a scrape overwrite. A file-level sync cannot make that distinction, so those
+# are last-writer-wins across devices. Everything else in the file is authored
+# or scraped, and favorite is explicitly not a statistic in ES's model.
+GAMELIST_ONLY=( --include "gamelist.xml" --include "**/gamelist.xml" )
+
+# What the saves tier owns, and content must never carry.
+#
+# A system directory holds more than games: RetroArch writes .srm and .state
+# next to the ROM, and several systems keep memory cards in a subfolder. The
+# saves allowlist claims all of it ("+ /**/*.srm" and friends in
+# cloud_sync-rules.txt), so uploading a system folder wholesale puts saves
+# in a second cloud location under different rules -- two writers and no
+# reconciliation, which is exactly how 70 files were deleted on 2026-09-01.
+#
+# Worse in the other direction: a content restore would then copy stale saves
+# back over live ones.
+#
+# The earlier allowlist fix (d77d4ea44d) covered directories another tier
+# owns. This is the same rule one level down, for files. Kept in step with
+# cloud_sync-rules.txt by hand -- there is no shared parser, and a pattern
+# added there must be added here.
+SAVE_EXCLUDES=(
+    --exclude "*.srm" --exclude "*.sav" --exclude "*.fs"
+    --exclude "*.state*" --exclude "*.auto" --exclude "*.dsv*"
+    --exclude "*.eep" --exclude "*.mpk" --exclude "*.sra"
+    --exclude "*.mcd" --exclude "*.mcr"
+    --exclude "save/**" --exclude "memcards/**"
+    --exclude "shared/savefiles/**" --exclude "PPSSPP/**"
+)
+
+STATUS=0
+take_cloud_lock
+# Everything from here to the end of the script runs with the lock
+# descriptor closed, so no child of this run can hold the lock once this
+# shell is gone -- see take_cloud_lock. The brace group is the whole of
+# the change: it adds no subshell, so exits, traps and variables behave
+# exactly as they did.
+{
+UNIT_N=${#DIRS[@]}; UNIT_I=0
+for DIR in "${DIRS[@]}"; do
+    # Local -> remote. This script uploads; cloud_content_restore is the one
+    # that brings content back down.
+    SRC="${DEST}/${DIR}"
+    TARGET="$(remote_for "${DIR}")"
+    UNIT_I=$((UNIT_I + 1))
+    log_message "Content backup: ${SRC} -> ${TARGET}"
+    # The marker the transfer page reads: what is being copied, and which of
+    # how many. Restore has emitted it since D-UI-024; backup never did, so
+    # the page kept the previous script's last label -- SETTINGS BACKUP --
+    # through every system it uploaded (maintainer, 2026-09-06).
+    echo ">>> unit ${DIR:-everything}|${UNIT_I}|${UNIT_N}"
+    echo "Backing up ${DIR:-everything} to the cloud..."
+    # --progress is what puts the stats on stdout. With only --log-file they
+    # go to the log and the caller sees nothing -- which is why the progress
+    # card sat at "0 B / 0 B, -, 0 B/s" through a restore that was in fact
+    # copying Mega Drive ROMs the whole time. The saves path has always passed
+    # it; these two never did.
+    #
+    # And NOT --stats-one-line: that collapses the display to a totals line,
+    # losing the per-file block. A transfer of a thousand small BIOS files
+    # spends minutes between percentage changes, and the only thing that says
+    # it is alive rather than stuck is the name of the file it is on right
+    # now. --stats 1s keeps that moving.
+    #
+    # No --progress-terminal-width: the flag does not exist on every rclone we
+    # ship against (the saves scripts test for it with "rclone help | grep"
+    # before using it), and an unknown flag is a usage error that transfers
+    # nothing. rclone pads the file name out to a guessed width; the reader
+    # trims it, so the flag bought nothing worth a version check.
+    #
+    # The folder first, on its own. rclone creates a missing destination as
+    # part of a copy, but only after listing it, and a server that answers a
+    # missing folder with an error rather than "not found" (an FTP server's
+    # 501 where the standard reply is 550) fails that listing. Under
+    # --retries 1 that one attempt is the whole run: reported as failed,
+    # with files that may or may not have landed (#142, from the #133
+    # matrix: 2 of 3). mkdir is one round trip, idempotent, and on a bucket
+    # under directory markers it writes the marker the folder's parent then
+    # lists (D-CLOUD-120). Its own failure is left to the copy to report.
+    rclone mkdir "${TARGET}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null
+    rclone copy "${SRC}" "${TARGET}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+        "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${MEDIA_EXCLUDES[@]}" \
+        --exclude "gamelist.xml" --exclude "**/gamelist.xml" \
+        --progress --stats 1s \
+        --log-file "${LOG_FILE}" --log-level INFO
+    RC=$?
+
+    # The game list: newest wins, rather than whoever ran last. Game content
+    # only (D-CLOUD-049) -- under ROMs alone the file stays where it is.
+    [ "${MEDIA_MODE}" != roms ] && rclone copy "${SRC}" "${TARGET}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+        "${GAMELIST_ONLY[@]}" --update \
+        --stats 0 \
+        --log-file "${LOG_FILE}" --log-level INFO || true
+
+    if [ ${RC} -ne 0 ] && [ ${RC} -ne 9 ]; then
+        # A failed unit says why: the network gone ends the run as 69 here,
+        # anything else carries rclone's own code up as before.
+        network_gone && stop_no_network "${RC}" "${DIR:-everything}"
+        log_message "backup of ${DIR:-everything}: rclone exit ${RC}"
+        echo "Couldn't finish backing up ${DIR:-everything}: $(why_for "${RC}" | tr 'A-Z' 'a-z')."
+        say_why "$(why_for "${RC}")"
+        STATUS=${RC}
+    else
+        echo "Backed up ${DIR:-everything}."
+    fi
+done
+
+# The progress card is gone by the time somebody who walked away comes back, so
+# leave the outcome where the menu can read it later. Device-local state, so it
+# lives under /storage/.cache and not in the settings backup.
+record_outcome content-backup "${STATUS}"
+
+# A failed unit leaves with rclone's own code, unremapped: nothing rclone
+# returns can read as the lock sentinel now that it is 75 (#99).
+exit ${STATUS}
+} 9>&-
diff --git a/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_restore b/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_restore
new file mode 100755
index 0000000000..cb480bb7e6
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/rclone/sources/cloud_content_restore
@@ -0,0 +1,1128 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+# cloud_content_restore - pull game content (ROMs, BIOS, ...) from the cloud.
+#
+# Unlike the saves sync (allowlist-filtered, never touches ROMs/BIOS), this is
+# an explicit, user-initiated copy of a chosen remote directory into
+# /storage/roms. It never deletes anything locally (rclone copy) and skips
+# files that already exist unless they differ.
+#
+# Usage:
+#   cloud_content_restore --list           print top-level remote directories
+#   cloud_content_restore <dir> [<dir>..]  copy remote dirs into /storage/roms
+#   cloud_content_restore --all            copy the whole remote content root
+#   cloud_content_restore --match          preview making this device match
+#   cloud_content_restore --match --apply  do it (the only mode that deletes)
+#
+# The remote content root defaults to the remote's root; set CONTENT_REMOTE in
+# /storage/.config/cloud_sync.conf to point somewhere else (e.g. "GAMES").
+
+. /etc/profile
+
+LOG_FILE="/var/log/cloud_sync.log"
+SCRIPT_NAME=$(basename "$0")
+DEST="/storage/roms"
+
+# The exit that means "nothing ran: another cloud sync holds the lock", which
+# EmulationStation names (SKIPPED - ANOTHER CLOUD SYNC IS RUNNING). It was 3
+# until 2026-09-09, which is also rclone's "directory not found", so a failed
+# unit carrying rclone's code to the final exit read as a sync that was never
+# running (#99, blindspot 33). sysexits.h's EX_TEMPFAIL sits above everything
+# rclone returns (0-9) and below the 128+signal range, so nothing this script
+# forwards can produce it. The same two numbers (75, and 69 for no network --
+# raised here when the link goes away under a running unit, see
+# stop_no_network) are what EmulationStation reads; scripts and ES ship
+# together.
+readonly EXIT_LOCK_HELD=75 EXIT_NO_NETWORK=69
+
+log_message() {
+    echo "[$(date "+%Y-%m-%d %H:%M:%S")] [INFO] [${SCRIPT_NAME}] ${1}" >> ${LOG_FILE}
+}
+
+# One cloud transfer at a time, whoever asked for it.
+#
+# Three callers can start one: EmulationStation at boot (the startup sync,
+# which ran headless from autostart/102-cloud-saves until #94), EmulationStation
+# after a game exits, and a person in the menu. Until
+# 2026-09-04 the game-exit path was an OS hook with a pgrep guard; moving it
+# into ES kept the visible progress and dropped the guard, so exiting a game
+# during the boot sync started a second rclone against the same remote. Two
+# writers on one folder is how a mirror deleted another handheld's saves
+# (D-CLOUD-014); two copies racing is milder, and still nothing anybody asked
+# for.
+#
+# The lock lives here, in the script, so no caller has to know about the
+# others. /var/run is tmpfs, so a lock cannot survive a reboot and go stale.
+# Non-blocking, because a request that queues silently behind a twenty-minute
+# transfer looks exactly like one that hung. Exit EXIT_LOCK_HELD (75) means
+# "skipped: another sync is running" -- the UI names it, and no last-run stamp
+# is written for work that did not happen.
+#
+# The descriptor is this shell's and nothing else's. A shell redirection
+# carries no close-on-exec, so `exec 9>` hands fd 9 to every child the
+# script starts, and rclone then holds the lock for the whole of a transfer
+# (watched in /proc on the VM, #124). While the script outlives its
+# children that is invisible, because bash waits for each of them before it
+# exits. The moment it does not -- killed or orphaned while rclone is still
+# copying, a child left in the background -- the lock outlives the run that
+# took it and every sync afterwards is refused with "another cloud sync is
+# running" when nothing is running at all. So the body runs with fd 9
+# closed ("9>&-"): bash keeps the lock on a descriptor of its own, which it
+# does mark close-on-exec, and nothing this script starts can see it.
+#
+# The refusal also waits a moment before saying no, as belt and braces for
+# a holder this script does not own: a descriptor leaked by an older build,
+# or a process in the act of exiting, frees itself in milliseconds, while a
+# real concurrent transfer does not. One second of patience turns a raced
+# skip into a run that works and costs a genuinely blocked run one second.
+CLOUD_SYNC_LOCK=/var/run/cloud_sync.lock
+take_cloud_lock() {
+    local tries=0
+    exec 9>"${CLOUD_SYNC_LOCK}"
+    while ! flock -n 9; do
+        if [ "${tries}" -ge 4 ]; then
+            echo "Skipped: another cloud sync is already running. Try again when it's done."
+            log_message "skipped: another cloud sync holds ${CLOUD_SYNC_LOCK}"
+            exit "${EXIT_LOCK_HELD}"
+        fi
+        tries=$((tries + 1))
+        sleep 0.25
+    done
+}
+
+if [ ! -e "/storage/.config/rclone/rclone.conf" ]; then
+    echo ">>> why YOUR CLOUD STORAGE ISN'T SET UP YET"
+    echo "Your cloud storage isn't set up yet. Set it up under GAME SETTINGS > MANAGE CLOUD STORAGE first."
+    exit 1
+fi
+
+[ -f /storage/.config/cloud_sync.conf ] && source /storage/.config/cloud_sync.conf
+
+REMOTENAME=$(rclone listremotes | head -1)
+if [ -z "${REMOTENAME}" ]; then
+    echo ">>> why YOUR CLOUD STORAGE ISN'T SET UP YET"
+    echo "Your cloud storage isn't set up yet. Set it up under GAME SETTINGS > MANAGE CLOUD STORAGE first."
+    exit 1
+fi
+
+ROOT="${REMOTENAME}${CONTENT_REMOTE:+${CONTENT_REMOTE}/}"
+LEGACY_ROOT="${REMOTENAME}"
+
+# The bound on every rclone command below that opens a socket: RCLONE_NET_OPTS
+# from cloud_sync.conf, or the same shipped values when the config has no
+# such line yet -- this script reads the config without running
+# cloud_sync_helper, so on the first run after an update it may not, and the
+# bound is a guard that a missing line must not switch off. The reasoning
+# for the numbers is beside the option in cloud_sync.conf.defaults; the
+# short version is that rclone's own defaults (60 s connect, 5 min idle, 10
+# low-level retries, 3 whole-run retries) hold a run for over ten minutes
+# on a link that drops mid-run (#101, #102, #103). Keep the fallback in step
+# with the default. The two rclone calls that touch only this device --
+# `rclone size` and `rclone delete` on a local folder in the match flow --
+# open no socket and carry none of this.
+RCLONE_NET_OPTS_FALLBACK="--contimeout 15s --timeout 30s --low-level-retries 10 --retries 1"
+_net_opts=$(echo "${RCLONE_NET_OPTS:-}" | tr '\n\\' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')
+[ -n "${_net_opts}" ] || _net_opts="${RCLONE_NET_OPTS_FALLBACK}"
+read -r -a RCLONE_NET_OPTS_ARRAY <<< "${_net_opts}"
+# A probe is a single listing that exists to answer quickly: one attempt,
+# tighter than the transfers (the same values the saves scripts probe with).
+readonly -a RCLONE_PROBE_OPTS=(--contimeout 10s --timeout 20s --low-level-retries 1 --retries 1)
+# A listing's bound (#143): three low-level retries, not a transfer's ten --
+# rclone's S3 backend hands the count to the AWS SDK as attempts with
+# exponential backoff (see cloud_backup for the measurement).
+readonly -a RCLONE_LIST_OPTS=(--contimeout 15s --timeout 30s --low-level-retries 3 --retries 1)
+
+# Whole or not at all: to a temporary name beside the stamp, then renamed
+# over it, as ThreadedCloudSync::recordOutcome does. A kill mid-write leaves
+# the previous stamp; it used to leave an empty file (D-CLOUD-078, #105).
+# LAST_WHY, when a `>>> why` line was printed, becomes the stamp's third
+# field as a token (spaces to underscores) for the row to read (D-UI-028).
+LAST_WHY=""
+write_stamp() {
+    local file="$1" line="$2" tmp
+    mkdir -p "$(dirname "${file}")" 2>/dev/null
+    tmp="${file}.tmp.$$"
+    { printf '%s\n' "${line}" > "${tmp}"; } 2>/dev/null \
+        && mv -f "${tmp}" "${file}" 2>/dev/null \
+        || rm -f "${tmp}" 2>/dev/null
+}
+record_outcome() { # <stamp-name> <rc>
+    local why=""
+    case "$2" in
+        0|9|"${EXIT_NO_NETWORK}"|"${EXIT_LOCK_HELD}") ;;
+        *) [ -n "${LAST_WHY}" ] && why=" $(printf '%s' "${LAST_WHY}" | tr ' ' '_')" ;;
+    esac
+    write_stamp "/storage/.cache/cloud_sync/last-$1" "$(date +%s) $2${why}"
+}
+
+# Why a unit did not finish, in the player's words (D-UI-028, D-CLOUD-077):
+# one `>>> why <SENTENCE>` protocol line per failing unit, which the page
+# and the card read; rclone's code stays in the log. The sentences are the
+# vocabulary table's in es-native-ui.md.
+say_why() {
+    LAST_WHY="$1"
+    echo ">>> why $1"
+    log_message "why: $1"
+}
+why_for() {
+    case "$1" in
+        3|4) echo "COULDN'T FIND YOUR CLOUD FOLDER" ;;
+        5)   echo "YOUR CLOUD STOPPED ANSWERING" ;;
+        6)   echo "SOME FILES DIDN'T FINISH" ;;
+        7|8) echo "YOUR CLOUD WOULDN'T TAKE THE FILES" ;;
+        130) echo "IT WAS STOPPED" ;;
+        *)   echo "SOMETHING WENT WRONG" ;;
+    esac
+}
+
+has_default_route() {
+    ip -4 route show default 2>/dev/null | grep -q . \
+        || ip -6 route show default 2>/dev/null | grep -q .
+}
+
+# Is the network gone? Asked after rclone failed, so the run can say why it
+# ended rather than hand up a code that reads as FAILED and sends somebody
+# to a log. Gone: no default route, or a route through which neither the
+# remote nor anything else answers a bounded probe. Not gone: the remote
+# answers again (a blip rclone did not survive), or the internet answers
+# while the remote does not (the provider, or the sign-in) -- that is
+# rclone's failure to report, and the caller passes rclone's code through
+# as before. The same three questions cloud_backup asks (#101, #103).
+network_gone() {
+    has_default_route || return 0
+    rclone lsd "${REMOTENAME}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1 && return 1
+    ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 && return 1
+    ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1 && return 1
+    return 0
+}
+
+# The network went away under a running unit. Says so, records that the run
+# did not complete -- never a 0, which would read as a restore that happened
+# -- under the stamp the action keeps (last-content-restore, or
+# last-content-match for --match --apply), and exits EXIT_NO_NETWORK, which
+# EmulationStation names (SKIPPED - NO NETWORK CONNECTION on the card,
+# SKIPPED, NO NETWORK on the row). No further unit is attempted: each would
+# stall for another minute against the same dead link. rclone copy and sync
+# write each file under a temporary name and rename it when complete, so
+# nothing partial is left on the card; a match's deletions had already
+# happened when the sync ran, and the cloud still holds what they removed.
+stop_no_network() {
+    local stamp="$1" rc="$2" doing="$3"
+    echo "Couldn't finish: lost the network while ${doing}. Try again when you're online."
+    log_message "stopped: the network went away while ${doing} (rclone exit ${rc}); exit ${EXIT_NO_NETWORK}"
+    record_outcome "content-${stamp}" "${EXIT_NO_NETWORK}"
+    exit "${EXIT_NO_NETWORK}"
+}
+
+# Read the old shape, write the new one.
+#
+# CONTENT_REMOTE is newer than content sync itself. Before it existed, content
+# sat at the remote root, and an upgraded device would look in the new place,
+# find nothing, and simply show an empty list - the player never chose a
+# layout, so there is nothing for them to reason about, and nobody reads
+# release notes on a handheld.
+#
+# So restore looks in the configured location and falls back to the old one.
+# Backups always write to the configured location, so a library migrates by
+# itself the next time it is backed up, with no prompt and no migration step.
+# The legacy root on a path-based remote is the whole account, which holds the
+# owner's own folders too. Only directories this device actually has locally
+# are offered from there - listing somebody's holiday photos as restorable ROMs
+# would be worse than the empty list this fixes.
+legacy_dirs() {
+    local d base
+    for d in "${DEST}"/*/; do
+        [ -d "${d}" ] || continue
+        base=$(basename "${d}")
+        case "${base}" in savefiles|savestates|screenshots|backup) continue ;; esac
+        echo "${base}"
+    done
+}
+
+# Where a local directory lives in the current cloud layout.
+#
+# ROMs and BIOS are named folders rather than a mirror of /storage/roms,
+# because the person filling them in is looking at a file manager on a
+# computer, where "bios sitting beside snes" is an accident of how a handheld
+# stores things. The local name is what everything else here uses, so the
+# mapping stays in one place: bios lives under BIOS, everything else under
+# ROMs.
+remote_for() {
+    case "$1" in
+        bios) echo "${ROOT}BIOS" ;;
+        *)    echo "${ROOT}ROMs/$1" ;;
+    esac
+}
+
+# Returns the full remote path that actually holds this directory.
+#
+# Three shapes are in the field and all of them have to keep working:
+#
+#   1. ROMs/<system> and BIOS      -- current
+#   2. <system> and bios, flat under CONTENT_REMOTE  -- what shipped before this
+#   3. <system> at the remote root -- before CONTENT_REMOTE existed at all
+#
+# Read all three, write only the first (cloud_content_backup). A library then
+# migrates itself the next time it is backed up: nothing to prompt about,
+# nothing to explain, and a device that has not updated yet still finds its
+# content where it left it.
+#
+# The legacy root on a path-based remote is the whole account, which holds the
+# owner's own folders too. Only directories this device actually has locally
+# are offered from there - listing somebody's holiday photos as restorable ROMs
+# would be worse than the empty list this fixes.
+resolve_src() {
+    local dir="$1" new
+    new="$(remote_for "${dir}")"
+    if exists_remote "${new}"; then
+        echo "${new}"
+    elif rclone lsf --dirs-only "${ROOT}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | sed 's:/$::' | grep -qx "${dir}"; then
+        log_message "Content \"${dir}\" found in the flat pre-ROMs layout"
+        echo "${ROOT}${dir}"
+    elif [ -n "${CONTENT_REMOTE}" ] && legacy_dirs | grep -qx "${dir}" \
+         && rclone lsf --dirs-only "${LEGACY_ROOT}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | sed 's:/$::' | grep -qx "${dir}"; then
+        log_message "Content \"${dir}\" found at the pre-CONTENT_REMOTE location"
+        echo "${LEGACY_ROOT}${dir}"
+    else
+        echo "${new}"
+    fi
+}
+
+# Does a remote path exist?
+#
+# NOT `rclone lsjson --stat`, which is what this used to be. On bucket-based
+# remotes (S3, B2, Minio) stat synthesises a directory entry for *any* path --
+# verified against Minio on rclone 1.60 and 1.74, where
+# "utterly-bogus-never-created" reports success with IsDir true. So it can
+# never report absence there, and every caller that branched on it took the
+# "exists" path unconditionally.
+#
+# A listing can report absence. Two questions, because a directory can be real
+# without holding files: does it contain anything, or does its parent list it
+# (which is what an --s3-directory-markers marker object produces)?
+exists_remote() {
+    [ -n "$(rclone lsf "$1" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | head -1)" ] && return 0
+    local parent name
+    parent="${1%/}"; name="${parent##*/}"; parent="${parent%/*}"
+    [ -n "${name}" ] || return 1
+    rclone lsf --dirs-only "${parent}/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | grep -qx "${name}/"
+}
+
+# Is this remote path missing, rather than unreadable? rclone answers "not
+# found" (exit 3) when the server's reply is the one it maps to that, and a
+# plain error (exit 1) when the words differ: an FTP server that answers a
+# missing folder with 501 "No such directory." where the standard reply is
+# 550 makes every "is it there yet?" branch read as "the cloud is broken"
+# (#142, from the #133 matrix). The parent settles it, whatever the words:
+# walk up until a level lists. A level that lists and lacks the next name is
+# a path not created yet (0); one that lists and holds it means the failure
+# was something else (1); a remote whose root will not list is broken (1).
+# On a bucket an absent prefix lists as empty, which is the same answer
+# (D-CLOUD-120). Called only after a listing has already failed with a code
+# other than 3, so the everyday path costs nothing extra.
+absent_not_broken() {
+    local path="${1%/}" remote rel name parent listing
+    remote="${path%%:*}:"; rel="${path#*:}"; rel="${rel#/}"
+    while [ -n "${rel}" ]; do
+        name="${rel##*/}"; parent="${rel%/*}"
+        [ "${parent}" = "${rel}" ] && parent=""
+        if listing=$(rclone lsf --dirs-only "${remote}/${parent:+${parent}/}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null); then
+            printf '%s\n' "${listing}" | grep -qFx -- "${name}/" && return 1
+            return 0
+        fi
+        [ -n "${parent}" ] || return 1
+        rel="${parent}"
+    done
+    return 1
+}
+
+# Which systems this device syncs.
+#
+# One cloud library, many handhelds, and they are not interchangeable: an H700
+# cannot run GameCube, and a 3:2 panel makes a device a Game Boy Advance
+# machine by preference rather than by limit. So the set is a per-device
+# choice.
+#
+# Kept in /storage/.cache, deliberately. The obvious homes -- cloud_sync.conf,
+# or ES's system.cfg -- are both captured by the settings backup, and restoring
+# one device's selection onto another would silently change what that device
+# syncs. That is the same defect shape as the CONTENT_REMOTE split (6717e0b348),
+# and once was enough.
+#
+# No file means no selection means everything, so a device that has never
+# opened the picker behaves exactly as it did before.
+SELECTION="/storage/.cache/cloud_sync/content-systems"
+
+selected_systems() {
+    [ -r "${SELECTION}" ] || return 0
+    grep -v '^[[:space:]]*$' "${SELECTION}" 2>/dev/null
+}
+
+# The systems this image can actually run, from its own EmulationStation
+# config. Matched on <path>, not <name>: they differ for a dozen systems and
+# matching names silently mislabels those as unsupported.
+es_systems_file() {
+    for c in /storage/.config/emulationstation/es_systems.cfg \
+             /usr/config/emulationstation/es_systems.cfg; do
+        [ -r "${c}" ] && { echo "${c}"; return 0; }
+    done
+}
+
+supported_systems() {
+    local c; c=$(es_systems_file)
+    [ -n "${c}" ] || return 0
+    sed -n 's:.*<path>/storage/roms/\([^</]*\).*:\1:p' "${c}" | sort -u
+}
+
+# Total bytes per top-level directory, from ONE recursive listing.
+#
+# rclone size per system would be one API round trip each, which on a library
+# of thirty systems is thirty waits before the player sees anything. lsf
+# --format sp returns size and path for every file in a single call; summing
+# them here costs nothing.
+sizes_under() {
+    rclone lsf -R --files-only --format "sp" --separator "|" "$1" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null \
+        | grep -v '|README\.txt$' \
+        | awk -F'|' '{ i = index($2, "/"); if (i == 0) next;
+                       d = substr($2, 1, i - 1); sz[d] += $1 }
+                     END { for (d in sz) print d "|" sz[d] }'
+}
+
+
+# --- make this device match the cloud ------------------------------------
+#
+# Backup and restore are both copy-only, deliberately, so a system removed
+# from the cloud stays on the device forever and a card can never be made to
+# match the library. This is the third action, and the only one here that
+# deletes.
+#
+# Five rules, each of which has already cost something in this subsystem:
+#
+#  1. --delete-excluded NEVER appears. Save files live inside system
+#     directories; with the excludes in place rclone leaves excluded
+#     destination files alone, and that one flag inverts it into a save wipe.
+#  2. Only ROMs/<selected system> and BIOS. /storage/roms also holds
+#     savefiles, savestates, screenshots, backup, bezels, themes and music --
+#     other tiers' or nobody's.
+#  3. An empty or failed listing must never mean "delete everything". A wifi
+#     drop, a lapsed token and a renamed cloud folder all look exactly like an
+#     empty cloud, so the content root is positively confirmed to hold
+#     something before any deletion is considered.
+#  4. Cloud -> device only. The mirror direction is what deleted another
+#     handheld's whole save library on 2026-09-01 (D-CLOUD-014).
+#  5. Saves survive a removed system. Its content goes; the .srm and .state
+#     files stay, leaving the directory holding only those -- which
+#     has_content() correctly reports as no content.
+#
+# Deletions are final on the device: no local backup-dir. The space reclaimed
+# is the entire point of syncing ROMs selectively, and the cloud is the backup
+# by definition, since this only ever removes what the cloud does not have
+# (D-CLOUD-023). Preview first, then apply.
+
+# Defined here, above every consumer.
+#
+# They used to sit below the case statement, which was fine while the only
+# consumer was the transfer loop at the end of the file -- and silently
+# catastrophic the moment --match started calling them from inside the case.
+# Bash expands an unset array to nothing, so rclone ran with no save
+# excludes at all and a match would have deleted .srm and .state files. It
+# was invisible in the output: fewer exclusions simply means more deletions,
+# and the preview reported them as ordinary work.
+
+# What the saves tier owns, and content must never carry.
+#
+# A system directory holds more than games: RetroArch writes .srm and .state
+# next to the ROM, and several systems keep memory cards in a subfolder. The
+# saves allowlist claims all of it ("+ /**/*.srm" and friends in
+# cloud_sync-rules.txt), so uploading a system folder wholesale puts saves
+# in a second cloud location under different rules -- two writers and no
+# reconciliation, which is exactly how 70 files were deleted on 2026-09-01.
+#
+# Worse in the other direction: a content restore would then copy stale saves
+# back over live ones.
+#
+# The earlier allowlist fix (d77d4ea44d) covered directories another tier
+# owns. This is the same rule one level down, for files. Kept in step with
+# cloud_sync-rules.txt by hand -- there is no shared parser, and a pattern
+# added there must be added here.
+SAVE_EXCLUDES=(
+    --exclude "*.srm" --exclude "*.sav" --exclude "*.fs"
+    --exclude "*.state*" --exclude "*.auto" --exclude "*.dsv*"
+    --exclude "*.eep" --exclude "*.mpk" --exclude "*.sra"
+    --exclude "*.mcd" --exclude "*.mcr"
+    --exclude "save/**" --exclude "memcards/**"
+    --exclude "shared/savefiles/**" --exclude "PPSSPP/**"
+)
+
+# Another sync client's unresolved dispute is not our content.
+#
+# Dropbox and Nextcloud rename the losing side of a concurrent write to
+# "X (Someone's conflicted copy 2026-09-03)"; Syncthing appends
+# ".sync-conflict-<date>". Carrying those onto a handheld doubles the storage
+# for no benefit -- the player cannot resolve a conflict from a games menu --
+# and it makes the artifacts immortal: a device that downloaded them uploads
+# them again on the next backup, so deleting them in the cloud looks like the
+# provider putting them back. That happened here, to 271 directories of BIOS
+# (2026-09-04).
+#
+# Resolution belongs on the computer where both sides can be seen. We decline
+# to move them in either direction, which is also the only way a cleanup on
+# one side stays done.
+CONFLICT_EXCLUDES=(
+    --exclude "**conflicted copy**"
+    --exclude "**.sync-conflict-**"
+)
+
+# gamelist.xml travels on its own terms.
+#
+# It is the scraping payload -- names, descriptions, genres, ratings, media
+# paths and the cheevos hashes that cost a hash of every ROM -- and all of that
+# is device-independent, so sharing it means scraping once rather than once per
+# handheld. Paths inside it are relative ("./Mega Man 3 (USA).zip"), so it
+# carries across devices unchanged.
+#
+# It degrades well in both directions, which is why this is safe at all:
+#
+#   * Reading, EmulationStation builds its list from the filesystem first and
+#     skips any entry whose ROM is absent ("does not exist ... Ignoring"), so a
+#     52-entry list on a handheld holding 10 of those games shows 10 games and
+#     no phantoms. That holds while ParseGamelistOnly is false, which is the
+#     default.
+#   * Writing, updateGamelist re-reads the file and rewrites only the entries
+#     whose metadata changed, preserving entries for ROMs this device does not
+#     have -- deliberately, per its own comment.
+#
+# What neither of those protects against is rclone, which replaces a file
+# wholesale. A device that scans its own ROMs and uploads before it has ever
+# restored would push a thin list over a rich one. That is an ordering problem,
+# not a merge problem, and --update solves it: skip when the destination is
+# newer, so the freshest list wins rather than the last writer.
+#
+# Hence a separate pass. --update on the whole content transfer would also
+# apply to ROMs, where "destination is newer" is not a reason to skip a file
+# somebody deliberately re-uploaded.
+#
+# Three fields remain genuinely per-device -- playcount, lastplayed and
+# gametime, which EmulationStation itself marks isStatistic and refuses to let
+# a scrape overwrite. A file-level sync cannot make that distinction, so those
+# are last-writer-wins across devices. Everything else in the file is authored
+# or scraped, and favorite is explicitly not a statistic in ES's model.
+GAMELIST_ONLY=( --include "gamelist.xml" --include "**/gamelist.xml" )
+
+# What EmulationStation owns, which a content match must never delete.
+#
+# gamelist.xml carries <playcount>, <lastplayed> and <favorite> -- per-device
+# facts that exist nowhere else -- and images/, videos/ and manuals/ hold
+# scraped artwork that can represent hours of scraping. None of it is content
+# the cloud is authoritative about, so "the cloud does not have it" is not a
+# reason to remove it.
+#
+# Found the only way these things are ever found: reading a real dry run,
+# which listed "gamelist.xml: Skipped delete" for every system on the device.
+#
+# Deliberately scoped to the match path. Whether backup should *upload* a
+# gamelist is a separate and open question (#61) -- but deleting one locally
+# is wrong under every answer to it.
+METADATA_EXCLUDES=(
+    --exclude "gamelist.xml"
+    --exclude "**/gamelist.xml"
+    --exclude "images/**"
+    --exclude "videos/**"
+    --exclude "manuals/**"
+    --exclude "magazines/**"
+    --exclude "media/**"
+)
+
+# rclone reports sizes in a NOTICE line using human units ("6.090Ki", "64Ki")
+# when the destination is local, and bare bytes for a small local-to-local
+# copy. Parsing only digits silently produced zero for every real transfer.
+to_bytes() {
+    awk '{ n = $0 + 0; u = $0; gsub(/[0-9.]/, "", u)
+           if (u == "Ki") n *= 1024
+           else if (u == "Mi") n *= 1048576
+           else if (u == "Gi") n *= 1073741824
+           else if (u == "Ti") n *= 1099511627776
+           printf "%d\n", n }'
+}
+
+# Does the content root actually hold anything? Rule 3.
+cloud_root_populated() {
+    local n
+    n=$(rclone lsf --dirs-only "${ROOT}ROMs/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | grep -c . )
+    [ "${n}" -gt 0 ] && return 0
+    rclone lsf --files-only "${ROOT}BIOS/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | grep -q . && return 0
+    return 1
+}
+
+# What one system would gain and lose. Prints "<sys>|<verb>|<files>|<bytes>".
+#
+# The counting uses rclone against the local path with the very same exclude
+# arrays the transfer uses, rather than a second hand-written find predicate:
+# a deletion predicate that can drift from the transfer predicate is how saves
+# get deleted by a tool that believes it is only touching ROMs.
+match_plan_one() {
+    local sys="$1" src local_dir n b out
+    src="$(remote_for "${sys}")"
+    local_dir="${DEST}/${sys}"
+
+    [ -d "${local_dir}" ] || { printf '%s|none|0|0\n' "${sys}"; return 0; }
+
+    if rclone lsf "${src}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | grep -q .; then
+        # Present in the cloud: sync reconciles both directions of difference.
+        out=$(rclone sync "${src}" "${local_dir}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+                "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${METADATA_EXCLUDES[@]}" \
+                --dry-run --stats 0 2>&1)
+        # "NOTICE: Game3.zip: Skipped delete as --dry-run is set (size 5)" --
+        # the exact wording on rclone 1.75.0, read off the real output rather
+        # than taken from the documentation. The size in the tail is what lets
+        # the confirmation say how much space comes back.
+        n=$(printf '%s\n' "${out}" | grep -c "Skipped delete")
+        b=$(printf '%s\n' "${out}" | sed -n 's/.*Skipped delete.*(size \([0-9.KMGTi]*\)).*/\1/p' \
+              | to_bytes | awk '{ t += $1 } END { print t+0 }')
+        printf '%s|sync|%s|%s\n' "${sys}" "${n}" "${b}"
+    else
+        # Absent from the cloud entirely: its content goes, its saves stay.
+        out=$(rclone size "${local_dir}" \
+                "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${METADATA_EXCLUDES[@]}" 2>/dev/null)
+        n=$(printf '%s\n' "${out}" | sed -n 's/^Total objects: *\([0-9]*\).*/\1/p' | head -1)
+        b=$(printf '%s\n' "${out}" | sed -n 's/^Total size: .*(\([0-9]*\) Byte).*/\1/p' | head -1)
+        [ -n "${n}" ] || n=0
+        [ -n "${b}" ] || b=0
+        [ "${n}" -eq 0 ] && { printf '%s|none|0|0\n' "${sys}"; return 0; }
+        printf '%s|remove|%s|%s\n' "${sys}" "${n}" "${b}"
+    fi
+}
+
+match_run() {
+    local apply="$1" sys line verb files bytes rc=0 sync_rc=0 del_rc=0 total_removed=0
+
+    # The exclusions are the only thing standing between this and somebody's
+    # saves, so assert they exist rather than trusting the file's layout. An
+    # unset array expands to nothing and rclone would happily proceed.
+    if [ ${#SAVE_EXCLUDES[@]} -eq 0 ] || [ ${#METADATA_EXCLUDES[@]} -eq 0 ]; then
+        echo "Refusing: the rules that keep your saves safe aren't loaded."
+        log_message "match: refused, exclusion arrays empty"
+        return 1
+    fi
+
+    # The preview is read-only and may run beside a transfer; applying is one.
+    [ "${apply}" = "1" ] && take_cloud_lock
+    # As at the foot of the script: the rest of the run cannot leak the
+    # lock into rclone. Closing a descriptor that was never opened (the
+    # preview, which takes no lock) is a no-op.
+    {
+
+    if ! cloud_root_populated; then
+        echo "Refusing to change anything: your cloud's ROMs and BIOS folder looks empty."
+        echo "That looks the same whether it really is empty, you're offline, or the"
+        echo "folder was renamed - so nothing is removed."
+        log_message "match: refused, content root lists nothing"
+        # One of the three it can tell apart: with the network gone the
+        # refusal is the no-network skip, and says so with the code
+        # EmulationStation names. Nothing ran, so no stamp.
+        if network_gone; then
+            echo "Skipped: there's no network connection. Try again when you're online."
+            log_message "match: skipped, no network"
+            exit "${EXIT_NO_NETWORK}"
+        fi
+        return 1
+    fi
+
+    mapfile -t SYS < <(selected_systems)
+    if [ ${#SYS[@]} -eq 0 ]; then
+        echo "You haven't picked any systems for this device yet."
+        return 1
+    fi
+
+    # What the page that runs this shows when it is done. A match is mostly
+    # deletion, and rclone's own totals for a deletion read "0 B / 0 B" --
+    # true and useless (maintainer, 2026-09-07). So each system is announced
+    # as a unit while it runs, and the summary at the end names what went:
+    # the numbers the confirmation showed, per system, so the last screen
+    # answers the first one.
+    local total_bytes=0 removed_detail="" unit_i=0 unit_n=${#SYS[@]} planned
+    for sys in "${SYS[@]}"; do
+        unit_i=$((unit_i + 1))
+        # Every chosen system is an item on the page, announced before its
+        # own dry run -- so the page names what is being checked while the
+        # check runs -- and announced whether or not it turns out to need
+        # anything. The page shows ITEM i OF n with this script's n, so n has
+        # to be the number of announcements the run makes and i their running
+        # count; until 2026-09-09 a system with nothing to do was skipped
+        # without one, and a run over three systems ended on ITEM 2 OF 3
+        # (#95). "Already matches the cloud" is that item's outcome, not a
+        # reason to hide it, and counting the work first would have held the
+        # page on WORKING with no item through one dry run per system. The
+        # preview (apply=0) prints plan lines for the confirmation and no
+        # markers, as before.
+        [ "${apply}" = "1" ] && echo ">>> unit ${sys}|${unit_i}|${unit_n}"
+        planned=$(match_plan_one "${sys}")
+        IFS='|' read -r _ verb files bytes <<< "${planned}"
+        case "${verb}" in
+            none)
+                [ "${apply}" = "1" ] && echo "Nothing to remove from ${sys}: it already matches the cloud."
+                continue
+            ;;
+            remove)
+                total_removed=$((total_removed + files))
+                total_bytes=$((total_bytes + bytes))
+                removed_detail="${removed_detail}${removed_detail:+,}${sys}:${files}:${bytes}"
+                if [ "${apply}" = "1" ]; then
+                    echo "Removing ${files} files from ${sys} that aren't in your cloud..."
+                    rclone delete "${DEST}/${sys}" \
+                        "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${METADATA_EXCLUDES[@]}" \
+                        --max-delete "${files}" \
+                        --log-file "${LOG_FILE}" --log-level INFO
+                    del_rc=$?
+                    if [ ${del_rc} -ne 0 ]; then
+                        rc=${del_rc}
+                        log_message "match: removing ${sys}: rclone exit ${del_rc}"
+                        echo "Couldn't finish removing files from ${sys}: $(why_for "${del_rc}" | tr 'A-Z' 'a-z')."
+                        say_why "$(why_for "${del_rc}")"
+                    fi
+                    rmdir "${DEST}/${sys}" 2>/dev/null
+                else
+                    echo "${sys}|remove|${files}|${bytes}"
+                fi
+            ;;
+            sync)
+                total_removed=$((total_removed + files))
+                total_bytes=$((total_bytes + bytes))
+                removed_detail="${removed_detail}${removed_detail:+,}${sys}:${files}:${bytes}"
+                if [ "${apply}" = "1" ]; then
+                    echo "Matching ${sys} to the cloud..."
+                    # --max-delete is the fail-closed half: if reality has
+                    # drifted from the preview the player agreed to, this
+                    # aborts rather than deleting more than they saw.
+                    #
+                    # It is a cap, not a transaction. Measured on rclone
+                    # 1.75.0: given three deletions and --max-delete 2, it
+                    # exits 7 having already removed two. So it bounds the
+                    # damage to what was previewed and does not undo it --
+                    # which is the right trade here, because the cloud still
+                    # holds everything this could remove.
+                    rclone sync "$(remote_for "${sys}")" "${DEST}/${sys}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+                        "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${METADATA_EXCLUDES[@]}" \
+                        --max-delete "${files}" \
+                        --progress --stats 1s \
+                        --log-file "${LOG_FILE}" --log-level INFO
+                    sync_rc=$?
+                    if [ ${sync_rc} -ne 0 ]; then
+                        rc=${sync_rc}
+                        # A failed unit says why: the network gone ends the
+                        # run as 69 here, anything else carries rclone's own
+                        # code up as before. Before the 69 exit, the running
+                        # totals go out on the same `>>> removed` line the
+                        # completed run prints, so the page can report
+                        # COMPLETED WITH GAPS over the deletions that did
+                        # happen -- a match is mostly deletion, and it had
+                        # already run for every system before this one
+                        # (D-UI-028; #105). The counts are the preview's,
+                        # what the player agreed to and --max-delete held
+                        # each system to; the cloud still holds every file.
+                        if network_gone; then
+                            echo ">>> removed ${total_removed}|${total_bytes}|${removed_detail}"
+                            stop_no_network match "${sync_rc}" "matching ${sys} to the cloud"
+                        fi
+                        log_message "match: matching ${sys}: rclone exit ${sync_rc}"
+                        echo "Couldn't finish matching ${sys} to the cloud: $(why_for "${sync_rc}" | tr 'A-Z' 'a-z')."
+                        say_why "$(why_for "${sync_rc}")"
+                    fi
+                else
+                    # The bytes the dry run counted, so the confirmation and
+                    # the done page agree (the preview said 78 KB where the
+                    # page then said 224 KB, 2026-09-07).
+                    echo "${sys}|sync|${files}|${bytes}"
+                fi
+            ;;
+            *)
+                # match_plan_one prints none, remove or sync; anything else
+                # is a failure to plan, and an announced item must not end
+                # in silence.
+                [ "${apply}" = "1" ] && echo "Couldn't check ${sys} against the cloud."
+                log_message "match: no plan for ${sys} (${planned})"
+                rc=1
+            ;;
+        esac
+    done
+
+    if [ "${apply}" = "1" ]; then
+        # ">>> removed 14|314572800|snes:12:300000000,gb:2:14572800" -- the
+        # page renders it on its last screen. The counts are the preview's,
+        # which is what the player agreed to; --max-delete holds the run to
+        # them, and a run that could not is a FAILED page, not a smaller number.
+        echo ">>> removed ${total_removed}|${total_bytes}|${removed_detail}"
+        log_message "match: applied, removed ${total_removed} files, rc=${rc}"
+        # The page that ran it fades; the row in the menu has to be able to
+        # answer "did that work?" afterwards, like every other cloud action.
+        record_outcome content-match "${rc}"
+    fi
+    return ${rc}
+    } 9>&-
+}
+
+content_files() {
+    local dir="$1"; shift
+    # One rule for both sides (D-CLOUD-048), set by MEDIA_MODE (D-CLOUD-050):
+    #   roms  -- ROMs and BIOS only: the scraper's folders and the game list
+    #            are neither listed nor moved
+    #   with  -- ROMs and game content together
+    #   only  -- game content alone: the scraper's folders and gamelist.xml
+    # The game list is game content (D-CLOUD-049): the scraper writes it
+    # beside the artwork, and a restored-then-scraped device must read as
+    # matching its cloud under ROMs alone.
+    local -a media=()
+    local d
+    case "${MEDIA_MODE:-roms}" in
+        roms) for d in ${MEDIA_DIRS:-images videos manuals screenshots fanart boxart wheel mix maps media}; do media+=( ! -path "${dir%/}/${d}/*" ); done
+              media+=( ! -path "${dir%/}/gamelist.xml" ) ;;
+        only) media+=( "(" -path "${dir%/}/gamelist.xml" )
+              for d in ${MEDIA_DIRS:-images videos manuals screenshots fanart boxart wheel mix maps media}; do media+=( -o -path "${dir%/}/${d}/*" ); done
+              media+=( ")" ) ;;
+    esac
+    find "${dir}" -type f \
+        ! -name '*.srm' ! -name '*.sav' ! -name '*.fs' ! -name '*.state*' \
+        ! -name '*.auto' ! -name '*.dsv*' ! -name '*.eep' ! -name '*.mpk' \
+        ! -name '*.sra' ! -name '*.mcd' ! -name '*.mcr' \
+        ! -path '*/save/*' ! -path '*/memcards/*' \
+        ! -path '*/shared/savefiles/*' ! -path '*/PPSSPP/*' \
+        ! -path '*conflicted copy*' ! -name '*.sync-conflict-*' \
+        "${media[@]}" "$@" 2>/dev/null
+}
+# Local systems that hold content, for the union scan.
+local_content_dirs() {
+    local d base
+    for d in "${DEST}"/*/; do
+        [ -d "${d}" ] || continue
+        base=$(basename "${d}")
+        case "${base}" in savefiles|savestates|screenshots|backup) continue ;; esac
+        content_files "${d}" | head -1 | grep -q . && printf '%s\n' "${base}"
+    done
+}
+# What a copy from side $1 to side $2 would move, as "count|bytes". Both
+# files are "size|relpath" listings, and a line matches only when the far
+# side has the same name at the same size -- so a file absent over there
+# counts, and so does one present at a different size, which is what
+# `rclone copy` compares (size, then modtime where the backend keeps one).
+# A same-size file is NOT counted whatever changed inside it: these listings
+# carry name and size only, so a file rewritten to the same length -- a
+# patched ROM, a re-saved config -- reads as present, though a copy would
+# move it on modtime or hash. The figure here can therefore run under what
+# a copy moves, never over. The caller also strips the game list from both
+# listings first (see --scan): its direction is decided by a modtime these
+# listings do not carry, so a differing size is not a direction. The count
+# and the bytes describe one set, so a page can put them on one line without
+# contradicting itself; until 2026-09-08 the count compared names alone and
+# would have read "0 FILES" beside a non-zero size for a ROM re-uploaded at
+# a new size.
+# Not comm(1): the image's busybox has no comm, and `comm ... | wc -l` then
+# reads 0 -- "nothing differs" -- which is the wrong way for a count to fail
+# (found in the VM, 2026-09-06). awk is what this script already runs on;
+# the getline form is safe when either file is empty, where the NR==FNR
+# idiom is not.
+delta_of() {
+    awk -F'|' -v L="$2" 'BEGIN { while ((getline x < L) > 0) a[x] = 1 }
+        !($0 in a) { n++; b += $1 } END { print n+0 "|" b+0 }' "$1"
+}
+# Drop from a cloud "size|path" listing what content_files drops locally, so
+# the two sides are counted by one rule.
+cloud_content_filter() {
+    local dirs; dirs="^($(echo ${MEDIA_DIRS} | tr ' ' '|'))$"
+    awk -F'|' -v dirs="${dirs}" -v mode="${MEDIA_MODE}" '
+        { n = split($2, seg, "/"); if (n < 2) next
+          f = seg[n]
+          game = (n > 2 && seg[2] ~ dirs) || (n == 2 && f == "gamelist.xml")
+          if (mode == "roms" && game) next
+          if (mode == "only" && !game) next
+          if (f ~ /\.(srm|sav|fs|auto|eep|mpk|sra|mcd|mcr)$/ || f ~ /\.state/ || f ~ /\.dsv/) next
+          if ($2 ~ /conflicted copy/ || f ~ /\.sync-conflict-/) next
+          if (f == "README.txt") next
+          if (n > 2 && (seg[2] == "save" || seg[2] == "memcards" || seg[2] == "PPSSPP")) next
+          print }'
+}
+# --with-media: include scraped game content (D-CLOUD-048). Off by default:
+# the scraper's folders under a system are neither moved nor counted unless
+# the switch is on, so a restored-then-scraped device does not read as
+# "different" from its cloud copy. Taken from anywhere on the command line.
+MEDIA_MODE=roms
+_ARGS=()
+for _a in "$@"; do
+    case "${_a}" in
+        --with-media) MEDIA_MODE=with ;;
+        --media-only) MEDIA_MODE=only ;;
+        *) _ARGS+=("${_a}") ;;
+    esac
+done
+set -- "${_ARGS[@]}"
+MEDIA_DIRS="images videos manuals screenshots fanart boxart wheel mix maps media"
+# What the main rclone pass carries, per mode. The game list never rides the
+# main pass: it has its own --update pass below (newest wins), which runs
+# only when game content is in scope.
+MEDIA_EXCLUDES=()
+case "${MEDIA_MODE}" in
+    roms) for _d in ${MEDIA_DIRS}; do MEDIA_EXCLUDES+=(--exclude "/${_d}/**"); done ;;
+    only) for _d in ${MEDIA_DIRS}; do MEDIA_EXCLUDES+=(--include "/${_d}/**"); done ;;
+esac
+
+case "${1}" in
+    --match)
+        # Preview by default; --apply is what deletes.
+        if [ "${2}" = "--apply" ]; then
+            match_run 1
+        else
+            match_run 0
+        fi
+        exit $?
+    ;;
+    --scan)
+        # One line per system in the union of cloud and device:
+        #   name|cloud_bytes|supported|device_bytes|files_in_cloud_not_here|files_here_not_in_cloud|bytes_in_cloud_not_here|bytes_here_not_in_cloud
+        # Both sides listed by the same rule (D-CLOUD-048) as "size|relpath"
+        # and compared by name and size (delta_of), because totals cannot say
+        # whether one side has what the other has. Fields 7 and 8 are what a
+        # copy in that direction would send; fields 5 and 6 count the same
+        # set. The game list is in the totals and never in the comparison
+        # (below). They arrived 2026-09-08; the first six keep their position
+        # and type, so a page built against six still reads this line.
+        SUP=$(supported_systems)
+        TMP=$(mktemp -d /tmp/cloud-scan.XXXXXX); trap 'rm -rf "${TMP}"' EXIT
+        rclone lsf -R --files-only --format "sp" --separator "|" "${ROOT}ROMs/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null \
+            | cloud_content_filter > "${TMP}/cloud"
+        scan_rc=${PIPESTATUS[0]}
+        # A code other than 3 from a folder that is simply not there yet
+        # (a server whose "missing" rclone does not map to "not found",
+        # #142) is an empty cloud, not one that could not be read.
+        if [ "${scan_rc}" -ne 0 ] && [ "${scan_rc}" -ne 3 ] && absent_not_broken "${ROOT}ROMs/"; then
+            log_message "scan: ROMs is not there yet (rclone exit ${scan_rc}; its nearest listable parent lacks it)"
+            scan_rc=3
+        fi
+        # BIOS is the ROMs tier's, never game content's: under --media-only it
+        # is not listed, so the union does not carry a line the page would
+        # skip and the log would puzzle over (3608 cloud BIOS files "not on
+        # this device" under game content alone, RG35XX SP, 2026-09-06).
+        if [ "${MEDIA_MODE}" != only ]; then
+            rclone lsf -R --files-only --format "sp" --separator "|" "${ROOT}BIOS/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null \
+                | grep -v '|README\.txt$' | sed 's/|/|bios\//' >> "${TMP}/cloud"
+            bios_rc=${PIPESTATUS[0]}
+            if [ "${bios_rc}" -ne 0 ] && [ "${bios_rc}" -ne 3 ] && absent_not_broken "${ROOT}BIOS/"; then
+                log_message "scan: BIOS is not there yet (rclone exit ${bios_rc}; its nearest listable parent lacks it)"
+                bios_rc=3
+            fi
+            # Keep the code that says the most. A missing folder is rclone's
+            # 3 and the one code an empty cloud gives, so a ROMs listing the
+            # cloud refused (5, 7) must not be overwritten by a BIOS folder
+            # that merely is not there yet.
+            if [ "${bios_rc}" -ne 0 ] && { [ "${scan_rc}" -eq 0 ] || [ "${scan_rc}" -eq 3 ]; }; then
+                scan_rc=${bios_rc}
+            fi
+        fi
+        # A listing that failed with the network gone is not an empty cloud,
+        # and the page must not be handed one: every system on the device
+        # would read as "not in your cloud yet". Say why, print no lines,
+        # and exit the code EmulationStation names. A listing that failed
+        # with the network up -- no ROMs folder yet, rclone's 3 -- is an
+        # empty cloud, and goes on as before.
+        if [ "${scan_rc}" -ne 0 ] && network_gone; then
+            log_message "scan: skipped, no network (rclone exit ${scan_rc})"
+            echo "Skipped: there's no network connection. Try again when you're online." >&2
+            exit "${EXIT_NO_NETWORK}"
+        fi
+        # A listing that failed with the network up is not an empty cloud
+        # either, unless the failure is that the folder is not there: rclone's
+        # 3, "directory not found", is what a cloud nothing has been backed up
+        # to yet answers, and goes on as before. Anything else -- the cloud
+        # refused the connection, rejected the sign-in, or answered with an
+        # error -- is a cloud that could not be read, and the page must say
+        # so rather than list every system on the device as "not yet in your
+        # cloud" (a refused port exited 5 and the picker offered the whole
+        # device for upload, 2026-09-10; D-CLOUD-077). rclone's code goes up
+        # unchanged: the sentinels are 75 and 69, which rclone never returns.
+        if [ "${scan_rc}" -ne 0 ] && [ "${scan_rc}" -ne 3 ]; then
+            log_message "scan: the cloud could not be read (rclone exit ${scan_rc})"
+            echo "Your cloud couldn't be read. Try again." >&2
+            exit "${scan_rc}"
+        fi
+        sizes_under "${ROOT}" | grep -vE '^(ROMs|BIOS)\|' > "${TMP}/legacy"
+        {
+            cut -d'|' -f2 "${TMP}/cloud" | cut -d/ -f1
+            local_content_dirs
+        } | sort -u | while IFS= read -r name; do
+            [ -n "${name}" ] || continue
+            # This system's cloud side, "size|relpath" under the system.
+            awk -F'|' -v n="${name}" '{ split($2, seg, "/"); if (seg[1] == n) print $1 "|" substr($2, length(n) + 2) }' "${TMP}/cloud" > "${TMP}/c"
+            # The device side by the same rule. One find per system: stat
+            # supplies the sizes, so the total needs no second pass. The
+            # prefix is cut by length, not by pattern, so a system name
+            # holding a regex character cannot mis-strip.
+            if [ -d "${DEST}/${name}" ]; then
+                content_files "${DEST}/${name}" -exec stat -c '%s|%n' {} + \
+                    | awk -v p="${DEST}/${name}/" '{ i = index($0, "|"); print substr($0, 1, i) substr($0, i + 1 + length(p)) }' > "${TMP}/l"
+            else
+                : > "${TMP}/l"
+            fi
+            cbytes=$(awk -F'|' '{ t += $1 } END { print t+0 }' "${TMP}/c")
+            lbytes=$(awk -F'|' '{ t += $1 } END { print t+0 }' "${TMP}/l")
+            # The game list is in those totals and out of the comparison.
+            # Under game content it travels in its own pass, --update, newest
+            # wins (the transfer below); these listings carry no modtime to
+            # say which side that is, so a size that differs is not a
+            # direction, and a page that counted it read "1 FILE TO RESTORE"
+            # on whichever side's list was older -- and kept reading it,
+            # since a run moves nothing that way (found in review,
+            # 2026-09-08). Any depth, as the transfer's "**/gamelist.xml".
+            # Under ROMs alone a system's own list is on neither side, so
+            # there the strip touches only a list nested in a subfolder.
+            grep -vE '[|/]gamelist\.xml$' "${TMP}/c" > "${TMP}/cd"
+            grep -vE '[|/]gamelist\.xml$' "${TMP}/l" > "${TMP}/ld"
+            IFS='|' read -r cnl cnl_bytes <<< "$(delta_of "${TMP}/cd" "${TMP}/ld")"
+            IFS='|' read -r lnc lnc_bytes <<< "$(delta_of "${TMP}/ld" "${TMP}/cd")"
+            if [ "${name}" = "bios" ] || printf '%s\n' "${SUP}" | grep -qxF "${name}"; then sup=1; else sup=0; fi
+            echo "${name}|${cbytes}|${sup}|${lbytes}|${cnl}|${lnc}|${cnl_bytes}|${lnc_bytes}"
+        done
+        # The pre-tier layout (a system straight under the content root) is
+        # listed for size alone and never compared: device_bytes and every
+        # comparison field are 0 without looking. The page reads an empty
+        # far side as "all of it moves", which is the only true reading of
+        # a line like this.
+        while IFS='|' read -r name bytes; do
+            [ -n "${name}" ] || continue
+            echo "${name}|${bytes}|0|0|0|0|0|0"
+        done < "${TMP}/legacy"
+        exit 0
+    ;;
+    --systems)
+        selected_systems
+        exit 0
+    ;;
+    --set-systems)
+        shift
+        mkdir -p "$(dirname "${SELECTION}")" 2>/dev/null
+        # An empty selection is a real answer ("none"), distinct from never
+        # having chosen; the file exists either way. Which is exactly why it
+        # is written whole or not at all: a kill mid-write left an empty
+        # file, and an empty file is a different valid choice -- every later
+        # --selected then said no systems were selected (D-CLOUD-078, #105).
+        printf '%s\n' $* | grep -v '^[[:space:]]*$' > "${SELECTION}.tmp.$$" 2>/dev/null
+        mv -f "${SELECTION}.tmp.$$" "${SELECTION}" 2>/dev/null || rm -f "${SELECTION}.tmp.$$"
+        echo "OK $(selected_systems | wc -l) selected"
+        exit 0
+    ;;
+    --selected)
+        mapfile -t DIRS < <(selected_systems)
+        if [ ${#DIRS[@]} -eq 0 ]; then
+            echo "You haven't picked any systems for this device."
+            exit 1
+        fi
+        # BIOS is not a system and is no longer a pick (maintainer, 2026-09-06):
+        # it comes with the tier whenever the cloud has it. The tier's own
+        # switch already says ROMS AND BIOS; nothing runs without them.
+        if [ "${MEDIA_MODE}" != only ] && exists_remote "${ROOT}BIOS" && ! printf '%s\n' "${DIRS[@]}" | grep -qx bios; then
+            DIRS+=("bios")
+        fi
+    ;;
+    --list)
+        # Top-level directories only; one per line, no trailing slash.
+        # Lists both locations so an upgraded device still sees content that
+        # predates CONTENT_REMOTE, rather than presenting an unexplained empty
+        # list to somebody who changed nothing.
+        {
+            # current layout, reported under the local names the rest of the
+            # script uses -- BIOS in the cloud is /storage/roms/bios here
+            rclone lsf --dirs-only "${ROOT}ROMs/" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | sed 's:/$::'
+            # the flat layout that shipped before it, minus its own containers
+            rclone lsf --dirs-only "${ROOT}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | sed 's:/$::' \
+                | grep -vxE 'ROMs|BIOS'
+            if [ -n "${CONTENT_REMOTE}" ]; then
+                rclone lsf --dirs-only "${LEGACY_ROOT}" "${RCLONE_LIST_OPTS[@]}" 2>/dev/null | sed 's:/$::' \
+                    | grep -Fxf <(legacy_dirs) 2>/dev/null
+            fi
+        } | sort -u | sed '/^$/d'
+        exit 0
+    ;;
+    --all)
+        DIRS=("")
+    ;;
+    "")
+        echo "Usage: ${SCRIPT_NAME} --list | --all | <dir> [<dir>...]" >&2
+        exit 1
+    ;;
+    *)
+        DIRS=("$@")
+    ;;
+esac
+
+
+
+STATUS=0
+take_cloud_lock
+# Everything from here to the end of the script runs with the lock
+# descriptor closed, so no child of this run can hold the lock once this
+# shell is gone -- see take_cloud_lock. The brace group is the whole of
+# the change: it adds no subshell, so exits, traps and variables behave
+# exactly as they did.
+{
+UNIT_N=${#DIRS[@]}; UNIT_I=0
+for DIR in "${DIRS[@]}"; do
+    SRC="$(resolve_src "${DIR}")"
+    TARGET="${DEST}/${DIR}"
+    UNIT_I=$((UNIT_I + 1))
+    log_message "Content restore: ${SRC} -> ${TARGET}"
+    # The marker the transfer page reads: what is being copied, and which of
+    # how many. rclone's own block totals that follow are this system's.
+    echo ">>> unit ${DIR:-everything}|${UNIT_I}|${UNIT_N}"
+    echo "Restoring ${DIR:-everything} from the cloud..."
+    # --progress is what puts the stats on stdout. With only --log-file they
+    # go to the log and the caller sees nothing -- which is why the progress
+    # card sat at "0 B / 0 B, -, 0 B/s" through a restore that was in fact
+    # copying Mega Drive ROMs the whole time. The saves path has always passed
+    # it; these two never did.
+    #
+    # And NOT --stats-one-line: that collapses the display to a totals line,
+    # losing the per-file block. A transfer of a thousand small BIOS files
+    # spends minutes between percentage changes, and the only thing that says
+    # it is alive rather than stuck is the name of the file it is on right
+    # now. --stats 1s keeps that moving.
+    #
+    # No --progress-terminal-width: the flag does not exist on every rclone we
+    # ship against (the saves scripts test for it with "rclone help | grep"
+    # before using it), and an unknown flag is a usage error that transfers
+    # nothing. rclone pads the file name out to a guessed width; the reader
+    # trims it, so the flag bought nothing worth a version check.
+    rclone copy "${SRC}" "${TARGET}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+        "${SAVE_EXCLUDES[@]}" "${CONFLICT_EXCLUDES[@]}" "${MEDIA_EXCLUDES[@]}" \
+        --exclude "gamelist.xml" --exclude "**/gamelist.xml" \
+        --progress --stats 1s \
+        --log-file "${LOG_FILE}" --log-level INFO
+    RC=$?
+
+    # The game list: newest wins, rather than whoever ran last. Game content
+    # only (D-CLOUD-049) -- under ROMs alone the file stays where it is.
+    [ "${MEDIA_MODE}" != roms ] && rclone copy "${SRC}" "${TARGET}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
+        "${GAMELIST_ONLY[@]}" --update \
+        --stats 0 \
+        --log-file "${LOG_FILE}" --log-level INFO || true
+
+    if [ ${RC} -ne 0 ] && [ ${RC} -ne 9 ]; then
+        # A failed unit says why: the network gone ends the run as 69 here,
+        # anything else carries rclone's own code up as before.
+        network_gone && stop_no_network restore "${RC}" "restoring ${DIR:-everything}"
+        log_message "restore of ${DIR:-everything}: rclone exit ${RC}"
+        echo "Couldn't finish restoring ${DIR:-everything}: $(why_for "${RC}" | tr 'A-Z' 'a-z')."
+        say_why "$(why_for "${RC}")"
+        STATUS=${RC}
+    else
+        echo "Restored ${DIR:-everything}."
+    fi
+done
+
+# The progress card is gone by the time somebody who walked away comes back, so
+# leave the outcome where the menu can read it later. Device-local state, so it
+# lives under /storage/.cache and not in the settings backup.
+record_outcome content-restore "${STATUS}"
+
+# A failed unit leaves with rclone's own code, unremapped: nothing rclone
+# returns can read as the lock sentinel now that it is 75 (#99).
+exit ${STATUS}
+} 9>&-
diff --git a/projects/ROCKNIX/packages/network/rclone/sources/cloud_migrate_layout b/projects/ROCKNIX/packages/network/rclone/sources/cloud_migrate_layout
new file mode 100755
index 0000000000..1bfc3ebd8e
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/rclone/sources/cloud_migrate_layout
@@ -0,0 +1,323 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+# cloud_migrate_layout - move a device off the original cloud folder layout.
+#
+# The first layout put everything under /GAMES, with the settings backups nested
+# inside the saves folder at /GAMES/backup. Both are wrong in ways that bite:
+#
+#   - /GAMES is a name somebody may well have used for something else, and we
+#     write into it as though it were ours.
+#   - a backup folder inside the saves folder is inside the path that a `sync`
+#     backup mirrors, so the archive is deletable by the operation meant to
+#     protect it.
+#
+# The default has been /ROCKNIX/Saves and /ROCKNIX/Backups since b35c5832b1,
+# but cloud_sync_helper only ever adds keys that are missing -- it never
+# rewrites one already in the file -- so every device configured before that
+# is still on the old layout and will stay there for ever unless asked.
+#
+# This is an offer, never automatic. Where somebody's saves live is theirs to
+# decide, and the safe answer is always to leave it alone.
+#
+#   cloud_migrate_layout --check     what would move, and whether it is safe
+#   cloud_migrate_layout --apply     do it
+#
+# Only the two folders we wrote are moved. Anything else under the old folder
+# is left exactly where it is, because it is not ours.
+
+. /etc/profile 2>/dev/null
+
+SYNC_CONF="/storage/.config/cloud_sync.conf"
+NEW_SAVES="/ROCKNIX/Saves"
+NEW_BACKUPS="/ROCKNIX/Backups"
+NEW_CONTENT="/ROCKNIX/Content"
+
+say() { echo "$@"; }
+
+remote_name() {
+    rclone listremotes 2>/dev/null | head -1
+}
+
+conf_value() {
+    grep -m1 "^$1=" "${SYNC_CONF}" 2>/dev/null | cut -d'"' -f2
+}
+
+# Does a remote path exist and hold anything?
+has_entries() {
+    [ -n "$(rclone lsf "$1" 2>/dev/null | head -1)" ]
+}
+
+# Does it hold actual files, ignoring the backup folder underneath it?
+#
+# Not the same question as "is it empty". The original layout has the backups
+# nested inside the saves folder, so a saves folder with nothing in it but
+# that subdirectory still lists an entry -- and reading that as "the saves are
+# here" would move the backups into the middle of the saves.
+has_files() {
+    local extra="$2"
+    [ -n "$(rclone lsf --files-only -R \
+            --exclude 'backup/**' --exclude 'Backups/**' ${extra} \
+            "$1" 2>/dev/null | head -1)" ]
+}
+
+# Does a remote path exist?
+#
+# NOT `rclone lsjson --stat`, which is what this used to be. On bucket-based
+# remotes (S3, B2, Minio) stat synthesises a directory entry for *any* path --
+# verified against Minio on rclone 1.60 and 1.74, where
+# "utterly-bogus-never-created" reports success with IsDir true. So it can
+# never report absence there, and every caller that branched on it took the
+# "exists" path unconditionally.
+#
+# A listing can report absence. Two questions, because a directory can be real
+# without holding files: does it contain anything, or does its parent list it
+# (which is what an --s3-directory-markers marker object produces)?
+exists() {
+    [ -n "$(rclone lsf "$1" 2>/dev/null | head -1)" ] && return 0
+    local parent name
+    parent="${1%/}"; name="${parent##*/}"; parent="${parent%/*}"
+    [ -n "${name}" ] || return 1
+    rclone lsf --dirs-only "${parent}/" 2>/dev/null | grep -qx "${name}/"
+}
+
+# Relocate a folder by copy, verify, delete -- never `rclone move`.
+#
+# move deletes as it goes, so an interruption -- a handheld dropping off wifi is
+# the normal case, not the exception -- leaves the library split across two
+# paths with no record of which files went where (#57, upgrade-and-install.md).
+# Copy first: a second run finds the copied files already present and skips
+# them. Verify by content with `rclone check`, reading its whole output rather
+# than one line of it (engineering-practices.md: rclone prints "N matching
+# files" last, and a check against the last line matched nothing). Only a
+# verified pass removes the source; a failed one leaves both sides intact and
+# says so.
+#
+# Pipelines are avoided on purpose: `rclone ... | tail` reports tail's status,
+# which is how a short backup once announced itself a success.
+relocate() {
+    local src="$1" dst="$2" what="$3" out
+    say "Copying ${what}..."
+    if ! out=$(rclone copy "${src}" "${dst}" --create-empty-src-dirs=false 2>&1); then
+        printf '%s\n' "${out}" | tail -3
+        say "FAILED copying ${what}. Both folders are intact; nothing was removed."
+        return 1
+    fi
+    say "Verifying ${what}..."
+    out=$(rclone check "${src}" "${dst}" --one-way 2>&1)
+    if ! printf '%s\n' "${out}" | grep -q "0 differences found"; then
+        printf '%s\n' "${out}" | grep -iE "differ|missing|error" | head -3
+        say "VERIFICATION FAILED for ${what}. Both folders are intact; the source was not removed."
+        return 1
+    fi
+    say "Removing the old ${what} folder..."
+    rclone purge "${src}" >/dev/null 2>&1 || say "(could not remove the old folder; the copy is complete and verified)"
+    return 0
+}
+
+# Is an existing destination a partial copy of this source, and nothing else?
+#
+# The refusals below exist so two devices' libraries are never merged. But a
+# copy interrupted half-way also leaves a destination that exists, and the same
+# refusal would then block the resume forever. The two cases differ in one
+# checkable way: a partial copy holds nothing that did not come from the
+# source. The reverse one-way check asks exactly that -- every file in dst is
+# present and identical in src -- so a foreign file in dst fails it and the
+# refusal stands.
+resumable() {
+    local src="$1" dst="$2" out
+    out=$(rclone check "${dst}" "${src}" --one-way 2>&1)
+    printf '%s\n' "${out}" | grep -q "0 differences found"
+}
+
+# What cloud_sync_helper would have derived CONTENT_REMOTE to be for a given
+# SAVES_REMOTE. The helper deliberately derives it rather than taking the shipped
+# default, so that ROMs and saves stay in one namespace -- its own comment
+# calls a split "worse than either layout alone".
+#
+# That is exactly what this script used to produce: it moved saves and backups
+# to /ROCKNIX and left CONTENT_REMOTE behind, so a migrated device looked for its
+# ROMs under a /GAMES that no longer had anything in it. Matching against the
+# derived value is how we tell our own pointer from one the owner chose --
+# theirs is left alone.
+derived_content() {
+    local sync="$1" parent
+    parent=$(dirname "${sync}")
+    [ "${parent}" = "/" ] && parent="${sync}"
+    echo "${parent%/}/Content"
+}
+
+# Move content to the current namespace if it is safe to, and repoint the
+# config. Never merges into an existing destination -- that is the same
+# interruptible half-migrated state the saves move refuses.
+migrate_content() {
+    local remote="$1" content="$2" mode="$3"
+
+    if has_entries "${remote}${content}/"; then
+        if exists "${remote}${NEW_CONTENT}" && ! resumable "${remote}${content}" "${remote}${NEW_CONTENT}"; then
+            say "REFUSING: ${remote}${NEW_CONTENT} already exists, and ${remote}${content}"
+            say "holds files. Nothing moved and the config is unchanged -- merging two"
+            say "content folders is not something to do without being asked."
+            return 4
+        fi
+        say "Would copy, verify, then remove  ${remote}${content}  ->  ${remote}${NEW_CONTENT}"
+        if [ "${mode}" != "--apply" ]; then
+            say "Nothing has been changed. Run with --apply to do it."
+            return 0
+        fi
+        if ! relocate "${remote}${content}" "${remote}${NEW_CONTENT}" "content"; then
+            say "The config is unchanged."
+            return 5
+        fi
+    else
+        say "Nothing is stored at ${remote}${content}, so only the setting changes."
+        if [ "${mode}" != "--apply" ]; then
+            say "Nothing has been changed. Run with --apply to do it."
+            return 0
+        fi
+    fi
+
+    sed -i "s|^CONTENT_REMOTE=.*|CONTENT_REMOTE=\"${NEW_CONTENT}\"|" "${SYNC_CONF}"
+    say "Content is now at ${remote}${NEW_CONTENT}."
+    return 0
+}
+
+main() {
+    local mode="${1:---check}"
+    local remote saves backups content old_root
+
+    remote=$(remote_name)
+    if [ -z "${remote}" ]; then
+        say "No cloud remote is configured; nothing to migrate."
+        return 1
+    fi
+
+    saves=$(conf_value SAVES_REMOTE)
+    backups=$(conf_value SETTINGS_REMOTE)
+
+    content=$(conf_value CONTENT_REMOTE)
+
+    # A layout the owner chose is current too. CHANGE CLOUD FOLDER writes the
+    # settings and content folders as SIBLINGS of the saves folder -- the
+    # parent's Backups and Content, or the folder's own when it sits at the
+    # root -- and a device on /Custom/Saves, /Custom/Backups, /Custom/Content
+    # has nothing to migrate. Until 2026-09-11 only the /ROCKNIX names counted
+    # as current, so this check offered to move a deliberately chosen layout
+    # back to the default one (#74). The nested first layout, backups INSIDE
+    # the saves folder, is the only shape this tool exists to move.
+    local sib_parent="${saves%/*}"; [ -n "${sib_parent}" ] || sib_parent="${saves}"
+    if [ "${saves}" != "${NEW_SAVES}" ] && [ "${backups}" = "${sib_parent}/Backups" ]; then
+        case "${content}" in
+            "${sib_parent}/Content"|"")
+                say "Already on a sibling layout of your own (${saves}, ${backups}); nothing to move."
+                return 3 ;;
+        esac
+    fi
+
+    if [ "${saves}" = "${NEW_SAVES}" ] && [ "${backups}" = "${NEW_BACKUPS}" ]; then
+        # Saves and backups are current, but a device migrated before
+        # CONTENT_REMOTE was carried along is still pointing its ROMs at the old
+        # namespace. Repair that here rather than making it a separate flow --
+        # this is the state every early migration left behind.
+        # The old SAVES_REMOTE is gone by now, so the derived value cannot be
+        # recomputed. The signature is enough: the helper always appends
+        # "/Content", so a path shaped that way and not already the current
+        # one is one of ours, left behind.
+        case "${content}" in
+            "${NEW_CONTENT}"|"") : ;;
+            */Content)
+                say "Saves and backups are current, but content still points at ${remote}${content}."
+                migrate_content "${remote}" "${content}"  "${mode}"
+                return $?
+            ;;
+        esac
+        say "Already on the current layout (${NEW_SAVES}, ${NEW_BACKUPS})."
+        return 3
+    fi
+
+    say "This device stores:"
+    say "  saves    ${remote}${saves}"
+    say "  backups  ${remote}${backups}"
+    say ""
+    say "The current layout is:"
+    say "  saves    ${remote}${NEW_SAVES}"
+    say "  backups  ${remote}${NEW_BACKUPS}"
+    say ""
+
+    # Where the saves actually are. Under the original layout SAVES_REMOTE was the
+    # folder itself; a device whose owner has already tidied them into a
+    # subfolder is the more useful case to handle, since that is what somebody
+    # does after losing files to a mirror.
+    local saves_src="${saves}"
+    # "at the root" must not count the saves subfolder, or a recursive listing
+    # finds the files inside it and concludes they were at the root all along
+    # -- which would move the whole folder, backups included, into Saves.
+    if ! has_files "${remote}${saves}/" "--exclude saves/**" \
+       && has_files "${remote}${saves}/saves/"; then
+        saves_src="${saves%/}/saves"
+        say "Saves are in ${remote}${saves_src}, not at the root."
+    fi
+
+    # Refuse to move onto something already there. A move into an existing
+    # directory is done file by file, which is exactly the interruptible,
+    # half-migrated state worth avoiding -- and it could merge two devices'
+    # libraries without anyone asking for that.
+    local blocked=0
+    for dest in "${NEW_SAVES}" "${NEW_BACKUPS}"; do
+        if exists "${remote}${dest}" && ! resumable "${remote}${saves_src}" "${remote}${dest}"; then
+            say "REFUSING: ${remote}${dest} already exists."
+            blocked=1
+        fi
+    done
+    [ "${blocked}" = "1" ] && return 4
+
+    say "Would move, server-side, leaving anything else where it is:"
+    has_files "${remote}${saves_src}/" \
+        && say "  ${remote}${saves_src}  ->  ${remote}${NEW_SAVES}"
+    has_entries "${remote}${backups}/" \
+        && say "  ${remote}${backups}  ->  ${remote}${NEW_BACKUPS}"
+
+    if [ "${mode}" != "--apply" ]; then
+        say ""
+        say "Nothing has been changed. Run with --apply to do it."
+        return 0
+    fi
+
+    say ""
+    local moved_saves=0
+    if has_files "${remote}${saves_src}/"; then
+        if relocate "${remote}${saves_src}" "${remote}${NEW_SAVES}" "saves"; then
+            moved_saves=1
+        else
+            say "Nothing else attempted."
+            return 5
+        fi
+    fi
+
+    if has_entries "${remote}${backups}/"; then
+        relocate "${remote}${backups}" "${remote}${NEW_BACKUPS}" "backups" || return 5
+    fi
+
+    # Only once the data is where the config will point. A config updated
+    # first, then a move that failed, is a device looking at an empty folder
+    # and reporting that it has no saves.
+    say "Updating ${SYNC_CONF}..."
+    sed -i "s|^SAVES_REMOTE=.*|SAVES_REMOTE=\"${NEW_SAVES}\"|" "${SYNC_CONF}"
+    sed -i "s|^SETTINGS_REMOTE=.*|SETTINGS_REMOTE=\"${NEW_BACKUPS}\"|" "${SYNC_CONF}"
+
+    # ROMs move with the saves they belong to, when the pointer is one we
+    # derived. A CONTENT_REMOTE the owner set themselves is theirs, and stays.
+    if [ -n "${content}" ] && [ "${content}" = "$(derived_content "${saves}")" ]; then
+        migrate_content "${remote}" "${content}" "${mode}"
+    elif [ -n "${content}" ] && [ "${content}" != "${NEW_CONTENT}" ]; then
+        say "Leaving CONTENT_REMOTE at ${content} -- it is not a path this migration set."
+    fi
+
+    say ""
+    say "Done. Saves are at ${remote}${NEW_SAVES}, backups at ${remote}${NEW_BACKUPS}."
+    [ "${moved_saves}" = "1" ] && say "Old folders were left in place if anything else was in them."
+    return 0
+}
+
+main "$@"
diff --git a/projects/ROCKNIX/packages/network/rclone/sources/cloud_net_ready b/projects/ROCKNIX/packages/network/rclone/sources/cloud_net_ready
new file mode 100755
index 0000000000..a3a325b024
--- /dev/null
+++ b/projects/ROCKNIX/packages/network/rclone/sources/cloud_net_ready
@@ -0,0 +1,217 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+
+# cloud_net_ready - wait for a settled network before a cloud sync starts.
+#
+# Usage: cloud_net_ready [--wait N]
+#
+#   exit 0    NetworkManager reports the connection up (STATE connected,
+#             in any connected state -- its connectivity word is only logged) and it
+#             has stayed up for GRACE seconds with a default route the
+#             whole time
+#   exit 69   no network: there is no default route and nothing is coming
+#             up -- at once, without waiting (D-CLOUD-072: a device booted
+#             with its radio off never holds the card); or a link that was
+#             coming up (NetworkManager `connecting`, or a carrier with no
+#             NetworkManager to ask) had no route by the deadline
+#             (D-CLOUD-136, #192); or N seconds (default 60) passed without
+#             a settled connection. 69 is EXIT_NO_NETWORK, the code the
+#             cloud scripts and EmulationStation share for "skipped, no
+#             network".
+#
+# Prints ">>> doing network" once, the moment it starts waiting -- which
+# includes the grace, and the wait for a route while a link comes up -- so
+# the sync card names its step: CHECKING THE CONNECTION... when the
+# interface sees a link, WAITING FOR A NETWORK, UP TO N SECONDS... when it
+# does not (#192), and a game launched meanwhile cancels the sync rather
+# than being refused (ThreadedCloudSync::cancelIfWaitingForNetwork), which
+# is what keeps this wait off the time to play (D-CLOUD-136; maintainer,
+# 2026-09-24: "If we can add the reachable wait without adding a delay to
+# the time to play, we should do it."). Nothing else on stdout on success;
+# one line saying why on a 69.
+#
+# Why. The startup sync used to begin on the first ping that came back:
+# seconds after Wi-Fi associates, which on an SDIO module is the moment it
+# is most likely to drop again (#102, #103). NetworkManager's `connected`
+# is the whole stack agreeing the link is up; holding it for a few seconds
+# is what "settled" means here. And no ping: a probe to a public host fails
+# on a LAN-only remote and on networks that block it, and passes while the
+# player's provider is down (rclone-cloud-sync.md, reachability). The
+# scripts probe the remote itself once they run.
+#
+# Busybox-compatible: sh, timeout, sleep, cat, grep, ip and nmcli, all on
+# the image (nmcli from the networkmanager package). Where nmcli is
+# missing or NetworkManager is not answering, the route test plus a carrier
+# on some interface stands in, and the log says so.
+#
+# The bound is N seconds plus at most GRACE: a connection that settles in
+# the last seconds of the wait is given its grace rather than dropped.
+
+WAIT=60
+GRACE=3
+POLL=1
+EXIT_NO_NETWORK=69
+LOG_FILE=/var/log/cloud_sync.log
+
+usage() {
+    echo "Usage: cloud_net_ready [--wait N]"
+    echo "  exit 0 when the network has been up for ${GRACE} s; 69 when there is"
+    echo "  no default route, or after N s (default ${WAIT}) without a settled one."
+}
+
+while [ $# -gt 0 ]; do
+    case "$1" in
+        --wait)   shift; WAIT="$1" ;;
+        --wait=*) WAIT="${1#--wait=}" ;;
+        -h|--help) usage; exit 0 ;;
+        *) echo "cloud_net_ready: unknown option $1" >&2; usage >&2; exit 64 ;;
+    esac
+    shift
+done
+case "${WAIT}" in
+    ''|*[!0-9]*) echo "cloud_net_ready: --wait takes a number of seconds" >&2; exit 64 ;;
+esac
+
+# Braced, so that a log that cannot be written is silent: redirections apply
+# left to right, and `>> file 2>/dev/null` reports the failed `>>` on the
+# original stderr -- which reaches the card, where any line that is not a
+# marker ends the WAITING state and with it a launch's power to cancel.
+log() {
+    { echo "[$(date '+%Y-%m-%d %H:%M:%S')] [${2:-INFO}] [cloud_net_ready] $1" >> "${LOG_FILE}"; } 2>/dev/null
+}
+
+# Hundredths of a second since boot, from the kernel: the wall clock jumps
+# when NTP or the RTC corrects it, which at boot -- the one time this runs
+# -- it does. Hundredths rather than whole seconds so "held for 3 s" is
+# three seconds and not a rounding of two point one.
+uptime_cs() {
+    local up
+    read -r up _ < /proc/uptime
+    echo "${up%.*}${up#*.}"
+}
+
+# The same test cloud_backup's check_network_link makes: reads the kernel's
+# table, sends nothing.
+has_default_route() {
+    ip -4 route show default 2>/dev/null | grep -q . \
+        || ip -6 route show default 2>/dev/null | grep -q .
+}
+
+# NetworkManager's word for the whole stack: connected, connecting,
+# disconnected, asleep, or "connected (site)" / "connected (local)" for a
+# device that is up without a default route. Empty when nmcli is absent or
+# NetworkManager does not answer within 5 s -- nmcli talks over D-Bus, and
+# an unanswered D-Bus call would otherwise wait forever, which in a tool
+# whose job is to bound a wait is the one failure it may not have.
+nm_state()        { timeout 5 nmcli -g STATE general 2>/dev/null; }
+nm_connectivity() { timeout 5 nmcli -g CONNECTIVITY general 2>/dev/null; }
+
+# The stand-in when NetworkManager cannot be asked: some interface other
+# than loopback has a carrier.
+carrier_up() {
+    local f
+    for f in /sys/class/net/*/carrier; do
+        case "${f}" in */lo/carrier) continue ;; esac
+        [ "$(cat "${f}" 2>/dev/null)" = "1" ] && return 0
+    done
+    return 1
+}
+
+START=$(uptime_cs)
+DEADLINE=$((START + WAIT * 100))
+GRACE_CS=$((GRACE * 100))
+SETTLED_SINCE=""
+ANNOUNCED=0
+FALLBACK_SAID=0
+STATE=""
+CONN=""
+
+while :; do
+    NOW=$(uptime_cs)
+
+    if ! has_default_route; then
+        # No route yet. A link that is coming up -- NetworkManager says
+        # `connecting`, or with no NetworkManager to ask some interface has
+        # a carrier -- is waited for up to the deadline, so the card's
+        # WAITING FOR A NETWORK line can be reached (#192, D-CLOUD-136; it
+        # was written in RC-11 and this exit stood in front of it). A
+        # device that is disconnected, asleep, or has its radio off exits at
+        # once as before: on the plane the card ends in a successful sync's
+        # time (D-CLOUD-072, D-CLOUD-112).
+        STATE=$(nm_state)
+        case "${STATE}" in
+            connecting*) COMING_UP=1 ;;
+            '') if carrier_up; then COMING_UP=1; else COMING_UP=0; fi ;;
+            *) COMING_UP=0 ;;
+        esac
+        if [ "${COMING_UP}" = 0 ]; then
+            echo "Skipped: there's no network connection. Try again when you're online."
+            log "no default route after $(((NOW - START) / 100))s (NetworkManager: ${STATE:-not asked}); exit ${EXIT_NO_NETWORK}"
+            exit "${EXIT_NO_NETWORK}"
+        fi
+        if [ "${NOW}" -ge "${DEADLINE}" ]; then
+            echo "Skipped: your network didn't come up in time. Try again when you're online."
+            log "no default route after ${WAIT}s while ${STATE:-a carrier} was coming up; exit ${EXIT_NO_NETWORK}"
+            exit "${EXIT_NO_NETWORK}"
+        fi
+        SETTLED_SINCE=""
+        if [ "${ANNOUNCED}" = 0 ]; then
+            echo ">>> doing network"
+            ANNOUNCED=1
+        fi
+        sleep "${POLL}"
+        continue
+    fi
+
+    STATE=$(nm_state)
+    if [ -n "${STATE}" ]; then
+        CONN=$(nm_connectivity)
+        # Any "connected" state settles -- "connected", "connected (site
+        # only)", "connected (local only)" -- once the default route above
+        # has held for GRACE seconds. NetworkManager's connectivity word is
+        # logged and not judged. It used to be: only "full" (or "unknown",
+        # or blank) settled, and "limited" or "portal" kept waiting until
+        # the deadline. The maintainer's RG SP (2026-09-12, 7eb713bbd9) sat
+        # at "connected (site only), connectivity limited" for its whole
+        # uptime while dropbox.com and two public connectivity checks
+        # answered it in under a second: NetworkManager's probe had failed
+        # once at boot and it re-checks every five minutes, so a 60 s wait
+        # could never see it change, and the startup sync ended "no
+        # network" on a device that had one. The judge of the cloud is the
+        # bounded run that follows (D-CLOUD-118): a portal or a dead link
+        # ends it within seconds with its own words, which is D-CLOUD-112's
+        # shape. "connecting" and "disconnected" still wait.
+        case "${STATE}" in
+            connected*) SETTLED=1 ;;
+            *) SETTLED=0 ;;
+        esac
+    else
+        if [ "${FALLBACK_SAID}" = 0 ]; then
+            log "nmcli unavailable or NetworkManager not answering; judging by the route and a carrier alone" WARN
+            FALLBACK_SAID=1
+        fi
+        if carrier_up; then SETTLED=1; else SETTLED=0; fi
+    fi
+
+    if [ "${SETTLED}" = 1 ]; then
+        [ -n "${SETTLED_SINCE}" ] || SETTLED_SINCE=${NOW}
+        if [ $((NOW - SETTLED_SINCE)) -ge "${GRACE_CS}" ]; then
+            log "network settled (${STATE:-carrier}${CONN:+, connectivity ${CONN}}), held ${GRACE}s, ready after $(((NOW - START) / 100))s"
+            exit 0
+        fi
+    else
+        SETTLED_SINCE=""
+        if [ "${NOW}" -ge "${DEADLINE}" ]; then
+            echo "Skipped: your network didn't come up in time. Try again when you're online."
+            log "not settled after ${WAIT}s (NetworkManager: ${STATE:-not asked}${CONN:+, connectivity ${CONN}}); exit ${EXIT_NO_NETWORK}"
+            exit "${EXIT_NO_NETWORK}"
+        fi
+    fi
+
+    if [ "${ANNOUNCED}" = 0 ]; then
+        echo ">>> doing network"
+        ANNOUNCED=1
+    fi
+    sleep "${POLL}"
+done
