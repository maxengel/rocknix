@@ -0,0 +1,23 @@
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+#
+# Put system.cfg right before anything reads it. network-base.service applies
+# system.hostname at about 1.7 s; the autostart chain that used to hold the
+# only `chksysconfig verify` runs seconds later, so a damaged system.cfg gave
+# the device an empty hostname (localhost) for the whole boot even once the
+# last good copy had been put back, and a reseeded one gave it the image's
+# name -- the RG SP's "H700" (#102). verify is idempotent; 001-setup still
+# runs it, and takes the boot-time backup once sort_settings has tidied it.
+[Unit]
+Description=ROCKNIX system.cfg last-known-good check
+DefaultDependencies=no
+After=local-fs.target systemd-tmpfiles-setup.service userconfig.service
+Before=network-base.service
+
+[Service]
+Type=oneshot
+ExecStart=/usr/bin/chksysconfig verify
+RemainAfterExit=yes
+
+[Install]
+WantedBy=sysinit.target
diff --git a/projects/ROCKNIX/packages/security/gnutls/package.mk b/projects/ROCKNIX/packages/security/gnutls/package.mk
