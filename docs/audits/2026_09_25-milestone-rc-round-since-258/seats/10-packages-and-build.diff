diff --git a/projects/ROCKNIX/packages/sysutils/busybox/sysctl.d/hang-policy.conf b/projects/ROCKNIX/packages/sysutils/busybox/sysctl.d/hang-policy.conf
new file mode 100644
index 0000000000..6277b3069b
--- /dev/null
+++ b/projects/ROCKNIX/packages/sysutils/busybox/sysctl.d/hang-policy.conf
@@ -0,0 +1,17 @@
+# A hang ends itself and leaves its trace (fork #104, D-SYS-003).
+#
+# A CPU that stops scheduling for 20 s, or a task stuck inside the kernel for
+# 120 s, is today a device that stays frozen until somebody holds the power
+# button -- which is what erased the evidence and truncated two config files
+# on the RG SP (#102). With these the kernel panics instead, ramoops keeps
+# the trace where the next boot can read it, and the device reboots itself
+# ten seconds later. panic_on_oops stays at its default of 0: an oops that
+# does not take the machine down is written to the persistent journal and the
+# player keeps their session.
+#
+# Here in /usr/lib/sysctl.d rather than under /usr/config, so it applies on
+# the first boot after an update and needs nothing copied to /storage first;
+# a device's own /storage/.config/sysctl.d still takes precedence.
+kernel.panic = 10
+kernel.softlockup_panic = 1
+kernel.hung_task_panic = 1
