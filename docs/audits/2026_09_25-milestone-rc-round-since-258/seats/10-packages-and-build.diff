diff --git a/projects/ROCKNIX/packages/initramfs/config/initramfs.x86_64.conf b/projects/ROCKNIX/packages/initramfs/config/initramfs.x86_64.conf
new file mode 100644
index 0000000000..90a4776ae7
--- /dev/null
+++ b/projects/ROCKNIX/packages/initramfs/config/initramfs.x86_64.conf
@@ -0,0 +1,6 @@
+# x86_64 glibc hardcodes the ELF interpreter path /lib64/ld-linux-x86-64.so.2.
+# The base initramfs.conf only provides /lib, /bin and /sbin usrmerge symlinks
+# (enough for aarch64, whose loader lives at /lib/ld-linux-aarch64.so.1), so
+# without /lib64 the kernel cannot exec the dynamically-linked /init (busybox)
+# and panics with "Failed to execute /init (error -2)". Provide the symlink.
+slink lib64 usr/lib 0777 0 0
