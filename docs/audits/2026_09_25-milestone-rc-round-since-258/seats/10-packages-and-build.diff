+#
+# Invoked by the kernel, never by hand: kernel.core_pattern pipes the dump to
+# this script's stdin (99-coredump.conf). Arguments, in core(5)'s order:
+#
+#   rocknix-corekeep %e %p %t %s %E
+#     %e executable name   %p pid   %t seconds since the epoch
+#     %s the fatal signal  %E the executable path, with ! for /
+#
+# Why this exists. Four emulator crashes were recorded on the handhelds
+# between 2026-09-07 and 2026-09-17 (fork #79). Exactly one could be
+# explained, and only because core_pattern had been pointed at a file by hand
+# for that session: the dump named video_texture_load_wrap_gl3_mipmap and a
+# command struct read from a returned stack frame, which is the whole reason
+# the threaded-video fix exists (libretro/RetroArch#19518). The other three
+# left a single kernel line saying the dump had been discarded. A crash that
+# cannot be read is a crash that gets argued about instead of fixed.
+#
+# What it writes, under /storage/.cache/log/cores (beside the logs the
+# var-log bind mount already keeps across a power cut):
+#
+#   core.<exe>.<epoch>.<pid>.gz   the dump, gzipped as it arrives
+#   core.<exe>.<epoch>.<pid>.txt  who died, when, on what signal, on which
+#                                 build, and whether the dump is whole
+#
+# Three rules it obeys, because this runs on somebody's game machine:
+#
+#   * It is bounded. A dump is streamed through gzip and cut off at
+#     CORE_MAX_BYTES of the raw dump (head -c before gzip, so the cap is the
+#     dump's size, not the archive's); the note says it was cut. The ring
+#     keeps CORE_KEEP newest pairs and deletes the rest, oldest first.
+#   * It refuses rather than fills the card. Under CORE_MIN_FREE_KB free it
+#     writes only the note, saying so. A player who cannot save their game
+#     because a crash dump filled the disk has been failed twice.
+#   * It never leaves the device by itself. A core is a copy of the process's
+#     memory, so it holds whatever that process held -- a RetroAchievements
+#     token, a Wi-Fi key, a password typed a minute ago. It is 0600, it is
+#     deliberately NOT collected into rocknix-evidence archives (which are
+#     built to be sent to a stranger and are redacted; a core cannot be), and
+#     nothing uploads it. Reading one is a deliberate act: copy it off with
+#     scp, knowing what is in it.
+#
+# Reading one, on a build host that has the unstripped binary:
+#
+#   gunzip -c core.retroarch.*.gz > core
+#   gdb-multiarch build.ROCKNIX-<DEVICE>.aarch64/build/retroarch-*/retroarch core
+#   (gdb) bt
+#
+# Fork-only (#104's neighbourhood, #79, #211).
+
+# Off unless somebody asked for it. The handler ships in every image and does
+# nothing until this marker exists, so a QA build and a release build are the
+# same image and there is no debug setting to remember to revert before a
+# release candidate (the maintainer's ask, 2026-09-19). Turn it on for a
+# device with:
+#
+# The marker lives on /storage, so it SURVIVES AN IN-PLACE UPDATE: a device
+# armed for troubleshooting stays armed across the next image unless it is
+# turned off. Disarm before handing a device an image meant to be evaluated
+# as it ships (D-QA-029).
+#
+#   rocknix-corekeep --on     # writes the marker, says where dumps will land
+#   rocknix-corekeep --off    # removes it; nothing is kept again
+#   rocknix-corekeep --status
+#
+# Whether this should instead be on for everyone is a real question -- four
+# unreadable crashes argue yes, and a core holds the device's credentials
+# (as /storage/.config/system/configs/system.cfg already does, on the same
+# partition) -- and it is recorded as an open decision rather than settled
+# here by default.
+CORE_MARKER="/storage/.config/keep-core-dumps"
+CORE_DIR="/storage/.cache/log/cores"
+# The cap is on the RAW bytes kept (head -c before gzip), per executable: a
+# whole RetroArch core is well under 256 MB; the interface's is mostly
+# texture memory and ran to 866 MB on x86_64, so it gets a gigabyte before
+# the stacks are lost (fork #247). CORE_MAX_BYTES in the environment sets
+# one cap for a run, which is how the scripts harness proves both notes.
+CORE_MAX_BYTES_DEFAULT=$(( 256 * 1024 * 1024 ))
+CORE_MAX_BYTES_INTERFACE=$(( 1024 * 1024 * 1024 ))
+CORE_MAX_BYTES="${CORE_MAX_BYTES:-}"
+CORE_KEEP=3
+# 512 MB of headroom, or we only write the note. The test below adds the cap
+# to it: a dump is admitted only when the card could take the whole cap and
+# still keep the headroom, since gzip -1 over texture memory can be close to
+# incompressible and a 1 GiB dump admitted at 600 MB free would fill the
+# card (audit #258, the seat's G-03). Overridable for the harness.
+CORE_MIN_FREE_KB="${CORE_MIN_FREE_KB:-$(( 512 * 1024 ))}"
+
+case "${1:-}" in
+    --on)
+        mkdir -p "$(dirname "${CORE_MARKER}")" 2>/dev/null
+        date -u '+armed %Y-%m-%d %H:%M:%S UTC' > "${CORE_MARKER}"
+        echo "core dumps will be kept under ${CORE_DIR} (ring of ${CORE_KEEP}; raw caps ${CORE_MAX_BYTES_DEFAULT} bytes, ${CORE_MAX_BYTES_INTERFACE} for the interface)"
+        echo "a core is process memory: assume it holds this device's tokens and keys"
+        exit 0 ;;
+    --off)
+        rm -f "${CORE_MARKER}"
+        echo "core dumps are discarded again; ${CORE_DIR} left as it is"
+        exit 0 ;;
+    --status)
+        if [ -f "${CORE_MARKER}" ]; then
+            echo "on ($(cat "${CORE_MARKER}" 2>/dev/null))"
+            ls -1 "${CORE_DIR}"/core.*.gz 2>/dev/null | wc -l | tr -d '\n'; echo " dump(s) kept"
+        else
+            echo "off -- no ${CORE_MARKER}"
+        fi
+        exit 0 ;;
+esac
+
+# The kernel is the only other caller, and it passes no such flag. Without the
+# marker the dump is read and dropped: the kernel needs the pipe consumed.
+if [ ! -f "${CORE_MARKER}" ]; then
+    cat > /dev/null 2>&1
+    exit 0
+fi
+
+EXE="${1:-unknown}"
+PID="${2:-0}"
+WHEN="${3:-0}"
+SIG="${4:-0}"
+EXEPATH="${5:-}"
+
+# A name that cannot escape the directory: the kernel gives %e from the
+# process, and a process can be named almost anything.
+if [ -z "${CORE_MAX_BYTES}" ]; then
+    case "${EXE}" in
+        emulationstation) CORE_MAX_BYTES="${CORE_MAX_BYTES_INTERFACE}" ;;
+        *)                CORE_MAX_BYTES="${CORE_MAX_BYTES_DEFAULT}" ;;
+    esac
+fi
+SAFE=$(printf '%s' "${EXE}" | tr -c 'A-Za-z0-9._-' '_' | cut -c1-40)
+[ -n "${SAFE}" ] || SAFE=unknown
+BASE="${CORE_DIR}/core.${SAFE}.${WHEN}.${PID}"
+
+mkdir -p "${CORE_DIR}" 2>/dev/null || exit 0
+chmod 0700 "${CORE_DIR}" 2>/dev/null
+
+note() { printf '%s\n' "$*" >> "${BASE}.txt"; }
+
+umask 077
+note "executable   ${EXE}"
+note "path         $(printf '%s' "${EXEPATH}" | tr '!' '/')"
+note "pid          ${PID}"
+note "signal       ${SIG}"
+note "when         ${WHEN} ($(date -u -d "@${WHEN}" '+%Y-%m-%d %H:%M:%S UTC' 2>/dev/null))"
+# busybox paste has no -s, and its usage text would land in the note.
+note "build        $(sed -n 's/^BUILD_ID=//p' /etc/os-release 2>/dev/null | tr -d '"' | tr '\n' ' ')"
+note "version      $(sed -n 's/^VERSION_ID=//p;s/^VERSION=//p' /etc/os-release 2>/dev/null | tr -d '"' | tr '\n' ' ')"
+note "kernel       $(uname -r 2>/dev/null)"
+
+# Free space first: the dump is the thing we can do without, the player's
+# saves are not.
+FREE_KB=$(df -k "${CORE_DIR}" 2>/dev/null | awk 'NR==2{print $4}')
+case "${FREE_KB}" in
+  ''|*[!0-9]*) FREE_KB=0 ;;
+esac
+NEED_KB=$(( CORE_MIN_FREE_KB + CORE_MAX_BYTES / 1024 ))
+if [ "${FREE_KB}" -lt "${NEED_KB}" ]; then
+    note "dump         NOT KEPT -- only ${FREE_KB} KB free, under the ${NEED_KB} KB needed (the ${CORE_MIN_FREE_KB} KB floor plus the ${CORE_MAX_BYTES} byte cap)"
+    logger -t rocknix-corekeep "${EXE} died on signal ${SIG}; dump discarded, ${FREE_KB} KB free"
+    exit 0
+fi
+
+# Stream the dump through gzip, bounded. head -c stops reading at the cap,
+# so the kernel's writer sees the pipe close and the rest is dropped -- which
+# is the intent: a truncated dump still usually carries the stack, and an
+# unbounded one can be the size of RAM.
+if head -c "${CORE_MAX_BYTES}" | gzip -1 > "${BASE}.gz" 2>/dev/null; then
+    SIZE=$(stat -c%s "${BASE}.gz" 2>/dev/null || echo 0)
+    # Whole or cut is decided by the raw count gzip records, never by the
+    # compressed size: a cut dump of zeros compresses to nothing and used to
+    # read "whole" (fork #247). At the cap, head stopped reading, so the
+    # process offered more than was kept.
+    RAW=$(gzip -l "${BASE}.gz" 2>/dev/null | awk 'NR==2{print $2}')
+    case "${RAW}" in ''|*[!0-9]*) RAW=0 ;; esac
+    # A dump of exactly the cap's size is whole, not cut: head stopped at the
+    # cap either way, so one more byte is asked of the stream -- present, the
+    # process offered more; absent, the cap was the size (the seat's G-06).
+    MORE=$(head -c 1 2>/dev/null | wc -c)
+    if [ "${RAW}" -ge "${CORE_MAX_BYTES}" ] && [ "${MORE:-0}" -ge 1 ]; then
+        note "dump         ${BASE}.gz (CUT at the cap: ${RAW} raw bytes kept of more, ${SIZE} compressed; cap ${CORE_MAX_BYTES})"
+    else
+        note "dump         ${BASE}.gz (whole: ${RAW} raw bytes, ${SIZE} compressed)"
+    fi
+    logger -t rocknix-corekeep "${EXE} died on signal ${SIG}; kept ${BASE}.gz (${SIZE} bytes)"
+else
+    note "dump         NOT KEPT -- gzip failed"
+    logger -t rocknix-corekeep "${EXE} died on signal ${SIG}; dump could not be written"
+fi
+
+note "credentials  a core is process memory: assume it holds tokens and keys. 0600, never collected, never uploaded."
+
+# The ring: newest CORE_KEEP pairs stay. Sorted by name, which sorts by the
+# epoch in it, so the oldest go first.
+ls -1 "${CORE_DIR}"/core.*.gz 2>/dev/null | sort | head -n -"${CORE_KEEP}" | while IFS= read -r OLD; do
+    rm -f "${OLD}" "${OLD%.gz}.txt"
+done
+exit 0
diff --git a/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-evidence b/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-evidence
new file mode 100755
index 0000000000..b386fc21cd
--- /dev/null
+++ b/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-evidence
@@ -0,0 +1,212 @@
+#!/bin/bash
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)
+#
+# rocknix-evidence - what the device knew, kept where a power cut cannot reach it.
+#
+#   rocknix-evidence snapshot   # one page of device state into a ring of five
+#   rocknix-evidence collect    # everything worth reading after a freeze, in one archive
+#   rocknix-evidence show       # the snapshots and archives that exist
+#
+# The RG SP froze during a startup sync and the forced power-off erased every
+# log that could have said why: the kernel's, the journal, EmulationStation's,
+# the cloud scripts' -- all in RAM (fork #102, #104). Since then /var/log is a
+# bind mount of /storage/.cache/log (var-log.mount), so those survive on their
+# own. This script adds the two things a log does not hold:
+#
+#   snapshot  -- what the device looked like a few minutes before it stopped:
+#                memory, load, temperature, the processes running, the last
+#                kernel lines, the cloud stamps. A timer runs it a minute after
+#                boot and every five minutes after that; five pages are kept,
+#                so a freeze is bracketed by the last 25 minutes of state.
+#   collect   -- one archive with the previous boot's journal, the kernel log,
+#                any pstore dump, the EmulationStation and cloud logs, the
+#                snapshots, and the size (never the content) of the config
+#                files. Run it after a device has misbehaved, before anything
+#                else is done to it; the archive is what to read and to send.
+#
+# Nothing here reads system.cfg or rclone.conf beyond their size, and every
+# file that goes into an archive or a snapshot passes through
+# redact_credentials (001-functions) first: a password, token or API key
+# reads <redacted>, the key or flag it sat under is kept. This file used to
+# say the logs carry no credential; they did -- a launch log in verbose mode
+# carried the RetroAchievements password, and a process list can carry one
+# on an emulator's command line -- so it is enforced here on the way out
+# rather than assumed of every writer (fork #176, D-INFRA-010). Without the
+# filter nothing is collected: an archive is what a player sends to a
+# stranger, and no archive beats an unfiltered one.
+# The tree is named after the log it lives beside, not after this script, so
+# a person who finds /storage/.cache/log finds everything in one place.
+
+. /etc/profile.d/001-functions 2>/dev/null
+
+EVIDENCE_DIR="/storage/.cache/log/evidence"
+RING=5
+SNAPSHOT_BYTES_MAX=$((256 * 1024))
+
+device_label() {
+  local model
+  [ -r /proc/device-tree/model ] && model=$(tr -d '\0' < /proc/device-tree/model 2>/dev/null)
+  [ -n "${model}" ] || model=$(cat /sys/class/dmi/id/product_name 2>/dev/null)
+  [ -n "${model}" ] || model="device"
+  printf '%s' "${model}" | sed -E 's/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-40
+}
+
+section() { printf '\n===== %s\n' "$1"; }
+
+# One page of state. Every command is best-effort and time-boxed so a device
+# that is already struggling is not held up by its own diagnostics.
+write_snapshot() {
+  echo "rocknix-evidence snapshot $(date '+%Y-%m-%d %H:%M:%S %Z')"
+  echo "boot_id $(cat /proc/sys/kernel/random/boot_id 2>/dev/null)"
+  echo "uptime $(cut -d' ' -f1 /proc/uptime 2>/dev/null)s   loadavg $(cat /proc/loadavg 2>/dev/null)"
+  echo "build $(sed -n 's/^BUILD_ID=//p' /etc/os-release 2>/dev/null | tr -d '"')"
+  section "memory"; free -m 2>/dev/null
+  section "pressure"; for p in cpu memory io; do [ -r "/proc/pressure/${p}" ] && { printf '%s: ' "${p}"; head -1 "/proc/pressure/${p}"; }; done
+  section "storage"; df -h /storage /tmp 2>/dev/null
+  section "thermal"; for z in /sys/class/thermal/thermal_zone*; do [ -r "${z}/temp" ] && printf '%s %s %s\n' "$(basename "${z}")" "$(cat "${z}/type" 2>/dev/null)" "$(cat "${z}/temp" 2>/dev/null)"; done
+  section "watchdog"; ls /sys/class/watchdog/ 2>/dev/null || echo "none"
+  for w in /sys/class/watchdog/watchdog*; do [ -d "${w}" ] && printf '%s identity=%s state=%s timeout=%s\n' "$(basename "${w}")" "$(cat "${w}/identity" 2>/dev/null)" "$(cat "${w}/state" 2>/dev/null)" "$(cat "${w}/timeout" 2>/dev/null)"; done
+  section "pstore (unread dumps)"; ls -la /sys/fs/pstore/ 2>/dev/null | tail -n +2
+  section "processes"; timeout 10 top -b -n 1 2>/dev/null | head -25
+  section "cloud sync"; ls -la /storage/.cache/cloud_sync/ 2>/dev/null | tail -n +2
+  if flock -n /var/run/cloud_sync.lock true 2>/dev/null; then echo "lock: free"; else echo "lock: HELD (a sync is running)"; fi
+  section "kernel, last 40 lines"; timeout 10 journalctl -k -n 40 --no-pager -o short-monotonic 2>/dev/null
+}
+
+# systemd-pstore.service archives a crash dump at boot, but its condition
+# (/sys/fs/pstore not empty) is checked about two seconds in, and on a UEFI
+# machine the previous boot's dump is not visible there yet: the panic left
+# fifteen chunks in the variable store and the service was skipped as "unmet
+# condition" while the chunks appeared a little later (VM, 2026-09-10).
+# ramoops on a handheld is visible from the first moment, so this is belt
+# and braces there -- but a dump left unread is the one piece of evidence
+# this whole tree exists for, so the first snapshot after boot archives
+# whatever the early service missed, with systemd's own tool.
+archive_unread_pstore() {
+  [ -n "$(ls -A /sys/fs/pstore 2>/dev/null)" ] || return 0
+  [ -x /usr/lib/systemd/systemd-pstore ] || return 0
+  /usr/lib/systemd/systemd-pstore >/dev/null 2>&1 && logger -t rocknix-evidence "archived a crash dump the boot-time service had not seen"
+  return 0
+}
+
+# The filter every file leaves through. A missing helper is an image fault;
+# say so once and write nothing, never an unfiltered page.
+have_filter() {
+  type redact_credentials >/dev/null 2>&1 && return 0
+  logger -t rocknix-evidence "redact_credentials is missing from /etc/profile.d/001-functions; nothing written"
+  return 1
+}
+
+# Every regular file under a directory, through the filter, in place, its
+# mtime kept (when a log was last written is evidence). A file the filter
+# cannot rewrite is removed rather than left as it was, and named. sed passes
+# bytes it does not match through untouched, and the pstore dumps are kernel
+# text, so nothing here is damaged by the pass.
+FILTERED=0; LEFT_OUT=0
+filter_tree() {
+  local f
+  while IFS= read -r -d '' f; do
+    if redact_credentials < "${f}" > "${f}.redacting" 2>/dev/null; then
+      touch -r "${f}" "${f}.redacting" 2>/dev/null
+      mv -f "${f}.redacting" "${f}"; FILTERED=$((FILTERED + 1))
+    else
+      rm -f "${f}" "${f}.redacting"; LEFT_OUT=$((LEFT_OUT + 1))
+      echo "Left out ${f#${1}/}: the credential filter couldn't rewrite it."
+    fi
+  done < <(find "$1" -type f -print0)
+  return 0
+}
+
+snapshot() {
+  have_filter || exit 0
+  mkdir -p "${EVIDENCE_DIR}" || exit 0
+  archive_unread_pstore
+  local tmp="${EVIDENCE_DIR}/state.tmp" i
+  write_snapshot 2>/dev/null | redact_credentials | head -c "${SNAPSHOT_BYTES_MAX}" > "${tmp}" || { rm -f "${tmp}"; exit 0; }
+  # Rotate like EmulationStation rotates its log: newest is state.0.txt.
+  rm -f "${EVIDENCE_DIR}/state.$((RING - 1)).txt"
+  for ((i = RING - 2; i >= 0; i--)); do
+    [ -f "${EVIDENCE_DIR}/state.${i}.txt" ] && mv -f "${EVIDENCE_DIR}/state.${i}.txt" "${EVIDENCE_DIR}/state.$((i + 1)).txt"
+  done
+  mv -f "${tmp}" "${EVIDENCE_DIR}/state.0.txt"
+}
+
+# Copy a file if it exists; never fail the collection over one missing piece.
+take() { [ -e "$1" ] && cp -a "$1" "$2" 2>/dev/null; return 0; }
+
+collect() {
+  if ! have_filter; then
+    echo "Couldn't load the credential filter (redact_credentials, /etc/profile.d/001-functions); nothing collected."
+    exit 1
+  fi
+  mkdir -p "${EVIDENCE_DIR}" || { echo "Couldn't write to ${EVIDENCE_DIR}."; exit 1; }
+  local stamp label dir out
+  stamp=$(date '+%Y_%m_%d-%H%M%S'); label=$(device_label)
+  dir="${EVIDENCE_DIR}/${stamp}-${label}-evidence"; out="${dir}.tar.gz"
+  mkdir -p "${dir}/pstore" "${dir}/snapshots" "${dir}/logs" "${dir}/stamps"
+
+  {
+    echo "collected $(date '+%Y-%m-%d %H:%M:%S %Z') on ${label}"
+    echo "uptime $(cut -d' ' -f1 /proc/uptime)s"
+    echo
+    echo "credential filter: every file in this archive has passed through redact_credentials"
+    echo "  (/etc/profile.d/001-functions). A password, token, API key or similar value reads"
+    echo "  <redacted>; the key or flag it belonged to is kept. The count is at the end of this file."
+    echo; cat /etc/os-release
+    echo; echo "cmdline: $(cat /proc/cmdline)"
+    echo; echo "boots known to the journal:"; journalctl --list-boots --no-pager 2>/dev/null
+    echo; echo "hang policy:"; for k in kernel.panic kernel.softlockup_panic kernel.hung_task_panic kernel.hung_task_timeout_secs kernel.panic_on_oops; do printf '  %s = %s\n' "${k}" "$(sysctl -n "${k}" 2>&1 | head -1)"; done
+    echo; echo "watchdog:"; ls /sys/class/watchdog/ 2>/dev/null || echo "  none"
+    for w in /sys/class/watchdog/watchdog*; do [ -d "${w}" ] && printf '  %s identity=%s state=%s timeout=%s\n' "$(basename "${w}")" "$(cat "${w}/identity" 2>/dev/null)" "$(cat "${w}/state" 2>/dev/null)" "$(cat "${w}/timeout" 2>/dev/null)"; done
+    echo; echo "persistent log mount:"; grep -E ' /var/log ' /proc/mounts || echo "  /var/log is NOT a bind mount (logs are volatile)"
+    echo; echo "config files, by size (content deliberately not collected):"
+    ls -la /storage/.config/system/configs/system.cfg* /storage/.config/emulationstation/es_settings.cfg* /storage/.config/rclone/rclone.conf 2>/dev/null | awk '{print "  " $5 "  " $6 " " $7 " " $8 "  " $9}'
+    echo; echo "what chksysconfig said at the last boots:"; journalctl --no-pager -o short-iso 2>/dev/null | grep -i 'chksysconfig' | tail -20
+  } > "${dir}/summary.txt" 2>&1
+
+  journalctl -b -1 --no-pager -o short-precise > "${dir}/journal-previous-boot.txt" 2>&1
+  journalctl -k -b -1 --no-pager -o short-precise > "${dir}/kernel-previous-boot.txt" 2>&1
+  journalctl -b 0 --no-pager -o short-precise > "${dir}/journal-this-boot.txt" 2>&1
+  dmesg > "${dir}/dmesg-this-boot.txt" 2>&1
+  cp -a /var/lib/systemd/pstore/. "${dir}/pstore/" 2>/dev/null
+  for f in /sys/fs/pstore/*; do take "${f}" "${dir}/pstore/unread-$(basename "${f}")"; done
+  for f in /var/log/es_log*.txt; do take "${f}" "${dir}/logs/"; done
+  [ -f /var/log/cloud_sync.log ] && tail -c 1048576 /var/log/cloud_sync.log > "${dir}/logs/cloud_sync.log"
+  take /var/log/exec.log "${dir}/logs/"
+  take /var/log/boot.log "${dir}/logs/"
+  for f in "${EVIDENCE_DIR}"/state.*.txt; do take "${f}" "${dir}/snapshots/"; done
+  for f in /storage/.cache/cloud_sync/*; do take "${f}" "${dir}/stamps/"; done
+
+  # Last, over everything that landed above, whatever wrote it: the filter
+  # is applied to the tree, not trusted of each writer. Then the count goes
+  # into the summary -- our own words and numbers, nothing that needs the pass.
+  filter_tree "${dir}"
+  printf '\ncredential filter: %s file(s) rewritten, %s left out\n' "${FILTERED}" "${LEFT_OUT}" >> "${dir}/summary.txt"
+
+  if tar -czf "${out}" -C "${EVIDENCE_DIR}" "$(basename "${dir}")" 2>/dev/null; then
+    rm -rf "${dir}"
+    echo "Evidence collected: ${out} ($(du -h "${out}" | cut -f1))"
+    echo "Every file in it has been through the credential filter (${FILTERED} rewritten, ${LEFT_OUT} left out)."
+    echo "Start with summary.txt, then journal-previous-boot.txt and pstore/."
+  else
+    rm -f "${out}"
+    echo "Couldn't write the archive; the pieces are in ${dir}."
+    exit 1
+  fi
+}
+
+show() {
+  echo "Snapshots (newest first):"
+  ls -la "${EVIDENCE_DIR}"/state.*.txt 2>/dev/null | awk '{print "  " $6 " " $7 " " $8 "  " $9}' || echo "  none yet"
+  echo "Archives:"
+  ls -la "${EVIDENCE_DIR}"/*-evidence.tar.gz 2>/dev/null | awk '{print "  " $5 "  " $6 " " $7 " " $8 "  " $9}' || echo "  none"
+  echo "Journal boots on record:"; journalctl --list-boots --no-pager 2>/dev/null | tail -5
+}
+
+case "${1}" in
+  snapshot) snapshot ;;
+  collect)  collect ;;
+  show|"")  show ;;
+  *) sed -n '5,9p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
+esac
diff --git a/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-systems b/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-systems
index 17a0d14a9a..492315bd80 100755
--- a/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-systems
+++ b/projects/ROCKNIX/packages/rocknix/sources/scripts/rocknix-systems
