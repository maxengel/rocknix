diff --git a/projects/ROCKNIX/devices/H700/patches/linux/0950-arm64-dts-allwinner-h616-ramoops-reserved-memory.patch b/projects/ROCKNIX/devices/H700/patches/linux/0950-arm64-dts-allwinner-h616-ramoops-reserved-memory.patch
new file mode 100644
index 0000000000..a0ba9bbd35
--- /dev/null
+++ b/projects/ROCKNIX/devices/H700/patches/linux/0950-arm64-dts-allwinner-h616-ramoops-reserved-memory.patch
@@ -0,0 +1,38 @@
+From: ROCKNIX fork <noreply@rocknix.org>
+Subject: [PATCH] arm64: dts: allwinner: h616: reserve 1 MiB for ramoops on every H700 board
+
+A panic or a detected hang on a handheld currently leaves nothing behind:
+the kernel log is in RAM and the reset that follows erases it. This adds
+a pstore/ramoops region at 0x4F000000, which every H700 board has as RAM
+and which nothing in the U-Boot boot chain touches (fork #104).
+
+---
+--- a/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
++++ b/arch/arm64/boot/dts/allwinner/sun50i-h616.dtsi
+@@ -117,6 +117,26 @@
+ 			reg = <0x0 0x40000000 0x0 0x40000>;
+ 			no-map;
+ 		};
++
++		/*
++		 * ROCKNIX (fork #104): 1 MiB for pstore/ramoops, so the kernel
++		 * log of a panic or a detected hang survives the reset that
++		 * follows it and is read back at the next boot. 0x4F000000 is
++		 * RAM on every H700 board (all carry at least 1 GiB from
++		 * 0x40000000) and nothing in the boot chain writes there: the
++		 * kernel is loaded at 0x40080000 (~32 MiB), U-Boot proper runs
++		 * at 0x4A000000, and what U-Boot loads late sits above it -- the
++		 * FDT at 0x4FA00000, the SPL's relocated stack at 0x4FE00000,
++		 * the ramdisk slot at 0x4FF00000. 512 KiB of console log and
++		 * four 128 KiB dumps, oopses and panics both.
++		 */
++		ramoops@4f000000 {
++			compatible = "ramoops";
++			reg = <0x0 0x4f000000 0x0 0x100000>;
++			record-size = <0x20000>;
++			console-size = <0x80000>;
++			max-reason = <2>;
++		};
+ 	};
+ 
+ 	osc24M: osc24M-clk {
