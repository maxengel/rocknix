+CONFIG_ROOT="/storage/.config"
+DEFAULT_ROOT="/usr/config"
+CFG_PATH="${CONFIG_ROOT}/system/configs"
+CFG="${CFG_PATH}/system.cfg"
+BACKUP="${CFG}.backup"
