@@ -0,0 +1,286 @@
+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
+
+### Phase 6: Virtualization-Specific Fixes  
+### Addresses NBD device issues and VM-specific hardware detection
+
+# Create udev rules for virtual block devices
+mkdir -p /etc/udev/rules.d
+
+cat <<EOF >/etc/udev/rules.d/90-x64-virtual-devices.conf
+# x64 Virtual Device Rules
+
+# NBD (Network Block Device) handling
+SUBSYSTEM=="block", KERNEL=="nbd*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="block", KERNEL=="nbd*", ACTION=="change", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="block", KERNEL=="nbd*", ATTRS{size}=="0", ENV{SYSTEMD_READY}="0"
+
+# Virtual RAM disks
+SUBSYSTEM=="block", KERNEL=="ram*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+
+# Virtual CD/DVD devices  
+SUBSYSTEM=="block", KERNEL=="sr*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+
+# QEMU virtual devices
+SUBSYSTEM=="block", KERNELS=="*virtio*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="net", KERNELS=="*virtio*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+
+# VMware virtual devices
+SUBSYSTEM=="block", ATTRS{vendor}=="VMware*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="net", ATTRS{vendor}=="VMware*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+
+# VirtualBox devices
+SUBSYSTEM=="block", ATTRS{vendor}=="VBOX*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="net", ATTRS{vendor}=="VBOX*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+
+# Hyper-V devices
+SUBSYSTEM=="block", ATTRS{vendor}=="Msft*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+SUBSYSTEM=="net", ATTRS{vendor}=="Msft*", ACTION=="add", ENV{SYSTEMD_READY}="1"
+EOF
+
+# Create virtualization detection and optimization service
+mkdir -p /usr/lib/systemd/system
+
+cat <<EOF >/usr/lib/systemd/system/x64-virtualization-setup.service
+[Unit]
+Description=x64 Virtualization Setup and Optimization
+After=systemd-udevd.service
+Before=multi-user.target
+ConditionVirtualization=!no
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/bin/sh -c '
+    # Detect virtualization environment
+    VIRT_TYPE=\$(systemd-detect-virt)
+    echo "Detected virtualization: \$VIRT_TYPE"
+    
+    # Create virtualization-specific optimizations
+    case "\$VIRT_TYPE" in
+        qemu|kvm)
+            echo "Applying QEMU/KVM optimizations..."
+            # Optimize for QEMU/KVM
+            echo "nbd" > /etc/modules-load.d/virtio-modules.conf
+            echo "virtio_blk" >> /etc/modules-load.d/virtio-modules.conf
+            echo "virtio_net" >> /etc/modules-load.d/virtio-modules.conf
+            echo "virtio_scsi" >> /etc/modules-load.d/virtio-modules.conf
+            ;;
+        vmware)
+            echo "Applying VMware optimizations..."
+            # VMware-specific optimizations
+            modprobe vmw_balloon 2>/dev/null || true
+            modprobe vmw_vmci 2>/dev/null || true
+            ;;
+        oracle)
+            echo "Applying VirtualBox optimizations..."
+            # VirtualBox-specific optimizations  
+            modprobe vboxguest 2>/dev/null || true
+            modprobe vboxsf 2>/dev/null || true
+            ;;
+        microsoft)
+            echo "Applying Hyper-V optimizations..."
+            # Hyper-V specific optimizations
+            modprobe hv_vmbus 2>/dev/null || true
+            modprobe hv_balloon 2>/dev/null || true
+            ;;
+    esac
+    
+    # Universal virtual device optimizations
+    echo "Applying universal VM optimizations..."
+    
+    # Disable unnecessary hardware services in VMs
+    systemctl mask hardware-detection.service 2>/dev/null || true
+    systemctl mask acpid.service 2>/dev/null || true
+    
+    # Optimize storage for VMs
+    echo deadline > /sys/block/*/queue/scheduler 2>/dev/null || true
+    
+    echo "Virtualization setup complete for \$VIRT_TYPE"
+'
+
+[Install]
+WantedBy=multi-user.target
+EOF
+
+# Create NBD device monitoring service
+cat <<EOF >/usr/lib/systemd/system/x64-nbd-monitor.service
+[Unit]
+Description=x64 NBD Device Monitor
+After=systemd-udevd.service x64-virtualization-setup.service
+ConditionVirtualization=!no
+
+[Service]
+Type=simple
+Restart=always
+RestartSec=30s
+ExecStart=/bin/sh -c '
+    # Monitor NBD devices and ensure proper state
+    while true; do
+        for nbd in /dev/nbd*; do
+            if [ -b "\$nbd" ]; then
+                nbd_num=\$(basename "\$nbd" | sed "s/nbd//")
+                
+                # Check if NBD device has content
+                if [ -r "\$nbd" ]; then
+                    size=\$(blockdev --getsize64 "\$nbd" 2>/dev/null || echo "0")
+                    if [ "\$size" = "0" ]; then
+                        # Device exists but is empty - mark as not ready
+                        udevadm trigger --action=change --property=SYSTEMD_READY=0 "\$nbd" 2>/dev/null || true
+                    else
+                        # Device has content - mark as ready
+                        udevadm trigger --action=change --property=SYSTEMD_READY=1 "\$nbd" 2>/dev/null || true
+                    fi
+                fi
+            fi
+        done
+        sleep 60
+    done
+'
+
+# Resource limits
+MemoryLimit=16M
+CPUQuota=5%
+
+[Install]
+WantedBy=multi-user.target
+EOF
+
+# Create virtual hardware detection service
+cat <<EOF >/usr/lib/systemd/system/x64-virtual-hardware-detection.service
+[Unit]
+Description=x64 Virtual Hardware Detection
+After=systemd-udevd.service
+Before=hardware-setup.service
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/bin/sh -c '
+    # Enhanced virtual hardware detection
+    mkdir -p /run/rocknix
+    
+    # Detect virtual hardware and create appropriate configurations
+    if [ -f /sys/devices/virtual/dmi/id/product_name ]; then
+        PRODUCT=\$(cat /sys/devices/virtual/dmi/id/product_name 2>/dev/null || echo "unknown")
+        echo "Detected virtual product: \$PRODUCT"
+        echo "\$PRODUCT" > /run/rocknix/virtual_product
+    fi
+    
+    if [ -f /sys/devices/virtual/dmi/id/sys_vendor ]; then
+        VENDOR=\$(cat /sys/devices/virtual/dmi/id/sys_vendor 2>/dev/null || echo "unknown")
+        echo "Detected virtual vendor: \$VENDOR"  
+        echo "\$VENDOR" > /run/rocknix/virtual_vendor
+    fi
+    
+    # Create virtual device optimizations
+    case "\$VENDOR" in
+        QEMU*)
+            echo "qemu" > /run/rocknix/vm_type
+            ;;
+        VMware*)
+            echo "vmware" > /run/rocknix/vm_type
+            ;;
+        innotek*)
+            echo "virtualbox" > /run/rocknix/vm_type
+            ;;
+        Microsoft*)
+            echo "hyperv" > /run/rocknix/vm_type
+            ;;
+        *)
+            echo "generic" > /run/rocknix/vm_type
+            ;;
+    esac
+    
+    echo "Virtual hardware detection complete"
+'
+
+[Install]
+WantedBy=sysinit.target
+EOF
+
+# Create device readiness coordination service
+cat <<EOF >/usr/lib/systemd/system/x64-device-readiness.service
+[Unit]
+Description=x64 Device Readiness Coordinator
+After=systemd-udevd.service x64-virtual-hardware-detection.service
+Before=local-fs.target
+
+[Service]
+Type=oneshot
+RemainAfterExit=yes
+ExecStart=/bin/sh -c '
+    # Coordinate device readiness for virtual environments
+    echo "Starting device readiness coordination..."
+    
+    # Wait for critical virtual devices
+    timeout=60
+    while [ \$timeout -gt 0 ]; do
+        ready=true
+        
+        # Check if virtual storage devices are ready
+        for dev in /dev/vd[a-z] /dev/sd[a-z]; do
+            if [ -b "\$dev" ]; then
+                if ! udevadm info "\$dev" | grep -q "SYSTEMD_READY=1"; then
+                    ready=false
+                    break
+                fi
+            fi
+        done
+        
+        if [ "\$ready" = "true" ]; then
+            echo "Virtual devices ready"
+            break
+        fi
+        
+        sleep 1
+        timeout=\$((timeout - 1))
+    done
+    
+    if [ \$timeout -eq 0 ]; then
+        echo "Warning: Timeout waiting for device readiness"
+    fi
+    
+    echo "Device readiness coordination complete"
+'
+
+[Install]
+WantedBy=sysinit.target
+EOF
+
+# Create enhanced modules loading for virtual environments
+mkdir -p /etc/modules-load.d
+
+cat <<EOF >/etc/modules-load.d/x64-virtual-modules.conf
+# Virtual environment modules for x64 systems
+
+# NBD (Network Block Device) support
+nbd
+
+# VirtIO modules for QEMU/KVM
+virtio
+virtio_pci
+virtio_blk
+virtio_net
+virtio_scsi
+virtio_console
+virtio_balloon
+
+# Virtual graphics
+virtio_gpu
+qxl
+bochs_drm
+EOF
+
+# Enable virtualization services
+mkdir -p /etc/systemd/system/sysinit.target.wants
+mkdir -p /etc/systemd/system/multi-user.target.wants
+
+ln -sf /usr/lib/systemd/system/x64-virtual-hardware-detection.service /etc/systemd/system/sysinit.target.wants/x64-virtual-hardware-detection.service
+ln -sf /usr/lib/systemd/system/x64-device-readiness.service /etc/systemd/system/sysinit.target.wants/x64-device-readiness.service
+ln -sf /usr/lib/systemd/system/x64-virtualization-setup.service /etc/systemd/system/multi-user.target.wants/x64-virtualization-setup.service
+ln -sf /usr/lib/systemd/system/x64-nbd-monitor.service /etc/systemd/system/multi-user.target.wants/x64-nbd-monitor.service
+
+# Log completion
+echo "Phase 6: Virtualization-specific fixes applied for Generic x86_64"
