+#!/bin/sh
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2024 ROCKNIX (https://github.com/ROCKNIX)
+
+### GENERIC_X64 Kernel parameter and early boot fixes
+
+echo "Applying kernel and early boot fixes for GENERIC_X64..."
+
+# Fix 1: Create kernel parameter overrides for systemd stability
+mkdir -p /etc/kernel
+
+cat <<EOF >/etc/kernel/cmdline.d/10-generic-x64.conf
+# GENERIC_X64 kernel parameters for systemd stability
+systemd.log_level=info
+systemd.log_target=console
+systemd.journald.forward_to_console=no
+quiet splash
+mitigations=off
+EOF
+
+# Fix 2: Create early boot environment setup
+mkdir -p /etc/systemd/system/sysinit.target.wants
+
+cat <<EOF >/etc/systemd/system/generic-x64-early-setup.service
+[Unit]
+Description=GENERIC_X64 Early System Setup
+DefaultDependencies=no
+Before=sysinit.target
+After=systemd-journald.service
+
+[Service]
+Type=oneshot
+ExecStart=/bin/sh -c 'echo "GENERIC_X64 early setup complete" > /var/log/generic-x64-setup.log'
+RemainAfterExit=yes
+StandardOutput=null
+StandardError=null
+
+[Install]
+WantedBy=sysinit.target
+EOF
+
+ln -sf /etc/systemd/system/generic-x64-early-setup.service /etc/systemd/system/sysinit.target.wants/
+
+# Fix 3: Memory and resource management for x86_64 desktop
+mkdir -p /etc/sysctl.d
+
+cat <<EOF >/etc/sysctl.d/10-generic-x64.conf
+# GENERIC_X64 system tuning
+vm.swappiness=10
+vm.dirty_ratio=15
+vm.dirty_background_ratio=5
+kernel.pid_max=32768
+fs.file-max=65536
+EOF
+
+# Fix 4: Process management improvements
+mkdir -p /etc/systemd/system.conf.d
+
+cat <<EOF >/etc/systemd/system.conf.d/10-generic-x64.conf
+[Manager]
+# Improved process management for desktop workloads
+DefaultTimeoutStartSec=30s
+DefaultTimeoutStopSec=15s
+DefaultDeviceTimeoutSec=30s
+DefaultRestartSec=100ms
+DefaultLimitNOFILE=4096
+DefaultLimitNPROC=2048
+
+# Reduce systemd overhead
+RuntimeWatchdogSec=0
+KExecWatchdogSec=0
+EOF
+
+echo "Kernel and early boot fixes applied for GENERIC_X64"
diff --git a/projects/ROCKNIX/packages/hardware/quirks/devices/QEMU Standard PC (Q35 + ICH9, 2009)/096-plymouth-communication-fixes b/projects/ROCKNIX/packages/hardware/quirks/devices/QEMU Standard PC (Q35 + ICH9, 2009)/096-plymouth-communication-fixes
