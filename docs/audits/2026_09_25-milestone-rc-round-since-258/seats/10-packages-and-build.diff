+  # copy in it, or a copy that does not list, is a failure to report.
+  if [ -n "${snap}" ] && [ ! -d "$(dirname "${snap}")" ]; then
+    say "a settings restore was cut off; the copy taken before it (${snap}) is on a folder not mounted yet, so it goes back at the next check this boot"
+    return 0
+  fi
