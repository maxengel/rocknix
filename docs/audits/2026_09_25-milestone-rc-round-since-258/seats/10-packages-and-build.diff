diff --git a/projects/ROCKNIX/bootloader/install b/projects/ROCKNIX/bootloader/install
new file mode 100755
index 0000000000..30bc5ed832
--- /dev/null
+++ b/projects/ROCKNIX/bootloader/install
@@ -0,0 +1,80 @@
+# SPDX-License-Identifier: GPL-2.0
+# Copyright (C) 2024-present ROCKNIX (https://github.com/ROCKNIX)
+
+# Portable bootloader installer for ROCKNIX
+# Handles different bootloader types based on BOOTLOADER variable
+
+echo "install: building ROCKNIX bootloader for ${DEVICE} (${BOOTLOADER}) ..."
+
+# Ensure the bootloader directory exists
+mkdir -p "${INSTALL}/usr/share/bootloader"
+
+# Handle different bootloader types
+case "${BOOTLOADER}" in
+  syslinux)
+    echo "install: installing syslinux bootloader files"
+    if [ -d "${INSTALL}/usr/share/syslinux" ]; then
+      echo "install: copying syslinux files to bootloader location"
+      cp -av "${INSTALL}/usr/share/syslinux"/* "${INSTALL}/usr/share/bootloader/"
+    else
+      echo "install: warning - syslinux files not found in ${INSTALL}/usr/share/syslinux"
+      echo "install: this may indicate syslinux package was not built for this target"
+    fi
+    ;;
+    
+  grub)
+    echo "install: installing grub bootloader files"
+    if [ -d "${INSTALL}/usr/share/grub" ]; then
+      echo "install: copying grub files to bootloader location"
+      cp -av "${INSTALL}/usr/share/grub"/* "${INSTALL}/usr/share/bootloader/"
+    else
+      echo "install: warning - grub files not found"
+    fi
+    ;;
+    
+  systemd-boot)
+    echo "install: installing systemd-boot bootloader files"
+    if [ -d "${INSTALL}/usr/lib/systemd/boot/efi" ]; then
+      echo "install: copying systemd-boot files to bootloader location"
+      cp -av "${INSTALL}/usr/lib/systemd/boot/efi"/* "${INSTALL}/usr/share/bootloader/"
+    else
+      echo "install: warning - systemd-boot files not found"
+    fi
+    ;;
+    
+  u-boot)
+    echo "install: u-boot bootloader should be handled by device-specific bootloader scripts"
+    echo "install: skipping generic bootloader installation for u-boot"
+    ;;
+    
+  qcom-abl|arm-efi)
+    # Written into the boot partition at image time, not staged into the
+    # filesystem here: scripts/mkimage generates the config for both, and
+    # projects/ROCKNIX/bootloader/mkimage's mkimage_abl() mcopies the
+    # rocknix_abl binary in. There is nothing under /usr/share for this
+    # script to copy, which is why the generic fallback below reported
+    # every Qualcomm build as an unknown bootloader with missing files --
+    # two warnings, on five targets, for a step that had already been
+    # done correctly somewhere else.
+    echo "install: ${BOOTLOADER} is written into the boot partition at image time"
+    echo "install: skipping generic bootloader installation for ${BOOTLOADER}"
+    ;;
+    
+  "")
+    echo "install: no bootloader specified (BOOTLOADER variable empty)"
+    echo "install: skipping bootloader installation"
+    ;;
+    
+  *)
+    echo "install: unknown bootloader type: ${BOOTLOADER}"
+    echo "install: attempting to copy from ${INSTALL}/usr/share/${BOOTLOADER}"
+    if [ -d "${INSTALL}/usr/share/${BOOTLOADER}" ]; then
+      echo "install: copying ${BOOTLOADER} files to bootloader location"
+      cp -av "${INSTALL}/usr/share/${BOOTLOADER}"/* "${INSTALL}/usr/share/bootloader/"
+    else
+      echo "install: warning - ${BOOTLOADER} files not found in ${INSTALL}/usr/share/${BOOTLOADER}"
+    fi
+    ;;
+esac
+
+echo "install: ROCKNIX bootloader installation completed for ${BOOTLOADER}"
