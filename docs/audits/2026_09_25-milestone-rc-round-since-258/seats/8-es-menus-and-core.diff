+				continue;
+			}
+
+			if (character == '\t')
+			{
+				auto it = stops.find(tabIndex);
+				if (it != stops.cend())
+					it->second = Math::max(it->second, xpos);
+				else
+					stops[tabIndex] = xpos;
+
+				tabIndex++;
+			}
+
+			Glyph* glyph = getGlyph(character);
+			if (glyph != NULL)
+				xpos += glyph->advance.x();
+		}
+	}
