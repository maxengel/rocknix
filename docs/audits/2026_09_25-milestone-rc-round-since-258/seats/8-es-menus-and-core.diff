+			return _("SCREENSCRAPER IS DOWN FOR MAINTENANCE. TRY AGAIN LATER.");
+		if (lower.find("identifiant") == std::string::npos && lower.find("login") == std::string::npos)
+			return _("SCREENSCRAPER ANSWERED WITH AN ERROR. TRY AGAIN LATER.");
+		break;
+	}
+
