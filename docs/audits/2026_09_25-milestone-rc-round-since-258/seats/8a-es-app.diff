+		[stillRunning, hardStop](IGuiLoadingHandler*)
+		{
+			const auto started = std::chrono::steady_clock::now();
+			bool hard = false;
+			while (stillRunning())
+			{
+				const long ms = (long) std::chrono::duration_cast<std::chrono::milliseconds>(std::chrono::steady_clock::now() - started).count();
