# build directories
/build.*/
/builds
/.fakeroot.*

# automatically downloaded source files
/sources/

# prebuild target binarys to provide
/target/

# mkpkg temp
mkpkg-temp

# options
/.libreelec

# private working directory
/.work/

# dedicated filesystem
/lost+found/

# symlinks...
/sources
/.work

# ccache
/.ccache/

# backup files
*.orig

# crap
.DS_Store
.directory

# ignore git repos from update scripts
tools/mkpkg/*.git

# ignore old linux configs
projects/**/*.old

# ROCKNIX
/.rocknix
/.cache
/.doc_cache
/.env
/.es_cache

# Allow rclone-bisync-planning.md in tmp/ even if tmp/ is ignored elsewhere
# Allow tmp/plans/bisync/ and its contents to be tracked
!tmp/plans/
!tmp/plans/bisync/
!tmp/plans/bisync/**
