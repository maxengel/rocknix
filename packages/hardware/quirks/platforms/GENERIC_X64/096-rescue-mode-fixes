### GENERIC_X64 Rescue Mode fixes
### Addresses missing sulogin utility for emergency shell

echo "Applying rescue mode fixes for GENERIC_X64..."

# Fix 1: Create systemd rescue mode configuration with fallback shell
mkdir -p /etc/systemd/system/rescue.service.d

# Completely disable rescue mode for GENERIC_X64 to avoid hardcoded path issues
systemctl mask rescue.service
systemctl mask rescue.target

# Create a dummy rescue service that just continues to default target
cat <<EOF >/etc/systemd/system/rescue.service
[Unit]
Description=Disabled Rescue Mode (GENERIC_X64)
DefaultDependencies=no
Conflicts=shutdown.target
After=sysinit.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block isolate default.target
RemainAfterExit=yes
EOF

# Fix 2: Also disable emergency mode to avoid hardcoded path issues
systemctl mask emergency.service
systemctl mask emergency.target

# Create a dummy emergency service that continues to default target
cat <<EOF >/etc/systemd/system/emergency.service
[Unit]
Description=Disabled Emergency Mode (GENERIC_X64)
DefaultDependencies=no
Conflicts=shutdown.target
After=sysinit.target
Before=shutdown.target

[Service]
Type=oneshot
ExecStart=/usr/bin/systemctl --no-block isolate default.target
RemainAfterExit=yes
EOF

echo "Rescue mode fixes applied for GENERIC_X64"