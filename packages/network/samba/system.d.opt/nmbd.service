[Unit]
Description=Samba NMB Daemon
Wants=network.target samba-config.service
After=network.target samba-config.service local-fs.target
StartLimitIntervalSec=0
ConditionPathExists=!/storage/.cache/services/samba.disabled
ConditionPathExists=/run/samba/smb.conf

[Service]
Type=forking
PIDFile=/run/samba/nmbd.pid
ExecStartPre=/usr/lib/samba/samba-config
ExecStart=/usr/sbin/nmbd
ExecReload=/bin/kill -HUP $MAINPID
TimeoutStopSec=1s
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
