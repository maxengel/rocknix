# Cloud Sync Rules - Default Configuration
# Rules use the same syntax as .gitignore

# Include save files and states
+ /savefiles/**
+ /savestates/**
+ /screenshots/**

# Include specific save directories for emulators
+ /**/*.srm
+ /**/*.sav
+ /**/*.fs
+ /**/*.state*
+ /**/*.auto
+ /**/*.dsv*
+ /n64/save/*.eep
+ /n64/save/*.mpk
+ /n64/save/*.sra
+ /n64/save/*.srm
+ /psx/memcards/*.mcd
+ /psx/memcards/*.mcr
+ /dc/shared/savefiles/**
+ /psp/PPSSPP/**

# Exclude ROMs and system directories to avoid large transfers
- /roms/**
- /bios/**
- /downloads/**
- /.cache/**
- /**/*.bin
- /**/*.iso
- /**/*.img
- /**/*.rom
- /**/*.zip
- /**/*.7z
- /**/*.chd
- /**/*.dol
- /**/*.elf

# Include everything else not explicitly excluded
+ /**
