. /etc/profile

# NOTE: to customize your backups, create a backuptool.conf file in
# /storage/.config like this:

# LOCATIONS=(
#   /storage/.config/retroarch/*
#   /storage/roms/savestates/*
#   /some/other/folder/file.name*
# )

BACKUPFOLDER="/storage/roms/backup"
ARCHIVEFOLDER="${BACKUPFOLDER}/archive"
# The name a backup is written under, and the one used to find it again.
#
# Dated, and matching what the cloud folder holds exactly -- a device that
# backs up locally and one that backs up to the cloud should produce the same
# thing under the same name, so that moving between them needs no
# translation. LEGACY_BACKUPFILE is the fixed name used before that, still
# read so an existing device restores from the archive it already has.
BACKUP_STAMP="$(date +%Y_%m_%d-%H%M%S)"
# tar, not zip.
#
# zip does not carry a symlink as a symlink, and this OS is full of them: the
# config tree links into /usr for OS-shipped content. Backups written before
# 358eb53d3f stored those targets' bytes as regular files, and busybox unzip
# then aborts the *whole* restore rather than overwrite a live symlink
# ("exists but is not a regular file"). That cost a restore, needed a second
# fix on the read side (02297b9c07), and left a skip-list in this script to
# work around archives already in the wild.
#
# tar stores a symlink as a symlink, preserves permissions and ownership, and
# extracts cleanly over an existing one. Verified on-device, because Info-ZIP
# on a desktop and busybox on a handheld disagree, which is how the original
# bug stayed invisible.
BACKUPFILE="${BACKUPFOLDER}/${BACKUP_STAMP}-${OS_NAME}_BACKUP.tar.gz"
LEGACY_BACKUPFILE="${BACKUPFOLDER}/${OS_NAME}_BACKUP.zip"

# The newest archive present, whatever it is called. Names lead with the date,
# so sorting them orders them by age.
newest_backup() {
    local found
    found=$(ls -1 "${BACKUPFOLDER}"/*-"${OS_NAME}"_BACKUP.tar.gz \
                  "${BACKUPFOLDER}"/*-"${OS_NAME}"_BACKUP.zip 2>/dev/null | sort | tail -1)
    if [ -n "${found}" ]; then
        echo "${found}"
    elif [ -f "${LEGACY_BACKUPFILE}" ]; then
        echo "${LEGACY_BACKUPFILE}"
    fi
}
ARCHIVE_KEEP=3
ESPATH="/storage/.config/emulationstation"
mkdir -p "${BACKUPFOLDER}"

fail() {
    echo -e "\e[31m${1}\e[0m"
    logger -t backuptool "${1}"
    sleep 5
    exit 1
}

note() {
    echo -e "\e[32m${1}\e[0m"
    logger -t backuptool "${1}"
}

# es_systems.cfg / es_features.cfg are OS-managed symlinks into /usr/config;
# backing up their content and restoring it as regular files would freeze the
# systems list at the backup-time version, so they are deliberately excluded.
DEFAULT=(
    /storage/.config/fancontrol.conf
    /storage/.config/backuptool.conf
    /storage/.config/system/configs/system.cfg
    /storage/.config/ppsspp/*
    /storage/.config/retroarch/*
    /storage/.config/moonlight/*
    /storage/.config/game/*
    ${ESPATH}/es_settings.cfg
    ${ESPATH}/es_input.cfg
    ${ESPATH}/scripts/*
    ${ESPATH}/themesettings/*
    ${ESPATH}/collections/*
    $(find ${ESPATH}/themes/* -type d -maxdepth 0 -not -path "*es-theme-art-book-next" -not -path "*system-theme" 2>/dev/null)
)

if [ -e "/storage/.config/backuptool.conf" ]
then
    if source /storage/.config/backuptool.conf
    then
        COMPRESSLOCATIONS=(${LOCATIONS[@]})
    else
        WARN="Error loading custom backuptool configs. Using defaults."
        echo "${WARN}"
        logger -t backuptool "${WARN}"
        COMPRESSLOCATIONS=(${DEFAULT[@]})
    fi
else
    COMPRESSLOCATIONS=(${DEFAULT[@]})
fi

case "${1}" in
    "restore")
        BACKUPFILE="$(newest_backup)"
        if [ -z "${BACKUPFILE}" ] || [ ! -f "${BACKUPFILE}" ]
        then
            fail "No backup found in ${BACKUPFOLDER}. Nothing to restore."
        fi

        # An archive is whatever it is named. Both are read: every device in
        # the field has .zip archives locally, and a format change is no
        # reason to strand them.
        case "${BACKUPFILE}" in
            *.tar.gz) ARCHIVE_KIND="tar" ;;
            *)        ARCHIVE_KIND="zip" ;;
        esac

        note "Verifying backup archive..."
        if [ "${ARCHIVE_KIND}" = "tar" ]
        then
            tar -tzf "${BACKUPFILE}" >/dev/null 2>&1 || \
                fail "Backup archive is damaged (${BACKUPFILE}). Restore aborted; nothing was changed."
        else
            unzip -t "${BACKUPFILE}" >/dev/null 2>&1 || \
                fail "Backup archive is damaged (${BACKUPFILE}). Restore aborted; nothing was changed."
        fi

        note "Restoring configuration from ${BACKUPFILE}..."
        if [ "${ARCHIVE_KIND}" = "tar" ]
        then
            # No skip-list here, and none needed. tar replaces a symlink with
            # whatever the archive holds instead of refusing and aborting, and
            # what the archive holds is the symlink itself.
            tar -xzf "${BACKUPFILE}" -C / >/dev/null
        else
            # Archives written before backups switched to regular files only
            # hold the *contents* of symlinked paths. Extracting one of those
            # over the live symlink makes busybox unzip abort the whole
            # restore, so every backup taken before that change would be
            # unrestorable here. Skip exactly those entries instead: the OS
            # owns those symlinks and provides them, and replacing one with a
            # stale copy is the bug that got them excluded from backups in the
            # first place.
            SKIP=""
            SKIPPED=0
            for ENTRY in $(unzip -l "${BACKUPFILE}" 2>/dev/null | awk 'NF>3 && $4 ~ /^storage\// {print $4}')
            do
                if [ -L "/${ENTRY}" ]
                then
                    SKIP="${SKIP} ${ENTRY}"
                    SKIPPED=$((SKIPPED + 1))
                fi
            done
            if [ "${SKIPPED}" -gt 0 ]
            then
                note "Keeping ${SKIPPED} system-provided link(s) this older backup would have overwritten."
                # -x is a mode switch: every argument after it is an exclusion.
                unzip -o "${BACKUPFILE}" -d / -x ${SKIP} >/dev/null
            else
                unzip -o "${BACKUPFILE}" -d / >/dev/null
            fi
        fi
        if [ $? -ne 0 ]
        then
            fail "Restore reported errors. Check 'logger' output; the device will NOT reboot."
        fi

        # Passwords and keys are stripped at backup time (see below); wifi and
        # similar credentials must be re-entered after a restore.
        # EmulationStation shows a native reminder on next boot to re-enter
        # the credentials that backups deliberately exclude.
        touch /storage/.config/.restore-finish-pending

        note "Restore complete. Wifi/account passwords are not part of backups and must be re-entered."
        note "Rebooting in 5 seconds so the restored configuration takes effect cleanly..."
        sync
        sleep 5
        systemctl reboot
    ;;
    "backup")
        # Guard the tool this whole path depends on. busybox provides unzip but
        # not zip, so a missing package means backup dies with a bare
        # "zip: not found" after the user has already chosen to back up.
        for TOOL in tar gzip
        do
            command -v "${TOOL}" >/dev/null 2>&1 || \
                fail "Cannot create a backup: '${TOOL}' is missing from this image."
        done
        # Rotate the previous backup into an archive folder that the cloud
        # allowlist (backup/*.zip) does not match, and keep only the newest few.
        # Rotate whatever archive is currently at the root. Each backup writes
        # a new dated name, so this is only ever the previous one.
        PREVIOUS="$(newest_backup)"
        if [ -n "${PREVIOUS}" ] && [ -f "${PREVIOUS}" ]
        then
            mkdir -p "${ARCHIVEFOLDER}"
            # Moved under the name it already has, keeping the date it was
            # taken. Re-stamping on rotation would date every archive to the
            # moment it was superseded, which is not when it was made and is
            # not what somebody hunting for "the one from before Tuesday"
            # needs. An archive written before names carried dates has none to
            # keep, so it gets one now.
            PREVIOUS_NAME="$(basename "${PREVIOUS}")"
            case "${PREVIOUS_NAME}" in
                [0-9][0-9][0-9][0-9]_*) ;;
                *) PREVIOUS_NAME="$(date -r "${PREVIOUS}" +%Y_%m_%d-%H%M%S 2>/dev/null || date +%Y_%m_%d-%H%M%S)-${PREVIOUS_NAME}" ;;
            esac
            mv "${PREVIOUS}" "${ARCHIVEFOLDER}/${PREVIOUS_NAME}"
            # Both shapes: an upgraded device still has archives written under
            # the old name, and rotation must not skip them and keep them for
            # ever while trimming only the new ones.
            ls -1t "${ARCHIVEFOLDER}"/*_BACKUP*.tar.gz "${ARCHIVEFOLDER}"/*_BACKUP*.zip \
                   "${ARCHIVEFOLDER}"/ARCHIVED_*.zip 2>/dev/null \
                | awk '!seen[$0]++' | tail -n +$((ARCHIVE_KEEP + 1)) | while read -r OLD
            do
                rm -f "${OLD}"
            done
        fi

        note "Backing up configuration to ${BACKUPFILE}..."

        # Files that carry credentials. They are held back from the archive and
        # a sanitized copy added afterwards, so a populated secret never enters
        # it at all. Sanitizing after the fact meant the real value was written
        # into the zip first and only then overwritten -- and a backup
        # interrupted in between left it there.
        SYSCFG="/storage/.config/system/configs/system.cfg"
        ESCFG="${ESPATH}/es_settings.cfg"
        RACFG="/storage/.config/retroarch/retroarch.cfg"

        # Regular files only: symlinks under the config tree point at
        # OS-shipped content (e.g. the ppsspp assets link into /usr).
        # zip -r follows them and stores their target's bytes; on restore
        # busybox unzip then refuses to overwrite the still-present
        # symlink ("exists but is not a regular file") and aborts the
        # whole restore partway. Symlinks are the OS's to provide, not
        # the backup's to carry.
        FILELIST=$(mktemp)
        SECRETLIST=$(mktemp)
        find ${COMPRESSLOCATIONS[@]} -type f 2>/dev/null > "${FILELIST}"

        # Only hold back what this backup was actually going to contain. A user
        # with custom LOCATIONS may have left these out on purpose, and adding a
        # sanitized copy regardless would put a file in their backup that they
        # had deliberately excluded.
        for CANDIDATE in "${SYSCFG}" "${ESCFG}" "${RACFG}"
        do
            if grep -qxF "${CANDIDATE}" "${FILELIST}"
            then
                echo "${CANDIDATE}" >> "${SECRETLIST}"
            fi
        done

        # busybox grep -f with an EMPTY pattern file matches nothing and prints
        # nothing, where GNU grep prints every line. The device has busybox, so
        # piping that into zip would hand it an empty list and fail the backup
        # outright -- and only for someone whose custom LOCATIONS excluded all
        # three credential files, which is exactly the case the membership check
        # above exists to support. Skip the filter when there is nothing to hold
        # back rather than relying on grep to agree across implementations.
        SENDLIST=$(mktemp)
        if [ -s "${SECRETLIST}" ]
        then
            grep -vxF -f "${SECRETLIST}" "${FILELIST}" > "${SENDLIST}"
        else
            cp "${FILELIST}" "${SENDLIST}"
        fi

        # Staged, then archived once.
        #
        # zip could append, so the old flow wrote the archive and then added
        # sanitized copies over the top. tar cannot append to a compressed
        # archive, and the staging that replaces it is the better shape
        # anyway: the sanitized file is the only version that ever exists in
        # the tree being archived, so there is no ordering in which a real
        # credential is written and later overwritten.
        STAGING=$(mktemp -d)
        if ! tar -cf - -T "${SENDLIST}" 2>/dev/null | tar -xf - -C "${STAGING}" 2>/dev/null
        then
            rm -rf "${STAGING}"
            rm -f "${BACKUPFILE}" "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"
            fail "Backup failed while collecting files; no backup file was written."
        fi

        # Wifi keys, the root password, and account passwords/tokens must never
        # leave the device (the archive can be synced to the cloud).
        if grep -qxF "${SYSCFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/system/configs"
            sed -E '/^[^#]*\.(key|password|token)=/d' "${SYSCFG}" \
                > "${STAGING}/storage/.config/system/configs/system.cfg"
        fi

        # es_settings.cfg holds the ScreenScraper password; strip it from the
        # archived copy the same way.
        if grep -qxF "${ESCFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/emulationstation"
            grep -v 'name="ScreenScraperPass"' "${ESCFG}" \
                > "${STAGING}/storage/.config/emulationstation/es_settings.cfg"
        fi

        # retroarch.cfg carries its own credentials when RetroArch's own UI
        # is used to sign in: cheevos password/token, netplay and kiosk
        # passwords, and streaming keys. Blank the values (rather than drop
        # the lines) so RetroArch still finds the keys it expects. The
        # cheevos *username* is deliberately kept - it is not a secret, and
        # the post-restore re-entry page uses it to know an account exists.
        if grep -qxF "${RACFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/retroarch"
            sed -E 's/^([a-z_]*(password|token|stream_key)) = ".*"$/\1 = ""/' "${RACFG}" \
                > "${STAGING}/storage/.config/retroarch/retroarch.cfg"
        fi

        # Member names come out as storage/... exactly as the zip's did, so
        # anything reading the archive sees the same shape.
        if ! tar -czf "${BACKUPFILE}" -C "${STAGING}" storage
        then
            rm -rf "${STAGING}"
            rm -f "${BACKUPFILE}" "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"
            fail "Backup failed; no backup file was written."
        fi
        rm -rf "${STAGING}"

        rm -f "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"

        # Last line of defence: the archive can be synced to the cloud, so
        # never ship one carrying a populated credential. This greps what
        # actually landed in the archive rather than trusting the strips above,
        # so a newly-added config file with secrets is caught the first
        # time it is backed up instead of silently leaking.
        # Text config members only, case-sensitive, anchored to a config-key
        # shape. Translation catalogues ship lines like 'Password = Пароль',
        # and scanning every member found nothing while warning on every
        # backup, which would be worse than not warning at all.
        # busybox tar has no wildcard member selection, so the members are
        # listed first and the text ones named explicitly. Same restriction as
        # before, for the same reason: -O concatenates members without
        # separators, so binary blobs run into the next file's first line and
        # defeat the anchor.
        SCANLIST=$(tar -tzf "${BACKUPFILE}" 2>/dev/null | grep -E '\.(cfg|conf|ini)$' || true)
        if [ -n "${SCANLIST}" ]
        then
            LEAKS=$(tar -xzOf "${BACKUPFILE}" ${SCANLIST} 2>/dev/null \
                | grep -acE '^[a-z_.]*(password|token|stream_key|\.key) *[=:] *"?[^"[:space:]]+' || true)
        else
            LEAKS=0
        fi
        if [ "${LEAKS}" -gt 0 ] 2>/dev/null
        then
            WARN="Warning: ${LEAKS} credential-looking line(s) in ${BACKUPFILE}. Review before sharing or syncing it."
            echo -e "\e[33m${WARN}\e[0m"
            logger -t backuptool "${WARN}"
        fi

        sync
        note "Backup complete: ${BACKUPFILE}"
        note "Copy it somewhere safe, or enable the system backup option in cloud sync."
        sleep 3
    ;;
    *)
        echo "Usage: backuptool {backup|restore}"
        exit 1
    ;;
esac
