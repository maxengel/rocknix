#!/bin/bash

# SPDX-License-Identifier: GPL-2.0-or-later
# Copyright (C) 2020-present Shanti Gilbert (https://github.com/shantigilbert)
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2026-present ROCKNIX (https://github.com/ROCKNIX)

. /etc/profile

# NOTE: to customize your backups, create a backuptool.conf file in
# /storage/.config like this:

# LOCATIONS=(
#   /storage/.config/retroarch/*
#   /storage/roms/savestates/*
#   /some/other/folder/file.name*
# )

# The folder the settings tier reads: cloud_backup uploads from
# SETTINGS_BACKUPS in cloud_sync.conf, and this must write where that reads,
# or the settings tier (backuptool backup && cloud_backup --system-only)
# archives into one folder and uploads from another. Found by the round-trip
# harness on 2026-09-06 (Gate 0, #35): the value was a constant here.
# BACKUPFOLDER is the name an un-migrated conf still carries (D-UI-022).
SETTINGS_BACKUPS="/storage/roms/backup"
if [ -f /storage/.config/cloud_sync.conf ]; then
    _configured=$(sed -n 's/^SETTINGS_BACKUPS="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /storage/.config/cloud_sync.conf | head -1)
    [ -z "${_configured}" ] && _configured=$(sed -n 's/^BACKUPFOLDER="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /storage/.config/cloud_sync.conf | head -1)
    [ -n "${_configured}" ] && SETTINGS_BACKUPS="${_configured}"
    unset _configured
fi
ARCHIVEFOLDER="${SETTINGS_BACKUPS}/archive"
# The name a backup is written under, and the one used to find it again.
#
# Dated, and matching what the cloud folder holds exactly -- a device that
# backs up locally and one that backs up to the cloud should produce the same
# thing under the same name, so that moving between them needs no
# translation. LEGACY_BACKUPFILE is the fixed name used before that, still
# read so an existing device restores from the archive it already has.
#
# _SETTINGS is the fourth name this file has carried (D-UI-022, 2026-09-06):
# the archive holds emulator and interface settings and nothing else, and
# calling it a system backup had people expecting their saves to be in it.
# Every reader below still accepts the three earlier names.
BACKUP_STAMP="$(date +%Y_%m_%d-%H%M%S)"
# The device's name sits between the stamp and -${OS_NAME}_SETTINGS.
#
# Every device used to write <stamp>-ROCKNIX_SETTINGS.tar.gz, so two
# handhelds' archives were told apart by nothing. Maintainer, 2026-09-08: a
# backup from the RG SP and one from the RG35XX SP, and no way to say from the
# names which came from which. The hostname would not do -- one device's owner
# had set it, the other still said ROCKNIX -- so the name is the one
# cloud_device_id derives from the device tree ("Anbernic-RG-SP", D-CLOUD-009):
# stable, readable, and already path-safe.
#
# It goes in the MIDDLE, not in place of ROCKNIX, on purpose:
#
#     2026_09_08-161022-Anbernic-RG-SP-ROCKNIX_SETTINGS.tar.gz
#
# The stamp stays first, so a listing still sorts by age; and the name still
# ends in -ROCKNIX_SETTINGS.tar.gz, so the glob every reader already has --
# newest_backup below, and the same function in every image already on a
# device -- matches it unchanged. A first cut put the label where ROCKNIX was,
# and an older image's finder then found nothing when it pulled a new archive
# down from the cloud (review, 2026-09-08).
#
# The helper is resolved beside this script or at /usr/bin, never via PATH,
# which /etc/profile rewrote above. With no helper there is no label, and the
# name is the one every older archive carries.
device_label() {
    local tool
    tool="$(dirname "$(readlink -f "$0")")/cloud_device_id"
    [ -x "${tool}" ] || tool="/usr/bin/cloud_device_id"
    [ -x "${tool}" ] && "${tool}" --label 2>/dev/null | tr -cd 'A-Za-z0-9_-'
}
DEVICE_LABEL="$(device_label)"
# tar, not zip.
#
# zip does not carry a symlink as a symlink, and this OS is full of them: the
# config tree links into /usr for OS-shipped content. Backups written before
# 358eb53d3f stored those targets' bytes as regular files, and busybox unzip
# then aborts the *whole* restore rather than overwrite a live symlink
# ("exists but is not a regular file"). That cost a restore, needed a second
# fix on the read side (02297b9c07), and left a skip-list in this script to
# work around archives already in the wild.
#
# tar stores a symlink as a symlink, preserves permissions and ownership, and
# extracts cleanly over an existing one. Verified on-device, because Info-ZIP
# on a desktop and busybox on a handheld disagree, which is how the original
# bug stayed invisible.
BACKUPFILE="${SETTINGS_BACKUPS}/${BACKUP_STAMP}-${DEVICE_LABEL:+${DEVICE_LABEL}-}${OS_NAME}_SETTINGS.tar.gz"
LEGACY_BACKUPFILE="${SETTINGS_BACKUPS}/${OS_NAME}_BACKUP.zip"

# The newest archive present, whatever it is called and whichever device wrote
# it. Names lead with the date, so sorting them orders them by age.
#
# Any device's, on purpose. A device that has just pulled another handheld's
# archive from the cloud (the fresh-device journey, #26) has it beside its own
# or in place of it, and "restore the newest backup" -- which is what the menu
# promises -- must apply it. These globs are the ones this function has always
# had: a labelled name ends in -ROCKNIX_SETTINGS.tar.gz like every archive
# before it, so the first glob takes the new shape and the old alike, and the
# other two take the two dated names before that. Unchanged, so that an image
# from before the label finds a new archive with the very same code.
newest_backup() {
    local found
    found=$(ls -1 "${SETTINGS_BACKUPS}"/*-"${OS_NAME}"_SETTINGS.tar.gz \
                  "${SETTINGS_BACKUPS}"/*-"${OS_NAME}"_BACKUP.tar.gz \
                  "${SETTINGS_BACKUPS}"/*-"${OS_NAME}"_BACKUP.zip 2>/dev/null | sort | tail -1)
    if [ -n "${found}" ]; then
        echo "${found}"
    elif [ -f "${LEGACY_BACKUPFILE}" ]; then
        echo "${LEGACY_BACKUPFILE}"
    fi
}
ARCHIVE_KEEP=3
ESPATH="/storage/.config/emulationstation"
mkdir -p "${SETTINGS_BACKUPS}"

# What the player sees, and what the log keeps. The first argument is the
# screen line: a sentence in the player's words that says what did not
# happen, what is in place, and what to do -- never a path, a code, a log or a
# tool's name (D-CLOUD-077, D-UI-028). The second, when given, is detail for
# the system log only. Until 2026-09-10 these printed "Restore reported
# errors. Check 'logger' output" and paths under /storage to a 3.5-inch
# screen.
fail() {
    echo -e "\e[31m${1}\e[0m"
    logger -t backuptool "${1}${2:+ -- ${2}}"
    sleep 5
    exit 1
}

note() {
    echo -e "\e[32m${1}\e[0m"
    logger -t backuptool "${1}${2:+ -- ${2}}"
}

# The one protocol line the transfer page and the sync card read for why a
# run did not finish (D-UI-028): upper case, the player's words. This tool's
# output is discarded in EmulationStation's chains today and shown verbatim
# on the console flows; the line is here for when those hops move onto the
# page (#105, tranche B).
why() {
    echo ">>> why ${1}"
}

# es_systems.cfg / es_features.cfg are OS-managed symlinks into /usr/config;
# backing up their content and restoring it as regular files would freeze the
# systems list at the backup-time version, so they are deliberately excluded.
DEFAULT=(
    /storage/.config/fancontrol.conf
    /storage/.config/backuptool.conf
    /storage/.config/system/configs/system.cfg
    /storage/.config/ppsspp/*
    /storage/.config/retroarch/*
    /storage/.config/moonlight/*
    /storage/.config/game/*
    ${ESPATH}/es_settings.cfg
    ${ESPATH}/es_input.cfg
    ${ESPATH}/scripts/*
    ${ESPATH}/themesettings/*
    ${ESPATH}/collections/*
    $(find ${ESPATH}/themes/* -type d -maxdepth 0 -not -path "*es-theme-art-book-next" -not -path "*system-theme" 2>/dev/null)
    # Player-supplied presentation assets. Not ROMs and not BIOS, so content
    # sync does not carry them; not saves either. They were in no tier at all
    # until this line, which is the kind of gap that is only discovered when
    # somebody restores a device and finds their overlays gone.
    #
    # They live here rather than in content sync because they are small and
    # change with the configuration they belong to. A large bezel pack is the
    # exception, and it will grow this archive -- which is uploaded whole on
    # every backup, so a player with hundreds of megabytes of overlays should
    # know that. See #45 on archive size generally.
    /storage/roms/bezels/*
    /storage/roms/themes/*
    # Systems whose content EmulationStation keeps outside /storage/roms.
    # Neither the saves tier (which spans /storage/roms) nor content sync
    # (same) can reach these, so before this line they were captured by
    # nothing at all and a ScummVM or idTech player lost their entries on
    # restore. /storage/roms/music is NOT the music system -- ES reads
    # playlists from gmu, and the roms folder of that name is a leftover.
    /storage/.config/gmu/playlists/*
    /storage/.config/idtech/*
    /storage/.config/modules/*
    /storage/.config/scummvm/games/*
)

if [ -e "/storage/.config/backuptool.conf" ]
then
    if source /storage/.config/backuptool.conf
    then
        COMPRESSLOCATIONS=(${LOCATIONS[@]})
    else
        WARN="YOUR CUSTOM BACKUP LIST COULDN'T BE READ. THE STANDARD LIST IS USED."
        echo "${WARN}"
        logger -t backuptool "${WARN} -- /storage/.config/backuptool.conf failed to source"
        COMPRESSLOCATIONS=(${DEFAULT[@]})
    fi
else
    COMPRESSLOCATIONS=(${DEFAULT[@]})
fi

# Is this archive whole? tar lists every member or fails; busybox unzip has
# no -t, so for a zip the listing is the test (a truncated zip has no central
# directory to list) -- and the -t is tried first for an unzip that has it.
# Until 2026-09-10 the zip check was `unzip -t` alone, which busybox answers
# with its usage text and exit 1, so every legacy .zip on a device read as
# damaged.
archive_ok() {
    case "${1}" in
        *.tar.gz) tar -tzf "${1}" >/dev/null 2>&1 ;;
        *)        unzip -t "${1}" >/dev/null 2>&1 || unzip -l "${1}" >/dev/null 2>&1 ;;
    esac
}

# Write one settings archive to TARGET, whole or not at all.
#
# Staged, then archived once, to TARGET.partial; listed back (tar -tzf) as
# the positive check that it is complete; only then renamed to TARGET. A
# kill or a power cut at any point leaves TARGET as it was -- absent, or the
# previous archive -- and at most a .partial beside it that nothing reads
# (every glob here and in cloud_backup ends in .tar.gz). Until 2026-09-10
# the archive was written straight under its final dated name, so a cut
# mid-tar left a truncated file that newest_backup picked as the newest and
# cloud_backup sent to the cloud (D-CLOUD-078, #105).
#
# With STRIP=1 the credential-carrying files are held back and a sanitized
# copy archived instead (the archive can be synced to the cloud). The
# pre-restore snapshot passes 0: it never leaves the device, and putting it
# back must give the player exactly the settings they had, passwords too.
#
# Returns 0 when TARGET holds a verified archive; 2 when nothing could be
# collected (an unreadable input, or nothing to collect); 3 when the archive
# could not be written or did not list back. TARGET is untouched on 2 and 3.
write_archive() {
    local TARGET="${1}" STRIP="${2:-1}"
    local SYSCFG="/storage/.config/system/configs/system.cfg"
    local ESCFG="${ESPATH}/es_settings.cfg"
    local RACFG="/storage/.config/retroarch/retroarch.cfg"
    local FILELIST SECRETLIST SENDLIST STAGING CANDIDATE

    # Regular files only: symlinks under the config tree point at
    # OS-shipped content (e.g. the ppsspp assets link into /usr).
    # zip -r follows them and stores their target's bytes; on restore
    # busybox unzip then refuses to overwrite the still-present
    # symlink ("exists but is not a regular file") and aborts the
    # whole restore partway. Symlinks are the OS's to provide, not
    # the backup's to carry.
    FILELIST=$(mktemp)
    SECRETLIST=$(mktemp)
    SENDLIST=$(mktemp)
    find ${COMPRESSLOCATIONS[@]} -type f 2>/dev/null > "${FILELIST}"
    if [ ! -s "${FILELIST}" ]
    then
        # busybox tar given an empty list writes nothing readable.
        rm -f "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"
        return 2
    fi

    # Only hold back what this backup was actually going to contain. A user
    # with custom LOCATIONS may have left these out on purpose, and adding a
    # sanitized copy regardless would put a file in their backup that they
    # had deliberately excluded.
    if [ "${STRIP}" = "1" ]
    then
        for CANDIDATE in "${SYSCFG}" "${ESCFG}" "${RACFG}"
        do
            if grep -qxF "${CANDIDATE}" "${FILELIST}"
            then
                echo "${CANDIDATE}" >> "${SECRETLIST}"
            fi
        done
    fi

    # busybox grep -f with an EMPTY pattern file matches nothing and prints
    # nothing, where GNU grep prints every line. The device has busybox, so
    # piping that into zip would hand it an empty list and fail the backup
    # outright -- and only for someone whose custom LOCATIONS excluded all
    # three credential files, which is exactly the case the membership check
    # above exists to support. Skip the filter when there is nothing to hold
    # back rather than relying on grep to agree across implementations.
    if [ -s "${SECRETLIST}" ]
    then
        grep -vxF -f "${SECRETLIST}" "${FILELIST}" > "${SENDLIST}"
    else
        cp "${FILELIST}" "${SENDLIST}"
    fi

    # Staged, then archived once.
    #
    # zip could append, so the old flow wrote the archive and then added
    # sanitized copies over the top. tar cannot append to a compressed
    # archive, and the staging that replaces it is the better shape
    # anyway: the sanitized file is the only version that ever exists in
    # the tree being archived, so there is no ordering in which a real
    # credential is written and later overwritten.
    STAGING=$(mktemp -d)
    # pipefail, in a subshell so it does not leak into the rest of the
    # script: a pipeline's status is its LAST command's, so without this
    # the guard tested the extracting tar and ignored the collecting one.
    # The collector exits 1 on an unreadable input or an unwritable target
    # and the pipeline still reported 0, so a short archive was written and
    # announced as a success.
    ( set -o pipefail
      tar -cf - -T "${SENDLIST}" 2>/dev/null | tar -xf - -C "${STAGING}" 2>/dev/null )
    if [ $? -ne 0 ]
    then
        rm -rf "${STAGING}"
        rm -f "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"
        return 2
    fi

    if [ "${STRIP}" = "1" ]
    then
        # Wifi keys, the root password, and account passwords/tokens must
        # never leave the device (the archive can be synced to the cloud).
        if grep -qxF "${SYSCFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/system/configs"
            sed -E '/^[^#]*\.(key|password|token)=/d' "${SYSCFG}" \
                > "${STAGING}/storage/.config/system/configs/system.cfg"
        fi

        # es_settings.cfg holds the ScreenScraper account password and, on
        # fork builds, the developer password entered on the device (#64);
        # strip both from the archived copy the same way.
        if grep -qxF "${ESCFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/emulationstation"
            grep -v -e 'name="ScreenScraperPass"' -e 'name="ScreenScraperDevPass"' "${ESCFG}" \
                > "${STAGING}/storage/.config/emulationstation/es_settings.cfg"
        fi

        # retroarch.cfg carries its own credentials when RetroArch's own UI
        # is used to sign in: cheevos password/token, netplay and kiosk
        # passwords, and streaming keys. Blank the values (rather than drop
        # the lines) so RetroArch still finds the keys it expects. The
        # cheevos *username* is deliberately kept - it is not a secret, and
        # the post-restore re-entry page uses it to know an account exists.
        if grep -qxF "${RACFG}" "${SECRETLIST}"
        then
            mkdir -p "${STAGING}/storage/.config/retroarch"
            sed -E 's/^([a-z_]*(password|token|stream_key)) = ".*"$/\1 = ""/' "${RACFG}" \
                > "${STAGING}/storage/.config/retroarch/retroarch.cfg"
        fi
    fi
    rm -f "${FILELIST}" "${SECRETLIST}" "${SENDLIST}"

    # Member names come out as storage/... exactly as the zip's did, so
    # anything reading the archive sees the same shape. To .partial first;
    # the name every reader looks for is given only to an archive that has
    # listed back whole.
    if ! tar -czf "${TARGET}.partial" -C "${STAGING}" storage \
       || ! tar -tzf "${TARGET}.partial" >/dev/null 2>&1
    then
        rm -rf "${STAGING}"
        rm -f "${TARGET}.partial"
        return 3
    fi
    rm -rf "${STAGING}"
    if ! mv -f "${TARGET}.partial" "${TARGET}"
    then
        rm -f "${TARGET}.partial"
        return 3
    fi
    return 0
}

# Keep only the newest ARCHIVE_KEEP archives under archive/. Both shapes: an
# upgraded device still has archives written under the old name, and
# rotation must not skip them and keep them for ever while trimming only the
# new ones. The pre-restore snapshots restore writes (<stamp>-PRE_RESTORE-...)
# are candidates too, so a run of restores cannot grow the folder past the
# same bound; they end in _SETTINGS.tar.gz and the first glob takes them, and
# they are named as well so a reader knows that is intended.
trim_archive() {
    ls -1t "${ARCHIVEFOLDER}"/*_SETTINGS*.tar.gz "${ARCHIVEFOLDER}"/*PRE_RESTORE*.tar.gz \
           "${ARCHIVEFOLDER}"/*_BACKUP*.tar.gz "${ARCHIVEFOLDER}"/*_BACKUP*.zip \
           "${ARCHIVEFOLDER}"/ARCHIVED_*.zip 2>/dev/null \
        | awk '!seen[$0]++' | tail -n +$((ARCHIVE_KEEP + 1)) | while read -r OLD
    do
        rm -f "${OLD}"
    done
}

# Options after the verb. --then-cloud: once the settings are verifiably in
# place, leave the marker EmulationStation reads at the next start to offer
# the cloud journey's continuation. It used to be touched by the menu in the
# confirmation callback -- before the restore had run, let alone succeeded --
# so a restore that failed still produced the offer (#105).
THEN_CLOUD=0
VERB="${1}"
shift
for OPT in "$@"
do
    case "${OPT}" in
        --then-cloud) THEN_CLOUD=1 ;;
    esac
done

case "${VERB}" in
    "restore")
        BACKUPFILE="$(newest_backup)"
        if [ -z "${BACKUPFILE}" ] || [ ! -f "${BACKUPFILE}" ]
        then
            why "THERE IS NO SETTINGS BACKUP ON THIS DEVICE"
            fail "THERE IS NO SETTINGS BACKUP ON THIS DEVICE. NOTHING WAS CHANGED. BACK UP SETTINGS FIRST, OR RESTORE THEM FROM THE CLOUD." "nothing under ${SETTINGS_BACKUPS} matched"
        fi

        # An archive is whatever it is named. Both are read: every device in
        # the field has .zip archives locally, and a format change is no
        # reason to strand them.
        case "${BACKUPFILE}" in
            *.tar.gz) ARCHIVE_KIND="tar" ;;
            *)        ARCHIVE_KIND="zip" ;;
        esac

        note "CHECKING THE SETTINGS ARCHIVE..." "${BACKUPFILE}"
        if ! archive_ok "${BACKUPFILE}"
        then
            why "THE SETTINGS ARCHIVE ON THIS DEVICE IS DAMAGED"
            fail "THE SETTINGS ARCHIVE ON THIS DEVICE IS DAMAGED. NOTHING WAS CHANGED. BACK UP SETTINGS AGAIN." "${BACKUPFILE} does not list"
        fi

        # Before anything is written over the live tree, the tree as it is
        # now goes into archive/ under the same shape as a backup, so a
        # restore that does not finish has something to go back to
        # (D-CLOUD-078: a failure reverts to the last known good state).
        # archive/ is never sent to the cloud and never scanned by
        # newest_backup, so the copy cannot be mistaken for a backup the
        # player made; it is trimmed with the rest of archive/ so the folder
        # stays bounded. Passwords are kept in it (STRIP=0): it stays on the
        # device, and "as they were" has to mean exactly that.
        mkdir -p "${ARCHIVEFOLDER}"
        SNAPSHOT="${ARCHIVEFOLDER}/${BACKUP_STAMP}-PRE_RESTORE-${DEVICE_LABEL:+${DEVICE_LABEL}-}${OS_NAME}_SETTINGS.tar.gz"
        note "KEEPING A COPY OF YOUR CURRENT SETTINGS..." "${SNAPSHOT}"
        write_archive "${SNAPSHOT}" 0
        case $? in
            0) trim_archive ;;
            2) # Nothing on the device to keep: a fresh install, or nothing
               # readable. There is nothing a failed restore could revert to
               # and nothing it could damage, so go on without a copy.
               SNAPSHOT=""
               logger -t backuptool "no current settings to copy aside before the restore" ;;
            *) why "YOUR CURRENT SETTINGS COULDN'T BE COPIED ASIDE"
               fail "YOUR CURRENT SETTINGS COULDN'T BE COPIED ASIDE, SO NOTHING WAS CHANGED. TRY AGAIN." "write_archive ${SNAPSHOT} failed" ;;
        esac

        note "RESTORING SETTINGS..." "from ${BACKUPFILE}"
        if [ "${ARCHIVE_KIND}" = "tar" ]
        then
            # No skip-list here, and none needed. tar replaces a symlink with
            # whatever the archive holds instead of refusing and aborting, and
            # what the archive holds is the symlink itself.
            tar -xzf "${BACKUPFILE}" -C / >/dev/null
        else
            # Archives written before backups switched to regular files only
            # hold the *contents* of symlinked paths. Extracting one of those
            # over the live symlink makes busybox unzip abort the whole
            # restore, so every backup taken before that change would be
            # unrestorable here. Skip exactly those entries instead: the OS
            # owns those symlinks and provides them, and replacing one with a
            # stale copy is the bug that got them excluded from backups in the
            # first place.
            SKIP=""
            SKIPPED=0
            for ENTRY in $(unzip -l "${BACKUPFILE}" 2>/dev/null | awk 'NF>3 && $4 ~ /^storage\// {print $4}')
            do
                if [ -L "/${ENTRY}" ]
                then
                    SKIP="${SKIP} ${ENTRY}"
                    SKIPPED=$((SKIPPED + 1))
                fi
            done
            if [ "${SKIPPED}" -gt 0 ]
            then
                note "KEEPING ${SKIPPED} SYSTEM-PROVIDED LINK(S) THIS OLDER BACKUP WOULD HAVE OVERWRITTEN."
                # -x is a mode switch: every argument after it is an exclusion.
                unzip -o "${BACKUPFILE}" -d / -x ${SKIP} >/dev/null
            else
                unzip -o "${BACKUPFILE}" -d / >/dev/null
            fi
        fi
        if [ $? -ne 0 ]
        then
            # Half the archive may be in place. Put the copy taken above
            # back over it, and say which state the device is in.
            if [ -n "${SNAPSHOT}" ] && tar -xzf "${SNAPSHOT}" -C / >/dev/null 2>&1
            then
                why "THE RESTORE COULDN'T FINISH"
                fail "THE RESTORE COULDN'T FINISH. YOUR SETTINGS ARE AS THEY WERE. TRY AGAIN." "extraction of ${BACKUPFILE} failed; ${SNAPSHOT} put back"
            elif [ -n "${SNAPSHOT}" ]
            then
                why "THE RESTORE COULDN'T FINISH"
                fail "THE RESTORE COULDN'T FINISH, AND SOME OF YOUR SETTINGS COULDN'T BE PUT BACK. TRY THE RESTORE AGAIN." "extraction of ${BACKUPFILE} failed and so did putting back ${SNAPSHOT}"
            else
                why "THE RESTORE COULDN'T FINISH"
                fail "THE RESTORE COULDN'T FINISH. TRY AGAIN." "extraction of ${BACKUPFILE} failed; there was no previous state to put back"
            fi
        fi

        # Passwords and keys are stripped at backup time (see write_archive);
        # wifi and similar credentials must be re-entered after a restore.
        # EmulationStation shows a native reminder on next boot to re-enter
        # the credentials that backups deliberately exclude.
        touch /storage/.config/.restore-finish-pending
        if [ "${THEN_CLOUD}" -eq 1 ]
        then
            touch /storage/.config/.cloud-journey-pending
        fi

        note "SETTINGS RESTORED. WI-FI AND ACCOUNT PASSWORDS ARE NOT PART OF A BACKUP AND MUST BE ENTERED AGAIN."
        note "RESTARTING IN 5 SECONDS SO THE RESTORED SETTINGS TAKE EFFECT..."
        sync
        sleep 5
        systemctl reboot
    ;;
    "backup")
        # Guard the tool this whole path depends on. busybox provides unzip but
        # not zip, so a missing package means backup dies with a bare
        # "zip: not found" after the user has already chosen to back up.
        for TOOL in tar gzip
        do
            command -v "${TOOL}" >/dev/null 2>&1 || {
                why "THIS DEVICE CAN'T MAKE A SETTINGS BACKUP"
                fail "THIS DEVICE CAN'T MAKE A SETTINGS BACKUP: A TOOL IS MISSING FROM THE IMAGE." "'${TOOL}' is not on PATH"
            }
        done

        # A .partial left by a run that was killed mid-write is not a backup
        # and nothing reads it; clear it so it does not sit there for ever.
        rm -f "${SETTINGS_BACKUPS}"/*.tar.gz.partial 2>/dev/null

        # The archive at the root right now, named before the new one exists
        # so that newest_backup cannot return the new one. It stays exactly
        # where it is until the new archive has been written and verified:
        # until 2026-09-10 it was moved into archive/ FIRST, so a kill in
        # between left no archive at the root at all -- restore said there
        # was nothing to restore while archive/ held three, and cloud_backup
        # sent nothing (D-CLOUD-078, #105).
        PREVIOUS="$(newest_backup)"

        note "BACKING UP SETTINGS..." "to ${BACKUPFILE}"
        write_archive "${BACKUPFILE}" 1
        case $? in
            0) ;;
            2) why "THE BACKUP COULDN'T FINISH WHILE COLLECTING YOUR SETTINGS"
               fail "THE BACKUP COULDN'T FINISH WHILE COLLECTING YOUR SETTINGS. NO BACKUP WAS WRITTEN; WHAT WAS HERE BEFORE IS UNCHANGED. TRY AGAIN." "collecting into staging failed" ;;
            *) why "THE BACKUP COULDN'T FINISH"
               fail "THE BACKUP COULDN'T FINISH. NO BACKUP WAS WRITTEN; WHAT WAS HERE BEFORE IS UNCHANGED. TRY AGAIN." "writing or verifying ${BACKUPFILE} failed" ;;
        esac

        # Now, and only now, rotate the previous archive into an archive
        # folder that the cloud allowlist (backup/*.zip) does not match, and
        # keep only the newest few. Each backup writes a new dated name, so
        # this is only ever the previous one.
        if [ -n "${PREVIOUS}" ] && [ -f "${PREVIOUS}" ] && [ "${PREVIOUS}" != "${BACKUPFILE}" ]
        then
            mkdir -p "${ARCHIVEFOLDER}"
            # Moved under the name it already has, keeping the date it was
            # taken. Re-stamping on rotation would date every archive to the
            # moment it was superseded, which is not when it was made and is
            # not what somebody hunting for "the one from before Tuesday"
            # needs. An archive written before names carried dates has none to
            # keep, so it gets one now.
            PREVIOUS_NAME="$(basename "${PREVIOUS}")"
            case "${PREVIOUS_NAME}" in
                [0-9][0-9][0-9][0-9]_*) ;;
                *) PREVIOUS_NAME="$(date -r "${PREVIOUS}" +%Y_%m_%d-%H%M%S 2>/dev/null || date +%Y_%m_%d-%H%M%S)-${PREVIOUS_NAME}" ;;
            esac
            mv "${PREVIOUS}" "${ARCHIVEFOLDER}/${PREVIOUS_NAME}"
            trim_archive
        fi

        # Last line of defence: the archive can be synced to the cloud, so
        # never ship one carrying a populated credential. This greps what
        # actually landed in the archive rather than trusting the strips above,
        # so a newly-added config file with secrets is caught the first
        # time it is backed up instead of silently leaking.
        # Text config members only, case-sensitive, anchored to a config-key
        # shape. Translation catalogues ship lines like 'Password = Пароль',
        # and scanning every member found nothing while warning on every
        # backup, which would be worse than not warning at all.
        # busybox tar has no wildcard member selection, so the members are
        # listed first and the text ones named explicitly. Same restriction as
        # before, for the same reason: -O concatenates members without
        # separators, so binary blobs run into the next file's first line and
        # defeat the anchor.
        SCANLIST=$(tar -tzf "${BACKUPFILE}" 2>/dev/null | grep -E '\.(cfg|conf|ini)$' || true)
        if [ -n "${SCANLIST}" ]
        then
            # Extract once and scan the files, rather than expanding the
            # member list into tar's arguments: unquoted, a member name
            # containing a space split into two names that do not exist, tar
            # errored into /dev/null, and those members went unscanned -- a
            # credential check failing open.
            SCANDIR=$(mktemp -d)
            tar -xzf "${BACKUPFILE}" -C "${SCANDIR}" 2>/dev/null
            LEAKS=$(find "${SCANDIR}" -type f \( -name '*.cfg' -o -name '*.conf' -o -name '*.ini' \) \
                -exec grep -hE '^[a-z_.]*(password|token|stream_key|\.key) *[=:] *"?[^"[:space:]]+' {} + 2>/dev/null \
                | wc -l)
            rm -rf "${SCANDIR}"
        else
            LEAKS=0
        fi
        if [ "${LEAKS}" -gt 0 ] 2>/dev/null
        then
            WARN="${LEAKS} LINE(S) IN THIS BACKUP LOOK LIKE PASSWORDS OR KEYS. CHECK IT BEFORE SHARING IT OR SENDING IT TO THE CLOUD."
            echo -e "\e[33m${WARN}\e[0m"
            logger -t backuptool "${WARN} -- ${BACKUPFILE}"
        fi

        sync
        note "SETTINGS BACKED UP TO THIS DEVICE." "${BACKUPFILE}"
        note "COPY IT SOMEWHERE SAFE, OR BACK UP SETTINGS TO THE CLOUD FROM GAME SETTINGS."
        sleep 3
    ;;
    *)
        echo "Usage: backuptool {backup|restore [--then-cloud]}" >&2
        exit 1
    ;;
esac
