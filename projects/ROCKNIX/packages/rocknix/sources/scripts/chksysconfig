# chksysconfig - keep the last known good system.cfg, and put it back.
#
# system.cfg.backup is the record of the last system.cfg that was known to be
# good (D-CLOUD-078, D-CLOUD-079). It is written from a file that has just
# been checked -- at boot once verify has run, and at shutdown -- and never
# from one that has not: an empty or truncated file is exactly what the
# record exists to survive, and copying it over the record is how the RG SP
# lost its settings (#102: a truncated system.cfg was backed up at the next
# clean shutdown, and the boot after that found no good copy and seeded the
# image defaults). Written to a temporary name beside it and renamed, so a
# power cut mid-copy leaves the previous record and never half of one.
#
# verify, at boot, tries the live file, then the record, then the defaults,
# in that order, and says in the system log which one it took. The image
# defaults are the last resort, not the first fix.
#
# The file name is deliberately the one this script has always used, so an
# upgraded device has one record at rest and nothing to migrate.

. /etc/profile

CONFIG_ROOT="/storage/.config"
DEFAULT_ROOT="/usr/config"
CFG_PATH="${CONFIG_ROOT}/system/configs"
CFG="${CFG_PATH}/system.cfg"
BACKUP="${CFG}.backup"

say() {
  logger -t chksysconfig "$*"
}

# A usable system.cfg: not empty, text, carrying the hostname line every
# image writes, and every non-blank line a key=value pair -- a truncated
# tail fails that last test, which is the shape a cut write leaves.
#
# "Text" is asked of the bytes: no control characters besides whitespace
# (so no NULs and none of the 0x00 fill a torn flash write leaves). The
# original test read grep's "Binary file" notice and let an empty file
# through as text, which it is, and as a config, which it is not.
valid() {
  local f="$1"
  [ -s "${f}" ] || return 1
  [ "$(LC_ALL=C tr -d '[:print:][:space:]\200-\377' < "${f}" | head -c 1 | wc -c)" -eq 0 ] || return 1
  grep -q '^system\.hostname=' "${f}" || return 1
  ! LC_ALL=C grep -qvE '^[[:space:]]*$|^[^=[:space:]][^=]*=' "${f}"
}

# One file replaces another whole or not at all: copy to a temporary name in
# the same directory, then rename over the target.
put() {
  local src="$1" dst="$2"
  if cp "${src}" "${dst}.tmp" && mv -f "${dst}.tmp" "${dst}"; then
    return 0
  fi
  rm -f "${dst}.tmp"
  return 1
}

backup() {
  if ! valid "${CFG}"; then
    say "not backing up system.cfg: it is empty, not text, or damaged; the last good copy stays as it is"
    return 1
  fi
  put "${CFG}" "${BACKUP}" || { say "could not write system.cfg.backup"; return 1; }
}

restore() {
  if ! valid "${BACKUP}"; then
    say "cannot restore system.cfg: the last good copy is missing or damaged too"
    return 1
  fi
  put "${BACKUP}" "${CFG}" || { say "could not write system.cfg from its last good copy"; return 1; }
  say "restored system.cfg from its last good copy (system.cfg.backup)"
}

verify() {
  local state="" recovered=0

  if ! valid "${CFG}"; then
    if [ ! -e "${CFG}" ]; then
      state="missing"
    elif [ ! -s "${CFG}" ]; then
      state="empty"
    else
      state="damaged"
    fi
    say "system.cfg is ${state}; recovering"
    if restore; then
      recovered=1
    else
      # Neither the live file nor the record is usable: the image's copy is
      # all that is left. The one file, not the whole config tree.
      if put "${DEFAULT_ROOT}/system/configs/system.cfg" "${CFG}"; then
        say "system.cfg was reseeded from the image defaults: there was no good copy to restore"
      else
        say "could not reseed system.cfg from the image defaults"
      fi
      recovered=1
    fi
  fi

  # Reseed what is missing from the config tree -- and only what is missing.
  #
  # This used to be `rsync -a /usr/config/ /storage/.config`, which also
  # replaced every file that merely differed from the image's copy:
  # es_settings.cfg, retroarch.cfg, the lot, whenever one retroarch file was
  # absent or system.cfg had lost its hostname line (#102's "defaults won").
  # --ignore-existing leaves every file that is present alone. An empty
  # retroarch file is not a config, so it is removed first and reseeded like
  # a missing one.
  local f missing=0
  for f in "${CONFIG_ROOT}/retroarch/retroarch-core-options.cfg" \
           "${CONFIG_ROOT}/retroarch/retroarch.cfg"; do
    if [ -e "${f}" ] && [ ! -s "${f}" ]; then
      rm -f "${f}"
    fi
    [ -s "${f}" ] || missing=1
  done
  if [ "${missing}" -eq 1 ] || [ "${recovered}" -eq 1 ]; then
    if rsync -a --ignore-existing "${DEFAULT_ROOT}/" "${CONFIG_ROOT}"; then
      say "reseeded missing files under ${CONFIG_ROOT} from the image; files already present were left alone"
    else
      say "could not reseed missing files under ${CONFIG_ROOT} from the image"
    fi
  fi
}

case ${1} in
  verify)
    verify
  ;;
  backup)
    backup
  ;;
  restore)
    restore
  ;;
esac
