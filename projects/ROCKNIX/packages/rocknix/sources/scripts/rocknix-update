# Manual adoption for0.0.1 (D-WORKFLOW-093). Retain the command name for
# installed callers, but never contact the previous distribution's updater.
case "${1:-}" in
    check) exit 1 ;;
    --help|-h) result=0 ;;
    *) result=1 ;;
esac
printf '%s\n' 'This version uses manual updates.' \
    'Get the update for your device and its instructions from:' \
    'https://github.com/pixelelated/distribution/releases'
exit "${result}"
