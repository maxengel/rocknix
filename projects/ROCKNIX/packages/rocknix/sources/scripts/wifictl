#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (C) 2023 JELOS (https://github.com/JustEnoughLinuxOS)
# Copyright (C) 2022 kkoshelev (https://github.com/kkoshelev)
# Wi-Fi via NetworkManager (iwd backend). AP/netplay still uses iwctl on the interface.

. /etc/profile

NMCLI="$(command -v nmcli 2>/dev/null)"

###
### Basic WIFI properties used across the tool.
###
### Usage:
###     wifictl command [ssid] [psk]
###
### For the interface's network rows (fork #191), reading NetworkManager
### rather than the wifi.ssid setting:
###     wifictl current           the network joined now; nothing and exit 1 when none,
###                               exit 2 when NetworkManager could not be asked
###     wifictl saved             the remembered networks, one per line: <name><TAB>active|saved
###     wifictl forget <name>     forget one: prints "forgotten", then "disconnected" on a
###                               second line when it was the one in use; exit 1, nothing
###                               printed, when it is not a remembered network or the delete failed
###     wifictl join <name>       join a saved network with the key NetworkManager holds for it
###                               (the picker's press on a SAVED row): prints "joined" once its
###                               profile is active and moves wifi.ssid / wifi.key onto it; exit 1,
###                               nothing printed, when it is not a saved network or the
###                               activation failed; exit 2 when NetworkManager could not be asked
###

WIFI_TYPE=$(get_setting wifi.adhoc.enabled)
NETWORK_ADDRESS="192.168.80"
ADHOC_CLIENT_ID=$(get_setting wifi.adhoc.id)
[ -z "${ADHOC_CLIENT_ID}" ] && ADHOC_CLIENT_ID="1"
NETPLAY_SSID="NETPLAY_AP"
WIFI_DEV="$(ls /sys/class/net | grep -m1 ^wlan)"

# Exit the script if the WiFi device isn't available
[ -z "${WIFI_DEV}" ] && exit 0
[ ! -d "/sys/class/net/${WIFI_DEV}" ] && exit 0
[ -z "${NMCLI}" ] && exit 0

SSID="${2:-$(get_setting wifi.ssid 2>/dev/null)}"
PSK="${3:-$(get_setting wifi.key 2>/dev/null)}"
COUNTRY="${4:-$(get_setting wifi.country | tr -d '[:space:]' 2>/dev/null)}"

if [ "${WIFI_TYPE}" = "1" ]; then
  SSID="${NETPLAY_SSID}"
  PSK="deadbeef"
fi

###
### Functions...
###

# Wait for iwd to start and have a device available
wait_for_wifi() {
  for i in $(seq 1 5); do
    iwctl device list | grep -q "${WIFI_DEV}" && break
    sleep 1
  done
  [ -n "${COUNTRY}" ] && iw reg set "${COUNTRY}"
}

# lists all wifi networks
list_wifi() {
  wait_for_wifi
  "${NMCLI}" -w 15 dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
  sleep 1
  "${NMCLI}" -t -f SSID dev wifi list ifname "${WIFI_DEV}" 2>/dev/null | sed '/^$/d' | sort -u
}

connect_wifi() {
  wait_for_wifi
  # Ensure NM has the device ready and has scanned
  for i in $(seq 1 10); do
    "${NMCLI}" -t -f DEVICE,STATE dev status 2>/dev/null | grep -q "^${WIFI_DEV}:disconnected" && break
    "${NMCLI}" -t -f DEVICE,STATE dev status 2>/dev/null | grep -q "^${WIFI_DEV}:connected" && break
    sleep 1
  done
  "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
  sleep 2
  # If a keyfile profile for this SSID already exists but is incomplete (e.g. missing
  # 802-11-wireless-security.key-mgmt), NM fails connection-update with "key-mgmt: property is missing".
  # Drop the stale profile so "device wifi connect" creates a clean one.
  "${NMCLI}" connection delete id "${SSID}" >/dev/null 2>&1 || true
  if [ -n "${PSK}" ]; then
    "${NMCLI}" -w 90 device wifi connect "${SSID}" password "${PSK}" ifname "${WIFI_DEV}" >/dev/null 2>&1
  else
    "${NMCLI}" -w 90 device wifi connect "${SSID}" ifname "${WIFI_DEV}" >/dev/null 2>&1
  fi
}

create_adhoc() {
  wait_for_wifi
  # NetworkManager drives iwd into AP mode itself (Device.Mode + AP.Start).
  # Switching the mode behind its back only makes NM force the device back to
  # station mode, so the netplay AP has to be a NetworkManager connection.
  # No DHCP: the clients derive their address from the local play ID.
  "${NMCLI}" connection delete id "${SSID}" >/dev/null 2>&1
  "${NMCLI}" connection add type wifi ifname "${WIFI_DEV}" con-name "${SSID}" ssid "${SSID}" \
    802-11-wireless.mode ap \
    802-11-wireless.band bg \
    802-11-wireless-security.key-mgmt wpa-psk \
    802-11-wireless-security.psk "${PSK}" \
    ipv4.method manual ipv4.addresses "${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}/24" \
    ipv6.method disabled || return 1
  "${NMCLI}" -w 30 connection up id "${SSID}" || return 1
}

connect_adhoc_client() {
  destroy_adhoc
  # Static lease: the netplay host runs no DHCP server, so the client
  # address is derived from the local play ID. Autoconnect stays off so a
  # vanished host doesn't keep the device from returning to ordinary
  # networks; rejoining is an explicit wifictl connect (ES toggle).
  "${NMCLI}" connection add type wifi ifname "${WIFI_DEV}" con-name "${SSID}" ssid "${SSID}" \
    802-11-wireless-security.key-mgmt wpa-psk \
    802-11-wireless-security.psk "${PSK}" \
    ipv4.method manual ipv4.addresses "${NETWORK_ADDRESS}.${ADHOC_CLIENT_ID}/24" \
    ipv6.method disabled connection.autoconnect no || return 1
  # The iwd backend fails "connection up" instantly when the SSID is not in
  # the scan cache yet, so make sure the host AP shows up first
  for i in $(seq 1 15); do
    "${NMCLI}" device wifi rescan ifname "${WIFI_DEV}" >/dev/null 2>&1
    sleep 2
    "${NMCLI}" -t -f SSID device wifi list ifname "${WIFI_DEV}" 2>/dev/null | grep -q "^${SSID}$" && break
  done
  "${NMCLI}" -t -f SSID device wifi list ifname "${WIFI_DEV}" 2>/dev/null | grep -q "^${SSID}$" || return 1
  # The host may still be coming up
  for i in $(seq 1 3); do
    "${NMCLI}" -w 20 connection up id "${SSID}" && return 0
    sleep 3
  done
  return 1
}

destroy_adhoc() {
  # Remove the netplay connection (host or client) so NM autoconnect
  # can't resurrect it and the device returns to the ordinary networks
  "${NMCLI}" connection delete id "${NETPLAY_SSID}" >/dev/null 2>&1
}

# Prefer the network currently in use for the next automatic connection. On
# resume the radio is only rfkill-unblocked, so NetworkManager autoconnect
# chooses among every saved profile and can join a different access point than
# the one in use -- often on another subnet, silently moving the device and
# dropping whatever was connected. The same applies at boot. Raising the
# priority of the active profile makes NM try that one first.
#
# Priority only, deliberately: every profile keeps autoconnect enabled, so a
# preferred network that is out of range just loses to whatever is in range.
# Turning autoconnect off on the others would pin harder but strand the device
# on a network it can no longer see. With no active connection there is nothing
# to prefer, and the priorities from the previous call still stand.
pin_wifi() {
  local active name

  active=$("${NMCLI}" -t -f GENERAL.CONNECTION device show "${WIFI_DEV}" 2>/dev/null | cut -d: -f2-)
  [ -z "${active}" ] && return 0

  "${NMCLI}" -t -f NAME,TYPE connection show 2>/dev/null |
    awk -F: '$2 ~ /wireless/ {print $1}' |
    while IFS= read -r name; do
      if [ "${name}" = "${active}" ]; then
        "${NMCLI}" connection modify "${name}" connection.autoconnect-priority 100 >/dev/null 2>&1
      else
        "${NMCLI}" connection modify "${name}" connection.autoconnect-priority 0 >/dev/null 2>&1
      fi
    done
}

# What NetworkManager remembers and what it is joined to, for the interface
# (fork #191). The setting wifi.ssid is the network the player configured
# last; NetworkManager keeps a profile for every network the device has
# joined and autoconnects to whichever remembered one is in range, so the
# two are not the same network -- and NETWORK SETTINGS showed the setting as
# though it were the connection. These read NetworkManager itself.
#
# nmcli -t separates fields with ':' and escapes a ':' or '\' inside a value
# with a backslash. A network's name can carry either, so the fields that
# cannot (TYPE, ACTIVE) are taken from the right, and the name is unescaped
# once it stands alone.
nm_unescape() {
  sed 's/\\\(.\)/\1/g'
}

# The SSID the device is joined to now: the one access point NetworkManager
# marks active, from the list it already holds (no rescan). Nothing and exit
# 1 when the device is joined to none; exit 2 when NetworkManager could not
# be asked, so a caller cannot read a silence as "not connected".
current_wifi() {
  local aps ssid
  aps=$("${NMCLI}" -t -f ACTIVE,SSID device wifi list ifname "${WIFI_DEV}" --rescan no 2>/dev/null) || return 2
  ssid=$(printf '%s\n' "${aps}" | sed -n 's/^yes://p' | head -n 1 | nm_unescape)
  [ -n "${ssid}" ] || return 1
  printf '%s\n' "${ssid}"
}

# Every network NetworkManager remembers: one line per wireless profile,
# <name><TAB>active or <name><TAB>saved, in nmcli's order (the one in use
# first). Wired and other profiles are not networks a player joined and are
# left out. Exit 1 with nothing printed when NetworkManager could not be
# asked -- an empty list and no list are different answers.
saved_wifi() {
  local profiles
  profiles=$("${NMCLI}" -t -f NAME,TYPE,ACTIVE connection show 2>/dev/null) || return 1
  printf '%s\n' "${profiles}" |
    awk -F: 'NF >= 3 && $(NF-1) ~ /wireless/ {
      name = $1; for (i = 2; i <= NF - 2; i++) name = name ":" $i
      print name "\t" ($NF == "yes" ? "active" : "saved")
    }' | nm_unescape
}

# Forget a remembered network: delete its profile, and say when that dropped
# the connection. Prints "forgotten" once the profile is gone, then
# "disconnected" on a second line when it was the one in use --
# NetworkManager deactivates a profile as it deletes it, so the device is
# off that network from this moment (autoconnect may then join another
# remembered one in range). A name that is not a remembered wireless
# network, a NetworkManager that cannot be asked, or a delete that fails:
# nothing printed and exit 1, so a caller cannot read a refusal as done.
# The name is matched whole, through the environment rather than awk -v,
# which would read backslashes in it as escapes.
forget_wifi() {
  local name="${1}" rows state
  [ -n "${name}" ] || return 1
  rows=$(saved_wifi) || return 1
  state=$(printf '%s\n' "${rows}" | NAME="${name}" awk -F'\t' '$1 == ENVIRON["NAME"] { print $2 }')
  [ -n "${state}" ] || return 1
  "${NMCLI}" connection delete id "${name}" >/dev/null 2>&1 || return 1
  echo "forgotten"
  case "${state}" in *active*) echo "disconnected" ;; esac
  return 0
}

# Join a saved network by its profile, with the key NetworkManager holds --
# the picker's press on a network the device has joined before (fork #191;
# the maintainer's paradigm of 2026-09-15: the WI-FI SSID row is the network
# you are on, the list behind it is what is in range, a saved one joins with
# a press). `connect` would have deleted the profile and rebuilt it from the
# WI-FI KEY setting, which holds the last key typed, for some other network.
# Prints "joined" once the profile is active (at once when it already is),
# then the settings wifi.ssid and wifi.key follow the profile, so the paths
# that connect from the settings -- the WI-FI KEY row, the ENABLE WI-FI
# switch, the restore wizard -- name the network the player is on; the key is
# read from NetworkManager and never printed. pin_wifi then prefers this
# network at the next boot and resume. A name that is not a saved wireless
# network, or an activation that fails: nothing printed, exit 1. NetworkManager
# not answering: exit 2, so a caller cannot read a silence as a refusal.
join_wifi() {
  local name="${1}" rows state psk
  [ -n "${name}" ] || return 1
  rows=$(saved_wifi) || return 2
  state=$(printf '%s\n' "${rows}" | NAME="${name}" awk -F'\t' '$1 == ENVIRON["NAME"] { print $2 }')
  [ -n "${state}" ] || return 1
  if [ "${state}" != "active" ]; then
    "${NMCLI}" -w 90 connection up id "${name}" >/dev/null 2>&1 || return 1
  fi
  psk=$("${NMCLI}" -s -g 802-11-wireless-security.psk connection show id "${name}" 2>/dev/null)
  set_setting wifi.ssid "${name}"
  set_setting wifi.key "${psk}"
  pin_wifi
  echo "joined"
  return 0
}

has_ap_mode() {
  wait_for_wifi

  PHY=$(basename "$(readlink /sys/class/net/${WIFI_DEV}/phy80211)")
  if iwctl adapter "$PHY" show | grep -q 'SupportedModes.*ap'; then
    exit 0
  else
    exit 1
  fi
}

case "${1}" in
  enable)
    rfkill unblock wifi
    ;;
  disable)
    rfkill block wifi
    ;;
  pin)
    pin_wifi
    ;;
  connect)
    if [ "${WIFI_TYPE}" = "1" ] && \
       [ "${ADHOC_CLIENT_ID}" = "1" ]; then
      create_adhoc
    elif [ "${WIFI_TYPE}" = "1" ]; then
      connect_adhoc_client
    else
      destroy_adhoc
      connect_wifi
    fi
  ;;
  disconnect)
    if [ "${WIFI_TYPE}" = "1" ]; then
      destroy_adhoc
    else
      "${NMCLI}" device disconnect "${WIFI_DEV}" >/dev/null 2>&1
    fi
    ;;
  reconnect)
    /usr/bin/wifictl disconnect
    /usr/bin/wifictl connect
    ;;
  list)
    list_wifi
    ;;
  channels)
    iw list | awk '/[0-9] MHz \[/ && ! /disabled|radar|no IR/ { gsub(/^.*\[/,""); gsub(/\].*$/,""); print}'
    ;;
  has_ap_mode)
    has_ap_mode
    ;;
  scan)
    "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
    ;;
  scanlist)
    "${NMCLI}" dev wifi rescan ifname "${WIFI_DEV}" 2>/dev/null
    sleep 2
    list_wifi
    ;;
  current)
    current_wifi
    ;;
  saved)
    saved_wifi
    ;;
  forget)
    forget_wifi "${2}"
    ;;
  join)
    join_wifi "${2}"
    ;;
esac
