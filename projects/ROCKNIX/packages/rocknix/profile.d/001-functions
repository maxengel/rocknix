function tocon() {
  echo -ne "\033[1000H\033[2K==> ${*}" >/dev/console
}

function log() {
  SOURCE=${1//\/*\//}
  MESSAGE=${*#${1}}
  MESSAGE=${MESSAGE# }
  logger -t ${SOURCE} "${MESSAGE}"
  echo "$(date) ${SOURCE}: ${MESSAGE}" >>/var/log/messages
}

# Every credential a launcher can log or a support bundle can carry, and the
# one way it is shown: the key or flag stays, the value reads <redacted>, so a
# log still says the setting was applied and nothing about what it was (fork
# #176, D-INFRA-010). RetroArch's launch log carried cheevos_password in the
# clear and rocknix-evidence copied it into the files a player sends for help.
# This is the only place that knows what a credential looks like in a line;
# every write to exec.log and every file the evidence bundle takes goes
# through it, so no script keeps its own list.
#
#   redact_credentials              # stdin to stdout, whole streams (files)
#   redact_credentials "a line"     # the line, redacted, on stdout
#
# Shapes, all case-insensitive: key = "value", key = 'value', key=value,
# "key": "value" and key: value where the key names a password, token, API
# key, secret, PSK or RetroAchievements' web key (global.retroachievements.key);
# a flag of that name followed by its value (--ra-password X); setsettings'
# Fetch "<key>" ... ] (value) line; RetroAchievements' p=, t= and y= request
# parameters on a line about RetroAchievements (or from its proxy), after
# ?, & or a space -- a log line pastes them bare as often as it joins them
# (#186 PL-29); the pre-push guard's fixed
# token formats (devpassword=, &y=, AKIA, ghp_, github_pat_, xox., sk- at a
# word's start -- "disk-" and "task-" are not keys, and forked a sed for
# nothing (#308 claude F-PB-18) -- a
# private-key block); setrootpass <value>; the password in a URL's
# user:password@. An empty value is left empty: whether a credential is set
# may be shown, only what it is may not. An unquoted value runs to the next
# space, quote, & or ; -- so a URL's next parameter survives -- and may
# itself START with & or ; (root.password=&x): the class that stops at them
# consumed nothing there and the whole value was kept (#307 PL-040). The
# word list is deliberately wide
# (a value under a key merely named like a credential is hidden too): a
# hidden setting in a debug log costs a question, a shown password costs an
# account.
#
# The one-line form checks the line in bash first and forks a sed only for a
# line that names a credential: setsettings writes a hundred lines a launch
# in verbose mode and a fork for each would be felt on a handheld.
function redact_credentials() {
  local words='passw|token|api_?key|secret|psk|wifi\.key|retroachievements\.key'
  local marks='(^|[?&[:space:]])[pty]=|AKIA|gh[pousr]_|github_pat_|xox[baprs]-|(^|[^A-Za-z0-9])sk-|PRIVATE KEY|setrootpass|://[^/[:space:]@]+:[^/[:space:]@]+@'
  if [ $# -gt 0 ]; then
    local line="$*" nocase=0
    shopt -q nocasematch && nocase=1
    shopt -s nocasematch
    if [[ "${line}" =~ (${words}|pass|${marks}) ]]; then
      [ "${nocase}" -eq 1 ] || shopt -u nocasematch
      printf '%s\n' "${line}" | redact_credentials
    else
      [ "${nocase}" -eq 1 ] || shopt -u nocasematch
      printf '%s\n' "${line}"
    fi
    return
  fi
  # A key naming a credential word anywhere, or ENDING in "pass"
  # (ScreenScraperPass, RA_Pass, rclone's pass): passw alone missed the
  # batocera-style ...Pass spellings (#308 claude F-PB-18). "pass" only at
  # the key's end, so "passed:" in a log line is not a key.
  local key="([A-Za-z0-9_.-]*(${words})[A-Za-z0-9_.-]*|[A-Za-z0-9_.-]*pass)"
  sed -E \
    -e "s/(^|[^A-Za-z0-9_.-])(${key}\"?[[:space:]]*[=:][[:space:]]*)\"[^\"]+\"/\1\2\"<redacted>\"/Ig" \
    -e "s/(^|[^A-Za-z0-9_.-])(${key}\"?[[:space:]]*[=:][[:space:]]*)'[^']+'/\1\2'<redacted>'/Ig" \
    -e "s/(^|[^A-Za-z0-9_.-])(${key}\"?[[:space:]]*[=:][[:space:]]*)([&;]*[^[:space:]\"'&;]+|[&;]+)/\1\2<redacted>/Ig" \
    -e "s/(^|[[:space:]])(--?${key})[[:space:]]+(\"[^\"]+\"|'[^']+'|[^[:space:]\"']+)/\1\2 <redacted>/Ig" \
    -e "s/^(.*\"[^\"]*(${words})[^\"]*\".*\] \().*\)[[:space:]]*\$/\1<redacted>)/I" \
    -e '/[Rr]etro[Aa]chievements|raofflineproxy|dorequest|127\.0\.0\.1:8080/s/(^|[?&[:space:]])([pty]=)[^&[:space:]"'"'"']+/\1\2<redacted>/g' \
    -e 's/([?&]y=)[A-Za-z0-9]{16,}/\1<redacted>/g' \
    -e 's/(^|[^A-Za-z0-9])(AKIA)[0-9A-Z]{16}/\1\2<redacted>/g' \
    -e 's/(^|[^A-Za-z0-9])(gh[pousr]_)[A-Za-z0-9]{36}/\1\2<redacted>/g' \
    -e 's/(^|[^A-Za-z0-9])(github_pat_)[A-Za-z0-9_]{20,}/\1\2<redacted>/g' \
    -e 's/(^|[^A-Za-z0-9])(xox[baprs]-)[A-Za-z0-9-]{10,}/\1\2<redacted>/g' \
    -e 's/(^|[^A-Za-z0-9])(sk-)[A-Za-z0-9_-]{24,}/\1\2<redacted>/g' \
    -e '/-----BEGIN [A-Z ]*PRIVATE KEY/,/-----END [A-Z ]*PRIVATE KEY/{/-----(BEGIN|END) [A-Z ]*PRIVATE KEY/!s/.*/<redacted>/}' \
    -e 's/(setrootpass[[:space:]]+)[^[:space:]]+/\1<redacted>/' \
    -e 's#(://[^/[:space:]@:]+:)[^@/[:space:]]+@#\1<redacted>@#g'
}

function get_setting() {
  if [ -n "${3}" ]
  then
    ### Test to see if we have a game setting.
    VAR="$2\[\"$(echo ${3} | sed -E "s~'~\\\x27~g"';s~[()&]~\\&~g')\"\]\.$1"
    OUTPUT=$(awk 'BEGIN {FS="="} /^'"${VAR}"'/ {print $NF}' ${J_CONF})
    if [ ! -z "${OUTPUT}" ]
    then
      echo ${OUTPUT}
      return
    else
      ### If not, check to see if we have a system setting.
      LOCAL=$(awk -F: '/^'"${2}.${1}"'=/ { st = index($0,"=");print substr($0,st+1);exit}' ${J_CONF})
      if [ ! -z "${LOCAL}" ]
      then
        echo ${LOCAL}
        return
      fi
    fi
  fi

  if [ -z "${3}" ] && [ -n "${2}" ]
  then
    ### Check to see if we have a global setting.
    LOCAL=$(awk -F: '/^'"${2}.${1}"'=/ {  st = index($0,"=");print substr($0,st+1);exit}' ${J_CONF})
    if [ ! -z "${LOCAL}" ]
    then
      echo ${LOCAL}
      return
    fi
  fi

  ### Check to see if we have a "system." global setting.
  SYSTEM=$(awk -F: '/^system.'"${1}"='/ { st = index($0,"=");print substr($0,st+1);exit}' ${J_CONF})
  if [ -n "${SYSTEM}" ]
  then
    echo ${SYSTEM}
    return
  fi

  ### Check to see if we have a "global." global setting."
  LOCAL=$(awk -F: '/^'"${1}"='/ { st = index($0,"=");print substr($0,st+1);exit}' ${J_CONF})
  if [ -z "${LOCAL}" ]
  then
    awk -F: '/^global.'"${1}"='/ { st = index($0,"=");print substr($0,st+1);exit}' ${J_CONF}
    return
  else
    echo ${LOCAL}
  fi
  return
}

# One line to the system log about the settings lock. busybox ships logger
# (CONFIG_LOGGER=y); should an image lack it, stderr is the next best reader.
function wait_lock_say() {
  if command -v logger >/dev/null 2>&1
  then
    logger -t wait_lock "${*}"
  else
    echo "wait_lock: ${*}" >&2
  fi
}

# The settings lock: a file holding its holder's pid, shared with the
# interface's PidLock (es-core AtomicFileUtil) on the same path.
#
#   Taken born with the pid: written to <lock>.<pid> and hard-linked into
#   place, which fails when the lock exists -- so no waiter ever reads an
#   empty lock that is really a holder between its open and its write, the
#   window a noclobber create left (#307 PL-041). A shell without ln (a
#   test's narrow PATH) falls back to that create.
#
#   Reaped once, under flock on <lock>.reap -- the lock the interface's
#   reaper takes too -- by re-reading the holder and removing the file only
#   if it still names the same holder and that holder is still not alive.
#   Two waiters that read the same stale pid used to re-read and remove in
#   two steps each, so the slower one removed the faster one's fresh lock
#   and both held it (#307 PL-041, #308 claude F-PB-08); under the reap lock
#   the second finds the lock changed and leaves it. Without flock (a
#   narrow PATH), the reap runs unguarded, as before.
#
#   Given up on, not spun on, when it cannot be created at all: a create
#   that fails with nothing at the path is retried at once once (released
#   in between) and then each second, and after five such misses -- a lock
#   folder that is missing, a read-only /tmp -- wait_lock says so and
#   returns 1, where it used to retry with no sleep for ever and hold a
#   core at 100% (#308 claude F-PB-06). A live holder is still waited on
#   for as long as it lives.
#
# The pid-reuse half of F-PB-08 does not arise: J_CONF_LOCK is on /tmp, a
# tmpfs, so no lock outlives the boot that wrote it.
function wait_lock() {
  local holder waited_on="" held_for=0 misses=0 took reaped
  while true
  do
    took=""
    if command -v ln >/dev/null 2>&1
    then
      if echo "$$" > "${J_CONF_LOCK}.$$" 2>/dev/null
      then
        ln "${J_CONF_LOCK}.$$" "${J_CONF_LOCK}" 2>/dev/null && took=1
        rm -f "${J_CONF_LOCK}.$$"
      fi
    else
      (set -o noclobber; echo "$$" > "${J_CONF_LOCK}") 2>/dev/null && took=1
    fi
    if [ -n "${took}" ]
    then
      # Save the exit status before anything else runs: 'exit $?' after rm
      # re-exited with rm's 0, so every script that ever took this lock (runemu.sh
      # among them) exited 0 however it ended. Release only a lock this shell still
      # holds -- callers rm it themselves, the trap outlives them, and another
      # process may own the file by the time this one exits.
      trap 'rc=$?; [ "$(cat "${J_CONF_LOCK}" 2>/dev/null)" = "$$" ] && rm -f "${J_CONF_LOCK}"; exit "${rc}"' INT TERM EXIT
      return 0
    fi

    # The create failed with nothing there: released in between (try again
    # at once, the first time), or the lock cannot be made at all.
    if [ ! -e "${J_CONF_LOCK}" ]
    then
      misses=$((misses + 1))
      if [ "${misses}" -ge 5 ]
      then
        wait_lock_say "cannot create ${J_CONF_LOCK} (its folder missing or not writable); not waiting on it"
        return 1
      fi
      [ "${misses}" -gt 1 ] && sleep 1
      continue
    fi
    misses=0

    # The file is there and names its holder -- or named one. A holder that
    # ends normally releases it through the trap above; one that is
    # SIGKILLed, OOM-killed or dies with its terminal cannot, and until
    # 2026-09-09 nothing read the pid in the file, so a stale lock stalled
    # every get_setting and set_setting on the device until reboot (4 min 43 s
    # for one set_setting on the VM, #98). Read the holder and ask the kernel.
    holder=""
    read -r holder 2>/dev/null < "${J_CONF_LOCK}"
    case "${holder}" in
      ''|*[!0-9]*)
        # Empty, or not a pid: nobody can be holding it. An empty file can
        # still be a noclobber create between its open and its write (the
        # fallback above, or an older writer), so give it a moment first.
        [ -n "${holder}" ] || sleep 0.2 2>/dev/null || sleep 1
        ;;
      *)
        if kill -0 "${holder}" 2>/dev/null
        then
          # Alive: wait, as ever, and never take a live holder's lock. After
          # 30 s of the same holder, say who it is -- once, not every second --
          # so the next person to find a stalled set_setting has a pid to look
          # at instead of a file that carries one nobody reads.
          if [ "${holder}" != "${waited_on}" ]
          then
            waited_on="${holder}"
            held_for=0
          fi
          held_for=$((held_for + 1))
          if [ "${held_for}" -eq 30 ]
          then
            wait_lock_say "still waiting on ${J_CONF_LOCK}: held by live pid ${holder} for ${held_for}s"
          fi
          sleep 1
          continue
        fi
        ;;
    esac

    # Stale. Reap it once, under the reap lock, only if it still names the
    # holder read above and that holder is still gone; then try again.
    reaped=$( {
        if command -v flock >/dev/null 2>&1; then flock -x 9 || exit 0; fi
        now=""
        [ -e "${J_CONF_LOCK}" ] || exit 0
        read -r now 2>/dev/null < "${J_CONF_LOCK}"
        [ "${now}" = "${holder}" ] || exit 0
        case "${now}" in ''|*[!0-9]*) ;; *) kill -0 "${now}" 2>/dev/null && exit 0 ;; esac
        rm -f "${J_CONF_LOCK}" && echo removed
      } 9>"${J_CONF_LOCK}.reap" 2>/dev/null )
    [ "${reaped}" = "removed" ] && wait_lock_say "removed stale lock ${J_CONF_LOCK} held by pid ${holder:-<none>}"
  done
}

# One key, one write, one rename, under a lock the caller holds: awk prints
# every line but the key's, then the key's new line, into a temporary
# beside the file, and the temporary is renamed over it -- so the file goes
# from the old content to the new in a single step, and an empty file (a
# torn write left it so) gets its one line the same way. It used to be
# del_setting (a rename) and then an append, with the lock released and
# retaken in between: a kill between the two lost the key (D-CLOUD-078,
# #105). Then it was one sed -i, `/^k=/d` and `$a k=v`, which loses the
# key whenever its line is the LAST line of the file: `d` ends the cycle
# and `$a` never runs for that line, so every key that sat last in
# system.cfg read as its default after being set (KILL10/KILL11 on the VM,
# 2026-09-10). The key is matched literally (a dot in it is a dot), and the
# value crosses through the environment, so `/`, `&`, `\` and spaces are
# nobody's to interpret.
#
# Returns 0 only when the new file is in place: the awk and the rename both
# succeeded. The failure branch used to end in the rm of the temporary, so
# the function's status was the rm's -- 0 -- and a write that never landed
# (a full card, a read-only folder) was reported to every caller as done
# (#307 PL-011).
function write_setting_line() {
  if K="${1}" V="${2}" awk 'BEGIN { k = ENVIRON["K"]; v = ENVIRON["V"] }
                            index($0, k "=") != 1 { print }
                            END { print k "=" v }' "${J_CONF}" > "${J_CONF}.tmp" 2>/dev/null \
     && mv -f "${J_CONF}.tmp" "${J_CONF}"
  then
    return 0
  fi
  rm -f "${J_CONF}.tmp"
  return 1
}
#
# Any other key's line is removed by the same literal match the writer uses:
# `sed -i "/^${1}=/d"` read the key as a pattern, so deleting foo.bar also
# removed foo_bar and fooXbar (#308, the gpt seat's F-PB-16) -- and through
# one temporary and one rename, with the status returned, as the writer.
function del_setting() {
  local rc=0
  wait_lock || return 1
  if [[ "${1}" =~ ^[[:alnum:]] ]]
  then
    if [ "${1}" = "system.hostname" ]
    then
      # The hostname line is the sentinel chksysconfig reads a usable
      # system.cfg by -- deliberate since #102, where a file that had lost
      # it was the symptom of "defaults won". Deleting the line made the
      # file read as damaged at the next shutdown and boot, and the last
      # good copy, with the old name in it, came back (#154). So this key's
      # default is an empty value, not an absent line: network-base-setup
      # already reads empty as the shipped default and gives the unit its
      # own name at the next boot (D-NET-002, D-NET-009). The sentinel
      # itself is not loosened.
      write_setting_line "${1}" "" || rc=1
    else
      if K="${1}" awk 'index($0, ENVIRON["K"] "=") != 1' "${J_CONF}" > "${J_CONF}.tmp" 2>/dev/null \
         && mv -f "${J_CONF}.tmp" "${J_CONF}"
      then
        :
      else
        rm -f "${J_CONF}.tmp"
        rc=1
      fi
    fi
  fi
  rm -f "${J_CONF_LOCK}"
  return ${rc}
}

function sort_settings() {
  wait_lock || return 1
  # The sorted copy replaces the live file only when it is plainly a config:
  # non-empty and still carrying the hostname line every image writes. An
  # unreadable source (EIO, a card on its way out) gives grep nothing, and
  # the mv below then installed an empty system.cfg -- the shape #102's
  # "defaults won" started from (D-CLOUD-078).
  grep '^[a-z0-9]' "${J_CONF}" | sort >"${J_CONF}.tmp"
  if [ -s "${J_CONF}.tmp" ] && grep -q '^system\.hostname=' "${J_CONF}.tmp"
  then
    mv -f "${J_CONF}.tmp" "${J_CONF}"
  else
    rm -f "${J_CONF}.tmp"
    logger -t sort_settings "left system.cfg alone: the sorted copy was empty or had no hostname line" 2>/dev/null
  fi
  rm -f "${J_CONF_LOCK}"
}

function set_kill() {
  if [ "${1}" = "set" ]
  then
    cat <<EOF >/tmp/.process-kill-data
${2}
EOF
  elif [ "${1}" = "stop" ]
  then
    if [ -e "/tmp/.process-kill-data" ]
    then
      rm -f "/tmp/.process-kill-data"
    fi
  fi
}

# The device name in the only form the network accepts: letters, digits and
# hyphens, at most 63 of them, no hyphen at either end. Anything else -- a
# space, an underscore, punctuation, a run of hyphens -- becomes one hyphen, so "RG SP" is
# applied as RG-SP rather than refused by hostnamed and left as whatever
# NetworkManager put there (fork #106). EmulationStation's HOSTNAME row keeps
# the same rule at entry (GuiMenu, cleanHostname); this is the fallback for a
# value already stored. Empty in, empty out: the caller decides the default.
function clean_hostname() {
  printf '%s' "${1}" | sed -E 's/[^A-Za-z0-9]+/-/g; s/^-+//; s/-+$//' | cut -c1-63 | sed -E 's/-+$//'
}

function set_setting() {

  if [ ! -d "/storage/.config/system/configs" ]
  then
    mkdir -p /storage/.config/system/configs
  fi
  if [ ! -e "/storage/.config/system/configs/system.cfg" ]
  then
    cp -f /usr/config/system/configs/system.cfg /storage/.config/system/configs/system.cfg
  fi

  if [[ "${1}" =~ ^[[:alnum:]] ]]
  then
    if [ "${2}" = "default" ]
    then
      # Removes the line -- or, for system.hostname, empties it: see there.
      del_setting "${1}"
    else
      # One write under one lock hold (write_setting_line says why), and the
      # write's own status returned past the lock's release (#307 PL-011).
      local rc
      wait_lock || return 1
      write_setting_line "${1}" "${2}"; rc=$?
      rm -f "${J_CONF_LOCK}"
      return ${rc}
    fi
  fi
}

function battery_percent() {
  if [ -f /tmp/battery.percent ]; then
    cat /tmp/battery.percent
  else
    awk 'BEGIN {FS="="} /POWER_SUPPLY_CAPACITY=/ {print $2}' /sys/class/power_supply/[Bb][Aa][Tt]*/uevent 2>/dev/null
  fi
}

function get_es_setting() {
  echo $(sed -n "s|\s*<${1} name=\"${2}\" value=\"\(.*\)\" />|\1|p" ${ES_CONF})
}

function fbwidth() {
  local ORIENTATION=$(</sys/devices/virtual/graphics/fbcon/rotate)
  if [ "${ORIENTATION}" = "0" ]
  then
    fbset | awk '/geometry/ {print $2}'
  else
    fbset | awk '/geometry/ {print $3}'
  fi
}

function fbheight() {
  local ORIENTATION=$(</sys/devices/virtual/graphics/fbcon/rotate)
  if [ "${ORIENTATION}" = "0" ]
  then
    fbset | awk '/geometry/ {print $3}'
  else
    fbset | awk '/geometry/ {print $2}'
  fi
}

function cpu_vendor() {
  awk '/vendor_id/ {print $3;exit}' /proc/cpuinfo
}

# sway window manager utility function to enable fullscreen on a window for an input app_id
function sway_fullscreen {
  # value for swaymsg criteria
  # for 'virtual' attributes pidof / pgrep this is the process to look up pid for
  local VALUE="${1}"
  
  # attribute for swaymsg criteria - default to app_id for backwards compatibility
  # 'virtual' attributes pidof / pgrep result in the value being evaluted at runtime
  local ATTRIBUTE="${2:-app_id}"

  # retry control vars
  local QUERY_LIMIT=5
  local QUERY_COUNT=0

  if echo "${UI_SERVICE}" | grep "sway"; then
    while [ $QUERY_COUNT -lt $QUERY_LIMIT ]; do
      # loop, attempting to fullscreen window for app_id
      ((QUERY_COUNT++))

      # Derive swaymsg criteria attribute and value where they are dynamic
      if [[ "${ATTRIBUTE}" = @(pidof|pgrep) ]]; then
        local PID=""

        case "${ATTRIBUTE}" in
          "pidof")
            PID=$(pidof "${VALUE}")
            ;;
          "pgrep")
            PID=$(pgrep "${VALUE}")
            ;;
        esac

        if [ -z "${PID}" ]; then
          echo "No PID found for VALUE=${VALUE}"
          sleep 1
          continue
        else
          ATTRIBUTE="pid"
          VALUE="${PID}"
        fi
      fi

      echo "Attempting to fullscreen ${ATTRIBUTE}=${VALUE}"
      swaymsg '['"${ATTRIBUTE}"'='"${VALUE}"'] fullscreen enable'
      local RESULT=$?

      if [ $RESULT -eq 0 ]; then
        echo "Successful, exiting"
        break
      else
        echo "Failed, waiting to try again"
        sleep 1
      fi
    done
  else
    echo "sway is not running, exiting"
  fi
}
