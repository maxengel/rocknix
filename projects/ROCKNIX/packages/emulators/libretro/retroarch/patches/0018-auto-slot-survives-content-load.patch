+    * the player launched with. Resetting it here to 0, or to the last
+    * numbered slot, sent that hotkey to a slot 0 file that does not exist
+    * (fork #249). A configured Auto is left alone; a numbered slot is
+    * scanned or reset as before. */
+   if (settings->ints.state_slot < 0)
+      return;
    if (savestate_auto_index)
    {
       command_scan_states(
