+      place_line_height                           = p_dispwidget->gfx_widget_fonts.msg_queue.line_height * place_scale;
+      p_dispwidget->msg_queue_place_padding       = (unsigned)((place_line_height * (2.0f / 3.0f)) + 0.5f);
+      p_dispwidget->msg_queue_place_spacing       = (unsigned)((place_line_height * 2.4f * (BASE_FONT_SIZE / MSG_QUEUE_FONT_SIZE)) / 4.0f);
+   }
    p_dispwidget->msg_queue_rect_start_x           = ceil(p_dispwidget->msg_queue_padding - (p_dispwidget->simple_widget_padding * 0.10f));
 
    gfx_widgets_update_icon_layout(p_dispwidget);
