# GENERIC_X64: request an OpenGL ES 3.0 context instead of ES 2.0.
#
# EmulationStation draws the menu dim/blur panel via Renderer::blurBehind() ->
# postProcessShader(), which calls glBlitFramebuffer() - an OpenGL ES 3.0
# function. Handheld GPU drivers (Adreno/Mali) expose glBlitFramebuffer in an
# ES 2.0 context via extension, so the menu renders there. Mesa's strict ES 2.0
# context (llvmpipe / virgl, i.e. every GENERIC_X64 VM) does not, so the blit is
# skipped and the whole menu background/panel silently disappears - menu items
# float over the carousel.
#
# Requesting an ES 3.0 context (which Mesa fully supports) makes
# glBlitFramebuffer available and the menu overlay renders correctly. This patch
# is GENERIC_X64-scoped, where the renderer is always Mesa, so no ES 2.0
# fallback is required.
--- a/es-core/src/renderers/Renderer_GLES20.cpp
+++ b/es-core/src/renderers/Renderer_GLES20.cpp
@@ -486,7 +486,7 @@
 
 		SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_CORE);
 #else
-		SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 2);
+		SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
 		SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
 
 		SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
