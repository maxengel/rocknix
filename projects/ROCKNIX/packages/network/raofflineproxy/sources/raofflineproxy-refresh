#
# raofflineproxy-refresh -- re-read a game's RetroAchievements state now.
#
# The service already re-reads every cached game's patch and unlocks about
# once a day while the device is online (patch 005: oldest patch row first,
# 50 a pass, a 24 h floor). That covers the ordinary case and needs nobody's
# attention. It does not cover the case a player is standing in front of:
# they have just reset an achievement on retroachievements.org, or earned one
# on another device, and they want to play this game offline in five minutes.
#
#   raofflineproxy-refresh --game <id>     one game, ignoring the age floor
#   raofflineproxy-refresh --all           every cached game, floor ignored
#   raofflineproxy-refresh                 what the daily pass would take now
#
# It is the same work the service's own pass does -- refresh_game_patch for
# the set and its images, then cache_unlocks for what the player has earned --
# run when asked instead of when due. Both, because the names mislead: the
# "patch" refresh does not touch unlocks. Nothing here
# changes what a pass is allowed to do: the client's own throttle, batch
# cooldown and 429 backoff still pace every request, and the run is bounded
# by --seconds so a player who asks for 500 games does not wait forever.
#
# Refuses while offline: a refresh is a conversation with the server, and
# there is nothing useful to do without one. Speaks the ctl's `>>> ` protocol
# so the interface can show progress (fork maxengel/rocknix#223).

from __future__ import annotations

import argparse
import json
import sys
import time

from raofflineproxy import cache_keys
from raofflineproxy.auth import resolve_credentials
from raofflineproxy.config import configure_logging, load_config
from raofflineproxy.storage import Storage
from raofflineproxy.utils import proxy_user_agent, self_user_agent
import raofflineproxy.proxy_service as proxy_service

FLOOR_SECONDS = 86400


def tell(text: str) -> None:
    print(f">>> {text}", flush=True)


def note(text: str) -> None:
    print(text, flush=True)


def cached_games(storage: Storage) -> list[dict]:
    """Every patch row, as select_games_to_refresh wants them."""
    rows = []
    for row in storage.get_all_cache_by_prefix(cache_keys.PREFIX_PATCH):
        if row.get("responseBody"):
            rows.append(row)
    return rows


def game_ids(rows: list[dict]) -> list[int]:
    ids = []
    for row in rows:
        key = str(row.get("cacheKey") or "")
        parts = key.split(":")
        if len(parts) > 1 and parts[1].isdigit():
            ids.append(int(parts[1]))
    return ids


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--game", type=int, help="one game id")
    parser.add_argument("--all", action="store_true", help="every cached game, ignoring the age floor")
    parser.add_argument("--seconds", type=float, default=300.0)
    args = parser.parse_args()

    configure_logging()
    config_data = load_config()

    tell("doing refresh")
    try:
        storage = Storage()
    except Exception as exc:
        note(f"the store could not be opened: {exc}")
        tell("why STORE_UNREADABLE")
        return 2
    try:
        credentials = resolve_credentials(storage, config_data, self_user_agent())
    except Exception as exc:
        note(f"no account to refresh as: {exc}")
        tell("why NO_ACCOUNT")
        return 2
    user_agent = proxy_user_agent(self_user_agent())

    rows = cached_games(storage)
    if args.game:
        wanted = [args.game]
    elif args.all:
        wanted = game_ids(rows)
    else:
        # Exactly what the daily pass would take, so this is also a way to
        # make the next pass's work happen now.
        wanted = proxy_service.select_games_to_refresh(rows, int(time.time() * 1000))
    if not wanted:
        note("nothing is due; every cached game was re-read within the last day")
        tell("note NOTHING_DUE")
        tell("done 0|0")
        return 0

    note(f"{len(wanted)} game(s) to re-read, from {len(rows)} cached")
    tell(f"total {len(wanted)}")
    deadline = time.monotonic() + max(1.0, args.seconds)
    done = 0
    failed = 0
    for index, gid in enumerate(wanted, 1):
        if time.monotonic() > deadline:
            left = len(wanted) - done - failed
            note(f"stopped at the {args.seconds:.0f}s ceiling; {left} game(s) left")
            tell(f"note LEFT {left}")
            tell(f"done {done}|{left}")
            return 1
        try:
            answer = proxy_service.refresh_game_patch(
                gid, credentials, user_agent, storage, config_data
            )
            # The patch is only half of it. refresh_game_patch re-reads the
            # set; the player's unlocks are a separate call, and a refresh
            # that skips it reports success while leaving the device
            # believing in achievements the site no longer holds -- which is
            # exactly what it did on the RG SP on 2026-09-19, after two
            # achievements were reset on the site: patch 28 s old, unlocks
            # 87,168 s old, and the two still reading as earned.
            proxy_service.cache_unlocks(
                gid, credentials, user_agent, config_data, storage
            )
            done += 1
            # It is documented as returning the title and returns the patch
            # body, so take the title out of it rather than printing a page
            # of JSON into the ctl's output.
            title = ""
            if answer:
                try:
                    title = (json.loads(answer).get("PatchData") or {}).get("Title") or ""
                except Exception:
                    title = str(answer)[:40]
            note(f"re-read {index}/{len(wanted)}: game {gid}" + (f" '{title}'" if title else ""))
            tell(f"refresh {index}|{len(wanted)}")
        except Exception as exc:
            failed += 1
            note(f"game {gid}: {exc}")
            if failed >= 3:
                note("three failures in a row; stopping rather than hammering")
                tell("why REPEATED_FAILURES")
                tell(f"done {done}|{len(wanted) - done}")
                return 1

    note(f"re-read {done} game(s), {failed} failed")
    tell(f"done {done}|{failed}")
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main())
