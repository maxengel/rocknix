-                    WHERE cachedAt < ?
-                      AND cacheKey NOT LIKE 'login2::%'
-                      AND cacheKey != ?
-                    """,
-                    (before, cache_keys.USER_AGENT),
+                self._connection.executemany(
+                    "DELETE FROM api_cache WHERE cacheKey = ?",
+                    [(key,) for key in sorted(doomed)],
                 )
                 self._connection.commit()
