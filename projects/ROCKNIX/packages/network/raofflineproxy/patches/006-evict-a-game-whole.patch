     def evict_cache_older_than(self, before: int) -> None:
+        # A game is evicted whole or not at all. The refresh keeps a game's
+        # patch, unlocks and startsession rows young and never touches its
+        # achievementsets row (keyed by hash, fetched once by a launch or a
+        # bulk cache) or its gameid alias, so evicting row by row deleted, at
+        # sixty days, exactly the row a RetroArch 1.22 launch loads the game
+        # through -- while the refreshed patch row kept the game in
+        # cached_game_ids.txt and every "cached" count. The game was still
+        # counted and no longer playable offline. So a stale row is kept
+        # while any patch or achievementsets row of its game is still young,
+        # and a game goes only when all of them are stale; the login rows
+        # and the User-Agent row are kept as before.
+        doomed = self._stale_cache_keys_by_game(before)
         if self._use_sqlite:
             assert self._connection is not None
             with self._lock:
-                self._connection.execute(
-                    """
