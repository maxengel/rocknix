+    def _cache_keys_and_ages(self) -> list[dict]:
+        """Every api_cache row as {cacheKey, cachedAt}, without its body."""
+        if self._use_sqlite:
+            assert self._connection is not None
+            with self._lock:
+                rows = self._connection.execute(
+                    "SELECT cacheKey, cachedAt FROM api_cache"
+                ).fetchall()
+            return [row_to_dict(row) for row in rows]
+
+        with self._lock:
+            with self._json_file_lock(exclusive=False):
+                self._reload_json_state_unlocked()
+                assert self._json_state is not None
+                return [
+                    {"cacheKey": item["cacheKey"], "cachedAt": item.get("cachedAt", 0)}
+                    for item in self._json_state["api_cache"]
+                ]
+
+    def _game_id_of_cache_key(self, cache_key: str) -> int | None:
+        """The game a cache row belongs to: from the key for patch, unlocks
+        and startsession rows, from the body for achievementsets (GameId)
+        and gameid (GameID) rows. None for a row that names no game."""
+        for prefix in (
+            cache_keys.PREFIX_PATCH,
+            cache_keys.PREFIX_UNLOCKS,
+            cache_keys.PREFIX_STARTSESSION,
+        ):
+            if cache_key.startswith(prefix):
+                value = cache_key[len(prefix):].split(":", 1)[0]
+                return int(value) if value.isdigit() else None
+        if cache_key.startswith(cache_keys.PREFIX_ACHIEVEMENTSETS) or cache_key.startswith(
+            cache_keys.PREFIX_GAMEID
+        ):
+            entry = self.get_cache(cache_key)
+            if entry is None:
+                return None
+            try:
+                payload = json.loads(entry["responseBody"])
+            except Exception:
+                return None
+            if not isinstance(payload, dict):
+                return None
+            field = "GameId" if cache_key.startswith(cache_keys.PREFIX_ACHIEVEMENTSETS) else "GameID"
+            value = payload.get(field)
+            return value if isinstance(value, int) and value > 0 else None
+        return None
+
+    def _stale_cache_keys_by_game(self, before: int) -> set[str]:
+        """The keys eviction may delete: rows older than `before`, less the
+        login rows and the User-Agent row, less every row of a game one of
+        whose patch or achievementsets rows is younger than `before`."""
+        rows = self._cache_keys_and_ages()
+        stale = {
+            row["cacheKey"]
+            for row in rows
+            if int(row.get("cachedAt") or 0) < before
+            and not row["cacheKey"].startswith(cache_keys.PREFIX_LOGIN)
+            and row["cacheKey"] != cache_keys.USER_AGENT
+        }
+        if not stale:
+            return stale
+        live: set[int] = set()
+        for row in rows:
+            key = row["cacheKey"]
+            if int(row.get("cachedAt") or 0) < before:
+                continue
+            if not (
+                key.startswith(cache_keys.PREFIX_PATCH)
+                or key.startswith(cache_keys.PREFIX_ACHIEVEMENTSETS)
+            ):
+                continue
+            game_id = self._game_id_of_cache_key(key)
+            if game_id is not None:
+                live.add(game_id)
+        return {key for key in stale if self._game_id_of_cache_key(key) not in live}
+
     def get_pending_awards(self) -> list[dict]:
         if self._use_sqlite:
             assert self._connection is not None
