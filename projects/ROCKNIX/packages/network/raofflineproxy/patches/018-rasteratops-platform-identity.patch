+
+    def test_rasteratops_discovers_rocknix_account_settings(self) -> None:
+        with tempfile.TemporaryDirectory() as temp_dir:
+            os_release = Path(temp_dir) / "os-release"
+            system_cfg = Path(temp_dir) / "system.cfg"
+            os_release.write_text('OS_NAME="RASTERATOPS"\n', encoding="utf-8")
+            system_cfg.touch()
+            with patch.object(config, "OS_RELEASE_PATH", os_release), patch.object(
+                config, "DEFAULT_ROCKNIX_SYSTEM_CFG", system_cfg
+            ):
+                self.assertTrue(config.running_on_rocknix())
+                self.assertEqual(config.detect_rocknix_system_cfg(), str(system_cfg))
+                self.assertEqual(
+                    config.detect_rocknix_system_cfg({"rocknix_system_cfg": "/custom/system.cfg"}),
+                    "/custom/system.cfg",
+                )
+
+    def test_platform_name_must_be_the_complete_os_name_record(self) -> None:
+        with tempfile.TemporaryDirectory() as temp_dir:
+            os_release = Path(temp_dir) / "os-release"
+            for text in ('# OS_NAME="ROCKNIX"', 'PREVIOUS_OS_NAME="ROCKNIX"', 'OS_NAME="ROCKNIX_REMIX"'):
+                with self.subTest(text=text):
+                    os_release.write_text(text + "\n", encoding="utf-8")
+                    with patch.object(config, "OS_RELEASE_PATH", os_release):
+                        self.assertFalse(config.running_on_rocknix())
 
