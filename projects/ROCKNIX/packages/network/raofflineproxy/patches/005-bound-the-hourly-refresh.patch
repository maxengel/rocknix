+# The hourly refresh is bounded. It was sized under MAX_CACHED_GAMES = 100:
+# every cached game, every pass, two requests each (patch, unlocks). With
+# no cap on the cache that is 2N GETs an hour for a library of N games -- a
+# 1,000-game library about 41,000 a day per device, ten minutes of
+# back-to-back requests each hour at the 0.3 s throttle. A pass now takes
+# only games whose patch row is at least REFRESH_MIN_AGE_SECONDS old, the
+# oldest first, and at most REFRESH_MAX_GAMES_PER_PASS of them: at most 100
+# GETs an hour whatever N is, and each game refreshed about once a day (up
+# to 1,200 games) or once every N/50 hours beyond that. The per-pass limit
+# equals SCAN_BATCH_SIZE, so no batch cooldown falls inside a pass.
+REFRESH_MIN_AGE_SECONDS = 24 * 3600
+REFRESH_MAX_GAMES_PER_PASS = 50
+# Fetches that fail in a row before a pass gives up (the link, the server);
+# a refused sign-in ends a pass at once, without a request for every game.
+REFRESH_MAX_FAILURES_IN_A_ROW = 3
+
+
+def select_games_to_refresh(
+    patch_entries: Sequence[dict],
+    now_ms: int,
+    min_age_seconds: int = REFRESH_MIN_AGE_SECONDS,
+    max_games: int = REFRESH_MAX_GAMES_PER_PASS,
+) -> list[int]:
+    """The game ids due a refresh: those whose newest patch row is at least
+    min_age_seconds old, the oldest first, at most max_games of them."""
+    newest: dict[int, int] = {}
+    for entry in patch_entries:
+        game_id = cache_keys.parse_game_id_from_patch_key(entry.get("cacheKey") or "")
+        if game_id is None:
+            continue
+        cached_at = int(entry.get("cachedAt") or 0)
+        if game_id not in newest or cached_at > newest[game_id]:
+            newest[game_id] = cached_at
+    cutoff = now_ms - min_age_seconds * 1000
+    due = sorted(
+        (game_id for game_id, cached_at in newest.items() if cached_at <= cutoff),
+        key=lambda game_id: (newest[game_id], game_id),
+    )
+    return due[: max(0, max_games)]
+
