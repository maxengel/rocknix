--- a/linux/tests/test_linux_network.py
+++ b/linux/tests/test_linux_network.py
@@ -16,6 +16,55 @@ class LinuxNetworkTests(unittest.TestCase):
         os.environ.pop("RAOFFLINEPROXY_CA_FILE", None)
