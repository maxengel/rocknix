<p class=note>Everything below is the older way, if the page above did not
open on the handheld.</p>
"""


# Linux input constants, from include/uapi/linux/input-event-codes.h.
EV_SYN, EV_KEY = 0x00, 0x01
SYN_REPORT = 0
UI_SET_EVBIT, UI_SET_KEYBIT = 0x40045564, 0x40045565
UI_DEV_CREATE, UI_DEV_DESTROY = 0x5501, 0x5502

# US layout, which is what the on-screen keyboard and the browser both assume.
# Only what a sign-in needs: an address, a password, and the keys to correct
# and submit them.
KEYMAP = {}
for _i, _c in enumerate("abcdefghijklmnopqrstuvwxyz"):
    KEYMAP[_c] = ((30, 48, 46, 32, 18, 33, 34, 35, 23, 36, 37, 38, 50,
                   49, 24, 25, 16, 19, 31, 20, 22, 47, 17, 45, 21, 44)[_i], False)
for _i, _c in enumerate("1234567890"):
    KEYMAP[_c] = (2 + _i, False)
KEYMAP.update({
    " ": (57, False), "-": (12, False), "=": (13, False), "[": (26, False),
    "]": (27, False), "\\": (43, False), ";": (39, False), "'": (40, False),
    "`": (41, False), ",": (51, False), ".": (52, False), "/": (53, False),
})
for _plain, _shifted in zip("1234567890-=[]\\;',./`", '!@#$%^&*()_+{}|:"<>?~'):
    KEYMAP[_shifted] = (KEYMAP[_plain][0], True)
for _c in "abcdefghijklmnopqrstuvwxyz":
    KEYMAP[_c.upper()] = (KEYMAP[_c][0], True)

NAMED_KEYS = {"enter": 28, "backspace": 14, "tab": 15, "escape": 1,
              "left": 105, "right": 106, "up": 103, "down": 108,
              "home": 102, "end": 107, "delete": 111,
              "pageup": 104, "pagedown": 109,
              "f1": 59, "f2": 60, "f3": 61}
KEY_LEFTSHIFT = 42

# How long a key is held, and the gap before the next one. Roughly 130 words
# per minute -- faster than anyone types, slow enough that a page's own input
# handling sees each keystroke as a separate event.
KEY_HOLD = 0.012
KEY_GAP = 0.022


class RemoteKeyboard:
    """A keyboard the phone can type on, for the window on the handheld.

    The player reads the provider's page on the device's own screen and types
    on the keyboard they already know how to use. Nothing is mirrored, so the
    only thing crossing the network is a keystroke -- which is why this
    replaced streaming the display.

    uinput rather than the Wayland virtual-keyboard protocol: it needs no
    Wayland client of our own, and sway picks the device up through libinput
    exactly as it would a keyboard someone plugged in.
    """

    def __init__(self):
        self.fd = None

    def open(self):
        if self.fd is not None:
            return True
        try:
            fd = os.open(UINPUT, os.O_WRONLY | os.O_NONBLOCK)
        except OSError as exc:
            log("no virtual keyboard: %s" % exc)
            return False
        try:
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_KEY)
            fcntl.ioctl(fd, UI_SET_EVBIT, EV_SYN)
            for code in set(list(NAMED_KEYS.values())
                            + [c for c, _ in KEYMAP.values()] + [KEY_LEFTSHIFT]):
                fcntl.ioctl(fd, UI_SET_KEYBIT, code)
            # struct uinput_user_dev: name[80], id{bustype,vendor,product,
            # version}, ff_effects_max, then the absmin/max/fuzz/flat arrays.
            name = b"ROCKNIX cloud sign-in".ljust(80, b"\0")
            os.write(fd, name + struct.pack("HHHHi", 0x03, 0x1209, 0x0001, 1, 0)
                     + b"\0" * (4 * 64 * 4))
            fcntl.ioctl(fd, UI_DEV_CREATE)
        except OSError as exc:
            log("could not create the virtual keyboard: %s" % exc)
            os.close(fd)
            return False
        # udev and libinput need a moment to notice a new device.
        time.sleep(0.5)
        self.fd = fd
        log("virtual keyboard ready")
        return True

    def _emit(self, etype, code, value):
        now = time.time()
        os.write(self.fd, struct.pack("llHHi", int(now),
                                      int((now % 1) * 1000000), etype, code, value))

    def _tap(self, code, shift=False):
        """One keypress, reported the way a real keyboard reports it.

        Each state change is its own SYN_REPORT, and press and release are
        separated in time. Sending press and release in a single report, with
        zero timestamps, is not what any hardware does: libinput and the
        page's own input handling both read it as one indivisible blur, and a
        typed address arrived truncated -- six characters of sixteen. The
        delays below are what a fast typist produces, and cost nothing that
        matters when the whole point is to save somebody a minute on a d-pad.
        """
        if shift:
            self._emit(EV_KEY, KEY_LEFTSHIFT, 1)
            self._emit(EV_SYN, SYN_REPORT, 0)
            time.sleep(KEY_GAP)
        self._emit(EV_KEY, code, 1)
        self._emit(EV_SYN, SYN_REPORT, 0)
        time.sleep(KEY_HOLD)
        self._emit(EV_KEY, code, 0)
        self._emit(EV_SYN, SYN_REPORT, 0)
        if shift:
            time.sleep(KEY_GAP)
            self._emit(EV_KEY, KEY_LEFTSHIFT, 0)
            self._emit(EV_SYN, SYN_REPORT, 0)

    def type_text(self, text):
        """Send printable characters. Returns how many were sent."""
        if not self.open():
            return 0
        sent = 0
        for char in text:
            entry = KEYMAP.get(char)
            if entry is None:
                continue        # not on a US layout; silently skipped
            self._tap(*entry)
            time.sleep(KEY_GAP)
            sent += 1
        return sent

    def press(self, name):
        code = NAMED_KEYS.get(name)
        if code is None or not self.open():
            return False
        self._tap(code)
        return True

    def close(self):
        if self.fd is None:
            return
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        os.close(self.fd)
        self.fd = None


# The handheld's controls, as the kernel reports them. A gamepad is not a
# keyboard: sway classifies this one as a tablet_pad, so GTK and WebKit
# receive nothing at all from it. Without this bridge the sign-in page is
# visible on the device and cannot be touched from the device -- and, worse,
# cannot be left.
BTN_SOUTH, BTN_EAST, BTN_NORTH, BTN_WEST = 304, 305, 307, 308
BTN_TL, BTN_TR, BTN_SELECT, BTN_START, BTN_MODE = 310, 311, 314, 315, 316
BTN_DPAD_UP, BTN_DPAD_DOWN, BTN_DPAD_LEFT, BTN_DPAD_RIGHT = 544, 545, 546, 547

# Arrows rather than Tab: WebKit's spatial navigation moves focus in the
# direction pressed, which is what a d-pad means. Tab order on a login page
# wanders through cookie banners and footer links.
# BTN_EAST is the button labelled A on this hardware, not BTN_SOUTH. These
# handhelds use the Nintendo layout, where A sits in the east position --
# EmulationStation's own es_input.cfg maps a=button 1 (BTN_EAST) and
# b=button 0 (BTN_SOUTH). Taking the Xbox reading meant the player pressed A
# and got a backspace.
GAMEPAD_KEYS = {
    BTN_DPAD_UP: "up", BTN_DPAD_DOWN: "down",
    BTN_DPAD_LEFT: "left", BTN_DPAD_RIGHT: "right",
    BTN_EAST: "enter",             # A activates what is focused
    BTN_SOUTH: "backspace",        # B goes back, as it does everywhere else
    BTN_NORTH: "tab",              # Y steps forward if spatial nav sticks
    BTN_WEST: "f1",                # X shows and hides the on-screen keyboard
    # L1/R1 scroll the page. The window turns these into a scroll in the
    # page rather than page-up/page-down, which do nothing while a text
    # field has the caret -- which is most of a sign-in form, and exactly
    # when the button below the fold is what cannot be reached.
    BTN_TL: "f2", BTN_TR: "f3",
}

# Select held, then Start: the same combination RetroArch uses to leave a
# game on this hardware, so it is already in players' fingers.
# projects/ROCKNIX/.../retroarch has input_enable_hotkey_btn = "8" (Select)
# and input_exit_emulator_btn = "9" (Start).
#
# A combination rather than any single button. Select alone is far too easy
# to catch while reaching across a small handheld, and losing a half-typed
# password to a stray thumb is worse than needing two buttons to leave.
GAMEPAD_HOTKEY = BTN_SELECT
GAMEPAD_QUIT = BTN_START


def find_gamepad():
    """The device node for the handheld's controls, by capability not name.

    Named lookups would need a table per device -- "H700 Gamepad" on one
    handheld is something else on the next. A device carrying BTN_SOUTH and a
    d-pad is a gamepad whatever it calls itself.
    """
    for entry in sorted(os.listdir("/sys/class/input")):
        if not entry.startswith("event"):
            continue
        caps = "/sys/class/input/%s/device/capabilities/key" % entry
        try:
            words = open(caps).read().split()
        except OSError:
            continue
        codes = set()
        for index, word in enumerate(reversed(words)):
            value = int(word, 16)
            codes |= {index * 64 + bit for bit in range(value.bit_length())
                      if value >> bit & 1}
        if BTN_SOUTH in codes and BTN_DPAD_UP in codes:
            return "/dev/input/" + entry
    return None


class GamepadBridge:
    """Turn the handheld's buttons into keystrokes for the sign-in page.

    Reads the gamepad's own event node -- evdev allows several readers, so
    this does not take input away from EmulationStation -- and replays each
    press through the same virtual keyboard the phone types on.
    """

    def __init__(self, keyboard, on_quit):
        self.keyboard = keyboard
        self.on_quit = on_quit
        self.thread = None
        self.stop_flag = threading.Event()

    def start(self):
        node = find_gamepad()
        if not node:
            log("no gamepad found; the sign-in page can only be driven from a phone")
            return False
        self.thread = threading.Thread(target=self._run, args=(node,), daemon=True)
        self.thread.start()
        log("gamepad bridge reading %s" % node)
        return True

    def _run(self, node):
        try:
            fd = os.open(node, os.O_RDONLY)
        except OSError as exc:
            log("could not read the gamepad: %s" % exc)
            return
        size = struct.calcsize("llHHi")
        held = set()
        try:
            while not self.stop_flag.is_set():
                data = os.read(fd, size)
                if len(data) < size:
                    continue
                _, _, etype, code, value = struct.unpack("llHHi", data)
                if etype != EV_KEY:
                    continue

                if value == 0:
                    held.discard(code)
                    continue
                if value != 1:            # 2 is autorepeat; ignore
                    continue
                held.add(code)

                # Either order, so it does not matter which thumb gets there
                # first.
                if ((code == GAMEPAD_QUIT and GAMEPAD_HOTKEY in held)
                        or (code == GAMEPAD_HOTKEY and GAMEPAD_QUIT in held)):
                    log("player ended the sign-in from the handheld")
                    self.on_quit()
                    return

                # Select is the hotkey, so it does not type on its own.
                if code == GAMEPAD_HOTKEY:
                    continue
                name = GAMEPAD_KEYS.get(code)
                if name:
                    self.keyboard.press(name)
        except OSError:
            pass
        finally:
            os.close(fd)

    def stop(self):
        self.stop_flag.set()


class SessionHolder:
    """The server outlives any one sign-in attempt.

    rclone's authorize server answers exactly one redirect and then exits, so
    a code that arrives expired -- which is the normal way this fails, the
    window being a couple of minutes -- ends the attempt. Without somewhere to
    start another, the player is sent back to the handheld to redo a flow they
    had almost finished. So the attempt is replaceable and the *server* is what
    persists, along with the PIN: the handheld is showing that PIN and a QR
    built from it, and neither can be re-issued from here.
    """

    def __init__(self, backend, remote_name, label, timeout):
        self.backend = backend
        self.remote_name = remote_name
        self.name = display_name(backend, label)
        self.timeout = timeout
        self.pin = "%04d" % secrets.randbelow(10000)
        self.pin_attempts = 0
        self.lock = threading.Lock()
        self.session = None
        self.browser = None
        self.keyboard = RemoteKeyboard()
        self.gamepad = None

    def start(self):
        session = Session(self.backend, self.remote_name, self.timeout)
        if not session.start():
            return False, session.error
        with self.lock:
            self.stop_browser()
            self.session = session
        return True, None

    def start_browser(self):
        """Open the provider's page here, for the handheld or a phone to drive."""
        if not browser_stack_available() or not self.session:
            return False
        self.stop_browser()
        host = urllib.parse.urlparse(self.session.provider).hostname or ""
        browser = BrowserSession(self.session.provider, host)
        if not browser.start():
            return False
        with self.lock:
            self.browser = browser

        # The handheld's own controls, and with them a way back out. Without
        # this the page is on the screen, cannot be driven from the device,
        # and cannot be closed -- which strands the handheld in a browser.
        self.keyboard.open()
        self.gamepad = GamepadBridge(self.keyboard, self.stop_browser)
        self.gamepad.start()
        return True

    def stop_browser(self):
        gamepad, self.gamepad = self.gamepad, None
        if gamepad:
            gamepad.stop()
        browser, self.browser = self.browser, None
        if browser:
            browser.stop()
        self.keyboard.close()

    def pin_exhausted(self):
        with self.lock:
            return self.pin_attempts >= 10

    def pin_failed(self):
        with self.lock:
            self.pin_attempts += 1
            return self.pin_attempts >= 10

    def authorised(self, pin):
        return secrets.compare_digest(str(pin), self.pin)


def make_handler(holder, shutdown):
    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass  # its default writes request lines to stderr

        def _send(self, body, status=200):
            encoded = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)

        def _render(self, message=""):
            self._send(PAGE % {
                "style": STYLE,
                "name": holder.name,
                "provider": holder.session.provider if holder.session else "",
                "pin": holder.pin,
                "message": message,
                "here": HERE_BLOCK % {"pin": holder.pin, "name": holder.name}
                        if holder.browser else "",
            })

        def _render_pin(self, message="", supplied=""):
            self._send(PIN_PAGE % {
                "style": STYLE,
                "message": message,
                # Carried back so a mistyped digit is corrected rather than
                # re-entered, and so a link that already had a PIN on it does
                # not present an empty box.
                "pin": supplied,
            })

        def _render_done(self, remote):
            self._send(DONE_PAGE % {
                "style": STYLE, "name": holder.name, "remote": remote,
            })

        def _gate(self, pin):
            """True when the request may proceed; renders the refusal if not."""
            if holder.pin_exhausted():
                self.send_error(403, "Too many wrong PINs. Start again on "
                                     "the handheld.")
                return False
            if holder.authorised(pin):
                return True
            # No PIN at all is somebody typing the bare address, which is the
            # documented fallback -- ask, do not refuse. A wrong one is either
            # a typo or a guess, and both are answered the same way so neither
            # learns anything the other does not.
            if not pin:
                self._render_pin()
            elif holder.pin_failed():
                self.send_error(403, "Too many wrong PINs. Start again on "
                                     "the handheld.")
            else:
                self._render_pin('<div class=err>That PIN did not match.</div>',
                                 supplied="")
            return False

        def _supplied(self):
            """The PIN, from wherever this request carries it.

            The address shown on the handheld is http://<device>:8080/7677 --
            the PIN is the tail of the one thing on screen, rather than a
            second number displayed beside it that only the minority who type
            the address rather than scanning it will ever need. ?pin= is still
            accepted: it is what the prompt below submits, and what an older
            QR still in somebody's camera roll would carry.
            """
            parsed = urllib.parse.urlparse(self.path)
            from_query = urllib.parse.parse_qs(parsed.query).get("pin", [""])[0]
            if from_query:
                return from_query
            return parsed.path.strip("/").split("/")[0]

        def do_GET(self):
            if not self._gate(self._supplied()):
                return
            self._render()

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0))
            fields = urllib.parse.parse_qs(
                self.rfile.read(length).decode("utf-8", "replace"))
            if not self._gate(fields.get("pin", [""])[0] or self._supplied()):
                return

            if fields.get("type") or fields.get("key"):
                if not holder.browser:
                    self._render('<div class=err>The sign-in page is not '
                                 'open on the handheld.</div>')
                    return
                text = fields.get("type", [""])[0]
                named = fields.get("key", [""])[0]
                sent = holder.keyboard.type_text(text) if text else 0
                if named:
                    holder.keyboard.press(named)
                self.send_response(204)
                self.send_header("Content-Length", "0")
                self.end_headers()
                log("typed %d characters%s" % (sent, " + " + named if named else ""))
                return

            if fields.get("restart"):
                ok, error = holder.start()
                if ok:
                    write_state(status="waiting",
                                provider=holder.session.provider)
                    self._render('<div class=ok>Ready for another go. '
                                 'Sign in below.</div>')
                else:
                    self._render('<div class=err>%s</div>' % error)
                return

            session = holder.session
            if session is None:
                self._render('<div class=err>No sign-in is running.</div>')
                return

            ok, detail = session.submit(fields.get("code", [""])[0])
            if ok:
                self._render_done(detail)
                threading.Timer(2.0, shutdown).start()
                return

            # A dead attempt gets a way forward on this page rather than an
            # instruction to walk back to the handheld and redo the flow.
            restart = ""
            if session.finished():
                restart = ('<form method=post>'
                           '<input type=hidden name=pin value="%s">'
                           '<input type=hidden name=restart value="1">'
                           '<button class=minor type=submit>'
                           'Start a new sign-in</button></form>' % holder.pin)
            self._render('<div class=err>%s</div>%s' % (detail, restart))

    return Handler


def cmd_serve(backend, remote_name, label, port, timeout):
    if not shutil.which("rclone") and not os.path.exists(RCLONE):
        sys.stderr.write("rclone is not installed\n")
        return 2

    # Nothing from the last attempt survives into this one -- including a
    # serve still holding the port.
    stop_other_serves()
    reset_state(status="starting", backend=backend)

    holder = SessionHolder(backend, remote_name, label, timeout)
    ok, error = holder.start()
    if not ok:
        sys.stderr.write("%s\n" % error)
        write_state(status="failed", error=error)
        return 2

    address = lan_address()
    server = http.server.ThreadingHTTPServer(("0.0.0.0", port), None)

    def shutdown():
        threading.Thread(target=server.shutdown, daemon=True).start()

    server.RequestHandlerClass = make_handler(holder, shutdown)

    bare = "http://%s:%d" % (address, port)
    url = "%s/%s" % (bare, holder.pin)
    write_state(status="waiting", backend=backend, url=url, address=bare,
                provider=holder.session.provider, pin=holder.pin,
                name=holder.name)

    # The window is not opened here. It covers the screen the moment it
    # appears, and the address and QR the handheld is showing are how
    # somebody gets a phone keyboard onto it -- opening it immediately means
    # that screen flashes past before it can be read or scanned. The handheld
    # asks for it when the player is ready.
    #
    # Best effort throughout: an image without the browser stack falls
    # through to the paste flow rather than failing the sign-in, and the page
    # says which one you are looking at.
    def open_when_asked():
        # Loops rather than opening once: pressing Start closes the window
        # and gives the handheld back, and the player may well want it again
        # -- to correct an address, or because they closed it by accident.
        flag = state_path("open-browser")
        deadline = time.time() + timeout
        while time.time() < deadline:
            if os.path.exists(flag):
                try:
                    os.unlink(flag)
                except OSError:
                    pass
                if holder.start_browser():
                    log("sign-in window opened for %s" % backend)
            time.sleep(0.4)

    if browser_stack_available():
        threading.Thread(target=open_when_asked, daemon=True).start()

    # stdout is the contract for the caller (the ES page reads these).
    print("URL=%s" % url)
    print("ADDRESS=%s" % bare)
    print("PIN=%s" % holder.pin)
    print("NAME=%s" % holder.name)
    print("PROVIDER=%s" % holder.session.provider)
    sys.stdout.flush()

    # The listener is only open while someone is actually signing in.
    timer = threading.Timer(timeout, shutdown)
    timer.daemon = True
    timer.start()
    try:
        server.serve_forever()
    finally:
        timer.cancel()
        server.server_close()
        holder.stop_browser()
        if holder.session and holder.session.proc \
                and holder.session.proc.poll() is None:
            holder.session.proc.send_signal(signal.SIGTERM)

    final = read_state().get("status")
    if final == "signed-in":
        return 0
    write_state(status="failed", error="sign-in did not complete")
    return 1


def main(argv):
    if len(argv) < 2:
        sys.stderr.write(
            "usage: cloud_oauth serve <backend> [--name NAME] "
            "[--label 'Dropbox'] [--port N] [--timeout SECONDS]\n"
            "       cloud_oauth url | info | status | open | cancel\n")
        return 1

    command = argv[1]

    if command == "serve":
        if len(argv) < 3:
            return main([argv[0]])
        backend = argv[2]
        name, label, port, timeout = None, None, 8080, 600
        rest = argv[3:]
        for i, arg in enumerate(rest):
            if arg == "--name" and i + 1 < len(rest):
                name = rest[i + 1]
            elif arg == "--label" and i + 1 < len(rest):
                label = rest[i + 1]
            elif arg == "--port" and i + 1 < len(rest):
                port = int(rest[i + 1])
            elif arg == "--timeout" and i + 1 < len(rest):
                timeout = int(rest[i + 1])
        return cmd_serve(backend, name, label, port, timeout)

    if command == "url":
        print(read_state().get("url", ""))
        return 0

    if command == "open":
        # Asked for by the handheld once the player has had a chance to read
        # the address and scan the code.
        os.makedirs(STATE_DIR, exist_ok=True)
        open(state_path("open-browser"), "w").close()
        return 0

    if command == "info":
        # One KEY=VALUE per line. `url` stays exactly as it was: the ES page
        # reads whichever of the two the running image provides, so an older
        # script and a newer page still agree on something.
        state = read_state()
        state["on_device"] = "yes" if browser_stack_available() else "no"
        for key in ("url", "address", "pin", "name", "provider", "status",
                    "on_device"):
            print("%s=%s" % (key.upper(), state.get(key, "")))
        return 0

    if command == "status":
        print(read_state().get("status", "idle"))
        return 0

    if command == "cancel":
        stop_other_serves()
        subprocess.run(["pkill", "-f", "rclone authorize"], capture_output=True)
        # Clears the address, PIN and provider link as well as the status --
        # a dead session's details are not something to leave lying in
        # /var/run for the next page to pick up and display.
        reset_state(status="idle")
        return 0

    return main([argv[0]])


