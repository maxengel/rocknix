    "dropbox": "Dropbox", "gcs": "Google Cloud Storage",
    "gphotos": "Google Photos", "hidrive": "HiDrive", "jottacloud": "Jottacloud",
    "mailru": "Mail.ru Cloud", "onedrive": "Microsoft OneDrive",
