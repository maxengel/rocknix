SIGNIN_WINDOW = "/usr/bin/cloud-signin-window"
WAYVNC = "/usr/bin/wayvnc"
SWAY = "/usr/bin/sway"
NOVNC_ROOT = "/usr/share/novnc"
WL_RUNTIME = "/var/run/cloud_oauth/wl"
WL_DISPLAY = "cloud-signin"
VNC_PORT = 5900


def browser_stack_available():
    """Whether this image can run the sign-in page on the device itself."""
    return (all(os.path.exists(p) for p in (SIGNIN_WINDOW, WAYVNC, SWAY))
            and os.path.isdir(NOVNC_ROOT))


class BrowserSession:
    """A sign-in page running here, driven from the player's phone.

    The provider redirects to http://localhost:<port>, which resolves on
    whichever machine runs the browser. Running it here is what puts that
    redirect in reach of rclone's authorize listener; mirroring it to a phone
    is what makes it typeable, because a d-pad and an on-screen keyboard are
    not a way to enter an email address and a password.

    Three processes, in order: a headless sway (no DRM, so EmulationStation
    keeps the actual screen), the window itself, and wayvnc serving the whole
    thing over a websocket that noVNC in the phone's browser can speak.
    """

    def __init__(self, url, host):
        self.url = url
        self.host = host
        self.procs = []
        self.error = None

    def _env(self):
        env = dict(os.environ)
        env.update({
            "XDG_RUNTIME_DIR": WL_RUNTIME,
            "WAYLAND_DISPLAY": WL_DISPLAY,
            "WLR_BACKENDS": "headless",
            "WLR_LIBINPUT_NO_DEVICES": "1",
            "GDK_BACKEND": "wayland",
        })
        # No seat, no session: this compositor never touches input hardware
        # or KMS, so it must not try to take them.
        env.pop("XDG_SEAT", None)
        return env

    def start(self):
        os.makedirs(WL_RUNTIME, mode=0o700, exist_ok=True)
        config = os.path.join(WL_RUNTIME, "sway.conf")
        with open(config, "w") as handle:
            handle.write(
                "output HEADLESS-1 resolution 720x1280\n"
                "default_border none\n"
                "exec %s %s %s\n"
                % (SIGNIN_WINDOW, shlex.quote(self.url), shlex.quote(self.host)))

        env = self._env()
        self.procs.append(subprocess.Popen(
            [SWAY, "-c", config], env=env,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))

        socket_path = os.path.join(WL_RUNTIME, WL_DISPLAY)
        deadline = time.time() + 20
        while time.time() < deadline and not os.path.exists(socket_path):
            time.sleep(0.25)
        if not os.path.exists(socket_path):
            self.error = "the sign-in window did not start"
            self.stop()
            return False

        # 127.0.0.1, never the LAN. An open VNC port with a provider's
        # sign-in page on it would be a worse hole than the one this whole
        # design exists to close -- anyone on the wifi could watch the
        # password being typed, or type into it themselves. The phone reaches
        # it through /vnc on the PIN-gated server below, which is one
        # credential for the whole flow rather than a second one to invent,
        # distribute and get wrong.
        #
        # Plain RFB, not --websocket: neatvnc only compiles its WebSocket
        # transport against nettle, and nettle 4.0 moved the API out from
        # under neatvnc 1.0.1 (there is no newer release). The bridge below
        # does the framing instead, which is a well-specified transformation
        # rather than crypto to get wrong.
        self.procs.append(subprocess.Popen(
            [WAYVNC, "127.0.0.1", str(VNC_PORT)], env=env,
            stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL))
        log("sign-in window running for %s" % self.host)
        return True

    def stop(self):
        for proc in reversed(self.procs):
            if proc.poll() is None:
                proc.terminate()
        for proc in reversed(self.procs):
            try:
                proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                proc.kill()
        self.procs = []


