# Typing an address into a phone is the fallback for a phone that cannot
# scan, and it has to stay short enough to type -- so the PIN is asked for
# here rather than carried in the address. Scanning the QR still skips this,
# because the QR encodes the PIN.
PIN_PAGE = """<!doctype html><meta name=viewport content="width=device-width,initial-scale=1">
<title>ROCKNIX cloud sign-in</title>
<style>
body{font:16px/1.5 system-ui,sans-serif;margin:0;padding:24px;background:#111;color:#eee}
.card{max-width:34rem;margin:0 auto}
h1{font-size:1.3rem;margin:0 0 1rem}
input{width:100%%;padding:12px;font-size:20px;letter-spacing:.3em;text-align:center;
      border-radius:8px;border:1px solid #555;background:#1c1c1c;color:#eee;
      box-sizing:border-box}
button{margin-top:12px;padding:12px 20px;font-size:16px;border-radius:8px;
       border:0;background:#4af;color:#000;font-weight:600}
.note{color:#aaa;font-size:.9rem}
.err{background:#722;padding:10px;border-radius:8px;margin:1rem 0}
</style>
<div class=card>
<h1>Enter the code from your handheld</h1>
%(message)s
<form method=get>
<input name=pin inputmode=numeric pattern="[0-9]*" maxlength=4 autofocus
       autocomplete=off placeholder="0000">
<button type=submit>Continue</button>
</form>
<p class=note>The four-digit code is on the handheld screen, beside this
address.</p>
</div>
"""


def make_handler(session, shutdown):
    class Handler(http.server.BaseHTTPRequestHandler):
        def log_message(self, *args):
            pass  # its default writes request lines to stderr

        def _render(self, message="", status=200):
            body = PAGE % {
                "backend": session.backend,
                "provider": session.provider,
                "pin": session.pin,
                "message": message,
            }
            encoded = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)

        def _render_pin(self, message="", status=200):
            body = PIN_PAGE % {"message": message}
            encoded = body.encode()
            self.send_response(status)
            self.send_header("Content-Type", "text/html; charset=utf-8")
            self.send_header("Content-Length", str(len(encoded)))
            self.end_headers()
            self.wfile.write(encoded)

        def _authorised(self, pin):
            # The PIN is shown on the handheld's screen, so answering it means
            # having the device in hand rather than only being on the wifi.
            return secrets.compare_digest(str(pin), session.pin)

        def do_GET(self):
            path = urllib.parse.urlparse(self.path)
            query = urllib.parse.parse_qs(path.query)
            pin = query.get("pin", [""])[0]

            if session.pin_exhausted():
                self.send_error(403, "Too many wrong codes. Start again on "
                                     "the handheld.")
                return

            if self._authorised(pin):
                self._render()
                return

            # No PIN at all is somebody typing the bare address, which is the
            # documented fallback -- ask, do not refuse. A wrong one is either
            # a typo or a guess, and both are answered the same way so neither
            # learns anything the other does not.
            if not pin:
                self._render_pin()
                return

            if session.pin_failed():
                self.send_error(403, "Too many wrong codes. Start again on "
                                     "the handheld.")
                return
            self._render_pin('<div class=err>That code did not match.</div>')

        def do_POST(self):
            length = int(self.headers.get("Content-Length", 0))
            fields = urllib.parse.parse_qs(
                self.rfile.read(length).decode("utf-8", "replace"))
            if session.pin_exhausted() or not self._authorised(
                    fields.get("pin", [""])[0]):
                self.send_error(403, "Enter the code shown on the handheld")
                return

            ok, detail = session.submit(fields.get("code", [""])[0])
            if ok:
                self._render('<div class=ok>Connected. The remote '
                             '<strong>%s</strong> is ready — you can close this '
                             'page and carry on from the handheld.</div>' % detail)
                threading.Timer(1.5, shutdown).start()
            else:
                self._render('<div class=err>%s</div>' % detail)

    return Handler


def cmd_serve(backend, remote_name, port, timeout):
    if not shutil.which("rclone") and not os.path.exists(RCLONE):
        sys.stderr.write("rclone is not installed\n")
        return 2

    session = Session(backend, remote_name, timeout)
    if not session.start():
        sys.stderr.write("%s\n" % session.error)
        write_state(status="failed", error=session.error)
        return 2

    address = lan_address()
    server = http.server.ThreadingHTTPServer(("0.0.0.0", port), None)

    def shutdown():
        threading.Thread(target=server.shutdown, daemon=True).start()

    server.RequestHandlerClass = make_handler(session, shutdown)

    bare = "http://%s:%d" % (address, port)
    url = "%s/?pin=%s" % (bare, session.pin)
    write_state(status="waiting", backend=backend, url=url, address=bare,
                provider=session.provider, pin=session.pin)

    # stdout is the contract for the caller (the ES page reads these).
    print("URL=%s" % url)
    print("ADDRESS=%s" % bare)
    print("PIN=%s" % session.pin)
    print("PROVIDER=%s" % session.provider)
    sys.stdout.flush()

    # The listener is only open while someone is actually signing in.
    timer = threading.Timer(timeout, shutdown)
    timer.daemon = True
    timer.start()
    try:
        server.serve_forever()
    finally:
        timer.cancel()
        server.server_close()
        if session.proc and session.proc.poll() is None:
            session.proc.send_signal(signal.SIGTERM)

    final = read_state().get("status")
    if final == "signed-in":
        return 0
    write_state(status="failed", error="sign-in did not complete")
    return 1


def main(argv):
    if len(argv) < 2:
        sys.stderr.write(
            "usage: cloud_oauth serve <backend> [--name NAME] [--port N] "
            "[--timeout SECONDS]\n"
            "       cloud_oauth url | info | status | cancel\n")
        return 1

    command = argv[1]

    if command == "serve":
        if len(argv) < 3:
            return main([argv[0]])
        backend = argv[2]
        name, port, timeout = None, 8080, 600
        rest = argv[3:]
        for i, arg in enumerate(rest):
            if arg == "--name" and i + 1 < len(rest):
                name = rest[i + 1]
            elif arg == "--port" and i + 1 < len(rest):
                port = int(rest[i + 1])
            elif arg == "--timeout" and i + 1 < len(rest):
                timeout = int(rest[i + 1])
        return cmd_serve(backend, name, port, timeout)

    if command == "url":
        print(read_state().get("url", ""))
        return 0

    if command == "info":
        # One KEY=VALUE per line. `url` stays exactly as it was: the ES page
        # reads whichever of the two the running image provides, so an older
        # script and a newer page still agree on something.
        state = read_state()
        for key in ("url", "address", "pin", "provider", "status"):
            print("%s=%s" % (key.upper(), state.get(key, "")))
        return 0

    if command == "status":
        print(read_state().get("status", "idle"))
        return 0

    if command == "cancel":
        subprocess.run(["pkill", "-f", "rclone authorize"], capture_output=True)
        write_state(status="idle")
        return 0

    return main([argv[0]])


if __name__ == "__main__":
    sys.exit(main(sys.argv))
