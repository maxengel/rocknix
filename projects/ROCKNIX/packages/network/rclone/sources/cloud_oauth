      method: "POST",
      headers: {"Content-Type": "application/x-www-form-urlencoded"},
      body: body + "&pin=" + encodeURIComponent(pin)
    });
  }
  box.addEventListener("input", function () {
    var v = box.value;
    if (!v) return;
    box.value = "";
    send("type=" + encodeURIComponent(v));
  });
  box.addEventListener("keydown", function (e) {
    var named = {Enter: "enter", Backspace: "backspace", Tab: "tab"}[e.key];
    if (named) { e.preventDefault(); send("key=" + named); }
  });
  Array.prototype.forEach.call(document.querySelectorAll("[data-key]"), function (b) {
    b.addEventListener("click", function () { send("key=" + b.dataset.key); box.focus(); });
