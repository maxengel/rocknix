def display_name(backend, label=None):
    # Our curated name wins where we have one: rclone's descriptions are
    # written for its documentation ("Google Cloud Storage (this is not Google
    # Drive)"), which is accurate and wrong as a page heading. The passed
    # label -- rclone's description, by way of the handheld's menu -- covers
    # everything else, and title-casing covers a backend reached from a shell.
    if backend in DISPLAY_NAMES:
        return DISPLAY_NAMES[backend]
    if label:
        return label
    return backend.replace("_", " ").title()


