# cloud_setup - configure the rclone cloud remote from a phone or computer.
#
# Serves rclone's own web configuration GUI from the handheld and shows a
# QR code pointing at it, so the remote can be set up without SSH. OAuth
# providers additionally require the `rclone authorize` token paste the GUI
# walks through (rclone's OAuth callback is fixed to localhost:53682, so a
# phone browser cannot complete that hop directly - see
# https://rclone.org/remote_setup/).

. /etc/profile

SCRIPT_NAME=$(basename "$0")
LOG_FILE="/var/log/cloud_sync.log"
RC_PORT=5572

log_message() {
    local message="$1"
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    echo "[${timestamp}] [INFO] [${SCRIPT_NAME}] ${message}" >> ${LOG_FILE}
}

# Wait for any confirm/cancel input: controller (evtest) or keyboard.
wait_for_button() {
    local input_device=""
    for dev in /dev/input/event*; do
        if [ -c "$dev" ]; then
            local supports=$(udevadm info "$dev" 2>/dev/null | awk '/ID_INPUT_JOYSTICK=1/ {print "joystick"}')
            if [ "$supports" = "joystick" ]; then
                input_device="$dev"
                break
            fi
        fi
    done
    if [ -n "$input_device" ]; then
        evtest "$input_device" 2>/dev/null | grep -m 1 -E "BTN_(SOUTH|EAST|A|B|START).*value 1" >/dev/null
    else
        read -sn1 2>/dev/null
    fi
}

cleanup() {
    if [ -n "${RCD_PID}" ] && kill -0 "${RCD_PID}" 2>/dev/null; then
        kill "${RCD_PID}" 2>/dev/null
        wait "${RCD_PID}" 2>/dev/null
    fi
    log_message "Cloud setup web GUI stopped"
}
trap cleanup EXIT

clear

# Need a network address to serve the GUI on
IP_ADDR=$(ip route get 1 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i=="src") {print $(i+1); exit}}')
if [ -z "${IP_ADDR}" ]; then
    echo -e "\e[31mNo network connection detected.\e[0m"
    echo "Connect to a network first, then try again."
    echo
    echo "Press any button to exit."
    wait_for_button
    exit 1
fi

# Short random password for this session only
RC_PASS=$(tr -dc 'a-z0-9' </dev/urandom 2>/dev/null | head -c 8)
[ -z "${RC_PASS}" ] && RC_PASS="rocknix${RANDOM}"
RC_URL="http://${IP_ADDR}:${RC_PORT}"

log_message "Starting rclone web config GUI on ${RC_URL}"

# rclone downloads and caches the web GUI on first use
rclone rcd \
    --rc-web-gui \
    --rc-web-gui-no-open-browser \
    --rc-addr ":${RC_PORT}" \
    --rc-user rocknix \
    --rc-pass "${RC_PASS}" \
    --log-file "${LOG_FILE}" \
    --log-level INFO \
    >/dev/null 2>&1 &
RCD_PID=$!

# rclone logs a login_token URL for its GUI; harvest the token so the QR
# code logs the visitor straight in (works for phones and computers alike).
LOGIN_TOKEN=""
for _try in $(seq 1 10); do
    LOGIN_TOKEN=$(grep -o 'login_token=[A-Za-z0-9_%=-]*' "${LOG_FILE}" 2>/dev/null | tail -1 | cut -d= -f2-)
    [ -n "${LOGIN_TOKEN}" ] && break
    sleep 1
done
# Optional advertised-address override: when the device is reached through a
# gateway that remaps its address (development setups, tunnels, proxies), a
# URL placed in this file is shown and encoded instead of the local address.
ADVERTISE_FILE="/storage/.config/cloud_setup_url"
if [ -s "${ADVERTISE_FILE}" ]; then
    RC_URL=$(head -n1 "${ADVERTISE_FILE}")
    log_message "Using advertised address override: ${RC_URL}"
fi

if [ -n "${LOGIN_TOKEN}" ]; then
    QR_URL="${RC_URL}/?login_token=${LOGIN_TOKEN}"
else
    QR_URL="${RC_URL}"
fi

if ! kill -0 "${RCD_PID}" 2>/dev/null; then
    echo -e "\e[31mFailed to start the rclone configuration service.\e[0m"
    echo "See ${LOG_FILE} for details. (First use needs internet access"
    echo "to download rclone's web interface.)"
    echo
    echo "Press any button to exit."
    wait_for_button
    exit 1
fi

echo -e "\e[32m=> ${OS_NAME:-ROCKNIX} CLOUD SETUP\e[0m"
echo
echo "Scan the QR code with your phone to set up your cloud remote."
echo "The QR code signs you in automatically. (Any device with a browser"
echo "on your network can also open the address below.)"
echo
qrencode -t ANSIUTF8 -m 2 "${QR_URL}"
echo
echo -e "  Address:  \e[36m${RC_URL}\e[0m"
echo -e "  Username: \e[36mrocknix\e[0m"
echo -e "  Password: \e[36m${RC_PASS}\e[0m"
echo
echo "On your phone: Configs > New Config, pick your provider and follow"
echo "the steps. Some providers (Google Drive, OneDrive, Dropbox...) ask"
echo "for a token; that step needs rclone on a computer:"
echo "  rclone authorize \"<provider>\""
echo
echo "Press any button here when you are done."

wait_for_button

echo
if rclone listremotes 2>/dev/null | grep -q .; then
    echo -e "\e[32mCloud remote configured: $(rclone listremotes | head -1)\e[0m"
    log_message "Cloud setup finished; first remote: $(rclone listremotes | head -1)"
else
    echo -e "\e[33mNo cloud remote configured yet.\e[0m"
    log_message "Cloud setup finished with no remotes configured"
fi
sleep 3
exit 0
