# Script configuration and global variables
SCRIPT_NAME=$(basename "$0")
LOG_FILE="/var/log/cloud_sync.log"
START_TIME=$(date +%s)

# The exit that means "nothing ran: another cloud sync holds the lock", which
# EmulationStation names (SKIPPED - ANOTHER CLOUD SYNC IS RUNNING). It was 3
# until 2026-09-09 -- and rclone's own 3 is "directory not found", so a
# restore whose saves phase met a cloud with no Saves folder yet carried
# rclone's code to the final exit and the page said a sync was running (#99,
# blindspot 33). sysexits.h's EX_TEMPFAIL sits above everything rclone
# returns (0-9) and below the 128+signal range, so nothing this script
# forwards can produce it. The no-network exit is 69 (EX_UNAVAILABLE) by the
# same rule -- raised by check_network_link before a run and by
# network_lost_during_run after a failed one, as in cloud_backup;
# EmulationStation reads both, and scripts and ES ship in one image.
readonly EXIT_LOCK_HELD=75 EXIT_NO_NETWORK=69

# The bound on a reachability probe: one attempt, 10 s to connect, 20 s in
# all. Tighter than the transfers' bound below, because a probe is a single
# listing whose whole point is to answer quickly. Used by check_internet and
# by network_lost_during_run after a failure.
readonly -a RCLONE_PROBE_OPTS=(--contimeout 10s --timeout 20s --low-level-retries 1 --retries 1)

# What bounds every other rclone command this script runs against the cloud
# -- the transfers, the listings, the archive download. The value is
# RCLONE_NET_OPTS in cloud_sync.conf (the reasoning for the numbers is
# beside it in cloud_sync.conf.defaults), seeded there by cloud_sync_helper;
# load_config turns it into RCLONE_NET_OPTS_ARRAY. This is the same value
# for a config the helper has not reached -- the helper binary missing, the
# line blanked -- so the bound holds on the first run after an update too.
# Until 2026-09-09 only the probe was bounded and every transfer ran on
# rclone's defaults: a 60 s connect timeout, a 5 min idle timeout, 10
# low-level retries, 3 whole-run retries. A link that dropped mid-run held
# the process for over ten minutes, and on the RG SP that froze the startup
# card at 113/113 with the launch gate held (#101, #102, #103). Keep the two
# values in step.
RCLONE_NET_OPTS_FALLBACK="--contimeout 15s --timeout 30s --low-level-retries 2 --retries 1"
RCLONE_NET_OPTS_ARRAY=()

# Non-interactive support for hooks and the ES menu:
#   --yes / -y   answer prompts automatically (headless mode)
#   --method=X   override the configured transfer method (sync or copy)
#   --update     add rclone --update (skip files newer on the destination)
ASSUME_YES=0
METHOD_OVERRIDE=""
EXTRA_UPDATE=0
SYSTEM_ONLY=0
SAVES_ONLY=0
for CLI_ARG in "$@"; do
    case "${CLI_ARG}" in
        --yes|-y) ASSUME_YES=1 ;;
        --method=sync|--method=copy) METHOD_OVERRIDE="${CLI_ARG#--method=}" ;;
        --method=*) echo "Ignoring invalid --method value: ${CLI_ARG#--method=}" ;;
        --update) EXTRA_UPDATE=1 ;;
        --system-only) SYSTEM_ONLY=1 ;;
        --saves-only) SAVES_ONLY=1 ;;
    esac
done

# Logging function that supports different severity levels and optional console output
# Parameters:
#   $1: Message text
#   $2: Whether to echo to screen (true/false, defaults to true)
#   $3: Log level (INFO, WARN, ERROR, defaults to configured LOG_LEVEL or INFO)
log_message() {
    local message="$1"
    local echo_to_screen="${2:-true}"  # Default to true
    local level="${3:-${LOG_LEVEL:-INFO}}"  # Use configured LOG_LEVEL as default
    local timestamp=$(date "+%Y-%m-%d %H:%M:%S")
    
    echo "[${timestamp}] [${level}] [${SCRIPT_NAME}] ${message}" >> ${LOG_FILE}
    
    if [[ "${echo_to_screen}" == "true" ]]; then
        # Color output based on level
        case "${level}" in
            ERROR) echo -e "\e[31m${message}\e[0m" ;;
            WARN)  echo -e "\e[33m${message}\e[0m" ;;
            *)     echo -e "${message}" ;;
        esac
    fi
}

# One cloud transfer at a time, whoever asked for it.
#
# Three callers can start one: EmulationStation at boot (the startup sync,
# which ran headless from autostart/102-cloud-saves until #94), EmulationStation
# after a game exits, and a person in the menu. Until
# 2026-09-04 the game-exit path was an OS hook with a pgrep guard; moving it
# into ES kept the visible progress and dropped the guard, so exiting a game
# during the boot sync started a second rclone against the same remote. Two
# writers on one folder is how a mirror deleted another handheld's saves
# (D-CLOUD-014); two copies racing is milder, and still nothing anybody asked
# for.
#
# The lock lives here, in the script, so no caller has to know about the
# others. /var/run is tmpfs, so a lock cannot survive a reboot and go stale.
# Non-blocking, because a request that queues silently behind a twenty-minute
# transfer looks exactly like one that hung. Exit EXIT_LOCK_HELD (75) means
# "skipped: another sync is running" -- the UI names it, and no last-run stamp
# is written for work that did not happen.
CLOUD_SYNC_LOCK=/var/run/cloud_sync.lock
take_cloud_lock() {
    exec 9>"${CLOUD_SYNC_LOCK}"
    if ! flock -n 9; then
        echo "Another cloud sync is already running. Skipped."
        log_message "skipped: another cloud sync holds ${CLOUD_SYNC_LOCK}" "false"
        exit "${EXIT_LOCK_HELD}"
    fi
}

# Exit EXIT_NO_NETWORK (69) means "skipped: no network". Answered locally,
# before any remote probe: with no default route there is nothing to restore
# from, and nobody should wait for rclone to time out learning that. `ip
# route` reads the kernel's table and sends nothing. The same test, the same
# code and the same "no stamp, nothing ran" as cloud_backup's; until
# 2026-09-09 this script had no such step and an offline restore reached
# check_internet, which exited 1 -- FAILED on the card, for a device that
# was simply not connected.
has_default_route() {
    ip -4 route show default 2>/dev/null | grep -q . \
        || ip -6 route show default 2>/dev/null | grep -q .
}

check_network_link() {
    if ! has_default_route; then
        echo "No network connection. Skipped."
        log_message "skipped: no default route, nothing to restore from" "false"
        exit "${EXIT_NO_NETWORK}"
    fi
}

# Load controller configuration if available
if [ -f "/storage/.config/profile.d/098-controller" ]; then
    source /storage/.config/profile.d/098-controller
    log_message "Controller config loaded: SOUTH=${DEVICE_BTN_SOUTH}, DPAD_UP=${DEVICE_BTN_DPAD_UP}" "false"
fi

# Simple controller input function using evtest for actual joystick input
# Improved controller input: persistent evtest for low-latency input
read_controller_input() {
    local timeout="${1:-0}" # Default to no timeout
    local input_device=""
    for dev in /dev/input/event*; do
        if [ -c "$dev" ]; then
            local supports=$(udevadm info "$dev" 2>/dev/null | awk '/ID_INPUT_JOYSTICK=1/ {print "joystick"}')
            if [ "$supports" = "joystick" ]; then
                input_device="$dev"
                break
            fi
        fi
    done
    if [ -z "$input_device" ]; then
        # Fallback to keyboard input if no controller is found
        if [ "$timeout" -gt 0 ]; then
            read -t "$timeout" -sn1 input 2>/dev/null
        else
            read -sn1 input 2>/dev/null
        fi
        case "$input" in
            "w"|"W"|$'\e[A') echo "up" ;;
            "s"|"S"|$'\e[B') echo "down" ;;
            "a"|"A"|$'\e[D') echo "left" ;;
            "d"|"D"|$'\e[C') echo "right" ;;
            $'\n'|" ")       echo "confirm" ;;
            "q"|"Q"|$'\e')   echo "cancel" ;;
            "") echo "timeout" ;;
            *) echo "unknown" ;;
        esac
        return
    fi
    
    # For controllers, block and wait for the first button press event.
    # This is more responsive than polling with a timeout.
    local event_output
    if [ "$timeout" -gt 0 ]; then
        event_output=$(timeout "$timeout" evtest "$input_device" 2>/dev/null | grep -m 1 "value 1")
    else
        event_output=$(evtest "$input_device" 2>/dev/null | grep -m 1 "value 1")
    fi
    
    if [ -z "$event_output" ]; then
        echo "timeout"
        return
    fi
    
    # Parse the first button press event found
    log_message "Raw event data: $event_output" "false"
    if [[ "$event_output" =~ BTN_DPAD_UP.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0Y.*value[[:space:]]+-1 ]]; then
        echo "up"
    elif [[ "$event_output" =~ BTN_DPAD_DOWN.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0Y.*value[[:space:]]+1 ]]; then
        echo "down"
    elif [[ "$event_output" =~ BTN_DPAD_LEFT.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0X.*value[[:space:]]+-1 ]]; then
        echo "left"
    elif [[ "$event_output" =~ BTN_DPAD_RIGHT.*value[[:space:]]+1 ]] || [[ "$event_output" =~ ABS_HAT0X.*value[[:space:]]+1 ]]; then
        echo "right"
    elif [[ "$event_output" =~ BTN_SOUTH.*value[[:space:]]+1 ]] || [[ "$event_output" =~ BTN_A.*value[[:space:]]+1 ]] || [[ "$event_output" =~ BTN_EAST.*value[[:space:]]+1 ]]; then
        echo "confirm"
    elif [[ "$event_output" =~ BTN_B.*value[[:space:]]+1 ]]; then
        echo "cancel"
    elif [[ "$event_output" =~ BTN_START.*value[[:space:]]+1 ]]; then
        echo "start"
    elif [[ "$event_output" =~ BTN_SELECT.*value[[:space:]]+1 ]]; then
        echo "select"
    else
        log_message "Unrecognized button event: $event_output" "false"
        echo "unknown"
    fi
}

# Simple controller-friendly confirmation using the same pattern as other ROCKNIX scripts
# Parameters: $1=message, $2=initial_selection (0=yes, 1=no, defaults to 0)
controller_confirm() {
    local message="$1"
    local selected="${2:-0}"         # Default to Yes initially selected
    local options=("Yes" "No")
    local last_selected=-1
    log_message "Starting controller_confirm with message: '$message', initial: $selected" "false"
    
    while true; do
        # Only redraw if selection changed
        if [ $selected -ne $last_selected ]; then
            printf "\033[2J\033[H"  # Clear screen and move to top
            echo -e "\e[33m${message}\e[0m"
            echo ""
            for i in "${!options[@]}"; do
                if [ $i -eq $selected ]; then
                    echo -e "\e[34m> \e[32m${options[$i]}\e[0m"
                else
                    echo "  ${options[$i]}"
                fi
            done
            echo ""
            echo "Controls: D-Pad Up/Down=Navigate, A=Confirm, B=Cancel"
            echo "Keyboard: W/S=Navigate, Enter=Confirm, Q=Cancel"
            echo ""
            last_selected=$selected
        fi
        
        local input=$(read_controller_input)
        log_message "Received input: '$input'" "false"
        case "$input" in
            "up")
                selected=$(( (selected - 1 + 2) % 2 ))
                log_message "Selection changed to: $selected (moved up)" "false"
                ;;
            "down")
                selected=$(( (selected + 1) % 2 ))
                log_message "Selection changed to: $selected (moved down)" "false"
                ;;
            "confirm")
                log_message "Confirmed with selection: $selected" "false"
                sleep 0.3
                return $selected
                ;;
            "cancel")
                log_message "Cancelled" "false"
                return 1
                ;;
            "timeout")
                # Continue waiting for input
                ;;
            *)
                log_message "Unknown input received: '$input'" "false"
                ;;
        esac
        sleep 0.05
    done
}

# Get available input devices for controller monitoring
get_controller_devices() {
    INPUT_DEVICES=()
    for DEV in /dev/input/event*; do
        unset SUPPORTS
        SUPPORTS=$(udevadm info ${DEV} | awk '/ID_INPUT_KEY=|ID_INPUT_JOYSTICK=/ {print $2}')
        if [ -n "${SUPPORTS}" ]; then
            DEVICE=$(udevadm info ${DEV} | awk 'BEGIN {FS="="} /DEVNAME=/ {print $2}')
            if [[ "${SUPPORTS}" =~ ID_INPUT_JOYSTICK ]]; then
                INPUT_DEVICES+=("${DEVICE}")
            fi
        fi
    done
}

# Controller-friendly menu with evtest-based input handling
# Parameters: $1=title, $@=options
controller_menu() {
    local title="$1"
    shift
    local options=("$@")
    local selected=0
    local choice_made=false
    local user_choice=""
    
    get_controller_devices
    
    while [ "$choice_made" = false ]; do
        # Display menu
        clear
        echo -e "\e[36m${title}\e[0m"
        echo "Use D-Pad to navigate, A button to confirm, B button to cancel"
        echo ""
        
        for i in "${!options[@]}"; do
            if [ $i -eq $selected ]; then
                echo -e "> \e[32m${options[$i]}\e[0m"
            else
                echo "  ${options[$i]}"
            fi
        done
        echo ""
        echo "Controls: D-Pad=Navigate, A=Confirm, B=Cancel"
        
        # Monitor controller input with timeout
        (
            for INPUT_DEVICE in ${INPUT_DEVICES[@]}; do
                timeout 1 evtest "${INPUT_DEVICE}" 2>&1 &
            done
            wait
        ) | while read line; do
            case ${line} in
                (${UP_EVENT}|${UP_ALT_EVENT})
                    selected=$(( (selected - 1 + ${#options[@]}) % ${#options[@]} ))
                    break
                ;;
                (${DOWN_EVENT}|${DOWN_ALT_EVENT})
                    selected=$(( (selected + 1) % ${#options[@]} ))
                    break
                ;;
                (${CONFIRM_EVENT})
                    user_choice="${options[$selected]}"
                    choice_made=true
                    break
                ;;
                (${CANCEL_EVENT})
                    user_choice=""
                    choice_made=true
                    break
                ;;
            esac
        done
        
        # Small delay to prevent rapid menu updates
        sleep 0.1
    done
    
    echo "$user_choice"
}

# Somebody who starts a restore and walks away has no way to learn how it went:
# the progress card is gone by the time they come back, and the toast that
# reported the outcome went with it. Leave the answer where the menu can read
# it later.
#
# Device-local state, so it lives under /storage/.cache rather than
# /storage/.config -- a stamp swept into the settings backup and restored onto
# a second device would be describing a run that device never made.
record_last_run() {
    local exit_code="$1"
    local name="restore"
    [ "${SYSTEM_ONLY}" -eq 1 ] && name="settings-restore"
    mkdir -p /storage/.cache/cloud_sync 2>/dev/null
    printf '%s %s\n' "$(date +%s)" "${exit_code}" \
        > "/storage/.cache/cloud_sync/last-${name}" 2>/dev/null
}

# Performs cleanup operations and exits with the specified code
# Records total execution time in the log for performance tracking
# Parameters:
#   $1: Exit code to return
clean_exit() {
    local exit_code=$1
    local duration=$(($(date +%s) - START_TIME))
    
    # A failed phase leaves with the code the phase gave -- rclone's, when a
    # transfer failed -- unremapped. Nothing rclone returns can read as the
    # lock or no-network sentinel now that those are 75 and 69 (#99).
    record_last_run "${exit_code}"
    log_message "Script completed in ${duration} seconds with exit code ${exit_code}" "false"
    exit ${exit_code}
}

# Verifies rclone is properly configured before attempting operations
# Exits with error if configuration file is missing
check_rclone_config() {
    if [ ! -e "/storage/.config/rclone/rclone.conf" ]; then
        log_message "You must configure rclone before using this tool. Run \`rclone config\` to get started." "true" "ERROR"
        sleep 3
        clean_exit 1
    fi
}

# What has to be reachable is the configured cloud storage, not the internet at
# large. Pinging google.com gets both answers wrong: it fails on a setup that
# works fine - a self-hosted or LAN remote needs no internet, and that host is
# unreachable on some networks outright - and it succeeds while the user's
# provider is down or their sign-in has expired. Test the remote itself, and
# probe further only to word the failure correctly, because the two causes have
# different fixes.
check_internet() {
    log_message "Checking cloud storage reachability..." "false"

    local remote
    remote=$(rclone listremotes 2>/dev/null | head -1)
    if [ -n "${remote}" ] && rclone lsd "${remote}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1; then
        log_message "Cloud storage ${remote} is reachable" "false"
        return 0
    fi

    if ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1; then
        log_message "Your cloud storage did not respond.\nCheck that it is still set up and that its sign-in has not expired." "true" "ERROR"
        sleep 3
        clean_exit 1
    fi
    # A route with nothing behind it -- Wi-Fi associated to an access point
    # whose uplink is down, or a link that has already gone quiet -- is no
    # network, the same answer check_network_link gives when there is no
    # route at all, and with the same code: EmulationStation shows SKIPPED -
    # NO NETWORK CONNECTION for it, where a 1 read as FAILED and sent
    # somebody to a log to learn that nothing had gone wrong. Nothing has
    # run yet, so no stamp, as for the other sentinel exits.
    log_message "You're not currently connected to the internet.\nPlease verify your settings and then try again." "true" "ERROR"
    log_message "skipped: no network -- the remote and the internet both unreachable before the run" "false"
    sleep 3
    exit "${EXIT_NO_NETWORK}"
}

# Why did rclone fail? Asked after a transfer or a listing came back
# non-zero, with rclone's code and the phase's name. The same function as
# cloud_backup's, for the same reason (#101: the RG SP left the LAN a minute
# into its startup sync, and the restore half is the first thing that sync
# runs). Told apart the way check_internet tells them apart before a run:
# is there a default route, does the remote answer a bounded probe now, does
# anything at all.
#
# The network gone -- no route, or a route nothing gets through -- ends the
# run with EXIT_NO_NETWORK (69), which EmulationStation names on the card
# and on the row (SKIPPED - NO NETWORK CONNECTION). Through clean_exit, so
# the stamp records a run that did not complete: never 0, and not rclone's
# code, because "no network" is the true answer and the one the player can
# act on. No second phase is attempted -- it would stall for another minute
# against the same dead link.
#
# Anything else is rclone's failure to report, and the caller passes
# rclone's own code through unchanged as it always did: the remote answers
# again (a blip rclone did not survive), or the internet answers and the
# remote does not (the provider, or the sign-in) -- neither is "no network",
# and saying so would be the phantom sentinel #99 removed.
network_lost_during_run() {
    local rc="$1" what="$2"
    if ! has_default_route; then
        log_message "The network went away during ${what} (rclone exit ${rc}): no default route now." "true" "ERROR"
        clean_exit "${EXIT_NO_NETWORK}"
    fi
    if rclone lsd "${REMOTENAME}" "${RCLONE_PROBE_OPTS[@]}" >/dev/null 2>&1; then
        log_message "${what} failed (rclone exit ${rc}) but ${REMOTENAME} answers now; reporting rclone's own result" "false"
        return 0
    fi
    if ping -q -c1 -W 3 1.1.1.1 >/dev/null 2>&1 || ping -q -c1 -W 3 8.8.8.8 >/dev/null 2>&1; then
        log_message "Your cloud storage stopped responding during ${what} (rclone exit ${rc}).\nCheck that it is still set up and that its sign-in has not expired." "true" "ERROR"
        return 0
    fi
    log_message "The network went away during ${what} (rclone exit ${rc}): nothing answers now." "true" "ERROR"
    clean_exit "${EXIT_NO_NETWORK}"
}

# Loads user configuration from cloud_sync.conf
# Applies default values for any missing configuration parameters
load_config() {
    # The helper first: it carries renamed keys across (D-UI-022) and appends
    # new defaults, and the values sourced below must be the migrated ones.
    if [ -f "/usr/bin/cloud_sync_helper" ]; then
        log_message "Updating cloud sync rules and config" "false"
        /usr/bin/cloud_sync_helper ${LOG_FILE}
    fi
    log_message "Loading configuration from cloud_sync.conf" "false"
    source /storage/.config/cloud_sync.conf

    # Saves have one local folder (D-CLOUD-040). RESTOREPATH used to let a
    # restore land somewhere other than the live saves -- a safety valve from
    # when restore was a mirror. A config still pointing it elsewhere would
    # give the saves tier two local trees, so every saves transfer refuses
    # until the setting is removed. The helper has already logged it.
    if [ -n "${RESTOREPATH:-}" ] && [ "${RESTOREPATH%/}" != "${SAVESPATH%/}" ]; then
        log_message "RESTOREPATH (${RESTOREPATH}) differs from SAVESPATH (${SAVESPATH}). Saves have one local folder now; remove RESTOREPATH from cloud_sync.conf." "true" "ERROR"
        clean_exit 1
    fi

    # Check for duplicate variable assignments in config
    local conf_file="/storage/.config/cloud_sync.conf"
    local dupes_found=0
    # List of variable names that appear more than once
    mapfile -t duplicate_vars < <(awk -F= '/^[A-Za-z0-9_]+=/{gsub(/"/,"",$1); count[$1]++} END{for (v in count) if(count[v]>1) print v}' "$conf_file")
    if [ ${#duplicate_vars[@]} -gt 0 ]; then
        dupes_found=1
    fi

    if [ $dupes_found -eq 1 ]; then
        # Build the full message including the duplicate info
        local dupe_message="Warning: Duplicate variable assignments detected in cloud_sync.conf\n\nDuplicate cloud sync variables have been found in the configuration file:"
        for var in "${duplicate_vars[@]}"; do
            dupe_message="${dupe_message}\n  - $var"
        done
        dupe_message="${dupe_message}\n\nWould you like to automatically clean up duplicates?"
        
        if [ "${ASSUME_YES}" -eq 1 ]; then
            local cleanup_choice=0
        else
            controller_confirm "$dupe_message" 0
            local cleanup_choice=$?
        fi
        log_message "Cleanup choice returned: $cleanup_choice" "false"
        
        if [ $cleanup_choice -eq 0 ]; then
            # User selected Yes - cleanup duplicates
            echo -e "\e[34m> Running duplicate cleanup...\e[0m"
            /usr/bin/cloud_sync_cleanup_duplicates.sh "$conf_file"
            echo -e "\e[34m> Duplicates cleaned.\e[0m"
            echo ""
            sleep 2
            # Reload config after cleanup
            source /storage/.config/cloud_sync.conf
        else
            # User selected No or cancelled - skip cleanup
            echo -e "\e[34m> Skipped duplicate cleanup.\e[0m"
            sleep 2
        fi

    fi

    # Clean and normalize rclone options to ensure proper spacing
    log_message "Original RCLONEOPTS: ${RCLONEOPTS}" "false"
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | tr '\n\\' '  ' | tr -s ' ')
    log_message "After newline cleanup: ${RCLONEOPTS}" "false"
    
    # Remove conflicting --verbose and -v flags that conflict with --log-level
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--verbose//g' | sed 's/-v / /g')
    log_message "After removing verbose flags: ${RCLONEOPTS}" "false"
    
    # Restore writes to local storage. The filter rules are an allowlist, so with
    # RESTOREMETHOD="sync" a --delete-excluded would delete everything local that
    # is not a save/state/screenshot (ROMs, BIOS, artwork). Strip it on restore;
    # backup keeps it, where it only tidies the remote.
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--delete-excluded//g')
    log_message "After removing restore-unsafe delete flags: ${RCLONEOPTS}" "false"
    
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | sed 's/--/ --/g' | sed 's/^ //')
    log_message "After spacing fix: ${RCLONEOPTS}" "false"
    
    # Clean up any double spaces left by removal
    RCLONEOPTS=$(echo "${RCLONEOPTS}" | tr -s ' ')
    log_message "After final cleanup: ${RCLONEOPTS}" "false"
    
    RCLONE_OPTS_ARRAY=()
    for opt in ${RCLONEOPTS}; do
        RCLONE_OPTS_ARRAY+=("$opt")
    done
    log_message "Options array has ${#RCLONE_OPTS_ARRAY[@]} elements" "false"

    # The network bound, as an array like RCLONEOPTS above. It goes on the
    # command line AFTER RCLONEOPTS, so a timeout somebody once put there
    # does not outrank it -- RCLONE_NET_OPTS is where the bound is changed.
    # Empty or unset -- a config the helper has not seeded, a line somebody
    # blanked -- means the shipped values, never rclone's defaults: the bound
    # is a guard, and a guard a missing line switches off is no guard.
    local net_opts
    net_opts=$(echo "${RCLONE_NET_OPTS:-}" | tr '\n\\' '  ' | tr -s ' ' | sed 's/^ //; s/ $//')
    [ -n "${net_opts}" ] || net_opts="${RCLONE_NET_OPTS_FALLBACK}"
    RCLONE_NET_OPTS_ARRAY=()
    for opt in ${net_opts}; do
        RCLONE_NET_OPTS_ARRAY+=("$opt")
    done
    log_message "rclone network bound: ${net_opts}" "false"

    # Apply command-line overrides
    if [ "${SYSTEM_ONLY}" -eq 1 ]; then
        BACKUPFILE_RESTORE_OPTION="yes"
        log_message "System-backup phase forced on by --system-only" "false"
    fi
    if [ -n "${METHOD_OVERRIDE}" ]; then
        RESTOREMETHOD="${METHOD_OVERRIDE}"
        log_message "Transfer method overridden from command line: ${METHOD_OVERRIDE}" "false"
    fi
    if [ "${EXTRA_UPDATE}" -eq 1 ]; then
        RCLONE_OPTS_ARRAY+=("--update")
        log_message "Added --update from command line" "false"
    fi
    log_message "Configuration loaded successfully" "false"
}

# cloud_device_id, beside this script or installed. Beside first, so a copy of
# these scripts staged for a test resolves the helper staged with it; never
# via PATH. Empty when neither exists, and every caller treats empty as "do
# not know" rather than inventing a name.
device_id_tool() {
    local tool
    tool="$(dirname "$(readlink -f "$0")")/cloud_device_id"
    [ -x "${tool}" ] || tool="/usr/bin/cloud_device_id"
    [ -x "${tool}" ] && echo "${tool}"
}

# This device's folder in the cloud. cloud_device_id owns the derivation --
# one implementation, because backup and restore disagreeing here means a
# device cannot find the archive it wrote.
device_folder() {
    local id="" tool
    tool=$(device_id_tool)
    [ -n "${tool}" ] && id=$("${tool}" 2>/dev/null | tr -cd 'A-Za-z0-9_.-')
    [ -z "${id}" ] && id="device-unknown"
    echo "${id}"
}

# What this device's archives are named after. backuptool writes
# <stamp>-<label>-ROCKNIX_SETTINGS.tar.gz with the label cloud_device_id
# derives from the device tree ("Anbernic-RG-SP"), so an archive's name says
# which handheld made it (2026-09-08). Letters, digits, _ and - only, so the
# value is literal inside a regular expression. Empty when the helper is
# missing; the callers then cannot tell this device's archives from another's,
# and say so.
device_label() {
    local tool
    tool=$(device_id_tool)
    [ -n "${tool}" ] && "${tool}" --label 2>/dev/null | tr -cd 'A-Za-z0-9_-'
}

# Does a cloud folder hold a settings archive at its top level? The same
# match the transfer below uses, so a folder this says yes to is one the
# restore can take from. Anything else -- unreachable, absent, only
# subfolders -- is no.
folder_has_archives() {
    rclone lsf "${1}/" --include "/*.{zip,tar.gz}" "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null | grep -q .
}

# The OS name the archive's name ends with. backuptool has OS_NAME from
# /etc/profile; this script is started by systemd and by EmulationStation,
# where no profile has run, so it is read from the file the profile reads it
# from. Never empty, so the pattern built on it always names a whole archive.
os_name() {
    local name="${OS_NAME}"
    [ -z "${name}" ] && name=$(sed -n 's/^OS_NAME="\{0,1\}\([^"]*\)"\{0,1\}$/\1/p' /etc/os-release 2>/dev/null | head -1)
    [ -z "${name}" ] && name="ROCKNIX"
    printf '%s\n' "${name}" | tr -cd 'A-Za-z0-9_-'
}

# Enhanced error reporting function
report_rclone_error() {
    local exit_code=$1
    local operation="$2"
    
    case $exit_code in
        0) log_message "${operation} completed successfully" "true" ;;
        1) log_message "${operation} failed: Syntax or usage error" "true" "ERROR" ;;
        2) log_message "${operation} failed: Error not otherwise categorized" "true" "ERROR" ;;
        3) log_message "${operation} failed: Directory not found or permission denied" "true" "ERROR" ;;
        4) log_message "${operation} failed: File not found" "true" "ERROR" ;;
        5) log_message "${operation} failed: Temporary failure, retry may help" "true" "ERROR" ;;
        6) log_message "${operation} failed: Less serious errors (e.g. partly transferred)" "true" "WARN" ;;
        7) log_message "${operation} failed: Fatal error - rclone giving up" "true" "ERROR" ;;
        8) log_message "${operation} failed: Transfer exceeded - limits exceeded" "true" "ERROR" ;;
        9) log_message "${operation} completed: no files transferred" "true" ;;
        *) log_message "${operation} failed with unknown error code: $exit_code" "true" "ERROR" ;;
    esac
}

# Enhanced rclone execution function with better error handling
execute_rclone_with_error_handling() {
    local method="$1"
    local source="$2"
    local dest="$3"
    shift 3
    local extra_opts=("$@")
    
    log_message "About to execute: rclone ${method} ${extra_opts[*]} ${source} ${dest}" "false"
    
    # Use a temporary file to capture stderr while allowing stdout (progress) to display
    local stderr_file="/tmp/rclone_stderr_$$"
    
    # Execute rclone with real-time progress display
    # stdout goes to terminal (shows progress), stderr goes to temp file for logging
    rclone "${method}" "${extra_opts[@]}" "${RCLONE_NET_OPTS_ARRAY[@]}" "${source}" "${dest}" 2>"$stderr_file"
    local rclone_exit_code=$?
    
    # Log any stderr output for debugging
    if [ -s "$stderr_file" ]; then
        while IFS= read -r line; do
            log_message "rclone stderr: $line" "false"
        done < "$stderr_file"
    fi
    
    # Clean up
    rm -f "$stderr_file"
    
    return $rclone_exit_code
}

# PART 1: Game saves restore function
# Restores game saves from cloud storage
restore_game_saves() {
    log_message "====================================" "true"
    log_message "STARTING GAME SAVES RESTORE" "true"
    echo ">>> unit SAVES||"
    log_message "====================================" "true"
    
    log_message "Starting restore from ${REMOTENAME}${SAVES_REMOTE} to ${SAVESPATH}"
    log_message "Restore started at $(date)" "false"

    # Which card is the saves folder on? (#83; see cloud_backup for the case.)
    # A restore into the wrong card's tree is the copy that later reads as
    # this device's newest save.
    local saves_root_tool saves_root_id=""
    # Installed beside this script (/usr/bin on a device; the same
    # directory wherever a copy of these scripts is run from).
    saves_root_tool="$(dirname "$(readlink -f "$0")")/cloud_saves_root"
    [ -x "${saves_root_tool}" ] || saves_root_tool=/usr/bin/cloud_saves_root
    if [ -x "${saves_root_tool}" ]; then
        # At boot the second card is bound over the saves folder a moment
        # after the interface starts, so a mismatch is given 15 seconds to
        # clear before it is a refusal. check prints the identity it
        # confirmed, or the reason it refused.
        if ! saves_root_id=$("${saves_root_tool}" check --wait 15); then
            log_message "${saves_root_id}" "true" "ERROR"
            return 1
        fi
    fi
    
    # Check if remote path exists before attempting restore
    log_message "Checking if remote path exists: ${REMOTENAME}${SAVES_REMOTE}" "false"
    rclone lsd "${REMOTENAME}${SAVES_REMOTE}" "${RCLONE_NET_OPTS_ARRAY[@]}" > /dev/null 2>&1
    local remote_check_status=$?
    if [ $remote_check_status -ne 0 ]; then
        network_lost_during_run "$remote_check_status" "the saves restore"
        log_message "Remote path ${REMOTENAME}${SAVES_REMOTE} is not accessible (exit code: $remote_check_status)" "true" "ERROR"
        report_rclone_error $remote_check_status "Remote path check"
        return $remote_check_status
    fi
    
    # Ensure local restore path exists
    if [ ! -d "${SAVESPATH}" ]; then
        log_message "Creating local restore path: ${SAVESPATH}" "false"
        mkdir -p "${SAVESPATH}"
    fi
    
    # Pass an explicit --log-level INFO when LOG_LEVEL is INFO
    local rclone_debug=""
    local filtered_opts=("${RCLONE_OPTS_ARRAY[@]}")
    
    # Add debug logging if LOG_LEVEL is INFO
    if [ "${LOG_LEVEL}" == "INFO" ]; then
        rclone_debug="--log-level"
    fi

    # Build the complete options array
    local all_opts=()
    if [ ${#filtered_opts[@]} -gt 0 ]; then
        all_opts+=("${filtered_opts[@]}")
    else
        all_opts+=(
            "--progress"
            "--log-file" "/var/log/cloud_sync.log"
            "--filter-from" "/storage/.config/cloud_sync-rules.txt"
        )
    fi

    # Add debug logging if enabled
    if [ -n "$rclone_debug" ]; then
        all_opts+=("$rclone_debug" "INFO")
    fi

    # Keep the settings-backup archive out of the saves payload -- phase 2 sends it
    # to SETTINGS_REMOTE on its own. rclone matches paths relative to the transfer
    # root, so the two rules that used to sit here never matched anything:
    # "${SETTINGS_BACKUPS}/**" is absolute, and "backups/**" names a directory that
    # does not exist (it is "backup"). Only the blanket "*.zip" was doing the
    # work, and it also overrode any user rule that deliberately included a zip.
    # Derive the pattern from SETTINGS_BACKUPS instead, so it keeps working if the
    # folder is renamed and is simply skipped when it lives outside the payload.
    # --stats-one-line collapses the whole display to a single totals line, so
    # the per-file block goes away -- and the per-file block is the part that
    # says the transfer is alive. A thousand small files spend minutes between
    # percentage changes; the name of the file it is on right now is the only
    # thing that distinguishes working from hung. The status page parses both.
    all_opts+=("--stats" "1s" "--exclude=bios/**")
    local backup_rel="${SETTINGS_BACKUPS#${SAVESPATH%/}/}"
    if [ "${backup_rel}" != "${SETTINGS_BACKUPS}" ]; then
        all_opts+=("--exclude=${backup_rel}/**")
    fi

    # Check if the rclone version supports the terminal width flag
    if rclone help | grep -q progress-terminal-width; then
        all_opts+=("--progress-terminal-width=80")
    fi
    
    # Execute rclone with enhanced error handling
    execute_rclone_with_error_handling \
        "${RESTOREMETHOD}" \
        "${REMOTENAME}${SAVES_REMOTE}/" \
        "${SAVESPATH}/" \
        "${all_opts[@]}"
    
    RESTORE_STATUS=$?
    # A failed transfer says why. The network gone ends the run as 69 here;
    # anything else falls through to report_rclone_error with rclone's code.
    if [ $RESTORE_STATUS -ne 0 ] && [ $RESTORE_STATUS -ne 9 ]; then
        network_lost_during_run "$RESTORE_STATUS" "the saves restore"
    fi
    
    # The card the saves folder is on must still be the one the transfer
    # started on. A bind that landed mid-run means part of the run went to
    # the other card: a failed run, and not one to record. A good run
    # records the card, so the next transfer has something to compare.
    local root_note=""
    if [ -x "${saves_root_tool}" ]; then
        if ! root_note=$("${saves_root_tool}" record "${saves_root_id}"); then
            RESTORE_STATUS=1
        fi
    fi

    # Report the result with detailed error information
    if [ -n "${root_note}" ]; then
        log_message "${root_note}" "true" "ERROR"
    else
        report_rclone_error $RESTORE_STATUS "Game saves restore"
    fi
    
    return $RESTORE_STATUS
}

# PART 2: Settings backup file restore function
# Restores settings backup files from cloud storage
# Only runs when BACKUPFILE_RESTORE_OPTION is set to "yes"
restore_system_files() {
    echo
    log_message "====================================" "true"
    log_message "STARTING SETTINGS BACKUP FILE RESTORE" "true"
    # The transfer page's marker for this phase. The label is the item's
    # name on the page (D-UI-022: settings) -- the word cloud_backup and
    # EmulationStation announce for the same item, so a restore run reads
    # like a backup run (#95). It read SETTINGS BACKUP until then.
    echo ">>> unit SETTINGS||"
    log_message "====================================" "true"
    
    if [ "${BACKUPFILE_RESTORE_OPTION}" == "yes" ]; then
        # Verify remote backup directory has content before attempting restore
        log_message "Checking remote backup directory: ${REMOTENAME}${SETTINGS_REMOTE}" "false"
        REMOTE_FILES=$(rclone ls ${REMOTENAME}${SETTINGS_REMOTE}/ "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null)
        local remote_ls_status=$?
        
        if [ $remote_ls_status -ne 0 ]; then
            network_lost_during_run "$remote_ls_status" "the settings restore"
            log_message "Failed to access remote backup directory (exit code: $remote_ls_status)" "true" "ERROR"
            report_rclone_error $remote_ls_status "Remote backup directory check"
            return $remote_ls_status
        fi
        
        # Nothing to restore is not a failure; see backup_system_files.
        if [ -z "${REMOTE_FILES}" ]; then
            log_message "There are no settings backup files to restore" "true" "WARN"
            return 0
        fi
        
        log_message "Starting restore of settings backup files from ${REMOTENAME}${SETTINGS_REMOTE} to ${SETTINGS_BACKUPS}"
        log_message "Settings backup file restore started at $(date)" "false"
        
        # Ensure local target directory exists before attempting restore
        mkdir -p ${SETTINGS_BACKUPS}
        
        # This transfer's root is SETTINGS_REMOTE, whose contents came from
        # SETTINGS_BACKUPS -- so the archive sits at the root, as "backup-*.zip",
        # not under "backup/". Both includes below named a directory that is not
        # there, and because using --include at all excludes everything it does
        # not match, this restore transferred nothing at all. The saves
        # allowlist was misanchored here for the same reason, and its
        # "- /**/*.zip" would have excluded the archive regardless. Match what
        # backup_system_files actually writes, anchored so it takes the current
        # archive and not anything under a rotated archive/ subdirectory.
        local backup_opts=(
            "--progress"
            "--log-file" "/var/log/cloud_sync.log"
            "--log-level" "INFO"
            "--include" "/*.{zip,tar.gz}"
            "--stats" "1s"
        )
        
        # Always fetch, rather than letting rclone decide by comparison.
        # Given no modification times and no hashes -- which is what a WebDAV
        # remote commonly offers -- it compares by size alone, and two
        # archives of equal size are taken to be the same file. A device that
        # already holds its own ROCKNIX_BACKUP.zip would then keep it and
        # report a successful restore, handing the player their own stale
        # configuration instead of the one they asked for. Fork issue #53.
        #
        # Unlike the backup side, this cannot be settled from a local marker:
        # the authoritative copy is the remote one, and its content is exactly
        # what we cannot see. Restore is an explicit, infrequent action -- it
        # does not run on game exit -- so fetching unconditionally costs one
        # download at the moment someone is already waiting for their data.
        backup_opts+=("--ignore-times")

        # Check if the rclone version supports the terminal width flag
        if rclone help | grep -q progress-terminal-width; then
            backup_opts+=("--progress-terminal-width=80")
        fi
        
        # Read both layouts, and write only the new one (cloud_backup does
        # that). Archives made before per-device folders sit at the root of
        # SETTINGS_REMOTE, and they are still someone's only backup -- a device
        # that upgrades must keep finding them. Nothing is moved or deleted:
        # the root copy may belong to another device that has not updated yet.
        local own_name device_src legacy_src restore_src=""
        own_name=$(device_folder)
        device_src="${REMOTENAME}${SETTINGS_REMOTE}/${own_name}"
        legacy_src="${REMOTENAME}${SETTINGS_REMOTE}"

        # The folder this device would have used before the name became
        # readable. An existing device keeps its stored identity and never
        # moves, but a reflashed one regenerates -- which is the point of
        # seeding from the hardware address -- and under the new rule it
        # generates a different name. Without this it would find nothing and
        # report that it has no backup, while its backups sat one folder away.
        local prior_name="" id_tool
        id_tool=$(device_id_tool)
        [ -n "${id_tool}" ] && prior_name=$("${id_tool}" --legacy 2>/dev/null \
                                            | tr -cd 'A-Za-z0-9_.-')
        local prior_src="${REMOTENAME}${SETTINGS_REMOTE}/${prior_name}"

        # The folders this device may have written under while its id ended
        # in the shared constant (#86): until 2026-09-08 every device whose
        # kernel builds in the sit tunnel hashed the same string, so the RG SP
        # backed up to Anbernic-RG-SP-ee5013fc56 and the RG35XX SP to
        # ROCKNIX-ee5013fc56. cloud_device_id heals such an id on the first
        # run that sees a real hardware address and lists the old names under
        # --previous; the archives are still there, and still someone's only
        # backup. Nothing is moved: the same name was produced by every device
        # of that model or hostname, so a folder here may hold another
        # device's archives too, and the log says so when one is taken.
        local previous_names=""
        [ -n "${id_tool}" ] && previous_names=$("${id_tool}" --previous 2>/dev/null \
                                                | tr -cd 'A-Za-z0-9_.\n-')

        # In order: this device's own folder, its pre-label name, the folders
        # it was healed away from, and the root where archives sat before
        # folders existed. The first that holds an archive wins.
        if folder_has_archives "${device_src}"; then
            restore_src="${device_src}"
            log_message "Restoring from this device's own cloud folder (${own_name})" "false"
        fi
        if [ -z "${restore_src}" ] && [ -n "${prior_name}" ] && folder_has_archives "${prior_src}"; then
            restore_src="${prior_src}"
            log_message "Using backups saved under this device's previous folder name (${prior_name})" "true"
        fi
        if [ -z "${restore_src}" ] && [ -n "${previous_names}" ]; then
            local previous_name
            while IFS= read -r previous_name; do
                [ -n "${previous_name}" ] || continue
                # Already tried above. A cloud_device_id from before --previous
                # existed answers it with the current id, so this also keeps
                # an older helper from sending the restore round the same
                # folder twice.
                [ "${previous_name}" = "${own_name}" ] && continue
                [ "${previous_name}" = "${prior_name}" ] && continue
                if folder_has_archives "${REMOTENAME}${SETTINGS_REMOTE}/${previous_name}"; then
                    restore_src="${REMOTENAME}${SETTINGS_REMOTE}/${previous_name}"
                    log_message "Using backups saved under ${previous_name}, a folder this device may have written to while its id was the shared constant (#86); another device of the same model or hostname may have written there too" "true" "WARN"
                    break
                fi
            done <<< "${previous_names}"
        fi
        if [ -z "${restore_src}" ] && folder_has_archives "${legacy_src}"; then
            restore_src="${legacy_src}"
            log_message "Using a backup saved before this device had its own cloud folder" "false"
        fi
        if [ -z "${restore_src}" ]; then
            # Say what is actually there. Other devices' folders are not this
            # device's to restore silently, but "no backup found" when the
            # cloud plainly holds several is the kind of dead end that sends
            # someone looking in the wrong place.
            local others
            others=$(rclone lsf "${legacy_src}/" --dirs-only "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null | tr -d '/' | tr '\n' ' ')
            if [ -n "${others}" ]; then
                log_message "No backup for this device. The cloud holds backups from: ${others}" "true" "WARN"
            else
                log_message "There is no settings backup in the cloud yet" "true" "WARN"
            fi
            RESTORE_SYSTEM_STATUS=0
            return 0
        fi

        # The newest one, not all of them. The cloud keeps a dated history now
        # -- 2026_09_02-143000-ROCKNIX_BACKUP.zip -- so a folder transfer would
        # drag down every archive it holds and leave several beside each other
        # with no way for backuptool to know which was meant. Names lead with
        # the date, so the last one in sort order is the most recent and no
        # metadata call is needed to establish that.
        #
        # This device's own first. Since 2026-09-08 the name carries the
        # device that wrote it (<stamp>-<label>-ROCKNIX_SETTINGS.tar.gz), and
        # the folder may hold more than this device's: another handheld's
        # archive that was restored here and sent up again, one written by a
        # device sharing the folder (a cloned id, #86), and every archive from
        # before names carried a device. When this device has a labelled
        # archive here, the newest of those is the one to bring back. When it
        # has none -- a fresh device that adopted another's folder to take
        # over its settings (#26), or a folder holding only archives from
        # before names carried a device -- the newest overall is, and the log
        # says whose it was. An archive carrying this device's label but made
        # on another device (the two ways cloud_backup's retention names) is
        # taken for this device's own; the label cannot tell them apart.
        local osn listing label mine newest
        osn=$(os_name)
        listing=$(rclone lsf --files-only --include "*.{zip,tar.gz}" "${restore_src}/" "${RCLONE_NET_OPTS_ARRAY[@]}" 2>/dev/null)
        label=$(device_label)
        mine=""
        if [ -n "${label}" ]; then
            mine=$(printf '%s\n' "${listing}" \
                   | grep -E "^[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{6}-${label}-${osn}_SETTINGS\.tar\.gz$" | sort | tail -1)
        fi
        if [ -n "${mine}" ]; then
            newest="${mine}"
            log_message "Restoring this device's own newest settings backup (named for ${label}): ${newest}" "false"
        else
            newest=$(printf '%s\n' "${listing}" | grep -v '^$' | sort | tail -1)
            if [ -n "${newest}" ]; then
                local made_by
                # The label is what sits between the stamp and -ROCKNIX_; an
                # archive from before the label has nothing there.
                made_by=$(printf '%s\n' "${newest}" \
                          | sed -nE "s/^[0-9]{4}_[0-9]{2}_[0-9]{2}-[0-9]{6}-(.*)-${osn}_(SETTINGS|BACKUP)\.(tar\.gz|zip)\$/\1/p")
                case "${made_by}" in
                    '') made_by="made before backups were named after the device" ;;
                    *)  made_by="made on ${made_by}" ;;
                esac
                log_message "No settings backup named for this device (${label:-no name}) in ${restore_src}; restoring the newest there, ${newest} (${made_by})" "true"
            fi
        fi

        if [ -z "${newest}" ]; then
            log_message "There is no settings backup in the cloud yet" "true" "WARN"
            RESTORE_SYSTEM_STATUS=0
            return 0
        fi

        # Under the name it already has. A backup taken on this device and one
        # pulled from the cloud should be the same file with the same name --
        # backuptool writes dated archives and looks for the newest, so
        # stripping the date here would have produced a local file that looked
        # older than everything beside it and sorted to the wrong end.
        local local_name="${newest}"

        log_message "Restoring ${newest} from ${restore_src}" "true"

        # Without the filter flags, for the same reason the upload drops them:
        # copyto names one file and rclone refuses filters on a single-file
        # copy. Passing the folder options through made the transfer fail while
        # the run still reported success, and nothing arrived.
        local fetch_opts=()
        local opt
        local skip_next=0
        for opt in "${backup_opts[@]}"; do
            # A flag and its value may be one element ("--include=/*.zip") or
            # two ("--include" "/*.{zip,tar.gz}"). Dropping only the flag in the second
            # form leaves the bare pattern behind, and rclone reads it as
            # another path -- copyto then has three and fails with an
            # uncategorised error, having transferred nothing.
            if [ ${skip_next} -eq 1 ]; then
                skip_next=0
                continue
            fi
            case "${opt}" in
                --include|--exclude|--filter|--filter-from)
                    skip_next=1; continue ;;
                --include=*|--exclude=*|--filter*) continue ;;
                # The guard that adds this greps `rclone help`, which mentions
                # the flag on builds that do not accept it -- so it reaches the
                # command line and rclone exits with "unknown flag", having
                # transferred nothing while the run still reported success. It
                # only shapes the progress display, so nothing is lost here.
                --progress-terminal-width*) continue ;;
            esac
            fetch_opts+=("${opt}")
        done

        rclone copyto "${restore_src}/${newest}" "${SETTINGS_BACKUPS}/${local_name}" "${RCLONE_NET_OPTS_ARRAY[@]}" \
            "${fetch_opts[@]}"

        RESTORE_SYSTEM_STATUS=$?
        # rclone copy writes to a temporary name and renames on completion,
        # so a download the link cut leaves no partial archive behind; the
        # run says why it ended.
        if [ $RESTORE_SYSTEM_STATUS -ne 0 ]; then
            network_lost_during_run "$RESTORE_SYSTEM_STATUS" "the settings restore"
        fi
        report_rclone_error $RESTORE_SYSTEM_STATUS "Settings backup file restore"
        
        return $RESTORE_SYSTEM_STATUS
    else
        log_message "Settings backup file restore skipped (BACKUPFILE_RESTORE_OPTION is not set to 'yes')" "true"
        RESTORE_SYSTEM_STATUS=0
    fi
    
    return $RESTORE_SYSTEM_STATUS
}

# Main script execution
main() {
    check_network_link
    check_rclone_config
    check_internet
    load_config
    
    # Define locations for source and remote
    # Note: This assumes at least one remote is configured and the first one should be used
    REMOTENAME=`rclone listremotes | head -1`
    
    # Begin main script operations with user-friendly header
    log_message "=> ${OS_NAME} CLOUD RESTORE UTILITY\n"
    
    # Execute Part 1: Game saves restore
    # This performs the primary save file restoration operation using the configured method
    # --system-only was parsed and then ignored here, so it restored game saves
    # anyway -- the opposite of what it says, over the top of local saves.
    if [ "${SYSTEM_ONLY}" -eq 1 ]; then
        log_message "Game saves restore skipped (--system-only)" "true"
        RESTORE_STATUS=0
    else
        restore_game_saves
        RESTORE_STATUS=$?
    fi
    
    # Add a pause for better visual separation between operations
    sleep 2
    
    # Execute Part 2: System restore
    # This restores settings backup files (zip files) if enabled in configuration
    if [ "${SAVES_ONLY}" -eq 1 ]; then
        log_message "Settings backup file restore skipped (--saves-only)" "true"
        RESTORE_SYSTEM_STATUS=0
    else
        restore_system_files
        RESTORE_SYSTEM_STATUS=$?
    fi
    
    # Create empty missing system directories if removed during restore
    # Only necessary when using sync method which can delete files
    if [ "${RESTOREMETHOD}" == "sync" ]; then
        log_message "Creating empty missing system directories" "true"
        # Guarded the way automount does it: the file is generated at build
        # time, so a missing one means a broken image, not a reason to print a
        # systemd error at the end of an otherwise good restore.
        if [ -e "/usr/config/system-dirs.conf" ]; then
            systemd-tmpfiles --create /usr/config/system-dirs.conf >/dev/null 2>&1 ||:
        fi
    fi
    
    # Add a pause before summary
    sleep 2
    
    # Add a line break for better visual separation
    echo
    
    # Provide final summary of all operations
    log_message "====================================" "true"
    log_message "RESTORE SUMMARY:" "true"
    log_message "Game saves restore: $([ $RESTORE_STATUS -eq 0 ] && echo 'SUCCESS' || echo 'COMPLETED WITH ERRORS')" "true"
    [ "${BACKUPFILE_RESTORE_OPTION}" == "yes" ] && log_message "Settings backup file restore: $([ $RESTORE_SYSTEM_STATUS -eq 0 ] && echo 'SUCCESS' || echo 'COMPLETED WITH ERRORS')" "true"
    log_message "Log file: ${LOG_FILE}" "true"
    log_message "====================================" "true"
    
    # Add a final pause before exiting
    sleep 3
    
    # Both phases decide the exit. It was the saves phase's alone -- "use the
    # game saves restore status as the overall exit code" -- so a settings
    # download that failed exited 0, and under --system-only, where the saves
    # phase is skipped and reports 0, every failure did: the page said
    # COMPLETED SUCCESSFULLY and last-settings-restore recorded 0 for an
    # archive that never arrived (found while bounding the runs, #103; the
    # same fix as cloud_backup's). A run is good when every phase it ran is;
    # otherwise it carries the first failing phase's code, the saves phase's
    # when both failed.
    local overall=${RESTORE_STATUS}
    [ "${overall}" -eq 0 ] && overall=${RESTORE_SYSTEM_STATUS}
    clean_exit ${overall}
}

# Set up signal trap to handle user interruption gracefully
trap 'log_message "Script interrupted by user" "false" "WARN"; clean_exit 130' INT TERM

# Start script execution
take_cloud_lock
main
