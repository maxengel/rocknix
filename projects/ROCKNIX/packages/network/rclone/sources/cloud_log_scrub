# cloud_log_scrub - take out of the cloud log the credentials earlier builds
# wrote into it. Once per device, at boot, before anything writes the log.
#
# Until e2d45ec7ec, cloud_remote logged every failed rclone call whole:
# "rclone config create <name> <type> url=... user=... pass=<the password>
# ... failed (1): <rclone's words>", every value the player had typed,
# passwords and keys among them; and cloud_oauth logged rclone's words when
# a sign-in could not be saved -- words that could carry the token. The
# fix stopped new lines (audit #307 PL-074). The old ones stayed: /var/log is
# /storage/.cache/log on every device since D-SYS-001 (2026-09-10), and
# cloud_sync.log is only trimmed past 1 MiB, which is months of ordinary
# runs (the audit of the fix round, PL-014).
#
# So, once: every cloud_sync.log* under /storage/.cache/log -- the log, a
# copy a trim left behind when it was cut off, any rotation -- is rewritten
# with
#   - an old cloud_remote failure line put in the shape this build writes:
#     "rclone <verb> failed (<code>)", its arguments and rclone's words gone
#     (a line cut off before its "failed" has every key=value masked);
#   - cloud_oauth's "could not finish the sign-in: <rclone's words>" with the
#     words <redacted>, unless they are one of the fixed sentences the
#     scripts themselves wrote;
#   - and every line through redact_credentials (001-functions), the one
#     place that knows what a credential looks like in a line.
# Lines hold their places: a file comes back with as many lines as it had,
# or it is not replaced. A file that grew while it was read is read again.
# The folder is /storage/.cache/log whether /var/log is bound over it or not
# (/storage/.cache/volatile-log): the old lines are on the card either way.
#
# Done is recorded in /storage/.cache/cloud_sync/log-scrubbed
# (scrubbed=<epoch> files=<n> lines=<n>), written only once every file was
# either rewritten or needed nothing; until then each boot tries again. A
# device with no log folder -- a clean install -- is recorded as done: no
# earlier build wrote anything there.

LOG_DIR=/storage/.cache/log
STAMP=/storage/.cache/cloud_sync/log-scrubbed

[ -e "${STAMP}" ] && exit 0
set -o pipefail

# The filter or nothing: without it a password in a line this script has no
# rule for would be kept and the log recorded as clean.
. /etc/profile.d/001-functions 2>/dev/null
if ! type redact_credentials >/dev/null 2>&1; then
    echo "cloud_log_scrub: redact_credentials is not in /etc/profile.d/001-functions; nothing was scrubbed, and the next boot tries again"
    exit 1
fi

# The shapes earlier builds wrote, by the script that wrote them. The
# cloud_remote rule for "config" verbs and the one for the others are kept
# apart so neither reads this build's own "rclone config create failed (1)"
# as an old line: that has no argument between the verb and "failed".
SCRUB_SED='
/\[cloud_remote\] rclone config /{
s/^(.*\[cloud_remote\] rclone config [a-z]+) [^ ]+( .*)? failed \(([0-9-]+)\)(: .*)?$/\1 failed (\3)/
s/ ([A-Za-z0-9_.-]+)=[^ ]*/ \1=<redacted>/g
}
/\[cloud_remote\] rclone config /!s/^(.*\[cloud_remote\] rclone [a-z]+) [^ ]+( .*)? failed \(([0-9-]+)\)(: .*)?$/\1 failed (\3)/
/\[cloud_oauth\] could not finish the sign-in: /{
/sign-in: (a remote called .* already exists|signed in, but the remote did not respond|rclone rejected the token|The sign-in worked, but it couldn.t be saved on your handheld\.|The sign-in worked, but your handheld.s cloud settings couldn.t be read\.|That sign-in was closed before it finished\.)$/!s/(could not finish the sign-in: ).*$/\1<redacted>/
}
'

lines_in() { awk 'END { print NR }' "$1"; }

# scrub <file>: rewrite it in place, through a temp and a rename; prints the
# number of lines it changed. Non-zero when the file could not be rewritten
# whole, which leaves it as it was.
scrub() {
    local f="$1" tmp="$1.scrub.$$" before after tries=0 changed
    while :; do
        before=$(wc -c < "${f}") || return 1
        if ! sed -E -e "${SCRUB_SED}" "${f}" | redact_credentials > "${tmp}"; then
            rm -f "${tmp}"; return 1
        fi
        after=$(wc -c < "${f}") || { rm -f "${tmp}"; return 1; }
        [ "${before}" = "${after}" ] && break
        tries=$((tries + 1))
        [ "${tries}" -lt 3 ] || { rm -f "${tmp}"; return 1; }
    done
    if [ "$(lines_in "${tmp}")" != "$(lines_in "${f}")" ]; then
        rm -f "${tmp}"; return 1
    fi
    changed=$(awk 'NR == FNR { a[FNR] = $0; next } a[FNR] != $0 { n++ } END { print n + 0 }' "${f}" "${tmp}") \
        || { rm -f "${tmp}"; return 1; }
    if [ "${changed}" -eq 0 ]; then
        rm -f "${tmp}"
    elif ! mv -f "${tmp}" "${f}"; then
        rm -f "${tmp}"; return 1
    fi
    echo "${changed}"
}

files=0 lines=0 failed=0
for f in "${LOG_DIR}"/cloud_sync.log "${LOG_DIR}"/cloud_sync.log.*; do
    [ -f "${f}" ] && [ ! -L "${f}" ] || continue
    case "${f}" in *.scrub.*) continue ;; esac
    if n=$(scrub "${f}"); then
        files=$((files + 1)); lines=$((lines + n))
    else
        failed=1
        echo "cloud_log_scrub: ${f##*/} could not be rewritten; it is as it was, and the next boot tries again"
    fi
done
[ "${failed}" -eq 0 ] || exit 1

mkdir -p "${STAMP%/*}" \
    && printf 'scrubbed=%s files=%s lines=%s\n' "$(date +%s)" "${files}" "${lines}" > "${STAMP}.tmp" \
    && mv -f "${STAMP}.tmp" "${STAMP}" \
    || { rm -f "${STAMP}.tmp"; echo "cloud_log_scrub: the record of the scrub could not be written; the next boot runs it again"; exit 1; }
[ "${lines}" -eq 0 ] || echo "cloud_log_scrub: ${lines} line(s) in ${files} cloud log file(s) had credentials an earlier build wrote; masked"
exit 0
