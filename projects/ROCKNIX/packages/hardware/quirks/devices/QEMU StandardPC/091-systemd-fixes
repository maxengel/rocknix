### GENERIC_X64 systemd service configuration fixes
### Base service configurations (enhanced by other quirks files)

echo "Applying base systemd service configurations for GENERIC_X64..."

# Create systemd drop-in directories for service overrides
mkdir -p /storage/.config/systemd/system/systemd-hostnamed.service.d
mkdir -p /storage/.config/systemd/system/systemd-journald.service.d

# Base systemd-hostnamed service configuration
cat <<EOF >/storage/.config/systemd/system/systemd-hostnamed.service.d/05-generic-x64-base.conf
[Unit]
# Base hostnamed configuration for GENERIC_X64
After=dbus.service
Wants=dbus.service

[Service]
# Base restart configuration
Restart=on-failure
RestartSec=1
StartLimitInterval=30
StartLimitBurst=5
# Base memory limit
MemoryMax=32M
EOF

# Base systemd-journald configuration
cat <<EOF >/storage/.config/systemd/system/systemd-journald.service.d/05-generic-x64-base.conf
[Service]
# Base journald configuration for GENERIC_X64
Restart=on-failure
RestartSec=2
StartLimitInterval=60
StartLimitBurst=3
# Base memory limit
MemoryMax=64M
EOF

# Base Samba service configurations (VM-specific config in 092-vm-service-fixes may override)
mkdir -p /storage/.config/systemd/system/smbd.service.d
mkdir -p /storage/.config/systemd/system/nmbd.service.d

cat <<EOF >/storage/.config/systemd/system/smbd.service.d/05-generic-x64-base.conf
[Unit]
# Base Samba service configuration for GENERIC_X64
After=dbus.service network.target

[Service]
# Base restart policy for Samba
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
# Base memory limit
MemoryMax=64M
EOF

cat <<EOF >/storage/.config/systemd/system/nmbd.service.d/05-generic-x64-base.conf
[Unit]
# Base NetBIOS service configuration for GENERIC_X64
After=network.target

[Service]
# Base restart policy for NetBIOS
Restart=on-failure
RestartSec=5
StartLimitInterval=60
StartLimitBurst=3
# Base memory limit
MemoryMax=32M
EOF

# Set base platform-specific service ordering
cat <<EOF >/storage/.config/profile.d/091-generic-x64-services
# GENERIC_X64 base service configuration
# May be enhanced by other quirks files

# Base service dependencies
SYSTEM_SERVICE_DEPS="dbus.service"

# Base UI service configuration
UI_SERVICE_AFTER="dbus.service systemd-logind.service"
UI_SERVICE_WANTS="dbus.service"
EOF

echo "Base systemd service configurations applied for GENERIC_X64"
