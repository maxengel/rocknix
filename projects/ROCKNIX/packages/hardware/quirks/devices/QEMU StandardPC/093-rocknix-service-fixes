### GENERIC_X64 ROCKNIX service fixes
### Addresses ROCKNIX-specific service failures seen in boot logs

# Fix rocknix-automount service issues
if [ -f /usr/lib/systemd/system/rocknix-automount.service ]; then
    # Create override directory
    mkdir -p /etc/systemd/system/rocknix-automount.service.d
    
    cat <<EOF >/etc/systemd/system/rocknix-automount.service.d/10-generic-x64.conf
[Unit]
# Add dependencies to ensure proper startup order
After=systemd-udevd.service systemd-journald.service
Wants=systemd-udevd.service

[Service]
# Increase timeout for slower desktop hardware
TimeoutStartSec=30s
TimeoutStopSec=15s

# Restart policy for failed mounts
Restart=on-failure
RestartSec=5s
EOF
fi

# Fix plymouth communication issues
if [ -f /usr/lib/systemd/system/plymouth-start.service ]; then
    mkdir -p /etc/systemd/system/plymouth-start.service.d
    
    cat <<EOF >/etc/systemd/system/plymouth-start.service.d/10-generic-x64.conf
[Unit]
# Reduce plymouth dependency conflicts
ConditionKernelCommandLine=!plymouth.enable=0

[Service]
# Handle communication failures gracefully
ExecStartPre=/bin/sh -c 'test -e /dev/fb0 || exit 0'
TimeoutStartSec=10s
EOF
fi

# Create enhanced D-Bus service coordination (extends base config)
mkdir -p /storage/.config/systemd/system/dbus.service.d

cat <<EOF >/storage/.config/systemd/system/dbus.service.d/15-rocknix-coordination.conf
[Unit]
# Enhanced D-Bus coordination with ROCKNIX services
After=systemd-journald.service
Before=systemd-logind.service rocknix-autostart.service

[Service]
# Enhanced timeout and error handling for ROCKNIX
TimeoutStartSec=25s
TimeoutStopSec=10s
# Coordinate with other fixes (VM config may override)
KillMode=mixed
EOF

# Fix systemd-hostnamed coordination (extends base config from 094-core-systemd-fixes)
mkdir -p /storage/.config/systemd/system/systemd-hostnamed.service.d

cat <<EOF >/storage/.config/systemd/system/systemd-hostnamed.service.d/20-rocknix-enhanced.conf
[Unit]
# Enhanced hostnamed coordination with ROCKNIX services
After=systemd-journald.service dbus.service
Requisite=dbus.service

[Service]
# ROCKNIX-specific hostnamed optimizations
StartLimitBurst=4
StartLimitIntervalSec=120s
# Enhanced process management
KillMode=mixed
KillSignal=SIGTERM
SendSIGKILL=yes
EOF

# Enhanced journald configuration for ROCKNIX (supplements base config)
mkdir -p /etc/systemd/journald.conf.d

cat <<EOF >/etc/systemd/journald.conf.d/15-rocknix-enhanced.conf
[Journal]
# ROCKNIX-specific journald enhancements
# Supplements base config from 094-core-systemd-fixes

# Enhanced rate limiting for ROCKNIX services
RateLimitInterval=120s
RateLimitBurst=2000

# ROCKNIX-specific log handling
MaxLevelStore=info
MaxLevelSyslog=warning
MaxLevelKMsg=warning
EOF

echo "ROCKNIX service coordination fixes applied for GENERIC_X64"
