# Steam Deck (Valve Jupiter) Configuration
cat <<EOF >/storage/.config/profile.d/001-device_config
# Device Features
DEVICE_HAS_TOUCHSCREEN="true"
DEVICE_FAKE_JACKSENSE="false"
DEVICE_BATTERY_LED_STATUS="true"
DEVICE_PWR_LED_CONTROL="true"
DEVICE_SLEEP_DPMS="true"
DEVICE_HAS_HDMI="false"

# Physical handheld device
DEVICE_IS_VIRTUAL="false"
DEVICE_VIRTUALIZATION_PLATFORM=""

# Steam Deck display configuration
DEVICE_DEFAULT_DISPLAY="eDP"
DEVICE_DEFAULT_RESOLUTION="1280x800"

# Steam Deck temperature monitoring
DEVICE_TEMP_SENSOR="/sys/class/thermal/thermal_zone*/temp"

# Steam Deck power management (AMD APU)
DEVICE_BASE_TDP="15"
DEVICE_TDP_RANGE="3-15"
