### GENERIC_X64 systemd service configuration fixes
### Addresses service startup failures seen during boot

# Create systemd drop-in directories for service overrides
mkdir -p /storage/.config/systemd/system/systemd-hostnamed.service.d
mkdir -p /storage/.config/systemd/system/systemd-journald.service.d
mkdir -p /storage/.config/systemd/system/dbus.service.d

# Fix systemd-hostnamed service stability
cat <<EOF >/storage/.config/systemd/system/systemd-hostnamed.service.d/10-generic-x64.conf
[Unit]
# Ensure D-Bus is available before starting hostnamed
After=dbus.service
Wants=dbus.service

[Service]
# Increase restart tolerance for PID churn issues
Restart=on-failure
RestartSec=1
StartLimitInterval=30
StartLimitBurst=5
# Reduce memory pressure
MemoryMax=32M
EOF

# Fix systemd-journald stability for desktop environment
cat <<EOF >/storage/.config/systemd/system/systemd-journald.service.d/10-generic-x64.conf
[Service]
# Increase file descriptor limits for journald
LimitNOFILE=8192
# Reduce restart sensitivity
Restart=on-failure
RestartSec=2
StartLimitInterval=60
StartLimitBurst=3
# Desktop-appropriate memory limits
MemoryMax=64M
EOF

# Ensure D-Bus starts early and stays stable
cat <<EOF >/storage/.config/systemd/system/dbus.service.d/10-generic-x64.conf
[Unit]
# Ensure D-Bus starts early in boot process
DefaultDependencies=false
After=sysinit.target
Before=multi-user.target

[Service]
# Increase D-Bus stability for desktop services
Restart=on-failure
RestartSec=1
StartLimitInterval=30
StartLimitBurst=5
# Appropriate memory limits for desktop environment
MemoryMax=48M
EOF

# Set platform-specific service ordering
cat <<EOF >/storage/.config/profile.d/091-generic-x64-services
# GENERIC_X64 service configuration
# Ensure proper service startup order for desktop environment

# Desktop environment needs D-Bus early
SYSTEM_SERVICE_DEPS="dbus.service"

# UI service dependency order
UI_SERVICE_AFTER="dbus.service systemd-logind.service"
UI_SERVICE_WANTS="dbus.service"
EOF
