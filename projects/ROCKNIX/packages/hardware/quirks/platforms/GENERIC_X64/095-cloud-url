# QEMU dev builds: when guest services are reached through a forward on the
# host machine, the address a phone must scan belongs to the host, not to this
# guest. The host side supplies it through fw_cfg (opt/org.rocknix.cloud_url):
# filled in automatically by the Linux launcher, and pre-written as an
# obviously invalid placeholder in the macOS bundle for the tester to edit once
# in the VM settings. Publish a valid value as the generic cloud-setup
# advertised URL, and never leave a stale or placeholder override behind.

FWCFG="/sys/firmware/qemu_fw_cfg/by_name/opt/org.rocknix.cloud_url/raw"
TARGET="/storage/.config/cloud_setup_url"

URL=""
if [ -r "${FWCFG}" ]; then
  URL=$(tr -d '\0' < "${FWCFG}")
fi

case "${URL}" in
  http://*|https://*)
    echo "${URL}" > "${TARGET}"
  ;;
  *)
    rm -f "${TARGET}"
  ;;
esac
