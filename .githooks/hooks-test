#!/bin/bash
# hooks-test -- the fork guards' own test: pre-commit, commit-msg and pre-push
# against the shapes they exist to refuse, in a scratch repository, with a
# stand-in wordlist (FORBIDDEN_TERMS_FILE) and a credential fixture built at
# run time -- neither the real list nor a literal secret is in this file, so
# the guards can commit their own proof (2026-09-28, #312; the ES fork's is
# .githooks/pre-push-test).
#   .githooks/hooks-test          # every case ok, then PASS (exit 0), or FAIL (1)
set -u
HOOKS="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"
SCRATCH="$(mktemp -d)" || exit 2
trap 'rm -rf "${SCRATCH}"' EXIT
FAKE="$(printf 'dev%s=%s' password QwErTyUiOpAsDfGh)"       # credential-shaped, means nothing
KEYNAME="sk-$(printf 'A%.0s' $(seq 1 24)).patch"             # a FILE NAME shaped like a key
printf "FORBIDDEN_PATTERNS='zebrafish[ ]quartet|qzx-estate'\\n" > "${SCRATCH}/wordlist"
printf "SECRET_PATTERNS='['\\n" > "${SCRATCH}/badlist"
export FORBIDDEN_TERMS_FILE="${SCRATCH}/wordlist"
unset FORBIDDEN_PATTERNS SECRET_PATTERNS_FILE
ZERO=0000000000000000000000000000000000000000
fail=0
mkdir -p "${SCRATCH}/nohooks"
g() { git -c user.name=t -c user.email=t@t -c commit.gpgsign=false -c "core.hooksPath=${SCRATCH}/nohooks" "$@"; }

# expect <refused|allowed> <case> <command...>
expect() {
  local want="$1" name="$2" rc; shift 2
  "$@" >"${SCRATCH}/out" 2>&1; rc=$?
  if { [ "${want}" = refused ] && [ "${rc}" -ne 0 ]; } || { [ "${want}" = allowed ] && [ "${rc}" -eq 0 ]; }; then
    echo "  ok    ${name}: ${want}"
  else
    echo "  FAIL  ${name}: expected ${want}, exited ${rc}"; sed 's/^/          /' "${SCRATCH}/out"; fail=1
  fi
}
says()   { if grep -q -F -- "$2" "${SCRATCH}/out"; then echo "  ok    $1: says \"$2\""; else echo "  FAIL  $1: expected \"$2\""; sed 's/^/          /' "${SCRATCH}/out"; fail=1; fi; }
silent() { if grep -q -i -F -- "$2" "${SCRATCH}/out"; then echo "  FAIL  $1: the output carries \"$2\""; sed 's/^/          /' "${SCRATCH}/out"; fail=1; else echo "  ok    $1: never prints the word"; fi; }
push_line() { printf '%s\n' "$1" | "${HOOKS}/pre-push" origin "file://${SCRATCH}/remote.git"; }

cd "${SCRATCH}" && git init -q -b main work && cd work || exit 2
git init -q --bare "${SCRATCH}/remote.git" && git remote add origin "${SCRATCH}/remote.git"

echo '--- pre-commit'
echo 'plain line' > a.txt; g add a.txt
expect allowed "a clean file" "${HOOKS}/pre-commit"
g commit -q -m base
echo "${FAKE}" > b.txt; g add b.txt
expect refused "a credential-shaped line" "${HOOKS}/pre-commit"
says "the value is redacted" "[REDACTED]"
silent "the refusal" "QwErTyUiOpAsDfGh"
g reset -q; rm b.txt
mkdir -p docs/audits/x/seats; echo "${FAKE}" > docs/audits/x/seats/y.diff; g add docs
expect refused "the same line under an audit packet (no path is exempt)" "${HOOKS}/pre-commit"
g reset -q; rm -r docs
echo 'the zebrafish quartet played' > c.txt; g add c.txt
expect refused "a listed word" "${HOOKS}/pre-commit"
says "the refusal names the file and line" "c.txt:1"
silent "the refusal" "zebrafish"
g reset -q; rm c.txt
printf 'one\nThe Zebrafish Quartet\n' > d.txt; g add d.txt
expect refused "a listed word in another case, on line 2" "${HOOKS}/pre-commit"
says "line 2 is named" "d.txt:2"
g reset -q; rm d.txt
# The three shapes the audit of the fixes found the scan skipping (claude
# G3-E-01, gpt G3-E-06): a repository with diff.noprefix, a content line
# that begins "++ ", and a file name git prints in quotes.
g config diff.noprefix true; echo "${FAKE}" > f.txt; g add f.txt
expect refused "a credential-shaped line with diff.noprefix set (the scan forces its prefixes)" "${HOOKS}/pre-commit"
g config --unset diff.noprefix; g reset -q; rm f.txt
printf '++ note\n%s\n' "${FAKE}" > h.txt; g add h.txt
expect refused "a content line beginning ++ does not end the file's scan" "${HOOKS}/pre-commit"
says "line 2 is named" "h.txt:2"
g reset -q; rm h.txt
echo "${FAKE}" > 'odd"name.txt'; g add 'odd"name.txt'
expect refused "a file name git prints in quotes is still scanned" "${HOOKS}/pre-commit"
g reset -q; rm 'odd"name.txt'
echo 'clean content' > "${KEYNAME}"; g add "${KEYNAME}"
expect allowed "a file NAMED like a key, clean inside (the label is not scanned)" "${HOOKS}/pre-commit"
g commit -q -m named
echo 'plain' > e.txt; g add e.txt
SECRET_PATTERNS_FILE="${SCRATCH}/badlist" expect refused "a credential list that does not compile" "${HOOKS}/pre-commit"
says "it says so" "does not compile"
FORBIDDEN_TERMS_FILE="${SCRATCH}/absent" expect refused "no wordlist at all" "${HOOKS}/pre-commit"
FORBIDDEN_TERMS_FILE="${SCRATCH}/absent" FORBIDDEN_PATTERNS='zebrafish[ ]quartet' expect allowed "the wordlist from the environment instead (CI)" "${HOOKS}/pre-commit"
GIT_DIR="${SCRATCH}/no-such-repo" expect refused "an index that cannot be read" "${HOOKS}/pre-commit"
g reset -q; rm e.txt

echo '--- commit-msg'
printf 'tidy the qzx-estate notes\n' > "${SCRATCH}/msg"
expect refused "a listed word in the message" "${HOOKS}/commit-msg" "${SCRATCH}/msg"
silent "the refusal" "qzx-estate"
printf 'tidy the notes\n\n# a comment line naming the zebrafish quartet is not the message\n' > "${SCRATCH}/msg"
expect allowed "a clean message (git drops the # comment)" "${HOOKS}/commit-msg" "${SCRATCH}/msg"
printf 'note\n\n%s\n' "${FAKE}" > "${SCRATCH}/msg"
expect refused "a credential-shaped line in the message" "${HOOKS}/commit-msg" "${SCRATCH}/msg"
expect refused "a message file that cannot be read (claude G3-E-02 / gpt G3-E-05)" "${HOOKS}/commit-msg" "${SCRATCH}/no-such-msg"
FORBIDDEN_TERMS_FILE="${SCRATCH}/absent" expect refused "a message with no wordlist to judge it by" "${HOOKS}/commit-msg" "${SCRATCH}/msg"

echo '--- pre-push'
g push -q origin main; remote="$(git rev-parse HEAD)"
g checkout -q -b mid "${remote}"; echo 'zebrafish quartet' > f.txt; g add f.txt; g commit -q -m mid; rm f.txt; g add -A; g commit -q -m tip
expect refused "a listed word in a middle commit, gone at the tip" push_line "refs/heads/mid $(git rev-parse HEAD) refs/heads/mid ${ZERO}"
silent "the refusal" "zebrafish"
g checkout -q -b msg "${remote}"; g commit -q --allow-empty -m 'about the qzx-estate'
expect refused "a listed word in a commit message" push_line "refs/heads/msg $(git rev-parse HEAD) refs/heads/msg ${ZERO}"
says "the message is named" ":message:1"
g checkout -q -b sec "${remote}"; echo "${FAKE}" > s.txt; g add s.txt; g commit -q -m s; echo clean > s.txt; g add s.txt; g commit -q -m s2
expect refused "a credential in a middle commit, gone at the tip" push_line "refs/heads/sec $(git rev-parse HEAD) refs/heads/sec ${ZERO}"
says "the value is redacted" "[REDACTED]"
g checkout -q -b old "${remote}"; echo 'zebrafish quartet' > t.txt; g add t.txt; g commit -q -m old; g push -q origin old; prev="$(git rev-parse HEAD)"
echo more >> t.txt; g add t.txt; g commit -q -m touch
expect refused "an older line in a file the range only touches beside (the tip scan)" push_line "refs/heads/old $(git rev-parse HEAD) refs/heads/old ${prev}"
g checkout -q -b quoted "${remote}"; g config diff.noprefix true; echo "${FAKE}" > 'odd"name.txt'; g add 'odd"name.txt'; g commit -q -m quoted
expect refused "a credential in a file git prints in quotes, pushed from a clone with diff.noprefix" push_line "refs/heads/quoted $(git rev-parse HEAD) refs/heads/quoted ${ZERO}"
g config --unset diff.noprefix
g checkout -q -b clean "${remote}"; echo more >> a.txt; echo more >> "${KEYNAME}"; g add -A; g commit -q -m clean
expect allowed "a clean commit, touching the file named like a key" push_line "refs/heads/clean $(git rev-parse HEAD) refs/heads/clean ${ZERO}"
SECRET_PATTERNS_FILE="${SCRATCH}/badlist" expect refused "a credential list that does not compile" push_line "refs/heads/clean $(git rev-parse HEAD) refs/heads/clean ${ZERO}"
FORBIDDEN_TERMS_FILE="${SCRATCH}/absent" expect refused "no wordlist at all" push_line "refs/heads/clean $(git rev-parse HEAD) refs/heads/clean ${ZERO}"
expect refused "a tip this clone does not have" push_line "refs/heads/clean 1234567890123456789012345678901234567890 refs/heads/clean ${ZERO}"

if [ "${fail}" -eq 0 ]; then echo PASS; else echo FAIL; exit 1; fi
