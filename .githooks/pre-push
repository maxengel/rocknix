#!/usr/bin/env bash
# pre-push guard for the maxengel/rocknix fork.
#
# Blocks pushing a PR branch (pr/*) that carries personal fork artifacts which
# must never reach an upstream pull request. Build clean PR branches by
# content, from upstream/next (.claude/rules/fork-workflow.md):
#   git worktree add --detach ../rocknix.worktrees/pr-<name> upstream/next
#   git switch -c pr/<name> && git checkout next -- <the feature paths> && git commit
#
# INSTALL WITH AN ABSOLUTE PATH:
#   git config core.hooksPath /path/to/rocknix/.githooks
#
# A *relative* `core.hooksPath=.githooks` looks right and silently does nothing
# where it matters most. The path resolves against whichever working tree you
# are pushing from, and a correctly built pr/* branch has no `.githooks/` in it
# - excluding it is the whole point of building it by content. Check out such a
# branch in a worktree and the hook file is simply absent, so git runs no hook
# and every check below is skipped. The better the PR branch, the less the
# guard exists. An absolute path pins the hook to the main checkout, so it runs
# regardless of which branch or worktree is being pushed.
#
# Only pushes whose DESTINATION is refs/heads/pr/* are guarded for personal
# paths -- `git push origin feature/x:pr/x` lands on pr/x and is judged as
# pr/x; every branch is scanned for credential-shaped lines (SECRET_PATTERNS
# below), in every commit the push carries, not only at its tip.
#
# Fails closed: a pr/* push with no upstream/next or origin/next to compare
# against is refused, not waved through with a warning, and so is any push
# whose range this hook cannot diff. Proven on 2026-09-13 (audit #151 PL-08)
# in a scratch repo with `core.hooksPath` pointing at this directory, one
# refusal each -- the commands, then the hook's answer:
#
#   # a value committed in the middle of the push and removed again at its tip
#   #   (devpassword=<sixteen letters spelling nothing>; a tip-only scan passes it)
#   git push scratch feature/x
#     -> "refusing to push feature/x: it carries lines shaped like credentials:"
#        "  7a9d1d2:notes.txt:+[REDACTED]" (the middle commit, named), exit 1
#   # a personal path pushed to a pr/* destination under another local name
#   git push scratch feature/p:refs/heads/pr/p
#     -> "pre-push blocked: pr/p (pushed from feature/p) carries personal artifacts
#         that must not go upstream:  docs/note.md", exit 1
#   # a pr/* push with no upstream/next and no origin/next in the repo
#   git push scratch pr/y
#     -> "refusing to push pr/y: no upstream/next or origin/next to compare a pr/* branch against", exit 1
#
# The hook at next 6e09b6fcca let all three through (the first two silently,
# the third with a warning); the same three shapes without their fault push
# through this one, and a range git cannot diff at all is refused too.

set -uo pipefail

# Personal paths that must never appear in an upstream PR branch.
# Keep this in step with `.claude/rules/fork-workflow.md` § "Personal paths".
PERSONAL_PATTERNS=(
  # Agent context, rules and skills
  '.claude/'
  'CLAUDE.md'
  'AGENTS.md'
  '.githooks/'
  '.github/sessions/'
  '.github/workflows/fork-'
  # Personal documentation and planning
  'docs/'
  'plans/'
  # Fork-only tooling. `tools/` as a whole is upstream's, so these are listed
  # one by one; a new fork-only tool must be added here by hand (the unlisted
  # check below is what reminds you).
  'tools/fork-publish-release'
  'tools/cloud-test-backend'
  'tools/cloud-round-trip'
  'tools/cloud-capture-stamp-test'
  'tools/wait-lock-test'
  'tools/last-good-scripts-test'
  'tools/lint-audit-artifacts'
  'tools/es-untranslated'
  'tools/es-menu-map-check'
  'tools/ra-candidate-games'
  'tools/retroarch-wrapper-test'
  'tools/build-preflight'
  'tools/watch-job'
  'tools/vm-visual-qa'
  'tools/vm-serial'
  'tools/vm-pair'
  'tools/cloud-census'
  'tools/emulator-exit-test'
  'tools/vm-qa'
  'tools/time-to-play'
  'tools/vocabulary-check'
  'tools/register-check'
  'tools/device-act'
  'tools/qa-accounts'
  'tools/ra-offline-test'
  'tools/vm-walks/'
  'tools/fork-worktree'
  'tools/fork-package-freshness'
  'tools/vm-upgrade-rehearsal'
  'tools/es-syntax-check'
  'tools/png-blackout'
  'tools/fork-newdrive'
  'tools/council/'
  # The council's deliberation artifacts (fork issue #70)
  'research/'
  # Copilot-era artifacts. Retired from `next`, but feature branches and
  # worktrees cut before the retirement still contain them, and a PR branch
  # built from one of those would carry them upstream. Keep guarding them.
  '.github/copilot-instructions.md'
  '.github/instructions/'
  '.github/shared-copilot-knowledge/'
  'tmp/shared-copilot-knowledge/'
  'compare-prompt-versions.sh'
)

zero='0000000000000000000000000000000000000000'
empty_tree="$(git hash-object -t tree /dev/null)"
status=0

# Lines shaped like credentials, on EVERY branch. GitHub's push protection
# knows its own catalogue of token formats; it does not know a ScreenScraper
# developer password (`devid=..&devpassword=..`) or a RetroAchievements web API
# key (`z=user&y=KEY`), and those are the secrets this fork actually handles
# (~/.ROCKNIX/options, device-builds.md § Build credentials). Names are not
# enough -- `export SCREENSCRAPER_DEV_LOGIN="devid=<id>&devpassword=<..>"` is
# documentation -- so every pattern demands a real-looking value; placeholders
# in <angle brackets> never match.
SECRET_PATTERNS='devpassword=[A-Za-z0-9._%-]{4,}|[?&]y=[A-Za-z0-9]{16,}|AKIA[0-9A-Z]{16}|gh[pousr]_[A-Za-z0-9]{36}|github_pat_[A-Za-z0-9_]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY|"(access|refresh)_token" *: *"[A-Za-z0-9._-]{16,}|sk-[A-Za-z0-9_-]{24,}|(API_?KEY|TOKEN|SECRET|PASSWORD|PASSWD)[A-Z_]* *[:=] *["'"'"']?[A-Za-z0-9+/=_-]{16,}'

# A relative hooksPath means pr/* pushes from a worktree run unguarded. We can
# only say so from a push that did reach the hook, which is the point: say it
# here rather than let a silent gap persist.
hooks_path="$(git config --get core.hooksPath || true)"
case "$hooks_path" in
  ''|/*) ;;
  *) echo "⚠ pre-push: core.hooksPath is relative ('${hooks_path}'), so this guard does" >&2
     echo "  not run when pushing a pr/* branch (those branches contain no .githooks/)." >&2
     echo "  Fix with: git config core.hooksPath \"\$(git rev-parse --show-toplevel)/.githooks\"" >&2 ;;
esac

# Pick a clean base to compare PR branches against.
base_ref=''
for cand in upstream/next origin/next; do
  if git rev-parse --verify --quiet "${cand}^{commit}" >/dev/null; then
    base_ref="$cand"
    break
  fi
done

while read -r local_ref local_sha remote_ref remote_sha; do
  # Skip branch deletions.
  [ "$local_sha" = "$zero" ] && continue

  pushed="${local_ref#refs/heads/}"

  # --- credentials, every branch -------------------------------------------
  # Two scans. (1) The files this push adds or changes, read whole at the
  # pushed tip, so a secret that slipped in earlier blocks the next push that
  # touches its file. (2) Every line ADDED by every commit in the range: a
  # value committed and removed again inside one push is in the history being
  # pushed and invisible at the tip (audit #151 PL-08). A range this hook
  # cannot diff is refused -- a scan that did not run has not passed.
  whole=0
  if [ "$remote_sha" = "$zero" ]; then
    oldest="$(git rev-list "$local_sha" --not --remotes 2>/dev/null | tail -1)"
    if [ -n "$oldest" ] && git rev-parse --verify --quiet "${oldest}^" >/dev/null; then
      range="${oldest}^..${local_sha}"
    elif [ -n "$oldest" ]; then
      whole=1                      # the remotes have none of this history: scan all of it
    elif git rev-parse --verify --quiet "${local_sha}^" >/dev/null; then
      range="${local_sha}^..${local_sha}"
    else
      whole=1
    fi
  else
    range="${remote_sha}..${local_sha}"
  fi
  names="$(mktemp)"; added="$(mktemp)"
  scan_ok=1
  if [ "$whole" = 1 ]; then
    git diff --name-only --no-renames --diff-filter=AM "$empty_tree" "$local_sha" -- . ':!*.po' ':!*.pot' > "$names" 2>/dev/null || scan_ok=0
    git log -p --root --no-renames --format='commit %h' "$local_sha" -- . ':!*.po' ':!*.pot' > "$added" 2>/dev/null || scan_ok=0
  else
    git diff --name-only --no-renames --diff-filter=AM "$range" -- . ':!*.po' ':!*.pot' > "$names" 2>/dev/null || scan_ok=0
    git log -p --no-renames --format='commit %h' "$range" -- . ':!*.po' ':!*.pot' > "$added" 2>/dev/null || scan_ok=0
  fi
  if [ "$scan_ok" != 1 ]; then
    rm -f "$names" "$added"
    echo "✗ pre-push: refusing to push ${pushed}: could not diff ${range:-$local_sha} to scan it for credentials." >&2
    status=1
    continue
  fi
  leaks=''
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    hit="$(git show "${local_sha}:${f}" 2>/dev/null | grep -nE "$SECRET_PATTERNS" | sed -E "s/($SECRET_PATTERNS)/[REDACTED]/g" | head -3 || true)"
    [ -n "$hit" ] && leaks+="$(printf '%s\n' "$hit" | sed "s|^|  ${f}:|")"$'\n'
  done < "$names"
  # <commit>:<file>:<added line>, for every + line under every +++ b/<file>
  hit="$(awk '/^commit /{c=$2} /^\+\+\+ b\//{f=substr($0,7)} /^\+/ && !/^\+\+\+ /{print c ":" f ":" $0}' "$added" \
         | grep -E "$SECRET_PATTERNS" | sed -E "s/($SECRET_PATTERNS)/[REDACTED]/g" | head -3 || true)"
  [ -n "$hit" ] && leaks+="$(printf '%s\n' "$hit" | sed 's|^|  |')"$'\n'
  rm -f "$names" "$added"
  if [ -n "$leaks" ]; then
    echo "✗ pre-push: refusing to push ${pushed}: it carries lines shaped like credentials:" >&2
    printf '%s' "$leaks" >&2
    echo "  Placeholders belong in <angle brackets>. A real value has to come out of history before this pushes." >&2
    status=1
    continue
  fi

  # --- personal paths, pr/* only -------------------------------------------
  # Keyed on where the push LANDS. `git push origin feature/x:pr/x` used to
  # pass here because the local name was not pr/*.
  case "$remote_ref" in
    refs/heads/pr/*) ;;
    *) continue ;;
  esac

  dest="${remote_ref#refs/heads/}"
  branch="$dest"
  [ "$dest" = "$pushed" ] || branch="${dest} (pushed from ${pushed})"

  if [ -z "$base_ref" ]; then
    echo "✗ pre-push: refusing to push ${branch}: no upstream/next or origin/next to compare a pr/* branch against." >&2
    echo "  git fetch upstream, then push again." >&2
    status=1
    continue
  fi

  # Files that differ between clean upstream and this PR branch tip.
  if ! changed="$(git diff --name-only "$base_ref" "$local_sha" 2>/dev/null)"; then
    echo "✗ pre-push: refusing to push ${branch}: git diff ${base_ref} ${local_sha} failed, so the personal-path guard could not run." >&2
    status=1
    continue
  fi

  hits=''
  while IFS= read -r f; do
    [ -z "$f" ] && continue
    for pat in "${PERSONAL_PATTERNS[@]}"; do
      case "$f" in
        "$pat"|"$pat"*) hits+="    $f"$'\n' ;;
      esac
    done
  done <<< "$changed"

  if [ -n "$hits" ]; then
    {
      echo "✖ pre-push blocked: ${branch} carries personal artifacts that must not go upstream:"
      printf '%s' "$hits"
      echo "  Rebuild the PR branch from upstream by content, not by commit:"
      echo "    git worktree add --detach ../rocknix.worktrees/pr-tmp upstream/next"
      echo "    git switch -c ${dest} && git checkout next -- <the feature paths> && git commit"
    } >&2
    status=1
  fi

  # Unlisted-artifact check. Anything that exists only on `next` and lives
  # outside the feature areas is very likely a personal artifact nobody
  # remembered to add above - today every such file is one. This warns instead
  # of blocking, because a genuinely upstream-bound new file reaches a PR
  # branch by exactly the same route: features merge into `next` before they
  # are PR'd, so being next-only is not proof of being personal.
  if git rev-parse --verify --quiet "${base_ref}^{commit}" >/dev/null; then
    unlisted=''
    while IFS= read -r f; do
      [ -z "$f" ] && continue
      printf '%s\n' "$changed" | grep -Fxq -- "$f" || continue
      listed=0
      for pat in "${PERSONAL_PATTERNS[@]}"; do
        case "$f" in "$pat"|"$pat"*) listed=1; break ;; esac
      done
      [ "$listed" -eq 1 ] && continue
      unlisted+="    $f"$'\n'
    done <<< "$(git diff --name-only --diff-filter=A "$base_ref" next -- \
                . ':!packages' ':!projects' 2>/dev/null)"

    if [ -n "$unlisted" ]; then
      {
        echo "⚠ pre-push: ${branch} touches files that exist only on next and are not listed"
        echo "  in PERSONAL_PATTERNS:"
        printf '%s' "$unlisted"
        echo "  Personal? Add them to PERSONAL_PATTERNS in .githooks/pre-push."
        echo "  Genuinely upstream-bound? Nothing to do."
      } >&2
    fi
  fi

  # Console-first content guard: product surfaces (user-visible script text in
  # the cloud/backup tooling) must never mention QA/dev environments. QEMU/VM
  # guidance belongs in dev docs and release notes only.
  content_hits="$(git diff "$base_ref" "$local_sha" -- \
      'projects/ROCKNIX/packages/network/rclone/sources/' \
      'projects/ROCKNIX/packages/rocknix/sources/scripts/' \
    | grep -E '^\+' | grep -inE 'qemu|virtual machine|user-mode network|port forward|127\.0\.0\.1:15' || true)"
  if [ -n "$content_hits" ]; then
    {
      echo "✖ pre-push blocked: ${branch} adds dev/VM wording to product surfaces (console-first rule):"
      printf '%s\n' "$content_hits" | sed 's/^/    /'
      echo "  Move QA guidance to dev docs or release notes; product text is handheld+phone only."
    } >&2
    status=1
  fi
done

exit $status
