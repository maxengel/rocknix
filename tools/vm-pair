#
# Two GENERIC_X64 guests from one image, for the tests that need two devices
# against one cloud: a conflict is a change on both sides since they last
# agreed, and one guest cannot make one. Conflict and bisync testing runs
# here and never on a handheld (D-QA-009).
#
#   ./tools/vm-pair up <ROCKNIX-GENERIC_X64...img.gz>   # two 16 GiB disks, two headless guests, a QA key in each
#   ./tools/vm-pair ssh a 'uname -r'                     # a command over SSH (the harness's transport)
#   ./tools/vm-pair serial b 'df -h /storage'            # a command over the serial console
#   ./tools/vm-pair info                                 # ports, sockets, the key
#   ./tools/vm-pair down                                 # both, by pidfile
#   ./tools/vm-pair reimage b <other...img.gz>           # one guest rebuilt from another image, the other left running
#
# Guest a keeps generic-x64-vm's defaults (SSH 10022, monitor and serial at
# /tmp/rocknix-qemu-*.sock, pidfile /tmp/rocknix-qemu.pid, VNC :9, the
# profile's MAC 52:54:00:52:4E:58); guest b gets the same with a -b suffix,
# SSH 10023, VNC :10 and its own MAC, 52:54:00:52:4E:59. Both sit behind
# user-mode NAT, so a shared MAC would collide on no network -- but
# cloud_device_id hashes the permanent MAC, and two guests on the profile's
# address printed one id between them (fork #91): one settings folder, one
# manifest, and two-device fixtures agreeing with themselves. The id is
# derived on first boot and then stored on the disk, so a pair started before
# guest b had its own address keeps the shared id until `up` rebuilds the
# disks; clearing the stored id alone re-derives the same one. Both reach
# the host's QA backend at 10.0.2.2. Disks live under $VM_PAIR_DIR
# (default /tmp/rocknix-vm-pair): scratch, rebuilt from the image on every up.
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
ROOT=$(cd "$HERE/.." && pwd)
VM_TOOL="$ROOT/projects/ROCKNIX/devices/GENERIC_X64/vm/generic-x64-vm"
DIR="${VM_PAIR_DIR:-/tmp/rocknix-vm-pair}"
KEY="$DIR/qa-key"

# VM_GL=none puts the guests on the software renderer; the launcher's default
# is hardware GL through virgl on the host's first Mesa render node (#291), and
# the harness takes its frames over the VNC display when the monitor has no surface.
# Per-guest settings: letter -> monitor serial pidfile vnc sshport mac
# (every `read` below names all six: the last variable takes the rest of the
# line, so a field added here without a slot there lands in the one before it)
settings() {
  case "$1" in
    a) echo "/tmp/rocknix-qemu-monitor.sock /tmp/rocknix-qemu-serial.sock /tmp/rocknix-qemu.pid 9 10022 52:54:00:52:4E:58" ;;
    b) echo "/tmp/rocknix-qemu-monitor-b.sock /tmp/rocknix-qemu-serial-b.sock /tmp/rocknix-qemu-b.pid 10 10023 52:54:00:52:4E:59" ;;
    *) echo "vm-pair: guest is a or b, not '$1'" >&2; exit 2 ;;
  esac
}

# One guest booted from its disk, with its own settings.
start_one() {
  local mon ser pid vnc port mac
  read -r mon ser pid vnc port mac <<<"$(settings "$1")"
  "$VM_TOOL" run --headless --daemonize ${VM_GL:+--gl "$VM_GL"} --monitor "$mon" --serial "$ser" --pidfile "$pid" --vnc "$vnc" --ssh-port "$port" --mac "$mac" "$DIR/vm-$1.qcow2" 2>&1 | grep -v pw.conf || true
  echo "up: $1 (pid $(cat "$pid"), ssh :$port, serial $ser, mac $mac)"
}

# The QA key in by serial, then SSH answering with the guest's BUILD_ID; 1
# when it did not answer within 300 s. Polled with the bound tools/vm-qa
# gives it, not one attempt: sshd comes up after the serial console does,
# and on a host that is also building an image the gap is tens of seconds --
# a single try reported "guest a did not answer" for a guest that answered
# ten seconds later, and took the whole pair down with it (#125).
ready_one() {
  local ser port pub who t0
  read -r _ ser _ _ port _ <<<"$(settings "$1")"
  "$HERE/vm-serial" --socket "$ser" wait --up-to 300 >/dev/null
  pub=$(cat "$KEY.pub")
  "$HERE/vm-serial" --socket "$ser" sh "mkdir -p /storage/.ssh && chmod 700 /storage/.ssh && echo '$pub' >> /storage/.ssh/authorized_keys && chmod 600 /storage/.ssh/authorized_keys" >/dev/null
  who=""; t0=$(date +%s)
  for _ in $(seq 1 100); do
    who=$(ssh -i "$KEY" -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR -o ConnectTimeout=8 root@127.0.0.1 'grep ^BUILD_ID= /etc/os-release | cut -c11-20' 2>/dev/null || true)
    if [ -n "$who" ]; then break; fi
    sleep 3
  done
  if [ -n "$who" ]; then
    echo "ready: $1 on $who over ssh :$port (answered after $(( $(date +%s) - t0 ))s)"
  else
    echo "vm-pair: guest $1 did not answer over ssh within 300s" >&2; return 1
  fi
}

stop_one() {
  read -r _ _ pid _ _ _ <<<"$(settings "$1")"
  if [ -f "$pid" ] && kill -0 "$(cat "$pid")" 2>/dev/null; then
    kill "$(cat "$pid")" && echo "down: $1 (pid $(cat "$pid"))"
  fi
  rm -f "$pid"
}

case "${1:-}" in
  up)
    img="${2:-}"; [ -f "$img" ] || { echo "usage: vm-pair up <ROCKNIX-GENERIC_X64...img.gz>" >&2; exit 2; }
    stop_one a; stop_one b; sleep 1
    mkdir -p "$DIR"; rm -f "$DIR"/vm-*.qcow2 "$DIR"/vm-*.ovmf-vars.fd
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -f "$KEY" -C vm-pair
    # one raw image, two disks
    gunzip -c "$img" > "$DIR/image.img"
    for g in a b; do
      qemu-img convert -f raw -O qcow2 "$DIR/image.img" "$DIR/vm-$g.qcow2"
      qemu-img resize "$DIR/vm-$g.qcow2" 16G >/dev/null
    done
    rm -f "$DIR/image.img"
    for g in a b; do start_one "$g"; done
    for g in a b; do ready_one "$g" || exit 1; done
    ;;
  reimage)
    # One guest rebuilt from another image while the other runs on: the
    # mixed-installation test's previous build beside a new one
    # (tools/cloud-pair-migration). Its own disk, settings, key and wait.
    g="${2:-}"; img="${3:-}"
    settings "$g" >/dev/null || exit 2
    [ -f "$img" ] || { echo "usage: vm-pair reimage <a|b> <ROCKNIX-GENERIC_X64...img.gz>" >&2; exit 2; }
    stop_one "$g"; sleep 1
    mkdir -p "$DIR"; rm -f "$DIR/vm-$g.qcow2" "$DIR/vm-$g.ovmf-vars.fd"
    [ -f "$KEY" ] || ssh-keygen -q -t ed25519 -N '' -f "$KEY" -C vm-pair
    gunzip -c "$img" > "$DIR/image-$g.img" || exit 1
    qemu-img convert -f raw -O qcow2 "$DIR/image-$g.img" "$DIR/vm-$g.qcow2" || exit 1
    qemu-img resize "$DIR/vm-$g.qcow2" 16G >/dev/null || exit 1
    rm -f "$DIR/image-$g.img"
    start_one "$g"
    ready_one "$g" || exit 1
    ;;
  down) stop_one a; stop_one b ;;
  ssh)
    read -r _ _ _ _ port _ <<<"$(settings "${2:-}")"; shift 2
    exec ssh -i "$KEY" -p "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR root@127.0.0.1 "$@" ;;
  scp)
    # vm-pair scp <a|b> <local file> <remote path>: the pair's key and the
    # guest's port, so a caller never carries them (vm-upgrade-rehearsal did,
    # audit #258 PL-030).
    read -r _ _ _ _ port _ <<<"$(settings "${2:-}")"; shift 2
    exec scp -q -i "$KEY" -P "$port" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o BatchMode=yes -o LogLevel=ERROR "$1" "root@127.0.0.1:$2" ;;
  port)
    read -r _ _ _ _ port _ <<<"$(settings "${2:-}")"; echo "$port" ;;
  serial)
    read -r _ ser _ _ _ _ <<<"$(settings "${2:-}")"; shift 2
    exec "$HERE/vm-serial" --socket "$ser" sh "$@" ;;
  info)
    for g in a b; do read -r mon ser pid vnc port mac <<<"$(settings "$g")"; printf '%s: ssh -i %s -p %s root@127.0.0.1   monitor %s   serial %s   pid %s   vnc :%s   mac %s\n' "$g" "$KEY" "$port" "$mon" "$ser" "$([ -f "$pid" ] && cat "$pid" || echo -)" "$vnc" "$mac"; done ;;
  *) sed -n '2,29p' "$0" | sed 's/^# \{0,1\}//'; exit 2 ;;
esac
