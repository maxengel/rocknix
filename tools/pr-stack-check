#
# pr-stack-check - build the upstream series by content and prove it is whole.
#
#   tools/pr-stack-check [--map FILE] [--keep] [--base REF] [--from REF]
#
# Reads docs/pr-series/map.txt (one `## title` per PR, in order, then the
# paths `git checkout <from> -- <path>` takes; `#` comments), makes a throwaway
# worktree on --base (default upstream/next), and stacks one commit per PR by
# content from --from (default next): a path that exists on next is checked
# out, a path next deleted is removed. Then it fails unless
#
#   1. every path the map names differs from the base somewhere (a dead line
#      in the map is a PR that claims what it does not carry);
#   2. no personal path (the push guard's PERSONAL_PATTERNS, read from
#      .githooks/pre-push) is named;
#   3. every upstream-bound file that differs between the base and next is
#      carried by exactly one PR -- an uncovered file fails, and so does one
#      two PRs both name;
#   4. the last head equals next on every upstream-bound path: zero files
#      differing under packages/, projects/, scripts/, config/, distributions/,
#      Makefile and tools/ minus the personal tools.
#
# It prints each PR's file list with counts. --keep leaves the worktree and
# its pr-stack/N branches for cutting the real pr/* branches from; without it
# the worktree and branches go (tools/fork-worktree remove, which refuses
# build output, of which a fresh worktree has none). Exit 0 only on PASS;
# 1 on any failure; 2 on usage or a base next does not contain (merge
# upstream first, or the diff is not the fork's).
#
# Why by content and not by commit: fork-workflow.md. Why a tool: #322's
# rule that the series must leave upstream with exactly the tree that was
# built and proven; a hand-made stack has no such proof (blindspot 47's
# shape, seen from the other side).
set -u
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
MAP="${ROOT}/docs/pr-series/map.txt"; BASE=upstream/next; FROM=next; KEEP=0
while [ $# -gt 0 ]; do
  case "$1" in
    --map) MAP="$2"; shift 2 ;;
    --base) BASE="$2"; shift 2 ;;
    --from) FROM="$2"; shift 2 ;;
    --keep) KEEP=1; shift ;;
    -h|--help) sed -n '5,40p' "$0"; exit 0 ;;
    *) echo "pr-stack-check: unknown argument $1" >&2; exit 2 ;;
  esac
done
cd "${ROOT}" || exit 2
[ -f "${MAP}" ] || { echo "pr-stack-check: no map at ${MAP}" >&2; exit 2; }
git rev-parse --verify -q "${BASE}" >/dev/null || { echo "pr-stack-check: no ref ${BASE}" >&2; exit 2; }
git rev-parse --verify -q "${FROM}" >/dev/null || { echo "pr-stack-check: no ref ${FROM}" >&2; exit 2; }
if ! git merge-base --is-ancestor "${BASE}" "${FROM}"; then
  echo "pr-stack-check: ${FROM} does not contain ${BASE}: merge it first, or the diff below is not only the fork's" >&2; exit 2
fi
FAIL=0; fail() { echo "FAIL: $*"; FAIL=1; }

# The upstream-bound roots, and the personal patterns the push guard refuses.
ROOTS=(packages projects scripts config distributions Makefile tools)
mapfile -t PERSONAL < <(sed -n '/^PERSONAL_PATTERNS=(/,/^)/p' "${ROOT}/.githooks/pre-push" | grep -o "^\s*'[^']*'" | tr -d " '")
[ "${#PERSONAL[@]}" -gt 5 ] || { echo "pr-stack-check: could not read PERSONAL_PATTERNS from .githooks/pre-push" >&2; exit 2; }
is_personal() { local p; for p in "${PERSONAL[@]}"; do case "$1" in "${p}"*) return 0 ;; esac; done; return 1; }

# Every upstream-bound file that differs between the base and FROM.
mapfile -t DIFF < <(git diff --name-only "${BASE}" "${FROM}" -- "${ROOTS[@]}" | while read -r f; do is_personal "$f" || echo "$f"; done)
[ "${#DIFF[@]}" -gt 0 ] || { echo "pr-stack-check: nothing differs between ${BASE} and ${FROM} on the upstream-bound roots"; exit 1; }

# Parse the map: titles and paths, in order.
declare -a TITLES; declare -A PATHS_OF; n=-1
while IFS= read -r line; do
  case "$line" in
    '## '*) n=$((n+1)); TITLES[$n]="${line#\#\# }"; PATHS_OF[$n]="" ;;
    '#'*|'') ;;
    *) [ "$n" -ge 0 ] || { echo "pr-stack-check: a path before the first ## title: $line" >&2; exit 2; }
       PATHS_OF[$n]+="${line}"$'\n' ;;
  esac
done < "${MAP}"
[ "$n" -ge 0 ] || { echo "pr-stack-check: the map names no PR" >&2; exit 2; }

# Which diff files each map path covers (a directory covers what is under it).
declare -A OWNER   # file -> PR index
declare -a FILES_OF
for i in $(seq 0 "$n"); do
  FILES_OF[$i]=""
  while IFS= read -r p; do
    [ -n "$p" ] || continue
    is_personal "$p" && fail "PR $((i+1)) names a personal path: $p"
    hit=0
    for f in "${DIFF[@]}"; do
      if [ "$f" = "$p" ] || [ "${f#"$p"/}" != "$f" ]; then
        hit=1
        if [ -n "${OWNER[$f]:-}" ] && [ "${OWNER[$f]}" != "$i" ]; then fail "$f is named by PR $((OWNER[$f]+1)) and PR $((i+1))"; fi
        OWNER[$f]="$i"; FILES_OF[$i]+="${f}"$'\n'
      fi
    done
    [ "$hit" = 1 ] || fail "PR $((i+1)) names a path that does not differ from ${BASE}: $p"
  done <<< "${PATHS_OF[$i]}"
done
for f in "${DIFF[@]}"; do [ -n "${OWNER[$f]:-}" ] || fail "no PR carries $f"; done

# Build the stack in a throwaway worktree.
WT="${ROOT}/../rocknix.worktrees/pr-stack-check"
if [ -e "${WT}" ]; then echo "pr-stack-check: ${WT} exists; remove it with tools/fork-worktree remove first" >&2; exit 2; fi
for i in $(seq 0 "$n"); do git branch -D "pr-stack/$((i+1))" >/dev/null 2>&1 || true; done
git worktree add -q --detach "${WT}" "${BASE}" || { echo "pr-stack-check: could not add the worktree" >&2; exit 2; }
cleanup() { if [ "${KEEP}" = 0 ]; then "${ROOT}/tools/fork-worktree" remove "${WT}" >/dev/null 2>&1 || git worktree remove "${WT}" >/dev/null 2>&1; for i in $(seq 0 "$n"); do git branch -D "pr-stack/$((i+1))" >/dev/null 2>&1 || true; done; fi; }
trap cleanup EXIT
for i in $(seq 0 "$n"); do
  echo "== PR $((i+1)): ${TITLES[$i]}"
  count=0
  while IFS= read -r f; do
    [ -n "$f" ] || continue
    if git -C "${ROOT}" cat-file -e "${FROM}:${f}" 2>/dev/null; then
      git -C "${WT}" checkout -q "${FROM}" -- "$f" || fail "PR $((i+1)): could not check out $f"
    else
      git -C "${WT}" rm -q -f -- "$f" 2>/dev/null || fail "PR $((i+1)): $f is deleted on ${FROM} and could not be removed"
    fi
    count=$((count+1)); echo "   $f"
  done <<< "${FILES_OF[$i]}"
  echo "   ($count files)"
  if [ "$count" = 0 ]; then fail "PR $((i+1)) carries no file"; continue; fi
  git -C "${WT}" commit -q --allow-empty -m "${TITLES[$i]}" || fail "PR $((i+1)): commit failed"
  git -C "${WT}" branch -f "pr-stack/$((i+1))" HEAD
done

# The last head must equal FROM on every upstream-bound path.
mapfile -t LEFT < <(git diff --name-only "$(git -C "${WT}" rev-parse HEAD)" "${FROM}" -- "${ROOTS[@]}" | while read -r f; do is_personal "$f" || echo "$f"; done)
if [ "${#LEFT[@]}" -gt 0 ]; then fail "the last head differs from ${FROM} on ${#LEFT[@]} upstream-bound file(s):"; printf '   %s\n' "${LEFT[@]}"; fi
if [ "${FAIL}" = 0 ]; then
  echo "pr-stack-check: PASS -- $((n+1)) PRs carry all ${#DIFF[@]} upstream-bound files, and the last head equals ${FROM} (0 differing)"
  [ "${KEEP}" = 1 ] && echo "kept: ${WT} on pr-stack/$((n+1)); branches pr-stack/1..$((n+1))"
  exit 0
fi
echo "pr-stack-check: FAIL"; exit 1
