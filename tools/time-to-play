class Guest:
    """One SSH channel to the guest, held open.

    ControlMaster because the POST that starts a launch goes over it and the
    number being measured is in tenths of a second: a fresh TCP connection
    and key exchange per command would be most of the first repeat's answer.
    drop_master() exists because an admin-down link or a blackholed route
    does not reset an established connection -- it stalls it -- so anything
    that cuts the guest's path to 10.0.2.2 closes the master first."""

    def __init__(self, host, port, key):
        self.host, self.port, self.key = host, str(port), key
        self.cp = "/tmp/ttp-cm-%d" % os.getpid()

    def _opts(self, master=True):
        o = ["-o", "StrictHostKeyChecking=no", "-o", "UserKnownHostsFile=/dev/null",
             "-o", "LogLevel=ERROR", "-o", "ConnectTimeout=8", "-o", "BatchMode=yes"]
        if self.key:
            o += ["-i", self.key]
        if master:
            o += ["-o", "ControlMaster=auto", "-o", "ControlPath=" + self.cp,
                  "-o", "ControlPersist=120"]
        return o

    def sh(self, cmd, timeout=60, master=True):
        try:
            # errors="replace", not text=True: the guest's log is UTF-8 and
            # busybox `cut -c` counts BYTES, so a line trimmed for the report
            # can end mid-character. A whole run died on one 0xc3 while
            # collecting the portal cell's log (2026-09-12); a measurement
            # must not be lost to a byte in a diagnostic.
            p = subprocess.run(["ssh", "-n", "-p", self.port] + self._opts(master) + [self.host, cmd],
                               capture_output=True, timeout=timeout,
                               encoding="utf-8", errors="replace")
            return p.returncode, p.stdout.strip()
        except subprocess.TimeoutExpired:
            return 255, ""

    def put(self, local, remote):
        subprocess.run(["scp", "-q", "-P", self.port] + self._opts() + [local, self.host + ":" + remote],
                       capture_output=True)

    def drop_master(self):
        subprocess.run(["ssh", "-O", "exit", "-o", "ControlPath=" + self.cp,
                        "-p", self.port, self.host], capture_output=True)

    def alive(self, timeout=8):
        return self.sh("true", timeout=timeout, master=False)[0] == 0

    def wait_alive(self, budget=180):
        end = time.monotonic() + budget
        while time.monotonic() < end:
            if self.alive(timeout=6):
                return True
            time.sleep(2)
        return False

    # --- the things this cell asks the guest ------------------------------

    def retroarch(self):
        """(pid, cpu ticks) while RetroArch runs, else None."""
        rc, out = self.sh(RA_PROBE, timeout=15)
        if not out:
            return None
        parts = out.split()
        try:
            return int(parts[0]), int(parts[1])
        except (IndexError, ValueError):
            return None

    def stamp(self, name):
        """The raw last-sync-<name> line, or ''."""
        return self.sh("cat %s/last-sync-%s 2>/dev/null" % (STAMP_DIR, name), timeout=15)[1]

    def es_up(self):
        return self.sh("pgrep -x emulationstation >/dev/null && echo y", timeout=15)[1] == "y"

    def launch(self, rom=ROM):
        """EmulationStation's own launch path, as pressing A on the game is.

        The HTTP API listens on the guest's loopback only, so the POST is
        made from inside the guest. ViewController::launch is what handles
        it -- the same function the A press reaches -- so the exit sync,
        the launch gate and the splash all behave exactly as for a player."""
        return self.sh("curl -s -o /dev/null -w '%%{http_code}' -X POST "
                       "-H 'Content-Type: text/plain' --data '%s' "
                       "http://127.0.0.1:1234/launch" % rom, timeout=25)[1]

    def kill_game(self):
        """The shipped execute_kill, from the installed input_sense."""
        return self.sh("/tmp/ttp-kill", timeout=20)[0]


GB_PROBE = "/storage/roms/gb/TTProbe.gb"
GB_LOGO = ("CEED6666CC0D000B03730083000C000D0008111F8889000EDC"
           "CC6EE6DDDDD999BBBB67636E0EECCCDDDC999FBBB9333E")


def build_gb_probe(path):
    """A cartridge that does nothing but draw.

    The runner's guests carry no ROM of their own, and a cell that cannot
    press a game on a fresh pair is a cell that never runs. This is the
    exit test's cartridge with its job swapped: that one writes a battery
    save and this one turns the LCD on with a blank background, because
    what this cell needs from a game is a frame that is NOT the black
    handover screen. Not shared with tools/emulator-exit-test, because the
    two carts have no line of behaviour in common -- only the twenty bytes
    of header every Game Boy ROM has."""
    rom = bytearray(0x8000)
    rom[0x100:0x104] = bytes([0x00, 0xC3, 0x50, 0x01])      # NOP ; JP $0150
    rom[0x104:0x134] = bytes.fromhex(GB_LOGO)
    rom[0x134:0x13B] = b"TTPROBE"
    rom[0x147] = 0x00   # ROM ONLY; nothing here needs a battery
    rom[0x148] = 0x00   # 32 KiB
    rom[0x149] = 0x00
    rom[0x14A] = 0x01
    rom[0x14B] = 0x33
    x = 0
    for i in range(0x134, 0x14D):
        x = (x - rom[i] - 1) & 0xFF
    rom[0x14D] = x
    rom[0x150:0x15B] = bytes([
        0xF3,              # DI
        0x3E, 0xE4,        # LD A,$E4     the usual BGP
        0xE0, 0x47,        # LDH ($47),A
        0x3E, 0x91,        # LD A,$91     LCD on, BG on, tiles at $8000
        0xE0, 0x40,        # LDH ($40),A
        0x18, 0xFE,        # JR -2        spin
    ])
    with open(path, "wb") as fh:
        fh.write(bytes(rom))


def ensure_rom(g, rom, workdir):
    """The game this cell presses, and whether it had to make one.

    EmulationStation launches what it has scanned, so a ROM dropped on the
    guest is invisible until it looks again -- and a restart is not enough
    to look at from here: screendump serves the previous instance's last
    frame for half a minute afterwards (generic-x64-vm-testing.md), which
    is exactly the window this cell measures in. A reboot costs about a
    minute and has neither problem."""
    if g.sh("test -f '%s' && echo y" % rom)[1] == "y":
        return rom, False
    local = os.path.join(workdir, "TTProbe.gb")
    build_gb_probe(local)
    g.sh("mkdir -p /storage/roms/gb")
    g.put(local, GB_PROBE)
    return GB_PROBE, True


def reboot_guest(g):
    """Reboot and wait for EmulationStation, then a moment for its first frame."""
    g.sh("systemctl reboot")
    g.drop_master()
    time.sleep(8)
    g.wait_alive(240)
    for _ in range(60):
        if g.es_up():
            break
        time.sleep(2)
    time.sleep(12)


