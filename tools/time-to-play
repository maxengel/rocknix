# main


def main():
    ap = argparse.ArgumentParser(
        description="Measure time to play on one GENERIC_X64 guest (#135).",
        formatter_class=argparse.RawDescriptionHelpFormatter,
        epilog=__doc__)
    ap.add_argument("--host", default="root@127.0.0.1")
    ap.add_argument("--port", default="10022", help="the guest's forwarded SSH port")
    ap.add_argument("--identity", default="/tmp/rocknix-vm-pair/qa-key")
    ap.add_argument("--monitor", required=True, help="the guest's QEMU monitor socket")
    ap.add_argument("--backend", default=os.environ.get("CLOUD_QA_BACKEND", "webdav"),
                    help="which QA cloud the guest's remote points at")
    ap.add_argument("--repeat", type=int, default=5)
    ap.add_argument("--out", required=True)
    ap.add_argument("--only", default="launch,exit,g2g,startup,offline,bounds",
                    help="cells to run: launch,exit,g2g,startup,offline,bounds")
    ap.add_argument("--label", default="", help="the host state these numbers were taken under")
    ap.add_argument("--payload", default="full", choices=("full", "srm"),
                    help="full: an auto-state, two manual states, their screenshots and a battery save "
                         "(D-CLOUD-116). srm: one changed battery save (P-13).")
    ap.add_argument("--rom", default=ROM)
    ap.add_argument("--conditions", default="",
                    help="only these offline/bounds cells, comma separated "
                         "(dead,noroute,blackhole,linkdown,portal,stall)")
    ap.add_argument("--stall-budget", type=float, default=420.0,
                    help="how long to watch the stalled-endpoint cell before giving up")
    ap.add_argument("--quick", action="store_true",
                    help="the runner's bounded form: one repeat of launch+exit+g2g, no reboot, no fixtures")
    ap.add_argument("--no-configure-remote", action="store_true",
                    help="leave the guest's rclone.conf alone (it already points where you want)")
    ap.add_argument("--vm", action="store_true",
                    help="the guest is a QEMU VM with no Vulkan: set RetroArch's video driver to gl "
                         "for the run and put it back after (the exit test's rule). Never for a handheld.")
    args = ap.parse_args()

    if args.quick:
        args.repeat = 1
        args.only = "launch,exit,g2g"

    only = [c.strip() for c in args.only.split(",") if c.strip()]
    out = os.path.abspath(args.out)
    os.makedirs(out, exist_ok=True)
    frames_dir = os.path.join(out, "frames")
    tool = os.path.join(HERE, "cloud-test-backend")

    g = Guest(args.host, args.port, args.identity)
    if not g.wait_alive(120):
        print("time-to-play: guest at %s does not answer" % args.port, file=sys.stderr)
        return 1
    # EmulationStation reads cloudsaves.gameexit and cloudsaves.startup when
    # it starts and keeps them in memory; set_setting changes the file and
    # nothing else. So the values this cell needs go into the file BEFORE the
    # boot the cell relies on, and a guest whose interface booted on other
    # values is rebooted -- or the exit sync never runs, the stamp never
    # appears, and the cell reports nothing (the runner's second dispatch,
    # fresh pair, 2026-09-12: file 1, interface booted on 0, no stamp; a
    # reboot with the file at 1, stamp `completed`).
    saved_startup = g.sh(". /etc/profile; get_setting cloudsaves.startup")[1]
    saved_gameexit = g.sh(". /etc/profile; get_setting cloudsaves.gameexit")[1]
    g.sh(". /etc/profile; set_setting cloudsaves.gameexit 1; set_setting cloudsaves.startup 0", timeout=120)
    settings_changed = (saved_gameexit != "1") or (saved_startup not in ("0", ""))
    # Before the helpers: a seeded ROM costs a reboot, and /tmp is a tmpfs.
    made = {"rom": False}
    rom, made["rom"] = ensure_rom(g, args.rom, out)
    if made["rom"] or settings_changed:
        reboot_guest(g)
    install_helpers(g)

    build = g.sh('sed -n "s/^BUILD_ID=//p" /etc/os-release')[1].strip('"')[:10]
    report = {
        "build": build, "backend": args.backend, "port": args.port,
        "repeat": args.repeat, "payload": args.payload,
        "host_state": args.label or "(not stated)",
        "started": time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime()),
        "rom": rom, "rom_seeded": made["rom"],
        "interface_rebooted": bool(made["rom"] or settings_changed),
        "settings_before": {"gameexit": saved_gameexit, "startup": saved_startup},
        "cells": {},
    }

    # Everything this cell changes on the guest, and the value to put back.
    saved_conf = os.path.join(out, "rclone.conf.saved")
    saved_cloud = os.path.join(out, "cloud_sync.conf.saved")
    subprocess.run(["scp", "-q", "-P", g.port] + g._opts() +
                   [g.host + ":" + RCLONE_CONF, saved_conf], capture_output=True)
    subprocess.run(["scp", "-q", "-P", g.port] + g._opts() +
                   [g.host + ":" + CLOUD_CONF, saved_cloud], capture_output=True)
    # A QEMU guest has no Vulkan. Left on the image's default, RetroArch
    # exists for a fifth of a second and never draws, the exit sync never
    # runs, and every headline number below is a dash -- which is what the
    # runner's first dispatch of this cell reported as a PASS (2026-09-12).
    # The exit test has always swapped the driver for its run; so does this.
    saved_vd = ""
    if args.vm:
        saved_vd = g.sh('grep -E "^video_driver" ' + RETROARCH_CFG)[1].strip()
        g.sh("sed -i 's/^video_driver = .*/video_driver = \"gl\"/' " + RETROARCH_CFG)
    fixtures = []

    def restore():
        for f in fixtures:
            f.down()
        if os.path.exists(saved_conf) and os.path.getsize(saved_conf) > 0:
            g.put(saved_conf, RCLONE_CONF)
            g.sh("chmod 600 " + RCLONE_CONF)
        if os.path.exists(saved_cloud) and os.path.getsize(saved_cloud) > 0:
            g.put(saved_cloud, CLOUD_CONF)
        g.sh("ip route show default | grep -q . || ip route add default via 10.0.2.2 dev eth0 2>/dev/null; "
             "ip route del blackhole 10.0.2.2/32 2>/dev/null; true")
        g.sh(". /etc/profile; set_setting cloudsaves.startup %s; set_setting cloudsaves.gameexit %s"
             % (saved_startup or "0", saved_gameexit or "1"), timeout=120)
        g.sh("rm -f /tmp/ttp-kill /tmp/ttp-arm.sh")
        if args.vm and saved_vd:
            g.sh("sed -i 's/^video_driver = .*/%s/' %s"
                 % (saved_vd.replace("\\", "\\\\").replace("/", "\\/").replace("&", "\\&"), RETROARCH_CFG))
        if made["rom"]:
            g.sh("rm -f %s; rmdir /storage/roms/gb 2>/dev/null; true" % GB_PROBE)

    def on_signal(signum, _frame):
        restore()
        sys.exit(128 + signum)

    signal.signal(signal.SIGINT, on_signal)
    signal.signal(signal.SIGTERM, on_signal)

    fr = Frames(args.monitor, frames_dir)
    try:
        # The harness's own cost, reported beside the numbers rather than
        # subtracted from them: the POST that starts a launch goes over the
        # SSH channel, so its round trip is inside the launch number.
        rtts = []
        for _ in range(7):
            a = time.monotonic()
            g.sh("true")
            rtts.append(time.monotonic() - a)
        fps = []
        for _ in range(5):
            a = time.monotonic()
            fr.frame()
            fps.append(time.monotonic() - a)
        report["ssh_rtt_median_s"] = round(statistics.median(rtts), 4)
        report["frame_poll_median_s"] = round(statistics.median(fps), 4)

        if not args.no_configure_remote:
            set_conf(g, subprocess.run([tool, "--backend", args.backend, "rclone-conf"],
                                       capture_output=True, text=True).stdout)
            # And the three remote PATHS, which are a different shape on every
            # backend: a folder on WebDAV and FTP, a bucket or a share first on
            # S3 and SMB, an absolute filesystem path on SFTP. Writing the
            # stanza without writing these ran the whole cell against
            # /ROCKNIX/Saves on an sshd that cannot create it.
            prefix = subprocess.run([tool, "--backend", args.backend, "endpoint-prefix"],
                                    capture_output=True, text=True).stdout.strip()
            g.sh("sed -i 's#^SAVES_REMOTE=.*#SAVES_REMOTE=\"%s/ROCKNIX/Saves\"#; "
                 "s#^SETTINGS_REMOTE=.*#SETTINGS_REMOTE=\"%s/ROCKNIX/Backups\"#; "
                 "s#^CONTENT_REMOTE=.*#CONTENT_REMOTE=\"%s/ROCKNIX/Content\"#' %s"
                 % (prefix, prefix, prefix, CLOUD_CONF))
            report["remotes"] = g.sh(
                "grep -E '^(SAVES_REMOTE|SETTINGS_REMOTE|CONTENT_REMOTE)=' " + CLOUD_CONF)[1]
        g.sh(". /etc/profile; set_setting cloudsaves.gameexit 1", timeout=120)
        report["remote_reachable"] = g.sh(
            "rclone lsd qa-cloud: --contimeout 10s --timeout 20s --low-level-retries 1 --retries 1 "
            ">/dev/null 2>&1 && echo yes || echo no", timeout=60)[1]

        def cycle(tag, relaunch, jitter, keep_frames=False):
            """One whole online cycle: seed, launch, play, exit."""
            size = seed_payload(g, jitter, args.payload)
            # The screen the launch started from IS the screen the card
            # will have to leave, so it is the one to compare against. It
            # used to be re-taken after the game had started, which made
            # the reference a picture of the game -- and the card then
            # never "went", on any repeat.
            L, rest_ref = measure_launch(g, fr, tag + "-launch", rom=rom)
            L["payload_kib"] = size
            wait_drawing(g)
            E = measure_exit(g, fr, tag + "-exit", rest_ref, relaunch=relaunch,
                             keep_frames=keep_frames, rom=rom)
            E["payload_kib"] = size
            E["log"] = g.sh("tail -25 /var/log/cloud_sync.log 2>/dev/null | cut -c1-200")[1]
            if relaunch:
                # game two is running; end it and let its own sync settle
                wait_drawing(g, budget=30)
                settle_sync(g)
            return L, E

        # --- launch + exit, the online baseline ---------------------------
        if "launch" in only or "exit" in only:
            L, E = [], []
            for i in range(args.repeat):
                a, b = cycle("r%d" % (i + 1), False, i, keep_frames=(i == 0))
                L.append(a)
                E.append(b)
                settle_sync(g)
            report["cells"]["launch"] = L
            report["cells"]["exit"] = E

        # --- game to game -------------------------------------------------
        if "g2g" in only:
            G2 = []
            for i in range(args.repeat):
                _, b = cycle("g%d" % (i + 1), True, i, keep_frames=(i == 0))
                G2.append(b)
                settle_sync(g)
            report["cells"]["g2g"] = G2

        # --- the startup sync ---------------------------------------------
        if "startup" in only:
            report["cells"]["startup"] = measure_startup(g, fr, args, out, rom)

        # --- offline and bounds -------------------------------------------
        conds = []
        if "offline" in only:
            conds += ["dead", "noroute", "blackhole", "linkdown", "portal"]
        if "bounds" in only:
            for c in ("dead", "stall", "portal"):
                if c not in conds:
                    conds.append(c)
        if args.conditions:
            want = [c.strip() for c in args.conditions.split(",") if c.strip()]
            conds = [c for c in want if c in conds] or want
        results = {}
        routes = read_routes(g) if conds else None
        for cond in conds:
            results[cond] = run_condition(g, fr, cond, args, tool, fixtures, rom, routes)
            # put the remote back between conditions
            if not args.no_configure_remote:
                set_conf(g, subprocess.run([tool, "--backend", args.backend, "rclone-conf"],
                                           capture_output=True, text=True).stdout)
            settle_sync(g)
        if results:
            report["cells"]["conditions"] = results
    finally:
        try:
            fr.close()
        except Exception:
            pass
        restore()
        g.drop_master()

    report["finished"] = time.strftime("%Y-%m-%d %H:%M UTC", time.gmtime())
    md = render(report)
    # A run that ran cleanly and measured nothing is not a pass. The first
    # dispatch from the runner printed every headline as "-" and exited 0
    # (RetroArch never drew; see --vm), and the report table said PASS.
    missing = headline_missing(report)
    report["headline_missing"] = missing
    over = over_budget(report)
    report["over_budget"] = over
    if missing:
        md += "\n**Not a pass:** " + "; ".join(missing) + ".\n"
    if over:
        md += "\n**Over budget:** " + "; ".join(over) + ".\n"
    with open(os.path.join(out, "time-to-play.json"), "w") as fh:
        json.dump(report, fh, indent=1)
    with open(os.path.join(out, "time-to-play.md"), "w") as fh:
        fh.write(md)
    print(md)
    print("frames and json: %s" % out)
    if missing or over:
        print("time-to-play: FAIL -- " + "; ".join(missing + over), file=sys.stderr)
        return 1
    return 0


# The budgets the register carries, and a run over one fails the suite (#135
# AC 2). D-CLOUD-119 (2026-09-12): the exit sync of one changed battery save
# on a hashed cloud within 3 s -- measured 0.79 s on S3, 1.0-1.7 s with the
# full payload on WebDAV and SFTP. Judged on the median of the exit cell's
# stamp time, the same number the report's headline shows; a cell that did
# not run is not judged (headline_missing says so). No row yet bounds the
# launch (0.6-0.9 s measured) or the game-to-game number, so neither fails.
EXIT_SYNC_BUDGET_S = 3.0

def over_budget(report):
    out = []
    rows = [r for r in (report["cells"].get("exit") or []) if r.get("t_sync_stamp") is not None]
    if rows:
        med = statistics.median(r["t_sync_stamp"] for r in rows)
        if med > EXIT_SYNC_BUDGET_S:
            out.append("the exit sync's stamp took %.2f s (median of %d), over D-CLOUD-119's %.0f s"
                       % (med, len(rows), EXIT_SYNC_BUDGET_S))
    return out


def headline_missing(report):
    """The numbers this cell exists to report, and how many repeats lacked
    each. An assertion that cannot fail is not evidence
    (engineering-practices.md), and a table of dashes under a PASS line is
    exactly that. Cells that did not run are not judged."""
    checks = [("launch", "t_first_game_frame", "the game's first frame"),
              ("exit", "t_sync_stamp", "the exit sync's stamp"),
              ("g2g", "t_second_game_frame", "the next game's first frame")]
    out = []
    for cell, field, what in checks:
        rows = report["cells"].get(cell) or []
        n = sum(1 for r in rows if r.get(field) is None)
        if n:
            out.append("%s missing in %d of %d %s repeat(s)" % (what, n, len(rows), cell))
    return out


def measure_startup(g, fr, args, out, rom=ROM):
    """Boot to the startup card's end, and a launch pressed while it runs."""
    res = {}
    g.sh(". /etc/profile; set_setting cloudsaves.startup 1", timeout=180)
    seed_payload(g, 3, args.payload)
    for arm, launch_during in (("boot", False), ("boot-launch", True)):
        before = g.stamp("startup")
        t0 = time.monotonic()
        g.sh("systemctl reboot")
        g.drop_master()
        time.sleep(6)
        entry = {"stamp_before": before}
        if not g.wait_alive(240):
            entry["error"] = "the guest did not come back"
            res[arm] = entry
            continue
        entry["t_ssh_back"] = round(time.monotonic() - t0, 2)
        # EmulationStation, then the stamp the startup sync writes
        es = None
        launched = None
        gameframe = None
        stamped = None
        prev = None
        end = time.monotonic() + 240
        while time.monotonic() < end:
            if es is None and g.es_up():
                es = time.monotonic()
                entry["t_es_up"] = round(es - t0, 2)
            if stamped is None:
                now = g.stamp("startup")
                if now and now != before:
                    stamped = time.monotonic()
                    entry["stamp_after"] = now
                    entry["t_startup_stamp"] = round(stamped - t0, 2)
                    if not launch_during:
                        break
            if launch_during and es is not None and launched is None and stamped is None:
                # press a game while the startup sync is still running
                launched = time.monotonic()
                entry["http"] = g.launch(rom)
                entry["t_launch_sent"] = round(launched - t0, 2)
            if launch_during and launched is not None and gameframe is None:
                f = fr.frame()
                if (prev is not None and vq.frame_diff(prev, f) >= vq.CHANGED_MIN
                        and not is_blank(f) and g.retroarch() is not None):
                    gameframe = time.monotonic()
                    entry["t_game_frame_after_launch"] = round(gameframe - launched, 2)
                    entry["png"] = fr.save("startup-%s-game" % arm, f)
                prev = f
            if launch_during and gameframe is not None and stamped is not None:
                break
            time.sleep(0.25)
        entry["stamp_after"] = entry.get("stamp_after") or g.stamp("startup")
        entry["stamp"] = parse_stamp(entry["stamp_after"])
        entry["exit_stamp"] = parse_stamp(g.stamp("exit"))
        if launch_during:
            wait_drawing(g, budget=40)
            g.kill_game()
            time.sleep(10)
        res[arm] = entry
    g.sh(". /etc/profile; set_setting cloudsaves.startup 0", timeout=180)
    return res


def run_condition(g, fr, cond, args, tool, fixtures, rom=ROM, routes=None):
    """One offline or bounds cell: set the condition, exit a game, measure."""
    entry = {"condition": cond}
    if routes:
        entry["routes_normalised"] = normalise_routes(g, routes)
    live = subprocess.run([tool, "--backend", args.backend, "rclone-conf"],
                          capture_output=True, text=True).stdout
    fixture = None
    if cond == "dead":
        entry["how"] = "the remote points at the refused port %d" % DEAD_PORT
        set_conf(g, subprocess.run([tool, "--backend", args.backend, "dead-conf"],
                                   capture_output=True, text=True).stdout)
    elif cond == "portal":
        entry["how"] = ("a captive portal on 127.0.0.1:%d answering 302 then 200 to everything, "
                        "with the remote pointed at it" % PORTAL_PORT)
        fixture = Fixture("portal", PORTAL_PORT)
        fixture.up()
        fixtures.append(fixture)
        set_conf(g, remote_stanza(args.backend, PORTAL_PORT, tool))
    elif cond == "stall":
        entry["how"] = ("an endpoint on 127.0.0.1:%d that accepts and never answers, "
                        "with the remote pointed at it" % STALL_PORT)
        fixture = Fixture("stall", STALL_PORT)
        fixture.up()
        fixtures.append(fixture)
        set_conf(g, remote_stanza(args.backend, STALL_PORT, tool))
    elif cond in ("noroute", "blackhole", "linkdown"):
        entry["how"] = {
            "noroute": "both default routes removed (v4 and v6: deleting only the v4 one leaves "
                       "the v6 default, and the scripts' has_default_route reads that as online)",
            "blackhole": "a blackhole route to 10.0.2.2 added 0.4 s after the exit, so the "
                         "connection can open and then the path to the cloud goes",
            "linkdown": "eth0 taken down 0.5 s after the exit -- a handheld leaving Wi-Fi",
        }[cond]
        set_conf(g, live)

    seed_payload(g, 7, args.payload)
    entry["routes_before"] = g.sh("ip -4 route show")[1]
    L, rest_ref = measure_launch(g, fr, "cond-%s-launch" % cond, rom=rom)
    entry["launch"] = {k: L[k] for k in ("t_left_carousel", "t_retroarch_seen",
                                         "t_first_game_frame", "t_ticks200")}
    wait_drawing(g)

    if cond == "noroute":
        # BOTH families. The QA endpoint is on the guest's own /24, so a
        # missing v4 default does not cut it -- and the scripts do not test
        # reachability first, they test `is there a default route`, which on
        # this guest the v6 one answers yes to. Deleting only the v4 default
        # left the exit sync completing normally in 1.3 s (2026-09-12).
        entry["route_cmd"] = g.sh(DEL_DEFAULTS + "; echo 'left:'; "
                                  "ip -4 route show default; ip -6 route show default")[1]
        E = measure_exit(g, fr, "cond-%s" % cond, rest_ref, budget=120, rom=rom)
        if routes:
            normalise_routes(g, routes)
    elif cond in ("blackhole", "linkdown"):
        # SSH from the host arrives from 10.0.2.2, so a blackhole to it
        # stalls this channel too -- an admin-down link does not reset an
        # established connection. So the cut is armed inside the guest, the
        # master is dropped, and the measurement runs on frames alone until
        # the route comes back.
        cut, back = (("ip route add blackhole 10.0.2.2/32",
                      "ip route del blackhole 10.0.2.2/32 2>/dev/null")
                     if cond == "blackhole" else
                     ("ip link set eth0 down", "ip link set eth0 up"))
        # Half a second, not two: the online exit sync ends in 1.4 s, and a
        # cut armed for +2 s arrived after the sync had completed -- the cell
        # reported `completed` and measured nothing (2026-09-12).
        g.sh('cat > /tmp/ttp-arm.sh <<"H"\n'
             '#!/bin/sh\n'
             'sleep 0.5\n'
             '%s\n'
             'sleep 60\n'
             '%s\n'
             'H\n'
             'chmod +x /tmp/ttp-arm.sh; setsid /tmp/ttp-arm.sh >/dev/null 2>&1 & echo armed'
             % (cut, back))
        E = measure_exit(g, fr, "cond-%s" % cond, rest_ref, budget=100,
                         ssh_poll=False, rom=rom)
        g.drop_master()
        g.wait_alive(240)
        if routes:
            normalise_routes(g, routes)
        E["stamp_after"] = g.stamp("exit")
        E["stamp"] = parse_stamp(E["stamp_after"])
        try:
            E["t_sync_stamp_clock"] = int(E["stamp"]["epoch"]) - int(E["epoch0"])
            E["t_sync_stamp"] = E["t_sync_stamp_clock"]
        except (KeyError, ValueError, TypeError):
            pass
    else:
        # The stall is the one cell with no bound behind it: nothing in the
        # scripts or in rclone's flags ends a connection that was accepted
        # and then went quiet before the handshake, so the budget here is
        # the measurement, not a timeout of ours.
        E = measure_exit(g, fr, "cond-%s" % cond, rest_ref,
                         budget=(args.stall_budget if cond == "stall" else 150), rom=rom)

    E["log"] = g.sh("tail -30 /var/log/cloud_sync.log 2>/dev/null | cut -c1-200")[1]
    entry["exit"] = E
    entry["routes_after"] = g.sh("ip -4 route show")[1]
    if fixture is not None:
        fixture.down()
        if fixture in fixtures:
            fixtures.remove(fixture)
    return entry


def render(r):
    L = r["cells"].get("launch", [])
    E = r["cells"].get("exit", [])
    G = r["cells"].get("g2g", [])
    C = r["cells"].get("conditions", {})
    S = r["cells"].get("startup", {})
    lines = ["# time to play -- %s on %s" % (r["build"], r["backend"]),
             "",
             "%s, guest at :%s, cloud `%s`, payload `%s`, %d repeat(s)."
             % (r["started"], r["port"], r["backend"], r["payload"], r["repeat"]),
             "",
             "Host state: **%s**. SSH round trip %.0f ms (the launch POST goes over it); "
             "one screendump %.0f ms, which is the resolution of every frame-derived number below."
             % (r["host_state"], r.get("ssh_rtt_median_s", 0) * 1000,
                r.get("frame_poll_median_s", 0) * 1000),
             "", "Seconds, as median / mean / max.", ""]

    if L:
        lines.append("## UI to game, at rest\n")
        lines.append(md_table(
            ["from the press to", "median / mean / max", "n"],
            [["the screen leaving the carousel", fmt(stats([x["t_left_carousel"] for x in L])), len(L)],
             ["the handover (a black screen)", fmt(stats([x.get("t_screen_blank") for x in L])), len(L)],
             ["RetroArch existing", fmt(stats([x["t_retroarch_seen"] for x in L])), len(L)],
             ["**the game's first frame**", "**%s**" % fmt(stats([x["t_first_game_frame"] for x in L])), len(L)],
             ["RetroArch drawing (200 CPU ticks)", fmt(stats([x["t_ticks200"] for x in L])), len(L)]]))
    if E:
        toks = {}
        for x in E:
            t = x.get("stamp", {}).get("token", "?")
            toks[t] = toks.get(t, 0) + 1
        lines.append("## The exit sync, on its own\n")
        lines.append(md_table(
            ["from execute_kill to", "median / mean / max", "n"],
            [["the emulator gone", fmt(stats([x["t_emulator_gone"] for x in E])), len(E)],
             ["**the last-sync-exit stamp**", "**%s**" % fmt(stats([x["t_sync_stamp"] for x in E])), len(E)],
             ["the card gone from the screen", fmt(stats([x["t_card_gone"] for x in E])), len(E)]]))
        # What was seeded, not what moved: RetroArch replaces the auto-state
        # on its way out, so the transferred total is smaller. The rclone
        # line in each cell's log is the authority on bytes.
        lines.append("Outcomes: %s. Payload seeded %s KiB (RetroArch rewrites the auto-state on exit, "
                     "so what moves is a little less; the log's rclone line has the bytes).\n"
                     % (", ".join("%s x%d" % (k, v) for k, v in toks.items()),
                        E[0].get("payload_kib", "?")))
    if G:
        toks = {}
        for x in G:
            t = x.get("stamp", {}).get("token", "?")
            toks[t] = toks.get(t, 0) + 1
        lines.append("## Game to game, with the exit sync in flight\n")
        lines.append(md_table(
            ["from execute_kill to", "median / mean / max", "n"],
            [["the emulator gone", fmt(stats([x["t_emulator_gone"] for x in G])), len(G)],
             ["the relaunch sent", fmt(stats([x["t_relaunch_sent"] for x in G])), len(G)],
             ["**the next game's first frame**", "**%s**" % fmt(stats([x["t_second_game_frame"] for x in G])), len(G)],
             ["the exit sync's stamp", fmt(stats([x["t_sync_stamp"] for x in G])), len(G)]]))
        lines.append("What the launch did to the sync, from the stamp's token: %s.\n"
                     % ", ".join("`%s` x%d" % (k, v) for k, v in toks.items()))
    if S:
        rows = []
        for arm, e in S.items():
            rows.append([arm, e.get("t_es_up"), e.get("t_startup_stamp"),
                         e.get("t_launch_sent"), e.get("t_game_frame_after_launch"),
                         e.get("stamp", {}).get("token")])
        lines.append("## The startup sync\n")
        lines.append(md_table(
            ["arm", "ES up (s from reboot)", "startup stamp (s from reboot)",
             "launch sent (s)", "launch to game frame (s)", "stamp token"], rows))
    if C:
        online = stats([x["t_sync_stamp"] for x in E]) if E else {}
        rows = []
        if online:
            rows.append(["**online (%s)**" % r["backend"], "a successful sync",
                         fmt(online), "completed"])
        for cond, e in C.items():
            ex = e.get("exit", {})
            rows.append([cond, e.get("how", ""),
                         "-" if ex.get("t_sync_stamp") is None else "%.2f" % ex["t_sync_stamp"],
                         ex.get("stamp", {}).get("token", "?")])
        lines.append("## Offline and bounds, beside the online run\n")
        lines.append(md_table(
            ["cell", "how", "execute_kill to the stamp (s)", "outcome token"], rows))
    return "\n".join(lines) + "\n"


