# the cells


def measure_launch(g, fr, tag, budget=45.0, rom=ROM):
    """UI to a game's first frame, from a screen at rest.

    Two clocks run at once and neither can be asked to wait for the other:
    the framebuffer says when a frame was drawn, /proc says when RetroArch
    existed and when it had burnt enough CPU to be drawing. The process poll
    is a thread so that a 15 ms SSH round trip does not sit between two
    screendumps."""
    base = fr.rest()
    result = {"tag": tag}
    ra = {"seen": None, "ticks200": None, "pid": None}
    stop = threading.Event()
    t0 = [None]

    def poll():
        while not stop.is_set():
            st = g.retroarch()
            now = time.monotonic()
            if st is not None:
                if ra["seen"] is None:
                    ra["seen"] = now
                    ra["pid"] = st[0]
                if ra["ticks200"] is None and st[1] >= 200:
                    ra["ticks200"] = now
            time.sleep(0.08)

    th = threading.Thread(target=poll, daemon=True)
    th.start()
    t0[0] = time.monotonic()
    http = g.launch(rom)
    result["http"] = http
    series, prev = [], base
    first_change = game_frame = None
    saved_first = saved_game = None
    blank_at = [None]
    while time.monotonic() - t0[0] < budget:
        t = time.monotonic()
        f = fr.frame()
        d_base = vq.frame_diff(base, f)
        d_prev = vq.frame_diff(prev, f)
        series.append([round(t - t0[0], 3), round(d_base, 6), round(d_prev, 6)])
        blank = is_blank(f)
        if first_change is None and d_base >= vq.CHANGED_MIN:
            first_change = t - t0[0]
            saved_first = fr.save("%s-01-left-carousel" % tag, f)
        if blank and blank_at[0] is None and d_base >= vq.CHANGED_MIN:
            blank_at[0] = t - t0[0]
        seen = ra["seen"]
        # The game's first frame: not the carousel, not the handover, and
        # not before the process that draws it exists. All three, because
        # each alone is wrong on its own -- the black screen satisfies the
        # first, a carousel redraw the second, and RetroArch exists for a
        # fifth of a second before it draws anything.
        if (game_frame is None and first_change is not None and seen is not None
                and t > seen and not blank and d_base >= vq.CHANGED_MIN):
            game_frame = t - t0[0]
            saved_game = fr.save("%s-02-first-game-frame" % tag, f)
            break
        if f is not None:
            prev = f
    stop.set()
    th.join(timeout=5)
    result.update({
        "t_left_carousel": None if first_change is None else round(first_change, 3),
        "t_screen_blank": None if blank_at[0] is None else round(blank_at[0], 3),
        "t_retroarch_seen": None if ra["seen"] is None else round(ra["seen"] - t0[0], 3),
        "t_first_game_frame": None if game_frame is None else round(game_frame, 3),
        "frames": series,
        "png": [x for x in (saved_first, saved_game) if x],
    })
    # ticks200 usually lands after the first game frame; give it a moment
    # rather than reporting a corroboration that simply had not happened yet.
    end = time.monotonic() + 15
    while ra["ticks200"] is None and time.monotonic() < end:
        st = g.retroarch()
        if st is None:
            break
        if st[1] >= 200:
            ra["ticks200"] = time.monotonic()
        time.sleep(0.1)
    result["t_ticks200"] = None if ra["ticks200"] is None else round(ra["ticks200"] - t0[0], 3)
    return result, base


def settle_sync(g, budget=60):
    """Back to a device with nothing running on it.

    It ENDS a leftover emulator rather than waiting one out: a repeat that
    began while the previous game was still up measured the previous game's
    exit, and a cell that waits for a condition it could create itself
    spends its budget proving the wait works."""
    if g.retroarch() is not None:
        g.kill_game()
    end = time.monotonic() + budget
    while time.monotonic() < end:
        busy = g.sh("pgrep -f 'rclon[e]' >/dev/null && echo busy || echo idle")[1]
        if g.retroarch() is None and busy == "idle":
            time.sleep(2)
            return True
        time.sleep(1)
    return False


def wait_drawing(g, budget=60):
    """Until RetroArch has burnt 2 s of CPU: the exit cell's readiness rule."""
    end = time.monotonic() + budget
    while time.monotonic() < end:
        st = g.retroarch()
        if st is not None and st[1] >= 200:
            return True
        time.sleep(0.2)
    return False


def parse_stamp(line):
    parts = (line or "").split()
    out = {"raw": line}
    if len(parts) >= 3:
        out.update({"epoch": parts[0], "rc": parts[1], "token": parts[2],
                    "why": " ".join(parts[3:])})
    return out


def measure_exit(g, fr, tag, rest_ref, relaunch=False, budget=150.0,
                 frame_every=0.5, keep_frames=True, ssh_poll=True, rom=ROM):
    """The exit sync, from execute_kill to the stamp and to the card going.

    rest_ref is the screen before the game was launched: the card is gone
    when the screen matches it again. That comparison is why the whole cell
    starts from a settled screen -- a carousel with a dialog half-open on it
    would never match, and the cell would report the card as never leaving.

    The relaunch is fired from the poll thread the instant the emulator is
    gone, not from the frame loop: the frame loop runs at half a second and
    a player's thumb does not wait for a screendump. What the launch then
    does to the sync is not assumed -- it is read off the stamp's token
    afterwards.

    ssh_poll=False is for the one condition that cuts this channel (a
    blackhole route to 10.0.2.2, which the host's forwarded SSH also comes
    from): the frames still arrive, because the QEMU monitor is a host
    socket and owes the guest's routing table nothing."""
    before = g.stamp("exit") if ssh_poll else ""
    result = {"tag": tag, "stamp_before": before, "relaunch": relaunch}
    marks = {"gone": None, "stamp": None, "ra2": None, "relaunched": None}
    stop = threading.Event()

    def poll():
        while not stop.is_set():
            if marks["gone"] is None:
                if g.retroarch() is None:
                    marks["gone"] = time.monotonic()
                    if relaunch:
                        result["http2"] = g.launch(rom)
                        marks["relaunched"] = time.monotonic()
            elif relaunch and marks["ra2"] is None:
                if g.retroarch() is not None:
                    marks["ra2"] = time.monotonic()
            if marks["stamp"] is None:
                now = g.stamp("exit")
                if now and now != before:
                    marks["stamp"] = time.monotonic()
                    result["stamp_after"] = now
            if marks["stamp"] is not None and marks["gone"] is not None and not relaunch:
                break
            time.sleep(0.12)

    # The guest's own clock, for the one condition that cannot be polled:
    # the stamp carries an epoch, so a run measured with no SSH channel
    # still has a duration, to the second.
    epoch0 = g.sh("date +%s")[1]
    th = None
    t0 = time.monotonic()
    g.kill_game()
    if ssh_poll:
        th = threading.Thread(target=poll, daemon=True)
        th.start()
    series, shots = [], []
    card_gone = game2 = None
    prev = None
    n = 0
    while time.monotonic() - t0 < budget:
        t = time.monotonic()
        f = fr.frame()
        d_rest = vq.frame_diff(rest_ref, f)
        d_prev = 1.0 if prev is None else vq.frame_diff(prev, f)
        series.append([round(t - t0, 3), round(d_rest, 6), round(d_prev, 6)])
        if keep_frames:
            shots.append(fr.save("%s-%03d" % (tag, n), f))
        n += 1
        if prev is not None:
            prev = f
        else:
            prev = f
        # The card is gone when the screen is the one the launch started
        # from again. Gated on the stamp where there is an SSH channel to
        # read it on, and on three seconds where there is not: between the
        # interface redrawing after the game and the card being created
        # there is a frame or two of plain carousel, and without a gate
        # the cell would call that the card leaving.
        if (not relaunch and card_gone is None and d_rest <= vq.SAME_MAX
                and ((marks["stamp"] is not None and t > marks["stamp"])
                     or (not ssh_poll and t - t0 >= 3.0))):
            card_gone = t
            break
        # A card that never goes must not hold the cell for the whole budget:
        # the work ended at the stamp, and twenty seconds is far past every
        # linger the card has (a second and a half on success).
        if not relaunch and marks["stamp"] is not None and t - marks["stamp"] > 15:
            break
        if (relaunch and game2 is None and marks["ra2"] is not None
                and t > marks["ra2"] and d_prev >= vq.CHANGED_MIN and not is_blank(f)):
            game2 = t
            shots.append(fr.save("%s-game2" % tag, f))
            break
        time.sleep(max(0.0, frame_every - (time.monotonic() - t)))
    stop.set()
    if th is not None:
        th.join(timeout=8)
    if marks["stamp"] is None and ssh_poll:
        after = g.stamp("exit")
        if after and after != before:
            marks["stamp"] = time.monotonic()
            result["stamp_after"] = after
    result.update({
        "t_emulator_gone": None if marks["gone"] is None else round(marks["gone"] - t0, 3),
        "t_sync_stamp": None if marks["stamp"] is None else round(marks["stamp"] - t0, 3),
        "t_card_gone": None if card_gone is None else round(card_gone - t0, 3),
        "t_relaunch_sent": None if marks["relaunched"] is None else round(marks["relaunched"] - t0, 3),
        "t_retroarch2_seen": None if marks["ra2"] is None else round(marks["ra2"] - t0, 3),
        "t_second_game_frame": None if game2 is None else round(game2 - t0, 3),
        "frames": series,
        "png": [x for x in shots if x],
    })
    result["stamp"] = parse_stamp(result.get("stamp_after", ""))
    result["epoch0"] = epoch0
    try:
        result["t_sync_stamp_clock"] = int(result["stamp"]["epoch"]) - int(epoch0)
    except (KeyError, ValueError, TypeError):
        result["t_sync_stamp_clock"] = None
    if result["t_sync_stamp"] is None:
        result["t_sync_stamp"] = result["t_sync_stamp_clock"]
    return result


# --------------------------------------------------------------------------
# host fixtures for the offline and bounds cells


class Fixture:
    """A tiny host listener the guest's remote can be pointed at.

    portal: answers 302 then 200 with HTML to everything, which is what a
    hotel or an airport does to a device that thinks it is online.
    stall:  accepts the connection and never writes a byte, which is the
    one shape neither a refused port nor a missing route can produce and
    the only one that tests an idle timeout rather than a connect timeout."""

    def __init__(self, kind, port):
        self.kind, self.port = kind, port
        self.proc = None

    def up(self):
        code = PORTAL_SRC if self.kind == "portal" else STALL_SRC
        path = os.path.join(tempfile.mkdtemp(prefix="ttp-fix-"), self.kind + ".py")
        with open(path, "w") as fh:
            fh.write(code)
        self.path = path
        self.proc = subprocess.Popen([sys.executable, path, str(self.port)],
                                     stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        for _ in range(50):
            import socket as _s
            try:
                c = _s.create_connection(("127.0.0.1", self.port), 0.3)
                c.close()
                return True
            except OSError:
                time.sleep(0.1)
        return False

    def down(self):
        if self.proc is not None:
            self.proc.terminate()
            try:
                self.proc.wait(timeout=5)
            except subprocess.TimeoutExpired:
                self.proc.kill()
            self.proc = None
        try:
            shutil.rmtree(os.path.dirname(self.path))
        except (OSError, AttributeError):
            pass


PORTAL_SRC = '''import sys, socketserver, http.server
class H(http.server.BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"
    def _p(self):
        body = b"<html><head><title>Sign in to Wi-Fi</title></head><body>Sign in to continue</body></html>"
        if self.path != "/portal":
            self.send_response(302)
            self.send_header("Location", "http://10.0.2.2:%d/portal" % self.server.server_address[1])
            self.send_header("Content-Length", "0")
            self.end_headers()
            return
        self.send_response(200)
        self.send_header("Content-Type", "text/html")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)
    do_GET = do_HEAD = do_POST = do_PUT = do_DELETE = _p
    def do_PROPFIND(self): self._p()
    def do_OPTIONS(self): self._p()
    def do_MKCOL(self): self._p()
    def log_message(self, *a): pass
class S(socketserver.ThreadingTCPServer):
    allow_reuse_address = True
S(("127.0.0.1", int(sys.argv[1])), H).serve_forever()
'''

STALL_SRC = '''import sys, socket, threading
s = socket.socket(); s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
s.bind(("127.0.0.1", int(sys.argv[1]))); s.listen(64)
held = []
while True:
    c, _ = s.accept()
    held.append(c)          # accepted, never answered, never closed
'''


# --------------------------------------------------------------------------
# the conditions the offline and bounds cells run under


def remote_stanza(backend, address_port, tool):
    """The guest's rclone stanza with its address moved to another port.

    Which field carries the address is the backend's business, not this
    cell's -- cloud-test-backend already answers that with dead-conf, so
    the refused case comes from there. For the portal and the stall the
    same substitution is made on a live stanza: a `url = http://...:PORT`
    for the two backends whose address is a URL, `port = N` for the rest."""
    out = subprocess.run([tool, "--backend", backend, "rclone-conf"],
                         capture_output=True, text=True).stdout
    lines = []
    for line in out.splitlines():
        s = line.strip()
        if s.startswith("url = "):
            value = s[len("url = "):]
            scheme, _, rest = value.partition("://")
            host = rest.split("/")[0].split(":")[0]
            line = "url = %s://%s:%d" % (scheme, host, address_port)
        elif s.startswith("port = "):
            line = "port = %d" % address_port
        lines.append(line)
    return "\n".join(lines) + "\n"


def read_routes(g):
    """The guest's two default routes, verbatim, so they can be put back.

    `ip route show`'s own output is valid input to `ip route replace`, which
    is why this keeps the line rather than a gateway: a route re-added by
    hand came back without its src or its metric, and the next condition
    then measured a guest that was not the one the online run measured."""
    return {"v4": g.sh("ip -4 route show default | head -1")[1],
            "v6": g.sh("ip -6 route show default | head -1")[1]}


# Every default route, not the first one. `ip route del default` deletes ONE
# match, and a table that has picked up a second default -- which is what a
# hand-added route with a different metric is -- then still has one. The
# noroute cell measured a guest that was still online twice because of it.
DEL_DEFAULTS = ("for i in 1 2 3 4 5 6; do ip -4 route show default | grep -q . || break; "
                "ip -4 route del default; done; "
                "for i in 1 2 3 4 5 6; do ip -6 route show default | grep -q . || break; "
                "ip -6 route del default; done")


def normalise_routes(g, routes):
    """Back to the routing table the online run was measured on."""
    cmds = ["ip route del blackhole 10.0.2.2/32 2>/dev/null",
            "ip link set eth0 up 2>/dev/null",
            "sleep 1", DEL_DEFAULTS]
    if routes.get("v4"):
        cmds.append("ip -4 route add %s" % routes["v4"])
    if routes.get("v6"):
        cmds.append("ip -6 route add %s" % routes["v6"])
    cmds.append("true")
    g.sh("; ".join(cmds))
    return g.sh("ip -4 route show default | head -1; ip -6 route show default | head -1")[1]


def set_conf(g, text):
    fh = tempfile.NamedTemporaryFile("w", suffix=".conf", delete=False)
    fh.write(text)
    fh.close()
    g.put(fh.name, RCLONE_CONF)
    g.sh("chmod 600 " + RCLONE_CONF)
    os.remove(fh.name)


# --------------------------------------------------------------------------
# statistics and the report


def stats(values):
    vals = [v for v in values if v is not None]
    if not vals:
        return {"n": 0}
    return {"n": len(vals),
            "median": round(statistics.median(vals), 2),
            "mean": round(statistics.fmean(vals), 2),
            "max": round(max(vals), 2),
            "min": round(min(vals), 2),
            "all": [round(v, 2) for v in vals]}


def fmt(st):
    if not st or st.get("n", 0) == 0:
        return "-"
    return "%.2f / %.2f / %.2f" % (st["median"], st["mean"], st["max"])


def md_table(head, rows):
    out = ["| " + " | ".join(head) + " |",
           "| " + " | ".join("---" for _ in head) + " |"]
    for r in rows:
        out.append("| " + " | ".join("-" if c is None else str(c) for c in r) + " |")
    return "\n".join(out) + "\n"


