def seed_payload(g, jitter, kind="full"):
    """The saves the exit sync has to move, with fresh mtimes.

    Sizes are jittered by the repeat index because WebDAV with vendor=other
    carries neither hashes nor modtimes: rclone compares by size alone
    there, so a byte-for-byte-different file of the same size is 'already
    uploaded' and the repeat would measure an empty transfer (#53's shape).
    Everything written here is inside cloud_sync-rules.txt's allowlist:
    /savestates/** wholesale, and *.srm by extension."""
    if kind == "srm":
        script = (
            'set -e; mkdir -p /storage/roms/nes\n'
            'dd if=/dev/urandom of=/storage/roms/nes/Probe.srm bs=1024 count=%d 2>/dev/null\n'
            'du -k /storage/roms/nes/Probe.srm | cut -f1\n' % (8 + jitter))
    else:
        script = (
            'set -e; d=/storage/roms/savestates/nes; mkdir -p "$d" /storage/roms/nes\n'
            'dd if=/dev/urandom of="$d/Probe.state.auto"  bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of="$d/Probe.state.auto.png" bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of="$d/Probe.state1"      bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of="$d/Probe.state1.png"  bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of="$d/Probe.state2"      bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of="$d/Probe.state2.png"  bs=1024 count=%d 2>/dev/null\n'
            'dd if=/dev/urandom of=/storage/roms/nes/Probe.srm bs=1024 count=%d 2>/dev/null\n'
            'du -ck "$d" /storage/roms/nes/Probe.srm | tail -1 | cut -f1\n'
            % (180 + jitter, 18 + jitter, 181 + jitter, 17 + jitter,
               179 + jitter, 19 + jitter, 8 + jitter))
    return g.sh(script, timeout=60)[1]


# --------------------------------------------------------------------------
# frames


def is_blank(frame):
    """Is this the handover screen rather than a picture?

    Between the interface tearing its window down and the emulator drawing,
    the scanout is black -- 0.22 s after the press on this guest, a third of
    a second before RetroArch's first green frame at 0.63 s. Both are "the
    screen changed", and only the second is the number #135 asks for. A
    frame whose bytes are almost all zero is the handover; a game frame,
    even a dark one, is not (Probe.nes draws 0x0d3d0d, 8% of the byte range,
    on every pixel)."""
    if not frame:
        return True
    # Past the PPM header: three lines, then the pixel data.
    body = frame
    for _ in range(3):
        nl = body.find(b"\n")
        if nl < 0:
            break
        body = body[nl + 1:]
    if not body:
        return True
    return (len(body) - body.count(0)) / float(len(body)) < 0.01


class Frames:
    """A monitor connection plus the bookkeeping every cell wants."""

    def __init__(self, path, outdir):
        self.mon = vq.Monitor(path)
        self.outdir = outdir
        os.makedirs(outdir, exist_ok=True)

    def frame(self):
        return self.mon.frame()

    def rest(self, timeout=25):
        """The screen with nothing happening on it: settle, then a frame.

        Every cell that asks 'is the card gone?' asks it against this."""
        vq.settle(self.mon.frame, timeout=timeout, quiet=1.2)
        return self.mon.frame()

    def save(self, name, data=None):
        ppm = os.path.join(self.outdir, name + ".ppm")
        png = os.path.join(self.outdir, name + ".png")
        if data is None:
            if not self.mon.screendump(ppm):
                return None
        else:
            with open(ppm, "wb") as fh:
                fh.write(data)
        try:
            vq.to_png(ppm, png)
        finally:
            try:
                os.remove(ppm)
            except OSError:
                pass
        return os.path.basename(png)

    def close(self):
        self.mon.close()


