#
# The work logs at a day's, a week's and a month's distance: one index over
# docs/work-logs/<yyyy_mm>-work_logs/<yyyy_mm_dd>-work_log.md, listing every
# timestamped entry's title under its day, the days under their ISO week, the
# weeks under their month. The day files stay the record; this is the table
# of contents that lets a month be read in a minute and a settled question be
# found before it is asked again (#253, D-QA-039's rule).
#
#   tools/work-log-index            # print the index
#   tools/work-log-index --write    # write docs/work-logs/INDEX.md
#   tools/work-log-index --check    # exit 1 when INDEX.md is not what --write would produce
#
# Regenerate after appending an entry; the pre-push guard warns when a
# work-log change is pushed without the index.

import datetime
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
BASE = os.path.join(ROOT, 'docs/work-logs')
OUT = os.path.join(BASE, 'INDEX.md')


def entries():
    days = {}
    for d, _, files in os.walk(BASE):
        for f in files:
            m = re.match(r'(\d{4})_(\d\d)_(\d\d)-work_log\.md$', f)
            if not m:
                continue
            date = datetime.date(*map(int, m.groups()))
            rel = os.path.relpath(os.path.join(d, f), BASE)
            items = []
            for line in open(os.path.join(d, f), encoding='utf-8'):
                if not line.startswith('## '):
                    continue
                hm = re.match(r'## (\d\d:\d\d) UTC\s*[—–-]+\s*(.*)', line.strip())
                if hm:
                    items.append((hm.group(1), hm.group(2).strip()))
                else:
                    items.append(('', line.strip().lstrip('# ').strip()))
            days[date] = (rel, items)
    return days


def render(days):
    out = ['# Work-log index', '',
           'Generated by `tools/work-log-index --write` from the day files under this directory; '
           'regenerate after appending an entry. One line per timestamped entry, days under their ISO week, weeks under their month. '
           'The day file is the record; this is where a month is read in a minute.', '']
    total = sum(len(v[1]) for v in days.values())
    months = {}
    for date in days:
        months.setdefault((date.year, date.month), []).append(date)
    out.append('%d entries over %d days in %d months: %s.' % (
        total, len(days), len(months),
        ', '.join('%04d-%02d' % k for k in sorted(months))))
    out.append('')
    for (y, mo) in sorted(months, reverse=True):
        mdays = sorted(months[(y, mo)], reverse=True)
        mcount = sum(len(days[d][1]) for d in mdays)
        out.append('## %04d-%02d (%d entries over %d days)' % (y, mo, mcount, len(mdays)))
        out.append('')
        weeks = {}
        for d in mdays:
            iso = d.isocalendar()
            weeks.setdefault((iso[0], iso[1]), []).append(d)
        for (wy, wn) in sorted(weeks, reverse=True):
            wdays = sorted(weeks[(wy, wn)], reverse=True)
            wcount = sum(len(days[d][1]) for d in wdays)
            out.append('### Week %04d-W%02d, %s to %s (%d entries over %d days)' % (
                wy, wn, wdays[-1].strftime('%b %d'), wdays[0].strftime('%b %d'), wcount, len(wdays)))
            out.append('')
            for d in wdays:
                rel, items = days[d]
                out.append('#### [%s](%s) (%d)' % (d.isoformat(), rel, len(items)))
                for when, title in items:
                    out.append('- %s%s' % ((when + ' ') if when else '', title))
                out.append('')
    return '\n'.join(out).rstrip('\n') + '\n'


def main():
    text = render(entries())
    if '--write' in sys.argv:
        open(OUT, 'w', encoding='utf-8').write(text)
        print('wrote %s (%d lines)' % (os.path.relpath(OUT, ROOT), text.count('\n')))
        return 0
    if '--check' in sys.argv:
        cur = open(OUT, encoding='utf-8').read() if os.path.exists(OUT) else ''
        if cur == text:
            print('work-log index: current')
            return 0
        print('work-log index: STALE -- run tools/work-log-index --write')
        return 1
    sys.stdout.write(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
