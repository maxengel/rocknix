#!/bin/bash
# forbidden-terms-check: every tracked file of a tree, or the lines on stdin,
# against the wordlist the fork must not carry (2026-09-28). The list lives
# outside every tree -- ~/.config/rocknix/forbidden-terms (FORBIDDEN_TERMS_FILE),
# or FORBIDDEN_PATTERNS in the environment (the fork CI's repository secret) --
# because a list of words a tree must not hold would itself hold them. A hit is
# printed as path:line, never the text.
#   tools/forbidden-terms-check                     # this tree
#   tools/forbidden-terms-check <dir>               # another git tree (the ES fork)
#   git log --format=%B a..b | tools/forbidden-terms-check --stdin   # commit messages
# Exit 0 with no hit; 1 with hits; 2 when it could not run -- the list
# unreadable or not compiling, git ls-files failing, a grep dying. Fails closed.
set -uo pipefail
if [ -z "${FORBIDDEN_PATTERNS:-}" ]; then
  f="${FORBIDDEN_TERMS_FILE:-${HOME}/.config/rocknix/forbidden-terms}"
  [ -r "${f}" ] || { echo "forbidden-terms-check: no wordlist (${f} unreadable, FORBIDDEN_PATTERNS unset)" >&2; exit 2; }
  . "${f}"
fi
[ -n "${FORBIDDEN_PATTERNS:-}" ] || { echo "forbidden-terms-check: FORBIDDEN_PATTERNS is empty" >&2; exit 2; }
printf '' | grep -i -E -e "${FORBIDDEN_PATTERNS}" >/dev/null 2>&1; rc=$?
[ "${rc}" -le 1 ] || { echo "forbidden-terms-check: the pattern does not compile (grep exited ${rc})" >&2; exit 2; }

if [ "${1:-}" = --stdin ]; then
  n="$(grep -a -i -c -E -e "${FORBIDDEN_PATTERNS}" -)"; rc=$?
  [ "${rc}" -le 1 ] || { echo "forbidden-terms-check: could not read stdin (grep exited ${rc})" >&2; exit 2; }
  if [ "${n}" -gt 0 ]; then echo "forbidden-terms-check: ${n} line(s) on stdin carry a listed word"; exit 1; fi
  echo "forbidden-terms-check: 0 hits on stdin"; exit 0
fi

TREE="${1:-$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)}"
list="$(mktemp)" || exit 2
trap 'rm -f "${list}"' EXIT
git -C "${TREE}" ls-files -z > "${list}" || { echo "forbidden-terms-check: git ls-files failed in ${TREE}" >&2; exit 2; }
hits=0; scanned=0
while IFS= read -r -d '' f; do
  p="${TREE}/${f}"
  [ -f "${p}" ] && [ ! -L "${p}" ] || continue        # a submodule, a symlink, a path deleted but tracked
  scanned=$((scanned + 1))
  out="$(grep -a -i -n -E -e "${FORBIDDEN_PATTERNS}" -- "${p}" 2>&1)"; rc=$?
  case "${rc}" in
    1) ;;
    0) while IFS= read -r ln; do echo "${f}:${ln%%:*}"; hits=$((hits + 1)); done <<< "${out}" ;;
    *) echo "forbidden-terms-check: grep failed on ${f} (rc ${rc})" >&2; exit 2 ;;
  esac
done < "${list}"
if [ "${hits}" -gt 0 ]; then
  echo "forbidden-terms-check: ${hits} hit(s) in ${scanned} tracked files (path:line above; the words are never printed)"
  exit 1
fi
echo "forbidden-terms-check: 0 hits in ${scanned} tracked files"
