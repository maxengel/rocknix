#!/usr/bin/env bash
# SPDX-License-Identifier: GPL-2.0
#
# Publish a locally-built ROCKNIX image to GitHub Releases on the fork, so it can
# be downloaded from anywhere (the build machine is often headless).
#
#   tools/fork-publish-release [DEVICE] [prerelease|stable]
#
# Defaults: DEVICE=GENERIC_X64, channel=prerelease, repo=maxengel/rocknix
# (override the repo with FORK_REPO=owner/name). Requires an authenticated `gh`
# (or GH_TOKEN in CI). Re-running for the same day updates the existing release.
set -euo pipefail

REPO="${FORK_REPO:-maxengel/rocknix}"
DEVICE="${1:-GENERIC_X64}"
CHANNEL="${2:-prerelease}"

# Newest matching image for the device (produced by scripts/image mkimage).
IMG="$(ls -t "target/ROCKNIX-${DEVICE}."*.img.gz 2>/dev/null | head -1 || true)"
if [ -z "${IMG}" ]; then
  echo "error: no target/ROCKNIX-${DEVICE}.*.img.gz found — build the image first" >&2
  exit 1
fi

BASE="$(basename "${IMG}" .img.gz)"                       # ROCKNIX-GENERIC_X64.x86_64-20260701

# Handhelds append a board variant after the date (...-20260819-DDR4), so the
# date is not always last. Anchoring to the end silently fell through to
# today's date, tagging a release with a date the image itself does not
# report - os-release carries OS_VERSION="<builddate>", which is what the
# device shows its owner.
DATE="$(printf '%s' "${BASE}" | grep -oE '[0-9]{8}' | tail -1)"
[ -n "${DATE}" ] || DATE="$(date +%Y%m%d)"
# One release per build, not per device. Publishing a tag per device produced
# four entries for a single build and 23 releases in all, so "what shipped on
# the 27th" meant reading four of them and comparing dates by eye. Every device
# now lands in dev-<date>; the filenames already carry their own device and
# date, so nothing is lost by grouping them. Set FORK_RELEASE_TAG to override.
TAG="${FORK_RELEASE_TAG:-dev-${DATE}}"

# One build of a handheld emits several images - DDR3/DDR4, Generic/Specific,
# a/b - and which one a person needs depends on the board inside their
# device. Publish every variant from this build; shipping only the newest
# strands everyone who owns the other one.
ASSETS=()
VARIANTS=()
for _img in target/ROCKNIX-"${DEVICE}".*"${DATE}"*.img.gz; do
  [ -f "${_img}" ] || continue
  ASSETS+=("${_img}")
  [ -f "${_img}.sha256" ] && ASSETS+=("${_img}.sha256")
  VARIANTS+=("$(basename "${_img}")")
done

# The .tar is the in-place update path - copied to /storage/.update it
# upgrades a device without wiping /storage. That is how anyone already
# running ROCKNIX takes a new build, and it is what an upgrade-path test
# needs, so it has to be in the release rather than only described by it.
UPDATE_TAR="$(ls -t target/ROCKNIX-"${DEVICE}".*"${DATE}"*.tar 2>/dev/null | head -1 || true)"
if [ -n "${UPDATE_TAR}" ]; then
  ASSETS+=("${UPDATE_TAR}")
  [ -f "${UPDATE_TAR}.sha256" ] && ASSETS+=("${UPDATE_TAR}.sha256")
fi
if [ ${#ASSETS[@]} -eq 0 ]; then
  echo "error: no images matching target/ROCKNIX-${DEVICE}.*${DATE}*.img.gz" >&2
  exit 1
fi

# Never publish a build with credentials compiled into it. A personal
# ScreenScraper developer pair or RetroAchievements web API key exported in
# ~/.ROCKNIX/options for local builds becomes a string inside the image's
# EmulationStation binary, and a public release would hand it to everyone who
# downloads. The build root keeps the binary that went into the image; refuse
# if it carries the shapes those credentials take. FORK_PUBLISH_ES_BIN points
# the check elsewhere (tests); FORK_ALLOW_EMBEDDED_CREDENTIALS=yes is for
# accounts created for the fork and nothing else.
ES_BIN="${FORK_PUBLISH_ES_BIN:-$(ls -d build.ROCKNIX-"${DEVICE}".*/image/system/usr/bin/emulationstation 2>/dev/null | head -1 || true)}"
if [ -n "${ES_BIN}" ] && [ -f "${ES_BIN}" ]; then
  if strings "${ES_BIN}" | grep -qE 'devpassword=|(^|&)y=[A-Za-z0-9]{8,}'; then
    if [ "${FORK_ALLOW_EMBEDDED_CREDENTIALS:-}" != "yes" ]; then
      echo "error: ${ES_BIN} embeds scraper/achievement credentials (built with ~/.ROCKNIX/options set)." >&2
      echo "       A public release would publish them. Rebuild without them, or set" >&2
      echo "       FORK_ALLOW_EMBEDDED_CREDENTIALS=yes only if these are accounts created for the fork." >&2
      exit 1
    fi
    echo "warning: publishing a binary with embedded credentials (FORK_ALLOW_EMBEDDED_CREDENTIALS=yes)" >&2
  fi
elif [ -f "${HOME}/.ROCKNIX/options" ] && grep -qE '^[[:space:]]*export[[:space:]]+(SCREENSCRAPER_DEV_LOGIN|GAMESDB_APIKEY|CHEEVOS_DEV_LOGIN|HFS_DEV_LOGIN)=' "${HOME}/.ROCKNIX/options"; then
  echo "error: ~/.ROCKNIX/options sets build credentials and no EmulationStation binary was found to check; refusing to publish blind." >&2
  exit 1
fi

# qemu-img runs on the host here (it is not in the build container).
VM_DISK_SIZE="${VM_DISK_SIZE:-16G}"
UTM_ZIP=""
QCOW2=""
case "${DEVICE}" in
  GENERIC_X64)
    VM_TOOL="projects/ROCKNIX/devices/GENERIC_X64/vm/generic-x64-vm"
    VM_PROFILE="projects/ROCKNIX/devices/GENERIC_X64/vm/profile.json"
    command -v qemu-img >/dev/null 2>&1 || {
      echo "error: qemu-img is required for GENERIC_X64 release artifacts" >&2
      exit 1
    }
    command -v python3 >/dev/null 2>&1 || {
      echo "error: python3 is required for GENERIC_X64 release artifacts" >&2
      exit 1
    }
    [ -x "${VM_TOOL}" ] || {
      echo "error: canonical VM tool not found: ${VM_TOOL}" >&2
      exit 1
    }

    VM_DISK_SIZE_BYTES="$(
      python3 -c 'import json,sys; print(json.load(open(sys.argv[1]))["disk"]["virtual_size_bytes"])' \
        "${VM_PROFILE}"
    )"
    VM_DISK_SIZE="$((VM_DISK_SIZE_BYTES / 1024 / 1024 / 1024))G"
    QCOW2="target/${BASE}.qcow2"
    UTM_ZIP="target/${BASE}.utm.zip"
    TMP_IMG="target/${BASE}.rawtmp.img"
    trap 'rm -f "${TMP_IMG:-}"' EXIT

    echo "Creating canonical ${VM_DISK_SIZE} sparse qcow2 (${QCOW2})..."
    rm -f "${QCOW2}" "${UTM_ZIP}"
    gunzip -kc "${IMG}" > "${TMP_IMG}"
    qemu-img convert -f raw -O qcow2 "${TMP_IMG}" "${QCOW2}"
    qemu-img resize "${QCOW2}" "${VM_DISK_SIZE_BYTES}"
    rm -f "${TMP_IMG}"
    "${VM_TOOL}" utm "${QCOW2}" --output "${UTM_ZIP}"

    (
      cd target
      sha256sum "${BASE}.qcow2" > "${BASE}.qcow2.sha256"
      sha256sum "${BASE}.utm.zip" > "${BASE}.utm.zip.sha256"
    )
    ASSETS+=(
      "${QCOW2}" "${QCOW2}.sha256"
      "${UTM_ZIP}" "${UTM_ZIP}.sha256"
    )

    # Ship the canonical launcher + profile so release consumers can boot the
    # qcow2 with correct firmware/disk/network settings (including the
    # LAN-reachable cloud-setup forward) without cloning the repo.
    cp "${VM_TOOL}" target/generic-x64-vm
    cp "${VM_PROFILE}" target/profile.json
    ASSETS+=(target/generic-x64-vm target/profile.json)
    ;;
  AMD64)
    command -v qemu-img >/dev/null 2>&1 || {
      echo "error: qemu-img is required for AMD64 release artifacts" >&2
      exit 1
    }
    QCOW2="target/${BASE}.qcow2"
    TMP_IMG="target/${BASE}.rawtmp.img"
    trap 'rm -f "${TMP_IMG:-}"' EXIT
    echo "Creating ${VM_DISK_SIZE} sparse qcow2 (${QCOW2})..."
    gunzip -kc "${IMG}" > "${TMP_IMG}"
    qemu-img convert -f raw -O qcow2 "${TMP_IMG}" "${QCOW2}"
    qemu-img resize "${QCOW2}" "${VM_DISK_SIZE}"
    rm -f "${TMP_IMG}"
    ( cd target && sha256sum "${BASE}.qcow2" > "${BASE}.qcow2.sha256" )
    ASSETS+=("${QCOW2}" "${QCOW2}.sha256")
    ;;
esac

PRERELEASE_FLAG="--prerelease"
# GitHub refuses to mark a draft or prerelease as Latest, so a repo publishing
# only prereleases leaves the badge on whatever was last a normal release --
# here a build from February 2025, presented as current for eighteen months.
# The newest dev build claims the badge; --latest is ignored for prereleases,
# so the channel has to be a real release for the sidebar to be truthful.
LATEST_FLAG=""
[ "${CHANNEL}" = "stable" ] && LATEST_FLAG="--latest"
[ "${CHANNEL}" = "stable" ] && PRERELEASE_FLAG=""

if [ -n "${UTM_ZIP}" ]; then
  RELEASE_NOTES="ROCKNIX ${DEVICE} build ${DATE}.

- **${BASE}.utm.zip** (recommended on Apple silicon Macs) — unzip and double-click the \`.utm\` bundle. It carries the canonical Q35/UEFI, Haswell-v4, 4-vCPU, 8-GiB, VirtIO/512-byte disk, virtio-gpu-gl, network, audio, input, and serial-console configuration.
- **${BASE}.qcow2** (recommended on Linux) — the same 16-GiB disk. Launch it with \`projects/ROCKNIX/devices/GENERIC_X64/vm/generic-x64-vm run <qcow2>\` so Linux uses the same guest-visible machine profile.
- **${BASE}.img.gz** — raw image for flashing or other hypervisors. In a VM, give it a ${VM_DISK_SIZE}+ disk **before first boot** and expose 512-byte sectors. On real hardware it resizes to fill the card.

Linux uses KVM acceleration when available; UTM uses QEMU TCG for x86_64 on Apple silicon. The accelerator necessarily differs, but the CPU model and virtual hardware presented to ROCKNIX are defined by the same versioned profile."
elif [ -n "${QCOW2}" ]; then
  RELEASE_NOTES="ROCKNIX ${DEVICE} build ${DATE}.

- **${BASE}.qcow2** (recommended for VMs) — a pre-sized ${VM_DISK_SIZE} sparse disk.
- **${BASE}.img.gz** — raw image for flashing or other hypervisors."
else
  # Handheld: no VM disk is built, and the variants are not interchangeable.
  RELEASE_NOTES="ROCKNIX ${DEVICE} build ${DATE}.

Flash one of these to a card. **The variants are not interchangeable — pick the one matching your board:**

$(printf -- '- **%s**\n' "${VARIANTS[@]}")
The device reports this build as OS version \`${DATE}\` under system information, which is how to confirm what is actually installed.

To update a device already running ROCKNIX **without losing settings**, copy $([ -n "${UPDATE_TAR}" ] && printf '`%s`' "$(basename "${UPDATE_TAR}")" || printf 'the \`.tar\`') to \`/storage/.update\` and reboot."
fi

echo "Publishing ${IMG} -> ${REPO} (tag ${TAG}, ${CHANNEL})"
if gh release view "${TAG}" --repo "${REPO}" >/dev/null 2>&1; then
  gh release upload "${TAG}" "${ASSETS[@]}" --repo "${REPO}" --clobber
    # --draft=false is load-bearing, not tidiness. A `gh release create` that is
    # interrupted part-way leaves the release as a DRAFT, which nobody but the
    # owner can see or download. Every later run then takes this branch, uploads
    # into the draft, edits the title, and prints "Done:" with an untagged-<hash>
    # URL that reads like a real release link -- so publishing appears to succeed
    # forever while nothing is downloadable. Re-assert the channel on every
    # update rather than trusting the state it was created in.
    # Title and notes are deliberately NOT rewritten here. A release now holds
    # every device for a build, so a second device publishing into it would
    # replace the first device's notes with its own, leaving the release
    # describing only whichever ran last. Assets are added; the description
    # the release was created with stands.
  gh release edit "${TAG}" --repo "${REPO}" \
    --draft=false ${PRERELEASE_FLAG}
else
  gh release create "${TAG}" "${ASSETS[@]}" --repo "${REPO}" ${PRERELEASE_FLAG} ${LATEST_FLAG} \
    --title "ROCKNIX dev build — ${DATE}" \
    --notes "${RELEASE_NOTES}"
fi

echo "Done: $(gh release view "${TAG}" --repo "${REPO}" --json url -q .url 2>/dev/null || echo "release ${TAG}")"
