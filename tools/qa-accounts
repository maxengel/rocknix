#
# qa-accounts - carry a QA test account from the build host into a QA guest,
# so the pages that need a real RetroAchievements or ScreenScraper login can
# be pressed on the VM without a credential ever passing through a chat, a
# commit or a log (D-QA-016, D-INFRA-006's pattern).
#
# The accounts live in ~/.ROCKNIX/qa-accounts, mode 0600, as export lines:
#
#   export RA_QA_USER=...          RetroAchievements test account
#   export RA_QA_PASSWORD=...
#   export RA_QA_WEBKEY=...        its web API key (retroachievements.org > settings)
#   export SS_QA_USER=...          ScreenScraper test account
#   export SS_QA_PASSWORD=...
#   export SS_QA_DEVID=...         a developer pair, if one may be used on the VM (enough on its own)
#   export SS_QA_DEVPASSWORD=...
#
#   tools/qa-accounts <ssh-port> ra             # RetroAchievements: system.cfg, live
#   tools/qa-accounts <ssh-port> screenscraper  # ScreenScraper: es_settings.cfg, needs a reboot
#   tools/qa-accounts <ssh-port> clear          # take both back out
#
# Prints the names it set and nothing else. Refuses a file that is not
# 0600, and a port that is not one of the QA guests' (10022-10029).
set -u
FILE="${QA_ACCOUNTS:-$HOME/.ROCKNIX/qa-accounts}"
PORT="${1:-}"; WHAT="${2:-}"
KEY="${QA_KEY:-/tmp/rocknix-vm-pair/qa-key}"
SSHO=(-o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 -o BatchMode=yes)
case "${PORT}" in 1002[0-9]) ;; *) echo "qa-accounts: <ssh-port> must be a QA guest's (10022-10029)" >&2; exit 2 ;; esac
case "${WHAT}" in ra|screenscraper|clear) ;; *) echo "qa-accounts: ra, screenscraper or clear" >&2; exit 2 ;; esac
g() { ssh -n -i "${KEY}" -p "${PORT}" "${SSHO[@]}" root@127.0.0.1 "$@"; }
if [ "${WHAT}" = clear ]; then
    g '. /etc/profile; for k in global.retroachievements.password global.retroachievements.key; do set_setting $k default; done
       F=/storage/.config/emulationstation/es_settings.cfg; sed -i "/name=\"ScreenScraper\(User\|Pass\|DevId\|DevPass\)\"/d" $F' >/dev/null
    echo "cleared: global.retroachievements.password global.retroachievements.key ScreenScraperUser ScreenScraperPass ScreenScraperDevId ScreenScraperDevPass"
    exit 0
fi
[ -f "${FILE}" ] || { echo "qa-accounts: no ${FILE} -- see the header for its shape" >&2; exit 1; }
mode=$(stat -c %a "${FILE}"); [ "${mode}" = "600" ] || { echo "qa-accounts: ${FILE} is mode ${mode}, must be 600" >&2; exit 1; }
# shellcheck disable=SC1090
set -a; . "${FILE}"; set +a
need() { for v in "$@"; do [ -n "${!v:-}" ] || { echo "qa-accounts: ${v} is not set in ${FILE}" >&2; exit 1; }; done; }
q() { printf '%q' "$1"; }
if [ "${WHAT}" = ra ]; then
    need RA_QA_USER RA_QA_PASSWORD RA_QA_WEBKEY
    g ". /etc/profile; set_setting global.retroachievements 1; set_setting global.retroachievements.username $(q "${RA_QA_USER}"); set_setting global.retroachievements.password $(q "${RA_QA_PASSWORD}"); set_setting global.retroachievements.key $(q "${RA_QA_WEBKEY}")" >/dev/null
    # Report what the device holds, not what was intended.
    got=$(g '. /etc/profile; for k in global.retroachievements.username global.retroachievements.password global.retroachievements.key; do [ -n "$(get_setting $k)" ] && printf "%s " "$k"; done')
    echo "set on :${PORT}: global.retroachievements=1 ${got}(read by the interface at its next start: reboot the guest)"
    case "${got}" in *username*password*key*) exit 0 ;; *) echo "qa-accounts: a value did not land" >&2; exit 1 ;; esac
else
    # An account, a developer pair, or both -- whichever the file holds. A
    # pair alone is enough for a real scrape (anonymous quota) and for the
    # wrong-password case with a made-up account planted beside it. Only the
    # names being written are replaced; the other pair's lines stay.
    #
    # The lines travel over ssh's stdin, never through a second shell's
    # quoting: sent as an argument they lost their attribute quotes and left
    # es_settings.cfg unparseable, which the interface answered by ignoring
    # the whole file (2026-09-13). Written with a rename, verified by reading
    # the names back.
    xml() { printf '%s' "$1" | sed 's/&/\&amp;/g; s/</\&lt;/g; s/"/\&quot;/g'; }
    lines=""; names=""; drop=""
    if [ -n "${SS_QA_USER:-}" ] && [ -n "${SS_QA_PASSWORD:-}" ]; then
        lines="$(printf '\t<string name="ScreenScraperUser" value="%s" />\n\t<string name="ScreenScraperPass" value="%s" />' "$(xml "${SS_QA_USER}")" "$(xml "${SS_QA_PASSWORD}")")"
        names="ScreenScraperUser ScreenScraperPass"; drop='User\|Pass'
    fi
    if [ -n "${SS_QA_DEVID:-}" ] && [ -n "${SS_QA_DEVPASSWORD:-}" ]; then
        more="$(printf '\t<string name="ScreenScraperDevId" value="%s" />\n\t<string name="ScreenScraperDevPass" value="%s" />' "$(xml "${SS_QA_DEVID}")" "$(xml "${SS_QA_DEVPASSWORD}")")"
        lines="${lines}${lines:+
}${more}"; names="${names}${names:+ }ScreenScraperDevId ScreenScraperDevPass"; drop="${drop}${drop:+\|}DevId\|DevPass"
    fi
    [ -n "${names}" ] || { echo "qa-accounts: neither SS_QA_USER/SS_QA_PASSWORD nor SS_QA_DEVID/SS_QA_DEVPASSWORD is set in ${FILE}" >&2; exit 1; }
    printf '%s\n' "${lines}" | ssh -i "${KEY}" -p "${PORT}" "${SSHO[@]}" root@127.0.0.1 "F=/storage/.config/emulationstation/es_settings.cfg
        grep -v '</config>' \$F | grep -v 'name=\"\{0,1\}ScreenScraper\(${drop}\)\"\{0,1\} ' > \$F.new
        cat >> \$F.new
        echo '</config>' >> \$F.new
        mv \$F.new \$F" || { echo "qa-accounts: the write failed" >&2; exit 1; }
    got=$(g 'grep -o "name=\"ScreenScraper[A-Za-z]*\" value=\"[^\"][^\"]*\"" /storage/.config/emulationstation/es_settings.cfg | sed "s/^name=\"//; s/\" value=.*//" | tr "\n" " "')
    echo "es_settings.cfg on :${PORT} now holds, with values: ${got}(the interface reads it at its next start: reboot the guest)"
    for n in ${names}; do case " ${got}" in *" ${n} "*) ;; *) echo "qa-accounts: ${n} did not land" >&2; exit 1 ;; esac; done
fi
