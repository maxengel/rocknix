#
# vm-qa - every automated check the fork has, against one GENERIC_X64 image, one report.
#
#   ./tools/vm-qa <ROCKNIX-GENERIC_X64...img.gz>            # bring the pair up from the image, run everything
#   ./tools/vm-qa --skip-up                                  # the pair is already up on the image under test
#   ./tools/vm-qa <image> --only round-trip,exit             # a subset: scripts, round-trip, exit, walks, link
#
# Each run writes to qa-<build>-<backend>-<guest>-<date>, so a matrix of
# backends against one image keeps a report each.
#   ./tools/vm-qa <image> --link                             # also the seven link-loss cells (minutes each; need the serial console)
#   ./tools/vm-qa --skip-up --only walks --guest b           # the walks on vm-pair's second guest
#   ./tools/vm-qa --skip-up --only round-trip --backend sftp # the round trip against another cloud (#133)
#
# What runs, in order, each with its own log and a PASS/FAIL line:
#
#   scripts     tools/last-good-scripts-test  -- the scripts under busybox shims, on the host
#   lifetime    ES tests/cloud-oauth-lifetime.py -- the wizard's page lifetimes under ASan, on the host (ES_SRC)
#   round-trip  tools/cloud-round-trip        -- 27 steps over SSH against the QA cloud, guest a
#   exit        tools/emulator-exit-test --vm -- the exit hotkey ends a game once, save written, guest a
#   time-to-play tools/time-to-play --quick   -- UI to a game's first frame, and one game's exit to the
#               next game's first frame, with the exit sync running (#135, D-CLOUD-098). Its own table
#               goes at the end of the report; the suite row here says only whether it ran.
#   link        tools/cloud-round-trip --only LINK1..LINK7 -- the link cut mid-run, seven ways (--link, or --only link)
#   walks       tools/vm-walks/*.steps        -- each step file replayed from a rebooted guest, frames kept
#               (frames are kept for a person to read; comparing them to references is fork #120's third box)
#
# The report goes to $ROCKNIX_ARTIFACTS/rocknix-images/qa-<build>-<date>/report.md
# (default /workspace/artifacts), beside the logs and frames, and this exits
# non-zero if any suite failed -- so a nightly can tell. Nothing here touches a
# handheld: the guests are tools/vm-pair's, on this host (fork #120, box 1).
set -u
ROOT=$(cd "$(dirname "$0")/.." && pwd)
IMAGE=""; SKIP_UP=0; ONLY="scripts,lifetime,round-trip,exit,time-to-play,walks"; LINK=0; GUEST=a
# Which of the five QA clouds every suite here talks to (#133). It is one
# variable and not a per-suite flag on purpose: the backend the endpoint is
# brought up on, the stanza the walks seed, and the endpoint the round trip
# reads back have to be the same one, and CLOUD_QA_BACKEND is what every
# tool below reads.
BACKEND="${CLOUD_QA_BACKEND:-webdav}"
while [ $# -gt 0 ]; do
  case "$1" in
    --skip-up) SKIP_UP=1; shift ;;
    --only) ONLY=$2; shift 2 ;;
    --guest) GUEST=$2; shift 2 ;;
    --backend) BACKEND=$2; shift 2 ;;
    --link) LINK=1; shift ;;
    -h|--help) sed -n '5,25p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) IMAGE=$1; shift ;;
  esac
done
[ "$SKIP_UP" = 1 ] || [ -n "$IMAGE" ] || { echo "vm-qa: an image, or --skip-up" >&2; exit 2; }
# Which of tools/vm-pair's guests the suites drive. Guest a is the default
# and the only one `up` is written around; --guest b exists because two
# sessions share this host and the walks suite is the one that can run
# anywhere -- it needs a monitor socket and a guest to reboot, nothing else.
KEY=/tmp/rocknix-vm-pair/qa-key
case "$GUEST" in
  a) PORT=10022; MON=/tmp/rocknix-qemu-monitor.sock;   SERIAL=/tmp/rocknix-qemu-serial.sock ;;
  b) PORT=10023; MON=/tmp/rocknix-qemu-monitor-b.sock; SERIAL=/tmp/rocknix-qemu-serial-b.sock ;;
  *) echo "vm-qa: --guest is a or b, not '$GUEST'" >&2; exit 2 ;;
esac
[ "$LINK" = 1 ] && ONLY="$ONLY,link"
SSH() { ssh -n -i "$KEY" -p "$PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR -o ConnectTimeout=8 -o BatchMode=yes root@127.0.0.1 "$@"; }

export CLOUD_QA_BACKEND="$BACKEND"
"$ROOT/tools/cloud-test-backend" up >/dev/null 2>&1 || { echo "vm-qa: the $BACKEND QA cloud backend did not come up" >&2; exit 1; }
if [ "$SKIP_UP" = 0 ]; then
  "$ROOT/tools/vm-pair" down >/dev/null 2>&1
  "$ROOT/tools/vm-pair" up "$IMAGE" 2>&1 | tail -2
fi
for i in $(seq 1 40); do SSH true 2>/dev/null && break; sleep 3; done
BUILD=$(SSH 'sed -n "s/^BUILD_ID=//p" /etc/os-release' 2>/dev/null | tr -d '"' | cut -c1-10)
[ -n "$BUILD" ] || { echo "vm-qa: guest $GUEST does not answer" >&2; exit 1; }
# The backend and the guest are in the directory name, not only the build and
# the minute. Two vm-qa runs against one image -- which is what a backend
# matrix is (#133) -- started in the same minute, shared a directory, and the
# second overwrote the first's report and logs: two runs, one answer, and the
# surviving report named the other run's cloud.
OUT="${ROCKNIX_ARTIFACTS:-/workspace/artifacts}/rocknix-images/qa-${BUILD}-${BACKEND}-${GUEST}-$(date +%Y%m%d-%H%M)"
mkdir -p "$OUT/walks"
REPORT="$OUT/report.md"
{ echo "# vm-qa on $BUILD"; echo; echo "started $(date -u '+%Y-%m-%d %H:%M UTC'), guest $GUEST at :$PORT, cloud $BACKEND (port $("$ROOT/tools/cloud-test-backend" port), $("$ROOT/tools/cloud-test-backend" caps)), image ${IMAGE:-(already up)}"; echo; echo "| suite | result | time | log |"; echo "| --- | --- | --- | --- |"; } > "$REPORT"
FAILS=0
run_suite() {  # name, log, command...
  local name=$1 log=$2; shift 2
  local t0=$(date +%s) rc
  "$@" > "$log" 2>&1; rc=$?
  local dt=$(( $(date +%s) - t0 ))
  local res=PASS; [ "$rc" = 0 ] || { res="FAIL ($rc)"; FAILS=$((FAILS+1)); }
  printf '| %s | %s | %ds | `%s` |\n' "$name" "$res" "$dt" "$(basename "$log")" >> "$REPORT"
  echo "$name: $res in ${dt}s"
}
case ",$ONLY," in *,scripts,*)    run_suite scripts    "$OUT/scripts.log"    "$ROOT/tools/last-good-scripts-test" ;; esac
# EmulationStation's page-lifetime check (#144): the wizard's page-replacement
# callbacks compiled under AddressSanitizer against small doubles, on the
# host, in seconds. It had not compiled for a day and nothing ran it, so
# nothing said so (audit 2026-09-12, F-01). ES_SRC names the checkout whose
# GuiMenu.cpp is pinned by the image under test; a missing checkout is a
# FAIL with the reason, never a silent skip -- a guard that cannot run has
# not passed.
lifetime_suite() {
  local es="${ES_SRC:-$HOME/Development/emulationstation-next.worktrees/qa-integration}"
  if [ ! -f "$es/tests/cloud-oauth-lifetime.py" ]; then
    echo "no EmulationStation checkout at $es (set ES_SRC); the lifetime check did not run"; return 1
  fi
  echo "GuiMenu.cpp from $es at $(git -C "$es" rev-parse --short HEAD 2>/dev/null || echo '?')"
  python3 "$es/tests/cloud-oauth-lifetime.py"
}
case ",$ONLY," in *,lifetime,*)   run_suite lifetime   "$OUT/lifetime.log"   lifetime_suite ;; esac
case ",$ONLY," in *,round-trip,*) run_suite round-trip "$OUT/round-trip.log" "$ROOT/tools/cloud-round-trip" --host root@127.0.0.1 --port "$PORT" --identity "$KEY" --backend "$BACKEND" ;; esac
case ",$ONLY," in *,exit,*)       run_suite exit       "$OUT/exit.log"       "$ROOT/tools/emulator-exit-test" --port "$PORT" --identity "$KEY" --vm ;; esac
# Time to play (#135). --quick is the bounded form -- one repeat of the
# launch, the exit sync and a game-to-game, no reboot and no host fixtures --
# because this runs on every image and the offline and bounds cells are
# minutes each. The full cell (--repeat 5, every condition) is run by hand
# when a number is being proposed for a register row (D-CLOUD-116).
case ",$ONLY," in *,time-to-play,*)
  run_suite time-to-play "$OUT/time-to-play.log" "$ROOT/tools/time-to-play" \
    --host root@127.0.0.1 --port "$PORT" --identity "$KEY" --monitor "$MON" \
    --backend "$BACKEND" --out "$OUT/time-to-play" --quick --vm \
    --label "vm-qa on $(hostname -s), guest $GUEST" ;;
esac
# The link cells are timing-bound (a run must end within 90 s of the cut), so
# they run before the walks and never while an image builds on this host.
case ",$ONLY," in *,link,*)       run_suite link       "$OUT/link.log"       "$ROOT/tools/cloud-round-trip" --host root@127.0.0.1 --port "$PORT" --identity "$KEY" --backend "$BACKEND" --only LINK1,LINK2,LINK3,LINK4,LINK5,LINK6,LINK7 --serial-socket "$SERIAL" ;; esac
# The walks open pages that refuse without a remote (NO CLOUD STORAGE IS SET
# UP ON THIS DEVICE YET. SET IT UP NOW?), and the round-trip suite, which runs
# first, puts the guest's rclone.conf back to how it found it -- on a fresh
# pair, absent. Seven walks failed at that dialog on af2db4ab09 (2026-09-11)
# while the same suite had read PASS on the image before, whose fixed-wait
# walks passed whenever the tool ran (#125). Seed the QA remote when there is
# none, the way seed-device does, and the folders the transfer page expects.
ensure_remote() {
  [ -n "$(SSH 'rclone listremotes 2>/dev/null' 2>/dev/null)" ] && return 0
  local conf; conf=$(mktemp)
  "$ROOT/tools/cloud-test-backend" rclone-conf > "$conf"
  SSH 'mkdir -p /storage/.config/rclone' 2>/dev/null
  scp -q -i "$KEY" -P "$PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$conf" root@127.0.0.1:/storage/.config/rclone/rclone.conf
  rm -f "$conf"
  SSH 'chmod 600 /storage/.config/rclone/rclone.conf; /usr/bin/cloud_sync_helper >/dev/null 2>&1; r=$(rclone listremotes 2>/dev/null | head -1); rclone mkdir "${r}/ROCKNIX/Saves" >/dev/null 2>&1; rclone mkdir "${r}/ROCKNIX/Backups" >/dev/null 2>&1; echo "walks: seeded the QA remote ${r} (the guest had none)"' 2>/dev/null
}
# And the transfer walks tick ROMS AND BIOS and continue to the systems page,
# which on a device with no ROMs is the dialog NO SYSTEM ON THIS DEVICE HOLDS
# WHAT YOU TICKED (two walks, af2db4ab09). The round-trip suite works in a
# scratch tree and leaves /storage/roms as it found it -- empty on a fresh
# pair -- so seed the same fixture the walks were written against: the
# backend's seed-content in the cloud and seed-device's ROMs on the guest.
ensure_fixture() {
  ensure_remote
  SSH 'test -f /storage/roms/snes/shared.sfc' 2>/dev/null && return 0
  "$ROOT/tools/cloud-test-backend" seed-content >/dev/null 2>&1
  local scr; scr=$(mktemp)
  "$ROOT/tools/cloud-test-backend" seed-device > "$scr"
  scp -q -i "$KEY" -P "$PORT" -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null -o LogLevel=ERROR "$scr" root@127.0.0.1:/tmp/qa-seed-device.sh
  rm -f "$scr"
  SSH 'bash /tmp/qa-seed-device.sh >/dev/null 2>&1; rm -f /tmp/qa-seed-device.sh; echo "walks: seeded the content fixture (cloud seed-content, device ROMs) -- the guest had no ROMs"' 2>/dev/null
}
case ",$ONLY," in *,walks,*)
  ensure_fixture
  # Every walk starts from a rebooted guest, which the README names as the
  # one deterministic start; a boot-time dialog is dismissed with B first.
  walk_all() {
    local rc=0 name legs w pre defpre=""
    # tools/vm-walks/suite.txt names the compositions: most walk files are a
    # leg that starts on a screen an earlier leg reaches, so replaying them
    # one at a time drove A presses into the carousel and counted the frames
    # as a pass (#125). The old behaviour is the fallback if the file is gone.
    local suite="$ROOT/tools/vm-walks/suite.txt"
    if [ ! -f "$suite" ]; then
      for w in "$ROOT"/tools/vm-walks/*.steps; do
        name=$(basename "$w" .steps)
        case "$name" in wake|reset) continue ;; esac
        printf '%s = %s\n' "$name" "$name"
      done > "$OUT/walks/suite.txt"
      suite="$OUT/walks/suite.txt"
    fi
    while IFS= read -r line; do
      line=${line%%#*}
      case "$line" in *=*) ;; *) continue ;; esac
      name=$(echo "${line%%=*}" | tr -d ' ')
      legs=${line#*=}
      # `<name> = <legs> | <shell>`: the part after | is a command run on the
      # guest BEFORE the reboot, for a walk whose starting screen depends on
      # state a reboot does not clear -- which the transfer page's switches
      # are: EmulationStation saves them into system.cfg when the page
      # closes and restores them at the next start, so a `tick-*` leg, which
      # FLIPS rather than sets, went the wrong way after any walk that had
      # left one on (#125).
      pre=""
      case "$legs" in *\|*) pre=${legs#*|}; legs=${legs%%|*} ;; esac
      # `default-pre = <shell>` is the reset every walk wants; a line's own
      # `| <shell>` runs after it, so a walk can override what it set.
      if [ "$name" = "default-pre" ]; then defpre=$legs; continue; fi
      [ -n "$name" ] || continue
      mkdir -p "$OUT/walks"
      [ -n "$defpre" ] && SSH "$defpre" >/dev/null 2>&1
      [ -n "$pre" ] && SSH "$pre" >/dev/null 2>&1
      SSH 'systemctl reboot' 2>/dev/null; sleep 6
      for i in $(seq 1 45); do SSH 'pgrep -x emulationstation >/dev/null' 2>/dev/null && break; sleep 3; done; sleep 10
      # wake, then dismiss-dialogs: the first key after a boot is eaten by the
      # screensaver, and a boot-time dialog (the journey prompt, the
      # RetroAchievements offer, FINISH RESTORE SETUP) has to go before any
      # walk. This was `key z` + `wait 2`, which is one B press: on a guest
      # with nothing open that press OPENS the carousel's GO TO dialog, and
      # the walk then ran a screen out of phase (#125).
      { printf 'wake\ndismiss-dialogs\n'
        for w in $legs; do printf '# --- %s ---\n' "$w"; cat "$ROOT/tools/vm-walks/$w.steps"; done
      } | timeout 900 "$ROOT/tools/vm-visual-qa" --monitor "$MON" run - --outdir "$OUT/walks/$name/" > "$OUT/walks/$name.log" 2>&1 \
        || { echo "walk $name: exit $?  (see walks/$name.log)"; rc=1; }
      echo "walk $name: $(ls "$OUT/walks/$name/" 2>/dev/null | wc -l) frames  [$(echo $legs)]"
    done < "$suite"
    return $rc
  }
  run_suite walks "$OUT/walks.log" walk_all ;; esac
{ echo; if [ "$FAILS" = 0 ]; then echo "**PASSED** -- every suite that ran passed."; else echo "**FAILED** -- $FAILS suite(s) failed; see the logs beside this file."; fi; echo; echo "finished $(date -u '+%Y-%m-%d %H:%M UTC')"; } >> "$REPORT"
# The time-to-play numbers go BELOW the footer, not into the suite table: the
# table is one row per suite and this cell reports four of its own. No budget
# row exists yet, so nothing here fails the run -- the numbers are reported
# and a register row is proposed from them by hand (D-CLOUD-116).
if [ -f "$OUT/time-to-play/time-to-play.md" ]; then
  # Demoted a level each, so the cell's own sections sit under its heading
  # rather than beside the report's.
  { echo; sed -e 's/^## /### /' -e '1s/^# /## /' "$OUT/time-to-play/time-to-play.md"; } >> "$REPORT"
fi
echo; cat "$REPORT"; echo; echo "report: $REPORT"
[ "$FAILS" = 0 ]
