#
# ra-candidate-games -- homebrew titles whose first achievements are cheap
# enough to drive, for the offline RetroAchievements runner's candidate pool.
#
# tools/ra-offline-test spends one of the QA account's unearned achievements
# on every PASS, and only one has ever been routed to an award (Tobu's
# Potato-tan Secret, D-RA-006). #211 then asked for two unlocks in a single
# session, which the pool cannot supply at all. Rather than guess at titles,
# this asks RetroAchievements two questions it can answer mechanically:
#
#   * which sets are homebrew -- RA prefixes those titles "~Homebrew~", which
#     is the same population as the freely distributable itch.io releases the
#     fixtures already come from (tools/../rocknix-qa-roms/itch-free-download.sh);
#   * which of their achievements nearly every player has -- NumAwarded over
#     NumDistinctPlayers. An achievement 95% of players hold is one that
#     happens in the first minutes; one 4% hold is a speedrun.
#
# A game with two or more of the former is a candidate for a two-unlock
# session. It is a candidate, not a route: a route nobody has driven to
# `Awarding achievement` is a guard with no observed positive, so the output
# of this tool is where to look, and ra-offline-test's CANDIDATES only grows
# once a route has been seen to work.
#
#   tools/ra-candidate-games [--min-rate 70] [--min-count 2] [--systems 4,6,7]
#
# Credentials come from ~/.ROCKNIX/qa-accounts (RA_QA_WEBKEY, RA_QA_USER) or
# the environment, are sent only to retroachievements.org, and are never
# printed. Responses are cached under the cache dir, so a re-run costs no
# requests; the live calls are paced at RA_MIN_REQUEST_INTERVAL_SECONDS, the
# same 0.3 s courtesy the proxy's client uses, because their docs ask us to
# be reasonable rather than naming a limit.

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import urllib.parse
import urllib.request
from pathlib import Path

API = "https://retroachievements.org/API"
PACE = 0.35  # seconds between calls; see the header
DEFAULT_SYSTEMS = "1,3,4,5,6,7,8,11,15,25"  # what our devices emulate

# A homebrew set is only useful to us if the ROM runs on a shipped system, so
# the RA console maps to the ES system folder and the extensions that image
# accepts (read from a running GENERIC_X64 image's es_systems.cfg,
# 2026-09-18). A title whose only itch.io download is an HTML5 build, a
# Windows .exe or a PICO-8 cart is not a candidate however cheap its
# achievements are -- which is the check to apply before adding one.
RUNNABLE = {
    1:  ("genesis/megadrive", ".bin .gen .md .sg .smd"),
    3:  ("snes", ".fig .sfc .smc .swc"),
    4:  ("gb", ".gb .gbc"),
    5:  ("gba", ".gba"),
    6:  ("gbc", ".gb .gbc"),
    7:  ("nes", ".nes .unf .unif"),
    8:  ("pcengine", ".bin .pce"),
    11: ("mastersystem", ".bin .sms"),
    15: ("gamegear", ".bin .gg"),
    25: ("atari2600", ".a26 .bin"),
}
ACCOUNTS = Path.home() / ".ROCKNIX" / "qa-accounts"


def credentials() -> tuple[str, str]:
    user, key = os.environ.get("RA_QA_USER"), os.environ.get("RA_QA_WEBKEY")
    if not (user and key) and ACCOUNTS.exists():
        for line in ACCOUNTS.read_text(encoding="utf-8").splitlines():
            line = line.strip().removeprefix("export ").strip()
            name, _, value = line.partition("=")
            value = value.strip().strip('"').strip("'")
            if name == "RA_QA_USER" and not user:
                user = value
            elif name == "RA_QA_WEBKEY" and not key:
                key = value
    if not (user and key):
        print("ra-candidate-games: no RA_QA_USER / RA_QA_WEBKEY (env or "
              f"{ACCOUNTS})", file=sys.stderr)
        raise SystemExit(2)
    return user, key


def get(endpoint: str, params: dict, cache: Path, name: str) -> object:
    """A cached GET. The cache key never contains the credentials."""
    cached = cache / f"{name}.json"
    if cached.exists():
        try:
            return json.loads(cached.read_text(encoding="utf-8"))
        except ValueError:
            cached.unlink()
    user, key = credentials()
    query = urllib.parse.urlencode({**params, "y": key, "z": user})
    time.sleep(PACE)
    # RetroAchievements answers 403 to a request with no user agent of its
    # own -- their Connect docs say never to call without one, and the web
    # API enforces the same. urllib's default is not enough.
    request = urllib.request.Request(
        f"{API}/{endpoint}?{query}",
        headers={"User-Agent": "ROCKNIX-qa-candidates/1.0 (+https://github.com/ROCKNIX)"},
    )
    with urllib.request.urlopen(request, timeout=30) as response:
        body = response.read().decode("utf-8")
    cache.mkdir(parents=True, exist_ok=True)
    cached.write_text(body, encoding="utf-8")
    return json.loads(body)


# How RetroAchievements hashes a ROM, per console. Getting this wrong reads
# as "the set does not know this ROM" when the file is in fact correct: the
# NES rule cost a wrong verdict on Cookie Clicker on 2026-09-18, because its
# .nes carries the 16-byte iNES header that rcheevos strips before hashing.
# Whole-file is the common case; the exceptions are the headers dumpers add.
HASH_RULE = {
    7:  ("nes", 16),    # iNES header stripped
    3:  ("snes", 512),  # copier header stripped when the file is 512 over a multiple of 1K
}


def ra_md5(path: Path, console_id: int) -> str:
    """The MD5 RetroAchievements would compute for this file."""
    import hashlib
    data = path.read_bytes()
    rule = HASH_RULE.get(console_id)
    if rule:
        _, header = rule
        if console_id == 7 and data[:4] == b"NES\x1a":
            data = data[16:]
        elif console_id == 3 and header and len(data) % 1024 == 512:
            data = data[512:]
    return hashlib.md5(data).hexdigest()


def check(game_id: int, path: Path, cache: Path) -> int:
    """Does this file carry the set's achievements?"""
    detail = get("API_GetGameExtended.php", {"i": game_id}, cache, f"game-{game_id}")
    console = int(detail.get("ConsoleID") or 0)
    listing = get("API_GetGameHashes.php", {"i": game_id}, cache, f"hashes-{game_id}")
    known = listing.get("Results", listing if isinstance(listing, list) else [])
    ours = ra_md5(path, console)
    print(f"{path.name}")
    print(f"  {detail.get('Title')}  [{detail.get('ConsoleName')}]")
    print(f"  hashed as RetroAchievements would: {ours}")
    for row in known:
        their = str(row.get("MD5") or "").lower()
        print(f"  {'MATCH  ' if their == ours else '       '}{their}  {str(row.get('Name') or '')[:52]}")
    if any(str(row.get("MD5") or "").lower() == ours for row in known):
        print("  -> this ROM carries the set")
        return 0
    print(f"  -> NOT the build the set was made against ({len(known)} known hash(es))")
    return 1


def main() -> int:
    parser = argparse.ArgumentParser(add_help=True)
    parser.add_argument("--min-rate", type=int, default=70,
                        help="percent of players holding an achievement for it to count as cheap")
    parser.add_argument("--min-count", type=int, default=2,
                        help="how many such achievements a game needs to be listed")
    parser.add_argument("--systems", default=DEFAULT_SYSTEMS)
    parser.add_argument("--cache", default=str(Path.home() / ".cache" / "rocknix-ra-candidates"))
    parser.add_argument("--limit", type=int, default=0, help="stop after N games (for a quick look)")
    parser.add_argument("--check", nargs=2, metavar=("GAME_ID", "FILE"),
                        help="does FILE carry that game's achievements? (hashed RA's way)")
    args = parser.parse_args()
    cache = Path(args.cache)

    if args.check:
        return check(int(args.check[0]), Path(args.check[1]), cache)

    homebrew = []
    for system in args.systems.split(","):
        listing = get("API_GetGameList.php", {"i": system, "f": 1}, cache, f"games-{system}")
        if isinstance(listing, list):
            homebrew += [g for g in listing if str(g.get("Title", "")).startswith("~Homebrew~")]
    print(f"{len(homebrew)} homebrew set(s) on systems {args.systems}", file=sys.stderr)

    rows = []
    for index, game in enumerate(sorted(homebrew, key=lambda g: -int(g.get("NumAchievements") or 0)), 1):
        if args.limit and index > args.limit:
            break
        gid = game["ID"]
        try:
            detail = get("API_GetGameExtended.php", {"i": gid}, cache, f"game-{gid}")
        except Exception as exc:
            print(f"  (game {gid}: {exc})", file=sys.stderr)
            continue
        players = int(detail.get("NumDistinctPlayers") or 0)
        achievements = (detail.get("Achievements") or {}).values()
        if players < 25 or not achievements:
            continue  # too few players for a rate to mean anything
        cheap = sorted(
            ((int(a.get("NumAwarded") or 0) * 100 // players, a) for a in achievements),
            key=lambda pair: -pair[0],
        )
        qualifying = [(rate, a) for rate, a in cheap if rate >= args.min_rate]
        if len(qualifying) >= args.min_count:
            rows.append((len(qualifying), players, detail, qualifying))
        if index % 50 == 0:
            print(f"  ...{index}/{len(homebrew)}", file=sys.stderr)

    rows.sort(key=lambda r: (-r[0], -r[1]))
    print(f"\n{len(rows)} title(s) with {args.min_count}+ achievements held by "
          f"{args.min_rate}%+ of players\n")
    for count, players, detail, qualifying in rows:
        title = str(detail.get("Title", "")).replace("~Homebrew~ ", "")
        folder, extensions = RUNNABLE.get(int(detail.get("ConsoleID") or 0), ("?", "?"))
        print(f"{title}  [{detail.get('ConsoleName')}]  game {detail.get('ID')}  "
              f"{players} players  {count} cheap of {detail.get('NumAchievements')}")
        print(f"    runs as: roms/{folder}   needs an itch.io upload ending {extensions}")
        for rate, a in qualifying[:4]:
            print(f"    {rate:3d}%  {str(a.get('Points')):>3} pts  {a.get('Title')}  (id {a.get('ID')})")
    return 0


if __name__ == "__main__":
    sys.exit(main())
