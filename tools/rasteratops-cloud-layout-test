def local_archive(f, suffix):
    put(f.path/'profile', 'export PATH=/shim:/repo:/usr/bin:/bin\nexport HOME=/storage\nexport OS_NAME=pixelelated\n')
    put(f.path/'storage/.config/backuptool.conf', 'LOCATIONS=( /storage/.config/proof-sentinel )\n')
    put(f.path/'storage/.config/proof-sentinel', 'before restore\n')
    archive = f.archive(ARCHIVE.replace('ROCKNIX_SETTINGS', suffix+'_SETTINGS'), local=True)
    original = archive.read_bytes()
    r=f.run('backuptool','restore')
    require(r.returncode==0, f'local {suffix} restore rc={r.returncode}: {r.stdout[-500:]}')
    require((f.path/'storage/.config/proof-sentinel').read_text()=='settings sentinel\n', 'local restore sentinel mismatch')
    snapshots=list((f.path/'storage/roms/backup/archive').glob('*PRE_RESTORE*'))
    require(snapshots, 'pre-restore recovery snapshot absent')
    with tarfile.open(snapshots[0]) as tar:
        require(tar.extractfile('storage/.config/proof-sentinel').read()==b'before restore\n', 'snapshot lost previous bytes')
    require(archive.read_bytes()==original, 'restore altered inherited archive')
    r=f.run('backuptool','backup')
    require(r.returncode==0, f'new local backup failed: {r.stdout[-400:]}')
    names=list((f.path/'storage/roms/backup').glob('*_SETTINGS.tar.gz'))
    require(any(n.name.endswith('-ROCKNIX_SETTINGS.tar.gz') for n in names), 'display rename changed persisted writer identity')


