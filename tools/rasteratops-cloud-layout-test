def no_remote_local_path(f, script, failed_read=False):
    put(f.path/'storage/.config/rclone/rclone.conf','')
    f.conf('/storage/not-a-cloud','/storage/not-settings','')
    put(f.path/'storage/not-a-cloud/gb/Remote.srm','local-only sentinel\n')
    put(f.path/'storage/roms/gb/Local.srm','local progress\n')
    if failed_read: f.fault(r'^listremotes( |$)')
    r=f.run(script,'--yes','--saves-only')
