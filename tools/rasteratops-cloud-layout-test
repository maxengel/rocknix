            'empty/failed remote discovery did not refuse with its setup outcome')
    require(not (f.path/'storage/not-a-cloud/gb/Local.srm').exists() and
            not (f.path/'storage/roms/gb/Remote.srm').exists(), 'unlinked transfer used a local path as its cloud')
    require((f.path/'storage/not-a-cloud/gb/Remote.srm').read_text()=='local-only sentinel\n', 'unlinked transfer changed local-only bytes')


def collision(f):
