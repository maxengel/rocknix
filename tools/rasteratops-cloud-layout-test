    require((f.path/'cloud/pixelelated/Content/ROMs/gb/A.gb').read_text()=='unrelated\n', 'unrelated content overwritten')
    # Record partially advanced pointers for the recovery proof, rather than assuming atomic migration.


def cloud_hashes(f):
    root = f.path/'cloud'
    return {str(p.relative_to(root)): hashlib.sha256(p.read_bytes()).hexdigest()
            for p in sorted(root.rglob('*')) if p.is_file()}


def marker_refusal(f, marker, mode):
    f.conf(OLD+'/Saves', OLD+'/Backups', OLD+'/Content')
    f.file(NEW+'/.layout', marker)
    f.file(NEW+'/Saves/gb/Fleet.srm', 'fleet progress\n')
    if mode == '--apply':
        f.file(OLD+'/Saves/gb/A.srm')
    before = cloud_hashes(f), f.pointers()
    script, arg = {'seed':('cloud_setup','--seed-folders'),
                   'scan':('cloud_scan','--folder')}.get(mode, ('cloud_migrate_layout',mode))
    r = f.run(script, arg)
    require(r.returncode not in (0,3), f'unsupported marker was accepted by {mode}')
    require((cloud_hashes(f), f.pointers()) == before,
            f'unsupported marker {marker!r} changed bytes/pointers through {mode}: rc={r.returncode}')
    require('Done.' not in r.stdout, 'unsupported marker reported completion')


def migration_retry(f, stage, operation='copy', legacy_record=False):
    f.conf(OLD+'/Saves', OLD+'/Backups', OLD+'/Content')
    payloads = {'Backups/QA/settings.tar.gz': 'settings bytes\n',
                'Saves/gb/A.srm': 'save bytes\n',
                'Saves-replaced/gb/A.srm': 'previous progress\n',
                'Content/ROMs/gb/A.gb': 'game bytes\n'}
    for name, data in payloads.items():
        f.file(OLD+'/'+name, data)
    pattern = r'^rcat qa:/pixelelated/\.layout ' if stage == 'marker' else (
        r'^'+operation+r' qa:/ROCKNIX/'+re.escape(stage)+r'/? ')
    f.fault(pattern)
    first = f.run('cloud_migrate_layout', '--apply')
    require((f.path/'ctl/fault-fired').exists(), f'{stage} fault never reached production call')
    require(first.returncode != 0, f'{stage} failure reported success: {first.stdout[-400:]}')
    require(not (f.path/'cloud/pixelelated/.layout').exists(), 'incomplete migration published marker')
    if legacy_record:
        record=f.path/'storage/.config/cloud-layout-migration.json'
        data=json.loads(record.read_text())
        data['source'].pop('discarded',None)
        record.write_text(json.dumps(data)+'\n')
    for name, data in payloads.items():
        copies = [f.path/'cloud'/root/name for root in ['ROCKNIX', 'pixelelated']]
        require(any(p.exists() and p.read_text()==data for p in copies), f'{stage} lost {name} before retry')
    pending = f.run('cloud_migrate_layout', '--needs-step')
    state = f.run('cloud_scan', '--folder')
    require(pending.returncode==0 and state.returncode==0 and
            'STATE=migration-pending' in (f.path/'storage/.cache/cloud_sync/scan/state').read_text(),
            f'{stage} interrupted move is not offered for retry')
    (f.path/'ctl/faults').unlink()
    before=cloud_hashes(f),f.pointers()
    seeded=f.run('cloud_setup','--seed-folders')
    require(seeded.returncode != 0 and (cloud_hashes(f),f.pointers())==before,
            'wizard seeded over an unfinished migration')
    # A completed tier remains usable after a failed move. All direct actors
    # keep the selected pointer; neither a retry record nor startup preparation
    # may make them change the marker or delete an old tier behind the mover.
    for script,argv in [
        ('cloud_restore',['--yes','--saves-only','--method=copy','--update','--automatic']),
        ('cloud_backup',['--yes','--saves-only','--method=copy','--update','--automatic']),
        ('cloud_backup',['--yes','--saves-only','--recent','--automatic']),
        ('cloud_restore',['--yes','--saves-only']),('cloud_backup',['--yes','--saves-only'])]:
        r=f.run(script,*argv)
        require(r.returncode in (0,9) and (cloud_hashes(f),f.pointers())==before,
                f'{stage}: direct {script} altered an unfinished layout: {r.stdout[-250:]}')
    # An OAuth refresh can rewrite this field without changing the cloud.
    with (f.path/'storage/.config/rclone/rclone.conf').open('a') as config:
        refreshed = {'access' + '_token': '<synthetic-refreshed>'}
        config.write('token = ' + json.dumps(refreshed) + '\n')
    second = f.run('cloud_migrate_layout', '--apply')
    require(second.returncode in (0,3), f'{stage} retry failed: {second.stdout[-500:]}')
    require((f.path/'cloud/pixelelated/.layout').is_file() and
            (f.path/'cloud/pixelelated/.layout').read_text()=='layout=2\n', f'{stage} retry did not commit marker')
    for name, data in payloads.items():
        p = f.path/'cloud/pixelelated'/name
        require(p.is_file() and p.read_text()==data, f'{stage} retry abandoned {name}')
        require(not (f.path/'cloud/ROCKNIX'/name).exists(), f'{stage} retry left duplicate {name}')
    before = cloud_hashes(f), f.pointers()
    again = f.run('cloud_migrate_layout', '--apply')
    require(again.returncode in (0,3) and (cloud_hashes(f), f.pointers())==before,
            f'{stage} repeated completed migration changed data')
    # A separate device has only its old pointers, none of the mover's local state.
    shutil.rmtree(f.path/'storage/.cache/cloud_sync')
    (f.path/'storage/.cache/cloud_sync').mkdir()
    f.conf(OLD+'/Saves', OLD+'/Backups', OLD+'/Content')
    follower = f.run('cloud_migrate_layout', '--follow')
    require(follower.returncode==0 and f.pointers()['SAVES_REMOTE']==NEW+'/Saves',
            f'{stage} second device could not follow committed layout')
    require(cloud_hashes(f)==before[0], 'following the completed migration changed cloud data')


def predecessor_retry(f, stage, interrupt_again=False):
    """The old script creates the inherited state; never hand-draw its pointers."""
    predecessor, ref = 'RC2', '69e6039f8f'
    source = '/GAMES'
    backups = '/GAMES/backup'
    content = '/GAMES/Content'
    f.conf(source, backups, content)
    payloads = {backups+'/QA/settings.tar.gz':'settings bytes\n',
                source+'/gb/A.srm':'save bytes\n', content+'/ROMs/gb/A.gb':'game bytes\n'}
    for name,data in payloads.items(): f.file(name,data)
    tool = f.path/'repo/cloud_migrate_layout'
    candidate = tool.read_bytes()
    old = subprocess.run(['git','-C',str(ROOT),'show',f'{ref}:{SOURCES}/cloud_migrate_layout'],
                         capture_output=True,check=True).stdout
    tool.write_bytes(old)
    targets = {'backups':backups, 'saves':source, 'discarded':source+'-replaced', 'content':content}
    if stage != 'complete':
        pattern = r'^rcat qa:/pixelelated/\.layout ' if stage == 'marker' else r'^copy qa:'+re.escape(targets[stage])+r'/? '
        f.fault(pattern)
    first = f.run('cloud_migrate_layout','--apply')
    if stage != 'complete':
        require((f.path/'ctl/fault-fired').exists(), f'{predecessor}/{stage}: fault was not reached')
        (f.path/'ctl/faults').unlink()
    (f.path/'predecessor.json').write_text(json.dumps(dict(ref=ref,
        script_sha256=hashlib.sha256(old).hexdigest(), rc=first.returncode,
        pointers=f.pointers(), cloud=cloud_hashes(f)),indent=2)+'\n')
    require(not (f.path/'storage/.config/cloud-layout-migration.json').exists(), 'old binary unexpectedly wrote new-format recovery state')
    tool.write_bytes(candidate)
    if interrupt_again:
        f.fault(r'^rcat qa:/pixelelated/\.layout ')
        failed=f.run('cloud_migrate_layout','--apply')
        require(failed.returncode != 0 and (f.path/'storage/.config/cloud-layout-migration.json').exists(),
                'interrupted predecessor recovery lost its record')
        (f.path/'ctl/faults').unlink()
    retry = f.run('cloud_migrate_layout','--apply')
    require(retry.returncode in (0,3), f'{predecessor}/{stage}: upgrade retry failed: {retry.stdout[-500:]}')
    expected = {'Backups/QA/settings.tar.gz':'settings bytes\n','Saves/gb/A.srm':'save bytes\n',
                'Content/ROMs/gb/A.gb':'game bytes\n'}
    for name,data in expected.items():
        path=f.path/'cloud/pixelelated'/name
        require(path.is_file() and path.read_text()==data, f'{predecessor}/{stage}: upgrade left {name} behind')
    require((f.path/'cloud/pixelelated/.layout').read_text()=='layout=2\n'
            if (f.path/'cloud/pixelelated/.layout').exists() else False,
            f'{predecessor}/{stage}: completed upgrade has no current marker')
    before=cloud_hashes(f),f.pointers()
    again=f.run('cloud_migrate_layout','--apply')
    require(again.returncode in (0,3) and (cloud_hashes(f),f.pointers())==before, 'repeated upgraded migration changed bytes/pointers')


def predecessor_boundaries(f, kind):
    # Current primary pointers with an inherited shelf; a chosen content
    # location remains independent even when its spelling ends in /Content.
    content = '' if kind == 'root' else '/Mine/Content'
    f.conf(content=content)
    f.file(NEW+'/Saves/gb/A.srm','current progress\n')
    # A sibling can still use the earlier layout. Current primary pointers
    # authorize only the unfinished shelf/content, never those live tiers.
    f.file(OLD+'/Saves/gb/Other.srm','another device save\n')
    f.file(OLD+'/Backups/QA/other.tar.gz','another device backup\n')
    f.file(OLD+'/Saves-replaced/gb/A.srm','earlier progress\n')
    f.file((content or '')+'/ROMs/gb/A.gb','chosen content\n')
    if kind in ('foreign','fleet'):
        f.file(NEW+'/Saves-replaced/gb/A.srm','foreign progress\n')
    if kind == 'fleet': f.file(NEW+'/.layout','layout=2\n')
    before=cloud_hashes(f),f.pointers()
    state=f.run('cloud_scan','--folder')
    require(state.returncode==0 and 'STATE=migration-pending' in
            (f.path/'storage/.cache/cloud_sync/scan/state').read_text(), 'inherited shelf is not offered through transfer recovery')
    r=f.run('cloud_migrate_layout','--apply')
    if kind == 'foreign':
        require(r.returncode != 0 and (cloud_hashes(f),f.pointers())==before,
                'unmarked conflicting recovery shelf was overwritten')
        return
    require(r.returncode in (0,3), f'{kind}: recovery failed: {r.stdout[-400:]}')
    require(f.pointers()['CONTENT_REMOTE']==content, 'recovery changed an independent content choice')
    for name,data in [('Saves/gb/Other.srm','another device save\n'),
                      ('Backups/QA/other.tar.gz','another device backup\n')]:
        require((f.path/'cloud/ROCKNIX'/name).is_file() and
                (f.path/'cloud/ROCKNIX'/name).read_text()==data,
                'recovering the shelf moved an unselected live tier')
        require(not (f.path/'cloud/pixelelated'/name).exists(),
                'recovering the shelf copied an unselected live tier')
    require((f.path/'cloud'/((content or '')+'/ROMs/gb/A.gb').lstrip('/')).read_text()=='chosen content\n',
            'recovery moved independent content bytes')
    values=[p.read_text() for p in (f.path/'cloud/pixelelated').rglob('*.srm')]
    require('current progress\n' in values and 'earlier progress\n' in values, 'recovery lost a progress version')
    if kind == 'fleet': require('foreign progress\n' in values, 'marked merge lost the other progress version')


def predecessor_content_only(f, empty=False):
    f.conf(content='/GAMES/Content')
    f.file(NEW+'/Saves/gb/A.srm','current save\n')
    f.file('/GAMES/gb/Other.srm','another device save\n')
    f.file('/GAMES/backup/QA/other.tar.gz','another device backup\n')
    if not empty: f.file('/GAMES/Content/ROMs/gb/A.gb','inherited content\n')
    before=cloud_hashes(f)
    preview=f.run('cloud_migrate_layout','--check')
    require(preview.returncode==0 and f'>>> plan {"none" if empty else "content"} /pixelelated' in preview.stdout,
            'current primary pointers planned unselected old live tiers')
    require(cloud_hashes(f)==before, 'preview changed cloud bytes')
    applied=f.run('cloud_migrate_layout','--apply')
    require(applied.returncode==0, 'content-only recovery failed')
    after=cloud_hashes(f)
    for name,digest in before.items():
        if '/Content/' not in name:
            require(after.get(name)==digest, 'content-only recovery changed an unselected live tier')
    require(f.pointers()['CONTENT_REMOTE']==NEW+'/Content', 'content pointer did not advance')
    if not empty:
        require((f.path/'cloud/pixelelated/Content/ROMs/gb/A.gb').read_text()=='inherited content\n',
                'content-only recovery lost bytes')


