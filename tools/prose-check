# prose-check -- does a rocknix.org page read as one of the site's writers wrote it?
#
#   tools/prose-check <page.md> [<page.md>...]     # fails on the first list in
#                                                  # .claude/skills/developer-relations/SKILL.md § Tells,
#                                                  # warns on the second
#   tools/prose-check --self-test                  # the site's own pages pass; a machine-sounding draft fails
#
# The lists are the skill's (#323, D-WORKFLOW-068), grown page by page in its
# loop; a tell added there is added here. Front matter, fenced code, inline
# code and URLs are not prose and are skipped. Exit 0 = no fail (warnings
# printed), 1 = a fail, 2 = usage or an unreadable file. Fork-only.
import re, sys, os

FAIL = [
    (r"—", "an em dash (the site punctuates with a comma, a colon or a spaced hyphen)"),
    (r"\s–\s", "a spaced en dash used as punctuation"),
    (r"\b(delve|delving|leverag(e|es|ed|ing)|robust(ly)?|seamless(ly)?|streamlin(e|es|ed|ing)|utiliz(e|es|ed|ing)|empower(s|ed|ing)?|elevat(e|es|ed|ing)|game-changer|supercharg(e|es|ed|ing))\b", "a word the site's writers never reach for"),
    (r"\b(best-in-class|world-class|cutting-edge|state-of-the-art|unlock the power)\b", "marketing"),
    (r"\b(it's|it is) worth noting\b|\bit is important to note\b|\bkeep in mind that\b|\bremember that\b|\bplease note\b", "filler framing: if it is worth noting, note it"),
    (r"(^|[.!?]\s+)note that\b", "'Note that' opening a sentence"),
    (r"\bwhether you're\b.*\bor\b|\bnot just\b.*,?\s*but\b", "a flourish the site does not use"),
    (r"\?\s*$", "a rhetorical question"),
    (r"[^`]![^\[\]\(=]", "an exclamation mark in body text"),
    (r"(^|[.!?]\s+)let's\b", "'Let's'"),
    (r"\b(in summary|to sum up|in conclusion|overall,|that's it!|you're all set|happy gaming)\b", "a closing summary or sign-off"),
]
WARN = [
    (r"\bdue to the fact that\b|\bat this point in time\b|\ba number of\b", "padding ('because', 'now', a count)"),
    (r"\bin order to\b", "'in order to' ('to' does it; the site's RetroAchievements page says it twice, so a warning)"),
    (r"\b\w+, \w+, and \w+\b(?![^`]*`)", "a three-item list: fine for three things (the maintainer's 'saves, states, and screenshots'), a tell when the three are adjectives for rhythm"),
    (r"\b(simply|just|easy|easily|quickly)\b", "the site's writers use this, once; a step is not made easier by saying so"),
    (r"\bensure( that)?\b", "'ensure' (the maintainer's word, once)"),
    (r"\bplease\b", "'please' outside a request for help"),
]

def prose_lines(text):
    """Yield (lineno, line) for prose only: no front matter, fenced code, HTML blocks; inline code and URLs blanked."""
    lines = text.split("\n"); infm = lines and lines[0].strip() == "---"; fence = False
    for i, l in enumerate(lines, 1):
        s = l.strip()
        if infm:
            if i > 1 and s == "---": infm = False
            continue
        if s.startswith("```") or s.startswith("~~~"): fence = not fence; continue
        if fence or s.startswith("<") or s.startswith("!!!") or s.startswith("|"): continue
        l2 = re.sub(r"`[^`]*`", "`x`", l); l2 = re.sub(r"https?://\S+", "URL", l2); l2 = re.sub(r"\+\+\"[^\"]*\"\+\+", "BUTTON", l2)
        yield i, l2

def check(path, text):
    fails, warns = [], []
    body = list(prose_lines(text)); prev_first = None
    for i, l in body:
        low = l.lower()
        for pat, why in FAIL:
            if re.search(pat, low if pat[0] != "[" else l):
                fails.append((i, why, l.strip()[:90]))
        for pat, why in WARN:
            if re.search(pat, low):
                warns.append((i, why, l.strip()[:90]))
        for sent in re.split(r"(?<=[.!?])\s+", l.strip()):
            if len(sent.split()) > 35: warns.append((i, "a sentence over 35 words", sent[:90]))
            first = sent.split()[0].lower() if sent.split() else None
            if first and first == prev_first and first not in ("the", "a", "an", "if", "in", "on", "to", "for", "you", "this", "it", "select", "press"):
                pass
            prev_first = first
        if l.strip().startswith("#") and l.strip().endswith("?"):
            warns.append((i, "a heading that is a question", l.strip()[:90]))
    # bold-label bullets: more than five in one list is a warning -- the maintainer's own variable
    # reference is eleven of them, and a reference list is that shape; a page of explanation is not
    run = 0
    for i, l in body:
        if re.match(r"\s*[-*]\s+\*\*[^*]+\*\*:", l): run += 1
        else:
            if run > 5: warns.append((i, "a list of more than five '**Label**: sentence' bullets (a reference list is this shape; explanation is not)", "(the list above)"))
            run = 0
    if run > 5: warns.append((len(body), "a list of more than five '**Label**: sentence' bullets", "(the list above)"))
    return fails, warns

BAD = """# :material-cloud: Cloud Sync

Whether you're a casual player or a hardcore collector, ROCKNIX's robust cloud sync seamlessly keeps your saves in sync — across every device you own! Let's delve into how to leverage it.

## Setup

1. Navigate to the settings in order to enable the feature.
2. It's worth noting that you should ensure your device is online.

In summary, cloud sync is fast, simple, and secure. Happy gaming!
"""

def main(argv):
    if len(argv) >= 2 and argv[1] == "--self-test":
        S = "/workspace/tmp/rocknix-session"
        ok = True
        for f in ("prose-sample-maintainer-rclone.md", "prose-sample-update.md", "prose-sample-ra.md"):
            p = os.path.join(S, f)
            if not os.path.exists(p): print(f"self-test: missing sample {p}"); return 2
            fails, warns = check(p, open(p, encoding="utf-8").read())
            print(f"{'ok  ' if not fails else 'FAIL'}  sample {f}: {len(fails)} fail, {len(warns)} warn")
            for i, why, s in fails: print(f"        {i}: {why}: {s}")
            ok = ok and not fails
        fails, warns = check("bad-draft", BAD)
        print(f"{'ok  ' if fails else 'FAIL'}  the machine-sounding draft: {len(fails)} fail (seen to fail: {len(fails) >= 5})")
        for i, why, s in fails: print(f"        {i}: {why}: {s}")
        ok = ok and len(fails) >= 5
        print("self-test: PASS" if ok else "self-test: FAIL"); return 0 if ok else 1
    if len(argv) < 2: print(__doc__ or "usage: tools/prose-check <page.md>..."); return 2
    rc = 0
    for p in argv[1:]:
        try: text = open(p, encoding="utf-8").read()
        except OSError as e: print(f"prose-check: {p}: {e}"); return 2
        fails, warns = check(p, text)
        for i, why, s in warns: print(f"{p}:{i}: warn: {why}: {s}")
        for i, why, s in fails: print(f"{p}:{i}: FAIL: {why}: {s}")
        print(f"prose-check: {p}: {'PASS' if not fails else 'FAIL'} ({len(fails)} fail, {len(warns)} warn)")
        rc = rc or (1 if fails else 0)
    return rc

if __name__ == "__main__":
    sys.exit(main(sys.argv))
