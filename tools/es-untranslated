#
# es-untranslated -- list the fork's EmulationStation strings that have no French.
#
# D-UI-051: a string the fork adds ships in English and French, written by hand into
# locale/lang/fr/LC_MESSAGES/emulationstation2.po; a missing translation falls through
# to English silently, which is why this exists (#152). A fork string is a `_("...")`
# msgid in es-app/src or es-core/src that the upstream base carries neither in its
# catalogue nor in its source; the reference is the upstream base (the merge base of
# HEAD with the upstream branch, derived each run -- audit #258 PL-022), read from git,
# so the list is exactly what the fork added. Its source counts as well as its .po
# because upstream adds strings without regenerating the catalogue: after the
# 2026-09-25 merge the fuel-gauge reset's two strings read as the fork's, and the
# `french` suite failed on strings the fork never wrote. Upstream's untranslated
# strings are still listed, after the summary, and do not fail the check. Untranslated means the msgid is absent from the current
# French catalogue or has an empty msgstr. The msgid must match the source byte for
# byte, because the build merges by msgid.
#
#   tools/es-untranslated [--es-src DIR] [--upstream COMMIT] [--quiet]
#     ES_SRC=<checkout> tools/es-untranslated
#
# Prints one line per untranslated fork string, `file:line<TAB>msgid`, then a summary;
# exits 1 while any remain and 0 when none do, so tools/vm-qa can run it on the host
# beside `vocabulary` and `register`.
import argparse, os, re, subprocess, sys

def parse_po(text):
    """msgid -> msgstr for a gettext catalogue (single- and multi-line entries; plurals keep msgstr[0])."""
    out = {}
    cur_id = None; cur_str = None; mode = None
    def unesc(s):
        return bytes(s, "utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")
    def flush():
        nonlocal cur_id, cur_str
        if cur_id is not None:
            out[cur_id] = cur_str or ""
        cur_id = None; cur_str = None
    for line in text.splitlines():
        line = line.strip()
        if not line or line.startswith("#"):
            continue
        m = re.match(r'^(msgid|msgid_plural|msgstr(?:\[\d+\])?|msgctxt)\s+"(.*)"$', line)
        if m:
            key, val = m.group(1), unesc(m.group(2))
            if key == "msgid":
                flush(); cur_id = val; mode = "id"
            elif key == "msgstr" or key == "msgstr[0]":
                cur_str = val; mode = "str"
            elif key.startswith("msgstr["):
                mode = "other"
            else:
                mode = "other"
            continue
        m = re.match(r'^"(.*)"$', line)
        if m:
            val = unesc(m.group(1))
            if mode == "id" and cur_id is not None: cur_id += val
            elif mode == "str" and cur_str is not None: cur_str += val
    flush()
    out.pop("", None)
    return out

def source_strings(root):
    """(msgid, file:line) for every _("...") in es-app/src and es-core/src, adjacent literals joined."""
    found = {}
    pat = re.compile(r'_\(\s*((?:"(?:[^"\\]|\\.)*"\s*)+)\)')
    for sub in ("es-app/src", "es-core/src"):
        for dp, _dirs, files in os.walk(os.path.join(root, sub)):
            for f in files:
                if not f.endswith((".cpp", ".h")):
                    continue
                p = os.path.join(dp, f)
                try:
                    text = open(p, encoding="utf-8", errors="replace").read()
                except OSError:
                    continue
                for m in pat.finditer(text):
                    lits = re.findall(r'"((?:[^"\\]|\\.)*)"', m.group(1))
                    raw = "".join(lits)
                    try:
                        msgid = bytes(raw, "utf-8").decode("unicode_escape").encode("latin-1").decode("utf-8")
                    except Exception:
                        msgid = raw
                    if not msgid:
                        continue
                    line = text.count("\n", 0, m.start()) + 1
                    found.setdefault(msgid, os.path.relpath(p, root) + ":" + str(line))
    return found

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--es-src", default=os.environ.get("ES_SRC", ""))
    ap.add_argument("--upstream", default="", help="the upstream base commit(s) whose catalogue defines the non-fork strings; default: every merge base of HEAD with ES_UPSTREAM_REF (rocknix/master)")
    ap.add_argument("--upstream-ref", default=os.environ.get("ES_UPSTREAM_REF", "rocknix/master"), help="the upstream branch the base is derived from (ES_UPSTREAM_REF)")
    ap.add_argument("--quiet", action="store_true")
    a = ap.parse_args()
    if not a.es_src or not os.path.isdir(os.path.join(a.es_src, "es-app", "src")):
        print("es-untranslated: --es-src (or ES_SRC) must name an EmulationStation checkout", file=sys.stderr); return 2
    po_path = os.path.join(a.es_src, "locale", "lang", "fr", "LC_MESSAGES", "emulationstation2.po")
    try:
        fr = parse_po(open(po_path, encoding="utf-8").read())
    except OSError as e:
        print("es-untranslated: cannot read " + po_path + ": " + str(e), file=sys.stderr); return 2
    # The base is derived, not remembered (audit #258 PL-022): a constant
    # outlives the rebase that moves it, and every string upstream added
    # since then is then counted as the fork's. `git merge-base --all` gives
    # every base of a criss-cross history; the union of their catalogues is
    # what upstream carried. Failing to find one is a check that cannot
    # run, not an empty upstream.
    bases = [b for b in a.upstream.split(",") if b]
    if not bases:
        r = subprocess.run(["git", "-C", a.es_src, "merge-base", "--all", "HEAD", a.upstream_ref], capture_output=True, text=True)
        if r.returncode != 0 or not r.stdout.strip():
            print("es-untranslated: no merge base of HEAD with " + a.upstream_ref + " -- fetch the upstream remote (git remote add rocknix https://github.com/ROCKNIX/emulationstation-next.git; git fetch rocknix master) or pass --upstream <commit>: " + r.stderr.strip(), file=sys.stderr); return 2
        bases = r.stdout.split()
    upstream_ids = set()
    for b in bases:
        try:
            up = subprocess.run(["git", "-C", a.es_src, "show", b + ":locale/lang/fr/LC_MESSAGES/emulationstation2.po"],
                                capture_output=True, text=True, check=True).stdout
        except subprocess.CalledProcessError as e:
            print("es-untranslated: cannot read the upstream catalogue at " + b + ": " + e.stderr.strip(), file=sys.stderr); return 2
        upstream_ids |= set(parse_po(up).keys())
    # Upstream's own source at each base, for the strings its catalogue does not
    # carry yet. Extracted with git archive, so a base that cannot be read is a
    # check that cannot run, not an upstream with no strings.
    import tempfile
    upstream_src_ids = set()
    for b in bases:
        with tempfile.TemporaryDirectory(prefix="es-untranslated-") as tmp:
            arc = subprocess.run(["git", "-C", a.es_src, "archive", "--format=tar", b, "es-app/src", "es-core/src"], capture_output=True)
            if arc.returncode != 0:
                print("es-untranslated: cannot read the upstream source at " + b + ": " + arc.stderr.decode(errors="replace").strip(), file=sys.stderr); return 2
            if subprocess.run(["tar", "-x", "-C", tmp], input=arc.stdout).returncode != 0:
                print("es-untranslated: cannot unpack the upstream source at " + b, file=sys.stderr); return 2
            found = source_strings(tmp)
            if not found:
                print("es-untranslated: the upstream source at " + b + " has no _() strings -- not a believable base", file=sys.stderr); return 2
            upstream_src_ids |= set(found)
    print("es-untranslated: upstream base " + ", ".join(b[:9] for b in bases) + (" (merge base of HEAD with " + a.upstream_ref + ")" if not a.upstream else " (given)"))
    src = source_strings(a.es_src)
    fork = {k: v for k, v in src.items() if k not in upstream_ids and k not in upstream_src_ids}
    upstream_untranslated = sorted((v, k) for k, v in src.items() if k in upstream_src_ids and k not in upstream_ids and not fr.get(k))
    missing = sorted(((v, k) for k, v in fork.items() if not fr.get(k)), key=lambda t: (t[0].split(":")[0], int(t[0].split(":")[1])))
    if not a.quiet:
        for where, msgid in missing:
            print(where + "\t" + msgid.replace("\n", "\\n"))
    print("es-untranslated: %d fork string(s) in the source, %d with French, %d without" % (len(fork), len(fork) - len(missing), len(missing)))
    if upstream_untranslated:
        print("es-untranslated: %d upstream string(s) not in upstream's catalogue and without French (upstream's, not counted):" % len(upstream_untranslated))
        if not a.quiet:
            for where, msgid in upstream_untranslated:
                print("  " + where + "\t" + msgid.replace("\n", "\\n"))
    return 1 if missing else 0

if __name__ == "__main__":
    sys.exit(main())
