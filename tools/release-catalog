#
# What did each cut carry, what was proven on it, and where is it now? One
# generated page from the RECORD.txt beside every kept image, so the question
# is a lookup and not an archaeology (#267, D-WORKFLOW-044).
#
#   tools/release-catalog --write        # regenerate docs/releases/catalog.md
#   tools/release-catalog --check        # exit 1 when the page is stale (serval only:
#                                        #   the artifacts live outside the repo)
#   tools/release-catalog                # print the table
#
# Reads /workspace/artifacts/rocknix-images/*/RECORD.txt (ARTIFACTS overrides).
# A RECORD.txt is `KEY<spaces>value` lines with continuation lines indented;
# the keys this reads: BUILD_ID, Built, Replaces, Delta, Proof, Device, Files,
# Superseded. The standing device facts are the hand-kept page beside the
# catalog, docs/releases/device-facts.md, which this tool does not write.

import glob
import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
ARTIFACTS = os.environ.get('ARTIFACTS', '/workspace/artifacts/rocknix-images')
PAGE = os.path.join(ROOT, 'docs/releases/catalog.md')
KEYS = ('BUILD_ID', 'Built', 'Replaces', 'Delta', 'Proof', 'Device', 'Files', 'Superseded')


def parse(path):
    rec = {'title': '', 'folder': os.path.basename(os.path.dirname(path))}
    key = None
    for line in open(path, encoding='utf-8', errors='replace'):
        line = line.rstrip('\n')
        if not rec['title'] and not key:
            rec['title'] = line.strip()
            continue
        m = re.match(r'^([A-Za-z_]+)\s{2,}(.*)$', line)
        if m and m.group(1) in KEYS:
            key = m.group(1)
            rec[key] = m.group(2).strip()
        elif key and line.startswith(' '):
            rec[key] += ' ' + line.strip()
    return rec


def clip(s, n):
    s = ' '.join((s or '').split())
    return s if len(s) <= n else s[:n - 1] + '…'


def state(rec):
    d = rec.get('Device', '')
    if rec.get('Superseded'):
        return 'superseded'
    if re.search(r'^On the|since \d{4}-\d\d-\d\d', d):
        return 'on a device'
    if 'Not staged' in d:
        return 'not staged'
    return d[:20] or '-'


def render(recs):
    out = ['# Release catalog', '',
           'Generated by `tools/release-catalog --write` from the `RECORD.txt` beside every kept',
           'image under `/workspace/artifacts/rocknix-images/`; do not edit by hand. One row per',
           'cut, newest first; the full RECORD.txt is the row\'s evidence. The standing device',
           'facts -- what only a handheld can show, and when each was last seen -- are',
           '[device-facts.md](device-facts.md), kept by hand (D-WORKFLOW-044, #267).', '',
           '| Kept as | Cut | BUILD_ID | Built | Where it is | What it carried | Proof |',
           '| --- | --- | --- | --- | --- | --- | --- |']
    for r in recs:
        cut = re.search(r'([a-z]+(?:-[a-z]+)? cut)', r.get('title', '')) or re.search(r'(RC-\d+)', r.get('title', ''))
        out.append('| `%s` | %s | `%s` | %s | %s | %s | %s |' % (
            r['folder'], cut.group(1) if cut else clip(r.get('title', ''), 40),
            (r.get('BUILD_ID', '') or '-').split(' ')[0], clip(r.get('Built', ''), 40),
            clip(r.get('Device', '') if state(r) != 'superseded' else 'superseded: ' + r.get('Superseded', ''), 140),
            clip(r.get('Delta', ''), 220), clip(r.get('Proof', ''), 220)))
    out += ['', '%d cuts with a RECORD.txt. A folder without one is an image nobody recorded, which is the' % len(recs),
            'shape #257 and the runbook forbid: write the RECORD.txt before the copy.', '']
    return '\n'.join(out)


def main():
    paths = glob.glob(os.path.join(ARTIFACTS, '*', 'RECORD.txt'))
    recs = [parse(p) for p in paths]
    recs.sort(key=lambda r: (r.get('Built', ''), r['folder']), reverse=True)
    text = render(recs)
    if '--write' in sys.argv:
        os.makedirs(os.path.dirname(PAGE), exist_ok=True)
        open(PAGE, 'w', encoding='utf-8').write(text)
        print('wrote %s (%d cuts)' % (os.path.relpath(PAGE, ROOT), len(recs)))
        return 0
    if '--check' in sys.argv:
        cur = open(PAGE, encoding='utf-8').read() if os.path.exists(PAGE) else ''
        if cur != text:
            print('release-catalog: docs/releases/catalog.md is stale; run tools/release-catalog --write')
            return 1
        print('release-catalog: current (%d cuts)' % len(recs))
        return 0
    print(text)
    return 0


if __name__ == '__main__':
    sys.exit(main())
