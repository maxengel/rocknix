// The phone keyboard page's own script, run against a small DOM: what the box
// shows is compared with what the handheld's field holds, where the field is
// rebuilt from the requests the page made, in order, the way cloud_oauth
// types them (printable ASCII only: KEYMAP is a US layout).
//
//   node page_test.js <rendered page.html>     P/F lines, then END
"use strict";
const fs = require("fs");
const vm = require("vm");

const html = fs.readFileSync(process.argv[2], "utf8");
const script = html.split("<script>").pop().split("</script>")[0];
let failed = 0, groups = 0;
function result(ok, good, bad) {
  console.log(ok ? "P " + good : "F " + bad);
}

function attrs(text) {
  const out = {};
  const re = /([\w-]+)(?:=("[^"]*"|'[^']*'|[^\s>]+))?/g;
  let m;
  while ((m = re.exec(text))) {
    let v = m[2] === undefined ? "" : m[2];
    if (v[0] === '"' || v[0] === "'") v = v.slice(1, -1);
    out[m[1].toLowerCase()] = v;
  }
  return out;
}

function page(probeText) {
  const byId = {}, keys = [], posts = [], timers = [];
  let probe = probeText;
  function el(tag, a) {
    const e = {
      tagName: tag.toUpperCase(), id: a.id || "", type: a.type || "",
      className: a.class || "", hidden: "hidden" in a, value: "", textContent: "",
      dataset: {}, listeners: {},
      classList: { add() {}, remove() {} },
      addEventListener(ev, fn) { (this.listeners[ev] = this.listeners[ev] || []).push(fn); },
      fire(ev, extra) {
        const e2 = Object.assign({ preventDefault() {}, touches: null, clientX: 0, clientY: 0 }, extra || {});
        (this.listeners[ev] || []).forEach((fn) => fn(e2));
      },
      focus() {}, setAttribute(k, v) { this[k] = v; }, getAttribute(k) { return this[k]; },
    };
    if (a["data-key"] !== undefined) e.dataset.key = a["data-key"];
    return e;
  }
  const tagRe = /<(input|button|div|span|p)\b([^>]*)>/gi;
  let m;
  while ((m = tagRe.exec(html))) {
    const a = attrs(m[2]);
    const e = el(m[1], a);
    if (a.id) byId[a.id] = e;
    if (a["data-key"] !== undefined) keys.push(e);
  }
  const document = {
    getElementById: (id) => byId[id] || null,
    querySelectorAll: (sel) => (sel === "[data-key]" ? keys : []),
    querySelector: () => null,
  };
  const sandbox = {
    document,
    window: { addEventListener() {} },
    setTimeout: (fn, ms) => timers.push(fn),
    fetch: (url, opts) => {
      if (opts && opts.method === "POST") {
        posts.push(opts.body);
        return Promise.resolve({ text: () => Promise.resolve("") });
      }
      return Promise.resolve({ text: () => Promise.resolve(probe) });
    },
    Promise, URLSearchParams, encodeURIComponent, decodeURIComponent, Math, Array, String, Object, JSON, RegExp,
  };
  vm.runInNewContext(script, sandbox);
  return {
    byId, keys, posts,
    box: byId.kb,
    setProbe(t) { probe = t; },
    async settle() { for (let i = 0; i < 50; i++) await new Promise((r) => setImmediate(r)); },
    async poll() { const run = timers.splice(0); run.forEach((fn) => fn()); await this.settle(); },
    async type(v) { this.box.value = v; this.box.fire("input"); await this.settle(); },
    async key(name) {
      const b = keys.find((k) => k.dataset.key === name);
      if (!b) throw new Error("no " + name + " button on the page");
      b.fire("click"); await this.settle();
    },
    async hardKey(key) { this.box.fire("keydown", { key }); await this.settle(); },
    device() {
      const fields = [""]; let cur = 0, closed = false;
      for (const body of posts) {
        const q = new URLSearchParams(body);
        if (q.has("type")) for (const ch of q.get("type")) if (ch >= " " && ch <= "~") fields[cur] += ch;
        const k = q.get("key");
        if (k === "backspace") fields[cur] = fields[cur].slice(0, -1);
        if (k === "tab" || k === "up" || k === "down") { cur += 1; fields[cur] = fields[cur] || ""; }
        if (k === "escape") closed = true;
      }
      return { field: fields[cur], closed };
    },
  };
}

const groupsList = [];
function group(fn) { groupsList.push(fn); }

