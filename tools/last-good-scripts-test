printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\nglobal.retroachievements.username=somebodyelse\n' > "${PCFG}"
ctl account; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "account for a user the proxy never signed in: exit 1, nothing on stdout" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\n' > "${PCFG}"
ctl account; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "account with no user name set: exit 1, nothing on stdout" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
# The toggle off: the service is stopped, and a row nobody will send is not
# on its way anywhere.
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=0\nglobal.retroachievements.username=QA\n' > "${PCFG}"
ctl pending; [ "${RC}" -eq 1 ] && [ "$(cat "${OUT}")" = "0" ]; check $? "the same rows with the toggle off: 0, exit 1 -- nothing would send them" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
ctl pending-ids; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "pending-ids with the toggle off: nothing, exit 1" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
ctl account; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "account with the toggle off: nothing, exit 1" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\nglobal.retroachievements.username=QA\n' > "${PCFG}"
# A store that cannot be read: an unknown count is never printed as one.
rm -f "${PDB}-wal" "${PDB}-shm"; printf 'not a database\n' > "${PDB}"
ctl pending; [ "${RC}" -eq 2 ] && [ ! -s "${OUT}" ] && grep -q 'could not be read' "${ERR}"; check $? "a store that is not one: exit 2, nothing on stdout, the reason on stderr" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
ctl pending-ids; [ "${RC}" -eq 2 ] && [ ! -s "${OUT}" ] && grep -q 'could not be read' "${ERR}"; check $? "pending-ids on that store: exit 2, nothing on stdout" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
ctl account; [ "${RC}" -eq 2 ] && [ ! -s "${OUT}" ] && grep -q 'could not be read' "${ERR}"; check $? "account on that store: exit 2, nothing on stdout" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
rm -f "${PDB}" "${PDB}-wal" "${PDB}-shm"
ctl pending-ids; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "pending-ids with no store: nothing, exit 1" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\n' > "${PCFG}"
# flushed: the stamp patches/003 has the service leave after a flush that
# sent awards, "<epoch> <flushed>", told once.
ctl flushed; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "flushed with no stamp: exit 1, nothing on stdout" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
printf '1789337156 2\n' > "${PSTAMP}"
ctl flushed; [ "${RC}" -eq 0 ] && [ "$(cat "${OUT}")" = "1789337156 2" ] && [ ! -e "${PSTAMP}" ]; check $? "a stamp: printed as written, exit 0, and removed" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); stamp: $([ -e "${PSTAMP}" ] && echo still there || echo gone)"
ctl flushed; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ]; check $? "asked again: exit 1 -- one flush is said once" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}")"
printf '1789337156 0\n' > "${PSTAMP}"
ctl flushed; [ "${RC}" -eq 1 ] && [ ! -s "${OUT}" ] && [ ! -e "${PSTAMP}" ]; check $? "a stamp that says nothing went: removed, exit 1, nothing claimed" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); stamp: $([ -e "${PSTAMP}" ] && echo still there || echo gone)"
# A flush that lands between the read and the remove (the head shim writes
