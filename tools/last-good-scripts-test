done
hits=$(python3 - "${E_SRC}" <<'EOS'
import re, sys, os
FORBIDDEN = re.compile(
    r"(?i)(\bexit(ed)?(\s+code)?\s*[:=]?\s*\(?-?\d+\)?|\brc\s*=\s*-?\d+|/var/log\S*|\S+\.log\b"
    r"|\blogger\b|\bjournalctl\b|\brclone\b|\bstderr\b|\bsysexits\b|\bEX_[A-Z]+\b|\bSIG(TERM|KILL|INT)\b"
    r"|\berrno\b|\bpid\s+\d+|\bflock\b|\bsentinel\b|\bcloud_[a-z_]+\b|\bbackuptool\b|(^|\s)--[a-z][a-z-]+"
    r"|\bCOMPLETED WITH ERRORS\b)")
d = sys.argv[1]; n_hits = 0
for f in sorted(os.listdir(d)):
    content_script = f.startswith("cloud_content_")
    for n, line in enumerate(open(os.path.join(d, f)), 1):
        t = line.strip()
        m = re.match(r'(echo(\s+-e)?|log_message|fail|note|why)\s+(".*?(?<!\\)"|\'.*?\')(.*)$', t)
        if not m: continue
        cmd, _, lit, rest = m.groups()
        if cmd == "log_message" and (content_script or re.search(r'^\s*"false"', rest)): continue
        if re.search(r'>>?\s*"?\$?\{?(LOG_FILE|log_file)|>&2|>>?\s*"?/', rest): continue
        text = lit[1:-1]
        if text.startswith(">>> ") and not text.startswith(">>> why"): continue
        mm = FORBIDDEN.search(text)
        if mm:
            n_hits += 1
            print(f"      {f}:{n}: [{mm.group(0).strip()}] {text[:100]}")
print(f"HITS={n_hits}")
EOS
)
