[ -e "${QSVC}/smb.conf" ]; check $? "samba on: smb.conf is still there after the pass" "smb.conf is gone after the pass: a fragment without CONF (004-tailscaled) inherited samba's and removed it; markers left: $(ls "${QSVC}" | tr '\n' ' ')"
