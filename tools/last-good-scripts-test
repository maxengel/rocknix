}
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\n' > "${PCFG}"
rm -f "${PDB}" "${PDB}-wal" "${PDB}-shm" "${PSTAMP}"
ctl pending; [ "${RC}" -eq 1 ] && [ "$(cat "${OUT}")" = "0" ]; check $? "pending before the service ever wrote a store: 0, exit 1" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
pdb
ctl pending; [ "${RC}" -eq 1 ] && [ "$(cat "${OUT}")" = "0" ]; check $? "an empty queue: 0, exit 1" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
pdb "$(prow 100359 pending)" "$(prow 100358 flushed)" "$(prow 100357 stale)"
ctl pending; [ "${RC}" -eq 0 ] && [ "$(cat "${OUT}")" = "1" ] && [ "$(wc -l < "${OUT}")" -eq 1 ]; check $? "one pending row beside a flushed and a stale one: 1, on the one line, exit 0" "rc ${RC}; stdout: $(tr '\n' '|' < "${OUT}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
