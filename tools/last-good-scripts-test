grep -q '^LOADED SAVESPATH=/storage/roms$' "${OUT}" && bash -n "${DS}/.config/cloud_sync.conf" 2>/dev/null; check $? "load_config on a torn conf falls back to the .bak and goes on" "rc ${RC}; out: $(grep -v '^\[' "${OUT}" | tail -2 | tr '\n' '|'); conf parses: $(bash -n "${DS}/.config/cloud_sync.conf" 2>/dev/null && echo yes || echo no)"
printf 'SAVESPATH="/storage/roms"\nSAVES_REMOTE="/ROCK' > "${DS}/.config/cloud_sync.conf"; rm -f "${DS}/.config/cloud_sync.conf.bak" "${DS}/.cache/cloud_sync/last-backup"
sb bash /repo/load.sh
[ "${RC}" -eq 1 ] && ! grep -q '^LOADED' "${OUT}"; check $? "with no .bak it refuses (rc 1) instead of running with half a config" "rc ${RC}; out: $(grep -v '^\[' "${OUT}" | tail -2 | tr '\n' '|')"
grep -q "^>>> why YOUR CLOUD SYNC SETTINGS COULDN'T BE READ$" "${OUT}"; check $? "and says why on the protocol line" "no >>> why line; out: $(grep -v '^\[' "${OUT}" | tr '\n' '|' | cut -c1-200)"
stamp="$(cat "${DS}/.cache/cloud_sync/last-backup" 2>/dev/null)"
