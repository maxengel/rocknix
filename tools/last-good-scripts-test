    [ -e "${QSVC}/smb.conf" ]; check $? "and samba's marker is still there" "smb.conf gone; markers left: $(ls "${QSVC}" | tr '\n' ' ')"
else
    check 1 "" "006-raofflineproxy is absent at ${BASE_REF}: the toggle had no boot pass"
