case "$1 $2 $3" in
    "-m raofflineproxy.main probe-online")
        a="$(head -n 1 /run/probe-answers 2>/dev/null)"; [ -n "$a" ] || a=false
        [ "$(wc -l < /run/probe-answers 2>/dev/null || echo 0)" -gt 1 ] && sed -i '1d' /run/probe-answers
        echo "probe dir=${RAOFFLINEPROXY_CONFIG_DIR} answer=${a} at=$(cat /run/clock 2>/dev/null)" >> /run/probe.log
        mkdir -p "${RAOFFLINEPROXY_CONFIG_DIR}" && printf '{\n  "online": %s\n}\n' "$a" > "${RAOFFLINEPROXY_CONFIG_DIR}/online_state.json"; exit 0 ;;
    "-m raofflineproxy.main run-smart-cache")
        echo "smart budget=${FAKE_BUDGET:-none} at=$(cat /run/clock 2>/dev/null)" >> /run/probe.log
        if [ -s /run/smart-slow ]; then s="$(cat /run/smart-slow)"; if [ -n "${FAKE_BUDGET:-}" ] && [ "$s" -gt "${FAKE_BUDGET}" ]; then echo $(( $(cat /run/clock) + FAKE_BUDGET )) > /run/clock; touch /run/timeout-hit; exit 143; fi; echo $(( $(cat /run/clock) + s )) > /run/clock; fi
        cat /run/smart-result 2>/dev/null || echo '{"type":"result","scanned":0,"total":0,"cached":0,"skipped":0,"limit_reached":false}'; exit 0 ;;
    "-m raofflineproxy.main cached-games-count") cat /run/cached-count 2>/dev/null || echo 0; exit 0 ;;
esac
if [ "$1" = "-" ] && [ -s /run/listing-delay ]; then echo $(( $(cat /run/clock) + $(cat /run/listing-delay) )) > /run/clock; fi
exec /usr/bin/python3 "$@"
EOS
# The helper the ctl runs beside itself, speaking cache-roms' lines: job i
# does what line i of /run/helper-plan says -- ok (the three rows a launch
# reads, written through the real Storage for the signed-in account, the
# ROM's path on the patch row), skip (no match), fail (a fetch that did not
# come back), login (sign-in refused), slow N (N virtual seconds, or the
# budget and a timeout), wait N (N real seconds), cancel (the interface's
# SIGINT to the ctl, then wait to be ended), die -- and ok when there is no
# line. It records its pid, its jobs and its start and end.
cat > "${T}/repo/raofflineproxy-cache-indexed" <<'EOS'
import os, signal, sys, time
from pathlib import Path
from raofflineproxy import cache_keys
from raofflineproxy.rom_browser import normalize_cached_rom_path
from raofflineproxy.storage import Storage
run = Path("/run"); (run / "helper.pid").write_text(f"{os.getpid()}\n")
def clock(): return int((run / "clock").read_text().strip() or 0)
def now(): return clock() if (run / "clock").exists() else int(time.time())
(run / "helper-times").write_text(f"start {now()}\n")
user = ""
for line in Path("/storage/.config/system/configs/system.cfg").read_text().splitlines():
    if line.startswith("global.retroachievements.username="): user = cache_keys.normalize_user(line.split("=", 1)[1])
plan = (run / "helper-plan").read_text().splitlines() if (run / "helper-plan").exists() else []
jobs = [l for l in Path(sys.argv[1]).read_text().splitlines() if l.strip()]
with (run / "helper-jobs.log").open("a") as log: log.write("".join(j + "\n" for j in jobs))
storage = Storage(); cached = failed = indexed = 0; total = len(jobs)
def say(text): print(text, flush=True)
running = Path(os.environ.get("RAOFFLINEPROXY_CONFIG_DIR", "/storage/.config/raofflineproxy")) / "running"
for i, raw in enumerate(jobs, start=1):
    kind, gid, hsh, path = raw.split("\t", 3); label = Path(path).name
    if i > 1: time.sleep(0.2)   # let the ctl read the last OK and rewrite the progress file
    if running.exists():
        with (run / "running-seen").open("a") as f: f.write(running.read_text())
    step = plan[i - 1].split() if i - 1 < len(plan) and plan[i - 1].strip() else ["ok"]
    if step[0] == "skip": failed += 1; say(f"FAIL {i}/{total} {label}: No RetroAchievements match"); continue
    if step[0] == "fail": failed += 1; say(f"FAIL {i}/{total} {label}: patch request failed: HTTP Error 429: Too Many Requests"); continue
    if step[0] == "login": failed += 1; say(f"FAIL {i}/{total} {label}: RetroAchievements login required"); continue
    if step[0] == "die": sys.exit(3)
    if step[0] == "wait": time.sleep(float(step[1]))
    if step[0] == "cancel":
        # The interface's CANCEL (D-UI-078): SIGINT to the ctl, whose pid is
        # the lock file's first line. Sent from here rather than from a
        # background job of the harness, whose children have SIGINT ignored
        # at entry and so cannot trap it (POSIX asynchronous lists).
        os.kill(int(Path("/var/run/raofflineproxy-scan.lock").read_text().split()[0]), signal.SIGINT); time.sleep(10); continue
    if step[0] == "slow":
        n = int(step[1]); budget = os.environ.get("FAKE_BUDGET")
        if budget and n > int(budget):
            (run / "clock").write_text(f"{clock() + int(budget)}\n"); (run / "timeout-hit").touch(); sys.exit(143)
        (run / "clock").write_text(f"{clock() + n}\n")
    game_id = int(gid) if gid else 9000 + i; hash_value = hsh or f"h{i:04d}"
    storage.upsert_cache(cache_keys.patch(game_id, user), '{"Success":true,"PatchData":{"ID":%d,"Title":"G%d"}}' % (game_id, game_id), source_rom_path=normalize_cached_rom_path(path))
    storage.upsert_cache(cache_keys.unlocks(game_id, user), '{"Success":true,"UserUnlocks":[]}')
    storage.upsert_cache(cache_keys.achievementsets(hash_value, user), '{"Success":true,"GameId":%d,"Sets":[]}' % game_id)
    cached += 1; indexed += 1 if kind == "I" else 0; say(f"OK {i}/{total} {label}")
storage.close()
with (run / "helper-times").open("a") as f: f.write(f"end {now()}\n")
say(f"DONE cached={cached} failed={failed} indexed={indexed}")
# After DONE (fork #188): what the badge downloads did on the RG SP -- `slow N`
# runs on past the budget and is killed by the fake timeout; `die` ends with 3.
linger = (run / "helper-linger").read_text().split() if (run / "helper-linger").exists() else []
if linger and linger[0] == "slow":
    n = int(linger[1]); budget = os.environ.get("FAKE_BUDGET")
    if budget and n > int(budget):
        (run / "clock").write_text(f"{clock() + int(budget)}\n"); (run / "timeout-hit").touch(); sys.exit(143)
    (run / "clock").write_text(f"{clock() + n}\n")
if linger and linger[0] == "die": sys.exit(3)
EOS
# MAX_SCAN_ENTRIES is the client's constant; with RA_TEST_SCAN_CAP set this
