echo "  g. the in-script RCLONE_NET_OPTS fallback is the shipped value (#146)"
# Four scripts carry a constant for a conf the helper has not reached, and
# their comments promise it equals the shipped RCLONE_NET_OPTS. #107 moved
# the shipped value to ten low-level retries and left all four at two; on
# the fallback path (a torn conf, a blanked line) that is #107 back, and no
# check read the constants (audit 2026-09-12, F-03). A comment is not a check.
shipped=$(sed -n 's/^DEFAULT_RCLONE_NET_OPTS="\(.*\)"$/\1/p' "${ROOT}/${RCLONE_REL}/cloud_sync.conf.defaults")
