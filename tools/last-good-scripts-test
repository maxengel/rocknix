    ( set +u; DEVICE="$2"; ARCH="$3"; TARGET_ARCH="$3"; ROOT="${4:-${ROOT}}"; PKG_DIR="$(dirname "$1")"
      OPENGL=mesa; OPENGLES=no; DISPLAYSERVER=wl; SYSROOT_PREFIX=/sysroot; TARGET_NAME=t; TARGET_PREFIX=t-
      die() { echo "DIE: $*"; exit 3; }
      safe_remove() { local p; for p in "$@"; do [ -e "${p}" ] || [ -L "${p}" ] && rm -r "${p}"; done; }
      get_build_dir() { echo "/build/$1"; }
      get_pkg_directory() { echo "${ROOT}/packages/${1}"; }
      . "$1" >/dev/null 2>&1
      eval "${F2_CALL}" )
}
F2P="projects/ROCKNIX/packages"

# F2-5. #308 7-generic-x64-vm claude F-VM-09: GENERIC_X64's mupen64plus.cfg
# carried an InputAutoCfg.ini block ("[Retroid Pocket Gamepad]", pasted from
# SM8250's copy) inside [Input-SDL-Control1], so every Control1 mapping sat
# in a section of its own. Each key of Control1 is read under Control1, once.
echo "  F2-5. GENERIC_X64's mupen64plus.cfg: every Control1 mapping is in [Input-SDL-Control1], once (#308 F-VM-09)"
M64="${F2}/mupen64plus.cfg"; src_of "${F2P}/emulators/standalone/mupen64plus-sa/mupen64plus-sa-core/config/GENERIC_X64/mupen64plus.cfg" "${M64}"
F2_OUT="$(awk -F' *= *' '/^\[/{sec=$0; next} /^[A-Za-z]/{ if (sec=="[Input-SDL-Control1]") n[$1]++; if ($1=="X Axis" && !seen++) xsec=sec }
    END { d=""; for (k in n) if (n[k]>1) d=d" "k"x"n[k]; print xsec "|" (("DPad R" in n) ? "dpad" : "no-dpad") "|" d }' "${M64}")"
[ "${F2_OUT}" = "[Input-SDL-Control1]|dpad|" ]; check $? "Control1's DPad and axis mappings are read under [Input-SDL-Control1], each key once" "Control1 read as '${F2_OUT}' (section of the first X Axis | DPad R present | keys seen twice) -- a section header is spliced into it"

# F2-5b. The audit of the fixes, claude G-F2-08 and gpt G-F2-04: the seed
# is fixed, but start_mupen64plus.sh copies it only when the player has no
# mupen64plus.cfg, so a GENERIC_X64 guest that ran mupen64plus before keeps
# the splice. The launcher's repair block is taken out of the script and run
# under the image's awk and mv against the audited seed with two settings
# the player changed: the six pasted lines go, every other byte stays, a
# second run changes nothing, and another device's copy -- SM8250's seed
# carries the same splice, upstream's file -- is left alone.
echo "  F2-5b. a GENERIC_X64 guest's existing mupen64plus.cfg loses the splice at the next launch and keeps everything else (#307 follow-up: claude G-F2-08, gpt G-F2-04)"
MR="${F2}/m64repair"; mkdir -p "${MR}"
src_of "${F2P}/emulators/standalone/mupen64plus-sa/mupen64plus-sa-core/scripts/start_mupen64plus.sh" "${MR}/start_mupen64plus.sh"
awk '/# ROCKNIX: GENERIC_X64 repair begin/,/# ROCKNIX: GENERIC_X64 repair end/' "${MR}/start_mupen64plus.sh" > "${MR}/repair.sh"
git -C "${ROOT}" show "417dcd8610:${F2P}/emulators/standalone/mupen64plus-sa/mupen64plus-sa-core/config/GENERIC_X64/mupen64plus.cfg" > "${MR}/spliced.cfg" 2>/dev/null
sed -e '0,/^plugin = 2$/s//plugin = 5/' -e 's/^ScreenWidth = .*/ScreenWidth = 1280/' "${MR}/spliced.cfg" > "${MR}/player.cfg"
f2_m64() { # <HW_DEVICE> <cfg>: run the repair block as the launcher would
    ( set +u; HW_DEVICE="$1"; M64PCONF="$2"; PATH="${TMP}/bbin:${PATH}"; . "${MR}/repair.sh" ) > /dev/null 2>&1
}
cp "${MR}/player.cfg" "${MR}/g.cfg"; f2_m64 GENERIC_X64 "${MR}/g.cfg"
F2_OUT="$(diff "${MR}/player.cfg" "${MR}/g.cfg" | grep '^[<>]' | tr '\n' '|')"
[ -s "${MR}/repair.sh" ] && [ "${F2_OUT}" = "< ; Retroid Pocket Gamepad - default.ini|< [Retroid Pocket Gamepad]|< plugged = True|< mouse = False|< AnalogDeadzone = 0,0|< AnalogPeak = 32768,32768|" ]
check $? "GENERIC_X64: exactly the six pasted lines leave the player's copy; plugin = 5 and ScreenWidth = 1280 stay" "the repair changed: '${F2_OUT:-nothing}' $([ -s "${MR}/repair.sh" ] || echo '(start_mupen64plus.sh has no repair block)')"
cp "${MR}/g.cfg" "${MR}/g1.cfg"; f2_m64 GENERIC_X64 "${MR}/g.cfg"
cmp -s "${MR}/g.cfg" "${MR}/g1.cfg" && grep -q '^plugin = 5$' "${MR}/g.cfg"; check $? "a second launch changes nothing" "a second run changed the repaired copy"
cp "${MR}/player.cfg" "${MR}/s.cfg"; f2_m64 SM8250 "${MR}/s.cfg"
cmp -s "${MR}/s.cfg" "${MR}/player.cfg"; check $? "another device's copy is left as it is" "the repair touched a copy on HW_DEVICE=SM8250"

# F2-6. #308 9-emulators claude F-EM-02: ppsspp-lr's strip of the
# aarch64-only -mno-outline-atomics ran in post_unpack, before scripts/unpack
# applies the patches (005 adds the flag), so it never found it. The recipe's
# hooks and its patches are run in scripts/unpack's order over the pinned
# source's files: x86_64 comes out without the flag, aarch64 with it.
echo "  F2-6. ppsspp-lr: the x86_64 strip of -mno-outline-atomics runs after the patches that add it (#308 F-EM-02)"
PP_PIN="$(sed -n 's/^PKG_VERSION="\([0-9a-f]*\)".*/\1/p' "${ROOT}/${F2P}/emulators/libretro/ppsspp-lr/package.mk" | head -1)"
PP_SRC=""
for d in "${SOURCES_DIR:-}" /workspace/cache/rocknix-sources "${ROOT}/sources" "${ROOT}"/../*/sources; do
    [ -n "${d}" ] && [ -f "${d}/ppsspp-lr/ppsspp-lr-${PP_PIN}/CMakeLists.txt" ] && { PP_SRC="${d}/ppsspp-lr/ppsspp-lr-${PP_PIN}"; break; }
done
if [ -z "${PP_SRC}" ]; then
    check 1 "" "the ppsspp-lr source ppsspp-lr-${PP_PIN:-?} is not under SOURCES_DIR, /workspace/cache/rocknix-sources or a build worktree's sources/ -- F2-6 did not run (a check that cannot run has not passed)"
else
PX="${F2}/ppsspp"; mkdir -p "${PX}/pkg/patches"
src_of "${F2P}/emulators/libretro/ppsspp-lr/package.mk" "${PX}/pkg/package.mk"
if [ "${OLD}" -eq 1 ]; then
    git -C "${ROOT}" ls-tree --name-only "${BASE_REF}" "${F2P}/emulators/libretro/ppsspp-lr/patches/" | while read -r f; do git -C "${ROOT}" show "${BASE_REF}:${f}" > "${PX}/pkg/patches/${f##*/}"; done
else
    cp "${ROOT}/${F2P}"/emulators/libretro/ppsspp-lr/patches/*.patch "${PX}/pkg/patches/"
fi
for arch in x86_64 aarch64; do
    B="${PX}/build-${arch}"; rm -rf "${B}"
    for f in CMakeLists.txt Common/ArmCPUDetect.cpp Core/Util/PathUtil.cpp ffmpeg/linux_arm64.sh libretro/libretro_vulkan.cpp ext/glew/glew.c; do
        mkdir -p "$(dirname "${B}/${f}")"; cp "${PP_SRC}/${f}" "${B}/${f}"
    done
    F2_CALL="PKG_BUILD='${B}'; declare -F post_unpack >/dev/null && post_unpack; for p in '${PX}'/pkg/patches/*.patch; do patch -d '${B}' -p1 -s --no-backup-if-mismatch < \"\${p}\" || exit 4; done; declare -F post_patch >/dev/null && post_patch; grep -c 'mno-outline-atomics' '${B}/CMakeLists.txt'"
    eval "PP_${arch}=\"\$(f2_source '${PX}/pkg/package.mk' GENERIC_X64 ${arch} 2>/dev/null)\""
done
[ "${PP_x86_64}" = "0" ] && [ "${PP_aarch64}" = "1" ]; check $? "x86_64's CMakeLists.txt ends without the flag, aarch64's keeps it" "after unpack, patches and hooks: x86_64 has ${PP_x86_64:-?} add_compile_options(-mno-outline-atomics) line(s), aarch64 ${PP_aarch64:-?} -- the strip ran before the patch that adds it"
fi
# The case above calls the hooks itself; that the build calls post_patch,
# and after the patches, is scripts/unpack's to say (the audit of the
# fixes, claude G-F2-03): its own lines are read for the order post_unpack
# -> the patch loop's patch command -> post_patch.
src_of scripts/unpack "${F2}/unpack"
U_PU=$(grep -n 'pkg_call_exists_opt post_unpack && pkg_call' "${F2}/unpack" | head -1 | cut -d: -f1)
U_PA=$(grep -n 'patch -d "${PKG_BUILD}" -p1' "${F2}/unpack" | head -1 | cut -d: -f1)
U_PP=$(grep -n 'pkg_call_exists_opt post_patch && pkg_call' "${F2}/unpack" | head -1 | cut -d: -f1)
[ -n "${U_PU}" ] && [ -n "${U_PA}" ] && [ -n "${U_PP}" ] && [ "${U_PU}" -lt "${U_PA}" ] && [ "${U_PA}" -lt "${U_PP}" ]
check $? "scripts/unpack calls post_unpack (line ${U_PU}), applies the patches (${U_PA}), then calls post_patch (${U_PP})" "scripts/unpack's order is not post_unpack < patch < post_patch: lines ${U_PU:-none}, ${U_PA:-none}, ${U_PP:-none}"

