# another implementation (uutils), so GNU's is found by name.
DGNU=""; for c in gnutimeout timeout; do command -v "${c}" >/dev/null && "${c}" --version 2>/dev/null | head -n 1 | grep -q 'GNU coreutils' && { DGNU="$(command -v "${c}")"; break; }; done
if [ "${DT_OK}" -eq 1 ] && [ -n "${DGNU}" ]; then
dfake_images; printf "${DCFG_ON}" > "${TCFG}"; TENV=()
mv "${T}/shim/timeout" "${T}/shim/timeout.shim"
printf '#!/bin/sh\nexec %s "$@"\n' "${DGNU}" > "${T}/shim/timeout"; chmod +x "${T}/shim/timeout"
treset; printf 'ok\n' > "${TR}/helper-plan"; echo group-cancel > "${TR}/images-mode"; rm -f "${TR}/images-calls" "${TR}/images.pid"
DT0=$(dnow)
RC=$( ( bwrap --die-with-parent --tmpfs / --tmpfs /usr "${USR_BINDS[@]}" "${TBB[@]}" \
    --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
    --ro-bind /etc /etc --ro-bind "${T}/profile" /etc/profile \
    --bind "${TS}" /storage --ro-bind "${T}/repo" /repo --ro-bind "${T}/shim" /shim --ro-bind "${CLIENT}" /client --ro-bind "${T}/pypath" /pypath \
    --bind "${TR}" /run --tmpfs /var --bind "${T}/varrun" /var/run \
    --dev /dev --proc /proc --tmpfs /tmp --setenv PYTHONPATH /client:/pypath \
    setsid -w bash /repo/raofflineproxy-ctl scan > "${OUT}" 2> "${ERR}"; echo $? ) 2>/dev/null )
DEND=$(dnow)
mv -f "${T}/shim/timeout.shim" "${T}/shim/timeout"
DI0="$(sed -n 's/^start \([0-9.]*\).*/\1/p' "${TR}/images-calls" 2>/dev/null | head -n 1)"
IP="$(cat "${TR}/images.pid" 2>/dev/null)"; for _ in $(seq 1 30); do kill -0 "${IP:-1}" 2>/dev/null || break; sleep 0.1; done
[ "${RC}" -eq 130 ] && grep -qx '>>> why CANCELLED' "${OUT}" && [ -n "${DI0}" ] && awk -v a="${DI0}" -v b="${DEND}" 'BEGIN{exit !(b - a < 3)}' && grep -q '^term ' "${TR}/images-calls" && ! grep -q '^int ' "${TR}/images-calls" && ! kill -0 "${IP:-1}" 2>/dev/null; check $? "claude G-D-03: under the real timeout the group's SIGINT reaches the ctl, not the helper; the run is CANCELLED (rc 130) $(awk -v a="${DI0:-0}" -v b="${DEND}" 'BEGIN{printf "%.2f", b - a}')s after the pass began and the helper is ended by SIGTERM through timeout" "claude G-D-03: rc ${RC}; the helper saw: $(tr '\n' ' ' < "${TR}/images-calls" 2>/dev/null | cut -c1-200); $(awk -v a="${DI0:-0}" -v b="${DEND}" 'BEGIN{printf "%.2f", b - a}')s; out: $(grep '^>>>' "${OUT}" | tail -n 2 | tr '\n' '|')"
[ -n "${IP}" ] && kill -9 "${IP}" 2>/dev/null; rm -f "${TR}/images-mode" "${TR}/helper-plan"
else
