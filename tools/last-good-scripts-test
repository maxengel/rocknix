sb bash /repo/cloud_sync_helper /tmp/helper.log
grep -q -- '--low-level-retries 4 --retries 1"$' "${DS}/.config/cloud_sync.conf"; check $? "a hand-tuned bound (four retries) is left alone" "conf holds: $(grep ^RCLONE_NET_OPTS "${DS}/.config/cloud_sync.conf")"


