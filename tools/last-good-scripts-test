if [ -n "${BB}" ]; then F1BB=(--ro-bind "${TMP}/bbin" /bbin --ro-bind "${BB_HOST}" "${BB}"); F1PATH="/shim:/bbin:/usr/bin:/bin"; fi
# /etc as the image has it: read-only, with the links the systemd and kmod
# recipes make into /storage (tmpfiles.d, sysctl.d, modules-load.d, the udev
# rules, the *.conf.d of logind and friends), and no /etc/systemd/system --
# the systemd recipe removes it and points systemd's own unit directory at
# /storage/.config/system.d instead (its patch 0001).
F1ETC="${F1}/etc"; mkdir -p "${F1ETC}/systemd/system.conf.d" "${F1ETC}/udev" "${F1ETC}/dbus-1/system.d"
: > "${F1ETC}/systemd/journald.conf"; : > "${F1ETC}/systemd/system.conf"
cat "${ROOT}/projects/ROCKNIX/packages/sysutils/systemd/package.mk" "${ROOT}/projects/ROCKNIX/packages/sysutils/kmod/package.mk" \
    | sed -n 's#^ *ln -sf \(/storage/[^ ]*\) ${INSTALL}/etc/\([^ ]*\)$#\1 \2#p' > "${F1}/etc-links"
while read -r tgt rel; do mkdir -p "$(dirname "${F1ETC}/${rel}")"; ln -sfn "${tgt}" "${F1ETC}/${rel}"; done < "${F1}/etc-links"
[ -L "${F1ETC}/tmpfiles.d" ] && [ -L "${F1ETC}/sysctl.d" ] && [ -L "${F1ETC}/udev/rules.d" ] && [ -L "${F1ETC}/modules-load.d" ]
check $? "the fixture's /etc carries the recipes' links into /storage ($(wc -l < "${F1}/etc-links") of them)" "the recipes' /etc links were not found; the fixture is not the image's /etc: $(tr '\n' ' ' < "${F1}/etc-links")"
# The shims: systemctl as the patched systemd behaves -- mask and unmask
# write a /dev/null link in /storage/.config/system.d, its unit directory --
# and the tools a quirk may call that do nothing here.
mkdir -p "${F1}/shim"
cat > "${F1}/shim/systemctl" <<'EOS'
#!/bin/bash
case "$1" in
    mask)   shift; for u in "$@"; do mkdir -p /storage/.config/system.d; ln -sfn /dev/null "/storage/.config/system.d/${u}"; done ;;
    unmask) shift; for u in "$@"; do [ "$(readlink "/storage/.config/system.d/${u}")" = /dev/null ] && rm -f "/storage/.config/system.d/${u}"; done ;;
esac
exit 0
EOS
for t in systemd-detect-virt modprobe udevadm plymouth logger blockdev; do printf '#!/bin/sh\nexit 0\n' > "${F1}/shim/${t}"; done
chmod +x "${F1}/shim"/*
# /storage as a guest's first boot leaves it: the /usr/config directories the
# links point into (each with its README), the shipped retroarch.cfg.
f1_storage() { # <dir>: a fresh /storage
    rm -rf "${1}"; mkdir -p "${1}/.config/profile.d" "${1}/.config/retroarch" "${1}/.cache"
    for d in tmpfiles.d sysctl.d modules-load.d modprobe.d udev.rules.d hwdb.d system.d logind.conf.d resolved.conf.d sleep.conf.d timesyncd.conf.d; do
        mkdir -p "${1}/.config/${d}"; echo "shipped" > "${1}/.config/${d}/README"
    done
    printf 'video_driver = "vulkan"\nvideo_fullscreen = "true"\nvideo_fullscreen_x = "640"\nvideo_fullscreen_y = "480"\n' > "${1}/.config/retroarch/retroarch.cfg"
}
# /sys: one connected virtio output at 1280x800 (QEMU's default), fw_cfg's
# SSH port, the DMI names.
f1_sys() { # <dir> [<connector>:<status>:<mode>[,<mode>...]]...
    local d="${1}" c name st modes; shift
    rm -rf "${d}"; mkdir -p "${d}/class/drm" "${d}/firmware/qemu_fw_cfg/by_name/opt/org.rocknix.cloud_ssh_port" "${d}/class/dmi/id"
    printf '10022' > "${d}/firmware/qemu_fw_cfg/by_name/opt/org.rocknix.cloud_ssh_port/raw"
    echo QEMU > "${d}/class/dmi/id/sys_vendor"; echo "Standard PC (Q35 + ICH9, 2009)" > "${d}/class/dmi/id/product_name"
    [ $# -eq 0 ] && set -- "card0-Virtual-1:connected:1280x800,1024x768,640x480"
    for c in "$@"; do
        name="${c%%:*}"; c="${c#*:}"; st="${c%%:*}"; modes="${c#*:}"
        mkdir -p "${d}/class/drm/${name}"
        echo "${st}" > "${d}/class/drm/${name}/status"
        if [ "${st}" = connected ]; then echo enabled; else echo disabled; fi > "${d}/class/drm/${name}/enabled"
        echo "${modes}" | tr ',' '\n' > "${d}/class/drm/${name}/modes"
    done
}
# One boot's quirk pass, as autostart runs it: the platform's scripts, then
# the device's, each "${script}" 2>&1 >>boot.log -- so what a script says on
# stderr is what the journal holds, and that is what lands in <journal>.
f1_pass() { # <storage> <sys> <quirks dir> <journal>
    ( bwrap --die-with-parent --tmpfs / --ro-bind /usr /usr "${F1BB[@]}" \
        --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 --symlink usr/sbin /sbin \
        --ro-bind "${F1ETC}" /etc --bind "${1}" /storage --ro-bind "${2}" /sys --ro-bind "${3}" /quirks \
        --ro-bind "${F1}/shim" /shim --tmpfs /run --tmpfs /tmp --tmpfs /var --dev /dev --proc /proc \
        --setenv PATH "${F1PATH}" --setenv HOME /storage \
        bash -c 'for s in /quirks/platforms/GENERIC_X64/* "/quirks/devices/QEMU Standard PC (Q35 + ICH9, 2009)"/*; do
                     [ -f "${s}" ] && bash "${s}" 2>&1 >>/run/boot.log
                 done; exit 0' ) > "${4}" 2>&1
}
f1_quirks() { # <ref|""> <destination>: the platform and QEMU device quirks a build installs
    rm -rf "${2}"; mkdir -p "${2}/platforms" "${2}/devices"
    f1_tree_at "${1}" "${F1_QREL}/platforms/GENERIC_X64" "${2}/platforms/GENERIC_X64"
    f1_tree_at "${1}" "${F1_QREL}/devices/${F1_QEMU}" "${2}/devices/${F1_QEMU}"
}
f1_new_files() { # <storage> <reference listing> -> files and links under <storage> not in the listing
    ( cd "${1}" && find . \( -type f -o -type l \) | LC_ALL=C sort ) | LC_ALL=C comm -13 "${2}" -
}
f1_storage "${F1}/fresh"; ( cd "${F1}/fresh" && find . \( -type f -o -type l \) | LC_ALL=C sort ) > "${F1}/fresh.list"
f1_sys "${F1}/sys"
F1_UNDER=""; [ "${OLD}" -eq 1 ] && F1_UNDER="${BASE_REF}"

# F1a. #307 PL-019 (and #308 F-VM-07, both seats): one boot's quirk pass on a
#      guest writes nothing into the read-only image -- the acceptance's own
#      `journalctl -b | grep -c 'Read-only file system'` -- says nothing on
#      the journal at all, and leaves /storage no file that changes a later
#      boot: no tmpfiles.d, sysctl.d, modules-load.d or udev rule, no unit or
#      mask in system.d.
f1_quirks "${F1_UNDER}" "${F1}/quirks.now"
f1_storage "${F1}/a"; f1_pass "${F1}/a" "${F1}/sys" "${F1}/quirks.now" "${F1}/a.journal"
F1_RO=$(grep -c 'Read-only file system' "${F1}/a.journal")
[ "${F1_RO}" -eq 0 ]; check $? "the quirk pass writes nothing into the read-only image: 0 'Read-only file system' lines on the journal" "the quirk pass writes into the read-only image: ${F1_RO} 'Read-only file system' lines, e.g. $(grep -m2 'Read-only file system' "${F1}/a.journal" | tr '\n' '|' | cut -c1-240)"
[ ! -s "${F1}/a.journal" ]; check $? "and says nothing else on the journal" "the pass says $(wc -l < "${F1}/a.journal") line(s) on the journal: $(head -3 "${F1}/a.journal" | tr '\n' '|' | cut -c1-240)"
F1_BOOT=$(f1_new_files "${F1}/a" "${F1}/fresh.list" | grep -E '^\./\.config/(tmpfiles\.d|sysctl\.d|modules-load\.d|modprobe\.d|udev\.rules\.d|hwdb\.d|system\.d|systemd)/')
[ -z "${F1_BOOT}" ]; check $? "and leaves /storage no file that changes a later boot (tmpfiles, sysctl, modules, udev, units, masks)" "the pass leaves /storage files that change later boots: $(echo "${F1_BOOT}" | tr '\n' ' ' | cut -c1-300)"

# F1b. #307 PL-019's Already written: a guest that ran the earlier builds'
#      quirks carries what they wrote into /storage. The fixture is exactly
#      that: the pass of the tree before this stream (F1_PREV), run on a
#      fresh /storage beside a file of the owner's own in each of those
#      directories. One boot of the tree under test takes back every file
#      the retired quirks wrote -- by name, so the owner's files stay -- and
#      a second boot changes nothing.
f1_quirks "${F1_PREV}" "${F1}/quirks.prev"
f1_storage "${F1}/b"
echo "mine" > "${F1}/b/.config/tmpfiles.d/50-mine.conf"; echo "mine" > "${F1}/b/.config/sysctl.d/99-mine.conf"
echo "mine" > "${F1}/b/.config/modules-load.d/mine.conf"; ln -s /dev/null "${F1}/b/.config/system.d/mine.service"
# and one under a drop-in directory the retired writers used, with a name
# none of them wrote (weston got 10-vm-config.conf, never 10-generic-x64.conf)
mkdir -p "${F1}/b/.config/systemd/system/weston.service.d"; echo "mine" > "${F1}/b/.config/systemd/system/weston.service.d/10-generic-x64.conf"
( cd "${F1}/b" && find . \( -type f -o -type l \) | LC_ALL=C sort ) > "${F1}/b.before"
f1_pass "${F1}/b" "${F1}/sys" "${F1}/quirks.prev" "${F1}/b.prev.journal"
F1_WROTE=$(f1_new_files "${F1}/b" "${F1}/b.before" | grep -vE '^\./\.config/(profile\.d/(001-device_config|090-ui_service|091-ui_shader)|cloud_setup_ssh)$')
[ -n "${F1_WROTE}" ]; check $? "the earlier builds' pass wrote $(echo "${F1_WROTE}" | grep -c .) file(s) into /storage the fixture can take back (the fixture holds what a guest holds)" "the earlier builds' pass wrote nothing -- the fixture proves nothing"
f1_pass "${F1}/b" "${F1}/sys" "${F1}/quirks.now" "${F1}/b.now.journal"
F1_LEFT=""; while IFS= read -r f; do [ -e "${F1}/b/${f}" ] || [ -L "${F1}/b/${f}" ] && F1_LEFT="${F1_LEFT} ${f}"; done <<< "${F1_WROTE}"
[ -z "${F1_LEFT}" ]; check $? "one boot of the tree under test takes back every one of them" "still on /storage after a boot: $(echo "${F1_LEFT}" | cut -c1-300)"
F1_MINE=0
for f in tmpfiles.d/50-mine.conf sysctl.d/99-mine.conf modules-load.d/mine.conf systemd/system/weston.service.d/10-generic-x64.conf; do [ "$(cat "${F1}/b/.config/${f}" 2>/dev/null)" = mine ] || F1_MINE=1; done
[ "$(readlink "${F1}/b/.config/system.d/mine.service")" = /dev/null ] || F1_MINE=1
check ${F1_MINE} "and the owner's own files beside them stay, a mask of their own and a drop-in under a name no retired quirk wrote included (the audit's G-F1-09)" "an owner's file was taken: $(ls "${F1}/b/.config/tmpfiles.d" "${F1}/b/.config/sysctl.d" "${F1}/b/.config/modules-load.d" "${F1}/b/.config/system.d" "${F1}/b/.config/systemd/system/weston.service.d" 2>&1 | tr '\n' ' ')"
grep -q 'retired' "${F1}/b.now.journal"; check $? "and the boot that takes them back says so on the journal" "the take-back boot's journal: '$(head -c 160 "${F1}/b.now.journal")'"
# Content, not names (the audit's second seat, G-F1-07): every file's bytes
# and every link's target, before and after a second boot.
f1_state() { ( cd "${1}" && find . \( -type f -o -type l \) | LC_ALL=C sort | while IFS= read -r f; do if [ -L "${f}" ]; then echo "${f} -> $(readlink "${f}")"; else echo "${f} $(sha256sum < "${f}" | cut -c1-16)"; fi; done ); }
f1_state "${F1}/b" > "${F1}/b.once"
f1_pass "${F1}/b" "${F1}/sys" "${F1}/quirks.now" "${F1}/b.twice.journal"
f1_state "${F1}/b" | cmp -s - "${F1}/b.once" && [ ! -s "${F1}/b.twice.journal" ]
check $? "and a second boot changes no file's bytes and says nothing" "a second boot changed /storage or spoke: $(f1_state "${F1}/b" | diff - "${F1}/b.once" | tr '\n' ' ' | cut -c1-200) $(head -c 120 "${F1}/b.twice.journal")"
# The take-back is once (the audit's second seat, G-F1-05): a mask the owner
# makes afterwards under one of the four names is theirs, and stays.
ln -sfn /dev/null "${F1}/b/.config/system.d/emergency.target"
f1_pass "${F1}/b" "${F1}/sys" "${F1}/quirks.now" "${F1}/b.third.journal"
[ "$(readlink "${F1}/b/.config/system.d/emergency.target")" = /dev/null ]; check $? "a mask of emergency.target the owner makes after the take-back survives the next boot" "the owner's emergency.target mask was removed by a later boot"

# F1c. #307 PL-022: no quirk tree outside the recipe that installs it. The
#      only quirks recipe is projects/ROCKNIX/packages/hardware/quirks, so a
#      packages/hardware/quirks/ with no package.mk is a tree nothing installs.
F1_ORPHAN=""
if [ "${OLD}" -eq 1 ]; then F1_ORPHAN=$(git -C "${ROOT}" ls-tree -r --name-only "${BASE_REF}" -- packages/hardware/quirks 2>/dev/null)
else F1_ORPHAN=$(cd "${ROOT}" && git ls-files -- packages/hardware/quirks; [ -d packages/hardware/quirks ] && find packages/hardware/quirks -type f); fi
F1_ORPHAN=$(echo "${F1_ORPHAN}" | sed '/^$/d' | grep -v '/package\.mk$' | sort -u)
[ -z "${F1_ORPHAN}" ] || { [ "${OLD}" -eq 0 ] && [ -f "${ROOT}/packages/hardware/quirks/package.mk" ]; }
check $? "no quirk tree outside the recipe that installs it (packages/hardware/quirks is empty)" "a quirk tree no recipe installs: $(echo "${F1_ORPHAN}" | wc -l) file(s), e.g. $(echo "${F1_ORPHAN}" | head -3 | tr '\n' ' ')"

# F1d. #307 PL-023: the serial root shell is the developers' channel on a
#      VM (D-QA-053) and nowhere else: a plain ConditionVirtualization=vm
#      beside the console conditions (a condition without | must hold as well
#      as one of the | ones), the console conditions kept, and the unit says
#      what it is in its header.
F1U="${F1}/serial-debug-shell.service"
src_of projects/ROCKNIX/devices/GENERIC_X64/filesystem/usr/lib/systemd/system/serial-debug-shell.service "${F1U}"
grep -qx 'ConditionVirtualization=vm' "${F1U}"; check $? "serial-debug-shell.service carries ConditionVirtualization=vm, a condition every start must meet" "serial-debug-shell.service has no plain ConditionVirtualization=vm: $(grep '^Condition' "${F1U}" | tr '\n' ' ')"
[ "$(grep -c '^ConditionKernelCommandLine=|console=ttyS0' "${F1U}")" -ge 1 ]; check $? "and keeps the console conditions tools/vm-serial depends on" "the console conditions are gone: $(grep '^Condition' "${F1U}" | tr '\n' ' ')"
head -3 "${F1U}" | grep -q 'SPDX-License-Identifier' && grep -q 'D-QA-053' "${F1U}"; check $? "and its header carries the SPDX line and the decision that keeps it (D-QA-053)" "the unit's header: $(head -3 "${F1U}" | tr '\n' '|')"

F1_IOI=$(awk '/^\[/{sec=$0} /^IgnoreOnIsolate=/{print sec}' "${F1U}")
[ "${F1_IOI}" = "[Unit]" ]; check $? "and IgnoreOnIsolate sits in [Unit], where systemd reads it" "IgnoreOnIsolate is under ${F1_IOI:-no section}, where systemd ignores it (systemd-analyze verify: Unknown key)"

# F1e. #307 PL-073: the in-place bootloader updater. The SYSTEM image's
#      /usr/share/bootloader holds update.sh alone (projects/ROCKNIX/
#      bootloader/install copies the syslinux files after the squashfs is
#      made, into the release's 3rdparty/bootloader), so every guarded copy
#      in it is false: it copies nothing and then writes UPDATE to
#      /storage/.boot.hint, which init writes itself after
#      update_bootloader. The acceptance: an update changes /flash, or the
#      script is gone.
F1E="${F1}/e"; F1BL=projects/ROCKNIX/devices/GENERIC_X64/bootloader/update.sh
if { [ "${OLD}" -eq 1 ] && git -C "${ROOT}" cat-file -e "${BASE_REF}:${F1BL}" 2>/dev/null; } || { [ "${OLD}" -eq 0 ] && [ -e "${ROOT}/${F1BL}" ]; }; then
    mkdir -p "${F1E}/update/usr/share/bootloader" "${F1E}/flash/EFI/BOOT" "${F1E}/storage" "${F1E}/shim"
    src_of "${F1BL}" "${F1E}/update/usr/share/bootloader/update.sh"
    for f in ldlinux.sys ldlinux.c32 syslinux.cfg EFI/BOOT/bootx64.efi EFI/BOOT/grub.cfg EFI/BOOT/ldlinux.e64; do echo "installed ${f}" > "${F1E}/flash/${f}"; done
    printf '#!/bin/sh\nexit 0\n' > "${F1E}/shim/mount"; chmod +x "${F1E}/shim/mount"
    F1_FL0=$(cd "${F1E}/flash" && find . -type f -exec sha256sum {} + | LC_ALL=C sort)
    bwrap --die-with-parent --tmpfs / --ro-bind /usr /usr --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
        --ro-bind "${F1E}/update" /update --bind "${F1E}/flash" /flash --bind "${F1E}/storage" /storage --ro-bind "${F1E}/shim" /shim \
        --dev /dev --proc /proc --tmpfs /tmp --setenv PATH /shim:/usr/bin:/bin --setenv SYSTEM_ROOT /update --setenv BOOT_ROOT /flash \
        bash /update/usr/share/bootloader/update.sh > "${F1E}/out" 2>&1
    F1_FL1=$(cd "${F1E}/flash" && find . -type f -exec sha256sum {} + | LC_ALL=C sort)
    [ "${F1_FL0}" != "${F1_FL1}" ]; check $? "the bootloader updater changes /flash on an update" "the bootloader updater copied nothing to /flash (the image ships it alone in /usr/share/bootloader) and wrote '$(cat "${F1E}/storage/.boot.hint" 2>/dev/null)' to the boot hint all the same"
else
    check 0 "GENERIC_X64 ships no bootloader updater that has nothing to copy"
fi
F1_INIT="${F1}/init"; src_of projects/ROCKNIX/packages/sysutils/busybox/scripts/init "${F1_INIT}"
grep -q '^update_bootloader() {' "${F1_INIT}" && grep -q 'if \[ -f ${SYSTEM_ROOT}/usr/share/bootloader/update.sh \]; then' "${F1_INIT}" && grep -A1 '^  update_bootloader$' "${F1_INIT}" | grep -q 'echo "UPDATE" >/storage/.boot.hint'
check $? "and init skips a missing updater and writes the boot hint itself after update_bootloader" "init no longer skips a missing update.sh or no longer writes the hint itself -- deleting the updater would lose the hint"

# F1f. The launcher, projects/ROCKNIX/devices/GENERIC_X64/vm/generic-x64-vm,
#      run inside bwrap with a /tmp of its own, so no default path can reach
#      a live guest's sockets on this host. QEMU is a shim that records its
#      argv (qemu-args never starts it; run execs it); qemu-img is the
#      host's, for disks it makes here.
F1V="${F1}/v"; mkdir -p "${F1V}/vm" "${F1V}/bin" "${F1V}/a,b"
for f in generic-x64-vm profile.json utm-bundle-readme.txt; do src_of "projects/ROCKNIX/devices/GENERIC_X64/vm/${f}" "${F1V}/vm/${f}"; done
chmod +x "${F1V}/vm/generic-x64-vm"
printf '#!/bin/sh\nprintf "%%s\\n" "$@" > "%s/qemu.argv"\nexit 0\n' "${F1V}" > "${F1V}/bin/qemu-system-x86_64"; chmod +x "${F1V}/bin/qemu-system-x86_64"
echo code > "${F1V}/code.fd"; echo vars-template > "${F1V}/vars-template.fd"
F1_QIMG=$(command -v qemu-img)
f1_vm() { # <args...>: the launcher in its sandbox; stdout+stderr to ${F1V}/out, the status in F1_RC
    bwrap --die-with-parent --ro-bind / / --tmpfs /tmp --bind "${F1V}" "${F1V}" --dev /dev --proc /proc \
        --setenv QEMU_SYSTEM_X86_64 "${F1V}/bin/qemu-system-x86_64" \
        python3 "${F1V}/vm/generic-x64-vm" "$@" > "${F1V}/out" 2>&1
    F1_RC=$?
}
f1_sock() { python3 -c 'import socket,sys; s=socket.socket(socket.AF_UNIX); s.bind(sys.argv[1])' "${1}"; }
f1_disk() { rm -f "${1}"; "${F1_QIMG}" create -q -f qcow2 "${1}" "${2}" >/dev/null 2>&1; }
F1_OVMF=(--ovmf-code "${F1V}/code.fd" --ovmf-vars-template "${F1V}/vars-template.fd")
[ -n "${F1_QIMG}" ] || check 1 "-" "qemu-img is not on this host; the launcher checks cannot run"
if [ -n "${F1_QIMG}" ]; then
f1_disk "${F1V}/disk.qcow2" 16G
# #307 PL-033 (and #308 claude F-VM-06): printing the arguments touches
# nothing -- not a running guest's monitor or serial socket, not the OVMF
# vars file.
rm -f "${F1V}/m.sock" "${F1V}/s.sock" "${F1V}/vars.fd"; f1_sock "${F1V}/m.sock"; f1_sock "${F1V}/s.sock"
f1_vm qemu-args --headless --gl none --monitor "${F1V}/m.sock" --serial "${F1V}/s.sock" --pidfile "${F1V}/pid" --ovmf-vars "${F1V}/vars.fd" "${F1_OVMF[@]}" "${F1V}/disk.qcow2"
[ "${F1_RC}" -eq 0 ] && [ -S "${F1V}/m.sock" ] && [ -S "${F1V}/s.sock" ] && [ ! -e "${F1V}/vars.fd" ]
check $? "qemu-args prints the command and leaves a running guest's monitor and serial sockets, and makes no OVMF vars file (#307 PL-033)" "qemu-args (rc ${F1_RC}): monitor socket $([ -S "${F1V}/m.sock" ] && echo kept || echo REMOVED), serial socket $([ -S "${F1V}/s.sock" ] && echo kept || echo REMOVED), vars file $([ -e "${F1V}/vars.fd" ] && echo CREATED || echo absent)"
grep -qF -- "unix:${F1V}/m.sock,server,nowait" "${F1V}/out"; check $? "and what it prints is the command run would start" "the printed command: $(head -c 300 "${F1V}/out")"
# run still does the start's work before it execs QEMU: a stale socket
# removed so QEMU can bind it, the vars file made from the template.
f1_vm run --headless --gl none --monitor "${F1V}/m.sock" --serial "${F1V}/s.sock" --pidfile "${F1V}/pid" --ovmf-vars "${F1V}/vars.fd" "${F1_OVMF[@]}" "${F1V}/disk.qcow2"
[ "${F1_RC}" -eq 0 ] && [ -s "${F1V}/qemu.argv" ] && [ ! -e "${F1V}/m.sock" ] && [ ! -e "${F1V}/s.sock" ] && [ "$(cat "${F1V}/vars.fd" 2>/dev/null)" = vars-template ]
check $? "and run still clears the stale sockets and makes the vars file from its template before it starts QEMU" "run (rc ${F1_RC}): QEMU $([ -s "${F1V}/qemu.argv" ] && echo started || echo NOT started), sockets $(ls "${F1V}"/*.sock 2>/dev/null | tr '\n' ' '), vars '$(cat "${F1V}/vars.fd" 2>/dev/null)'; $(head -c 200 "${F1V}/out")"
# The gpt seat's input: the disk given as the monitor path. A start removes
# only a socket; anything else at a socket path is refused, and the disk
# stays.
cp "${F1V}/disk.qcow2" "${F1V}/victim.qcow2"; rm -f "${F1V}/qemu.argv"
f1_vm run --monitor "${F1V}/victim.qcow2" --ovmf-vars "${F1V}/vars.fd" "${F1_OVMF[@]}" "${F1V}/disk.qcow2"
[ "${F1_RC}" -ne 0 ] && [ -f "${F1V}/victim.qcow2" ] && [ ! -e "${F1V}/qemu.argv" ]
check $? "a start refuses a socket path that holds a file, and the file stays (the gpt seat's disk-as---monitor input)" "run --monitor <a qcow2> (rc ${F1_RC}): the file $([ -f "${F1V}/victim.qcow2" ] && echo kept || echo DELETED), QEMU $([ -e "${F1V}/qemu.argv" ] && echo started || echo not started)"
# The audit of the fixes, gpt G-F1-01: a --monitor that is a symlink to
# another guest's live socket. The path was resolved before the check, so
# the check saw a socket and removed the other guest's; a link is refused
# and both stay.
rm -f "${F1V}/other.sock" "${F1V}/link.sock" "${F1V}/qemu.argv"; f1_sock "${F1V}/other.sock"; ln -s "${F1V}/other.sock" "${F1V}/link.sock"
