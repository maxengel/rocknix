echo "  q. 099-networkservices: a daemon fragment that sets no CONF inherits none from the fragment before it (#166)"
# The boot pass sources every /usr/lib/autostart/daemons/* in turn and, for
# each, removes the marker CONF names before rewriting it from STATE and
# backgrounding a systemctl start or stop. It never reset the variables
# between fragments, so a fragment that sets no CONF (004-*, 005-fstrim,
# 007-syncthing) inherited the previous one's and removed the marker it had
# just written: 007-syncthing took raofflineproxy.conf from
# 006-raofflineproxy, and the unit's ConditionPathExists read false by the
# time the backgrounded start was processed, so the toggle died on the
# second boot while the row still read on (#166 s. 6). The same leak has
# removed samba's smb.conf through 004-tailscaled at every boot since the
# fragments were written, which is why the smb.conf check below fails at
# every BASE_REF and the raofflineproxy.conf one from #165 on.
#
# The pass runs WHOLE and unmodified under bwrap over the real fragments,
# every one the tree ships, at their real path: /usr/lib is the host's bound
# entry by entry so the fixture's daemons/ can sit under it, /etc is a tmpfs
# holding the loader's cache and a stub 001-functions (get_setting lifted
# from the file under test, on the fixture's system.cfg; tocon and log to
# stderr), /storage the fixture's, and systemctl a shim that reads the
# raofflineproxy unit's condition the way systemd does -- when the start is
# processed, a moment after the loop has moved on -- and logs what it found.
# Both starts and stops are backgrounded by the pass, so the wrapper waits
# for them before the log is read.
NS_REL=projects/ROCKNIX/packages/rocknix/autostart/099-networkservices
Q="${TMP}/q"; QS="${Q}/storage"; mkdir -p "${QS}/.config/system/configs" "${QS}/.cache/services" "${Q}/repo" "${Q}/shim" "${Q}/run" "${Q}/daemons" "${Q}/etc"
src_of "${NS_REL}" "${Q}/repo/099-networkservices"
bash -n "${Q}/repo/099-networkservices"; check $? "099-networkservices parses (bash -n)" "099-networkservices does not parse"
QHAVE_RA=0
while IFS= read -r frag; do
    rel="${frag#* }"
    if [ "${OLD}" -eq 1 ] && ! git -C "${ROOT}" cat-file -e "${BASE_REF}:${rel}" 2>/dev/null; then
        echo "    note  ${rel##*/} is absent at ${BASE_REF}; left out of the pass"
        continue
    fi
    src_of "${rel}" "${Q}/daemons/${rel##*/}"
    [ "${rel##*/}" = "006-raofflineproxy" ] && QHAVE_RA=1
done < <(cd "${ROOT}" && find projects -path '*/daemons/[0-9]*' -type f -printf '%f %p\n' | sort)
QFRAGS="$(ls "${Q}/daemons" | tr '\n' ' ')"
echo "    fragments: ${QFRAGS}"
{
    sed -n '/^function get_setting() {/,/^}/p' "${FN}"
    cat <<'EOS'
tocon() { echo "tocon $*" >&2; }
log() { echo "log $*" >&2; }
J_CONF=/storage/.config/system/configs/system.cfg
EOS
} > "${Q}/etc/001-functions"
cat > "${Q}/shim/systemctl" <<'EOS'
#!/bin/sh
# systemd reads ConditionPathExists when it processes the start, not when
# systemctl is invoked, and the boot pass backgrounds every call and moves
# on to the next fragment; a short wait puts this shim on the same side of
# that race as the real unit.
sleep 1
case "$1" in
    start)
        case "$2" in
            raofflineproxy|raofflineproxy.service)
                if [ -e /storage/.cache/services/raofflineproxy.conf ]; then echo "start $2 started" >> /run/systemctl.log; else echo "start $2 condition-unmet" >> /run/systemctl.log; fi ;;
            *) echo "start $2 started" >> /run/systemctl.log ;;
        esac ;;
    stop) echo "stop $2" >> /run/systemctl.log ;;
    *) echo "$*" >> /run/systemctl.log ;;
esac
exit 0
EOS
printf '#!/bin/sh\necho "logger $*" >&2\n' > "${Q}/shim/logger"
chmod +x "${Q}/shim"/*
QUSR=(--tmpfs /usr); for u in bin sbin lib64 libexec share; do [ -e "/usr/${u}" ] && QUSR+=(--ro-bind "/usr/${u}" "/usr/${u}"); done
for e in /usr/lib/* /usr/lib/.[!.]*; do [ -e "${e}" ] && QUSR+=(--ro-bind "${e}" "${e}"); done
QETC=(--tmpfs /etc); for e in /etc/ld.so.cache /etc/alternatives /etc/passwd /etc/group; do [ -e "${e}" ] && QETC+=(--ro-bind "${e}" "${e}"); done
QBB=(); QPATH="/shim:/usr/bin:/bin"
if [ -n "${BB}" ]; then QBB=(--ro-bind "${TMP}/bbin" /bbin --ro-bind "${BB}" "${BB}"); QPATH="/shim:/bbin:/usr/bin:/bin"; fi
QOUT="${Q}/out"; QCFG="${QS}/.config/system/configs/system.cfg"; QSVC="${QS}/.cache/services"; QLOG="${Q}/run/systemctl.log"
qpass() { # run the boot pass once; rc in $RC, output in $QOUT, systemctl's log in $QLOG
