s.upsert_cache(cache_keys.unlocks(102, "qa"), '{"Success":true,"UserUnlocks":[]}')
s.upsert_cache(cache_keys.achievementsets("bbbb", "qa"), '{"Success":true,"GameId":102,"Sets":[]}')
