#
# last-good-scripts-test - a device-less check that the scripts keep the last
# known good state when they are killed mid-write (D-CLOUD-078, fork #105):
#
#   a. chksysconfig: verify with an empty system.cfg and a valid .backup
#      restores the backup, not the image defaults; backup with an empty
#      current file leaves .backup unchanged;
#   b. backuptool backup killed mid-tar (a tar shim that writes 1 MiB and
#      SIGKILLs the whole process group) leaves the previous archive as the
#      only *.tar.gz at the root and a .partial beside it; a restore whose
#      extraction fails puts the pre-restore snapshot back and says so;
#   c. set_setting is one rename: the single sed produces the right file for
#      values carrying /, & and spaces, deletes on "default", and gives an
#      empty file its one line -- there is no longer a step between delete
#      and add for a kill to land in;
#   d. write_stamp killed mid-write leaves the previous stamp;
#   e. every line the scripts can print to a screen is free of exit codes,
#      log paths, tool names and flags (the harness's FORBIDDEN regex).
#   f. backuptool never archives rclone.conf and its scanner knows rclone's
#      key names (#52);
#   g. each script's RCLONE_NET_OPTS_FALLBACK equals the shipped
#      RCLONE_NET_OPTS, so a torn conf does not silently restore #107 (#146).
#   h. --automatic's rclone wrapper ends a stalled call at the ceiling and
#      returns 124; a deliberate run's is ended at the stall ceiling and
#      returns 124 too, while one that finishes returns its own status;
#      why_for says what 124 means to each; the automatic fallback equals
#      the shipped value (D-CLOUD-118, D-CLOUD-126).
#   i. cloud_net_ready settles on a held default route in any connected
#      NetworkManager state; a still-connecting network exits 69 at the deadline.
#   j. cloud_sync_helper migrates the pre-#107 retry bound once, with a marker,
#      and leaves a hand-tuned value alone.
#   k. backuptool leaves out what the image ships (a file identical to its
#      /usr/config copy; PPSSPP's assets and shader cache always), and a
#      restore of an older archive does not put those back (#45).
#   l. a missing cloud folder reads as not there yet whatever the server's
#      words: absent_not_broken walks up to the nearest listable parent, the
#      setup wizard carries the same function, the content backup makes its
#      folder before copying (#142).
#   m. network-base-setup gives the shipped device name (the build family) a
#      per-unit suffix once and writes it back; a name the player typed, or
#      another family's, is left alone; the script no longer calls hostnamectl and
#      the unit orders before systemd-hostnamed and NetworkManager (#50).
#   n. a deliberate cloud_backup whose rclone stops making progress is ended
#      at the stall ceiling (rclone's idle timeout plus a grace, sized from
#      RCLONE_NET_OPTS): exit non-zero, no success stamp, the why on the
#      protocol line and Couldn't finish ... Try again. as the outcome line;
#      a run that completes ends on Completed. and stamps 0; a transfer that
#      keeps moving past the ceiling is not ended (D-CLOUD-126, #153).
#   o. set_setting system.hostname default (and del_setting) leaves an empty
#      system.hostname= line rather than none, so chksysconfig still reads
#      the file as usable and network-base-setup gives the unit its own name
#      at the next boot; any other key deleted with default is removed as
#      before (D-NET-009, #154).
#   p. raofflineproxy-ctl, the OFFLINE RETROACHIEVEMENTS toggle's backend
#      (#165, D-RA-002): enable writes the marker the unit conditions on,
#      starts the service, records the hardcore setting as it was and turns
#      it off; disable stops, removes the marker and puts hardcore back as
#      recorded; both are harmless run twice; a service that will not start
#      leaves the settings untouched and the marker gone; the last stdout
#      line is hardcore=<0|1> and nothing else is printed. And in k: the
#      proxy's folder under /storage/.config is held back whole from a
#      backup and never put back on a restore (its token cache and award
#      queue, D-INFRA-010). Then the two answers the sync cards ask for
#      (#173, D-RA-004): pending counts the pending rows of a fixture store
#      shaped like the proxy's (0 and 1, exit 1 and 0; 0 with the toggle
#      off; exit 2 and nothing on stdout when the store cannot be read),
#      and flushed prints the service's last-flush stamp once and removes
#      it (exit 1 when there is none, or none worth the name).
#   q. 099-networkservices, the boot pass over /usr/lib/autostart/daemons/*:
#      a fragment that sets no CONF inherits none from the fragment before
#      it, so the marker the previous fragment wrote (raofflineproxy.conf,
#      smb.conf) is still there when the backgrounded systemctl start reads
#      the unit's ConditionPathExists; the pass still removes the marker and
#      stops the service when the toggle is off (#166).
#   r. the launch log carries no credential value: setsettings' Added setting
#      and Fetch lines, runemu's Executing line and loginit header, and the
#      shapes redact_credentials (001-functions) knows -- the key or flag
#      kept, the value <redacted>, an empty value left empty, a value under
#      a plain key untouched, and RetroArch's appendconfig still carrying the
#      real password, since only the log is redacted (#176, D-INFRA-010).
#   s. rocknix-evidence: no planted value survives into the archive or a
#      snapshot page (a process list can carry --ra-password), the key names
#      do, summary.txt says the filter ran and over how many files, and
#      without the helper nothing is collected and no page is written (#176).
#
# The chksysconfig and 001-functions functions are lifted out of the files
# under test and run in a fresh bash against temp paths, as wait-lock-test
# does. backuptool is run WHOLE and unmodified inside bwrap, with a stub
# /etc/profile, a fake /storage and PATH shims (logger, systemctl, sleep,
# and the tar that dies) -- bubblewrap needs no user namespace here, only
# setuid or an allowing profile. sed, mv, cp, tr, head, wc, cut and awk --
# and, in k, tar and unzip; in m, the same applets under network-base-setup
# -- are the image's busybox when its build root is on this machine, the
# host's otherwise -- every external command a check under test leans on
# that IS a busybox applet on the device (grep and sort there are GNU, and
# the image's busybox has no grep applet), not only the ones already known
# to differ: chksysconfig's text test passed here for a day under GNU tr and
# failed on every device under busybox tr (2026-09-10), so the checks in a.
# run through the image's binary.
#
# To watch the guards fire, point it at the scripts from before the change.
# Every case that runs or lifts a script takes it from BASE_REF under --old
# (src_of), so a case whose FAILs have never been seen is a case with no
# evidence (#151 PL-10):
#
#     tools/last-good-scripts-test --old      # a, b, c, d, e, f, j, k, l, m
#                                             # FAIL against 1d1503180d
#     BASE_REF=53f390b1e9 tools/last-good-scripts-test --old
#                                             # k, l, m FAIL: the scripts from
#                                             # before #45, #142 and #50
#     BASE_REF=c15050c897 tools/last-good-scripts-test --old
#                                             # a FAILS: the text test that
#                                             # busybox tr never passed
#     BASE_REF=8707919349 tools/last-good-scripts-test --old
#                                             # h (the deliberate stall, the
#                                             # deliberate why), n and o FAIL:
#                                             # the scripts from before #153
#                                             # and #154
#     BASE_REF=34aca64afd tools/last-good-scripts-test --old
#                                             # k's proxy-folder checks FAIL
#                                             # (the folder travelled) and p
#                                             # FAILS whole: the tree before
#                                             # #165 has no raofflineproxy-ctl
#     BASE_REF=0f7785e6ed tools/last-good-scripts-test --old
#                                             # q FAILS: the boot pass before
#                                             # #166 removed raofflineproxy.conf
#                                             # through 007-syncthing (and
#                                             # smb.conf through 004-tailscaled,
#                                             # at every BASE_REF: upstream's leak)
#     BASE_REF=d79281066c tools/last-good-scripts-test --old
#                                             # p's pending and flushed checks
#                                             # FAIL: the ctl before #173 has
#                                             # neither verb (usage, exit 2)
#     BASE_REF=28a80357ed tools/last-good-scripts-test --old
#                                             # r and s FAIL: the scripts from
#                                             # before #176 -- the password in
#                                             # exec.log's Added setting and
#                                             # Fetch lines, in the bundle and
#                                             # in a snapshot page, and a
#                                             # collect that runs with no filter
#     tools/last-good-scripts-test            # PASSED
#
# One FAIL in m that names "the built image" is about the build root on this
# machine, not the tree: case m grades the avahi unit the image ships, and a
# root built before the avahi recipe removed the stock units (#151 PL-01)
# holds the wrong one until avahi and the image are rebuilt. It is a true
# statement about that image and is left to fail rather than softened.
#
# Exit 0 when every check passes, 1 otherwise, 2 when it cannot run.
set -u

ROOT="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
BASE_REF="${BASE_REF:-1d1503180d}"
OLD=0
[ "${1:-}" = "--old" ] && OLD=1

CHK_REL=projects/ROCKNIX/packages/rocknix/sources/scripts/chksysconfig
BT_REL=projects/ROCKNIX/packages/rocknix/sources/scripts/backuptool
FN_REL=projects/ROCKNIX/packages/rocknix/profile.d/001-functions
NBS_REL=projects/ROCKNIX/packages/sysutils/systemd/scripts/network-base-setup
RCLONE_REL=projects/ROCKNIX/packages/network/rclone/sources

command -v bwrap >/dev/null || { echo "needs bubblewrap (bwrap)" >&2; exit 2; }
command -v setsid >/dev/null || { echo "needs setsid" >&2; exit 2; }

TMP="$(mktemp -d)"; trap 'rm -rf "${TMP}"' EXIT
FAIL=0
check() { # <0|nonzero> ok-text bad-text
    if [ "$1" -eq 0 ]; then echo "    PASS  $2"; else echo "    FAIL  $3"; FAIL=$((FAIL + 1)); fi
}

# One file under test: the working tree's copy, or the base commit's under
# --old. A copy that cannot be read ends the run (exit 2) rather than
# leaving an empty file for a case to grade -- against an empty script every
# guard is absent, and the FAILs would read as the guards firing. Every case
# that lifts or runs a script takes it from here, so --old means the same
# thing in every case (#151 PL-10: cases l and m used to read the working
# tree whatever the flag said, and their checks had never been seen to fail).
src_of() { # <repo-relative path> <destination>
    if [ "${OLD}" -eq 1 ]; then
        git -C "${ROOT}" show "${BASE_REF}:${1}" > "${2}" || { echo "cannot read ${1} at ${BASE_REF}" >&2; exit 2; }
    else
        cp "${ROOT}/${1}" "${2}" || { echo "cannot read ${1}" >&2; exit 2; }
    fi
}

# The scripts under test: the working tree, or the base commit's.
mkdir -p "${TMP}/src"
for rel in "${CHK_REL}" "${BT_REL}" "${FN_REL}"; do
    src_of "${rel}" "${TMP}/src/$(basename "${rel}")"
done
CHK="${TMP}/src/chksysconfig"; BT="${TMP}/src/backuptool"; FN="${TMP}/src/001-functions"
chmod +x "${BT}"

# busybox sed/mv/cp from the image when a build root is here, so the rename
# semantics tested are the device's.
BB=""
for b in "${ROOT}"/../*/build.ROCKNIX-*/image/system/usr/bin/busybox "${ROOT}".worktrees/*/build.ROCKNIX-*/image/system/usr/bin/busybox "${ROOT}"/build.ROCKNIX-*/image/system/usr/bin/busybox; do
    [ -x "${b}" ] && "${b}" sed --help >/dev/null 2>&1 && { BB="${b}"; break; }
done
[ -n "${BB}" ] || BB="$(command -v busybox || true)"
mkdir -p "${TMP}/bbin"
if [ -n "${BB}" ]; then
    for a in sed mv cp tr head wc cut awk; do printf '#!/bin/sh\nexec %s %s "$@"\n' "${BB}" "${a}" > "${TMP}/bbin/${a}"; chmod +x "${TMP}/bbin/${a}"; done
fi

echo "last-good-scripts-test: $([ "${OLD}" -eq 1 ] && echo "scripts at ${BASE_REF} (expect FAILs)" || echo "scripts in ${ROOT}")"
[ -n "${BB}" ] && echo "  sed/mv/cp/tr/head/wc/cut/awk: $("${BB}" 2>&1 | head -1)"

# ---------------------------------------------------------------- a.
echo "  a. chksysconfig keeps and restores the last good system.cfg"
A="${TMP}/a"; mkdir -p "${A}/cfg/system/configs" "${A}/cfg/retroarch" "${A}/def/system/configs" "${A}/def/retroarch"
printf 'system.hostname=DEFAULT\n' > "${A}/def/system/configs/system.cfg"
echo d > "${A}/def/retroarch/retroarch.cfg"; echo d > "${A}/def/retroarch/retroarch-core-options.cfg"
echo user > "${A}/cfg/retroarch/retroarch.cfg"; echo user > "${A}/cfg/retroarch/retroarch-core-options.cfg"
{
    # Every function the file defines, whatever it calls them.
    awk '/^[a-z_]+\(\) *\{/{p=1} p{print} p&&/^\}/{p=0}' "${CHK}"
    cat <<EOS
logger() { echo "logger \$*" >&2; }
CONFIG_ROOT="${A}/cfg"; DEFAULT_ROOT="${A}/def"
CFG_PATH="\${CONFIG_ROOT}/system/configs"; CFG="\${CFG_PATH}/system.cfg"; BACKUP="\${CFG}.backup"
EOS
} > "${A}/fns.sh"
# The old script names /storage and /usr/config outright, so its rsync must
# be shimmed to do what it would do -- copy the default tree over the config
# tree -- against the fixture; the new one takes the roots from variables.
mkdir -p "${A}/bin"
cat > "${A}/bin/rsync" <<EOS
#!/bin/bash
args=(); ign=0
for x in "\$@"; do case "\$x" in --ignore-existing) ign=1 ;; -a) ;; /usr/config/) args+=("${A}/def/") ;; /storage/.config) args+=("${A}/cfg") ;; *) args+=("\$x") ;; esac; done
opts=(-a); [ "\$ign" = 1 ] && opts+=(--ignore-existing)
exec /usr/bin/rsync "\${opts[@]}" "\${args[@]}"
EOS
chmod +x "${A}/bin/rsync"
CFGF="${A}/cfg/system/configs/system.cfg"

printf 'a.b=1\nsystem.hostname=MINE\n' > "${CFGF}.backup"; : > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>"${A}/err"
[ "$(grep '^system.hostname=' "${CFGF}" 2>/dev/null)" = "system.hostname=MINE" ]; check $? "empty system.cfg + valid .backup: verify restored the backup (hostname MINE)" "system.cfg after verify: '$(tr '\n' '|' < "${CFGF}" | cut -c1-80)' -- expected the backup's hostname MINE"
[ "$(cat "${A}/cfg/retroarch/retroarch.cfg")" = "user" ]; check $? "and the player's retroarch.cfg was left alone" "retroarch.cfg was overwritten with the image default"
grep -q 'logger -t chksysconfig .*restored' "${A}/err"; check $? "one syslog line names the recovery" "no recovery line in syslog; stderr: '$(tr '\n' '|' < "${A}/err" | cut -c1-200)'"

printf 'a.b=1\nsystem.host' > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>/dev/null
[ "$(grep '^system.hostname=' "${CFGF}" 2>/dev/null)" = "system.hostname=MINE" ]; check $? "truncated system.cfg (no hostname): verify restored the backup" "system.cfg after verify: '$(tr '\n' '|' < "${CFGF}" | cut -c1-80)'"

printf 'a.b=1\n\0\0\0\nsystem.hostname=X\n' > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>/dev/null
[ "$(grep -a '^system.hostname=' "${CFGF}" 2>/dev/null)" = "system.hostname=MINE" ]; check $? "binary system.cfg: verify restored the backup" "system.cfg after verify: '$(tr '\n' '|' < "${CFGF}" | cut -c1-80)'"

: > "${CFGF}"; : > "${CFGF}.backup"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>/dev/null
[ "$(grep '^system.hostname=' "${CFGF}" 2>/dev/null)" = "system.hostname=DEFAULT" ]; check $? "both empty: verify fell back to the image's system.cfg" "system.cfg after verify: '$(tr '\n' '|' < "${CFGF}" | cut -c1-80)'"

printf 'system.hostname=GOOD\n' > "${CFGF}.backup"; : > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; backup" 2>/dev/null
[ "$(cat "${CFGF}.backup")" = "system.hostname=GOOD" ]; check $? "backup with an empty current file left .backup unchanged" ".backup after backup: '$(tr '\n' '|' < "${CFGF}.backup" | cut -c1-80)' -- the empty file replaced the good copy"
printf 'system.hostname=NEW\nx=1\n' > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; backup" 2>/dev/null
[ "$(head -1 "${CFGF}.backup")" = "system.hostname=NEW" ] && [ ! -e "${CFGF}.backup.tmp" ]; check $? "backup with a valid current file replaced .backup, no temp left" ".backup: '$(head -1 "${CFGF}.backup")'; temp present: $([ -e "${CFGF}.backup.tmp" ] && echo yes || echo no)"

# The fixtures above are three lines long. A device's system.cfg is the
# image's, 220-odd lines, and that is the file the check has to accept --
# under the device's tr (busybox reads "[:print:]" as eight characters).
sed 's/@DEVICENAME@/QA/' "${ROOT}/projects/ROCKNIX/packages/rocknix/config/system/configs/system.cfg" > "${CFGF}"
: > "${CFGF}.backup"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; backup" 2>/dev/null
cmp -s "${CFGF}" "${CFGF}.backup"; check $? "the image's own system.cfg ($(wc -l < "${CFGF}") lines) is valid and became the record" "the image's system.cfg was refused as damaged; .backup: $(wc -c < "${CFGF}.backup") bytes"
printf 'system.hostname=X\nwifi.ssid=caf\303\251 \342\230\205\n' > "${CFGF}"
PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; backup" 2>/dev/null
cmp -s "${CFGF}" "${CFGF}.backup"; check $? "a UTF-8 value (an accented Wi-Fi name) is text" "the UTF-8 system.cfg was refused as damaged"

# A settings restore cut off mid-extract: backuptool left .restore-in-progress
# naming the copy it took aside; verify puts the copy back over the tree
# (EXTRACT_ROOT, / on a device), says so for EmulationStation, and clears the
# marker (D-CLOUD-078, KILL18).
mkdir -p "${A}/root/storage/.config/test" "${A}/snapsrc/storage/.config/test"
echo HALF-RESTORED > "${A}/root/storage/.config/test/x.cfg"
echo LIVE > "${A}/snapsrc/storage/.config/test/x.cfg"
tar -czf "${A}/cfg/pre-restore.tar.gz" -C "${A}/snapsrc" storage
printf '%s\n' "${A}/cfg/pre-restore.tar.gz" > "${A}/cfg/.restore-in-progress"
printf 'system.hostname=X\n' > "${CFGF}"; cp "${CFGF}" "${CFGF}.backup"
EXTRACT_ROOT="${A}/root" PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>"${A}/err"
[ "$(cat "${A}/root/storage/.config/test/x.cfg")" = "LIVE" ] && [ ! -e "${A}/cfg/.restore-in-progress" ] && [ "$(cat "${A}/cfg/.restore-reverted" 2>/dev/null)" = "reverted" ]; check $? "a cut-off restore is undone at boot: the copy is back, the marker gone, 'reverted' left for the screen" "x.cfg='$(cat "${A}/root/storage/.config/test/x.cfg")'; marker: $([ -e "${A}/cfg/.restore-in-progress" ] && echo present || echo gone); said: '$(cat "${A}/cfg/.restore-reverted" 2>/dev/null)'"
rm -f "${A}/cfg/.restore-reverted"
# The copy's folder not mounted yet (sysinit runs before /storage/roms is
# bound): the marker stays for the later verify, nothing is said.
printf '%s\n' "${A}/not-mounted-yet/pre-restore.tar.gz" > "${A}/cfg/.restore-in-progress"
EXTRACT_ROOT="${A}/root" PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>"${A}/err"
[ -e "${A}/cfg/.restore-in-progress" ] && [ ! -e "${A}/cfg/.restore-reverted" ] && grep -q 'not mounted yet' "${A}/err"; check $? "a copy whose folder is not mounted yet is left for the later verify, marker kept, nothing said" "marker: $([ -e "${A}/cfg/.restore-in-progress" ] && echo present || echo gone); said: '$(cat "${A}/cfg/.restore-reverted" 2>/dev/null)'; log: $(grep -c 'not mounted yet' "${A}/err") line(s)"
printf '%s\n' "${A}/cfg/missing.tar.gz" > "${A}/cfg/.restore-in-progress"
EXTRACT_ROOT="${A}/root" PATH="${A}/bin:${TMP}/bbin:${PATH}" bash -c ". '${A}/fns.sh'; verify" 2>"${A}/err"
[ ! -e "${A}/cfg/.restore-in-progress" ] && [ "$(cat "${A}/cfg/.restore-reverted" 2>/dev/null)" = "failed" ]; check $? "with the copy missing the marker is cleared and 'failed' is said instead" "marker: $([ -e "${A}/cfg/.restore-in-progress" ] && echo present || echo gone); said: '$(cat "${A}/cfg/.restore-reverted" 2>/dev/null)'"
rm -f "${A}/cfg/.restore-reverted"

# ---------------------------------------------------------------- b.
echo "  b. backuptool: a kill mid-tar leaves the previous archive; a failed restore puts the snapshot back"
B="${TMP}/b"; ST="${B}/storage"
mkdir -p "${ST}/.config/system/configs" "${ST}/.config/test" "${ST}/roms/backup" "${B}/shim" "${B}/repo"
cp "${BT}" "${B}/repo/backuptool"
printf 'export PATH=/shim:/usr/bin:/bin\nexport OS_NAME=ROCKNIX\n' > "${B}/profile"
printf '#!/bin/sh\necho "logger $*" >&2\n' > "${B}/shim/logger"
printf '#!/bin/sh\necho "systemctl $*"\n' > "${B}/shim/systemctl"
printf '#!/bin/sh\nexit 0\n' > "${B}/shim/sleep"
chmod +x "${B}/shim"/*
printf 'system.hostname=X\nwifi.key=SECRET\n' > "${ST}/.config/system/configs/system.cfg"
printf 'LOCATIONS=(\n  /storage/.config/system/configs/system.cfg\n  /storage/.config/test/*\n)\n' > "${ST}/.config/backuptool.conf"
for i in 1 2 3; do echo "file${i}" > "${ST}/.config/test/f${i}"; done
# Run backuptool whole, inside bwrap: the repo copy at /repo, a stub profile,
# the fake /storage, shims first on PATH. setsid gives each run its own
# process group, which is what the dying tar kills.
bt() { # <verb...>; stdout+stderr to $OUT, rc in $RC (137 when the group was killed)
    # In a subshell so the shell's own "Killed" notice for the dying group
    # does not land in the test's output.
    RC=$( ( setsid -w bwrap --die-with-parent --tmpfs / --ro-bind /usr /usr \
        --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
        --ro-bind /etc /etc --ro-bind "${B}/profile" /etc/profile \
        --bind "${ST}" /storage --ro-bind "${B}/shim" /shim --ro-bind "${B}/repo" /repo \
        --dev /dev --proc /proc --tmpfs /tmp \
        bash /repo/backuptool "$@" > "${OUT}" 2>&1; echo $? ) 2>/dev/null )
}
OUT="${B}/out"
bt backup; rc1=${RC}
first=$(ls "${ST}/roms/backup"/*.tar.gz 2>/dev/null)
[ "${rc1}" -eq 0 ] && [ -n "${first}" ] && [ "$(echo "${first}" | wc -l)" -eq 1 ]; check $? "a first backup writes one archive at the root (rc 0)" "rc ${rc1}; root holds: $(ls "${ST}/roms/backup" 2>/dev/null | tr '\n' ' '); out: $(tail -3 "${OUT}" | tr '\n' '|')"
tar -tzf "${first}" 2>/dev/null | grep -q 'storage/.config/test/f1$'; check $? "and it lists back whole" "archive does not list"
! tar -xzOf "${first}" storage/.config/system/configs/system.cfg 2>/dev/null | grep -q SECRET; check $? "with the wifi key stripped" "the archive carries the wifi key"
sleep 1  # a new stamp, so the second archive has a distinct name
bt backup; rc2=${RC}
second=$(ls "${ST}/roms/backup"/*.tar.gz 2>/dev/null)
[ "${rc2}" -eq 0 ] && [ "$(echo "${second}" | wc -l)" -eq 1 ] && [ "${second}" != "${first}" ] && [ -f "${ST}/roms/backup/archive/$(basename "${first}")" ]; check $? "a second backup rotates the first into archive/ and leaves one at the root" "rc ${rc2}; root: $(ls "${ST}/roms/backup" | tr '\n' ' '); archive: $(ls "${ST}/roms/backup/archive" 2>/dev/null | tr '\n' ' ')"

# The kill: tar writing the archive emits 1 MiB and SIGKILLs its own
# process group -- bwrap, the script, itself. Every other tar call is real.
cat > "${B}/shim/tar" <<'EOS'
#!/bin/bash
out=""; prev=""
for a in "$@"; do [ "${prev}" = "-czf" ] && out="${a}"; prev="${a}"; done
if [ -n "${out}" ]; then
    head -c 1048576 /dev/zero > "${out}"
    kill -9 -- "-$(cut -d' ' -f5 /proc/self/stat)"
    sleep 5
    exit 1
fi
exec /usr/bin/tar "$@"
EOS
chmod +x "${B}/shim/tar"
sleep 1
bt backup; rck=${RC}
roots=$(ls "${ST}/roms/backup"/*.tar.gz 2>/dev/null)
partials=$(ls "${ST}/roms/backup"/*.partial 2>/dev/null)
