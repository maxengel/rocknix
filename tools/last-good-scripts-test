conf=$(sed -n 's/^RCLONE_NET_OPTS="\(.*\)"$/\1/p' "${ROOT}/${RCLONE_REL}/cloud_sync.conf")
[ "${conf}" = "${shipped}" ]; check $? "cloud_sync.conf carries the same value" "cloud_sync.conf has '${conf}'"
for scr in cloud_backup cloud_restore cloud_content_backup cloud_content_restore; do
  fb=$(sed -n 's/^RCLONE_NET_OPTS_FALLBACK="\(.*\)"$/\1/p' "${ROOT}/${RCLONE_REL}/${scr}")
