# ---------------------------------------------------------------- e.
echo "  e. nothing a screen can show carries an exit code, a log path, a tool's name or a flag"
# The harness's FORBIDDEN regex (docs/audits/2026_09_10-graceful-degradation/
# kill-fixtures-design.md) over every string literal an echo, a screen-bound
# log_message, a fail/note/why can print. Log-only lines are skipped: a
# log_message whose second argument is "false" in the saves scripts, every
# log_message in the content scripts (theirs writes only to the file), and
# any line redirected into a file or to stderr. cloud_sync_helper prints
# nothing to a screen at all and is not scanned.
E_SRC="${TMP}/e"; mkdir -p "${E_SRC}"
for rel in "${RCLONE_REL}"/cloud_backup "${RCLONE_REL}"/cloud_restore "${RCLONE_REL}"/cloud_content_backup "${RCLONE_REL}"/cloud_content_restore "${RCLONE_REL}"/cloud_saves_root "${BT_REL}"; do
    src_of "${rel}" "${E_SRC}/$(basename "${rel}")"
done
hits=$(python3 - "${E_SRC}" <<'EOS'
import re, sys, os
FORBIDDEN = re.compile(
    r"(?i)(\bexit(ed)?(\s+code)?\s*[:=]?\s*\(?-?\d+\)?|\brc\s*=\s*-?\d+|/var/log\S*|\S+\.log\b"
    r"|\blogger\b|\bjournalctl\b|\brclone\b|\bstderr\b|\bsysexits\b|\bEX_[A-Z]+\b|\bSIG(TERM|KILL|INT)\b"
    r"|\berrno\b|\bpid\s+\d+|\bflock\b|\bsentinel\b|\bcloud_[a-z_]+\b|\bbackuptool\b|(^|\s)--[a-z][a-z-]+"
    r"|\bCOMPLETED WITH ERRORS\b)")
d = sys.argv[1]; n_hits = 0
for f in sorted(os.listdir(d)):
    content_script = f.startswith("cloud_content_")
    for n, line in enumerate(open(os.path.join(d, f)), 1):
        t = line.strip()
        m = re.match(r'(echo(\s+-e)?|log_message|fail|note|why)\s+(".*?(?<!\\)"|\'.*?\')(.*)$', t)
        if not m: continue
        cmd, _, lit, rest = m.groups()
        if cmd == "log_message" and (content_script or re.search(r'^\s*"false"', rest)): continue
        if re.search(r'>>?\s*"?\$?\{?(LOG_FILE|log_file)|>&2|>>?\s*"?/', rest): continue
        text = lit[1:-1]
        if text.startswith(">>> ") and not text.startswith(">>> why"): continue
        mm = FORBIDDEN.search(text)
        if mm:
            n_hits += 1
            print(f"      {f}:{n}: [{mm.group(0).strip()}] {text[:100]}")
print(f"HITS={n_hits}")
EOS
)
echo "${hits}" | grep -v '^HITS='
n_hits=$(echo "${hits}" | sed -n 's/^HITS=//p')
[ "${n_hits}" = "0" ]; check $? "no screen line matches FORBIDDEN across the six scripts" "${n_hits} screen line(s) match FORBIDDEN (listed above)"


