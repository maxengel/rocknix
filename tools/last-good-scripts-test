# wifictl whole, inside bwrap: a fake wlan0 under /sys/class/net (the script
# exits 0 without an adapter), a stub /etc/profile with the two settings
# helpers, and an nmcli shim that answers from a profile table the checks
# edit -- two wireless profiles, "Home Wi-Fi" in use and "Cafe: Guest" saved
# (a space and a colon, which nmcli -t escapes as \:), and a wired one that
# must never be listed. connection delete removes the named row and records
# the name it was given in /run/deleted; /run/nm-down makes every call fail,
# as a NetworkManager that has stopped answering does (fork #102).
# connection up id <name> marks that row active and the others not, and
# records the name in /run/up (or fails, when /run/up-fails exists, as an
# access point that refuses the stored key does); -s -g ...psk connection
# show id <name> answers the profile's key as psk-of-<name>; device show and
# connection modify serve pin_wifi. The stub profile's set_setting records
# each call in /run/settings. The image's busybox applets (sed, awk, head,
# cut) stand in front of the host's, as in m: the pipelines under test run
# under them on the device.
U="${TMP}/u"; mkdir -p "${U}/shim" "${U}/repo" "${U}/run"
src_of "${WIFICTL_REL}" "${U}/repo/wifictl"
printf 'get_setting() { :; }\nset_setting() { printf "%%s=%%s\\n" "$1" "$2" >> /run/settings; }\nexport PATH=/shim:/bbin:/usr/bin:/bin\n' > "${U}/profile"
cat > "${U}/shim/nmcli" <<'EOS'
#!/bin/bash
# NetworkManager as wifictl asks it: the profiles in /run/profiles (name,
# type, active -- tab-separated), escaped as nmcli -t escapes them.
[ -e /run/nm-down ] && { echo "Error: NetworkManager is not running." >&2; exit 8; }
TAB=$(printf '\t')
esc() { printf '%s' "$1" | sed 's/\\/\\\\/g; s/:/\\:/g'; }
case "$*" in
  *"-s -g 802-11-wireless-security.psk connection show id "*)
    all="$*"; name="${all#*connection show id }"
    cut -f1 /run/profiles | grep -q -x -F -- "${name}" || { echo "Error: unknown connection '${name}'." >&2; exit 10; }
    printf 'psk-of-%s\n' "${name}" ;;
  *"device show "*)
    active=$(awk -F'\t' '$2 ~ /wireless/ && $3 == "yes" { print $1 }' /run/profiles | head -n 1)
    printf 'GENERAL.CONNECTION:%s\n' "$(esc "${active}")" ;;
  *"connection modify "*)
    exit 0 ;;
  *"connection up id "*)
    all="$*"; name="${all#*connection up id }"
    printf '%s\n' "${name}" >> /run/up
    cut -f1 /run/profiles | grep -q -x -F -- "${name}" || { echo "Error: unknown connection '${name}'." >&2; exit 10; }
    [ -e /run/up-fails ] && { echo "Error: Connection activation failed: (7) Secrets were required, but not provided." >&2; exit 4; }
    NAME="${name}" awk -F'\t' 'BEGIN { OFS = FS } { $3 = ($1 == ENVIRON["NAME"] && $2 ~ /wireless/) ? "yes" : (($2 ~ /wireless/) ? "no" : $3); print }' /run/profiles > /run/profiles.new && mv /run/profiles.new /run/profiles ;;
  *"connection show"*)
    while IFS="${TAB}" read -r name type active; do
      printf '%s:%s:%s\n' "$(esc "${name}")" "${type}" "${active}"
    done < /run/profiles ;;
  *"wifi list"*)
    # The access points in range: every remembered wireless network, the
    # one in use marked, and a neighbour nobody saved.
    while IFS="${TAB}" read -r name type active; do
      case "${type}" in *wireless*) printf '%s:%s\n' "${active}" "$(esc "${name}")" ;; esac
    done < /run/profiles
    echo "no:Neighbour" ;;
  *"connection delete id "*)
    all="$*"; name="${all#*connection delete id }"
    printf '%s\n' "${name}" >> /run/deleted
