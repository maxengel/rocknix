    [ -e "${QSVC}/raofflineproxy.conf" ]; check $? "toggle on: raofflineproxy.conf is still there after the pass" "raofflineproxy.conf is gone after the pass: 007-syncthing inherited CONF from 006-raofflineproxy and removed it; markers left: $(ls "${QSVC}" | tr '\n' ' ')"
    grep -qx 'start raofflineproxy started' "${QLOG}"; check $? "and the unit's condition held when its start was processed" "systemctl saw: $(grep raofflineproxy "${QLOG}" | tr '\n' '|')"
    ! grep -q 'condition-unmet' "${QLOG}"; check $? "no start found its marker missing" "systemctl saw: $(tr '\n' '|' < "${QLOG}")"
    [ ! -e "${QSVC}/sshd.conf" ] && grep -qx 'stop sshd' "${QLOG}"; check $? "ssh off: no sshd.conf, sshd stopped (the pass still does its job)" "sshd.conf: $([ -e "${QSVC}/sshd.conf" ] && echo present || echo absent); systemctl saw: $(tr '\n' '|' < "${QLOG}")"
    # Step 7 of the upgrade shape: the toggle off (or never set) and a marker
    # left behind -- the pass removes it and stops the service.
    printf 'system.hostname=X\nglobal.retroachievements.offlineproxy=0\nsamba.enabled=1\n' > "${QCFG}"
