EXIT_LOCK_HELD=75; EXIT_NO_NETWORK=69; RCLONE_NET_OPTS_FALLBACK="--contimeout 15s"; METHOD_OVERRIDE=""; EXTRA_UPDATE=0; LOG_LEVEL=INFO
