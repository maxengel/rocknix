        fi
        mkdir -p "$(dirname "${dst}")" && cp "${src}" "${dst}" ;;
    size) printf '{"count":1,"bytes":%s}\n' "$(stat -c %s "$(local_of "$1")" 2>/dev/null || echo 0)" ;;
