[ -f "${DS}/.config/.cloud_sync-net-opts-retries-applied" ]; check $? "and the once-only marker is set" "no marker"
printf 'SAVESPATH="/storage/roms"\nBACKUPMETHOD="copy"\nRCLONE_NET_OPTS="--contimeout 15s --timeout 30s --low-level-retries 4 --retries 1"\n' > "${DS}/.config/cloud_sync.conf"
