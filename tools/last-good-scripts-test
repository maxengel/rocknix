echo "  h. the rclone wrapper: an automatic run's stalled call ends at the ceiling, a deliberate run's at the stall ceiling (D-CLOUD-118, D-CLOUD-126)"
# The wrapper and its helpers are lifted out of cloud_backup (from BASE_REF
# under --old, as every case does since #151 PL-10) and run against a shim
# rclone that sleeps. With AUTOMATIC=1 and a deadline 3 s away it must
# return 124 within a few seconds. With AUTOMATIC=0 and a 3 s stall ceiling
# a shim that finishes returns its own status, and one that prints nothing
# and sleeps is ended at the ceiling and returns 124 as well -- the shipped
# scripts left it to sleep its 20 s out and returned 0 (#153). The shim
# execs its sleep so a TERM reaches the process holding the wrapper's fifo.
H="${TMP}/h"; mkdir -p "${H}/shim" "${H}/run"
printf '#!/bin/sh\nexec sleep "${SHIM_SLEEP:-60}"\n' > "${H}/shim/rclone"; chmod +x "${H}/shim/rclone"
src_of "${RCLONE_REL}/cloud_backup" "${H}/cloud_backup"; src_of "${RCLONE_REL}/cloud_restore" "${H}/cloud_restore"
{
    sed -n '/^child_running() {/,/^}/p; /^progress_mark() {/,/^}/p; /^advance_mark() {/,/^}/p; /^bounded_rclone() {/,/^}/p; /^rclone() {/,/^}/p' "${H}/cloud_backup"
    printf 'RCLONE_OUTER=""; RCLONE_CHILD=""; CEILING_DIR_ROOT=%q; DELIBERATE_CEILING_SECONDS=3\nlog_message() { :; }\n' "${H}/run"
} > "${H}/wrapper.sh"
grep -q 'command timeout' "${H}/wrapper.sh"; check $? "the wrapper is lifted from cloud_backup" "no rclone() wrapper found in cloud_backup"
t0=$(date +%s)
RC_H=$(PATH="${H}/shim:${PATH}" bash -c ". '${H}/wrapper.sh'; AUTOMATIC=1; SYNC_DEADLINE=\$(( \$(date +%s) + 3 )); RCLONE_SYNC_NET_OPTS_ARRAY=(--retries 1); rclone lsd x: ; echo \$?" 2>/dev/null | tail -1)
dt=$(( $(date +%s) - t0 ))
[ "${RC_H}" = "124" ]; check $? "an automatic run's stalled rclone returns 124 (timeout)" "returned '${RC_H}'"
[ "${dt}" -le 10 ]; check $? "and within the ceiling (${dt}s)" "took ${dt}s"
RC_H=$(PATH="${H}/shim:${PATH}" SHIM_SLEEP=0 bash -c ". '${H}/wrapper.sh'; AUTOMATIC=0; SYNC_DEADLINE=0; rclone lsd x: ; echo \$?" 2>/dev/null | tail -1)
[ "${RC_H}" = "0" ]; check $? "a deliberate run's rclone that finishes returns its own status" "returned '${RC_H}'"
t0=$(date +%s)
RC_H=$(PATH="${H}/shim:${PATH}" SHIM_SLEEP=20 bash -c ". '${H}/wrapper.sh'; AUTOMATIC=0; SYNC_DEADLINE=0; rclone lsd x: ; echo \$?" 2>/dev/null | tail -1)
dt=$(( $(date +%s) - t0 ))
[ "${RC_H}" = "124" ] && [ "${dt}" -le 10 ]; check $? "a deliberate run's rclone that shows no progress is ended at the stall ceiling and returns 124 (${dt}s)" "returned '${RC_H}' after ${dt}s -- a deliberate run's stalled rclone was left to itself (#153)"
for scr in cloud_backup cloud_restore; do
  bash -c ". <(sed -n '/^why_for() {/,/^}/p' '${H}/${scr}'); AUTOMATIC=1; why_for 124" 2>/dev/null | grep -q "TOOK TOO LONG"; check $? "${scr}: why_for 124 on an automatic run says the cloud took too long" "${scr}: $(bash -c ". <(sed -n '/^why_for() {/,/^}/p' '${H}/${scr}'); AUTOMATIC=1; why_for 124" 2>/dev/null)"
  bash -c ". <(sed -n '/^why_for() {/,/^}/p' '${H}/${scr}'); AUTOMATIC=0; why_for 124" 2>/dev/null | grep -q "STOPPED ANSWERING"; check $? "${scr}: and on a deliberate run that the cloud stopped answering (TRY AGAIN is in reach)" "${scr}: '$(bash -c ". <(sed -n '/^why_for() {/,/^}/p' '${H}/${scr}'); AUTOMATIC=0; why_for 124" 2>/dev/null)' -- the automatic sync's words, promising a retry nobody scheduled (#153)"
done
for scr in cloud_backup cloud_restore cloud_content_backup cloud_content_restore; do :; done
shipped_sync=$(sed -n 's/^DEFAULT_RCLONE_SYNC_NET_OPTS="\(.*\)"$/\1/p' "${ROOT}/${RCLONE_REL}/cloud_sync.conf.defaults")
for scr in cloud_backup cloud_restore; do
  fb=$(sed -n 's/^RCLONE_SYNC_NET_OPTS_FALLBACK="\(.*\)"$/\1/p' "${ROOT}/${RCLONE_REL}/${scr}")
  [ -n "${fb}" ] && [ "${fb}" = "${shipped_sync}" ]; check $? "${scr}: RCLONE_SYNC_NET_OPTS_FALLBACK is the shipped value" "${scr}: '${fb:-(none)}' vs '${shipped_sync}'"
done

echo "  i. cloud_net_ready settles on a held default route however NetworkManager judges connectivity"
# The RG SP case (2026-09-12): NetworkManager stuck at "connected (site
# only)" / "limited" with the internet reachable; the helper waited 60 s and
# said no network. Shims stand in for ip (a default route) and nmcli (that
# verdict); the helper must settle within the grace, not wait to the deadline.
I="${TMP}/i"; mkdir -p "${I}/shim"
printf '#!/bin/sh\ncase "$*" in *"route show default"*) echo "default via 192.168.1.1 dev wlan0" ;; esac\n' > "${I}/shim/ip"
printf '#!/bin/sh\ncase "$*" in *STATE*) echo "connected (site only)" ;; *CONNECTIVITY*) echo "limited" ;; esac\n' > "${I}/shim/nmcli"
chmod +x "${I}/shim"/*
t0=$(date +%s)
PATH="${I}/shim:${PATH}" bash "${ROOT}/${RCLONE_REL}/cloud_net_ready" --wait 12 > "${I}/out" 2>&1; RC_I=$?
dt=$(( $(date +%s) - t0 ))
[ "${RC_I}" -eq 0 ]; check $? "connected (site only) + limited settles (rc ${RC_I}, ${dt}s)" "rc ${RC_I} after ${dt}s: $(tail -1 "${I}/out" | cut -c1-120)"
[ "${dt}" -lt 12 ]; check $? "and before the deadline" "took the whole wait: ${dt}s"
printf '#!/bin/sh\ncase "$*" in *STATE*) echo "connecting" ;; *CONNECTIVITY*) echo "unknown" ;; esac\n' > "${I}/shim/nmcli"
t0=$(date +%s)
PATH="${I}/shim:${PATH}" bash "${ROOT}/${RCLONE_REL}/cloud_net_ready" --wait 3 > "${I}/out" 2>&1; RC_I=$?
[ "${RC_I}" -eq 69 ]; check $? "still connecting at the deadline exits 69" "rc ${RC_I}: $(tail -1 "${I}/out" | cut -c1-120)"

echo "  j. cloud_sync_helper migrates the shipped retry bound once, and leaves a hand-tuned value alone (#107)"
