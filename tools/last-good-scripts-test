printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\nglobal.retroachievements.username=QA\nglobal.retroachievements.token=FIXTURETOKEN\n' > "${TCFG}"
treset; rm -f "${TREADY}"; rm -f "${TPD}/proxy.sqlite3"*
