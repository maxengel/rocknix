printf 'SAVESPATH="/storage/roms"\nSAVES_REMOTE="/ROCK' > "${DS}/.config/cloud_sync.conf"
sb bash /repo/cloud_sync_helper /tmp/helper.log
[ "$(cat "${DS}/.config/cloud_sync.conf.bak")" = "${good_conf}" ]; check $? "a conf that does not parse does not replace the good .bak" "conf.bak now: '$(tail -1 "${DS}/.config/cloud_sync.conf.bak")'"
