rm -f "${PDB}" "${PDB}-wal" "${PDB}-shm"; pdb "INSERT INTO api_cache(cacheKey,responseBody,cachedAt,firstCachedAt) VALUES ('login2::qa','{\"Success\":true,\"User\":\"QA\",\"Token\":\"SECRETTOKEN123\"}',1789336962833,1789336962833)"
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.offlineproxy=1\nglobal.retroachievements.username=QA\n' > "${PCFG}"
