from raofflineproxy import network
class ImageServer:
    def __init__(self, st): self.storage = st; self.config_data = {}; self.asked = []
    def is_online(self): self.asked.append("is_online"); return True
    def _forward_static_asset(self, path, headers): self.asked.append("forward"); return proxy_service.raw_response_bytes(200, b"fetched", "image/png", "OK")
    def process_proxy_request(self, *a): return proxy_service.ProxyRuntimeServer.process_proxy_request(self, *a)
class ImageSock:
    # What socketserver.StreamRequestHandler asks of a connection: a reader over the request bytes, sendall for the answer.
    def __init__(self, raw): self.rfile = io.BytesIO(raw); self.out = bytearray()
    def makefile(self, mode, *a, **k): return self.rfile
    def sendall(self, data): self.out += data
    def settimeout(self, *a): pass
    def setsockopt(self, *a): pass
    def shutdown(self, *a): pass
    def close(self): pass
def image_request(srv, path, extra=""):
    sock = ImageSock(f"GET {path} HTTP/1.1\r\nHost: 127.0.0.1:8080\r\nUser-Agent: es\r\n{extra}\r\n".encode()); t0 = time.monotonic()
    proxy_service.ProxyRequestHandler(sock, ("127.0.0.1", 40000), srv)
    r, body = parse(bytes(sock.out)); return r, body, time.monotonic() - t0
