echo "  e. nothing a screen can show carries an exit code, a log path, a tool's name or a flag"
# The harness's FORBIDDEN regex (docs/audits/2026_09_10-graceful-degradation/
# kill-fixtures-design.md) over every string literal an echo, a screen-bound
# log_message, a fail/note/why can print. Log-only lines are skipped: a
# log_message whose second argument is "false" in the saves scripts, every
# log_message in the content scripts (theirs writes only to the file), and
# any line redirected into a file or to stderr. cloud_sync_helper prints
# nothing to a screen at all and is not scanned.
E_SRC="${TMP}/e"; mkdir -p "${E_SRC}"
for rel in "${RCLONE_REL}"/cloud_backup "${RCLONE_REL}"/cloud_restore "${RCLONE_REL}"/cloud_content_backup "${RCLONE_REL}"/cloud_content_restore "${RCLONE_REL}"/cloud_saves_root "${BT_REL}"; do
