def driver():
    """cloud_oauth main() with the sandbox's patches: its state under COT_DIR,
    a shim rclone that prints an authorize link and waits, a fake window that
    records its pid, no pad, no uinput, no sway."""
    d = os.environ["COT_DIR"]
    loader = importlib.machinery.SourceFileLoader("cloud_oauth", REPO)
    spec = importlib.util.spec_from_loader(loader.name, loader)
    m = importlib.util.module_from_spec(spec)
    loader.exec_module(m)
    m.STATE_DIR = os.path.join(d, "state")
    m.LOG_FILE = os.path.join(d, "cloud_sync.log")
    m.UINPUT = "/nonexistent/uinput"
    shim = os.path.join(d, "rclone")
    with open(shim, "w") as h:
        h.write('#!/bin/bash\n'
                'echo "Please go to http://127.0.0.1:53682/auth?state=abc123"\n'
                'exec -a "$0 authorize" sleep 60\n')
    os.chmod(shim, 0o755)
    m.RCLONE = shim
    win = os.path.join(d, "cloud-signin-window")
    with open(win, "w") as h:
        h.write('#!/bin/bash\necho $$ > "$(dirname "${CLOUD_SIGNIN_PAGE_FILE}")/window.pid"\n'
                'exec -a "$0" sleep 60\n')
    os.chmod(win, 0o755)
    m.SIGNIN_WINDOW = win
    m.running_session = lambda: (d, "wayland-1")
    m.find_gamepad = lambda *a, **k: (None, set())
    m.lan_address = lambda: os.environ.get("COT_LAN", "127.0.0.1")
    m.provider_url = lambda local: "https://www.dropbox.com/oauth2/authorize?state=abc123"
    m.BrowserSession._cursor_timeout = staticmethod(lambda ms: None)
    return m.main(["cloud_oauth"] + sys.argv[4:])
