        --symlink usr/bin /bin --symlink usr/lib /lib --symlink usr/lib64 /lib64 \
        "${QETC[@]}" --ro-bind "${Q}/etc/001-functions" /etc/profile.d/001-functions \
        --ro-bind "${Q}/daemons" /usr/lib/autostart/daemons \
        --bind "${QS}" /storage --ro-bind "${Q}/repo" /repo --ro-bind "${Q}/shim" /shim --bind "${Q}/run" /run \
        --dev /dev --proc /proc --tmpfs /tmp --setenv PATH "${QPATH}" \
        bash -c 'source /repo/099-networkservices; wait' > "${QOUT}" 2>&1; echo $? ) 2>/dev/null )
}
