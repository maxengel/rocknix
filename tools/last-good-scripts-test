printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.hardcore=1\n' > "${PCFG}"
ctl status; [ "${RC}" -eq 1 ] && grep -qx 'enabled=0' "${OUT}"; check $? "status before: enabled=0, exit 1" "rc ${RC}; out: $(tr '\n' '|' < "${OUT}")"
ctl enable
[ "${RC}" -eq 0 ] && [ "$(pv global.retroachievements.offlineproxy)" = "1" ] && [ "$(pv global.retroachievements.hardcore)" = "0" ] && [ "$(pv global.retroachievements.offlineproxy.hardcore_was)" = "1" ]; check $? "enable (rc ${RC}): the toggle is 1, hardcore 0, and the record says it was 1" "rc ${RC}; system.cfg: $(tr '\n' '|' < "${PCFG}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
[ -e "${PMARK}" ] && grep -q '^systemctl start raofflineproxy.service$' "${P}/run/systemctl.log"; check $? "the marker is written and the service started" "marker: $([ -e "${PMARK}" ] && echo yes || echo no); systemctl: $(tr '\n' '|' < "${P}/run/systemctl.log" 2>/dev/null)"
[ "$(wc -l < "${OUT}")" -eq 1 ] && [ "$(tail -1 "${OUT}")" = "hardcore=0" ]; check $? "stdout is the one line EmulationStation reads: hardcore=0" "stdout: $(tr '\n' '|' < "${OUT}")"
[ "$(grep -c . "${PCFG}")" -eq 5 ] && grep -qx 'system.hostname=X' "${PCFG}" && grep -qx 'global.retroachievements=1' "${PCFG}"; check $? "and the other lines of system.cfg are as they were" "system.cfg: $(tr '\n' '|' < "${PCFG}")"
# Twice: the record must still say 1, not the 0 the first enable wrote.
ctl status; [ "${RC}" -eq 0 ] && grep -qx 'enabled=1' "${OUT}" && grep -qx 'hardcore=0' "${OUT}" && grep -qx 'service=active' "${OUT}"; check $? "status after: enabled=1, hardcore=0, service=active, exit 0" "rc ${RC}; out: $(tr '\n' '|' < "${OUT}")"
ctl enable
[ "${RC}" -eq 0 ] && [ "$(pv global.retroachievements.offlineproxy.hardcore_was)" = "1" ] && [ "$(pv global.retroachievements.hardcore)" = "0" ] && [ "$(tail -1 "${OUT}")" = "hardcore=0" ]; check $? "a second enable keeps the record at 1 (rc ${RC})" "record now '$(pv global.retroachievements.offlineproxy.hardcore_was)' -- the first enable's 0 was recorded over the player's 1"
# Off again: hardcore comes back, the record goes, the marker goes.
ctl disable
[ "${RC}" -eq 0 ] && [ "$(pv global.retroachievements.offlineproxy)" = "0" ] && [ "$(pv global.retroachievements.hardcore)" = "1" ] && [ -z "$(pv global.retroachievements.offlineproxy.hardcore_was)" ] && ! grep -q 'hardcore_was' "${PCFG}"; check $? "disable (rc ${RC}): the toggle is 0, hardcore is back at 1, the record line is gone" "rc ${RC}; system.cfg: $(tr '\n' '|' < "${PCFG}"); err: $(tr '\n' '|' < "${ERR}" | cut -c1-160)"
[ ! -e "${PMARK}" ] && grep -q '^systemctl stop raofflineproxy.service$' "${P}/run/systemctl.log" && [ "$(tail -1 "${OUT}")" = "hardcore=1" ] && [ "$(wc -l < "${OUT}")" -eq 1 ]; check $? "the marker is gone, the service stopped, and stdout is hardcore=1" "marker: $([ -e "${PMARK}" ] && echo yes || echo no); systemctl: $(tr '\n' '|' < "${P}/run/systemctl.log"); stdout: $(tr '\n' '|' < "${OUT}")"
ctl disable
[ "${RC}" -eq 0 ] && [ "$(pv global.retroachievements.hardcore)" = "1" ] && [ "$(tail -1 "${OUT}")" = "hardcore=1" ]; check $? "a second disable changes nothing and still answers hardcore=1 (rc ${RC})" "rc ${RC}; hardcore '$(pv global.retroachievements.hardcore)'; stdout: $(tr '\n' '|' < "${OUT}")"
# A casual player, and a device whose system.cfg has never had the key.
printf 'system.hostname=X\nglobal.retroachievements=1\n' > "${PCFG}"
ctl enable; rce=${RC}; ctl disable
[ "${rce}" -eq 0 ] && [ "${RC}" -eq 0 ] && [ "$(pv global.retroachievements.hardcore)" = "0" ] && [ "$(tail -1 "${OUT}")" = "hardcore=0" ]; check $? "with no hardcore line before, enable then disable leaves hardcore 0 (rc ${rce}/${RC})" "hardcore '$(pv global.retroachievements.hardcore)'; stdout: $(tr '\n' '|' < "${OUT}")"
# The service will not start: nothing about the settings changes, the
# marker does not stay, and the exit says so.
printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.hardcore=1\n' > "${PCFG}"; touch "${P}/run/fail-start"
ctl enable
[ "${RC}" -eq 1 ] && [ ! -e "${PMARK}" ] && [ "$(pv global.retroachievements.hardcore)" = "1" ] && [ -z "$(pv global.retroachievements.offlineproxy)" ] && [ -z "$(pv global.retroachievements.offlineproxy.hardcore_was)" ]; check $? "a service that will not start: exit 1, no marker left, hardcore still 1, no toggle and no record written" "rc ${RC}; marker: $([ -e "${PMARK}" ] && echo yes || echo no); system.cfg: $(tr '\n' '|' < "${PCFG}")"
[ ! -s "${OUT}" ]; check $? "and nothing on stdout for EmulationStation to mistake for a result" "stdout: $(tr '\n' '|' < "${OUT}")"
rm -f "${P}/run/fail-start"
# A settings write that fails, at each of the three, on a device with
# hardcore on: the device is left exactly as it was -- toggle unset,
# hardcore 1, no record, the marker gone, the service stopped (#186 PL-16).
for fk in global.retroachievements.offlineproxy.hardcore_was global.retroachievements.hardcore global.retroachievements.offlineproxy; do
    printf 'system.hostname=X\nglobal.retroachievements=1\nglobal.retroachievements.hardcore=1\n' > "${PCFG}"; rm -f "${P}/run/active" "${PMARK}"; : > "${P}/run/systemctl.log"
    printf '%s\n' "${fk}" > "${P}/run/fail-set"
    ctl enable
    [ "${RC}" -eq 1 ] && [ "$(pv global.retroachievements.offlineproxy)" != "1" ] && [ "$(pv global.retroachievements.hardcore)" = "1" ] && ! grep -q 'hardcore_was' "${PCFG}" && [ ! -e "${PMARK}" ] && [ ! -e "${P}/run/active" ] && [ ! -s "${OUT}" ]; check $? "enable with the ${fk##*.} write failing: exit 1, toggle not 1, hardcore still 1, no record, marker gone, service stopped, nothing on stdout" "rc ${RC}; system.cfg: $(tr '\n' '|' < "${PCFG}"); marker: $([ -e "${PMARK}" ] && echo yes || echo no); service: $([ -e "${P}/run/active" ] && echo active || echo stopped); stdout: $(tr '\n' '|' < "${OUT}") (#186 PL-16)"
done
rm -f "${P}/run/fail-set"
# pending and flushed (#173, D-RA-004): what the exit sync card asks before
# it speaks, and what the next card that reached the network asks. A
# fixture store with the proxy's own pending_awards table (storage.py's
# DDL, WAL like the service's), written by the host's python3; the ctl
