            L.power_cut()
            cur_es = parse_es(L.dev.run(f"cat {ES_SETTINGS} 2>/dev/null || true", check=False)) or s0_es
            cur_sys = parse_syscfg(L.dev.run(f"cat {SYSCFG} 2>/dev/null || true", check=False)) or s0_sys
            if classify(cur_es, s0_es, toggle_key, toggle_default, marker_es) == "DEFAULTS":
