def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", help="ssh target, e.g. root@127.0.0.1 (required unless --list)")
    ap.add_argument("--port", type=int, default=10022)
    ap.add_argument("--identity", help="ssh private key")
    ap.add_argument("--real-roms", action="store_true",
                    help="use /storage/roms instead of a scratch tree (DESTRUCTIVE)")
    ap.add_argument("--keep", action="store_true", help="leave fixtures in place")
    ap.add_argument("--path-prefix", help="a directory on the device to put first on PATH (scripts under test, before an image carries them)")
    ap.add_argument("--second-port", type=int,
                    help="ssh port of a second device -- the VM pair's guest b -- which turns on the two-device fixtures (D-QA-009)")
    ap.add_argument("--second-host", help="ssh target of the second device (default: the same as --host)")
    ap.add_argument("--only", help="run only these fixtures, skipping the single-device suite (comma-separated: A1,A9,CONTRACT "
                    "for the two-device set, which needs --second-port; CAP1..CAP12 for the capture set, one device, no cloud)")
    ap.add_argument("--list", action="store_true", help="print the fixture registries and exit without touching a device")
    ap.add_argument("--transport", default="copy,bisync", help="transports for #9's contract fixtures: copy, bisync, or both (default)")
    ap.add_argument("--bisync-flags", default="", help="extra flags for every rclone bisync run (Gate 11 variants)")
    ap.add_argument("--dump", help="a host directory to write raw outputs into: every transport run's (Gate 11's record), "
                    "and each LINK cell's detached run and re-run (<dump>/LINKn/{out,rc,rerun.out})")
    ap.add_argument("--link", action="store_true",
                    help="run the link-loss fixtures LINK1..LINK7 after the suite (#103); they take minutes and need the guest's serial console")
    ap.add_argument("--serial-socket", default="/tmp/rocknix-qemu-serial.sock",
                    help="the guest's serial console socket, from generic-x64-vm run --headless (default: %(default)s); "
                         "the link-loss fixtures are skipped when it is not there")
    ap.add_argument("--vm-serial", default=os.path.join(HERE, "vm-serial"), help="the serial client (default: %(default)s)")
    ap.add_argument("--link-restore-after", type=float, default=40,
                    help="seconds after the cut at which the link is restored (default: %(default)s; 120 shows an unbounded run overshoot the bound)")
    ap.add_argument("--kill", action="store_true",
                    help="run the KILL cells after the suite (#105): a writer killed at every step, the config files power-cut; "
                         "--only KILL1,... for a subset (cells needing no endpoint prepare the device locally)")
    ap.add_argument("--monitor-socket", default="/tmp/rocknix-qemu-monitor.sock",
                    help="QEMU's monitor socket, from generic-x64-vm run --headless (default: %(default)s); the power-cut cells "
                         "KILL12/KILL13 are skipped when it is not there")
    ap.add_argument("--power-cut-trials", type=int, default=3, help="KILL13 arm A: how many of --cut-after-ms to run (default: %(default)s)")
    ap.add_argument("--cut-after-ms", default="0,50,200,1000",
                    help="KILL13 arm A: the gaps between the page close and system_reset, in ms (default: %(default)s)")
    ap.add_argument("--vocabulary", dest="vocabulary", action="store_true", default=True,
                    help="assert the three outcome words (COMPLETED, COULDN'T FINISH, SKIPPED) on every run's last line; on by "
                         "default since 2026-09-10 (the FORBIDDEN check -- no exit codes, log paths or tool names on the screen -- is always on)")
    ap.add_argument("--no-vocabulary", dest="vocabulary", action="store_false",
                    help="skip the outcome-word assertion, for an image that predates the strings")
    args = ap.parse_args()
    # Line-buffered even when redirected: a run in the background used to
    # show nothing until it ended, and a run that hangs showed nothing ever.
    try:
        sys.stdout.reconfigure(line_buffering=True)
    except (AttributeError, ValueError):
        pass
    if args.list:
        list_fixtures()
        return 0
    if not args.host:
        ap.error("--host is required")
    if args.real_roms and args.second_port:
        raise Fail("the two-device fixtures rewrite both saves trees; they never run against real ROMs (D-QA-009)")

    cap_keys = {k for k, _, _ in CAPTURE_FIXTURES}
    solo_keys = {k for k, _, _ in SOLO_FIXTURES}
    link_keys = {k for k, _, _ in LINK_FIXTURES}
    kill_keys = {k for k, _, _, _ in KILL_FIXTURES}
    kill_local_keys = {k for k, _, _, needs in KILL_FIXTURES if "backend" not in needs}
    only = {k.strip().upper() for k in args.only.split(",")} if args.only else None
    skipped = []
    # A run naming only capture fixtures needs no MinIO and no second guest:
    # the producer is network-free, so the backend is asked for nothing. The
    # same for the KILL cells that touch no endpoint (backuptool, set_setting,
    # the local records, and the power-cut cells, which need the console and
    # the monitor but no cloud).
    cap_only = only is not None and only <= cap_keys
    kill_local = only is not None and bool(only) and only <= kill_local_keys
    local_only = cap_only or kill_local
    remote = "" if local_only else backend("remote-name").strip()
    root = "/storage/roms" if args.real_roms else SCRATCH
    devices = [Device(args.host, args.port, args.identity, args.path_prefix)]
    if args.second_port:
        devices.append(Device(args.second_host or args.host, args.second_port, args.identity, args.path_prefix))

    failures = 0
    prepared = []
    archive = f"{root}/backup/{ARCHIVE_NAME}"
    # From the first capture on, every device carries the harness's settings;
    # whatever happens below -- a failing check, an exception, a Ctrl-C --
    # the block after the try puts each one back (Gate 0, #35: a device the
    # harness has finished with has the remote it started with). Found the
    # hard way: a run that aborted on guest b left the QA remote and the QA
    # paths behind.
    try:
        if local_only:
            first = prepare_local(devices[0], root, args, prepared,
                                  keys=("SAVESPATH", "SETTINGS_BACKUPS") if kill_local else ("SAVESPATH",), capture=cap_only)
        else:
            if len(devices) > 1:
                assert_two_devices(devices[0], devices[1])
            first = prepare_device(devices[0], remote, root, args, prepared, which="a " if len(devices) > 1 else "")
            if len(devices) > 1:
                prepare_device(devices[1], remote, root, args, prepared, which="b ")
        if not args.only:
            failures += run_steps(first.dev, root, remote, args, first.settings, first.prev_paths)
        if len(prepared) > 1:
            failures += run_pair(prepared[0].dev, prepared[1].dev, root, remote, args, first.settings)
        elif only and only - cap_keys - solo_keys - link_keys - kill_keys:
            print("\n--only names two-device fixtures; pass --second-port for the VM pair's guest b")
        if only and only & solo_keys:
            failures += run_solo(first.dev, root, remote, args, first.settings, only)
        if only and only & cap_keys:
            failures += run_capture(first.dev, root, args, only)
        if args.link or (only and only & link_keys):
            # Off by default in the suite: minutes per cell, and a channel a
            # handheld does not have. Skipped -- said, not silently -- when
            # the console is not there.
            serial = Serial(args.serial_socket, args.vm_serial)
            if serial.usable():
                failures += run_link(first.dev, root, remote, args, first.settings, serial, only)
            else:
                skipped.append(f"LINK fixtures: no serial console at {args.serial_socket} (or {args.vm_serial} is not executable); "
                               "a guest from `generic-x64-vm run --headless` has one, a handheld has none")
                print(f"\n    SKIP  {skipped[-1]}")
        if args.kill or (only and only & kill_keys):
            # Off by default: minutes per cell, and two of them reboot the
            # guest. Cells whose channel is missing are skipped one by one,
            # with a line each, inside run_kill.
            serial = Serial(args.serial_socket, args.vm_serial)
            failures += run_kill(first.dev, root, remote, args, first.settings, serial, only, local_only)
    finally:
        for p in prepared:
            restore_device(p, args, archive)
    note = f" ({'; '.join(skipped)})" if skipped else ""
    print(f"\n{'PASSED' if failures == 0 else f'{failures} CHECK(S) FAILED'}{note}")
    return 1 if failures else 0


def run_steps(dev, root, remote, args, settings, prev_paths):
    failures = 0
    step("plant fixtures")
    for rel, data in {**FIXTURES, **EXCLUDED}.items():
        dev.write(f"{root}/{rel}", data)
    before = {rel: dev.sha(f"{root}/{rel}") for rel in FIXTURES}
    failures += not check(all(before.values()), "fixtures written",
                          "could not write fixtures")

    step("saves back up to the cloud")
    backend("reset")
    # Nothing is in the cloud yet, so a restore must fail -- and fail as a
    # failure, with its own code. cloud_restore leaves with rclone's code for
    # "directory not found", 3, which until 2026-09-09 was also the lock
    # sentinel EmulationStation reads, and the page said SKIPPED - ANOTHER
    # CLOUD SYNC IS RUNNING over a run that had moved five files (VM; #99).
    # The sentinels are 75 (lock held) and 69 (no network) now, codes rclone
    # cannot return; a phase failure passes rclone's code through unremapped.
    rc = dev.run("cloud_restore --yes --saves-only >/dev/null 2>&1; echo $?", check=False).strip()
    failures += not check(rc not in ("0", "75", "69"),
                          "a restore with no Saves folder in the cloud fails with its own code, not as a sentinel",
                          f"cloud_restore exited {rc!r} against an empty endpoint (0 = succeeded, 75/69 = read as a sentinel)")
    # As BACK UP SAVES TO THE CLOUD runs it: --saves-only, or the settings
    # phase rides along under a saves label (2026-09-06).
    dev.run("cloud_backup --yes --saves-only >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    uploaded = {rel for rel in FIXTURES if os.path.basename(rel) in listing}
    failures += not check(len(uploaded) == len(FIXTURES),
                          f"all {len(FIXTURES)} fixtures reached the bucket",
                          f"only {len(uploaded)}/{len(FIXTURES)} reached the bucket")
    # Only meaningful once something uploaded: if the backup did nothing at
    # all, "the excluded file is absent" is true for the wrong reason and
    # reports a pass over a broken run.
    leaked = [rel for rel in EXCLUDED if os.path.basename(rel) in listing]
    if uploaded:
        failures += not check(not leaked,
                              "the allowlist kept excluded files out of the cloud",
                              f"excluded file(s) uploaded: {leaked}")
    else:
        print("    SKIP  allowlist check - nothing uploaded, so it proves nothing")

    step("a second backup replaces several saves at once")
    # Every saves assertion above this line is about a FIRST upload, and a
    # first upload has nothing to move out of the way. The exit sync after a
    # game is the other case -- saves already in the cloud, replaced -- and it
    # was broken on Dropbox for as long as #103's retry bound shipped, with
    # the harness green throughout (#107, D-CLOUD-083). --backup-dir turns
    # each replacement into a server-side move as well as an upload, so this
    # exercises twice the writes per file and several files at once.
    #
    # This backend has no per-folder write lock, so it cannot reproduce
    # Dropbox's contention; what it can prove is that the replace path works
    # at all and that the cloud ends up holding the new bytes. Both were
    # untested until now.
    for rel in FIXTURES:
        dev.run(f"printf 'v2-%s' {shlex.quote(rel)} >> {shlex.quote(f'{root}/{rel}')}")
    want = {rel: dev.sha(f"{root}/{rel}") for rel in FIXTURES}
    rc, out = run_rc(dev, "cloud_backup --yes --saves-only")
    failures += not check(rc == 0, f"the second backup completed (exit {rc})",
                          f"the second backup exited {rc}: {out.strip()[-200:]!r}")
    # Read the cloud copies back, not the run's own report (#53's lesson).
    stale = []
    for rel in FIXTURES:
        dev.run(f"rm -f {shlex.quote(f'{root}/{rel}')}")
    run_rc(dev, "cloud_restore --yes --saves-only")
    for rel in FIXTURES:
        if dev.sha(f"{root}/{rel}") != want[rel]:
            stale.append(rel)
    failures += not check(not stale,
                          f"all {len(FIXTURES)} replaced saves came back from the cloud as the new bytes",
                          f"the cloud still holds the old bytes for: {stale}")
    # These files legitimately hold their v2 bytes from here on, on both
    # sides. The round-trip check below compares against what was here before
    # the first backup, so it is told what "before" means now -- otherwise it
    # reports 0/4 matched for a restore that worked perfectly.
    before = dict(want)

    step("saves restore from the cloud")
    for rel in FIXTURES:
        dev.run(f"rm -f {shlex.quote(f'{root}/{rel}')}")
    gone = [rel for rel in FIXTURES if dev.sha(f"{root}/{rel}")]
    failures += not check(not gone, "local copies removed before restore",
                          f"still present: {gone}")
    dev.run("cloud_restore --yes --saves-only >/dev/null 2>&1 || true", check=False)
    after = {rel: dev.sha(f"{root}/{rel}") for rel in FIXTURES}
    same = [rel for rel in FIXTURES if before[rel] and before[rel] == after[rel]]
    failures += not check(len(same) == len(FIXTURES),
                          f"all {len(FIXTURES)} files restored byte-identical",
                          f"only {len(same)}/{len(FIXTURES)} matched: "
                          f"{[r for r in FIXTURES if r not in same]}")

    step("the settings archive round-trips")
    # Off by default, so the phase would otherwise never run here. Remember the
    # device's own setting: leaving it on would mean a later user-initiated
    # restore also pulls archives down, which they never asked for.
    dev.run(f"grep -m1 '^BACKUPFILE_RESTORE_OPTION=' {CONF} > {CONF}.qa-prev 2>/dev/null || : > {CONF}.qa-prev")
    dev.run(f"grep -q '^BACKUPFILE_RESTORE_OPTION=' {CONF} "
            f"&& sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|BACKUPFILE_RESTORE_OPTION=\"yes\"|' {CONF} "
            f"|| echo 'BACKUPFILE_RESTORE_OPTION=\"yes\"' >> {CONF}")
    archive = f"{root}/backup/{ARCHIVE_NAME}"
    dev.write(archive, ARCHIVE_BODY)
    arch_before = dev.sha(archive)
    backend("reset")
    # As the settings tier runs it (backuptool backup && cloud_backup --yes --system-only).
    dev.run("cloud_backup --yes --system-only >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    uploaded_archive = ARCHIVE_NAME in listing
    failures += not check(uploaded_archive,
                          "the settings backup archive reached the cloud",
                          "the archive was not uploaded")

    # It must land under this device's own folder. A single shared filename is
    # what let the second device to run replace the first device's archive,
    # with no remote history to recover it from (#49). One device cannot
    # demonstrate the collision, but it can prove the archive is namespaced --
    # which is the property that prevents it.
    if uploaded_archive:
        device_id = dev.run("cloud_device_id 2>/dev/null || true").strip()
        failures += not check(
            bool(device_id) and f"{device_id}/{ARCHIVE_NAME}" in listing,
            f"the archive is filed under this device ({device_id or 'no id'})",
            "the archive sits at the root of the backup path - a second "
            "device would overwrite it")
    dev.run(f"rm -f {shlex.quote(archive)}")
    mark = log_mark(dev)
    dev.run("cloud_restore --yes --system-only >/dev/null 2>&1 || true", check=False)
    if uploaded_archive:
        arch_after = dev.sha(archive)
        failures += not check(arch_after is not None and arch_after == arch_before,
                              "the archive came back byte-identical",
                              "the archive did not come back - restore can report "
                              "SUCCESS while its filter matches nothing")
        # The archive carries no device name, so the restorer had none of this
        # device's to prefer and must say it took the newest overall instead.
        tail = dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true", check=False)
        failures += not check("restoring the newest there" in tail,
                              "and the restorer said it fell back to the newest archive overall",
                              "a pre-label archive was restored without the fallback being logged")
    else:
        print("    SKIP  archive restore - nothing was uploaded, so it proves nothing")

    # A second backup, against a remote that already holds one. The first
    # transfer always happens, so it cannot detect a comparison that wrongly
    # decides the file is already there - which is what #53 was.
    if uploaded_archive:
        step("a changed archive of the same size still reaches the cloud")
        dev.write(archive, ARCHIVE_BODY_V2)
        v2_local = dev.sha(archive)
        dev.run("cloud_backup --yes --system-only >/dev/null 2>&1 || true", check=False)
        dev.run(f"rm -f {shlex.quote(archive)}")
        dev.run("cloud_restore --yes --system-only >/dev/null 2>&1 || true", check=False)
        v2_back = dev.sha(archive)
        failures += not check(v2_back is not None and v2_back == v2_local,
                              "the second archive replaced the first in the cloud",
                              "the changed archive never reached the cloud - a "
                              "size-only comparison can skip the upload and "
                              "still report SUCCESS")

    # --- per-device names: retention and preference -------------------------
    # Since 2026-09-08 an archive's name carries the device that wrote it,
    # between the date and ROCKNIX (<stamp>-<label>-ROCKNIX_SETTINGS.tar.gz),
    # and two rules hang off that. Retention counts and removes only archives
    # carrying this device's label, in this device's own folder: one carrying
    # another device's label (restored here and sent up again, or written by a
    # device sharing the folder through a cloned id, #86) or none (from before
    # names carried a device) is left alone. And a restore brings back this
    # device's newest before anything newer another device wrote. One device
    # proves both by planting the other shapes in its own folder: the VM
    # pair's guest b gets its own folder by construction, so the pair cannot
    # share one without a cloned id, which A11 refuses. A same-label archive
    # from another device of the same model is not planted: by design it
    # cannot be told from this device's own, and counts as one of them.
    step("retention removes only archives carrying this device's name, and restore prefers them")
    label = dev.run("cloud_device_id --label 2>/dev/null || true").strip()
    osn = os_name(dev)
    device_id = dev.run("cloud_device_id 2>/dev/null || true").strip()
    settings_remote = settings.get("SETTINGS_REMOTE") or settings.get("SYNCPATH_BACKUP") or ""
    keep_raw = dev.run(f"grep -m1 '^CLOUD_BACKUP_KEEP=' {CONF} 2>/dev/null | cut -d= -f2 | tr -d '\"' || true").strip()
    keep = int(keep_raw) if keep_raw.isdigit() else 3
    folder = f"{remote}:{settings_remote}/{device_id}"
    if not (label and device_id and settings_remote) or not 1 <= keep <= 20:
        failures += not check(False, "",
                              f"cannot set the fixture up (label {label!r}, id {device_id!r}, "
                              f"settings remote {settings_remote!r}, keep {keep})")
    else:
        other = f"2026_01_01-000000-Other-Handheld-{osn}_SETTINGS.tar.gz"
        # Both pre-label shapes a folder in the field holds: the dated tar,
        # and the zip the uploader dated on its way up.
        unlabelled = [f"2026_01_01-000000-{osn}_SETTINGS.tar.gz", f"2026_01_01-000000-{osn}_BACKUP.zip"]
        # keep of this device's planted, one more uploaded: exactly one goes.
        own = [f"2026_01_{d:02d}-000000-{label}-{osn}_SETTINGS.tar.gz" for d in range(2, 2 + keep)]
        newest_own = f"2026_01_{2 + keep:02d}-000000-{label}-{osn}_SETTINGS.tar.gz"
        newer_other = f"2099_01_01-000000-Other-Handheld-{osn}_SETTINGS.tar.gz"
        plant = "/tmp/qa-plant"
        broot = f"{root}/backup"
        dev.run(f"rclone purge {shlex.quote(folder)} >/dev/null 2>&1; rm -rf {plant}; mkdir -p {plant} {shlex.quote(broot)}",
                check=False)
        # A fixture that cannot be planted is a FAIL here, not an abort of
        # every step after this one.
        try:
            for name in [other] + unlabelled + own:
                dev.write(f"{plant}/{name}", name.encode())
                dev.run(f"rclone copyto {shlex.quote(f'{plant}/{name}')} {shlex.quote(f'{folder}/{name}')}")
            planted = True
        except Fail as e:
            planted = False
            failures += not check(False, "", f"could not plant the fixture in {folder}: {e}")
        ran = False
        if planted:
            # One archive of this device's at the root so the upload runs and
            # retention runs after it; the marker is cleared so a root that
            # looks unchanged is not skipped.
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip {CACHE}/settings-backup.uploaded", check=False)
            # A real archive: cloud_backup lists it before sending and refuses
            # one that does not list (2026-09-10), so a run of bytes never
            # uploads and retention never runs.
            dev.write(f"{broot}/{newest_own}", ARCHIVE_BODY)
            rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
            listing = dev.run(f"rclone lsf --files-only {shlex.quote(folder + '/')} 2>/dev/null || true", check=False).split()
            mine = sorted(n for n in listing if n.endswith(f"-{label}-{osn}_SETTINGS.tar.gz"))
            ran = check(rc == 0 and newest_own in listing,
                        f"the upload ran (exit {rc})",
                        f"the upload did not run (exit {rc}); retention cannot be judged")
            failures += not ran
        if ran:
            failures += not check(mine == sorted(own[1:] + [newest_own]),
                                  f"this device's archives were trimmed to CLOUD_BACKUP_KEEP={keep}, oldest first",
                                  f"retention did not keep the newest {keep} of this device's: {mine}")
            spared = [other] + unlabelled
            failures += not check(all(n in listing for n in spared),
                                  "another device's archive and both pre-label shapes were left alone",
                                  "RETENTION REMOVED WHAT IS NOT THIS DEVICE'S: "
                                  f"{[n for n in spared if n not in listing]}")

            # Restore: the other device's is newer, and this device's must still win.
            dev.write(f"{plant}/{newer_other}", newer_other.encode())
            dev.run(f"rclone copyto {shlex.quote(f'{plant}/{newer_other}')} {shlex.quote(f'{folder}/{newer_other}')}")
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
            run_rc(dev, "cloud_restore --yes --system-only")
            local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
            failures += not check(newest_own in local and newer_other not in local,
                                  "restore brought back this device's newest, not the other device's newer archive",
                                  f"restore chose {local or 'nothing'} over this device's own {newest_own}")
            # With none of this device's own left, the newest overall -- the
            # fresh-device journey (#26) -- and the log says whose it was.
            for name in mine:
                dev.run(f"rclone deletefile {shlex.quote(f'{folder}/{name}')} >/dev/null 2>&1 || true", check=False)
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
            mark = log_mark(dev)
            run_rc(dev, "cloud_restore --yes --system-only")
            local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
            tail = dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true", check=False)
            failures += not check(newer_other in local,
                                  "with none of its own, restore took the newest overall",
                                  f"restore took {local or 'nothing'} when only other devices' archives remained")
            failures += not check("made on Other-Handheld" in tail,
                                  "and the log named the device that made it",
                                  "the fallback restore did not say whose archive it took")
        dev.run(f"rm -rf {plant}; rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip {CACHE}/settings-backup.uploaded",
                check=False)
        dev.run(f"rclone purge {shlex.quote(folder)} >/dev/null 2>&1 || true", check=False)

    # --- content backup / restore -------------------------------------------
    # cloud_content_backup hardcodes DEST=/storage/roms and ignores SAVESPATH,
    # so the scratch tree cannot contain this one. It is confined instead to a
    # directory the harness creates and removes, and driven per-directory:
    # `--all` would upload the whole ROM library, which is never what a test
    # should do to someone's device.
    step("ROMs and BIOS back up a system directory")
    croot = f"/storage/roms/{CONTENT_DIR}"
    # Never delete somebody's library: the fixture directory is a real
    # system's, and the harness owns it only if it is empty or absent.
    existing = dev.run(f"find {shlex.quote(croot)} -type f 2>/dev/null | head -3 || true").strip()
    if existing and not args.real_roms:
        raise Fail(f"{croot} holds files ({existing.splitlines()[0]} ...); refusing to use it as a fixture")
    dev.run(f"rm -rf {shlex.quote(croot)}")
    for rel, data in CONTENT_FIXTURES.items():
        dev.write(f"{croot}/{rel}", data)
    cbefore = {rel: dev.sha(f"{croot}/{rel}") for rel in CONTENT_FIXTURES}

    listed = dev.run(f"cloud_content_backup --list 2>/dev/null || true")
    failures += not check(CONTENT_DIR in listed,
                          f"{CONTENT_DIR} is offered as a content directory",
                          f"--list did not offer it: {listed.split() or 'nothing'}")

    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    clisting = backend("ls")
    cup = {rel for rel in CONTENT_FIXTURES if os.path.basename(rel) in clisting}
    ok = check(len(cup) == len(CONTENT_FIXTURES),
               f"all {len(CONTENT_FIXTURES)} content files reached the cloud",
               f"only {len(cup)}/{len(CONTENT_FIXTURES)} reached the cloud")
    failures += not ok
    if not ok:
        # Distinguish "this device has the known bug" from "the harness is
        # broken" - otherwise a real, already-diagnosed defect reads as a
        # problem with the test.
        body = dev.run("cat $(command -v cloud_content_backup) 2>/dev/null || true")
        if "Restoring ${DIR:-everything} from the cloud" in body:
            print("          ^ this device ships the inverted cloud_content_backup "
                  "(issue #40): it copies cloud -> device, so nothing is ever "
                  "uploaded. Expected until a build carries the fix.")

    step("a user's own rule sits above the catch-all and keeps its file off the cloud")
    # #39: rclone filters are first-match-wins, and user rules used to be
    # appended below "- /**", where nothing reaches them. The merge puts them
    # first now; this proves it the only way that matters -- a file the user
    # excluded does not travel -- and reads the file's order as well.
    probe_rel = "saves/keep-off-the-cloud.probe"
    dev.run(f"printf 'never leaves' > {shlex.quote(f'{root}/{probe_rel}')}")
    dev.run(f"grep -qxF -- '- /**/*.probe' {RULES} || sed -i '1i - /**/*.probe' {RULES}")
    rc, out = run_rc(dev, "cloud_backup --yes --saves-only")
    failures += not check(rc == 0, f"the backup with a user rule completed (exit {rc})", f"exit {rc}: {out.strip()[-160:]!r}")
    order = dev.run(f"grep -nxF -e '- /**/*.probe' -e '- /**' {RULES} | cut -d: -f1 | tr '\\n' ' '").split()
    failures += not check(len(order) == 2 and int(order[0]) < int(order[1]),
                          f"the user rule sits above the catch-all in the merged file (lines {' < '.join(order) if order else '?'})",
                          f"rules order was {order}")
    saves_remote = dev.run(f"grep -m1 '^SAVES_REMOTE=' {CONF} | cut -d'\"' -f2").strip()
    # The scripts fall back to the first configured remote when REMOTENAME is
    # blank in the conf, and so must this.
    remote_name = dev.run(f"grep -m1 '^REMOTENAME=' {CONF} | cut -d'\"' -f2").strip() \
        or dev.run("rclone listremotes 2>/dev/null | head -1").strip()
    listing = dev.run(f"rclone lsf -R --files-only {shlex.quote(remote_name + saves_remote)} 2>/dev/null || true")
    failures += not check("keep-off-the-cloud.probe" not in listing and "game1.srm" in listing,
                          "the excluded file stayed home while the ordinary save travelled",
                          f"cloud listing: {listing.strip()[:200]!r}")
    dev.run(f"sed -i '/^- \\/\\*\\*\\/\\*\\.probe$/d' {RULES}; rm -f {shlex.quote(f'{root}/{probe_rel}')}")

    step("an edited RCLONEOPTS without --filter-from still keeps the allowlist")
    # #71: the allowlist rode along only inside the shipped default value of
    # RCLONEOPTS, so a player who edited that line (a --bwlimit, dropping
    # --progress) and did not keep --filter-from sent the whole ROM library
    # into the saves folder. The scripts add the rules file whenever the
    # options do not name one; a file outside the allowlist must stay home.
    dev.run(f"cp {CONF} {CONF}.qa-71")
    dev.run(f"sed -i '/^RCLONEOPTS=/,/[^\\\\]$/d' {CONF}; echo 'RCLONEOPTS=\"--progress\"' >> {CONF}")
    rom_rel = "saves/not-a-save.rom"
    dev.run(f"printf 'a rom, not a save' > {shlex.quote(f'{root}/{rom_rel}')}")
    rc, out = run_rc(dev, "cloud_backup --yes --saves-only")
    failures += not check(rc == 0, f"the backup with a bare RCLONEOPTS completed (exit {rc})", f"exit {rc}: {out.strip()[-160:]!r}")
    listing = dev.run(f"rclone lsf -R --files-only {shlex.quote(remote_name + saves_remote)} 2>/dev/null || true")
    failures += not check("not-a-save.rom" not in listing and "game1.srm" in listing,
                          "the file outside the allowlist stayed home while the save travelled",
                          f"cloud listing: {listing.strip()[:200]!r}")
    warned = dev.run("grep -c 'carried no --filter-from' /var/log/cloud_sync.log 2>/dev/null || echo 0").strip()
    failures += not check(warned.isdigit() and int(warned) > 0, "the log says the allowlist was added", "no such log line")
    # The restore half: a non-save planted IN the cloud must not come down
    # either, with the same bare options.
    dev.run(f"printf 'cloud-side rom' > /tmp/qa-cloud-side.rom; rclone copyto /tmp/qa-cloud-side.rom "
            f"{shlex.quote(remote_name + saves_remote + '/saves/qa-cloud-side.rom')} >/dev/null 2>&1; rm -f /tmp/qa-cloud-side.rom")
    rc, out = run_rc(dev, "cloud_restore --yes --saves-only")
    came_down = dev.run(f"test -e {shlex.quote(f'{root}/saves/qa-cloud-side.rom')} && echo yes || echo no").strip()
    failures += not check(rc == 0 and came_down == "no",
                          f"a restore with a bare RCLONEOPTS left the cloud-side non-save in the cloud (exit {rc})",
                          f"exit {rc}, came down: {came_down}")
    dev.run(f"rclone deletefile {shlex.quote(remote_name + saves_remote + '/saves/qa-cloud-side.rom')} >/dev/null 2>&1 || true", check=False)
    # A user who names their own filter file keeps control: nothing is added,
    # and their rule -- excluding one save by name -- is what governs.
    dev.run(f"printf -- '- /**/own-rule-victim.srm\n+ /**\n' > /tmp/qa-own-rules.txt; "
            f"sed -i '/^RCLONEOPTS=/d' {CONF}; echo 'RCLONEOPTS=\"--progress --filter-from /tmp/qa-own-rules.txt\"' >> {CONF}; "
            f"printf 'victim' > {shlex.quote(f'{root}/saves/own-rule-victim.srm')}")
    before_warn = dev.run("grep -c 'carried no --filter-from' /var/log/cloud_sync.log 2>/dev/null || echo 0").strip()
    rc, out = run_rc(dev, "cloud_backup --yes --saves-only")
    listing = dev.run(f"rclone lsf -R --files-only {shlex.quote(remote_name + saves_remote)} 2>/dev/null || true")
    after_warn = dev.run("grep -c 'carried no --filter-from' /var/log/cloud_sync.log 2>/dev/null || echo 0").strip()
    failures += not check(rc == 0 and "own-rule-victim.srm" not in listing and after_warn == before_warn,
                          "a user's own --filter-from is honoured and nothing is added over it",
                          f"exit {rc}; victim in cloud: {'own-rule-victim.srm' in listing}; added-lines {before_warn}->{after_warn}")
    dev.run(f"mv -f {CONF}.qa-71 {CONF}; rm -f {shlex.quote(f'{root}/{rom_rel}')} {shlex.quote(f'{root}/saves/own-rule-victim.srm')} /tmp/qa-own-rules.txt")
    # A run's lock can outlive its exit by a moment (a child that inherited
    # the descriptor), and the next step takes the lock itself; give it up
    # to ten seconds to fall free rather than hand the next step a race.
    dev.run("for i in $(seq 1 20); do flock -n /var/run/cloud_sync.lock true 2>/dev/null && break; sleep 0.5; done", check=False)

    step("changing the cloud folder moves the settings folder beside it, and the layout counts as current")
    # #74: CHANGE CLOUD FOLDER used to write the settings folder INSIDE the
    # saves folder -- the nesting cloud_migrate_layout exists to undo and the
    # data-loss trap cloud_backup warns about. Now the siblings derive from
    # the new folder, the warning is gone, the next settings backup lands
    # under the new Backups, and the migration check leaves a chosen layout
    # alone rather than offering to move it back to /ROCKNIX.
    prev = {k: dev.run(f"grep -m1 '^{k}=' {CONF} | cut -d'\"' -f2").strip() for k in ("SAVES_REMOTE", "SETTINGS_REMOTE", "CONTENT_REMOTE")}
    rc, out = run_rc(dev, "cloud_setup --set-saves-remote /QA-Custom/Saves")
    now = {k: dev.run(f"grep -m1 '^{k}=' {CONF} | cut -d'\"' -f2").strip() for k in ("SAVES_REMOTE", "SETTINGS_REMOTE", "CONTENT_REMOTE")}
    failures += not check(now == {"SAVES_REMOTE": "/QA-Custom/Saves", "SETTINGS_REMOTE": "/QA-Custom/Backups", "CONTENT_REMOTE": "/QA-Custom/Content"},
                          "the three folders are siblings under the new root", f"conf reads {now}")
    # The upload wants a local archive to send; the settings steps above may
    # have pointed SETTINGS_BACKUPS back at the device default, so plant one
    # where it points now and take it away afterwards.
    bk_dir = dev.run(f"grep -m1 '^SETTINGS_BACKUPS=' {CONF} | cut -d'\"' -f2").strip() or "/storage/roms/backup"
    bk_name = "2026_01_02-000000-QA-ROCKNIX_SETTINGS.tar.gz"
    dev.run(f"mkdir -p {shlex.quote(bk_dir)}")
    dev.write(f"{bk_dir}/{bk_name}", ARCHIVE_BODY)
    rc, out = run_rc(dev, "cloud_backup --yes --system-only")
    failures += not check(rc == 0 and "inside" not in out.lower(),
                          f"a settings backup ran without the nesting warning (exit {rc})", f"exit {rc}: {out.strip()[-200:]!r}")
    label = dev.run("cloud_device_id --label 2>/dev/null || true").strip()
    landed = dev.run(f"rclone lsf -R --files-only {shlex.quote(remote_name + '/QA-Custom/Backups')} 2>/dev/null || true")
    failures += not check(".tar.gz" in landed and (not label or label in landed),
                          f"the archive landed under /QA-Custom/Backups/{label or '<device>'}/", f"listing: {landed.strip()[:200]!r}")
    rc, out = run_rc(dev, "cloud_migrate_layout --check")
    failures += not check(rc == 3 and "nothing to move" in out,
                          "the migration check calls the chosen sibling layout current",
                          f"exit {rc}: {out.strip()[-200:]!r}")
    dev.run(f"rm -f {shlex.quote(f'{bk_dir}/{bk_name}')}; "
            f"cloud_setup --set-saves-remote {shlex.quote(prev['SAVES_REMOTE'] or '/ROCKNIX/Saves')} >/dev/null 2>&1; "
            f"rclone purge {shlex.quote(remote_name + '/QA-Custom')} >/dev/null 2>&1 || true", check=False)
    for k, v in prev.items():
        if v:
            dev.run(f"sed -i 's|^{k}=.*|{k}=\"{v}\"|' {CONF}")

    step("a cloud with no saves folder yet is empty, not broken; a wrong root still fails")
    # #100: the parent decides. Root present and only Saves missing is the
    # everyday shape of a device whose saves were never backed up -- exit 0,
    # a plain line, and the offer EmulationStation turns into CREATE IT.
    # The root itself missing is a wrong setting and must keep failing, or
    # a typo in the folder name would restore nothing and report success.
    # Done on a folder of its own rather than by moving the suite's saves
    # folder aside: the suite's SAVES_REMOTE may sit at the root (/GAMES),
    # where by design there is no parent to tell the two shapes apart.
    prev_saves = dev.run(f"grep -m1 '^SAVES_REMOTE=' {CONF} | cut -d'\"' -f2").strip()
    dev.run(f"sed -i 's|^SAVES_REMOTE=.*|SAVES_REMOTE=\"/QA-Empty/Saves\"|' {CONF}; "
            f"rclone purge {shlex.quote(remote_name + '/QA-Empty')} >/dev/null 2>&1; "
            f"rclone mkdir {shlex.quote(remote_name + '/QA-Empty/Backups')} >/dev/null 2>&1", check=False)
    rc, out = run_rc(dev, "cloud_restore --yes --saves-only")
    failures += not check(rc == 0 and "nothing in your cloud" in out.lower() and ">>> offer create-saves-folder" in out,
                          "root present, Saves absent: exit 0, the plain line, and the offer",
                          f"exit {rc}: {out.strip()[-200:]!r}")
    dev.run(f"sed -i 's|^SAVES_REMOTE=.*|SAVES_REMOTE=\"/QA-No-Such-Root/Saves\"|' {CONF}")
    rc, out = run_rc(dev, "cloud_restore --yes --saves-only")
    failures += not check(rc != 0 and ">>> offer" not in out,
                          f"root absent: the restore fails (exit {rc}) and offers nothing",
                          f"exit {rc}: {out.strip()[-200:]!r}")
    dev.run(f"sed -i 's|^SAVES_REMOTE=.*|SAVES_REMOTE=\"{prev_saves}\"|' {CONF}; "
            f"rclone purge {shlex.quote(remote_name + '/QA-Empty')} >/dev/null 2>&1 || true", check=False)

    step("ROMs and BIOS restore it")
    # Plant at the endpoint directly rather than restoring what the upload
    # step just wrote: otherwise a broken uploader fails this check for the
    # wrong reason and one bug masks the other's status (audit F-03).
    backend("reset")
    stage = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    for rel, data in CONTENT_FIXTURES.items():
        f = os.path.join(stage, CONTENT_DIR, rel)
        os.makedirs(os.path.dirname(f), exist_ok=True)
        open(f, "wb").write(data)
    # The current layout: ROMs/<system> under CONTENT_REMOTE (D-CLOUD-018);
    # the restorer reads the flat pre-ROMs layout too, but the fixture is the
    # shape a backup writes today.
    cpath = epath(backend("content-remote"))
    backend("put", os.path.join(stage, CONTENT_DIR), f"{cpath}/ROMs/{CONTENT_DIR}")
    dev.run(f"rm -rf {shlex.quote(croot)}")
    failures += not check(not dev.sha(f"{croot}/{list(CONTENT_FIXTURES)[0]}"),
                          "local content removed before restore",
                          "local content still present")
    dev.run(f"cloud_content_restore {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    cafter = {rel: dev.sha(f"{croot}/{rel}") for rel in CONTENT_FIXTURES}
    csame = [r for r in CONTENT_FIXTURES if cbefore[r] and cbefore[r] == cafter[r]]
    failures += not check(len(csame) == len(CONTENT_FIXTURES),
                          f"all {len(CONTENT_FIXTURES)} content files restored byte-identical",
                          f"only {len(csame)}/{len(CONTENT_FIXTURES)} matched")

    dev.run(f"rm -rf {shlex.quote(croot)}")

    # --- tier boundaries ----------------------------------------------------
    # The regression test for blindspot 21. Content sync and the saves sync
    # both operate over /storage/roms; a save file living next to a ROM must
    # be carried by the saves tier and NOT by content. This existed as a
    # defect for a day and was caught by a human reading an upload listing,
    # not by this harness.
    step("a save file inside a system directory does not reach the ROMs and BIOS tier")
    backend("reset")
    dev.write(f"{croot}/Some Game.srm", b"battery save, saves tier owns this")
    dev.write(f"{croot}/Some Game.rom", b"a rom, content tier owns this")
    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    listing = backend("ls")
    # Both directions, or the assertion cannot fail: the ROM proves the
    # transfer ran at all, the .srm proves the exclusion bit.
    failures += not check("Some Game.rom" in listing,
                          "the ROM reached the content tier",
                          "the ROM did not transfer - exclusion cannot be judged")
    failures += not check("Some Game.srm" not in listing,
                          "the save file was correctly withheld from content",
                          "SAVE DATA REACHED THE CONTENT TIER (blindspot 21)")

    # A sync conflict is another client's dispute, and moving it makes it
    # immortal: a device that downloads one uploads it again, so deleting it
    # in the cloud looks like the provider putting it back. 271 directories of
    # BIOS were resurrected exactly that way on 2026-09-04.
    step("a sync-conflict artifact is carried by no tier, in either direction")
    backend("reset")
    conflict_dir = "Machines (Someone's conflicted copy 2026-09-03)"
    dev.write(f"{croot}/Real.rom", b"content tier owns this")
    dev.write(f"{croot}/{conflict_dir}/dup.rom", b"dropbox left this behind")
    dev.write(f"{croot}/Other.sync-conflict-20260903-120000-ABCDEF.rom", b"syncthing")
    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    listing = backend("ls")
    # Real.rom first: without it the exclusions below prove nothing, because a
    # transfer that moved nothing at all also mentions no conflicted copy.
    failures += not check("Real.rom" in listing,
                          "the ordinary ROM reached the content tier",
                          "nothing transferred - the exclusions cannot be judged")
    failures += not check("conflicted copy" not in listing,
                          "the conflicted copy was withheld from the cloud",
                          "A CONFLICTED COPY WAS UPLOADED (D-CLOUD-022)")
    failures += not check("sync-conflict" not in listing,
                          "the Syncthing conflict file was withheld",
                          "A .sync-conflict FILE WAS UPLOADED (D-CLOUD-022)")
    # And it must not count as content this device holds, or the picker's
    # badge reports a size the cloud will never agree with.
    sizes = dev.run("cloud_content_backup --list-sizes 2>/dev/null || true")
    failures += not check("conflicted copy" not in sizes,
                          "--list-sizes ignores conflict artifacts",
                          "--list-sizes counted a conflicted copy as content")

    # gamelist.xml is shared metadata with a per-device tail. It rides in its
    # own --update pass so the freshest list wins rather than whoever ran last:
    # a device that scans its own ROMs and uploads before ever restoring would
    # otherwise push a thin list over a rich one.
    step("gamelist.xml moves with game content, newest-first, in its own pass")
    # The game list is game content (D-CLOUD-049): it moves only when game
    # content is in scope, so this step runs --with-media, and restores
    # --selected with a selection that exists.
    backend("reset")
    dev.write(f"{croot}/Real.rom", b"content")
    dev.write(f"{croot}/gamelist.xml", b"<gameList><game><path>./Real.rom</path></game></gameList>")
    dev.run(f"cloud_content_restore --set-systems {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true", check=False)
    dev.run(f"cloud_content_backup --with-media {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    failures += not check("Real.rom" in listing,
                          "the ROM reached the content tier",
                          "nothing transferred - the gamelist assertions cannot be judged")
    failures += not check("gamelist.xml" in listing,
                          "the gamelist reached the cloud in its own pass",
                          "gamelist.xml was not uploaded at all")

    # Now make the local copy newer and poorer, and restore: --update must
    # refuse to overwrite it.
    dev.write(f"{croot}/gamelist.xml", b"<gameList><!--LOCAL-NEWER--></gameList>")
    # Unmistakably newer: on a fast guest the upload and this write land in
    # the same second, WebDAV keeps one-second modtimes, and --update falls
    # back to size when times are equal -- which is not the case under test.
    # busybox touch takes "YYYY-MM-DD hh:mm:ss", not @epoch; the arithmetic runs on the device.
    dev.run(f'touch -d "$(date -d @$(( $(date +%s) + 120 )) \'+%Y-%m-%d %H:%M:%S\')" {shlex.quote(croot)}/gamelist.xml')
    dev.run(f"rm -f {shlex.quote(croot)}/Real.rom")
    dev.run("sync", check=False)
    _, out = run_rc(dev, "cloud_content_restore --with-media --selected")
    ok, items, detail = unit_protocol(out)
    failures += not check(ok and CONTENT_DIR in items,
                          f"--selected announced every unit it moved, numbered across the run ({detail})",
                          f"the unit markers do not add up to the run (#95): {detail}")
    # The restore must have done something before "the local one survived"
    # means anything: the ROM removed above is back.
    failures += not check(bool(dev.sha(f"{croot}/Real.rom")),
                          "the restore ran (the removed ROM is back)",
                          "the restore transferred nothing - the gamelist assertion below would pass for the wrong reason")
    local = dev.run(f"cat {shlex.quote(croot)}/gamelist.xml 2>/dev/null || true")
    failures += not check("LOCAL-NEWER" in local,
                          "a newer local gamelist survived the restore",
                          "RESTORE CLOBBERED A NEWER LOCAL GAMELIST (--update not applied)")

    # Three callers can start a cloud sync -- boot, game exit, the menu -- and
    # until 2026-09-04 nothing stopped two from running at once. The lock lives
    # in the scripts, so this test is caller-agnostic: hold it, then ask.
    step("a second cloud sync while one runs is refused, exits 75, and stamps nothing")
    dev.run("rm -f /storage/.cache/cloud_sync/last-backup", check=False)
    out = dev.run(
        "exec 9>/var/run/cloud_sync.lock; flock -n 9 || echo HOLDER-FAILED; "
        "cloud_backup --yes >/tmp/second.out 2>&1; echo rc=$?; "
        "exec 9>&-", check=False)
    failures += not check("HOLDER-FAILED" not in out,
                          "the test could hold the lock itself",
                          "could not take the lock to set up the test")
    failures += not check("rc=75" in out,
                          "the second sync exited 75 (EX_TEMPFAIL, the lock sentinel)",
                          f"expected exit 75 while the lock was held, got: {out.strip()[-40:]}")
    second = dev.run("cat /tmp/second.out 2>/dev/null || true")
    failures += not check("already running" in second.lower(),
                          "and said another sync was running",
                          "exit 75 without the message somebody would read")
    failures += assert_message(second, 75, args.vocabulary, label="the refusal: ")
    stamp = dev.run("cat /storage/.cache/cloud_sync/last-backup 2>/dev/null || echo NONE")
    failures += not check(stamp.strip() == "NONE",
                          "no last-run stamp was written for work that did not happen",
                          "A SKIPPED SYNC STAMPED A LAST-RUN (would read as success/failure)")

    # The game-exit sync runs cloud_backup --yes --saves-only --recent: only
    # what changed since the last backup that worked, no remote probe, no
    # tidy, and exit 69 at once when there is no network. Each is a claim a
    # player waits on after every game, so each is asserted here -- against
    # the script's own log, because "fast" is not observable from a listing.
    step("a --recent sync with nothing changed leaves the remote alone")
    dev.run("cloud_backup --yes --saves-only >/dev/null 2>&1 || true", check=False)  # a success to measure from
    mark = dev.run("wc -l < /var/log/cloud_sync.log 2>/dev/null || echo 0").strip() or "0"
    out = dev.run("cloud_backup --yes --saves-only --recent >/dev/null 2>&1; echo rc=$?", check=False)
    tail = dev.run(f"tail -n +{int(mark) + 1} /var/log/cloud_sync.log 2>/dev/null || true")
    failures += not check("rc=0" in out, "the recent sync exited 0",
                          f"recent sync failed: {out.strip()[-40:]}")
    failures += not check("--max-age" in tail and "--no-traverse" in tail,
                          "rclone was given a recency window and told not to list the remote",
                          "--recent did not narrow the copy (no --max-age/--no-traverse in the log)")
    failures += not check("nothing to transfer" in tail.lower(),
                          "and found nothing to move",
                          "a recent sync with nothing changed transferred something")
    failures += not check("Ensuring remote sync path" not in tail and "Removing orphaned" not in tail,
                          "no probe and no tidy round trips were made",
                          "a recent sync still probed or tidied the remote")

    step("a --recent sync after one save is written pushes that file")
    dev.write(f"{root}/savestates/recent-probe.state", b"recent")
    dev.run("sync", check=False)
    mark = dev.run("wc -l < /var/log/cloud_sync.log 2>/dev/null || echo 0").strip() or "0"
    out = dev.run("cloud_backup --yes --saves-only --recent >/dev/null 2>&1; echo rc=$?", check=False)
    tail = dev.run(f"tail -n +{int(mark) + 1} /var/log/cloud_sync.log 2>/dev/null || true")
    failures += not check("rc=0" in out and "recent-probe.state" in backend("ls"),
                          "the new save reached the bucket",
                          "the save written after the last sync did not reach the bucket")
    failures += not check("Transferred:            1 / 1" in tail,
                          "and it was the only file transferred",
                          "more than one file moved for one changed save")

    step("with no network the exit sync returns 69 at once and stamps nothing")
    out = dev.run(
        "mkdir -p /tmp/noroute && printf '#!/bin/sh\nexit 0\n' > /tmp/noroute/ip && chmod +x /tmp/noroute/ip; "
        "s0=$(cat /storage/.cache/cloud_sync/last-backup 2>/dev/null); "
        "t0=$(date +%s%N); PATH=/tmp/noroute:$PATH cloud_backup --yes --saves-only --recent >/tmp/qa-noroute.out 2>&1; "
        "rc=$?; t1=$(date +%s%N); s1=$(cat /storage/.cache/cloud_sync/last-backup 2>/dev/null); "
        "echo rc=$rc ms=$(( (t1 - t0) / 1000000 )) stamp=$([ \"$s0\" = \"$s1\" ] && echo same || echo CHANGED); "
        "rm -rf /tmp/noroute", check=False)
    fields = dict(kv.split("=", 1) for kv in out.split() if "=" in kv)
    failures += not check(fields.get("rc") == "69", "exit 69 (EX_UNAVAILABLE, the no-network sentinel) with no default route",
                          f"expected exit 69 without a route, got: {out.strip()}")
    failures += not check(fields.get("ms", "99999").isdigit() and int(fields.get("ms", "99999")) < 2000,
                          "and it answered in under two seconds",
                          f"took {fields.get('ms')} ms to notice there was no network")
    failures += not check(fields.get("stamp") == "same",
                          "no last-run stamp was written for work that did not happen",
                          "A NO-NETWORK SKIP STAMPED A LAST-RUN")
    failures += assert_message(dev.run("cat /tmp/qa-noroute.out 2>/dev/null || true", check=False),
                               int(fields["rc"]) if fields.get("rc", "").isdigit() else None, args.vocabulary, label="the no-network skip: ")

    step("every EmulationStation system path is carried by exactly one tier")
    # The complement of the rule above: a path in NO tier is silent data loss
    # on restore. Four were found this way (gmu/playlists, idtech, modules,
    # scummvm/games) after a ScummVM player would have lost their entries.
    orphans = dev.run(
        "C=$(ls /storage/.config/emulationstation/es_systems.cfg "
        "/usr/config/emulationstation/es_systems.cfg 2>/dev/null | head -1); "
        "B=$(command -v backuptool); "
        "grep -oP '(?<=<path>)[^<]+' \"$C\" | sort -u | while read -r p; do "
        "  case \"$p\" in /storage/roms/*) continue ;; esac; "
        "  grep -qF \"$p\" \"$B\" || echo \"$p\"; "
        "done").split()
    failures += not check(not orphans,
                          "every ES path outside /storage/roms is in the settings backup",
                          f"carried by no tier: {' '.join(orphans)}")

    # --- archive format -----------------------------------------------------
    step("the settings archive is a tar archive named for this device, and every reader finds it")
    # A real archive, written by backuptool where the conf says archives live.
    dev.run("backuptool backup >/dev/null 2>&1 || true", check=False)
    # backuptool's own finder, not a copy of its globs: what RESTORE SETTINGS
    # FROM THIS DEVICE will apply is what this asserts. The script is resolved
    # BEFORE /etc/profile is sourced, because the profile rewrites PATH and
    # would drop the --path-prefix directory; the profile is sourced at all
    # because the script itself does, and its globs are built on OS_NAME,
    # which an ssh session does not have.
    finder = finder_cmd       # module-level since the KILL cells use it too
    newest_cmd = finder('"$(command -v backuptool)"')
    newest = dev.run(newest_cmd, check=False).strip()
    failures += not check(newest.endswith(".tar.gz"),
                          f"newest archive is a tar.gz ({os.path.basename(newest) or 'none'})",
                          f"newest archive is not a tar.gz: {newest or 'none found'}")
    if newest:
        failures += not check(dev.run(f"tar -tzf {shlex.quote(newest)} >/dev/null 2>&1 && echo ok", check=False).strip() == "ok",
                              "the archive passes tar integrity",
                              "the archive is not readable by tar")
    # The device's name sits between the stamp and ROCKNIX (2026-09-08): two
    # handhelds' archives used to be told apart by nothing.
    label = dev.run("cloud_device_id --label 2>/dev/null || true").strip()
    osn = os_name(dev)
    named = bool(label) and re.fullmatch(
        rf"\d{{4}}_\d{{2}}_\d{{2}}-\d{{6}}-{re.escape(label)}-{re.escape(osn)}_SETTINGS\.tar\.gz",
        os.path.basename(newest)) is not None
    failures += not check(named,
                          f"the archive is named for this device, between the date and {osn} ({label or 'no label'})",
                          f"the archive does not carry this device's name between the date and {osn}: "
                          f"{os.path.basename(newest) or 'none'} (label {label or 'none'})")
    # In the MIDDLE, so that the finder every image already carries --
    # *-ROCKNIX_SETTINGS.tar.gz -- still matches. The installed backuptool is
    # asked through its own function: on a device running an image from
    # before the label, that is an older reader finding a new archive, which
    # a first cut of this change broke (review, 2026-09-08). Where the
    # installed script is itself the one under test, this holds trivially.
    installed = dev.run(finder("/usr/bin/backuptool"), check=False).strip()
    failures += not check(bool(newest) and installed == newest,
                          "the installed image's own backuptool finds the same archive",
                          f"the installed backuptool's finder got {os.path.basename(installed) or 'nothing'}, "
                          f"not {os.path.basename(newest) or 'none'}")
    # Every device in the field has archives from before names carried a
    # device. A newer one of those must still be found.
    legacy = f"{os.path.dirname(newest) if newest else f'{root}/backup'}/2099_12_31-235959-{osn}_BACKUP.zip"
    dev.run(f": > {shlex.quote(legacy)}")
    found = dev.run(newest_cmd, check=False).strip()
    dev.run(f"rm -f {shlex.quote(legacy)}")
    failures += not check(found == legacy,
                          "a newer archive under the pre-label name is still found",
                          f"the finder skipped a pre-label archive: got {os.path.basename(found) or 'none'}")

    # --- per-device system selection ---------------------------------------
    step("content transfers honour the system selection")
    dev.run(f"cloud_content_restore --set-systems {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    sel = dev.run("cloud_content_restore --systems 2>/dev/null || true").split()
    failures += not check(sel == [CONTENT_DIR],
                          f"selection persisted as {sel}",
                          f"selection did not round-trip: {sel}")
    # A selection of exactly one directory must exclude a second one that
    # also has content - otherwise "only selected" is untested.
    other = f"{CONTENT_DIR}-unselected"
    dev.write(f"/storage/roms/{other}/game.rom", b"should not be uploaded")
    backend("reset")
    _, out = run_rc(dev, "cloud_content_backup --selected")
    ok, items, detail = unit_protocol(out)
    listing = backend("ls")
    failures += not check("game.rom" not in listing,
                          "an unselected system was not uploaded",
                          "an UNSELECTED system was uploaded")
    failures += not check(ok and CONTENT_DIR in items and other not in items,
                          f"--selected announced the selected units and only those, numbered across the run ({detail})",
                          f"the unit markers do not add up to the run (#95): {detail}")
    # The match flow numbers its items the same way, and every chosen system
    # is one -- including one with nothing to do. Until 2026-09-09 such a
    # system was skipped without an announcement while n still counted it,
    # so a run over three systems ended on ITEM 2 OF 3 (#95). `ghost` exists
    # in neither the cloud nor the device: its plan is `none`.
    ghost = "ghost-never-a-system"
    dev.run(f"cloud_content_restore --set-systems {shlex.quote(CONTENT_DIR)} {ghost} >/dev/null 2>&1 || true", check=False)
    rc, out = run_rc(dev, "cloud_content_restore --match --apply")
    ok, items, detail = unit_protocol(out)
    failures += not check(rc == 0 and ok and sorted(items) == sorted([CONTENT_DIR, ghost]),
                          f"--match --apply announced both chosen systems as ITEM i OF 2, the one with nothing to do included ({detail})",
                          f"exit {rc}; {detail}; tail {out.strip()[-160:]!r}")
    failures += not check(f"Nothing to remove from {ghost}" in out,
                          "and said so for the system that already matches",
                          "no 'Nothing to remove' line for the system with nothing to do")
    dev.run(f"rm -rf /storage/roms/{shlex.quote(other)}")
    dev.run("rm -f /storage/.cache/cloud_sync/content-systems")

    step("a system this device cannot run is marked unsupported")
    # Plant a cloud directory for a system absent from es_systems.cfg.
    backend("reset")
    stage2 = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    os.makedirs(f"{stage2}/ROMs/definitely-not-a-system", exist_ok=True)
    open(f"{stage2}/ROMs/definitely-not-a-system/x.rom", "wb").write(b"x")
    cpath2 = epath(backend("content-remote"))
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    # name|cloud_bytes|supported|device_bytes|... -- the third field, not the tail
    failures += not check(bool(row) and row[0].split("|")[2:3] == ["0"],
                          "the unrunnable system is flagged 0 (unsupported)",
                          f"scan did not mark it unsupported: {row or 'row absent'}")
    # The comparison fields (2026-09-08): x.rom is one byte the device lacks;
    # y.rom is one byte in the cloud and two here, so it is "not here" at the
    # cloud's size and "not in the cloud" at the device's. Names alone would
    # have called y.rom present on both sides. Expected, by planted sizes:
    # cloud 2 bytes, unsupported, device 2 bytes, 2 files/2 bytes to restore,
    # 1 file/2 bytes to back up.
    open(f"{stage2}/ROMs/definitely-not-a-system/y.rom", "wb").write(b"y")
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    dev.write("/storage/roms/definitely-not-a-system/y.rom", b"yy")
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["2", "0", "2", "2", "1", "2", "2"],
                          "the scan says what a copy each way would move, in files and bytes",
                          f"scan fields 2-8 were not 2|0|2|2|1|2|2: {row or 'row absent'}")
    # The game list is sized, never compared (2026-09-08): three bytes in the
    # cloud, five on the device. Under ROMs alone neither side lists a
    # system's own list, so the row is what it was; under game content each
    # total grows by its list and every comparison field stays put, since
    # the list's direction is a modtime the scan does not have.
    open(f"{stage2}/ROMs/definitely-not-a-system/gamelist.xml", "wb").write(b"ccc")
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    dev.write("/storage/roms/definitely-not-a-system/gamelist.xml", b"ddddd")
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["2", "0", "2", "2", "1", "2", "2"],
                          "under ROMs alone the game list is neither sized nor counted",
                          f"scan fields 2-8 were not 2|0|2|2|1|2|2 with a game list present: {row or 'row absent'}")
    scan = dev.run("cloud_content_restore --scan --with-media 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["5", "0", "7", "2", "1", "2", "2"],
                          "under game content the game list is sized on each side and never counted as moving",
                          f"scan fields 2-8 were not 5|0|7|2|1|2|2: {row or 'row absent'}")
    dev.run("rm -rf /storage/roms/definitely-not-a-system")

    step("a scan the cloud refused exits with rclone's code and lists nothing")
    # The network is up and the cloud is not: the stanza's endpoint moved to a
    # port nothing listens on, on the same host. This is the case the scan's
    # network probe must not read as "no network" (that is LINK7's 69) and
    # must not read as an empty cloud either -- it did, and the picker listed
    # every system on the device as "not yet in your cloud" (2026-09-10).
    good_conf = dev.run(f"cat {RCLONE_CONF}")
    dev.run("sed -i -E 's#^((url|endpoint) *= *[a-z]+://[^:/ ]+)(:[0-9]+)?#\\1:1#' " + RCLONE_CONF)
    moved = dev.run(f"grep -E '^(url|endpoint)' {RCLONE_CONF} || true").strip()
    rc, out = run_rc(dev, "cloud_content_restore --scan")
    dev.write(RCLONE_CONF, good_conf.encode())
    rows = [l for l in out.splitlines() if l.count("|") >= 2]
    failures += not check(":1" in moved, "the stanza's endpoint was moved to a closed port",
                          f"the sed did not rewrite the endpoint: {moved!r}")
    failures += not check(rc not in (0, 69) and not rows,
                          f"the scan exited {rc} with no system lines",
                          f"exit {rc} with {len(rows)} system line(s): a refused cloud read as an empty one")
    rc, out = run_rc(dev, "cloud_content_restore --scan")
    failures += not check(rc == 0 and any(l.count("|") >= 2 for l in out.splitlines()),
                          "with the stanza restored the scan lists systems again (exit 0)",
                          f"exit {rc} after restoring the stanza: {out.strip()[-120:]!r}")

    # --- folder seeding -----------------------------------------------------
    step("seeding is idempotent and never clobbers an existing note")
    dev.run("cloud_setup --seed-folders >/dev/null 2>&1 || true", check=False)
    dev.run("true")
    marker = b"OWNER WROTE THIS"
    stage3 = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    open(f"{stage3}/README.txt", "wb").write(marker)
    spath = epath(backend("saves-remote"))
    subprocess.run([BACKEND, "put", stage3, spath], capture_output=True, text=True)
    second = dev.run("cloud_setup --seed-folders 2>/dev/null || true")
    failures += not check(second.count("OK ") >= 2,
                          "a second seeding run reports the folders present",
                          f"second run did not report folders: {second.strip()[:80]}")
    note = subprocess.run([BACKEND, "cat", f"{spath}/README.txt"], capture_output=True).stdout
    failures += not check(note == marker,
                          "the owner's note survived a second seeding",
                          f"the note was replaced: {note[:40]!r}")

    step("an older config's keys are carried across (D-UI-022, A12)")
    # A conf shaped like one from before #73 -- old names, no new ones, and a
    # RESTOREPATH equal to BACKUPPATH (the legal shape; the unequal one is a
    # refusal, A12 proper). The helper carries every value to its new name.
    saved_conf = dev.run(f"cat {CONF}")
    old_conf = "\n".join([
        'BACKUPPATH="/storage/qa-old-saves"', 'BACKUPFOLDER="/storage/qa-old-saves/backup"',
        'RESTOREPATH="/storage/qa-old-saves"', 'SYNCPATH="/QA-OLD"', 'SYNCPATH_BACKUP="/QA-OLD-BACKUPS"',
        'CONTENTPATH="/QA-OLD-CONTENT"', ""])
    dev.write(CONF, old_conf.encode())
    dev.run("cloud_sync_helper >/dev/null 2>&1 || true", check=False)
    migrated = dev.run(f"cat {CONF}")
    carried = {"SAVESPATH": "/storage/qa-old-saves", "SETTINGS_BACKUPS": "/storage/qa-old-saves/backup",
               "SAVES_REMOTE": "/QA-OLD", "SETTINGS_REMOTE": "/QA-OLD-BACKUPS", "CONTENT_REMOTE": "/QA-OLD-CONTENT"}
    missing = [k for k, v in carried.items() if f'{k}="{v}"' not in migrated]
    failures += not check(not missing, "every old key reached its new name with its value",
                          f"not carried: {missing}")
    dev.write(CONF, saved_conf.encode())

    # The one-record assertion over everything the suite touched (#105).
    step("one last-known-good of every record, and no writer's litter, after the suite")
    failures += litter_scan(dev, settings, remote)
    return failures


