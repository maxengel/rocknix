#!/usr/bin/env python3
"""Round-trip the cloud-sync scripts against the local QA S3 backend.

Drives a ROCKNIX device over SSH - a VM from generic-x64-vm, or real hardware
on the LAN - through backup, restore and content sync, and checks the result
from both ends: file contents on the device, and objects in the bucket.

    ./tools/cloud-test-backend up
    ./tools/cloud-round-trip --host root@127.0.0.1 --port 10022
    ./tools/cloud-round-trip --host root@127.0.0.1 --port 10022 --second-port 10023 \
        --identity /tmp/rocknix-vm-pair/qa-key          # the VM pair: two devices, one cloud

With --second-port the two-device fixtures of #35 run after the single-device
suite (--only A1,A9 runs just those): a conflict is a change on both sides
since two devices last agreed, and only a pair can make one (D-QA-009).

    ./tools/cloud-round-trip --host root@127.0.0.1 --port 10022 --identity ... \
        --path-prefix /tmp/qa-bin --only CAP1,CAP2,CAP3,CAP4,CAP5,CAP6,CAP7,CAP8,CAP9,CAP10

--only CAP1..CAP10 runs #21's capture fixtures against a staged cloud_capture
on one device with no cloud at all -- no MinIO, no remote, no second guest
(see the capture section below for what to stage). --only A15 runs #86's
identity fixture: one device and the QA endpoint, no second guest. --list
prints every registry without touching a device.

Two guards, both load-bearing:

* Every cloud_* script picks its remote with `rclone listremotes | head -1`.
  If the device has another remote sorting earlier, the tests would sync a
  real cloud account instead. The remote is asserted, never assumed.
* Restore is destructive by design. The suite works in a scratch tree by
  default and only touches /storage/roms with --real-roms, so pointing this
  at a device with real saves cannot quietly delete them.
"""

import argparse
import hashlib
import json
import os
import re
import shlex
import subprocess
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
BACKEND = os.path.join(HERE, "cloud-test-backend")

SCRATCH = "/storage/cloud-qa"
CONF = "/storage/.config/cloud_sync.conf"
RCLONE_CONF = "/storage/.config/rclone/rclone.conf"

# Content chosen to catch the failure modes that have actually bitten:
# a nested path, a name with a space (quoting), and a file the allowlist
# must exclude - the filter is what stands between --delete-excluded and
# somebody's cloud data.
FIXTURES = {
    "saves/game1.srm": b"save-one-v1",
    "saves/nested/deep/game2.srm": b"save-two-v1",
    "saves/game with space.srm": b"save-three-v1",
    "savestates/game1.state": b"state-one-v1",
}
EXCLUDED = {"saves/scratch.tmp": b"should-never-leave-the-device"}

# Content sync is a different code path: whole directories of ROMs and BIOS,
# not allowlisted save files. Its directory is created and removed by the test
# and named so it is obvious what it is if a run is interrupted.
# The settings-backup archive: phase 2 of both scripts. Nothing exercised this
# until it was found broken - cloud_restore filtered on "backup/*.zip" while
# the archive sits at the root of SETTINGS_REMOTE, so it restored nothing and
# still reported SUCCESS. A silent no-op is exactly what a round-trip catches.
# A dated name, because the uploader dates an undated one on the way up
# (ROCKNIX-backup-qa.zip went up as 2026_09_06-180107-ROCKNIX-backup-qa.zip)
# and the restorer brings the dated name back -- a harness looking for its
# own undated path on either side saw nothing (Gate 0, #35).
# The pre-label shape, on purpose. Since 2026-09-08 backuptool writes
# <stamp>-<device>-ROCKNIX_SETTINGS.tar.gz, and every device in the field
# still holds archives named ROCKNIX_ locally and in the cloud; this one
# stands for those, so the round trip proves the upgrade path -- an unlabelled
# archive is still uploaded, and still comes back through the restorer's
# newest-overall fallback. The labelled shape is asserted on the archive
# backuptool itself writes, and the retention step plants both shapes side by
# side.
ARCHIVE_NAME = "2026_01_01-000000-ROCKNIX_SETTINGS.tar.gz"
ARCHIVE_BODY = b"settings-backup-archive-v1"
# Deliberately the same length as ARCHIVE_BODY. A remote with no modtimes and
# no hashes leaves rclone comparing by size alone, so a second archive of
# identical size was silently never uploaded while the run reported success
# (#53). The real archive is ~17 MB of OS-shipped assets around a few KB of
# config, so an ordinary settings change routinely preserves its size --
# "preamp=7" -> "preamp=8" is the same width. Only a second backup against an
# already-populated remote can catch it; the first one always transfers.
ARCHIVE_BODY_V2 = b"settings-backup-archive-v2"
assert len(ARCHIVE_BODY_V2) == len(ARCHIVE_BODY)

# A system EmulationStation declares (D-CLOUD-019): the content tier lists
# only those. Vectrex, because nobody's library is likely to be there -- and
# the harness refuses to run if it is (see the content step).
CONTENT_DIR = "vectrex"
CONTENT_FIXTURES = {
    "rom1.bin": b"rom-one",
    "sub/rom2.bin": b"rom-two",
    "rom with space.bin": b"rom-three",
}


class Fail(Exception):
    pass


class Device:
    def __init__(self, host, port, identity=None, path_prefix=None):
        # --path-prefix: a directory on the device put first on PATH for every
        # command, so a script fixed on the host can be proven against the
        # suite before an image carries it (the VM tests it first, D-QA-007).
        self.path_prefix = path_prefix
        self.host, self.port = host, port
        # One multiplexed connection per device: a fixture makes hundreds of
        # calls, and a fresh handshake costs ~90 ms against ~5 ms over the
        # control socket. Its path must stay under 108 bytes, which rules
        # out any scratch directory, so it lives in /tmp.
        self.base = ["ssh", "-o", "StrictHostKeyChecking=no",
                     "-o", "UserKnownHostsFile=/dev/null",
                     "-o", "LogLevel=ERROR",
                     "-o", "ControlMaster=auto", "-o", f"ControlPath=/tmp/crt-{os.getuid()}-%C",
                     "-o", "ControlPersist=120", "-p", str(port)]
        if identity:
            self.base += ["-i", identity]
        self.base.append(host)

    def run(self, cmd, check=True):
        if self.path_prefix:
            cmd = f"PATH={shlex.quote(self.path_prefix)}:$PATH; " + cmd
        p = subprocess.run(self.base + [cmd], capture_output=True, text=True)
        if check and p.returncode != 0:
            raise Fail(f"{cmd!r} exited {p.returncode}: {p.stderr.strip() or p.stdout.strip()}")
        return p.stdout

    def write(self, path, data: bytes):
        self.run(f"mkdir -p {shlex.quote(os.path.dirname(path))}")
        p = subprocess.run(self.base + [f"cat > {shlex.quote(path)}"],
                           input=data, capture_output=True)
        if p.returncode != 0:
            raise Fail(f"writing {path}: {p.stderr.decode().strip()}")

    def sha(self, path):
        out = self.run(f"sha256sum {shlex.quote(path)} 2>/dev/null || true")
        return out.split()[0] if out.strip() else None


def backend(*args):
    return subprocess.run([BACKEND, *args], capture_output=True, text=True,
                          check=True).stdout


def step(name):
    print(f"\n=== {name}")


def check(cond, ok, bad):
    print(f"    {'PASS' if cond else 'FAIL'}  {ok if cond else bad}")
    return cond


class Prepared:
    """A device the harness has pointed at the QA endpoint, and what it
    looked like before, so it can be put back whatever happens."""

    def __init__(self, dev):
        self.dev = dev
        self.settings = {}
        self.prev_paths = {}
        self.prev_rclone_conf = ""
        # A capture-only run (prepare_local) reads no rclone.conf and asks the
        # backend for nothing; restore_device must then put back neither.
        self.local_only = False


def prepare_device(dev, remote, root, args, prepared, which=""):
    """Point one device at the QA endpoint. It is appended to `prepared` as
    soon as its previous state is captured -- before anything is written --
    so the block that restores devices covers it even if this raises."""
    p = Prepared(dev)
    step(f"device {which}reachable and equipped")
    who = dev.run("echo ok", check=False).strip()
    if not check(who == "ok", "ssh works", "no shell over ssh"):
        raise Fail(f"no shell over ssh on {dev.host} port {dev.port}")
    have = dev.run("command -v rclone cloud_backup cloud_restore || true")
    check("rclone" in have and "cloud_backup" in have,
          "rclone and cloud scripts present",
          "device is missing rclone or the cloud scripts")

    step(f"point device {which}at the QA bucket" if which else "point the device at the QA bucket")
    # The device's own remote comes back at the end: a device the suite has
    # finished with has the remote it started with (Gate 0, #35).
    p.prev_rclone_conf = dev.run(f"cat {RCLONE_CONF} 2>/dev/null || true")
    for key in ("SAVESPATH", "SETTINGS_BACKUPS", "SAVES_REMOTE", "SETTINGS_REMOTE", "CONTENT_REMOTE",
                "BACKUPPATH", "BACKUPFOLDER", "SYNCPATH", "SYNCPATH_BACKUP", "CONTENTPATH"):
        p.prev_paths[key] = dev.run(f"grep -m1 '^{key}=' {CONF} 2>/dev/null || true").strip()
    prepared.append(p)
    dev.run(f"mkdir -p {os.path.dirname(RCLONE_CONF)}")
    dev.write(RCLONE_CONF, backend("rclone-conf").encode())
    first = dev.run("rclone listremotes 2>/dev/null | head -1").strip().rstrip(":")
    if not check(first == remote,
                 f"first remote is {remote!r}, which is what the scripts will use",
                 f"first remote is {first!r}, not {remote!r} - refusing to sync "
                 f"someone else's account"):
        raise Fail("refusing to sync someone else's account")

    settings = {}
    if not args.real_roms:
        # Keep the scripts' own defaults for everything except where they
        # read and write, so the code under test is unchanged.
        dev.run(f"mkdir -p {SCRATCH}")
        # Remember what these were. Pointing a device at a scratch tree and
        # leaving it there means its next real backup silently captures
        # nothing -- the failure this suite exists to catch, caused by the
        # suite. Found when a later manual run reported "Backup folder
        # /storage/cloud-qa/backup does not exist" on a device the test had
        # finished with.
        settings.update({"SAVESPATH": SCRATCH,
                         "SETTINGS_BACKUPS": f"{SCRATCH}/backup"})

    # A bucket-based endpoint needs the bucket as the first path component,
    # and the shipped "/GAMES" is not a legal bucket name (issue #38). The
    # backend states what it needs rather than the driver assuming.
    syncpath = backend("saves-remote").strip()
    settings["SAVES_REMOTE"] = syncpath
    # A SIBLING of syncpath, not a child. Phase 1 syncs syncpath with
    # --delete-excluded and the archive is excluded, so a nested path gets
    # deleted there; a full run masks it because phase 2 re-uploads, but a
    # --saves-only run deletes the archives and puts nothing back.
    settings["SETTINGS_REMOTE"] = backend("settings-remote").strip()
    # cloud_content_* default to the remote root, which on a bucket-based
    # endpoint means a bucket per content directory (#38, same cause).
    settings["CONTENT_REMOTE"] = backend("content-remote").strip()

    # An image that has not renamed its keys (before #73) reads the old
    # names; write what the scripts on this device actually read
    # (D-UI-022, read-old-if-new-absent -- from the harness's side).
    old_names = {"SAVESPATH": "BACKUPPATH", "SETTINGS_BACKUPS": "BACKUPFOLDER",
                 "SAVES_REMOTE": "SYNCPATH", "SETTINGS_REMOTE": "SYNCPATH_BACKUP",
                 "CONTENT_REMOTE": "CONTENTPATH"}
    new_keys = "SAVES_REMOTE" in dev.run("cat $(command -v cloud_backup) 2>/dev/null || true")
    if not new_keys:
        settings = {old_names[k]: v for k, v in settings.items()}
        print("    old key names: this image predates the rename")
    p.prev_paths = {k: v for k, v in p.prev_paths.items() if k in settings}
    apply_settings(dev, settings)
    p.settings = settings
    if not args.real_roms:
        print(f"    scratch tree {SCRATCH} (pass --real-roms to use /storage/roms)")
    print(f"    SAVES_REMOTE {syncpath} on the {backend('backend').strip()} endpoint")
    return p


def assert_two_devices(a, b):
    """Two guests are two devices only if cloud_device_id says so, and every
    two-device fixture rests on that: with one id they would write one
    manifest-<id>.json, one settings folder and one set of agreement records,
    and agree with themselves (blindspot 31's shape). It hashes the permanent
    MAC, and until fork #91 tools/vm-pair started both guests on the profile's
    fixed address -- so both printed one id, and this harness rewrote b's to
    "<id>-second" for the run, which put every pair fixture on an identity the
    harness had invented. Now a shared id stops the run before either device
    is prepared: nothing is written, so there is nothing to put back.

    Runs the tool as the fixtures do (cloud_device_id, on each guest's own
    PATH prefix); an id that cannot be read fails the same way, because a
    check that could not run has not passed."""
    step("the two devices are two devices, not one id twice (#91)")
    ids = [d.run("cloud_device_id 2>/dev/null || true").strip() for d in (a, b)]
    if check(all(ids) and ids[0] != ids[1],
             f"a is {ids[0]}, b is {ids[1]}",
             f"a is {ids[0] or 'no id'}, b is {ids[1] or 'no id'} -- one id, or none, between two devices (#91)"):
        return
    # Which remedy: a blank id is the tool missing or failing, not a clone; a
    # guest pair on one MAC needs `tools/vm-pair up` again (the id is derived
    # from the address and stored on first boot, so clearing the stored one
    # re-derives the same); a pair on two MACs with one id is a stale clone
    # -- A11 writes a's id onto b and puts it back, and an interrupted run
    # can leave it -- and there the stored id is what to clear.
    macs = [d.run("cat /sys/class/net/eth0/address 2>/dev/null || true").strip() for d in (a, b)]
    if not all(ids):
        why = (f"cloud_device_id printed nothing on {'a' if not ids[0] else 'b'}: the tool is missing there or "
               "failed (check `command -v cloud_device_id` on that guest, and --path-prefix)")
    elif macs[0] and macs[0] == macs[1]:
        why = (f"both guests carry the MAC {macs[0]}: this pair predates vm-pair giving guest b its own address; "
               "re-create it with `tools/vm-pair up <img.gz>` (clearing b's stored id alone re-derives the same one)")
    else:
        why = (f"the MACs differ ({macs[0] or '?'} / {macs[1] or '?'}), so b's stored id is a stale clone; "
               f"remove {ID_FILE} on b and run again")
    raise Fail(f"refusing the two-device fixtures: {why} (#91)")


def prepare_local(dev, root, args, prepared):
    """Point one device's saves root at the scratch tree and nothing else: no
    remote, no bucket, no second guest. The capture fixtures (#21) drive a
    producer that opens no socket, so the QA endpoint is never asked for
    anything and the device's rclone.conf is never read -- which is why
    restore_device must not "put back" a remote this prepare never captured
    (as written it deleted the file whenever prev_rclone_conf was blank)."""
    if args.real_roms:
        raise Fail("the capture fixtures empty the saves root between runs; they never run against real ROMs")
    p = Prepared(dev)
    p.local_only = True
    step("device reachable and equipped (local: no cloud)")
    who = dev.run("echo ok", check=False).strip()
    if not check(who == "ok", "ssh works", "no shell over ssh"):
        raise Fail(f"no shell over ssh on {dev.host} port {dev.port}")
    have = dev.run("command -v jq cloud_device_id cloud_saves_root cloud_capture || true")
    check(all(t in have for t in ("jq", "cloud_device_id", "cloud_saves_root")),
          "jq and the sibling helpers present", "device is missing jq, cloud_device_id or cloud_saves_root")
    check("cloud_capture" in have, "cloud_capture resolves (staged by hand under --path-prefix)",
          "cloud_capture does not resolve: stage it into the prefix directory; every fixture will fail its setup")
    step("point the device's saves root at the scratch tree")
    p.prev_paths["SAVESPATH"] = dev.run(f"grep -m1 '^SAVESPATH=' {CONF} 2>/dev/null || true").strip()
    prepared.append(p)
    dev.run(f"mkdir -p {shlex.quote(root)}")
    apply_settings(dev, {"SAVESPATH": root})
    p.settings = {"SAVESPATH": root}
    print(f"    scratch tree {root}; SAVESPATH points at it for the run; no remote is touched")
    return p


def list_fixtures():
    """The registries, for --list: what --only can name, without a device."""
    print("two-device fixtures (need --second-port; --only A1,A9,...):")
    for key, title, _ in PAIR_FIXTURES:
        print(f"  {key:<10}{title}")
    print(f"  {'CONTRACT':<10}#9's transport contract under the reconciler (see --transport)")
    print("\nsingle-device cloud fixtures (one device and the QA endpoint; --only A15):")
    for key, title, _ in SOLO_FIXTURES:
        print(f"  {key:<10}{title}")
    print("\ncapture fixtures (one device, no cloud; --only CAP1,...,CAP10):")
    for key, title, _ in CAPTURE_FIXTURES:
        print(f"  {key:<10}{title}")


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--host", help="ssh target, e.g. root@127.0.0.1 (required unless --list)")
    ap.add_argument("--port", type=int, default=10022)
    ap.add_argument("--identity", help="ssh private key")
    ap.add_argument("--real-roms", action="store_true",
                    help="use /storage/roms instead of a scratch tree (DESTRUCTIVE)")
    ap.add_argument("--keep", action="store_true", help="leave fixtures in place")
    ap.add_argument("--path-prefix", help="a directory on the device to put first on PATH (scripts under test, before an image carries them)")
    ap.add_argument("--second-port", type=int,
                    help="ssh port of a second device -- the VM pair's guest b -- which turns on the two-device fixtures (D-QA-009)")
    ap.add_argument("--second-host", help="ssh target of the second device (default: the same as --host)")
    ap.add_argument("--only", help="run only these fixtures, skipping the single-device suite (comma-separated: A1,A9,CONTRACT "
                    "for the two-device set, which needs --second-port; CAP1..CAP10 for the capture set, one device, no cloud)")
    ap.add_argument("--list", action="store_true", help="print the fixture registries and exit without touching a device")
    ap.add_argument("--transport", default="copy,bisync", help="transports for #9's contract fixtures: copy, bisync, or both (default)")
    ap.add_argument("--bisync-flags", default="", help="extra flags for every rclone bisync run (Gate 11 variants)")
    ap.add_argument("--dump", help="a host directory to write every transport run's raw output into (Gate 11's record)")
    args = ap.parse_args()
    if args.list:
        list_fixtures()
        return 0
    if not args.host:
        ap.error("--host is required")
    if args.real_roms and args.second_port:
        raise Fail("the two-device fixtures rewrite both saves trees; they never run against real ROMs (D-QA-009)")

    cap_keys = {k for k, _, _ in CAPTURE_FIXTURES}
    solo_keys = {k for k, _, _ in SOLO_FIXTURES}
    only = {k.strip().upper() for k in args.only.split(",")} if args.only else None
    # A run naming only capture fixtures needs no MinIO and no second guest:
    # the producer is network-free, so the backend is asked for nothing.
    cap_only = only is not None and only <= cap_keys
    remote = "" if cap_only else backend("remote-name").strip()
    root = "/storage/roms" if args.real_roms else SCRATCH
    devices = [Device(args.host, args.port, args.identity, args.path_prefix)]
    if args.second_port:
        devices.append(Device(args.second_host or args.host, args.second_port, args.identity, args.path_prefix))

    failures = 0
    prepared = []
    archive = f"{root}/backup/{ARCHIVE_NAME}"
    # From the first capture on, every device carries the harness's settings;
    # whatever happens below -- a failing check, an exception, a Ctrl-C --
    # the block after the try puts each one back (Gate 0, #35: a device the
    # harness has finished with has the remote it started with). Found the
    # hard way: a run that aborted on guest b left the QA remote and the QA
    # paths behind.
    try:
        if cap_only:
            first = prepare_local(devices[0], root, args, prepared)
        else:
            if len(devices) > 1:
                assert_two_devices(devices[0], devices[1])
            first = prepare_device(devices[0], remote, root, args, prepared, which="a " if len(devices) > 1 else "")
            if len(devices) > 1:
                prepare_device(devices[1], remote, root, args, prepared, which="b ")
        if not args.only:
            failures += run_steps(first.dev, root, remote, args, first.settings, first.prev_paths)
        if len(prepared) > 1:
            failures += run_pair(prepared[0].dev, prepared[1].dev, root, remote, args, first.settings)
        elif only and only - cap_keys - solo_keys:
            print("\n--only names two-device fixtures; pass --second-port for the VM pair's guest b")
        if only and only & solo_keys:
            failures += run_solo(first.dev, root, remote, args, first.settings, only)
        if only and only & cap_keys:
            failures += run_capture(first.dev, root, args, only)
    finally:
        for p in prepared:
            restore_device(p, args, archive)
    print(f"\n{'PASSED' if failures == 0 else f'{failures} CHECK(S) FAILED'}")
    return 1 if failures else 0


def run_steps(dev, root, remote, args, settings, prev_paths):
    failures = 0
    step("plant fixtures")
    for rel, data in {**FIXTURES, **EXCLUDED}.items():
        dev.write(f"{root}/{rel}", data)
    before = {rel: dev.sha(f"{root}/{rel}") for rel in FIXTURES}
    failures += not check(all(before.values()), "fixtures written",
                          "could not write fixtures")

    step("saves back up to the cloud")
    backend("reset")
    # As BACK UP SAVES TO THE CLOUD runs it: --saves-only, or the settings
    # phase rides along under a saves label (2026-09-06).
    dev.run("cloud_backup --yes --saves-only >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    uploaded = {rel for rel in FIXTURES if os.path.basename(rel) in listing}
    failures += not check(len(uploaded) == len(FIXTURES),
                          f"all {len(FIXTURES)} fixtures reached the bucket",
                          f"only {len(uploaded)}/{len(FIXTURES)} reached the bucket")
    # Only meaningful once something uploaded: if the backup did nothing at
    # all, "the excluded file is absent" is true for the wrong reason and
    # reports a pass over a broken run.
    leaked = [rel for rel in EXCLUDED if os.path.basename(rel) in listing]
    if uploaded:
        failures += not check(not leaked,
                              "the allowlist kept excluded files out of the cloud",
                              f"excluded file(s) uploaded: {leaked}")
    else:
        print("    SKIP  allowlist check - nothing uploaded, so it proves nothing")

    step("saves restore from the cloud")
    for rel in FIXTURES:
        dev.run(f"rm -f {shlex.quote(f'{root}/{rel}')}")
    gone = [rel for rel in FIXTURES if dev.sha(f"{root}/{rel}")]
    failures += not check(not gone, "local copies removed before restore",
                          f"still present: {gone}")
    dev.run("cloud_restore --yes --saves-only >/dev/null 2>&1 || true", check=False)
    after = {rel: dev.sha(f"{root}/{rel}") for rel in FIXTURES}
    same = [rel for rel in FIXTURES if before[rel] and before[rel] == after[rel]]
    failures += not check(len(same) == len(FIXTURES),
                          f"all {len(FIXTURES)} files restored byte-identical",
                          f"only {len(same)}/{len(FIXTURES)} matched: "
                          f"{[r for r in FIXTURES if r not in same]}")

    step("the settings archive round-trips")
    # Off by default, so the phase would otherwise never run here. Remember the
    # device's own setting: leaving it on would mean a later user-initiated
    # restore also pulls archives down, which they never asked for.
    dev.run(f"grep -m1 '^BACKUPFILE_RESTORE_OPTION=' {CONF} > {CONF}.qa-prev 2>/dev/null || : > {CONF}.qa-prev")
    dev.run(f"grep -q '^BACKUPFILE_RESTORE_OPTION=' {CONF} "
            f"&& sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|BACKUPFILE_RESTORE_OPTION=\"yes\"|' {CONF} "
            f"|| echo 'BACKUPFILE_RESTORE_OPTION=\"yes\"' >> {CONF}")
    archive = f"{root}/backup/{ARCHIVE_NAME}"
    dev.write(archive, ARCHIVE_BODY)
    arch_before = dev.sha(archive)
    backend("reset")
    # As the settings tier runs it (backuptool backup && cloud_backup --yes --system-only).
    dev.run("cloud_backup --yes --system-only >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    uploaded_archive = ARCHIVE_NAME in listing
    failures += not check(uploaded_archive,
                          "the settings backup archive reached the cloud",
                          "the archive was not uploaded")

    # It must land under this device's own folder. A single shared filename is
    # what let the second device to run replace the first device's archive,
    # with no remote history to recover it from (#49). One device cannot
    # demonstrate the collision, but it can prove the archive is namespaced --
    # which is the property that prevents it.
    if uploaded_archive:
        device_id = dev.run("cloud_device_id 2>/dev/null || true").strip()
        failures += not check(
            bool(device_id) and f"{device_id}/{ARCHIVE_NAME}" in listing,
            f"the archive is filed under this device ({device_id or 'no id'})",
            "the archive sits at the root of the backup path - a second "
            "device would overwrite it")
    dev.run(f"rm -f {shlex.quote(archive)}")
    mark = log_mark(dev)
    dev.run("cloud_restore --yes --system-only >/dev/null 2>&1 || true", check=False)
    if uploaded_archive:
        arch_after = dev.sha(archive)
        failures += not check(arch_after is not None and arch_after == arch_before,
                              "the archive came back byte-identical",
                              "the archive did not come back - restore can report "
                              "SUCCESS while its filter matches nothing")
        # The archive carries no device name, so the restorer had none of this
        # device's to prefer and must say it took the newest overall instead.
        tail = dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true", check=False)
        failures += not check("restoring the newest there" in tail,
                              "and the restorer said it fell back to the newest archive overall",
                              "a pre-label archive was restored without the fallback being logged")
    else:
        print("    SKIP  archive restore - nothing was uploaded, so it proves nothing")

    # A second backup, against a remote that already holds one. The first
    # transfer always happens, so it cannot detect a comparison that wrongly
    # decides the file is already there - which is what #53 was.
    if uploaded_archive:
        step("a changed archive of the same size still reaches the cloud")
        dev.write(archive, ARCHIVE_BODY_V2)
        v2_local = dev.sha(archive)
        dev.run("cloud_backup --yes --system-only >/dev/null 2>&1 || true", check=False)
        dev.run(f"rm -f {shlex.quote(archive)}")
        dev.run("cloud_restore --yes --system-only >/dev/null 2>&1 || true", check=False)
        v2_back = dev.sha(archive)
        failures += not check(v2_back is not None and v2_back == v2_local,
                              "the second archive replaced the first in the cloud",
                              "the changed archive never reached the cloud - a "
                              "size-only comparison can skip the upload and "
                              "still report SUCCESS")

    # --- per-device names: retention and preference -------------------------
    # Since 2026-09-08 an archive's name carries the device that wrote it,
    # between the date and ROCKNIX (<stamp>-<label>-ROCKNIX_SETTINGS.tar.gz),
    # and two rules hang off that. Retention counts and removes only archives
    # carrying this device's label, in this device's own folder: one carrying
    # another device's label (restored here and sent up again, or written by a
    # device sharing the folder through a cloned id, #86) or none (from before
    # names carried a device) is left alone. And a restore brings back this
    # device's newest before anything newer another device wrote. One device
    # proves both by planting the other shapes in its own folder: the VM
    # pair's guest b gets its own folder by construction, so the pair cannot
    # share one without a cloned id, which A11 refuses. A same-label archive
    # from another device of the same model is not planted: by design it
    # cannot be told from this device's own, and counts as one of them.
    step("retention removes only archives carrying this device's name, and restore prefers them")
    label = dev.run("cloud_device_id --label 2>/dev/null || true").strip()
    osn = os_name(dev)
    device_id = dev.run("cloud_device_id 2>/dev/null || true").strip()
    settings_remote = settings.get("SETTINGS_REMOTE") or settings.get("SYNCPATH_BACKUP") or ""
    keep_raw = dev.run(f"grep -m1 '^CLOUD_BACKUP_KEEP=' {CONF} 2>/dev/null | cut -d= -f2 | tr -d '\"' || true").strip()
    keep = int(keep_raw) if keep_raw.isdigit() else 3
    folder = f"{remote}:{settings_remote}/{device_id}"
    if not (label and device_id and settings_remote) or not 1 <= keep <= 20:
        failures += not check(False, "",
                              f"cannot set the fixture up (label {label!r}, id {device_id!r}, "
                              f"settings remote {settings_remote!r}, keep {keep})")
    else:
        other = f"2026_01_01-000000-Other-Handheld-{osn}_SETTINGS.tar.gz"
        # Both pre-label shapes a folder in the field holds: the dated tar,
        # and the zip the uploader dated on its way up.
        unlabelled = [f"2026_01_01-000000-{osn}_SETTINGS.tar.gz", f"2026_01_01-000000-{osn}_BACKUP.zip"]
        # keep of this device's planted, one more uploaded: exactly one goes.
        own = [f"2026_01_{d:02d}-000000-{label}-{osn}_SETTINGS.tar.gz" for d in range(2, 2 + keep)]
        newest_own = f"2026_01_{2 + keep:02d}-000000-{label}-{osn}_SETTINGS.tar.gz"
        newer_other = f"2099_01_01-000000-Other-Handheld-{osn}_SETTINGS.tar.gz"
        plant = "/tmp/qa-plant"
        broot = f"{root}/backup"
        dev.run(f"rclone purge {shlex.quote(folder)} >/dev/null 2>&1; rm -rf {plant}; mkdir -p {plant} {shlex.quote(broot)}",
                check=False)
        # A fixture that cannot be planted is a FAIL here, not an abort of
        # every step after this one.
        try:
            for name in [other] + unlabelled + own:
                dev.write(f"{plant}/{name}", name.encode())
                dev.run(f"rclone copyto {shlex.quote(f'{plant}/{name}')} {shlex.quote(f'{folder}/{name}')}")
            planted = True
        except Fail as e:
            planted = False
            failures += not check(False, "", f"could not plant the fixture in {folder}: {e}")
        ran = False
        if planted:
            # One archive of this device's at the root so the upload runs and
            # retention runs after it; the marker is cleared so a root that
            # looks unchanged is not skipped.
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip {CACHE}/settings-backup.uploaded", check=False)
            dev.write(f"{broot}/{newest_own}", b"the archive this run uploads")
            rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
            listing = dev.run(f"rclone lsf --files-only {shlex.quote(folder + '/')} 2>/dev/null || true", check=False).split()
            mine = sorted(n for n in listing if n.endswith(f"-{label}-{osn}_SETTINGS.tar.gz"))
            ran = check(rc == 0 and newest_own in listing,
                        f"the upload ran (exit {rc})",
                        f"the upload did not run (exit {rc}); retention cannot be judged")
            failures += not ran
        if ran:
            failures += not check(mine == sorted(own[1:] + [newest_own]),
                                  f"this device's archives were trimmed to CLOUD_BACKUP_KEEP={keep}, oldest first",
                                  f"retention did not keep the newest {keep} of this device's: {mine}")
            spared = [other] + unlabelled
            failures += not check(all(n in listing for n in spared),
                                  "another device's archive and both pre-label shapes were left alone",
                                  "RETENTION REMOVED WHAT IS NOT THIS DEVICE'S: "
                                  f"{[n for n in spared if n not in listing]}")

            # Restore: the other device's is newer, and this device's must still win.
            dev.write(f"{plant}/{newer_other}", newer_other.encode())
            dev.run(f"rclone copyto {shlex.quote(f'{plant}/{newer_other}')} {shlex.quote(f'{folder}/{newer_other}')}")
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
            run_rc(dev, "cloud_restore --yes --system-only")
            local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
            failures += not check(newest_own in local and newer_other not in local,
                                  "restore brought back this device's newest, not the other device's newer archive",
                                  f"restore chose {local or 'nothing'} over this device's own {newest_own}")
            # With none of this device's own left, the newest overall -- the
            # fresh-device journey (#26) -- and the log says whose it was.
            for name in mine:
                dev.run(f"rclone deletefile {shlex.quote(f'{folder}/{name}')} >/dev/null 2>&1 || true", check=False)
            dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
            mark = log_mark(dev)
            run_rc(dev, "cloud_restore --yes --system-only")
            local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
            tail = dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true", check=False)
            failures += not check(newer_other in local,
                                  "with none of its own, restore took the newest overall",
                                  f"restore took {local or 'nothing'} when only other devices' archives remained")
            failures += not check("made on Other-Handheld" in tail,
                                  "and the log named the device that made it",
                                  "the fallback restore did not say whose archive it took")
        dev.run(f"rm -rf {plant}; rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip {CACHE}/settings-backup.uploaded",
                check=False)
        dev.run(f"rclone purge {shlex.quote(folder)} >/dev/null 2>&1 || true", check=False)

    # --- content backup / restore -------------------------------------------
    # cloud_content_backup hardcodes DEST=/storage/roms and ignores SAVESPATH,
    # so the scratch tree cannot contain this one. It is confined instead to a
    # directory the harness creates and removes, and driven per-directory:
    # `--all` would upload the whole ROM library, which is never what a test
    # should do to someone's device.
    step("ROMs and BIOS back up a system directory")
    croot = f"/storage/roms/{CONTENT_DIR}"
    # Never delete somebody's library: the fixture directory is a real
    # system's, and the harness owns it only if it is empty or absent.
    existing = dev.run(f"find {shlex.quote(croot)} -type f 2>/dev/null | head -3 || true").strip()
    if existing and not args.real_roms:
        raise Fail(f"{croot} holds files ({existing.splitlines()[0]} ...); refusing to use it as a fixture")
    dev.run(f"rm -rf {shlex.quote(croot)}")
    for rel, data in CONTENT_FIXTURES.items():
        dev.write(f"{croot}/{rel}", data)
    cbefore = {rel: dev.sha(f"{croot}/{rel}") for rel in CONTENT_FIXTURES}

    listed = dev.run(f"cloud_content_backup --list 2>/dev/null || true")
    failures += not check(CONTENT_DIR in listed,
                          f"{CONTENT_DIR} is offered as a content directory",
                          f"--list did not offer it: {listed.split() or 'nothing'}")

    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    clisting = backend("ls")
    cup = {rel for rel in CONTENT_FIXTURES if os.path.basename(rel) in clisting}
    ok = check(len(cup) == len(CONTENT_FIXTURES),
               f"all {len(CONTENT_FIXTURES)} content files reached the cloud",
               f"only {len(cup)}/{len(CONTENT_FIXTURES)} reached the cloud")
    failures += not ok
    if not ok:
        # Distinguish "this device has the known bug" from "the harness is
        # broken" - otherwise a real, already-diagnosed defect reads as a
        # problem with the test.
        body = dev.run("cat $(command -v cloud_content_backup) 2>/dev/null || true")
        if "Restoring ${DIR:-everything} from the cloud" in body:
            print("          ^ this device ships the inverted cloud_content_backup "
                  "(issue #40): it copies cloud -> device, so nothing is ever "
                  "uploaded. Expected until a build carries the fix.")

    step("ROMs and BIOS restore it")
    # Plant at the endpoint directly rather than restoring what the upload
    # step just wrote: otherwise a broken uploader fails this check for the
    # wrong reason and one bug masks the other's status (audit F-03).
    backend("reset")
    stage = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    for rel, data in CONTENT_FIXTURES.items():
        f = os.path.join(stage, CONTENT_DIR, rel)
        os.makedirs(os.path.dirname(f), exist_ok=True)
        open(f, "wb").write(data)
    # The current layout: ROMs/<system> under CONTENT_REMOTE (D-CLOUD-018);
    # the restorer reads the flat pre-ROMs layout too, but the fixture is the
    # shape a backup writes today.
    cpath = epath(backend("content-remote"))
    backend("put", os.path.join(stage, CONTENT_DIR), f"{cpath}/ROMs/{CONTENT_DIR}")
    dev.run(f"rm -rf {shlex.quote(croot)}")
    failures += not check(not dev.sha(f"{croot}/{list(CONTENT_FIXTURES)[0]}"),
                          "local content removed before restore",
                          "local content still present")
    dev.run(f"cloud_content_restore {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    cafter = {rel: dev.sha(f"{croot}/{rel}") for rel in CONTENT_FIXTURES}
    csame = [r for r in CONTENT_FIXTURES if cbefore[r] and cbefore[r] == cafter[r]]
    failures += not check(len(csame) == len(CONTENT_FIXTURES),
                          f"all {len(CONTENT_FIXTURES)} content files restored byte-identical",
                          f"only {len(csame)}/{len(CONTENT_FIXTURES)} matched")

    dev.run(f"rm -rf {shlex.quote(croot)}")

    # --- tier boundaries ----------------------------------------------------
    # The regression test for blindspot 21. Content sync and the saves sync
    # both operate over /storage/roms; a save file living next to a ROM must
    # be carried by the saves tier and NOT by content. This existed as a
    # defect for a day and was caught by a human reading an upload listing,
    # not by this harness.
    step("a save file inside a system directory does not reach the ROMs and BIOS tier")
    backend("reset")
    dev.write(f"{croot}/Some Game.srm", b"battery save, saves tier owns this")
    dev.write(f"{croot}/Some Game.rom", b"a rom, content tier owns this")
    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    listing = backend("ls")
    # Both directions, or the assertion cannot fail: the ROM proves the
    # transfer ran at all, the .srm proves the exclusion bit.
    failures += not check("Some Game.rom" in listing,
                          "the ROM reached the content tier",
                          "the ROM did not transfer - exclusion cannot be judged")
    failures += not check("Some Game.srm" not in listing,
                          "the save file was correctly withheld from content",
                          "SAVE DATA REACHED THE CONTENT TIER (blindspot 21)")

    # A sync conflict is another client's dispute, and moving it makes it
    # immortal: a device that downloads one uploads it again, so deleting it
    # in the cloud looks like the provider putting it back. 271 directories of
    # BIOS were resurrected exactly that way on 2026-09-04.
    step("a sync-conflict artifact is carried by no tier, in either direction")
    backend("reset")
    conflict_dir = "Machines (Someone's conflicted copy 2026-09-03)"
    dev.write(f"{croot}/Real.rom", b"content tier owns this")
    dev.write(f"{croot}/{conflict_dir}/dup.rom", b"dropbox left this behind")
    dev.write(f"{croot}/Other.sync-conflict-20260903-120000-ABCDEF.rom", b"syncthing")
    dev.run(f"cloud_content_backup {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    listing = backend("ls")
    # Real.rom first: without it the exclusions below prove nothing, because a
    # transfer that moved nothing at all also mentions no conflicted copy.
    failures += not check("Real.rom" in listing,
                          "the ordinary ROM reached the content tier",
                          "nothing transferred - the exclusions cannot be judged")
    failures += not check("conflicted copy" not in listing,
                          "the conflicted copy was withheld from the cloud",
                          "A CONFLICTED COPY WAS UPLOADED (D-CLOUD-022)")
    failures += not check("sync-conflict" not in listing,
                          "the Syncthing conflict file was withheld",
                          "A .sync-conflict FILE WAS UPLOADED (D-CLOUD-022)")
    # And it must not count as content this device holds, or the picker's
    # badge reports a size the cloud will never agree with.
    sizes = dev.run("cloud_content_backup --list-sizes 2>/dev/null || true")
    failures += not check("conflicted copy" not in sizes,
                          "--list-sizes ignores conflict artifacts",
                          "--list-sizes counted a conflicted copy as content")

    # gamelist.xml is shared metadata with a per-device tail. It rides in its
    # own --update pass so the freshest list wins rather than whoever ran last:
    # a device that scans its own ROMs and uploads before ever restoring would
    # otherwise push a thin list over a rich one.
    step("gamelist.xml moves with game content, newest-first, in its own pass")
    # The game list is game content (D-CLOUD-049): it moves only when game
    # content is in scope, so this step runs --with-media, and restores
    # --selected with a selection that exists.
    backend("reset")
    dev.write(f"{croot}/Real.rom", b"content")
    dev.write(f"{croot}/gamelist.xml", b"<gameList><game><path>./Real.rom</path></game></gameList>")
    dev.run(f"cloud_content_restore --set-systems {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true", check=False)
    dev.run(f"cloud_content_backup --with-media {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    failures += not check("Real.rom" in listing,
                          "the ROM reached the content tier",
                          "nothing transferred - the gamelist assertions cannot be judged")
    failures += not check("gamelist.xml" in listing,
                          "the gamelist reached the cloud in its own pass",
                          "gamelist.xml was not uploaded at all")

    # Now make the local copy newer and poorer, and restore: --update must
    # refuse to overwrite it.
    dev.write(f"{croot}/gamelist.xml", b"<gameList><!--LOCAL-NEWER--></gameList>")
    # Unmistakably newer: on a fast guest the upload and this write land in
    # the same second, WebDAV keeps one-second modtimes, and --update falls
    # back to size when times are equal -- which is not the case under test.
    # busybox touch takes "YYYY-MM-DD hh:mm:ss", not @epoch; the arithmetic runs on the device.
    dev.run(f'touch -d "$(date -d @$(( $(date +%s) + 120 )) \'+%Y-%m-%d %H:%M:%S\')" {shlex.quote(croot)}/gamelist.xml')
    dev.run(f"rm -f {shlex.quote(croot)}/Real.rom")
    dev.run("sync", check=False)
    dev.run("cloud_content_restore --with-media --selected >/dev/null 2>&1 || true", check=False)
    # The restore must have done something before "the local one survived"
    # means anything: the ROM removed above is back.
    failures += not check(bool(dev.sha(f"{croot}/Real.rom")),
                          "the restore ran (the removed ROM is back)",
                          "the restore transferred nothing - the gamelist assertion below would pass for the wrong reason")
    local = dev.run(f"cat {shlex.quote(croot)}/gamelist.xml 2>/dev/null || true")
    failures += not check("LOCAL-NEWER" in local,
                          "a newer local gamelist survived the restore",
                          "RESTORE CLOBBERED A NEWER LOCAL GAMELIST (--update not applied)")

    # Three callers can start a cloud sync -- boot, game exit, the menu -- and
    # until 2026-09-04 nothing stopped two from running at once. The lock lives
    # in the scripts, so this test is caller-agnostic: hold it, then ask.
    step("a second cloud sync while one runs is refused, exits 3, and stamps nothing")
    dev.run("rm -f /storage/.cache/cloud_sync/last-backup", check=False)
    out = dev.run(
        "exec 9>/var/run/cloud_sync.lock; flock -n 9 || echo HOLDER-FAILED; "
        "cloud_backup --yes >/tmp/second.out 2>&1; echo rc=$?; "
        "exec 9>&-", check=False)
    failures += not check("HOLDER-FAILED" not in out,
                          "the test could hold the lock itself",
                          "could not take the lock to set up the test")
    failures += not check("rc=3" in out,
                          "the second sync exited 3",
                          f"expected exit 3 while the lock was held, got: {out.strip()[-40:]}")
    second = dev.run("cat /tmp/second.out 2>/dev/null || true")
    failures += not check("already running" in second.lower(),
                          "and said another sync was running",
                          "exit 3 without the message somebody would read")
    stamp = dev.run("cat /storage/.cache/cloud_sync/last-backup 2>/dev/null || echo NONE")
    failures += not check(stamp.strip() == "NONE",
                          "no last-run stamp was written for work that did not happen",
                          "A SKIPPED SYNC STAMPED A LAST-RUN (would read as success/failure)")

    # The game-exit sync runs cloud_backup --yes --saves-only --recent: only
    # what changed since the last backup that worked, no remote probe, no
    # tidy, and exit 4 at once when there is no network. Each is a claim a
    # player waits on after every game, so each is asserted here -- against
    # the script's own log, because "fast" is not observable from a listing.
    step("a --recent sync with nothing changed leaves the remote alone")
    dev.run("cloud_backup --yes --saves-only >/dev/null 2>&1 || true", check=False)  # a success to measure from
    mark = dev.run("wc -l < /var/log/cloud_sync.log 2>/dev/null || echo 0").strip() or "0"
    out = dev.run("cloud_backup --yes --saves-only --recent >/dev/null 2>&1; echo rc=$?", check=False)
    tail = dev.run(f"tail -n +{int(mark) + 1} /var/log/cloud_sync.log 2>/dev/null || true")
    failures += not check("rc=0" in out, "the recent sync exited 0",
                          f"recent sync failed: {out.strip()[-40:]}")
    failures += not check("--max-age" in tail and "--no-traverse" in tail,
                          "rclone was given a recency window and told not to list the remote",
                          "--recent did not narrow the copy (no --max-age/--no-traverse in the log)")
    failures += not check("nothing to transfer" in tail.lower(),
                          "and found nothing to move",
                          "a recent sync with nothing changed transferred something")
    failures += not check("Ensuring remote sync path" not in tail and "Removing orphaned" not in tail,
                          "no probe and no tidy round trips were made",
                          "a recent sync still probed or tidied the remote")

    step("a --recent sync after one save is written pushes that file")
    dev.write(f"{root}/savestates/recent-probe.state", b"recent")
    dev.run("sync", check=False)
    mark = dev.run("wc -l < /var/log/cloud_sync.log 2>/dev/null || echo 0").strip() or "0"
    out = dev.run("cloud_backup --yes --saves-only --recent >/dev/null 2>&1; echo rc=$?", check=False)
    tail = dev.run(f"tail -n +{int(mark) + 1} /var/log/cloud_sync.log 2>/dev/null || true")
    failures += not check("rc=0" in out and "recent-probe.state" in backend("ls"),
                          "the new save reached the bucket",
                          "the save written after the last sync did not reach the bucket")
    failures += not check("Transferred:            1 / 1" in tail,
                          "and it was the only file transferred",
                          "more than one file moved for one changed save")

    step("with no network the exit sync returns 4 at once and stamps nothing")
    out = dev.run(
        "mkdir -p /tmp/noroute && printf '#!/bin/sh\nexit 0\n' > /tmp/noroute/ip && chmod +x /tmp/noroute/ip; "
        "s0=$(cat /storage/.cache/cloud_sync/last-backup 2>/dev/null); "
        "t0=$(date +%s%N); PATH=/tmp/noroute:$PATH cloud_backup --yes --saves-only --recent >/dev/null 2>&1; "
        "rc=$?; t1=$(date +%s%N); s1=$(cat /storage/.cache/cloud_sync/last-backup 2>/dev/null); "
        "echo rc=$rc ms=$(( (t1 - t0) / 1000000 )) stamp=$([ \"$s0\" = \"$s1\" ] && echo same || echo CHANGED); "
        "rm -rf /tmp/noroute", check=False)
    fields = dict(kv.split("=", 1) for kv in out.split() if "=" in kv)
    failures += not check(fields.get("rc") == "4", "exit 4 with no default route",
                          f"expected exit 4 without a route, got: {out.strip()}")
    failures += not check(fields.get("ms", "99999").isdigit() and int(fields.get("ms", "99999")) < 2000,
                          "and it answered in under two seconds",
                          f"took {fields.get('ms')} ms to notice there was no network")
    failures += not check(fields.get("stamp") == "same",
                          "no last-run stamp was written for work that did not happen",
                          "A NO-NETWORK SKIP STAMPED A LAST-RUN")

    step("every EmulationStation system path is carried by exactly one tier")
    # The complement of the rule above: a path in NO tier is silent data loss
    # on restore. Four were found this way (gmu/playlists, idtech, modules,
    # scummvm/games) after a ScummVM player would have lost their entries.
    orphans = dev.run(
        "C=$(ls /storage/.config/emulationstation/es_systems.cfg "
        "/usr/config/emulationstation/es_systems.cfg 2>/dev/null | head -1); "
        "B=$(command -v backuptool); "
        "grep -oP '(?<=<path>)[^<]+' \"$C\" | sort -u | while read -r p; do "
        "  case \"$p\" in /storage/roms/*) continue ;; esac; "
        "  grep -qF \"$p\" \"$B\" || echo \"$p\"; "
        "done").split()
    failures += not check(not orphans,
                          "every ES path outside /storage/roms is in the settings backup",
                          f"carried by no tier: {' '.join(orphans)}")

    # --- archive format -----------------------------------------------------
    step("the settings archive is a tar archive named for this device, and every reader finds it")
    # A real archive, written by backuptool where the conf says archives live.
    dev.run("backuptool backup >/dev/null 2>&1 || true", check=False)
    # backuptool's own finder, not a copy of its globs: what RESTORE SETTINGS
    # FROM THIS DEVICE will apply is what this asserts. The script is resolved
    # BEFORE /etc/profile is sourced, because the profile rewrites PATH and
    # would drop the --path-prefix directory; the profile is sourced at all
    # because the script itself does, and its globs are built on OS_NAME,
    # which an ssh session does not have.
    def finder(script):
        return (f"B={script}; . /etc/profile >/dev/null 2>&1; . {CONF}; "
                "eval \"$(sed -n '/^newest_backup()/,/^}/p' \"$B\")\"; newest_backup")
    newest_cmd = finder('"$(command -v backuptool)"')
    newest = dev.run(newest_cmd, check=False).strip()
    failures += not check(newest.endswith(".tar.gz"),
                          f"newest archive is a tar.gz ({os.path.basename(newest) or 'none'})",
                          f"newest archive is not a tar.gz: {newest or 'none found'}")
    if newest:
        failures += not check(dev.run(f"tar -tzf {shlex.quote(newest)} >/dev/null 2>&1 && echo ok", check=False).strip() == "ok",
                              "the archive passes tar integrity",
                              "the archive is not readable by tar")
    # The device's name sits between the stamp and ROCKNIX (2026-09-08): two
    # handhelds' archives used to be told apart by nothing.
    label = dev.run("cloud_device_id --label 2>/dev/null || true").strip()
    osn = os_name(dev)
    named = bool(label) and re.fullmatch(
        rf"\d{{4}}_\d{{2}}_\d{{2}}-\d{{6}}-{re.escape(label)}-{re.escape(osn)}_SETTINGS\.tar\.gz",
        os.path.basename(newest)) is not None
    failures += not check(named,
                          f"the archive is named for this device, between the date and {osn} ({label or 'no label'})",
                          f"the archive does not carry this device's name between the date and {osn}: "
                          f"{os.path.basename(newest) or 'none'} (label {label or 'none'})")
    # In the MIDDLE, so that the finder every image already carries --
    # *-ROCKNIX_SETTINGS.tar.gz -- still matches. The installed backuptool is
    # asked through its own function: on a device running an image from
    # before the label, that is an older reader finding a new archive, which
    # a first cut of this change broke (review, 2026-09-08). Where the
    # installed script is itself the one under test, this holds trivially.
    installed = dev.run(finder("/usr/bin/backuptool"), check=False).strip()
    failures += not check(bool(newest) and installed == newest,
                          "the installed image's own backuptool finds the same archive",
                          f"the installed backuptool's finder got {os.path.basename(installed) or 'nothing'}, "
                          f"not {os.path.basename(newest) or 'none'}")
    # Every device in the field has archives from before names carried a
    # device. A newer one of those must still be found.
    legacy = f"{os.path.dirname(newest) if newest else f'{root}/backup'}/2099_12_31-235959-{osn}_BACKUP.zip"
    dev.run(f": > {shlex.quote(legacy)}")
    found = dev.run(newest_cmd, check=False).strip()
    dev.run(f"rm -f {shlex.quote(legacy)}")
    failures += not check(found == legacy,
                          "a newer archive under the pre-label name is still found",
                          f"the finder skipped a pre-label archive: got {os.path.basename(found) or 'none'}")

    # --- per-device system selection ---------------------------------------
    step("content transfers honour the system selection")
    dev.run(f"cloud_content_restore --set-systems {shlex.quote(CONTENT_DIR)} >/dev/null 2>&1 || true",
            check=False)
    sel = dev.run("cloud_content_restore --systems 2>/dev/null || true").split()
    failures += not check(sel == [CONTENT_DIR],
                          f"selection persisted as {sel}",
                          f"selection did not round-trip: {sel}")
    # A selection of exactly one directory must exclude a second one that
    # also has content - otherwise "only selected" is untested.
    other = f"{CONTENT_DIR}-unselected"
    dev.write(f"/storage/roms/{other}/game.rom", b"should not be uploaded")
    backend("reset")
    dev.run("cloud_content_backup --selected >/dev/null 2>&1 || true", check=False)
    listing = backend("ls")
    failures += not check("game.rom" not in listing,
                          "an unselected system was not uploaded",
                          "an UNSELECTED system was uploaded")
    dev.run(f"rm -rf /storage/roms/{shlex.quote(other)}")
    dev.run("rm -f /storage/.cache/cloud_sync/content-systems")

    step("a system this device cannot run is marked unsupported")
    # Plant a cloud directory for a system absent from es_systems.cfg.
    backend("reset")
    stage2 = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    os.makedirs(f"{stage2}/ROMs/definitely-not-a-system", exist_ok=True)
    open(f"{stage2}/ROMs/definitely-not-a-system/x.rom", "wb").write(b"x")
    cpath2 = epath(backend("content-remote"))
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    # name|cloud_bytes|supported|device_bytes|... -- the third field, not the tail
    failures += not check(bool(row) and row[0].split("|")[2:3] == ["0"],
                          "the unrunnable system is flagged 0 (unsupported)",
                          f"scan did not mark it unsupported: {row or 'row absent'}")
    # The comparison fields (2026-09-08): x.rom is one byte the device lacks;
    # y.rom is one byte in the cloud and two here, so it is "not here" at the
    # cloud's size and "not in the cloud" at the device's. Names alone would
    # have called y.rom present on both sides. Expected, by planted sizes:
    # cloud 2 bytes, unsupported, device 2 bytes, 2 files/2 bytes to restore,
    # 1 file/2 bytes to back up.
    open(f"{stage2}/ROMs/definitely-not-a-system/y.rom", "wb").write(b"y")
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    dev.write("/storage/roms/definitely-not-a-system/y.rom", b"yy")
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["2", "0", "2", "2", "1", "2", "2"],
                          "the scan says what a copy each way would move, in files and bytes",
                          f"scan fields 2-8 were not 2|0|2|2|1|2|2: {row or 'row absent'}")
    # The game list is sized, never compared (2026-09-08): three bytes in the
    # cloud, five on the device. Under ROMs alone neither side lists a
    # system's own list, so the row is what it was; under game content each
    # total grows by its list and every comparison field stays put, since
    # the list's direction is a modtime the scan does not have.
    open(f"{stage2}/ROMs/definitely-not-a-system/gamelist.xml", "wb").write(b"ccc")
    subprocess.run([BACKEND, "put", f"{stage2}/ROMs", f"{cpath2}/ROMs"], capture_output=True, text=True)
    dev.write("/storage/roms/definitely-not-a-system/gamelist.xml", b"ddddd")
    scan = dev.run("cloud_content_restore --scan 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["2", "0", "2", "2", "1", "2", "2"],
                          "under ROMs alone the game list is neither sized nor counted",
                          f"scan fields 2-8 were not 2|0|2|2|1|2|2 with a game list present: {row or 'row absent'}")
    scan = dev.run("cloud_content_restore --scan --with-media 2>/dev/null || true")
    row = [l for l in scan.splitlines() if l.startswith("definitely-not-a-system|")]
    failures += not check(bool(row) and row[0].split("|")[1:] == ["5", "0", "7", "2", "1", "2", "2"],
                          "under game content the game list is sized on each side and never counted as moving",
                          f"scan fields 2-8 were not 5|0|7|2|1|2|2: {row or 'row absent'}")
    dev.run("rm -rf /storage/roms/definitely-not-a-system")

    # --- folder seeding -----------------------------------------------------
    step("seeding is idempotent and never clobbers an existing note")
    dev.run("cloud_setup --seed-folders >/dev/null 2>&1 || true", check=False)
    dev.run("true")
    marker = b"OWNER WROTE THIS"
    stage3 = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
    open(f"{stage3}/README.txt", "wb").write(marker)
    spath = epath(backend("saves-remote"))
    subprocess.run([BACKEND, "put", stage3, spath], capture_output=True, text=True)
    second = dev.run("cloud_setup --seed-folders 2>/dev/null || true")
    failures += not check(second.count("OK ") >= 2,
                          "a second seeding run reports the folders present",
                          f"second run did not report folders: {second.strip()[:80]}")
    note = subprocess.run([BACKEND, "cat", f"{spath}/README.txt"], capture_output=True).stdout
    failures += not check(note == marker,
                          "the owner's note survived a second seeding",
                          f"the note was replaced: {note[:40]!r}")

    step("an older config's keys are carried across (D-UI-022, A12)")
    # A conf shaped like one from before #73 -- old names, no new ones, and a
    # RESTOREPATH equal to BACKUPPATH (the legal shape; the unequal one is a
    # refusal, A12 proper). The helper carries every value to its new name.
    saved_conf = dev.run(f"cat {CONF}")
    old_conf = "\n".join([
        'BACKUPPATH="/storage/qa-old-saves"', 'BACKUPFOLDER="/storage/qa-old-saves/backup"',
        'RESTOREPATH="/storage/qa-old-saves"', 'SYNCPATH="/QA-OLD"', 'SYNCPATH_BACKUP="/QA-OLD-BACKUPS"',
        'CONTENTPATH="/QA-OLD-CONTENT"', ""])
    dev.write(CONF, old_conf.encode())
    dev.run("cloud_sync_helper >/dev/null 2>&1 || true", check=False)
    migrated = dev.run(f"cat {CONF}")
    carried = {"SAVESPATH": "/storage/qa-old-saves", "SETTINGS_BACKUPS": "/storage/qa-old-saves/backup",
               "SAVES_REMOTE": "/QA-OLD", "SETTINGS_REMOTE": "/QA-OLD-BACKUPS", "CONTENT_REMOTE": "/QA-OLD-CONTENT"}
    missing = [k for k, v in carried.items() if f'{k}="{v}"' not in migrated]
    failures += not check(not missing, "every old key reached its new name with its value",
                          f"not carried: {missing}")
    dev.write(CONF, saved_conf.encode())

    return failures


# ===========================================================================
# Two devices against one cloud: the fixtures epic #11 builds against (#35)
# ===========================================================================
#
# Every fixture here is written before the code it tests and fails against
# the shipped scripts by design (`engineering-practices.md`, "A failure you
# find is yours to fix"): its first commit carries the failing output, and it
# turns green when #21/#22 land. The pair runs on GENERIC_X64 guests only
# (D-QA-009). A conflict is a change on both sides since two devices last
# agreed; one guest cannot make one, and a handheld is where a mistake
# becomes somebody's evening.
#
# a is the device under test; b is the other handheld, the one whose change
# a's copy has not seen. Every fixture begins with a first pass that brings
# both to agreement, because a suite that starts from an empty remote only
# ever tests first uploads (#53; the #35 futro).

ID_FILE = "/storage/.config/cloud_sync-device-id"
LOG = "/var/log/cloud_sync.log"
CACHE = "/storage/.cache/cloud_sync"

# The writers of the saves tree (#22 R1), as they run today: the boot
# autostart (102-cloud-saves); GuiMenu.cpp's SYNC SAVES WITH THE CLOUD, BACK
# UP SAVES TO THE CLOUD and RESTORE SAVES FROM THE CLOUD (the transfer page's
# SAVES tick runs the last two); FileData.cpp's game-exit push; and the two
# scripts from a shell. A1 runs each one. When a writer changes, this table
# changes in the same commit: the fixture tests what the labels run.
WRITERS = [
    ("the boot pair (autostart 102-cloud-saves)",
     "cloud_restore --yes --method=copy --update --saves-only; "
     "cloud_backup --yes --method=copy --update --saves-only"),
    ("SYNC SAVES WITH THE CLOUD",
     "cloud_restore --yes --method=copy --update --saves-only && "
     "cloud_backup --yes --method=copy --update --saves-only"),
    ("BACK UP SAVES TO THE CLOUD (and the SAVES tick, backing up)",
     "cloud_backup --yes --saves-only"),
    ("RESTORE SAVES FROM THE CLOUD (and the SAVES tick, restoring)",
     "cloud_restore --yes --saves-only"),
    ("the game-exit push", "cloud_backup --yes --saves-only --recent"),
    ("cloud_backup from a shell", "cloud_backup --yes"),
    ("cloud_restore from a shell", "cloud_restore --yes"),
]
BOOT_PAIR = WRITERS[0][1]

# The wizard's apply step, as the two fixtures that need a decision call it.
# Named here, once, so they can run at all before #22/#23 exist: the command
# fails today and the fixtures with it. `left` keeps the cloud's copy -- the
# device's is the loser, pushed to the store first (#22 R9); `right` keeps
# the device's.
APPLY = "cloud_reconcile --apply --unit {unit} --keep {side}"


def sha(data):
    return hashlib.sha256(data).hexdigest()


def epath(remote_path):
    """The endpoint path of a cloud path, for `cloud-test-backend cat/put/ls`.
    On WebDAV the folder is the path; on S3 the first component is the
    bucket, which the backend's own commands already prefix -- passing it
    again doubled the path, and the seeding step read its note back from a
    place the device never looked."""
    path = remote_path.strip().lstrip("/")
    if backend("backend").strip() == "s3":
        path = path.split("/", 1)[1] if "/" in path else ""
    return path


def backend_bytes(path):
    p = subprocess.run([BACKEND, "cat", path], capture_output=True)
    return p.stdout if p.returncode == 0 else None


def backend_files(path):
    """Every file under an endpoint path, as paths relative to it."""
    out = subprocess.run([BACKEND, "ls", path], capture_output=True, text=True).stdout
    return [line.split(None, 1)[1] for line in out.splitlines() if len(line.split(None, 1)) == 2]


def set_key(dev, key, val):
    dev.run(f"grep -q '^{key}=' {CONF} && sed -i 's|^{key}=.*|{key}=\"{val}\"|' {CONF} "
            f"|| echo '{key}=\"{val}\"' >> {CONF}")


def apply_settings(dev, settings):
    for key, val in settings.items():
        set_key(dev, key, val)


def run_rc(dev, cmd, env=""):
    """Run a command the way its caller does; return (exit code, its output)."""
    out = dev.run(f"( {env} {cmd} ) >/tmp/qa-run.out 2>&1; echo rc=$?; cat /tmp/qa-run.out", check=False)
    first, _, rest = out.partition("\n")
    return (int(first[3:]) if first.startswith("rc=") else -1), rest


def touch_offset(dev, path, seconds):
    """Move a file's mtime relative to the device's clock -- the lever the
    shipped pipeline resolves by. busybox touch takes a date, not @epoch."""
    dev.run(f'touch -d "$(date -d @$(( $(date +%s) + ({seconds}) )) \'+%Y-%m-%d %H:%M:%S\')" {shlex.quote(path)}')


def log_mark(dev):
    return int(dev.run(f"wc -l < {LOG} 2>/dev/null || echo 0").strip() or 0)


def os_name(dev):
    """What every settings archive's name ends with: OS_NAME, read from the
    file /etc/profile reads it from, since an ssh session has run no profile."""
    return dev.run('. /etc/os-release 2>/dev/null; echo "$OS_NAME"', check=False).strip() or "ROCKNIX"


def log_since(dev, mark):
    return dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true")


def name_of(digest, known):
    """Which planted version a hash is, for a message somebody can read."""
    for name, data in known.items():
        if digest == sha(data):
            return name
    return "absent" if digest is None else "neither (partial or foreign bytes)"


class Pair:
    def __init__(self, a, b, root, settings):
        self.a, self.b, self.root, self.settings = a, b, root, settings
        self.saves_remote = settings["SAVES_REMOTE"]
        self.spath = epath(self.saves_remote)

    def path(self, rel):
        return f"{self.root}/{rel}"

    def reset(self):
        """Empty the cloud and both saves trees, forget every stamp and
        record, put both devices back on the shared folder. Each fixture
        starts from nothing, so what one leaves behind cannot pass the next."""
        backend("reset")
        for d in (self.a, self.b):
            d.run(f"rm -rf {shlex.quote(self.root)} {CACHE}; mkdir -p {shlex.quote(self.root)} {CACHE}")
            apply_settings(d, self.settings)

    def cloud_sha(self, rel, folder=None):
        data = backend_bytes(f"{self.spath if folder is None else folder}/{rel}")
        return sha(data) if data is not None else None

    def agree(self, files):
        """The first pass: a backs up, b restores, both hold what the cloud holds."""
        for rel, data in files.items():
            self.a.write(self.path(rel), data)
        rc, _ = run_rc(self.a, "cloud_backup --yes --saves-only")
        rc2, _ = run_rc(self.b, "cloud_restore --yes --saves-only")
        wrong = [rel for rel, data in files.items()
                 if not (self.cloud_sha(rel) == sha(data) == self.b.sha(self.path(rel)))]
        if wrong:
            raise Fail(f"the first pass left {wrong} without agreement (backup exit {rc}, restore exit {rc2})")

    def both_changed(self, rel, h0, ha, hb, a_offset=3600):
        """Agreement on h0; b publishes hb; a edits to ha offline, its copy
        `a_offset` seconds newer (positive) or older than b's upload."""
        self.reset()
        self.agree({rel: h0})
        self.b.write(self.path(rel), hb)
        run_rc(self.b, "cloud_backup --yes --saves-only")
        if self.cloud_sha(rel) != sha(hb):
            raise Fail("b's publication did not reach the cloud")
        self.a.write(self.path(rel), ha)
        touch_offset(self.a, self.path(rel), a_offset)


def fx_a1(p):
    """A1: two devices agree on H0; b publishes HB; a edits to HA offline and
    runs every writer. Neither HA nor HB may be overwritten anywhere, and one
    conflict is reported. As shipped each writer is a recency resolver
    (blindspot 28): the cloud's copy or this device's is replaced, and
    nothing says so."""
    f = 0
    rel = "saves/Both Changed.srm"
    v = {"H0": b"H0: what both devices agreed on",
         "HA": b"HA: this device's edit, made offline, never seen by the cloud",
         "HB": b"HB: the other device's edit, already published"}
    for label, cmd in WRITERS:
        lost, rcs = [], []
        for timing, offset in (("this device's copy newer", 3600), ("the cloud's copy newer", -3600)):
            p.both_changed(rel, v["H0"], v["HA"], v["HB"], offset)
            rc, _ = run_rc(p.a, cmd)
            rcs.append(rc)
            cloud, local = p.cloud_sha(rel), p.a.sha(p.path(rel))
            if cloud != sha(v["HB"]):
                lost.append(f"{timing}: the cloud's HB became {name_of(cloud, v)}")
            if local != sha(v["HA"]):
                lost.append(f"{timing}: this device's HA became {name_of(local, v)}")
        f += not check(not lost, f"{label}: neither HA nor HB was overwritten",
                       f"{label}: " + "; ".join(lost) + " (blindspot 28)")
        f += not check(all(rc == 5 for rc in rcs),
                       f"{label}: reported one queued conflict (exit 5)",
                       f"{label}: no conflict reported (exit {rcs[0]} / {rcs[1]})")
    return f


def fx_a2(p):
    """A2: a failed push is retried at the next exit with nothing changed; an
    equal-size, equal-mtime byte change enters the changed set at the next
    full pass -- the hash catches what size and mtime cannot (#53's shape,
    on a save)."""
    f = 0
    rel = "saves/Retry.srm"
    v = {"H0": b"H0 agreed", "HA": b"HA: changed while the cloud was unreachable"}
    p.reset()
    p.agree({rel: v["H0"]})
    p.a.write(p.path(rel), v["HA"])
    # One push fails the way a lapsed sign-in does: the remote's password
    # (or S3 secret) wrong for that run, then put back. A closed port would
    # do too, but rclone retries a refused connection for ten minutes.
    good = p.a.run(f"cat {RCLONE_CONF}")
    p.a.run(f"sed -i \"s|^pass = .*|pass = $(rclone obscure wrong-password)|; s|^secret_access_key = .*|secret_access_key = wrong|\" {RCLONE_CONF}")
    rc1, _ = run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    p.a.write(RCLONE_CONF, good.encode())
    f += not check(rc1 != 0, f"the push failed while the cloud refused the sign-in (exit {rc1}; the setup)",
                   "a push the cloud refused reported success")
    rc2, _ = run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    f += not check(p.cloud_sha(rel) == sha(v["HA"]),
                   "the next exit, with nothing changed since, retried and published",
                   f"the failed push was not retried: the cloud holds {name_of(p.cloud_sha(rel), v)} (exit {rc2})")

    rel = "saves/Same Size.srm"
    one, two = b"version-one-of-this-save", b"version-two-of-this-save"
    assert len(one) == len(two)
    p.reset()
    p.agree({rel: one})
    # On b: new bytes, the same length, the mtime put back to what it was.
    q = shlex.quote(p.path(rel))
    p.b.run(f"cp -p {q} {q}.ref")
    p.b.write(p.path(rel), two)
    p.b.run(f"touch -r {q}.ref {q}; rm -f {q}.ref; sync")
    run_rc(p.b, "cloud_backup --yes --saves-only")
    run_rc(p.a, "cloud_restore --yes --saves-only")
    f += not check(p.a.sha(p.path(rel)) == sha(two),
                   "an equal-size, equal-mtime byte change entered the changed set at the full pass",
                   "an equal-size, equal-mtime byte change was never noticed: size and mtime matched "
                   "and nothing hashed, so a still holds version one (A2)")
    return f


def fx_a3(p):
    """A3: CHANGE CLOUD FOLDER to a folder holding different saves. Nothing
    downloads silently; identical pairs seed agreement; differing pairs
    queue. As shipped the pass after a re-link is the boot pair, which
    replaces this device's copy with the folder's newer one."""
    f = 0
    same, diff = "saves/Same In Both.srm", "saves/Differs.srm"
    v = {"H0": b"H0: in both folders", "X": b"X: this device's version",
         "Y": b"Y: the other folder's version, never seen here"}
    p.reset()
    p.agree({same: v["H0"], diff: v["X"]})
    second = p.saves_remote.rstrip("/") + "-second"
    set_key(p.b, "SAVES_REMOTE", second)
    p.b.write(p.path(same), v["H0"])
    p.b.write(p.path(diff), v["Y"])
    run_rc(p.b, "cloud_backup --yes --saves-only")
    set_key(p.b, "SAVES_REMOTE", p.saves_remote)
    if p.cloud_sha(diff, epath(second)) != sha(v["Y"]):
        raise Fail("b could not fill the second folder")
    # a changes folder the way CHANGE CLOUD FOLDER does; its differing copy is
    # older than the folder's, the shape recency gets wrong.
    rc, out = run_rc(p.a, f"cloud_setup --set-saves-remote {shlex.quote(second)}")
    if rc != 0:
        raise Fail(f"cloud_setup --set-saves-remote refused {second}: {out.strip()[-80:]}")
    touch_offset(p.a, p.path(diff), -3600)
    rc, _ = run_rc(p.a, BOOT_PAIR)
    got = p.a.sha(p.path(diff))
    f += not check(got == sha(v["X"]), "nothing on this device was replaced by the new folder's saves",
                   f"A SAVE WAS SILENTLY REPLACED after CHANGE CLOUD FOLDER: {diff} became {name_of(got, v)} (A3)")
    f += not check(p.a.sha(p.path(same)) == sha(v["H0"]), "the identical pair is untouched", "the identical pair changed")
    f += not check(rc == 5, "the differing pair was queued (exit 5)", f"no queue for the differing pair (exit {rc})")
    agreed = p.a.run(f"cat {CACHE}/agreed.json 2>/dev/null || true")
    f += not check(same in agreed and diff not in agreed,
                   "the identical pair seeded agreement and the differing one did not",
                   "no agreement record for the identical pair" if not agreed.strip()
                   else "the agreement record is wrong about which pair agrees")
    return f


def fx_a8(p):
    """A8: a publication interrupted after one member of an N64 pair (.eep and
    .mpk: one unit). No device installs the mixed set; an unrelated unit still
    moves; the hold clears when the second member lands.

    The pair sits beside the ROM (n64/Torn.eep, n64/Torn.mpk): every shipped
    mupen64plus.cfg has SaveSRAMPath = "/storage/roms/n64", so that is the
    layout the emulator writes and the unit capture can see (#21). It was
    n64/save/, a directory only the allowlist ever named."""
    f = 0
    eep, mpk, other = "n64/Torn.eep", "n64/Torn.mpk", "saves/Unrelated.srm"
    e = {"old": os.urandom(2048), "new": os.urandom(2560)}
    m = {"old": os.urandom(32768), "new": os.urandom(40960)}
    u0, u1 = b"unrelated, agreed", b"unrelated, changed on a meanwhile"
    p.reset()
    try:
        p.agree({eep: e["old"], mpk: m["old"], other: u0})
    except Fail as x:
        # The shipped allowlist admits n64/save/*.eep and **/*.srm, not the
        # .eep/.mpk the emulator writes beside the ROM, so until the includes
        # land (#89, the allowlist issue split from #21) the pair never
        # reaches the cloud and A8 cannot get past its first pass. Say so --
        # but only when the evidence is that shape: the .srm made it and
        # neither member of the pair did. A backend outage or a broken
        # cloud_backup is re-raised as itself, not dressed as the known gap.
        if p.cloud_sha(other) == sha(u0) and not p.cloud_sha(eep) and not p.cloud_sha(mpk):
            raise Fail(f"{x} -- a standalone N64 pair beside the ROM is not in the sync allowlist yet "
                       "(+ /**/*.eep, + /**/*.mpk: #89, the allowlist issue split from #21); A8 waits on it")
        raise
    p.b.write(p.path(eep), e["new"])
    p.b.write(p.path(mpk), m["new"])
    # b publishes one file at a time at 8 KiB/s; rclone is killed once the
    # .eep (first by name) has landed and the .mpk is still in flight.
    p.b.run("rm -f /tmp/qa-torn.out; (RCLONE_TRANSFERS=1 RCLONE_BWLIMIT=8k setsid cloud_backup --yes --saves-only "
            ">/tmp/qa-torn.out 2>&1 &)")
    for _ in range(120):
        time.sleep(0.25)
        if p.cloud_sha(eep) == sha(e["new"]):
            break
    p.b.run("pkill -9 -x rclone; for i in $(seq 40); do pgrep -x cloud_backup >/dev/null || break; sleep 0.25; done; true",
            check=False)
    torn = p.cloud_sha(eep) == sha(e["new"]) and p.cloud_sha(mpk) != sha(m["new"])
    f += not check(torn, "b's publication was interrupted after its first member (the setup)",
                   f"could not leave the publication torn: .eep is {name_of(p.cloud_sha(eep), e)}, "
                   f".mpk is {name_of(p.cloud_sha(mpk), m)}")
    if not torn:
        return f
    p.a.write(p.path(other), u1)
    run_rc(p.a, BOOT_PAIR)
    got = (name_of(p.a.sha(p.path(eep)), e), name_of(p.a.sha(p.path(mpk)), m))
    f += not check(got in {("old", "old"), ("new", "new")}, f"a installed no mixed set (its pair is {got[0]}/{got[1]})",
                   f"A MIXED SET WAS INSTALLED on a: .eep {got[0]}, .mpk {got[1]} (A8)")
    f += not check(p.cloud_sha(other) == sha(u1), "an unrelated unit still moved while the torn one was held",
                   "the unrelated unit did not move")
    run_rc(p.b, "cloud_backup --yes --saves-only")
    run_rc(p.a, BOOT_PAIR)
    got = (name_of(p.a.sha(p.path(eep)), e), name_of(p.a.sha(p.path(mpk)), m))
    f += not check(got == ("new", "new"), "the hold cleared when the second member landed",
                   f"after the second member landed a holds .eep {got[0]}, .mpk {got[1]}")
    return f


def fx_a9(p):
    """A9: delete and renumber on one device, sync repeatedly on the other; a
    retired hash put back; an unexplained rm; a saves root that is unmounted,
    empty, or pointed at an empty cloud folder, with agreement on record.

    The states live under savestates/gba/ and the save under gba/ -- the
    layout ES and RetroArch write, so the unit is one capture can see (#21).
    Where the deletion models the save-state manager's, `cloud_capture
    --retire` runs before the unlink, as GuiSaveState does, so the retired
    record #22 needs exists in the case that tests it (D-CLOUD-053)."""
    f = 0
    s = {"S1": os.urandom(3001), "S2": os.urandom(3002), "S3": os.urandom(3003)}
    st = lambda n: f"savestates/gba/Renumber.state{n}"
    p.reset()
    p.agree({st(1): s["S1"], st(2): s["S2"], st(3): s["S3"]})
    # a deletes slot 2 from the manager -- which records the deletion first
    # -- and ES renumbers: slot 3 becomes slot 2.
    rc, _ = run_rc(p.a, f"cloud_capture --retire {shlex.quote(p.path(st(2)))}")
    rows = [r for r in (manifest_of(p.a) or {}).get("retired") or [] if r.get("path") == st(2)]
    f += not check(rc == 0 and bool(rows) and rows[0].get("sha256") == sha(s["S2"]),
                   "the manager's deletion left a retired row for state2 with S2's sha (#21; the record #22 propagates)",
                   f"cloud_capture --retire exited {rc}; retired rows for state2: {[(r.get('sha256') or '')[:8] for r in rows]} "
                   "-- the #22 checks below would fail on a #21 precondition")
    p.a.run(f"rm -f {shlex.quote(p.path(st(2)))}; mv {shlex.quote(p.path(st(3)))} {shlex.quote(p.path(st(2)))}")
    run_rc(p.a, BOOT_PAIR)
    for _ in range(2):
        run_rc(p.b, BOOT_PAIR)

    def on(dev):
        out = dev.run(f"cd {shlex.quote(p.root)} && sha256sum savestates/gba/* 2>/dev/null || true")
        return sorted(name_of(line.split()[0], s) for line in out.splitlines() if line.strip())

    def in_cloud():
        return sorted(name_of(sha(backend_bytes(f"{p.spath}/{rel}") or b""), s)
                      for rel in backend_files(p.spath) if rel.startswith("savestates/"))

    f += not check(on(p.b) == ["S1", "S3"], "after repeated syncs b holds S1 and S3, each exactly once",
                   f"b holds {on(p.b)} (A9: each surviving version exactly once)")
    f += not check(in_cloud() == ["S1", "S3"], "and so does the cloud", f"the cloud holds {in_cloud()}")
    # The retired hash put back, as the discarded-saves tool would: a new
    # publication, which the old retired record must not consume.
    p.a.write(p.path(st(3)), s["S2"])
    run_rc(p.a, BOOT_PAIR)
    run_rc(p.b, BOOT_PAIR)
    f += not check(on(p.b) == ["S1", "S2", "S3"], "a retired hash put back reached b as a new publication",
                   f"b holds {on(p.b)} after the retired hash was put back")

    # An unexplained absence: rm, not ES's delete, so no retired record.
    gone, kept = "gba/Removed By Hand.srm", "saves/Kept.srm"
    g0 = b"removed by rm on a"
    p.reset()
    p.agree({gone: g0, kept: b"kept"})
    p.a.run(f"rm -f {shlex.quote(p.path(gone))}")
    rc, _ = run_rc(p.a, BOOT_PAIR)
    f += not check(p.a.sha(p.path(gone)) is None, "the file removed by hand was not put back on a",
                   "THE FILE REMOVED BY HAND CAME BACK: an absence was resolved by a download (A9)")
    f += not check(p.cloud_sha(gone) == sha(g0), "and the cloud's copy was not deleted",
                   "the cloud's copy was deleted on an unexplained absence")
    f += not check(rc == 5, "a question was queued (exit 5)", f"no question queued (exit {rc})")
    run_rc(p.b, BOOT_PAIR)
    f += not check(p.b.sha(p.path(gone)) == sha(g0), "b's copy was untouched", "b's copy was touched by a's unexplained absence")

    # Mass absence, with agreement on record: the root unmounted, then empty,
    # then the cloud folder empty. Every pass refuses and names the reason.
    p.reset()
    p.agree({"saves/On Record.srm": b"agreed and on record"})
    passes = WRITERS[:5]
    q = shlex.quote(p.root)
    p.a.run(f"mv {q} {q}.away")
    try:
        rcs = [run_rc(p.a, c)[0] for _, c in passes]
        present = p.a.run(f"find {q} -type f 2>/dev/null | wc -l").strip()
    finally:
        p.a.run(f"rm -rf {q}; mv {q}.away {q}")
    f += not check(all(rc == 1 for rc in rcs), "with the saves root unmounted every pass refused (exit 1)",
                   f"passes on an unmounted root exited {rcs} (A9: refuse, reason named)")
    f += not check(present == "0", "and nothing was written where the root should be",
                   f"{present} file(s) were written into a root that was not mounted")
    p.a.run(f"mv {q} {q}.away; mkdir -p {q}")
    try:
        rcs = [run_rc(p.a, c)[0] for _, c in passes]
        present = p.a.run(f"find {q} -type f 2>/dev/null | wc -l").strip()
    finally:
        p.a.run(f"rm -rf {q}; mv {q}.away {q}")
    f += not check(all(rc == 1 for rc in rcs), "with the saves root empty every pass refused (exit 1)",
                   f"passes on an empty root exited {rcs}")
    f += not check(present == "0", "and nothing was downloaded into it",
                   f"{present} file(s) were downloaded into an empty root with agreement on record")
    empty = p.saves_remote.rstrip("/") + "-empty"
    set_key(p.a, "SAVES_REMOTE", empty)
    rcs = [run_rc(p.a, c)[0] for _, c in passes]
    set_key(p.a, "SAVES_REMOTE", p.saves_remote)
    uploaded = backend_files(epath(empty))
    f += not check(all(rc == 1 for rc in rcs), "with the cloud folder empty every pass refused (exit 1)",
                   f"passes against an empty cloud folder exited {rcs}")
    f += not check(not uploaded, "and nothing was uploaded to it",
                   f"{len(uploaded)} file(s) were uploaded into an empty cloud folder with agreement on record")
    queued = p.a.run(f"cat {CACHE}/queue.json 2>/dev/null || true").strip()
    f += not check(not queued, "no question was queued for a mass absence", "a mass absence queued questions")
    return f


def fx_a11(p):
    """A11: a cloned card -- the second device carries the first's identity.
    It refuses to publish with duplicate-device-id and transfers nothing."""
    f = 0
    rel = "saves/Cloned.srm"
    h0 = b"H0 published by the first card"
    a_id = p.a.run("cloud_device_id").strip()
    prev = p.b.run(f"cat {ID_FILE} 2>/dev/null || true")
    p.reset()
    p.agree({rel: h0})
    p.b.write(ID_FILE, (a_id + "\n").encode())
    try:
        p.b.write(p.path(rel), b"HB from the clone")
        mark = log_mark(p.b)
        rc, out = run_rc(p.b, "cloud_backup --yes --saves-only")
        said = "duplicate-device-id" in out + log_since(p.b, mark)
        f += not check(rc == 1 and said, "the clone was refused with duplicate-device-id",
                       f"THE CLONE PUBLISHED (exit {rc}, no duplicate-device-id refusal) (A11)")
        f += not check(p.cloud_sha(rel) == sha(h0), "and transferred nothing",
                       "the clone's copy replaced the first card's in the cloud")
    finally:
        p.b.write(ID_FILE, prev.encode())
    return f


def fx_a12(p):
    """A12 (D-CLOUD-040): an upgraded config carrying a legacy RESTOREPATH
    unlike BACKUPPATH. The helper migrates SAVESPATH from BACKUPPATH, drops
    RESTOREPATH and writes one WARN naming the ignored folder; nothing in that
    folder is touched; the passes proceed."""
    f = 0
    a = p.a
    other = SCRATCH + "-other"
    p.reset()
    p.agree({"saves/Agreed.srm": b"agreed before the upgrade"})
    untouched = b"lives in the folder RESTOREPATH named"
    a.write(f"{other}/saves/Untouched.srm", untouched)
    saved = a.run(f"cat {CONF}")
    keep = [l for l in saved.splitlines()
            if not re.match(r"^(SAVESPATH|SETTINGS_BACKUPS|SAVES_REMOTE|SETTINGS_REMOTE|CONTENT_REMOTE)=", l)]
    old = keep + [f'BACKUPPATH="{p.root}"', f'BACKUPFOLDER="{p.root}/backup"', f'RESTOREPATH="{other}"',
                  f'SYNCPATH="{p.settings["SAVES_REMOTE"]}"', f'SYNCPATH_BACKUP="{p.settings["SETTINGS_REMOTE"]}"',
                  f'CONTENTPATH="{p.settings["CONTENT_REMOTE"]}"', ""]
    a.write(CONF, "\n".join(old).encode())
    try:
        mark = log_mark(a)
        run_rc(a, f"cloud_sync_helper {LOG}")
        conf = a.run(f"cat {CONF}")
        warns = [l for l in log_since(a, mark).splitlines() if "WARN" in l and other in l]
        f += not check(f'SAVESPATH="{p.root}"' in conf, "SAVESPATH was migrated from BACKUPPATH",
                       "SAVESPATH was not carried from BACKUPPATH")
        f += not check("RESTOREPATH=" not in conf, "RESTOREPATH was dropped",
                       "RESTOREPATH is still in the config (A12: dropped, warned once)")
        f += not check(len(warns) == 1, "one WARN names the ignored folder",
                       f"{len(warns)} WARN line(s) name {other}; expected exactly one")
        rc, _ = run_rc(a, BOOT_PAIR)
        f += not check(rc == 0, "the pass proceeded (exit 0)", f"the pass refused (exit {rc}) instead of migrating")
        f += not check(a.sha(f"{other}/saves/Untouched.srm") == sha(untouched),
                       "nothing in the ignored folder was touched", "the ignored folder was touched")
    finally:
        a.write(CONF, saved.encode())
        a.run(f"rm -rf {shlex.quote(other)}")
    return f


def fx_a14(p):
    """A14: the manifest step, in two halves. #21's: a state (with its
    thumbnail) and a save planted on the unit layout, the producer run the way
    ES runs it at exit -- the working copy at /storage/.cache/cloud_sync holds
    an entry for both with the planted shas. #22's: the exit path pushes it,
    so the manifest is on the remote under savestates/.rocknix/ with the same
    sha256, remote_hash null on WebDAV and non-null on MinIO; and the
    ROMs-and-BIOS tier never sees the savestates directory. The remote checks
    stay, and stay failing, until #22 pushes the file.

    The paths carry a <system> component because no unit table can see
    savestates/Manifest Game.state1 or saves/Manifest Game.srm: without the
    layout and without a call to the producer, nothing would ever have
    written the entry this fixture asserted."""
    f = 0
    state, save = "savestates/gba/Manifest Game.state1", "gba/Manifest Game.srm"
    sbytes, vbytes = b"#RZIPv" + os.urandom(2000), os.urandom(512)
    p.reset()
    p.a.write(p.path(state), sbytes)
    p.a.write(p.path(state + ".png"), b"\x89PNG" + os.urandom(300))
    p.a.write(p.path(save), vbytes)
    rc, _ = capture(p.a, p.root, "gba", p.path("gba/Manifest Game.gba"))
    a_id = p.a.run("cloud_device_id").strip()
    local = manifest_of(p.a)
    got = {rel: (entry(local, rel) or {}).get("sha256") for rel in (state, save)}
    f += not check(rc == 0 and got[state] == sha(sbytes) and got[save] == sha(vbytes),
                   f"the working copy {CACHE}/manifest-{a_id}.json holds both entries with the planted shas (#21)",
                   f"exit {rc}; working copy {'absent' if local is None else 'present'}; entries "
                   f"{ {k: (v or '')[:8] for k, v in got.items()} } (#21)")
    run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    mpath = f"{p.spath}/savestates/.rocknix/manifest-{a_id}.json"
    raw = backend_bytes(mpath)
    f += not check(raw is not None, "the manifest reached the cloud under savestates/.rocknix/",
                   f"no manifest at {mpath} after the exit path (A14)")
    if raw is not None:
        try:
            m = json.loads(raw)
        except ValueError:
            m = {}
        pushed = m.get("entries", {}).get(state) if isinstance(m, dict) else None
        f += not check(bool(pushed) and pushed.get("sha256") == sha(sbytes),
                       "its entry for the state carries the planted bytes' sha256 (#22)",
                       "the pushed manifest has no entry for the state, or its sha256 is not the planted bytes' (#22)")
        kind = backend("backend").strip()
        rh = (pushed or {}).get("remote_hash", "unset")
        f += not check((rh is None) if kind == "webdav" else rh not in (None, "unset"),
                       f"remote_hash is {'null' if kind == 'webdav' else 'non-null'} on {kind}",
                       f"remote_hash is {rh!r} on {kind}")
    listed = p.a.run("cloud_content_backup --list 2>/dev/null || true").split()
    f += not check("savestates" not in listed, "the ROMs-and-BIOS tier never offers savestates",
                   "the content tier offers the savestates directory (the manifest would ride twice)")
    return f


def fx_a5(p):
    """A5: a test-only reader answers "this game, newest first, thumbnail,
    producing device, winning side" from the cloud store alone, on a second
    device that never made the decision."""
    f = 0
    rel = "savestates/Decided.state1"
    p.both_changed(rel, os.urandom(4001), os.urandom(4002), os.urandom(4003))
    p.a.write(p.path(rel + ".png"), b"\x89PNG a's thumbnail")
    rc, _ = run_rc(p.a, APPLY.format(unit=shlex.quote(rel), side="left"))
    store = p.saves_remote.rstrip("/") + "-discarded"
    # The reader, on b: the store listed and every record read as one line;
    # nothing local consulted.
    reader = ("R=$(rclone listremotes 2>/dev/null | head -1); S=" + shlex.quote(store) + "; "
              "rclone lsf -R --files-only \"${R}${S}\" 2>/dev/null | while IFS= read -r r; do "
              "case \"$r\" in */record.json|record.json) rclone cat \"${R}${S}/${r}\" | jq -c . ;; "
              "*) echo \"MEMBER $r\" ;; esac; done")
    out = p.b.run(reader, check=False)
    records, members = [], []
    for line in out.splitlines():
        if line.startswith("MEMBER "):
            members.append(line[7:])
            continue
        try:
            records.append(json.loads(line))
        except ValueError:
            pass
    f += not check(bool(records), "b read a decision record from the store",
                   f"NO RECORD IN THE STORE at {epath(store)} (apply exit {rc}) (A5)")
    if records:
        r = sorted(records, key=lambda r: r.get("decided_at", ""), reverse=True)[0]
        want = {"decided_at": r.get("decided_at"),
                "producer": (r.get("loser") or {}).get("producer") or r.get("producer"),
                "winner side": (r.get("winner") or {}).get("side")}
        f += not check(all(want.values()), "the newest record names when, the producing device and the winning side",
                       f"the record lacks {[k for k, v in want.items() if not v]}")
        f += not check(any(m.endswith(".png") for m in members), "the loser's thumbnail travelled with it",
                       "no thumbnail beside the record")
    return f


def fx_retention(p):
    """The retention ordering (#22 R9): the loser and its record are verified
    in the cloud before the winner replaces anything. Killed between the two,
    the loser is in the store, the head is unchanged, the device's copy is
    still its own."""
    f = 0
    rel = "saves/Ordered.srm"
    v = {"H0": os.urandom(65536), "HA": os.urandom(65537), "HB": os.urandom(65538)}
    p.both_changed(rel, v["H0"], v["HA"], v["HB"])
    store = epath(p.saves_remote.rstrip("/") + "-discarded")
    # KEEP LEFT: the cloud's HB wins; a's HA is the loser, pushed to the store
    # first. At 8 KiB/s a 64 KiB transfer takes eight seconds, so the record
    # is on the remote well before the winner's replacement completes.
    p.a.run("rm -f /tmp/qa-apply.out; (RCLONE_BWLIMIT=8k setsid " + APPLY.format(unit=shlex.quote(rel), side="left")
            + " >/tmp/qa-apply.out 2>&1 &)")
    seen = False
    for _ in range(160):
        time.sleep(0.25)
        if any(r.endswith("record.json") for r in backend_files(store)):
            seen = True
            break
        if not p.a.run("pgrep -x cloud_reconcile >/dev/null && echo running", check=False).strip():
            break
    p.a.run("pkill -9 -x rclone; pkill -9 -x cloud_reconcile; true", check=False)
    tail = p.a.run("tail -c 120 /tmp/qa-apply.out 2>/dev/null || true", check=False).strip()
    f += not check(seen, "the loser's record appeared in the store (the kill point)",
                   f"no record.json ever appeared under {store} (apply said: {tail!r})")
    if seen:
        stored = [sha(backend_bytes(f"{store}/{r}") or b"") for r in backend_files(store) if not r.endswith("record.json")]
        f += not check(sha(v["HA"]) in stored, "the loser's bytes are in the store, hash-equal",
                       f"the store holds {[name_of(x, v) for x in stored]}, not HA")
    f += not check(p.cloud_sha(rel) == sha(v["HB"]), "the head is unchanged",
                   f"the head became {name_of(p.cloud_sha(rel), v)}")
    f += not check(p.a.sha(p.path(rel)) == sha(v["HA"]), "the device's copy was not replaced before the loser was verified",
                   f"the device's copy became {name_of(p.a.sha(p.path(rel)), v)}")
    return f


PAIR_FIXTURES = [
    ("A1", "both changed after a first pass: every writer, this device's copy newer and older", fx_a1),
    ("A2", "a failed push retried; an equal-size, equal-mtime change after a first pass", fx_a2),
    ("A3", "CHANGE CLOUD FOLDER to a folder holding different saves", fx_a3),
    ("A8", "a torn N64 pair: interrupted after one member, held, then cleared", fx_a8),
    ("A9", "delete and renumber; a retired hash put back; rm; an unmounted, empty, or empty-cloud root", fx_a9),
    ("A11", "a cloned device id refuses to publish", fx_a11),
    ("A12", "a legacy RESTOREPATH unlike BACKUPPATH: migrated, warned, nothing touched", fx_a12),
    ("A14", "the manifest step: under savestates/.rocknix/, sha256, remote_hash per backend, one tier", fx_a14),
    ("A5", "the discarded-saves reader, from the second device", fx_a5),
    ("RETENTION", "the retention ordering: killed after the loser is stored, before the winner replaces", fx_retention),
]


def run_pair(a, b, root, remote, args, settings):
    failures = 0
    only = {k.strip().upper() for k in args.only.split(",")} if args.only else None
    p = Pair(a, b, root, settings)
    # The cache directory holds each device's stamps and selections; the
    # fixtures wipe it between runs, so it is carried across and put back.
    had = {d: snapshot_cache(d) for d in (a, b)}
    try:
        for key, title, fn in PAIR_FIXTURES:
            if only and key not in only:
                continue
            step(f"{key} -- {title}")
            try:
                failures += fn(p)
            except Fail as e:
                failures += 1
                print(f"    FAIL  {e}")
        if not only or "CONTRACT" in only:
            for kind in args.transport.split(","):
                failures += run_contract(p, kind.strip(), args)
    finally:
        p.reset()
        for d in (a, b):
            restore_cache(d, had[d])
    return failures


# ===========================================================================
# #86: where the device's identity comes from -- one device, and the cloud
# ===========================================================================
#
# The single-device suite proves what a device does with its id; this proves
# where the id comes from. Both handhelds printed the same hash, ee5013fc56,
# because every kernel that builds in the IPv6 sit tunnel has a sit0 that
# sorts before wlan0, `ethtool -P sit0` says "not set", and the old
# permanent_address accepted the string "notset" as a seed. The VM's kernel
# has sit as a module and its eth0 sorts first, so it never hit the trap by
# accident; here sit is loaded and the functions of the staged script are run
# with the interface list narrowed to sit0 -- by overriding usable_interfaces
# in the harness's own shell after sourcing the script, never through a hook
# in the product. A macvlan on eth0 stands in for an interface the name list
# does not know: it is ARPHRD_ETHER with no bus device behind it, so only the
# sysfs tests can refuse it. The restore half needs the QA endpoint, which is
# why this is its own registry and not a capture fixture.

# md5("notset|unknown")[:10]: the hash every affected device carried.
POISONED = hashlib.md5(b"notset|unknown").hexdigest()[:10]
assert POISONED == "ee5013fc56"

A15_DRIVER = "/tmp/qa-a15-fn"
A15_HOST = "A15HOST"
A15_PLANT = "/tmp/qa-a15-plant"
A15_ASIDE = "/tmp/qa-a15-aside"      # the device's own manifest working copies, for the run
A15_MACVLAN = "qa0mv"                # type 1, no device link: only the sysfs tests refuse it


def fx_a15(dev, root, remote, settings):
    """A15 (#86): the seed is a MAC or nothing.

    (a) With sit0 present, the old pipeline yields "notset" for it (the trap
        is real on this kernel); permanent_address yields nothing for sit0
        and a MAC for eth0; the product's own interface list omits sit0.
        A macvlan on eth0 is type 1 with no device link and matches no name
        pattern, so only the sysfs tests can refuse it: the list omits it
        too, and permanent_address reaches eth0 past it.
    (b) A planted <hostname>-ee5013fc56 -- the RG35XX SP's shape -- heals on
        one run to <label>-<md5(MAC|unknown)[:10]>, which is the hash this
        guest already had, so the recipe is unchanged; the old id is kept in
        .previous, the change is in the cloud-sync log and the journal (both
        marked before the run, so only this run's lines count), and
        --previous lists the recorded id, then <label>-ee5013fc56, then
        <hostname>-ee5013fc56 for a hostname unlike the label. cloud_capture
        --full then carries manifest-<old id>.json to the new name, once.
    (c) An archive planted under the old folder is found by cloud_restore
        through the --previous tier, and the log names the folder and why;
        an archive in the device's own folder wins over it. With the upload
        marker saying the local archive was already sent -- as an old build
        left it after uploading to the old folder -- a backup still lands in
        the healed folder, the marker then names that folder, and the run
        after has nothing to send; the old folder is neither written to nor
        trimmed.
    (d) A second run returns the healed id and rewrites nothing -- mtimes
        moved back first, so a same-content rewrite would show; a healthy id
        that does not match this hardware is returned unchanged.
    (e) With no usable adapter the poisoned id is returned unchanged and
        nothing is written.
    (f) Without sit0 the two guessed names leave --previous: a device that
        never had one could not have written under the constant."""
    f = 0
    tool = dev.run("command -v cloud_device_id 2>/dev/null || true").strip()
    if not tool:
        raise Fail("cloud_device_id does not resolve on the device")
    print(f"    under test: {tool}")

    # What the fixture disturbs, captured before anything is written.
    saved_id = dev.run(f"cat {ID_FILE} 2>/dev/null || true")
    had_prev = dev.run(f"[ -e {ID_FILE}.previous ] && echo yes || echo no").strip() == "yes"
    saved_prev = dev.run(f"cat {ID_FILE}.previous 2>/dev/null || true")
    had_sit = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "yes"
    hostname = dev.run("hostname").strip()
    opt_line = dev.run(f"grep -m1 '^BACKUPFILE_RESTORE_OPTION=' {CONF} 2>/dev/null || true").strip()
    marker = f"{CACHE}/settings-backup.uploaded"
    had_marker = dev.run(f"[ -e {marker} ] && echo yes || echo no").strip() == "yes"
    saved_marker = dev.run(f"cat {marker} 2>/dev/null || true")
    # What cloud_capture --full leaves in the cache besides the manifest: its
    # stamp and stage directory. Removed afterwards only if this run made them.
    capture_litter = [x for x in (f"{CACHE}/last-capture", f"{CACHE}/stage")
                      if dev.run(f"[ -e {x} ] && echo yes || echo no").strip() == "no"]
    # The device's manifest working copies, whatever their names: (b) plants
    # one under the poisoned id and expects it under the healed one, and a
    # real one under either name would be mistaken for the fixture's.
    dev.run(f"rm -rf {A15_ASIDE}; mkdir -p {A15_ASIDE}; "
            f"for m in {CACHE}/manifest-*.json; do [ -e \"$m\" ] && mv \"$m\" {A15_ASIDE}/; done; true", check=False)
    settings_remote = settings.get("SETTINGS_REMOTE") or settings.get("SYNCPATH_BACKUP") or ""
    if not settings_remote:
        raise Fail("no SETTINGS_REMOTE in the harness's settings; cannot plant a folder")
    base = f"{remote}:{settings_remote}"
    broot = f"{root}/backup"
    a15_save = f"{root}/saves/qa-a15.srm"
    folders = []
    mv_made = False

    # One function of the staged script, in a shell that has sourced every
    # definition but the final dispatch line. A15_IFACES, when set, replaces
    # usable_interfaces in that shell -- the narrowing lives here.
    driver = """#!/bin/bash
tool="$1"; fn="$2"; shift 2
eval "$(sed '/^main "\\$@"$/d' "${tool}")"
if [ -n "${A15_IFACES}" ]; then
    usable_interfaces() { tr ' ' '\\n' <<< "${A15_IFACES}"; }
fi
"${fn}" "$@"
"""
    dev.write(A15_DRIVER, driver.encode())
    dev.run(f"chmod +x {A15_DRIVER}")

    def fn(name, ifaces=None):
        env = f"A15_IFACES={shlex.quote(ifaces)}" if ifaces is not None else ""
        return run_rc(dev, f"{A15_DRIVER} {shlex.quote(tool)} {name}", env=env)

    def id_file():
        return dev.run(f"cat {ID_FILE} 2>/dev/null || true").strip()

    def prev_file():
        return dev.run(f"cat {ID_FILE}.previous 2>/dev/null || true").split()

    def mtime(path):
        # Nanoseconds. %Y is whole seconds, and a run that finishes in the
        # same second as the plant would hide a rewrite behind it.
        return dev.run(f"stat -c '%y' {shlex.quote(path)} 2>/dev/null || true", check=False).strip()

    def journal_mark():
        # Line count, as log_mark does for the file: every earlier A15 run
        # left an identical "healed" line in the journal, so a tail of the
        # journal matched with or without this run writing one.
        return int(dev.run("journalctl -t cloud_device_id -o cat --no-pager 2>/dev/null | wc -l",
                           check=False).strip() or 0)

    def journal_since(mark):
        return dev.run(f"journalctl -t cloud_device_id -o cat --no-pager 2>/dev/null | tail -n +{mark + 1}",
                       check=False)

    def plant(folder, name, body):
        dev.write(f"{A15_PLANT}/{name}", body)
        dev.run(f"rclone copyto {shlex.quote(f'{A15_PLANT}/{name}')} {shlex.quote(f'{folder}/{name}')}")
        if folder not in folders:
            folders.append(folder)

    def listing(folder):
        return dev.run(f"rclone lsf --files-only {shlex.quote(folder + '/')} 2>/dev/null || true", check=False).split()

    try:
        # --- (a) ---------------------------------------------------------------
        print("    -- (a) the guard: sit0 yields nothing, eth0 yields a MAC")
        if not had_sit:
            dev.run("modprobe sit 2>/dev/null || true", check=False)
        sit_now = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "yes"
        f += not check(sit_now, "sit0 is present (modprobe sit)",
                       "sit0 could not be created; the trap cannot be reproduced on this guest")
        raw = dev.run("ethtool -P sit0 2>/dev/null | sed 's/.*: //' | tr -d ' \\r\\n'").strip()
        f += not check(raw == "notset",
                       f"the old pipeline turns `ethtool -P sit0` into {raw!r} -- the string both handhelds hashed",
                       f"`ethtool -P sit0` became {raw!r}, not 'notset'; this kernel does not reproduce the trap")
        stype = dev.run("cat /sys/class/net/sit0/type 2>/dev/null; [ -e /sys/class/net/sit0/device ] && echo device || echo no-device").split()
        etype = dev.run("cat /sys/class/net/eth0/type 2>/dev/null; [ -e /sys/class/net/eth0/device ] && echo device || echo no-device").split()
        print(f"          sit0: type {stype[0] if stype else '?'}, {stype[1] if len(stype) > 1 else '?'}; "
              f"eth0: type {etype[0] if etype else '?'}, {etype[1] if len(etype) > 1 else '?'}")
        rc, out = fn("permanent_address", "sit0")
        f += not check(rc != 0 and not out.strip(),
                       f"permanent_address yields nothing for sit0 (exit {rc})",
                       f"permanent_address ACCEPTED sit0: exit {rc}, {out.strip()!r}")
        rc, out = fn("usable_interfaces")
        listed = out.split()
        f += not check("eth0" in listed and "sit0" not in listed and "lo" not in listed,
                       f"the script's own usable_interfaces lists {listed} with sit0 present",
                       f"usable_interfaces listed {listed}")
        mac = dev.run("ethtool -P eth0 2>/dev/null | sed 's/.*: //' | tr -d ' \\r\\n'").strip()
        rc, out = fn("permanent_address", "eth0")
        f += not check(rc == 0 and out.strip() == mac
                       and re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac, re.I) is not None,
                       f"permanent_address yields eth0's permanent address, {mac}",
                       f"permanent_address gave {out.strip()!r} (exit {rc}) for eth0, whose address is {mac!r}")
        if not mac:
            raise Fail("eth0 has no permanent address; the rest of the fixture cannot run")
        expected_hash = hashlib.md5(f"{mac}|unknown".encode()).hexdigest()[:10]
        rc, out = fn("poisoned_hash")
        f += not check(out.strip() == POISONED,
                       f"the script derives the poisoned constant as {out.strip()}",
                       f"the script's poisoned_hash is {out.strip()!r}, not {POISONED}")
        # The sysfs tests on their own. sit0 is refused by its name as well,
        # so a script with the two tests deleted still passed the checks
        # above. A macvlan matches no name pattern and is ARPHRD_ETHER with
        # no bus device behind it -- the only thing that can refuse it is
        # the device-link test; `ethtool -P` on it says "not set", which is
        # the trap's own string.
        dev.run(f"ip link del {A15_MACVLAN} 2>/dev/null || true", check=False)
        rc_mv, out_mv = run_rc(dev, f"ip link add {A15_MACVLAN} link eth0 type macvlan")
        mv_made = rc_mv == 0
        if mv_made:
            mtype = dev.run(f"cat /sys/class/net/{A15_MACVLAN}/type 2>/dev/null; "
                            f"[ -e /sys/class/net/{A15_MACVLAN}/device ] && echo device || echo no-device").split()
            f += not check(mtype[:2] == ["1", "no-device"],
                           f"{A15_MACVLAN} (a macvlan on eth0) is type 1 with no device link: no name pattern catches it, only the sysfs tests can",
                           f"{A15_MACVLAN} is {mtype}; it does not isolate the sysfs tests")
            rc, out = fn("usable_interfaces")
            listed = out.split()
            f += not check("eth0" in listed and A15_MACVLAN not in listed,
                           f"usable_interfaces omits {A15_MACVLAN} and keeps eth0: {listed}",
                           f"usable_interfaces listed {listed}: the device-link test did not refuse {A15_MACVLAN}")
            rc, out = fn("permanent_address", f"{A15_MACVLAN} eth0")
            f += not check(rc == 0 and out.strip() == mac,
                           f"with {A15_MACVLAN} sorting first, permanent_address still yields eth0's address (valid_mac refuses its 'not set')",
                           f"permanent_address gave {out.strip()!r} (exit {rc}) with the list {A15_MACVLAN} eth0")
        else:
            f += not check(False, "",
                           f"could not create a macvlan {A15_MACVLAN} on eth0 (exit {rc_mv}: {out_mv.strip()[-80:]}); the sysfs tests are unproven")

        # --- (b) ---------------------------------------------------------------
        print("    -- (b) a poisoned stored id heals once")
        label = dev.run("cloud_device_id --label").strip()
        if not label:
            raise Fail("cloud_device_id --label printed nothing")
        # The hostname shape: ROCKNIX-ee5013fc56 on the RG35XX SP, whose id
        # predates the label. The label shape (the RG SP's) is then the
        # guessed line of --previous, covered on its own below.
        poisoned = f"{hostname}-{POISONED}"
        label_p = f"{label}-{POISONED}"
        expected = f"{label}-{expected_hash}"
        if hostname == label:
            print(f"          (hostname and label are both {label}: the two shapes of the constant collapse here)")
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}; rm -f {ID_FILE}.previous")
        mark = log_mark(dev)
        jmark = journal_mark()
        rc, out = run_rc(dev, "cloud_device_id")
        new_id = out.strip()
        f += not check(rc == 0 and new_id == expected,
                       f"{poisoned} healed to {new_id}",
                       f"cloud_device_id printed {new_id!r} (exit {rc}); expected {expected}")
        f += not check(id_file() == expected, "the id file holds the healed id",
                       f"the id file holds {id_file()!r}")
        f += not check(prev_file() == [poisoned],
                       f"the .previous file holds the old id once",
                       f".previous holds {prev_file()}")
        # The hash, not the whole id: the guest's stored id was written by the
        # image's own cloud_device_id, whose label rule may be older than the
        # staged script's (GENERICX64 from the hostname against GENERIC-X64
        # from HW_DEVICE, 2026-09-08). The recipe under test is the hash.
        before = saved_id.strip()
        before_hash = before.rsplit("-", 1)[-1] if before else ""
        if before_hash and before_hash != POISONED:
            f += not check(expected_hash == before_hash,
                           f"the healed hash {expected_hash} is the one this guest generated before the change ({before}): the recipe is unchanged",
                           f"the healed hash {expected_hash} differs from the guest's own {before}: THE RECIPE CHANGED")
            if before != new_id:
                print(f"          (label {before.rsplit('-', 1)[0]} -> {label}: the label rule, not the hash)")
        else:
            print(f"    SKIP  recipe check - the guest's own id ({before or 'none'}) is not a healthy one to compare with")
        legacy = dev.run("cloud_device_id --legacy").strip()
        f += not check(legacy == f"{hostname}-{expected_hash}",
                       f"--legacy is {legacy}: the hostname and the same hash",
                       f"--legacy is {legacy!r}; expected {hostname}-{expected_hash}")
        tail = log_since(dev, mark)
        f += not check(poisoned in tail and expected in tail and "[cloud_device_id]" in tail,
                       "the cloud-sync log records old -> new under the cloud_device_id tag",
                       f"the cloud-sync log does not: {tail.strip()[-200:]!r}")
        journal = journal_since(jmark)
        f += not check(expected in journal and poisoned in journal,
                       "and so does the journal (logger -t cloud_device_id), in a line this run wrote",
                       f"the journal gained nothing saying so: {journal.strip()[-200:]!r}")
        rc, out = run_rc(dev, "cloud_device_id --previous")
        lines = out.split()
        want = [poisoned] if hostname == label else [poisoned, label_p]
        f += not check(lines == want,
                       f"--previous lists {lines}: the recorded id, then <label>-{POISONED}"
                       + (" (which is the recorded one here)" if hostname == label else f"; <hostname>-{POISONED} is the recorded one"),
                       f"--previous listed {lines}; expected {want}")
        dev.run(f"hostname {A15_HOST}")
        rc, out = run_rc(dev, "cloud_device_id --previous")
        dev.run(f"hostname {shlex.quote(hostname)}")
        lines2 = out.split()
        want2 = want + [f"{A15_HOST}-{POISONED}"]
        f += not check(lines2 == want2,
                       f"with the hostname {A15_HOST}, --previous adds {A15_HOST}-{POISONED} last",
                       f"--previous listed {lines2}; expected {want2}")

        # The working copy follows the id. The boot pass is `cloud_capture
        # --full`, whose first act is to call cloud_device_id -- so on the
        # handhelds this is where the heal happens and where the manifest
        # written under the old id would be orphaned.
        print("    -- (b) cloud_capture --full carries the working copy to the healed id")
        man_old = f"{CACHE}/manifest-{poisoned}.json"
        man_new = f"{CACHE}/manifest-{expected}.json"
        dev.write(man_old, b'{"schema":1,"entries":{},"units":{},"retired":[]}\n')
        dev.write(a15_save, b"a15")   # --full refuses an empty root
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_capture --full")
        tail = log_since(dev, mark)
        old_there = dev.run(f"[ -e {shlex.quote(man_old)} ] && echo yes || echo no").strip() == "yes"
        new_ok = dev.run(f"jq -e '.entries' {shlex.quote(man_new)} >/dev/null 2>&1 && echo yes || echo no",
                         check=False).strip() == "yes"
        f += not check(not old_there and new_ok and "adopted" in tail and poisoned in tail and expected in tail,
                       f"cloud_capture --full adopted manifest-{poisoned}.json as manifest-{expected}.json and said so (exit {rc})",
                       f"exit {rc}; old manifest {'still there' if old_there else 'gone'}, new one "
                       f"{'parses' if new_ok else 'absent or unparsable'}; log: {tail.strip()[-300:]!r}")
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_capture --full")
        tail = log_since(dev, mark)
        f += not check("adopted" not in tail and "could not adopt" not in tail,
                       "a second --full adopts nothing more (the current name exists)",
                       f"the second --full logged: {tail.strip()[-300:]!r}")

        # --- (c) ---------------------------------------------------------------
        print("    -- (c) the old folder stays restorable; backup and retention never touch it")
        osn = os_name(dev)
        old_folder = f"{base}/{poisoned}"
        new_folder = f"{base}/{expected}"
        old_archive = f"2026_01_01-000000-{osn}_SETTINGS.tar.gz"   # the pre-label shape the RG35XX SP's folder holds
        backend("reset")
        dev.run(f"rm -rf {A15_PLANT}; mkdir -p {A15_PLANT} {shlex.quote(broot)}")
        plant(old_folder, old_archive, b"written under the shared id")
        dev.run(f"grep -q '^BACKUPFILE_RESTORE_OPTION=' {CONF} "
                f"&& sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|BACKUPFILE_RESTORE_OPTION=\"yes\"|' {CONF} "
                f"|| echo 'BACKUPFILE_RESTORE_OPTION=\"yes\"' >> {CONF}")
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_restore --yes --system-only")
        local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
        tail = log_since(dev, mark)
        f += not check(old_archive in local,
                       f"cloud_restore found the archive under {poisoned} (the hostname shape) through the --previous tier (exit {rc})",
                       f"restore brought back {local or 'nothing'} (exit {rc})")
        f += not check(poisoned in tail and "shared constant" in tail,
                       "and the log names the folder it took and why",
                       f"the log did not name the folder: {tail.strip()[-300:]!r}")
        own_archive = f"2026_01_02-000000-{label}-{osn}_SETTINGS.tar.gz"
        plant(new_folder, own_archive, b"written under the healed id")
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        mark = log_mark(dev)
        run_rc(dev, "cloud_restore --yes --system-only")
        local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
        tail = log_since(dev, mark)
        f += not check(own_archive in local and old_archive not in local,
                       "with an archive in its own folder, restore takes that one before the old folder's",
                       f"restore brought back {local or 'nothing'}")
        f += not check(f"own cloud folder ({expected})" in tail,
                       "and says it restored from the device's own folder",
                       f"the log did not: {tail.strip()[-300:]!r}")
        keep_raw = dev.run(f"grep -m1 '^CLOUD_BACKUP_KEEP=' {CONF} 2>/dev/null | cut -d= -f2 | tr -d '\"' || true").strip()
        keep = int(keep_raw) if keep_raw.isdigit() and 1 <= int(keep_raw) <= 20 else 3
        # More of this device's own labelled archives than retention keeps,
        # in the OLD folder: if retention reached it, some would go.
        old_own = [f"2026_01_{d:02d}-000000-{label}-{osn}_SETTINGS.tar.gz" for d in range(3, 3 + keep + 2)]
        for name in old_own:
            plant(old_folder, name, name.encode())
        old_before = sorted(listing(old_folder))
        upload = f"2026_02_01-000000-{label}-{osn}_SETTINGS.tar.gz"
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        dev.write(f"{broot}/{upload}", b"this run's archive")
        # The regression: the archive has not changed since it was last sent,
        # and the marker says so -- the bare hash an old build wrote after
        # uploading to the OLD folder. A game-exit backup on the new build
        # runs from exactly this state, and a marker that knew only what was
        # sent answered "nothing to send" and left the healed folder empty.
        # The hash is computed as cloud_backup computes it: md5 of the
        # md5sum listing of the archives at the root of SETTINGS_BACKUPS.
        local_sum = dev.run(f"md5sum {shlex.quote(broot)}/*.tar.gz | md5sum | cut -d' ' -f1").strip()
        dev.run(f"printf '%s\\n' {local_sum} > {marker}")
        mark = log_mark(dev)
        rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
        new_list = listing(new_folder)
        old_after = sorted(listing(old_folder))
        f += not check(rc == 0 and upload in new_list,
                       f"with the marker saying this archive was already sent (an old build's marker, from the old folder), the backup still landed in the healed folder {expected} (exit {rc})",
                       f"the backup did not land in {expected} (exit {rc}): {new_list}; log: {log_since(dev, mark).strip()[-200:]!r}")
        f += not check("device.json" in new_list,
                       "and wrote the healed folder's device.json",
                       f"no device.json in {expected}: {new_list}")
        now_marker = dev.run(f"cat {marker} 2>/dev/null || true").strip()
        f += not check(now_marker == f"{local_sum} {new_folder}",
                       f"the marker now records where as well as what: {now_marker}",
                       f"the marker reads {now_marker!r}; expected {local_sum} {new_folder}")
        mark = log_mark(dev)
        rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
        tail = log_since(dev, mark)
        # The marker's own line, not the transfer banner (which names the
        # folder on every run), and no upload: a marker that never learnt
        # the new shape would send 17 MB on every game exit.
        f += not check(rc == 0 and f"unchanged since the last upload to {new_folder}" in tail and "Uploading" not in tail,
                       "and the run after that has nothing to send, and sends nothing",
                       f"the run after: exit {rc}, log {tail.strip()[-300:]!r}")
        f += not check(upload not in old_after and old_after == old_before
                       and all(n in old_after for n in [old_archive] + old_own),
                       f"nothing was written to or removed from {poisoned}: it still holds its {len(old_before)} archives",
                       f"THE OLD FOLDER CHANGED: before {old_before}, after {old_after}")

        # --- (d) ---------------------------------------------------------------
        print("    -- (d) a healthy stored id is left alone")
        touch_offset(dev, ID_FILE, -5)
        touch_offset(dev, f"{ID_FILE}.previous", -5)
        m_id, m_prev = mtime(ID_FILE), mtime(f"{ID_FILE}.previous")
        rc, out = run_rc(dev, "cloud_device_id")
        f += not check(out.strip() == expected and id_file() == expected and prev_file() == [poisoned]
                       and mtime(ID_FILE) == m_id and mtime(f"{ID_FILE}.previous") == m_prev,
                       "a second run returns the healed id and rewrites nothing (the id file and .previous keep their mtimes)",
                       f"second run: printed {out.strip()!r}, file {id_file()!r} (mtime {m_id} -> {mtime(ID_FILE)}), "
                       f".previous {prev_file()} (mtime {m_prev} -> {mtime(f'{ID_FILE}.previous')})")
        healthy = "Some-Other-Handheld-0123456789"
        dev.run(f"printf '%s\\n' {healthy} > {ID_FILE}")
        touch_offset(dev, ID_FILE, -5)
        m_id = mtime(ID_FILE)
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_device_id")
        f += not check(out.strip() == healthy and id_file() == healthy and prev_file() == [poisoned]
                       and mtime(ID_FILE) == m_id and healthy not in log_since(dev, mark),
                       "a healthy id that does not match this hardware is returned unchanged and not rewritten (the module-swap case)",
                       f"printed {out.strip()!r}, file {id_file()!r} (mtime {m_id} -> {mtime(ID_FILE)}), .previous {prev_file()}")

        # --- (e) ---------------------------------------------------------------
        print("    -- (e) no adapter, no healing")
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}; rm -f {ID_FILE}.previous")
        touch_offset(dev, ID_FILE, -5)
        stamp_before = mtime(ID_FILE)
        mark = log_mark(dev)
        rc, out = fn("main", "sit0")
        stamp_after = mtime(ID_FILE)
        f += not check(rc == 0 and out.strip() == poisoned,
                       f"with the interface list narrowed to sit0 the poisoned id is returned unchanged (exit {rc})",
                       f"printed {out.strip()!r} (exit {rc}); expected {poisoned}")
        untouched = (id_file() == poisoned and not prev_file()
                     and stamp_before == stamp_after
                     and "healed" not in log_since(dev, mark))
        f += not check(untouched, "and nothing was written: the id file keeps its mtime, no .previous, no log line",
                       f"file {id_file()!r} (mtime {stamp_before} -> {stamp_after}), .previous {prev_file()}")

        # --- (f) ---------------------------------------------------------------
        print("    -- (f) without sit0 the guessed names are not offered")
        # Under a hostname unlike the recorded id's, so that both guessed
        # names -- <label>-P and <hostname>-P -- would be new lines if the
        # gate let them through; with the real hostname the second collapses
        # into the recorded id and an ungated script passes by dedup.
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}.previous")
        rc_rm, out_rm = run_rc(dev, "rmmod sit")
        sit_gone = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "no"
        if sit_gone:
            dev.run(f"hostname {A15_HOST}")
            rc, out = run_rc(dev, "cloud_device_id --previous")
            dev.run(f"hostname {shlex.quote(hostname)}")
            lines = out.split()
            f += not check(lines == [poisoned],
                           f"with no sit0 (hostname {A15_HOST}), --previous lists {lines}: the recorded id only -- a device that never had a sit0 could not have hashed 'notset'",
                           f"--previous listed {lines} with no sit0; expected [{poisoned}]")
            if had_sit:
                dev.run("modprobe sit 2>/dev/null || true", check=False)
        else:
            f += not check(False, "", f"sit could not be unloaded (exit {rc_rm}: {out_rm.strip()[-80:]}); the sit0 gate is unproven")
    finally:
        # Everything back: the hostname, the identity, sit, the macvlan, the
        # settings-restore option, the upload marker, the manifests, the
        # planted folders, the scratch archives, the driver.
        dev.run(f"hostname {shlex.quote(hostname)}", check=False)
        if saved_id.strip():
            dev.write(ID_FILE, saved_id.encode())
        else:
            dev.run(f"rm -f {ID_FILE}", check=False)
        if had_prev:
            dev.write(f"{ID_FILE}.previous", saved_prev.encode())
        else:
            dev.run(f"rm -f {ID_FILE}.previous", check=False)
        if not had_sit:
            dev.run("rmmod sit 2>/dev/null || true", check=False)
        if mv_made:
            dev.run(f"ip link del {A15_MACVLAN} 2>/dev/null || true", check=False)
        if opt_line:
            dev.run(f"sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|{opt_line}|' {CONF}", check=False)
        else:
            dev.run(f"sed -i '/^BACKUPFILE_RESTORE_OPTION=/d' {CONF}", check=False)
        if had_marker:
            dev.write(marker, saved_marker.encode())
        else:
            dev.run(f"rm -f {marker}", check=False)
        dev.run(f"rm -f {CACHE}/manifest-*.json; "
                f"for m in {A15_ASIDE}/manifest-*.json; do [ -e \"$m\" ] && mv \"$m\" {CACHE}/; done; "
                f"rm -rf {A15_ASIDE} {shlex.quote(a15_save)}; true", check=False)
        for x in capture_litter:
            dev.run(f"rm -rf {shlex.quote(x)}", check=False)
        for folder in folders:
            dev.run(f"rclone purge {shlex.quote(folder)} >/dev/null 2>&1 || true", check=False)
        dev.run(f"rm -rf {A15_PLANT} {A15_DRIVER}; rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip",
                check=False)
        now = id_file()
        sit_after = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no", check=False).strip() == "yes"
        mv_after = dev.run(f"[ -d /sys/class/net/{A15_MACVLAN} ] && echo yes || echo no", check=False).strip() == "yes"
        print(f"    put back: id {now or 'none'}{' (as before)' if now == saved_id.strip() else ' (DIFFERS from ' + (saved_id.strip() or 'none') + ')'}, "
              f".previous {'restored' if had_prev else 'absent'}, marker {'restored' if had_marker else 'absent'}, "
              f"sit0 {'present' if sit_after else 'absent'} (was {'present' if had_sit else 'absent'}), "
              f"{A15_MACVLAN} {'STILL PRESENT' if mv_after else 'gone'}, hostname {dev.run('hostname', check=False).strip()}")
    return f


SOLO_FIXTURES = [
    ("A15", "the seed is a MAC or nothing: sit0 and a macvlan are refused, a poisoned id heals once, "
            "the working copy and the next backup follow it, its old folder stays restorable", fx_a15),
]


def run_solo(dev, root, remote, args, settings, only):
    """The single-device cloud fixtures, on the first (only) device."""
    failures = 0
    for key, title, fn in SOLO_FIXTURES:
        if only and key not in only:
            continue
        step(f"{key} -- {title}")
        try:
            failures += fn(dev, root, remote, settings)
        except Fail as e:
            failures += 1
            print(f"    FAIL  {e}")
    return failures


# ===========================================================================
# #21's producer: cloud_capture, on one device, with no cloud
# ===========================================================================
#
# The capture fixtures drive /usr/bin/cloud_capture the way EmulationStation
# does at game exit (--system/--rom/--emulator/--core/--started/--exit), the
# way the save-state manager does (--retire, --rescan) and the way the boot
# autostart does (--full), and read the working copy it writes at
# /storage/.cache/cloud_sync/manifest-<device-id>.json. The producer opens no
# socket and spawns no rclone, so these need neither MinIO nor a second guest:
# --only CAP1,...,CAP10 prepares the device locally (prepare_local) and the
# QA endpoint is never asked for anything.
#
# The harness copies nothing onto the device. Stage the producer and its two
# siblings by hand before a run -- they are resolved beside $0, so all three
# must sit in the same directory:
#
#     scp -i /tmp/rocknix-vm-pair/qa-key -P 10022 \
#         projects/ROCKNIX/packages/network/rclone/sources/{cloud_capture,cloud_device_id,cloud_saves_root} \
#         root@127.0.0.1:/tmp/qa-bin/ && ssh ... chmod +x /tmp/qa-bin/cloud_*
#     ./tools/cloud-round-trip --host root@127.0.0.1 --port 10022 --identity /tmp/rocknix-vm-pair/qa-key \
#         --path-prefix /tmp/qa-bin --only CAP1,CAP2,CAP3,CAP4,CAP5,CAP6,CAP7,CAP8,CAP9,CAP10,CAP11
#
# CAP10 (d) also reads autostart/102-cloud-saves: stage it into the same
# directory to check the repo's copy rather than the image's. CAP11 copies
# the staged producer beside a cloud_device_id shim of its own.
#
# What the harness cannot prove is ES's half -- that the call is made outside
# the cloudsaves.gameexit gate, on a nonzero exit, with the --core= token of
# the finished command -- because it cannot drive EmulationStation. Those are
# the six VM procedures in the #21 design; each fixture's docstring says
# which half it covers.

ISO_UTC = re.compile(r"^\d{4}-\d\d-\d\dT\d\d:\d\d:\d\dZ$")


def require_capture(dev):
    """The producer must resolve under the PATH prefix. It is staged by hand;
    the harness copies nothing, so its absence is a setup failure, not a
    finding about the script."""
    have = dev.run("command -v cloud_capture 2>/dev/null || true").strip()
    if not have:
        raise Fail("cloud_capture does not resolve on the device (with --path-prefix): stage "
                   "projects/ROCKNIX/packages/network/rclone/sources/cloud_capture into the prefix directory "
                   "beside cloud_device_id and cloud_saves_root, chmod +x -- the harness copies nothing")
    return have


def local_reset(dev, root):
    """Empty the saves root and the cache -- manifest, stage, stamps, the
    saves-root record -- so what one fixture leaves cannot pass the next. No
    backend("reset"): there is no cloud in a capture run."""
    dev.run(f"rm -rf {shlex.quote(root)} {CACHE}; mkdir -p {shlex.quote(root)} {CACHE}")


def manifest_text(dev):
    """(present, text) of the working copy. Presence is asserted with [ -e ],
    never inferred from an empty stdout (blindspot 31: a helper that reads
    through the wrong path agrees with itself)."""
    out = dev.run(f"f={CACHE}/manifest-$(cloud_device_id 2>/dev/null).json; "
                  "if [ -e \"$f\" ]; then echo PRESENT; cat \"$f\"; else echo ABSENT; fi")
    head, _, rest = out.partition("\n")
    return head.strip() == "PRESENT", rest


def manifest_of(dev):
    """The parsed working copy, or None when the file is absent. A file that
    is present but does not parse raises -- the fixture that expects one
    (CAP9 d) reads manifest_text itself."""
    present, text = manifest_text(dev)
    if not present:
        return None
    try:
        return json.loads(text)
    except ValueError as e:
        raise Fail(f"the manifest is present but does not parse: {e}")


def manifest_stat(dev):
    """(mtime, inode, sha256) of the working copy, or None when absent. All
    three, because ext4 keeps seconds: a rewrite within the same second is
    invisible by mtime alone (I8 is asserted on all three)."""
    out = dev.run(f"f={CACHE}/manifest-$(cloud_device_id 2>/dev/null).json; "
                  "if [ -e \"$f\" ]; then stat -c '%Y %i' \"$f\"; sha256sum \"$f\" | cut -c1-64; else echo ABSENT; fi")
    fields = out.split()
    if fields == ["ABSENT"]:
        return None
    return int(fields[0]), int(fields[1]), fields[2]


def entry(m, rel):
    return ((m or {}).get("entries") or {}).get(rel)


def members(m, unit):
    return (((m or {}).get("units") or {}).get(unit) or {}).get("members")


def nulls(e, keys):
    """Every key present and null -- absent is not null (§6)."""
    return bool(e) and all(k in e and e[k] is None for k in keys)


def capture(dev, root, system, rom, emulator="retroarch", core="mgba", started=0, exit_code=None, env=""):
    """Run the producer the way ES does at exit, every value quoted the way
    shellQuote would. --started 0 by default: the explicit record-everything
    form, since a fixture's planted files predate any real session."""
    cmd = (f"cloud_capture --system {shlex.quote(system)} --rom {shlex.quote(rom)} "
           f"--emulator {shlex.quote(emulator)} --core {shlex.quote(core)} --started {int(started)}")
    if exit_code is not None:
        cmd += f" --exit {int(exit_code)}"
    return run_rc(dev, cmd, env)


def plant(dev, root, rel, data):
    """Write one member; hand its bytes back so the caller can hash them."""
    dev.write(f"{root}/{rel}", data)
    return data


def plant_unit(dev, root, system, stem, save=None, states=None, auto=None, png=None, romdir=None):
    """Plant a libretro unit's members with random bodies and return
    {relative path: bytes}. `states` maps slot -> size (slot 0 is the bare
    .state); `png` is the thumbnail size beside every state and auto, or None
    for none; `romdir` is where the .srm goes (the ROM's directory, because
    savefiles_in_content_dir is true), defaulting to <system>."""
    romdir = romdir or system
    planted = {}
    if save is not None:
        planted[f"{romdir}/{stem}.srm"] = os.urandom(save)
    for slot, size in sorted((states or {}).items()):
        rel = f"savestates/{system}/{stem}.state{'' if slot == 0 else slot}"
        planted[rel] = b"#RZIPv" + os.urandom(size)
        if png:
            planted[rel + ".png"] = b"\x89PNG" + os.urandom(png)
    if auto is not None:
        rel = f"savestates/{system}/{stem}.state.auto"
        planted[rel] = b"#RZIPv" + os.urandom(auto)
        if png:
            planted[rel + ".png"] = b"\x89PNG" + os.urandom(png)
    for rel, data in planted.items():
        dev.write(f"{root}/{rel}", data)
    return planted


def stage_count(dev):
    return int(dev.run(f"ls {CACHE}/stage 2>/dev/null | wc -l").strip() or 0)


def stage_sha(dev, digest):
    """sha256sum of the sealed copy named by a hash -- an integrity check,
    not a tautology, because the name is the hash the producer recorded."""
    return dev.sha(f"{CACHE}/stage/{digest}")


def iso_mtime(dev, path):
    """A file's mtime rendered the way the producer renders it."""
    return dev.run(f"date -u -d @$(stat -c %Y {shlex.quote(path)}) +%FT%TZ").strip()


def last_capture(dev):
    """The durable stamp as (epoch, rc, mode, unit, "emu-exit=<N|?>",
    "<emulator>/<core>"), or None for anything else -- a four-field stamp
    from before the launch's exit and the frozen pair were carried is None
    too, so every check on the trailing fields fails against it. emu-exit is
    what ES passed to --exit: runemu.sh's 0/1, not the emulator's code. The
    unit may contain spaces (a ROM stem); the two trailing fields never do,
    so the parse takes three fields from the front and two from the back."""
    line = dev.run(f"cat {CACHE}/last-capture 2>/dev/null || true").strip()
    parts = line.rsplit(None, 2)
    if len(parts) != 3 or not parts[1].startswith("emu-exit=") or "/" not in parts[2]:
        return None
    front = parts[0].split(None, 3)
    return (*front, parts[1], parts[2]) if len(front) == 4 else None


def failures_lines(dev):
    return int(dev.run(f"wc -l < {CACHE}/capture-failures 2>/dev/null || echo 0").strip() or 0)


class Solo:
    """One device, its scratch saves root and the producer's working copy.
    No cloud: nothing here calls backend() or reads rclone.conf."""

    def __init__(self, a, root):
        self.a, self.root = a, root
        self.id = a.run("cloud_device_id 2>/dev/null || true").strip()
        self.manifest = f"{CACHE}/manifest-{self.id}.json"
        self.stage = f"{CACHE}/stage"

    def path(self, rel):
        return f"{self.root}/{rel}"

    def reset(self):
        """Every fixture starts here: the producer resolves, and the root and
        cache are empty."""
        require_capture(self.a)
        local_reset(self.a, self.root)


def fx_cap1(p):
    """CAP1: capture on every exit -- with the transfer lock held by another
    process, no route, an rclone shim counting spawns, and exit 1 from the
    emulator. The unit is recorded; each seal is the planted bytes; the
    thumbnails are declared members with no entry; the .state.auto.bak decoy
    is nothing; nothing is written into the saves tree; stdout stays empty
    (ES reads that pipe); no rclone was spawned; the durable stamp names the
    unit.

    The toggle-off half is ES's: FileData.cpp calls the producer outside the
    cloudsaves.gameexit gate. VM procedure (1) of the #21 design proves it
    (cloudsaves.gameexit=0, launch and exit a game, read the manifest); the
    harness cannot drive EmulationStation."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    unit = "gba:Game"
    srm, s1, auto = "gba/Game.srm", "savestates/gba/Game.state1", "savestates/gba/Game.state.auto"
    planted = plant_unit(a, root, "gba", "Game", save=604, states={1: 40 * 1024}, auto=30 * 1024, png=3 * 1024)
    plant(a, root, auto + ".bak", b"ES's launch-time swap (SaveState.cpp), never a member")
    a.run("touch /tmp/qa-mark; sleep 1")
    # One guest command: the lock held on fd 9 (run_steps' recipe), the ip
    # shim that reports no route, the rclone shim that counts spawns.
    out = a.run(
        "mkdir -p /tmp/noroute /tmp/qa-shim; printf '#!/bin/sh\\nexit 0\\n' > /tmp/noroute/ip; chmod +x /tmp/noroute/ip; "
        "printf '#!/bin/sh\\necho \"$@\" >> /tmp/qa-spawns\\nexec /usr/bin/rclone \"$@\"\\n' > /tmp/qa-shim/rclone; "
        "chmod +x /tmp/qa-shim/rclone; rm -f /tmp/qa-spawns /tmp/qa-cap1.out /tmp/qa-cap1.err; "
        "exec 9>/var/run/cloud_sync.lock; flock -n 9 || echo HOLDER-FAILED; "
        f"PATH=/tmp/noroute:/tmp/qa-shim:$PATH cloud_capture --system gba --rom {shlex.quote(p.path('gba/Game.gba'))} "
        "--emulator retroarch --core mgba --started 0 --exit 1 >/tmp/qa-cap1.out 2>/tmp/qa-cap1.err; echo rc=$?; "
        "exec 9>&-", check=False)
    rc = next((int(w[3:]) for w in out.split() if w.startswith("rc=") and w[3:].lstrip("-").isdigit()), -1)
    f += not check("HOLDER-FAILED" not in out, "the test held the transfer lock itself (the setup)",
                   "could not take the lock to set up the test")
    f += not check(rc == 0, "capture exited 0 under a held lock, with no route, after exit 1 from the emulator",
                   f"capture exited {rc} (stderr: {a.run('tail -c 200 /tmp/qa-cap1.err 2>/dev/null || true').strip()!r})")
    m = manifest_of(a)
    f += not check(m is not None, "the manifest exists and parses", "no manifest was written")
    if m is None:
        a.run("rm -rf /tmp/noroute /tmp/qa-shim /tmp/qa-spawns /tmp/qa-mark", check=False)
        return f
    for rel in (srm, s1, auto):
        e = entry(m, rel) or {}
        want = sha(planted[rel])
        f += not check(e.get("sha256") == want == a.sha(p.path(rel)) and e.get("size") == len(planted[rel]),
                       f"{rel}: sha256 and size are the planted bytes'",
                       f"{rel}: {'no entry' if not e else 'sha256/size differ from the planted bytes'}")
    three = [entry(m, r) or {} for r in (srm, s1, auto)]
    f += not check([e.get("kind") for e in three] == ["save", "state", "auto"],
                   "kinds save/state/auto", f"kinds {[e.get('kind') for e in three]}")
    f += not check([e.get("slot") for e in three] == [None, 1, None],
                   "slots null/1/null", f"slots {[e.get('slot') for e in three]}")
    f += not check([e.get("screenshot") for e in three] == [None, s1 + ".png", auto + ".png"],
                   "the state and the auto name their .png as screenshot; the save has none",
                   f"screenshots {[e.get('screenshot') for e in three]}")
    f += not check(all(e.get("unit") == unit for e in three), f"unit {unit!r} on all three",
                   f"units {[e.get('unit') for e in three]}")
    prov = {k: three[1].get(k) for k in ("emulator", "core", "system", "rom")}
    f += not check(prov == {"emulator": "retroarch", "core": "mgba", "system": "gba", "rom": "Game.gba"},
                   "emulator/core/system/rom are the arguments, verbatim", f"provenance {prov}")
    f += not check(all(nulls(e, ("producer", "pub", "published_at", "replaces", "remote_hash")) for e in three),
                   "producer/pub/published_at/replaces/remote_hash are present and null",
                   "a first version carries a non-null (or absent) producer/pub/published_at/replaces/remote_hash")
    f += not check(all(isinstance(e.get("clock_synced"), bool) for e in three),
                   "clock_synced is a bool", f"clock_synced {[e.get('clock_synced') for e in three]!r}")
    f += not check(members(m, unit) == sorted(planted),
                   "units[gba:Game].members is the five planted paths, sorted, without the .bak",
                   f"members {members(m, unit)}")
    f += not check(not any(k.endswith(".png") for k in m.get("entries", {})),
                   "no entry is keyed on a .png (sidecars are members, not versions)",
                   f"png entries: {[k for k in m.get('entries', {}) if k.endswith('.png')]}")
    sealed = [(rel, stage_sha(a, (entry(m, rel) or {}).get("sha256", "")) == (entry(m, rel) or {}).get("sha256"))
              for rel in (srm, s1, auto)]
    f += not check(all(ok for _, ok in sealed), "stage/<sha> hashes to its own name for each version",
                   f"seals wrong or missing for {[rel for rel, ok in sealed if not ok]}")
    spawns = a.run("cat /tmp/qa-spawns 2>/dev/null || true").strip()
    f += not check(not spawns, "no rclone was spawned", f"rclone was spawned: {spawns[:80]!r}")
    newer = a.run(f"find {shlex.quote(root)} -newer /tmp/qa-mark 2>/dev/null || true").strip()
    f += not check(not newer, "nothing was written into the saves tree",
                   f"written into the saves tree: {newer.splitlines()[:3]}")
    size = a.run("wc -c < /tmp/qa-cap1.out 2>/dev/null || echo -1").strip()
    f += not check(size == "0", "stdout was empty (ES reads that pipe)", f"{size} byte(s) on stdout")
    stamp = last_capture(a)
    f += not check(stamp is not None and stamp[1] == "0" and stamp[2].split("!")[0] == "exit" and stamp[3] == unit,
                   f"{CACHE}/last-capture records rc 0, mode exit, the unit", f"last-capture is {stamp!r}")
    f += not check(stamp is not None and stamp[4] == "emu-exit=1" and stamp[5] == "retroarch/mgba",
                   "and carries the launch's exit as ES passed it (emu-exit=1: runemu.sh's 0/1, not the emulator's own code) "
                   "and the frozen pair retroarch/mgba, which only the exit path knew",
                   f"last-capture is {stamp!r}")
    a.run("rm -rf /tmp/noroute /tmp/qa-shim /tmp/qa-spawns /tmp/qa-mark /tmp/qa-cap1.out /tmp/qa-cap1.err", check=False)
    return f


def fx_cap2(p):
    """CAP2: the recorded core is the argument, never a default. gba's save is
    captured under snes9x2005_plus, then under mgba; a standalone with an
    empty --core records the emulator's name (§6: core is never empty).

    ES's half -- that the value is the --core= token of the finished command,
    read after setupSaveState, and that the call is ungated -- is proven by
    inspection of FileData.cpp (~656, ~764) and by VM procedures (1) and (3),
    not by the harness."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    rel, rom = "gba/Core.srm", p.path("gba/Core.gba")
    v1 = plant(a, root, rel, os.urandom(700))
    rc, _ = capture(a, root, "gba", rom, core="snes9x2005_plus")
    e1 = entry(manifest_of(a), rel) or {}
    f += not check(rc == 0 and e1.get("core") == "snes9x2005_plus" and e1.get("emulator") == "retroarch",
                   "core is snes9x2005_plus (not gba's default), emulator retroarch",
                   f"exit {rc}; core {e1.get('core')!r}, emulator {e1.get('emulator')!r}")
    time.sleep(1.1)   # captured_at keeps seconds
    plant(a, root, rel, os.urandom(701))
    rc, _ = capture(a, root, "gba", rom, core="mgba")
    e2 = entry(manifest_of(a), rel) or {}
    f += not check(e2.get("core") == "mgba", "the next version records mgba", f"core {e2.get('core')!r}")
    f += not check(e2.get("replaces") == sha(v1), "replaces is the first version's sha",
                   f"replaces {e2.get('replaces')!r}")
    f += not check((e2.get("captured_at") or "") > (e1.get("captured_at") or "") and ISO_UTC.match(e2.get("captured_at") or ""),
                   "captured_at advanced", f"captured_at {e1.get('captured_at')!r} -> {e2.get('captured_at')!r}")
    f += not check(nulls(e2, ("pub", "published_at")), "pub and published_at are still null",
                   f"pub {e2.get('pub')!r}, published_at {e2.get('published_at')!r}")
    plant(a, root, "n64/Empty.eep", os.urandom(2048))
    rc, _ = capture(a, root, "n64", p.path("n64/Empty.z64"), emulator="mupen64plus", core="")
    e3 = entry(manifest_of(a), "n64/Empty.eep") or {}
    f += not check(rc == 0 and e3.get("core") == "mupen64plus" and e3.get("emulator") == "mupen64plus",
                   "an empty --core is recorded as the emulator's name (never empty)",
                   f"exit {rc}; core {e3.get('core')!r}, emulator {e3.get('emulator')!r}")
    return f


def fx_cap3(p):
    """CAP3: the seal is an independent copy. (a) The sealed copy has one link
    and its own inode, and an in-place write to the source afterwards does
    not change it. (b) The negative control on the same filesystem: a hard
    link does follow the write, which is why the seal is a copy (D-CLOUD-034).
    (c) The seal guard's observed positive: a writer racing the copy of a
    64 MiB state; either a clean seal or a declined member, never an entry
    whose bytes are not in the stage."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    rel, rom = "savestates/gba/Seal.state1", p.path("gba/Seal.gba")
    src = shlex.quote(p.path(rel))
    plant(a, root, rel, b"#RZIPv" + os.urandom(2 * 1024 * 1024))
    rc, _ = capture(a, root, "gba", rom)
    e = entry(manifest_of(a), rel) or {}
    rec = e.get("sha256") or ""
    if rc != 0 or not rec:
        raise Fail(f"the setup capture recorded nothing (exit {rc})")
    links = a.run(f"stat -c '%h %i' {CACHE}/stage/{rec} 2>/dev/null || true").split()
    src_ino = a.run(f"stat -c %i {src}").strip()
    f += not check(links[:1] == ["1"] and len(links) == 2 and links[1] != src_ino,
                   "the seal has one link and its own inode", f"seal stat {links} vs source inode {src_ino}")
    a.run(f"dd if=/dev/urandom of={src} bs=4096 count=1 conv=notrunc 2>/dev/null; sync")
    f += not check(a.sha(p.path(rel)) != rec, "the in-place write to the source landed (the setup)",
                   "the mutation did not change the source; the check below would pass for the wrong reason")
    f += not check(stage_sha(a, rec) == rec, "stage/<sha> still hashes to its name after the source was rewritten",
                   "THE SEAL FOLLOWED AN IN-PLACE WRITE TO THE SOURCE (a link, not a copy)")
    size = a.run(f"stat -c %s {CACHE}/stage/{rec} 2>/dev/null || echo -1").strip()
    f += not check(str(e.get("size")) == size, "the recorded size is the sealed copy's", f"size {e.get('size')} vs seal {size}")

    # (b) the control: the scratch root and /storage/.cache are one filesystem
    # (/dev/vda2 on the VM), so ln makes a real hard link; /tmp is tmpfs and
    # would fail with EXDEV.
    rel2 = "savestates/gba/Seal.state2"
    src2 = shlex.quote(p.path(rel2))
    plant(a, root, rel2, b"#RZIPv" + os.urandom(1024 * 1024))
    linked = a.run(f"ln {src2} {CACHE}/qa-link 2>&1 && echo LINKED || true")
    same = a.run(f"stat -c '%h %i' {src2} {CACHE}/qa-link 2>/dev/null || true").split()
    f += not check(len(same) == 4 and same[0] == same[2] == "2" and same[1] == same[3],
                   "the control's premise, stated: qa-link and its source are one inode with two links",
                   f"the control is not a hard link (stat '%h %i' gives {same}); what it shows below proves nothing")
    h1 = a.sha(f"{CACHE}/qa-link")
    a.run(f"dd if=/dev/urandom of={src2} bs=4096 count=1 conv=notrunc 2>/dev/null; sync")
    h2 = a.sha(f"{CACHE}/qa-link")
    a.run(f"rm -f {CACHE}/qa-link")
    f += not check("LINKED" in linked and h1 and h2 and h1 != h2,
                   "the hard-linked variant follows the in-place write, which is why the seal is a copy (D-CLOUD-034)",
                   "the hard link did not follow the write -- the control proves nothing"
                   + ("" if "LINKED" in linked else f" (ln failed: {linked.strip()[:60]})"))

    # (c) a writer racing the seal of a big state. The writer is a script so
    # the wait below can find it by a pattern its own shell cannot match.
    big = "savestates/gba/Race.state1"
    bsrc = shlex.quote(p.path(big))
    a.run(f"mkdir -p $(dirname {bsrc}); head -c 67108864 /dev/urandom > {bsrc}; sync")
    a.write("/tmp/qa-cap3-writer.sh",
            (f"#!/bin/bash\nfor i in $(seq 2000); do dd if=/dev/urandom of={bsrc} bs=4096 count=1 "
             "seek=$((RANDOM % 16000)) conv=notrunc 2>/dev/null; done\n").encode())
    mark = log_mark(a)
    a.run("setsid bash /tmp/qa-cap3-writer.sh >/dev/null 2>&1 < /dev/null &")
    rc, _ = capture(a, root, "gba", p.path("gba/Race.gba"))
    a.run("for i in $(seq 200); do pgrep -f 'qa-cap[3]-writer' >/dev/null || break; sleep 0.2; done; rm -f /tmp/qa-cap3-writer.sh",
          check=False)
    e = entry(manifest_of(a), big)
    tail = log_since(a, mark)
    if e is not None:
        sealed = stage_sha(a, e.get("sha256", ""))
        f += not check(sealed == e.get("sha256"), "a clean seal: the entry's sha is a stage file hashing to its name",
                       "AN ENTRY WHOSE BYTES ARE NOT IN THE STAGE (sha recorded, seal absent or torn)")
    else:
        f += not check(rc == 1 and "changed while it was being sealed" in tail,
                       "the member changed under the seal three times and was declined (exit 1, WARN)",
                       f"no entry and no declined-seal WARN (exit {rc}): the guard neither sealed nor said why")
    return f


def fx_cap4(p):
    """CAP4: nothing changed, nothing rewritten, in all three modes (I8) --
    the manifest's mtime, inode and content all stand, the stage does not
    grow, and nothing above DEBUG is logged. Then the positive controls, so
    the check can fail: a touch changes the manifest and the entry's mtime
    but not its version; new bytes make a version; a deleted thumbnail leaves
    the declaration."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    unit, srm, s1 = "gba:Game", "gba/Game.srm", "savestates/gba/Game.state1"
    rom = p.path("gba/Game.gba")
    planted = plant_unit(a, root, "gba", "Game", save=604, states={1: 40 * 1024}, auto=30 * 1024, png=3 * 1024)
    rc, _ = capture(a, root, "gba", rom)
    m0, n0 = manifest_stat(a), stage_count(a)
    if rc != 0 or m0 is None:
        raise Fail(f"the setup capture recorded nothing (exit {rc})")
    e0 = entry(manifest_of(a), srm) or {}
    mark = log_mark(a)
    time.sleep(2)   # ext4 keeps seconds: a same-second rewrite is invisible by mtime alone

    def unchanged(label, rc, quiet=True):
        # A no-op exit or --full writes nothing and logs nothing above DEBUG
        # (I8). A --retire of a path nothing is known about is allowed its
        # one INFO line ("nothing known about ...; not recorded").
        loud = [l for l in log_since(a, mark).splitlines() if "[cloud_capture]" in l and "[DEBUG]" not in l] if quiet else []
        return not check(rc == 0 and manifest_stat(a) == m0 and stage_count(a) == n0 and not loud,
                         f"{label}: exit 0; manifest mtime/inode/sha and stage count unchanged"
                         + ("; nothing above DEBUG logged" if quiet else ""),
                         f"{label}: exit {rc}; stat {manifest_stat(a)} vs {m0}; stage {stage_count(a)} vs {n0}; "
                         f"logged {loud[:2]}")

    rc, _ = capture(a, root, "gba", rom)
    f += unchanged("a second exit with identical arguments", rc)
    for i in (1, 2):
        rc, _ = run_rc(a, "cloud_capture --full")
        f += unchanged(f"--full, pass {i}", rc)
    rc, _ = run_rc(a, "cloud_capture --retire savestates/gba/Nothing.state9")
    f += unchanged("--retire of a path with no entry and no file", rc, quiet=False)

    touch_offset(a, p.path(srm), 60)
    rc, _ = capture(a, root, "gba", rom)
    m1 = manifest_stat(a)
    e1 = entry(manifest_of(a), srm) or {}
    f += not check(rc == 0 and m1 is not None and all(x != y for x, y in zip(m1, m0)),
                   "a touch rewrote the manifest (mtime, inode and sha all changed)",
                   f"after a touch the manifest stat is {m1} against {m0}")
    f += not check(e1.get("mtime") == iso_mtime(a, p.path(srm)),
                   "the entry's mtime is the file's new value, ISO-UTC", f"mtime {e1.get('mtime')!r}")
    f += not check(all(e1.get(k) == e0.get(k) for k in ("sha256", "replaces", "captured_at")),
                   "sha256, replaces and captured_at stand (a touch is metadata, not a version)",
                   "a touch made a version: sha256/replaces/captured_at changed")
    plant(a, root, srm, os.urandom(605))
    rc, _ = capture(a, root, "gba", rom)
    e2 = entry(manifest_of(a), srm) or {}
    f += not check(e2.get("sha256") == a.sha(p.path(srm)) != e0.get("sha256") and e2.get("replaces") == e0.get("sha256"),
                   "new bytes made a version whose replaces is the old sha",
                   f"sha {e2.get('sha256', '')[:12]} replaces {e2.get('replaces')!r}")
    a.run(f"rm -f {shlex.quote(p.path(s1 + '.png'))}")
    rc, _ = capture(a, root, "gba", rom)
    m = manifest_of(a)
    f += not check((entry(m, s1) or {}).get("screenshot", "unset") is None,
                   "a deleted thumbnail refreshes the state's screenshot to null",
                   f"screenshot {(entry(m, s1) or {}).get('screenshot', 'unset')!r}")
    f += not check(members(m, unit) == sorted(k for k in planted if k != s1 + ".png"),
                   "and it left units[gba:Game].members", f"members {members(m, unit)}")
    return f


def fx_cap5(p):
    """CAP5: core_build is the pin of the core's package -- through the
    exception table and the regular rule -- and an unmapped core is
    "unknown", never empty. Against a planted pins file (CLOUD_CAPTURE_PINS,
    because /usr is read-only), mapped cases first so a negative cannot pass
    for the wrong reason. Every capture writes new bytes first: a repeat with
    only a different --core is an I8 no-op that would read back the previous
    entry (three earlier drafts of this fixture could not pass for that
    reason)."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    pins = {"mgba-lr": "1" * 40, "snes9x2005_plus-lr": "2" * 40, "vice-lr": "3" * 40,
            "neocd_lr": "4" * 40, "mupen64plus-sa": "5" * 40, "ffmpeg-lr": "6" * 40}
    a.write("/tmp/qa-pins", ("".join(f"{k} {v}\n" for k, v in pins.items())).encode())
    env = "CLOUD_CAPTURE_PINS=/tmp/qa-pins"
    mgba_dv = a.run(r"""sed -n 's/^display_version *= *"\(.*\)"$/\1/p' /usr/lib/libretro/mgba_libretro.info 2>/dev/null | head -1""").strip() or None
    n = [0]

    def run(core, emulator="retroarch", env=env):
        n[0] += 1
        system = "n64" if emulator == "mupen64plus" else "gba"
        rel = f"{system}/Pins.eep" if emulator == "mupen64plus" else f"{system}/Pins.srm"
        plant(a, root, rel, os.urandom(800 + n[0]))
        rc, out = capture(a, root, system, p.path(f"{system}/Pins.{'z64' if system == 'n64' else 'gba'}"),
                          emulator=emulator, core=core, env=env)
        e = entry(manifest_of(a), rel) or {}
        if rc != 0 or e.get("core") != (core or emulator):
            raise Fail(f"--core {core!r}: exit {rc}, entry {e.get('core')!r} (the setup for the pin check)")
        return e

    try:
        f += cap5_cases(a, run, pins, mgba_dv)
    finally:
        a.run("rm -f /tmp/qa-pins", check=False)
    return f


def cap5_cases(a, run, pins, mgba_dv):
    """CAP5's assertions, split out so the planted pins file is removed on a
    Fail as well as on the way through."""
    f = 0
    e = run("mgba")
    f += not check(e.get("core_build") == pins["mgba-lr"], "mgba -> mgba-lr's pin (the regular rule)",
                   f"mgba -> core_build {e.get('core_build')!r}")
    f += not check(e.get("core_display_version") == mgba_dv,
                   f"core_display_version is the .info's display_version ({mgba_dv!r})",
                   f"core_display_version {e.get('core_display_version')!r}, .info says {mgba_dv!r}")
    for core, pkg, why in (("snes9x2005_plus", "snes9x2005_plus-lr", "the underscore is kept"),
                           ("vice_x64", "vice-lr", "five .so, one package"),
                           ("neocd", "neocd_lr", "the only _lr package")):
        e = run(core)
        f += not check(e.get("core_build") == pins[pkg], f"{core} -> {pkg}'s pin ({why})",
                       f"{core} -> core_build {e.get('core_build')!r}, wanted {pkg}'s")
    e = run("mupen64plus-sa", emulator="mupen64plus")
    f += not check(e.get("core_build") == pins["mupen64plus-sa"], "mupen64plus-sa -> its own pin (the *-sa identity rule)",
                   f"mupen64plus-sa -> core_build {e.get('core_build')!r}")
    e = run("no-such-core")
    f += not check(e.get("core_build") == "unknown" and "core_display_version" in e and e["core_display_version"] is None,
                   "an unmapped core -> core_build \"unknown\", core_display_version null",
                   f"no-such-core -> {e.get('core_build')!r} / {e.get('core_display_version', 'absent')!r}")
    e = run("ffmpeg")
    f += not check(e.get("core_build") == "unknown",
                   "ffmpeg -> \"unknown\" despite a planted ffmpeg-lr line (the exception table fires)",
                   f"ffmpeg -> core_build {e.get('core_build')!r}: the exception table did not fire")
    e = run("mupen64plus")
    f += not check("core_display_version" in e and e["core_display_version"] is None,
                   "mupen64plus (a .so with no .info) -> core_display_version null",
                   f"mupen64plus -> core_display_version {e.get('core_display_version', 'absent')!r}")
    has_pins = a.run("[ -e /usr/share/rocknix/core-pins ] && echo yes || echo no").strip() == "yes"
    if has_pins:
        image_pin = a.run("awk '$1 == \"mgba-lr\" { print $2; exit }' /usr/share/rocknix/core-pins").strip()
        e = run("mgba", env="")
        f += not check(bool(image_pin) and e.get("core_build") == image_pin,
                       f"without the override core_build is the image's own mgba-lr pin ({image_pin[:12]}...)",
                       f"image pin {image_pin!r}, recorded {e.get('core_build')!r}")
    else:
        print("    SKIP  image carries no /usr/share/rocknix/core-pins (predates 27eb3264a2); "
              "the map was proven against a planted file")
        e = run("mgba", env="")
        f += not check(e.get("core_build") == "unknown",
                       "without the override an absent pins file renders as \"unknown\", never as a failure",
                       f"no pins file, core_build {e.get('core_build')!r}")
    return f


def fx_cap6(p):
    """CAP6: a unit is what the emulator writes. (a) libretro, the ROM in a
    subfolder and a stem with glob and shell characters, with decoys that
    share the prefix. (b) standalone N64: the .eep/.mpk pair beside the ROM
    (SaveSRAMPath in every shipped mupen64plus.cfg), one unit, both members
    declared -- acceptance (7). (c) the historical n64/save/ directory as the
    row's second candidate. (d) a libretro exit of the same N64 ROM joins
    the unit without restamping the standalone's files (rows are keyed by
    emulator)."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    stem = "Game [!] & (x) v1.1"
    unit = f"gba:{stem}"
    planted = plant_unit(a, root, "gba", stem, save=700, states={3: 4096}, auto=4096, png=512, romdir="gba/sub")
    srm, st0, st3, auto = (f"gba/sub/{stem}.srm", f"savestates/gba/{stem}.state",
                           f"savestates/gba/{stem}.state3", f"savestates/gba/{stem}.state.auto")
    planted[st0] = plant(a, root, st0, b"#RZIPv" + os.urandom(4096))   # slot 0, with no thumbnail: six members
    for decoy in (f"savestates/gba/{stem}.state.auto.bak", f"savestates/gba/{stem}x.state9", "savestates/gba/Other.state1"):
        plant(a, root, decoy, b"#RZIPv decoy")
    rc, _ = capture(a, root, "gba", p.path(f"gba/sub/{stem}.gba"))
    m = manifest_of(a) or {}
    entries = m.get("entries", {})
    f += not check(rc == 0 and sorted(entries) == sorted([srm, st0, st3, auto]),
                   "exactly four entries: the .srm (keyed under gba/sub/), .state, .state3, .state.auto",
                   f"exit {rc}; entries {sorted(entries)}")
    f += not check(all(e.get("unit") == unit for e in entries.values()) and entries,
                   f"all with unit {unit!r}", f"units {[e.get('unit') for e in entries.values()]}")
    slots = [(entries.get(r) or {}).get("slot", "absent") for r in (srm, st0, st3, auto)]
    f += not check(slots == [None, 0, 3, None], "slots null/0/3/null (a bare .state is slot 0)", f"slots {slots}")
    f += not check((entries.get(st3) or {}).get("screenshot") == st3 + ".png",
                   "state3's screenshot is its .png", f"screenshot {(entries.get(st3) or {}).get('screenshot')!r}")
    f += not check(members(m, unit) == sorted(planted),
                   "members are exactly the six real paths -- no decoy, no Other.state1",
                   f"members {members(m, unit)}")

    eep, mpk = "n64/Torn.eep", "n64/Torn.mpk"
    plant(a, root, eep, os.urandom(2048))
    plant(a, root, mpk, os.urandom(32768))
    rc, _ = capture(a, root, "n64", p.path("n64/Torn.z64"), emulator="mupen64plus", core="mupen64plus-sa")
    m = manifest_of(a) or {}
    pair = [entry(m, r) or {} for r in (eep, mpk)]
    f += not check(rc == 0 and all(e.get("kind") == "save" and e.get("unit") == "n64:Torn"
                                   and "slot" in e and e["slot"] is None and "screenshot" in e and e["screenshot"] is None
                                   for e in pair),
                   "the standalone pair: two save entries, slot and screenshot null, one unit n64:Torn",
                   f"exit {rc}; pair {[(e.get('kind'), e.get('unit'), e.get('slot', 'absent')) for e in pair]}")
    f += not check(members(m, "n64:Torn") == [eep, mpk], "units[n64:Torn].members declares both (acceptance 7)",
                   f"members {members(m, 'n64:Torn')}")

    plant(a, root, "n64/save/Old.eep", os.urandom(2048))
    plant(a, root, "n64/save/Old.mpk", os.urandom(32768))
    rc, _ = capture(a, root, "n64", p.path("n64/Old.z64"), emulator="mupen64plus", core="mupen64plus-sa")
    m = manifest_of(a) or {}
    old = [(entry(m, r) or {}).get("unit") for r in ("n64/save/Old.eep", "n64/save/Old.mpk")]
    f += not check(rc == 0 and old == ["n64:Old", "n64:Old"],
                   "the historical n64/save/ directory is the row's second candidate (what the allowlist has named for years)",
                   f"exit {rc}; units {old}")

    plant(a, root, "n64/Torn.srm", os.urandom(1024))
    plant(a, root, "savestates/n64/Torn.state1", b"#RZIPv" + os.urandom(4096))
    rc, _ = capture(a, root, "n64", p.path("n64/Torn.z64"), emulator="retroarch", core="mupen64plus_next")
    m = manifest_of(a) or {}
    lr = [(entry(m, r) or {}) for r in ("n64/Torn.srm", "savestates/n64/Torn.state1")]
    f += not check(rc == 0 and all(e.get("unit") == "n64:Torn" and e.get("emulator") == "retroarch" for e in lr),
                   "a libretro exit of the same ROM joins unit n64:Torn", f"exit {rc}; {[(e.get('unit'), e.get('emulator')) for e in lr]}")
    f += not check(members(m, "n64:Torn") == [eep, mpk, "n64/Torn.srm", "savestates/n64/Torn.state1"],
                   "units[n64:Torn] now declares all four", f"members {members(m, 'n64:Torn')}")
    f += not check(all((entry(m, r) or {}).get("emulator") == "mupen64plus" for r in (eep, mpk)),
                   "the .eep/.mpk entries still say mupen64plus (rows are keyed by emulator)",
                   f"standalone entries now say {[(entry(m, r) or {}).get('emulator') for r in (eep, mpk)]}")
    return f


def fx_cap7(p):
    """CAP7: a renumber is a move, a deletion is a retired record, and nothing
    is invented. The manager's path (--retire before the unlink, --rescan
    after the renumber) carries captured_at, replaces and provenance across
    the move and grows the stage by nothing; a chain of moves resolves; the
    shell path (rm + mv, no --retire) records the move, invents no retired
    row and drops the displaced entry with a WARN, while a member that merely
    vanished keeps its entry; retired is bounded at 200; a path outside the
    root is refused. A thumbnail is a declared member with no entry
    (D-CLOUD-059): retired beside its state it leaves members with the
    state's entry, retired alone its state's screenshot goes to null, and
    neither writes a retired row."""
    f = 0
    a, root = p.a, p.root
    p.reset()

    def st(stem, n):
        return f"savestates/gba/{stem}.state{n}"

    def q(rel):
        return shlex.quote(p.path(rel))

    # The manager's path.
    s = {n: b"#RZIPv" + os.urandom(3000 + n) for n in (1, 2, 3)}
    plant(a, root, "gba/Re.srm", os.urandom(512))
    for n, data in s.items():
        plant(a, root, st("Re", n), data)
        plant(a, root, st("Re", n) + ".png", b"\x89PNG" + os.urandom(300 + n))
    rc, _ = capture(a, root, "gba", p.path("gba/Re.gba"))
    m = manifest_of(a) or {}
    before = {n: dict(entry(m, st("Re", n)) or {}) for n in s}
    if rc != 0 or not all(before[n].get("sha256") == sha(s[n]) for n in s):
        raise Fail(f"the setup capture did not record the three states (exit {rc})")
    # The state and its thumbnail together, as GuiSaveState hands them over.
    rc, _ = run_rc(a, f"cloud_capture --retire {q(st('Re', 2))} {shlex.quote(st('Re', 2) + '.png')}")
    m = manifest_of(a) or {}
    retired = m.get("retired") or []
    f += not check(rc == 0 and entry(m, st("Re", 2)) is None and st("Re", 2) + ".png" not in m.get("entries", {}),
                   "--retire (one absolute, one relative path) exited 0 and removed the state's entry",
                   f"exit {rc}; state2 entry {'present' if entry(m, st('Re', 2)) else 'gone'}")
    rows = {r.get("path"): r for r in retired}
    f += not check(len(retired) == 1 and rows.get(st("Re", 2), {}).get("sha256") == sha(s[2]) and st("Re", 2) + ".png" not in rows,
                   "one retired row: the state with its entry's sha, root-relative; none for the thumbnail, "
                   "which has no version to retire (D-CLOUD-059)",
                   f"retired {[(r.get('path'), (r.get('sha256') or '')[:8]) for r in retired]}")
    f += not check(all("retires_pub" in r and r["retires_pub"] is None and ISO_UTC.match(r.get("at") or "") for r in retired),
                   "retires_pub null and `at` ISO-UTC on it", f"rows {retired}")
    f += not check(members(m, "gba:Re") is not None and not any(x in members(m, "gba:Re") for x in (st("Re", 2), st("Re", 2) + ".png")),
                   "units[gba:Re].members no longer names either", f"members {members(m, 'gba:Re')}")
    stamp = last_capture(a)
    f += not check(stamp is not None and stamp[2] == "retire" and stamp[4:] == ("emu-exit=?", "-/-"),
                   "last-capture for a --retire reads mode retire, emu-exit=? and -/- (no game ran)", f"last-capture is {stamp!r}")
    # A thumbnail alone (the manager can delete just the picture): the
    # state's entry stays, its screenshot goes to null, and that is what
    # drops the .png from members -- still no retired row.
    png1 = st("Re", 1) + ".png"
    rc, _ = run_rc(a, f"cloud_capture --retire {q(png1)}")
    m = manifest_of(a) or {}
    e1 = entry(m, st("Re", 1)) or {}
    f += not check(rc == 0 and e1.get("sha256") == sha(s[1]) and "screenshot" in e1 and e1["screenshot"] is None,
                   "--retire of a thumbnail alone: exit 0, the state's entry stays with screenshot null",
                   f"exit {rc}; state1 {'HAS NO ENTRY' if not e1 else 'screenshot ' + repr(e1.get('screenshot'))}")
    f += not check(len(m.get("retired") or []) == 1 and png1 not in {r.get("path") for r in m.get("retired") or []},
                   "and retired gained nothing", f"retired {[(r.get('path'), (r.get('sha256') or '')[:8]) for r in m.get('retired') or []]}")
    f += not check(members(m, "gba:Re") is not None and png1 not in members(m, "gba:Re") and st("Re", 1) in members(m, "gba:Re"),
                   "units[gba:Re].members drops the png and keeps the state", f"members {members(m, 'gba:Re')}")
    f += not check(not any(k.endswith(".png") for k in m.get("entries", {})),
                   "no entry was created for the png (a meta op on a missing entry makes nothing)",
                   f"png entries: {[k for k in m.get('entries', {}) if k.endswith('.png')]}")
    a.run(f"rm -f {q(png1)}")
    # The stage baseline is taken after the retire: its GC drops the retired
    # version's seal (referenced by no entry), and the claim under test is
    # that the *move* adds nothing. rename keeps mtime, as copyToSlot(move=true) does.
    n_stage, s3_stat = stage_count(a), a.run(f"stat -c '%i %Y' {CACHE}/stage/{sha(s[3])}").strip()
    a.run(f"rm -f {q(st('Re', 2))} {q(st('Re', 2) + '.png')}; mv {q(st('Re', 3))} {q(st('Re', 2))}; "
          f"mv {q(st('Re', 3) + '.png')} {q(st('Re', 2) + '.png')}")
    rc, _ = run_rc(a, f"cloud_capture --rescan --system gba --rom {q('gba/Re.gba')}")
    m = manifest_of(a) or {}
    e2 = entry(m, st("Re", 2)) or {}
    f += not check(rc == 0 and e2.get("sha256") == sha(s[3]) and e2.get("slot") == 2 and e2.get("screenshot") == st("Re", 2) + ".png",
                   "--rescan re-keyed state3's version at state2 with slot 2 and its png",
                   f"exit {rc}; state2 sha {(e2.get('sha256') or '')[:8]} slot {e2.get('slot')!r} screenshot {e2.get('screenshot')!r}")
    f += not check(e2.get("captured_at") == before[3].get("captured_at") and e2.get("replaces") == before[3].get("replaces"),
                   "captured_at and replaces carried from the moved entry",
                   f"captured_at {e2.get('captured_at')!r} vs {before[3].get('captured_at')!r}; replaces {e2.get('replaces')!r}")
    f += not check(e2.get("emulator") == "retroarch" and e2.get("core") == "mgba",
                   "emulator/core carried across the move, not \"unknown\" (a move carries provenance)",
                   f"emulator {e2.get('emulator')!r} core {e2.get('core')!r}")
    f += not check(entry(m, st("Re", 3)) is None, "no entry at state3", "state3 still has an entry")
    f += not check(stage_count(a) == n_stage and a.run(f"stat -c '%i %Y' {CACHE}/stage/{sha(s[3])}").strip() == s3_stat,
                   "the stage did not grow (a move needs no new copy)", f"stage {stage_count(a)} vs {n_stage}")
    f += not check(len(m.get("retired") or []) == 1, "retired is still length 1", f"retired length {len(m.get('retired') or [])}")

    # A copy and a new version at its source in one pass: cp -p state1 state2
    # (a copyToSlot without move keeps the mtime) then new bytes at state1.
    # That is a MOVE (state1's old version now sits at state2) and a PUT
    # (state1 holds a new version). The merge once deleted every move source
    # after the reduce, put included, and state1's new bytes were never
    # recorded again -- no entry, and an mtime below every later --started.
    k = {"A": b"#RZIPv" + os.urandom(6001), "B": b"#RZIPv" + os.urandom(6002)}
    plant(a, root, st("Copy", 1), k["A"])
    capture(a, root, "gba", p.path("gba/Copy.gba"))
    ka = dict(entry(manifest_of(a), st("Copy", 1)) or {})
    a.run(f"cp -p {q(st('Copy', 1))} {q(st('Copy', 2))}")
    plant(a, root, st("Copy", 1), k["B"])
    rc, _ = run_rc(a, f"cloud_capture --rescan --system gba --rom {q('gba/Copy.gba')}")
    m = manifest_of(a) or {}
    k1, k2 = entry(m, st("Copy", 1)) or {}, entry(m, st("Copy", 2)) or {}
    f += not check(rc == 0 and k2.get("sha256") == sha(k["A"]) and k2.get("captured_at") == ka.get("captured_at"),
                   "cp -p then rewrite: state2 holds the old version as a move (original captured_at)",
                   f"exit {rc}; state2 {(k2.get('sha256') or '')[:8]} captured_at {k2.get('captured_at')!r} vs {ka.get('captured_at')!r}")
    f += not check(k1.get("sha256") == sha(k["B"]) and k1.get("replaces") == sha(k["A"]),
                   "and state1 keeps its new version as a put whose replaces is the old sha (a put at a move source survives)",
                   f"state1 {'HAS NO ENTRY' if not k1 else (k1.get('sha256') or '')[:8]} replaces {(k1.get('replaces') or '')[:8]} "
                   "-- a put at a move source was dropped with the source (R5: a version nothing will record again)")

    # A renumber chain: state4 -> state3 -> state2.
    c = {n: b"#RZIPv" + os.urandom(4000 + n) for n in (1, 2, 3, 4)}
    for n, data in c.items():
        plant(a, root, st("Chain", n), data)
    capture(a, root, "gba", p.path("gba/Chain.gba"))
    m = manifest_of(a) or {}
    cb = {n: dict(entry(m, st("Chain", n)) or {}) for n in c}
    run_rc(a, f"cloud_capture --retire {q(st('Chain', 2))}")
    a.run(f"rm -f {q(st('Chain', 2))}; mv {q(st('Chain', 3))} {q(st('Chain', 2))}; mv {q(st('Chain', 4))} {q(st('Chain', 3))}")
    rc, _ = run_rc(a, f"cloud_capture --rescan --system gba --rom {q('gba/Chain.gba')}")
    m = manifest_of(a) or {}
    c2, c3 = entry(m, st("Chain", 2)) or {}, entry(m, st("Chain", 3)) or {}
    f += not check(rc == 0 and c2.get("sha256") == sha(c[3]) and c3.get("sha256") == sha(c[4]),
                   "the chain resolved: state2 holds S3 and state3 holds S4",
                   f"exit {rc}; state2 {(c2.get('sha256') or '')[:8]} state3 {(c3.get('sha256') or '')[:8]}")
    f += not check(c2.get("captured_at") == cb[3].get("captured_at") and c3.get("captured_at") == cb[4].get("captured_at")
                   and c2.get("replaces") == cb[3].get("replaces") and c3.get("replaces") == cb[4].get("replaces"),
                   "both as moves: original captured_at, no fabricated replaces",
                   f"captured_at {c2.get('captured_at')!r}/{c3.get('captured_at')!r}; replaces {c2.get('replaces')!r}/{c3.get('replaces')!r}")
    chain = sorted(k for k in m.get("entries", {}) if k.startswith("savestates/gba/Chain."))
    f += not check(chain == [st("Chain", 1), st("Chain", 2), st("Chain", 3)], "no new versions: three Chain entries",
                   f"Chain entries {chain}")

    # The shell path (A9's shape): rm and mv with no --retire.
    h = {n: b"#RZIPv" + os.urandom(5000 + n) for n in (1, 2, 3)}
    for n, data in h.items():
        plant(a, root, st("Shell", n), data)
    capture(a, root, "gba", p.path("gba/Shell.gba"))
    m = manifest_of(a) or {}
    hb = dict(entry(m, st("Shell", 3)) or {})
    n_retired = len(m.get("retired") or [])
    a.run(f"rm -f {q(st('Shell', 2))}; mv {q(st('Shell', 3))} {q(st('Shell', 2))}")
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", p.path("gba/Shell.gba"))
    m = manifest_of(a) or {}
    tail = log_since(a, mark)
    h2 = entry(m, st("Shell", 2)) or {}
    f += not check(rc == 0 and h2.get("sha256") == sha(h[3]) and h2.get("captured_at") == hb.get("captured_at"),
                   "the move was recorded at exit (state2 holds S3 with its original captured_at)",
                   f"exit {rc}; state2 {(h2.get('sha256') or '')[:8]} captured_at {h2.get('captured_at')!r} vs {hb.get('captured_at')!r}")
    f += not check(len(m.get("retired") or []) == n_retired, "retired gained nothing (no retire record is invented)",
                   f"retired grew from {n_retired} to {len(m.get('retired') or [])}")
    f += not check("displaced at" in tail and "without a retire record" in tail,
                   "the displaced version was named in a WARN", "no 'displaced at ... without a retire record' WARN")
    f += not check(entry(m, st("Shell", 3)) is None, "the vanished state3 path has no entry", "state3 still has an entry")
    plant(a, root, "gba/Kept.srm", os.urandom(600))
    plant(a, root, st("Kept", 1), b"#RZIPv" + os.urandom(2000))   # a second member, so the unit still scans
    capture(a, root, "gba", p.path("gba/Kept.gba"))
    a.run(f"rm -f {q('gba/Kept.srm')}")
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", p.path("gba/Kept.gba"))
    m = manifest_of(a) or {}
    f += not check(rc == 0 and entry(m, "gba/Kept.srm") is not None and "claimed but not on disk" in log_since(a, mark),
                   "a member that merely vanished keeps its entry (I5) and the log says 'claimed but not on disk'",
                   f"exit {rc}; entry {'kept' if entry(m, 'gba/Kept.srm') else 'GONE'}; WARN {'present' if 'claimed but not on disk' in log_since(a, mark) else 'absent'}")

    # The bound: 250 synthetic rows, one more retire, 200 remain.
    synthetic = [{"sha256": f"{i:064x}", "path": f"savestates/gba/Synthetic.state{i}", "retires_pub": None,
                  "at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(1577836800 + i))} for i in range(250)]
    a.write("/tmp/qa-retired.json", json.dumps(synthetic).encode())
    a.run(f"jq --slurpfile r /tmp/qa-retired.json '.retired = $r[0]' {p.manifest} > {p.manifest}.tmp && mv -f {p.manifest}.tmp {p.manifest}; "
          "rm -f /tmp/qa-retired.json")
    plant(a, root, "gba/Bound.srm", os.urandom(640))
    capture(a, root, "gba", p.path("gba/Bound.gba"))
    rc, _ = run_rc(a, f"cloud_capture --retire {q('gba/Bound.srm')}")
    m = manifest_of(a) or {}
    retired = m.get("retired") or []
    ats = {r.get("at") for r in retired}
    f += not check(rc == 0 and len(retired) == 200, "retired is trimmed to 200", f"exit {rc}; retired length {len(retired)}")
    f += not check(bool(retired) and retired[-1].get("path") == "gba/Bound.srm", "the newest row is the one just written",
                   f"last row {retired[-1] if retired else None}")
    f += not check(not any(r["at"] in ats for r in synthetic[:51]) and all(r["at"] in ats for r in synthetic[51:]),
                   "the oldest 51 are gone and the rest kept", "the trim did not drop the oldest 51")

    mark = log_mark(a)
    rc, _ = run_rc(a, "cloud_capture --retire /storage/cloud-qa-elsewhere/gba/Outside.srm")
    m = manifest_of(a) or {}
    f += not check(rc == 1 and len(m.get("retired") or []) == 200 and "WARN" in log_since(a, mark),
                   "--retire of a path outside the saves root: exit 1, nothing recorded, WARN logged",
                   f"exit {rc}; retired length {len(m.get('retired') or [])}; WARN {'present' if 'WARN' in log_since(a, mark) else 'absent'}")
    return f


def fx_cap8(p):
    """CAP8: nothing is stamped that this session did not write; the A2 shape
    at exit; --full's limits. (a) A member with no entry older than --started
    is not recorded, per member; --started 0 records it. (b) An equal-size,
    equal-mtime rewrite is invisible at exit (the documented limit of a
    size+mtime changed set). (c) --full catches it with "unknown" provenance
    and GCs the old seal. (d) --full adopts no path without an entry. (e)
    --full refuses an empty root (A9's shape, fail-closed)."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    old, rom = "savestates/gba/Old.state1", p.path("gba/Old.gba")
    plant(a, root, old, b"#RZIPv" + os.urandom(3000))
    touch_offset(a, p.path(old), -3600)
    started = int(a.run("date +%s").strip())
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", rom, started=started)
    f += not check(rc == 0 and manifest_of(a) is None,
                   "a member older than --started with no entry: exit 0 and no manifest was created",
                   f"exit {rc}; manifest {'created' if manifest_of(a) is not None else 'absent'}")
    f += not check("have no entry and were not stamped" in log_since(a, mark),
                   "the log says it was not stamped", "no 'have no entry and were not stamped' line")
    # The same unit gains a member this session wrote: recorded, the old one still not.
    plant(a, root, "gba/Old.srm", os.urandom(512))
    rc, _ = capture(a, root, "gba", rom, started=started)
    m = manifest_of(a)
    f += not check(rc == 0 and entry(m, "gba/Old.srm") is not None and entry(m, old) is None,
                   "the fresh .srm is recorded and the old state still is not (the rule is per member, not per run)",
                   f"exit {rc}; srm {'recorded' if entry(m, 'gba/Old.srm') else 'missing'}, old state {'STAMPED' if entry(m, old) else 'not recorded'}")
    rc, _ = capture(a, root, "gba", rom, started=0)
    f += not check(rc == 0 and entry(manifest_of(a), old) is not None, "--started 0 records it",
                   f"exit {rc}; old state {'recorded' if entry(manifest_of(a), old) else 'still missing'}")

    same, srom = "gba/Same.srm", p.path("gba/Same.gba")
    one, two = b"version-one-of-this-save", b"version-two-of-this-save"
    assert len(one) == len(two)
    plant(a, root, same, one)
    capture(a, root, "gba", srom)
    qf = shlex.quote(p.path(same))
    a.run(f"cp -p {qf} {qf}.ref")
    plant(a, root, same, two)
    a.run(f"touch -r {qf}.ref {qf}; rm -f {qf}.ref; sync")
    m0 = manifest_stat(a)
    rc, _ = capture(a, root, "gba", srom)
    f += not check(rc == 0 and (entry(manifest_of(a), same) or {}).get("sha256") == sha(one) and manifest_stat(a) == m0,
                   "an equal-size, equal-mtime rewrite is not seen at exit (the documented limit of size+mtime)",
                   f"exit {rc}; entry sha is {name_of((entry(manifest_of(a), same) or {}).get('sha256'), {'one': one, 'two': two})}")
    rc, _ = run_rc(a, "cloud_capture --full")
    m = manifest_of(a)
    e = entry(m, same) or {}
    f += not check(rc == 0 and e.get("sha256") == sha(two) and e.get("replaces") == sha(one),
                   "--full caught it: version two, replaces version one",
                   f"exit {rc}; sha {name_of(e.get('sha256'), {'one': one, 'two': two})} replaces {name_of(e.get('replaces'), {'one': one, 'two': two})}")
    f += not check(e.get("emulator") == e.get("core") == e.get("core_build") == "unknown"
                   and "core_display_version" in e and e["core_display_version"] is None,
                   "with emulator/core/core_build \"unknown\" and core_display_version null (the session was not observed)",
                   f"provenance {[e.get(k) for k in ('emulator', 'core', 'core_build', 'core_display_version')]}")
    f += not check(e.get("system") == "gba" and e.get("rom") == "Same.gba" and e.get("unit") == "gba:Same" and e.get("kind") == "save",
                   "system/rom/unit/kind carried", f"{[e.get(k) for k in ('system', 'rom', 'unit', 'kind')]}")
    f += not check(nulls(e, ("producer", "pub", "published_at")), "producer/pub/published_at null",
                   f"{[e.get(k, 'absent') for k in ('producer', 'pub', 'published_at')]}")
    f += not check(stage_sha(a, sha(two)) == sha(two) and stage_sha(a, sha(one)) is None,
                   "the new sha is in the stage and the old one was GC'd",
                   f"stage: two {'present' if stage_sha(a, sha(two)) else 'MISSING'}, one {'still present' if stage_sha(a, sha(one)) else 'gone'}")

    plant(a, root, "savestates/gba/Stray.state7", b"#RZIPv" + os.urandom(2000))
    m0 = manifest_stat(a)
    rc, _ = run_rc(a, "cloud_capture --full")
    f += not check(rc == 0 and entry(manifest_of(a), "savestates/gba/Stray.state7") is None and manifest_stat(a) == m0,
                   "--full adopts nothing: a fresh file with no entry stays unrecorded and the manifest is untouched",
                   f"exit {rc}; stray {'ADOPTED' if entry(manifest_of(a), 'savestates/gba/Stray.state7') else 'not adopted'}; "
                   f"stat {'unchanged' if manifest_stat(a) == m0 else 'CHANGED'}")

    ents0 = (manifest_of(a) or {}).get("entries")
    qr = shlex.quote(root)
    mark = log_mark(a)
    a.run(f"mv {qr} {qr}.away; mkdir -p {qr}")
    try:
        rc, _ = run_rc(a, "cloud_capture --full")
        tail = log_since(a, mark)
    finally:
        a.run(f"rm -rf {qr}; mv {qr}.away {qr}")
    f += not check(rc == 1 and (manifest_of(a) or {}).get("entries") == ents0 and root in tail,
                   "--full on an empty root: exit 1, entries untouched, the log names the root",
                   f"exit {rc}; entries {'unchanged' if (manifest_of(a) or {}).get('entries') == ents0 else 'CHANGED'}; "
                   f"root named {'yes' if root in tail else 'no'}")
    return f


def fx_cap9(p):
    """CAP9: the error policy is the one written down, and the un-provable is
    not faked. Usage errors exit 2 on stderr; a missing SAVESPATH, an
    unwritable stage and a newer schema exit 1 with the manifest untouched
    and an ERROR naming the path; a corrupt manifest is moved aside and the
    session still recorded; the durable stamps survive where /var/log does
    not; the no-lock claim is a static check, labelled as one; the jq-absent
    branch is not reachable on a read-only /usr and is not pretended."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    rom = p.path("gba/Policy.gba")
    for label, cmd in (("no --started", "cloud_capture --system gba --rom x.gba --emulator retroarch --core mgba"),
                       ("no --core", "cloud_capture --system gba --rom x.gba --emulator retroarch --started 0"),
                       ("an unknown flag", "cloud_capture --bogus"),
                       ("--retire with no path", "cloud_capture --retire")):
        out = a.run(f"{cmd} >/tmp/qa-u.out 2>/tmp/qa-u.err; echo rc=$?; wc -c < /tmp/qa-u.err", check=False).split()
        rc = int(out[0][3:]) if out and out[0].startswith("rc=") else -1
        err = int(out[1]) if len(out) > 1 and out[1].isdigit() else 0
        f += not check(rc == 2 and err > 0, f"{label}: exit 2 with a line on stderr", f"{label}: exit {rc}, {err} byte(s) on stderr")
    f += not check(manifest_of(a) is None, "usage errors created no manifest", "a usage error created a manifest")
    a.run("rm -f /tmp/qa-u.out /tmp/qa-u.err", check=False)

    # A system with no <emulators> element (tools) exits with an empty pair.
    # That is nothing to record, not a usage error: exit 0, no manifest, and
    # no capture-failures row -- one per run of such a system would crowd the
    # real failures out of the 20 the stamp keeps. ES also skips the spawn
    # for an empty launchedEmulator; this is the producer's own guard.
    n0 = failures_lines(a)
    rc, _ = run_rc(a, "cloud_capture --system tools --rom /storage/roms/tools/x.sh --emulator '' --core '' --started 0 --exit 0")
    stamp = last_capture(a)
    f += not check(rc == 0 and manifest_of(a) is None and failures_lines(a) == n0 and stamp is not None and stamp[1] == "0",
                   "--emulator '' (a system with no emulator): exit 0, nothing recorded, no capture-failures row, last-capture rc 0",
                   f"exit {rc}; manifest {'created' if manifest_of(a) is not None else 'absent'}; failures {failures_lines(a)} vs {n0}; stamp {stamp!r}")
    f += not check(stamp is not None and stamp[4:] == ("emu-exit=0", "-/-"),
                   "its stamp carries the exit it was given (emu-exit=0) and -/- for the empty pair", f"stamp {stamp!r}")

    set_key(a, "SAVESPATH", "/storage/cloud-qa-missing")
    n0 = failures_lines(a)
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", rom)
    set_key(a, "SAVESPATH", root)
    tail = log_since(a, mark)
    f += not check(rc == 1 and manifest_of(a) is None and "ERROR" in tail and "/storage/cloud-qa-missing" in tail,
                   "SAVESPATH not a directory: exit 1, no manifest, ERROR naming the path",
                   f"exit {rc}; manifest {'created' if manifest_of(a) is not None else 'absent'}; log {tail.strip()[-80:]!r}")
    f += not check(failures_lines(a) > n0, "capture-failures gained a line", "no capture-failures line for a refused run")
    stamp_b = last_capture(a)

    plant(a, root, "gba/Policy.srm", os.urandom(512))
    rc, _ = capture(a, root, "gba", rom)
    m0 = manifest_stat(a)
    if rc != 0 or m0 is None:
        raise Fail(f"the setup capture recorded nothing (exit {rc})")
    a.run(f"rm -rf {CACHE}/stage; touch {CACHE}/stage")
    plant(a, root, "gba/Policy.srm", os.urandom(513))
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", rom)
    tail = log_since(a, mark)
    a.run(f"rm -f {CACHE}/stage")
    f += not check(rc == 1 and manifest_stat(a) == m0 and "ERROR" in tail and f"{CACHE}/stage" in tail,
                   "stage unwritable (a file where the directory goes): exit 1, manifest untouched, ERROR naming the stage",
                   f"exit {rc}; stat {'unchanged' if manifest_stat(a) == m0 else 'CHANGED'}; log {tail.strip()[-80:]!r}")

    a.run(f"printf 'not json{{' > {p.manifest}")
    plant(a, root, "gba/After.srm", os.urandom(520))
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", p.path("gba/After.gba"))
    tail = log_since(a, mark)
    aside = a.run(f"for x in {p.manifest}.corrupt-*; do [ -e \"$x\" ] && cat \"$x\"; done 2>/dev/null || true")
    present, text = manifest_text(a)
    try:
        m = json.loads(text) if present else None
    except ValueError:
        m = None
    f += not check(rc == 0 and aside == "not json{", "a corrupt manifest is moved aside as manifest-<id>.json.corrupt-<epoch> with its bytes intact",
                   f"exit {rc}; aside holds {aside!r}")
    f += not check(m is not None and entry(m, "gba/After.srm") is not None,
                   "the new manifest parses and holds this session's entries",
                   "no parseable manifest with this session's entry after the corrupt one was set aside")
    f += not check("WARN" in tail or "ERROR" in tail, "and it was logged", "nothing logged about the corrupt manifest")

    a.run(f"jq '.schema = 2' {p.manifest} > {p.manifest}.tmp && mv -f {p.manifest}.tmp {p.manifest}")
    m0 = manifest_stat(a)
    plant(a, root, "gba/After.srm", os.urandom(521))
    n0 = failures_lines(a)
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", p.path("gba/After.gba"))
    tail = log_since(a, mark)
    f += not check(rc == 1 and manifest_stat(a) == m0 and "ERROR" in tail and "schema" in tail,
                   "a manifest claiming a newer schema: exit 1, untouched, ERROR naming the schema",
                   f"exit {rc}; stat {'unchanged' if manifest_stat(a) == m0 else 'CHANGED'}; log {tail.strip()[-80:]!r}")
    stamp_e = last_capture(a)
    reason = a.run(f"tail -1 {CACHE}/capture-failures 2>/dev/null || true").strip()
    f += not check(stamp_b is not None and stamp_b[1] == "1" and stamp_e is not None and stamp_e[1] == "1",
                   "last-capture recorded rc 1 after both refusals (a stamp that survives the reboot /var/log does not)",
                   f"last-capture after SAVESPATH: {stamp_b!r}; after schema: {stamp_e!r}")
    f += not check(stamp_b is not None and stamp_b[4:] == ("emu-exit=?", "retroarch/mgba")
                   and stamp_e is not None and stamp_e[4:] == ("emu-exit=?", "retroarch/mgba"),
                   "both refusals still stamped the frozen pair retroarch/mgba and emu-exit=? (no --exit was passed): "
                   "the run that could not record is the one whose log line will be gone",
                   f"after SAVESPATH: {stamp_b!r}; after schema: {stamp_e!r}")
    f += not check(failures_lines(a) > n0 and "schema" in reason, "capture-failures names the reason",
                   f"capture-failures last line {reason!r}")

    # A rev 1 manifest -- no unit, units or retired, the shape this writer
    # advertises upgrading in place. --full derives each entry's unit from
    # its system and rom, stamps it on the unchanged entry too, and declares
    # both in units; nothing is filed under "-".
    p.reset()
    r1, k1 = "gba/RevOne.srm", "gba/Kept1.srm"
    one, kept = plant(a, root, r1, b"rev-one-bytes"), plant(a, root, k1, b"kept-bytes")

    def rev1(rel, data, digest):
        return {"kind": "save", "sha256": digest, "size": len(data), "mtime": iso_mtime(a, p.path(rel)), "system": "gba",
                "rom": rel.split("/")[1].replace(".srm", ".gba"), "slot": None, "screenshot": None, "pub": None}

    a.write(p.manifest, json.dumps({"schema": 1, "entries": {r1: rev1(r1, one, "1" * 64), k1: rev1(k1, kept, sha(kept))}}).encode())
    mark = log_mark(a)
    rc, _ = run_rc(a, "cloud_capture --full")
    m = manifest_of(a) or {}
    e1, ek = entry(m, r1) or {}, entry(m, k1) or {}
    f += not check(rc == 0 and e1.get("sha256") == sha(one) and e1.get("replaces") == "1" * 64 and e1.get("unit") == "gba:RevOne",
                   "a rev 1 entry re-hashed by --full carries unit gba:RevOne, derived from its system and rom",
                   f"exit {rc}; unit {e1.get('unit')!r} sha {(e1.get('sha256') or '')[:8]} replaces {(e1.get('replaces') or '')[:8]}")
    f += not check(ek.get("unit") == "gba:Kept1" and ek.get("sha256") == sha(kept),
                   "an unchanged rev 1 entry gains its unit too (the upgrade in place)", f"unit {ek.get('unit')!r}")
    f += not check(members(m, "gba:RevOne") == [r1] and members(m, "gba:Kept1") == [k1] and "-" not in (m.get("units") or {}),
                   "units declares both and nothing is filed under \"-\"", f"units {m.get('units')}")
    f += not check("rev 1" in log_since(a, mark), "the upgrade was logged", "no 'rev 1' line in the log")

    script = a.run("command -v cloud_capture").strip()
    hits = a.run(f"grep -v '^[[:space:]]*#' {shlex.quote(script)} | grep -c -e flock -e cloud_sync.lock -e rclone -e curl -e wget || true").strip()
    f += not check(hits == "0", "static: no flock, no lock file, no rclone, curl or wget in the shipped script's code "
                   "(CAP1 proves it does not block on a held lock and spawns no rclone through PATH, different claims)",
                   f"static: {hits} non-comment line(s) mention flock, cloud_sync.lock, rclone, curl or wget")
    print("    SKIP  jq-absent branch is not reachable on a read-only /usr; it is covered by code reading, not by this fixture")
    return f


def boot_caller_gate(lines):
    """How the autostart runs `cloud_capture --full`, resolved from the file's
    structure rather than from line order. None when there is no --full line;
    else (index, enclosing test text or None, gate_ok, background_ok).

    The gate is the `if` that ENCLOSES the --full line: walk back over the
    non-comment lines, where a `fi` opens a nested block that its own `if`
    closes, and the first unmatched `if` is the one guarding us -- an `else`
    or `elif` met first means the line runs when that test is false. It must
    name BOTH toggles (orchestrator decision 2: a gameexit-only device runs
    it too). Line order is not evidence: the sync block's own toggle test sits
    above any line appended after its `fi`, and satisfied the old check for an
    ungated --full. The line itself must be detached (setsid or nohup, ending
    in a single `&` -- `&&` is a foreground chain) and niced."""
    code = [(i, l.strip()) for i, l in enumerate(lines) if l.strip() and not l.lstrip().startswith("#")]
    full = [i for i, s in code if "cloud_capture --full" in s]
    if not full:
        return None
    enclosing, depth = None, 0
    for i, s in reversed([(i, s) for i, s in code if i < full[0]]):
        if s == "fi" or s.startswith("fi;") or s.startswith("fi "):
            depth += 1
        elif s.startswith("if "):
            if depth == 0:
                enclosing = s
                break
            depth -= 1
        elif depth == 0 and (s == "else" or s.startswith("elif ")):
            enclosing = s
            break
    gate_ok = (enclosing is not None and enclosing.startswith("if ")
               and bool(re.search(r"cloudsaves\.startup", enclosing)) and bool(re.search(r"cloudsaves\.gameexit", enclosing)))
    line = lines[full[0]]
    bg_ok = bool(re.search(r"(setsid|nohup).*(?<!&)&\s*$", line)) and "nice" in line
    return full[0], enclosing, gate_ok, bg_ok


def fx_cap10(p):
    """CAP10: the card context informs, it never silently refuses -- and a
    flip discards. (a) A wrong-but-stable card: the version is recorded, the
    log carries cloud_saves_root's sentence, the stamp carries !card. (b) A
    card that changes during the run: discarded, manifest untouched, ERROR,
    capture-failures. (c) --full waits for the usual card and then records.
    (d) The boot caller, statically: --full runs from the autostart behind
    the cloud-saves toggle and in the background (D-CLOUD-057: boot time is
    not ours to spend).

    The fireable form: local_reset wipes the saves-root record and with no
    record `cloud_saves_root check` exits 0, so a bogus record is planted."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    rel, rom = "gba/Card.srm", p.path("gba/Card.gba")
    plant(a, root, rel, os.urandom(512))
    rc, _ = capture(a, root, "gba", rom)
    if rc != 0:
        raise Fail(f"the setup capture exited {rc}")
    a.run(f"echo 'uuid:00000000-0000-0000-0000-000000000000' > {CACHE}/saves-root")
    new = plant(a, root, rel, os.urandom(513))
    mark = log_mark(a)
    rc, _ = capture(a, root, "gba", rom)
    tail = log_since(a, mark)
    stamp = last_capture(a)
    f += not check(rc == 0 and (entry(manifest_of(a), rel) or {}).get("sha256") == sha(new),
                   "on a wrong-but-stable card the new version IS recorded (the file is real; its claim belongs, I5)",
                   f"exit {rc}; entry sha {'is the new bytes' if (entry(manifest_of(a), rel) or {}).get('sha256') == sha(new) else 'is not the new bytes'}")
    f += not check("different card" in tail, "the log carries cloud_saves_root's 'different card' sentence",
                   f"log {tail.strip()[-100:]!r}")
    f += not check(stamp is not None and "!card" in stamp[2], "last-capture carries the !card marker", f"last-capture {stamp!r}")

    # (b) a shim beside a copy of the producer: siblings resolve beside $0,
    # so the copy is what makes the shim the one that answers.
    real = a.run("cloud_saves_root identity").strip()
    capbin, idbin = a.run("command -v cloud_capture").strip(), a.run("command -v cloud_device_id").strip()
    a.run(f"rm -rf /tmp/qa-flip; mkdir -p /tmp/qa-flip; cp {shlex.quote(capbin)} /tmp/qa-flip/cloud_capture; "
          f"cp {shlex.quote(idbin)} /tmp/qa-flip/cloud_device_id")
    a.write("/tmp/qa-flip/cloud_saves_root",
            ("#!/bin/sh\ncase \"$1\" in\n"
             f"    check) echo {shlex.quote(real)}; exit 0 ;;\n"
             "    identity) echo uuid:ffffffff-ffff-ffff-ffff-ffffffffffff; exit 0 ;;\n"
             "esac\nexit 0\n").encode())
    a.run("chmod +x /tmp/qa-flip/*")
    m0, n0 = manifest_stat(a), failures_lines(a)
    plant(a, root, rel, os.urandom(514))
    mark = log_mark(a)
    rc, _ = run_rc(a, f"/tmp/qa-flip/cloud_capture --system gba --rom {shlex.quote(rom)} --emulator retroarch --core mgba --started 0")
    tail = log_since(a, mark)
    a.run("rm -rf /tmp/qa-flip", check=False)
    f += not check(rc == 1 and manifest_stat(a) == m0, "a card that changed during the run: exit 1, the manifest untouched (the run was discarded)",
                   f"exit {rc}; stat {'unchanged' if manifest_stat(a) == m0 else 'CHANGED: a scan spanning two trees was recorded'}")
    f += not check("ERROR" in tail and failures_lines(a) > n0, "ERROR logged and capture-failures gained a line",
                   f"ERROR {'present' if 'ERROR' in tail else 'absent'}; failures {failures_lines(a)} vs {n0}")

    # (c) --full with the bogus record still in place: it waits (bounded), then records.
    new = plant(a, root, rel, os.urandom(515))
    mark = log_mark(a)
    out = a.run("t0=$(date +%s%N); cloud_capture --full >/dev/null 2>&1; rc=$?; t1=$(date +%s%N); "
                "echo rc=$rc ms=$(( (t1 - t0) / 1000000 ))", check=False)
    fields = dict(kv.split("=", 1) for kv in out.split() if "=" in kv)
    rc, ms = int(fields.get("rc", -1)), int(fields.get("ms", -1))
    tail = log_since(a, mark)
    f += not check(rc == 0 and (entry(manifest_of(a), rel) or {}).get("sha256") == sha(new),
                   "--full on a wrong-but-stable card: exit 0 and the entry updated (it informs, it does not refuse)",
                   f"exit {rc}; entry {'updated' if (entry(manifest_of(a), rel) or {}).get('sha256') == sha(new) else 'NOT updated'}")
    f += not check(9000 <= ms < 60000, f"and it waited for the usual card first ({ms} ms; the 10 s ceiling of D-CLOUD-057)",
                   f"--full took {ms} ms: it did not wait for the card (or waited far past the ceiling)")
    f += not check("different card" in tail or "wait" in tail.lower(), "the wait was logged",
                   f"no card message in the log: {tail.strip()[-100:]!r}")

    # (d) the boot caller, statically. The staged copy first (the repo's
    # file), then the image's.
    staged = f"{a.path_prefix}/102-cloud-saves" if a.path_prefix else ""
    where = a.run(f"for x in {shlex.quote(staged)} /usr/lib/autostart/common/102-cloud-saves; do "
                  "[ -n \"$x\" ] && [ -e \"$x\" ] && { echo \"$x\"; break; }; done; true").strip()
    text = a.run(f"cat {shlex.quote(where)} 2>/dev/null || true") if where else ""
    absent = (f"static: {where or 'no autostart found'} has no 'cloud_capture --full' line -- the image predates the boot "
              "caller; stage autostart/102-cloud-saves beside the producer to check the repo's copy")
    got = boot_caller_gate(text.splitlines())
    if got is None:
        f += not check(False, "", absent)
        f += not check(False, "", absent)
        return f
    idx, enclosing, gate_ok, bg_ok = got
    f += not check(gate_ok, f"static: --full runs at boot inside an `if` on both cloud-saves toggles ({where}:{idx + 1})",
                   f"static: {where}:{idx + 1}: the enclosing test is {enclosing!r} -- expected an `if` naming both "
                   "cloudsaves.startup and cloudsaves.gameexit (a gameexit-only device runs it too; a line after the sync block's fi is ungated)")
    f += not check(bg_ok, "static: and detached under nice, ending in a single & (never delaying boot, D-CLOUD-057)",
                   f"static: the --full line is not `setsid|nohup ... nice ... &`: {text.splitlines()[idx].strip()[:90]!r}")
    return f


def fx_cap11(p):
    """CAP11: two writers of one manifest. The boot --full runs detached
    (D-CLOUD-064) and can overlap the first game's exit capture; capture
    takes no lock, so the loser must notice, and must not lose a first
    version -- a member with no entry and an mtime below the next --started
    is never stamped again. A shim beside a copy of the producer rewrites the
    manifest (adding an entry of its own) between the run's load and its
    rename, once. An exit capture that loses re-runs once against the
    winner's document: exit 0, its version recorded, the other writer's
    entry kept, the re-run logged. --full never retries: exit 1 and
    manifest-moved in capture-failures."""
    f = 0
    a, root = p.a, p.root
    p.reset()
    rel, rom = "gba/Two.srm", p.path("gba/Two.gba")
    plant(a, root, rel, os.urandom(500))
    rc, _ = capture(a, root, "gba", rom)
    if rc != 0:
        raise Fail(f"the setup capture exited {rc}")
    # The shim answers as cloud_device_id (siblings resolve beside $0) and on
    # the --label call -- which the producer makes after loading the manifest
    # and before writing it -- rewrites the manifest through tmp+rename, once.
    capbin, idbin, srbin = (a.run(f"command -v {x}").strip() for x in ("cloud_capture", "cloud_device_id", "cloud_saves_root"))
    other = {"kind": "save", "sha256": "f" * 64, "size": 1, "mtime": "2026-01-01T00:00:00Z", "unit": "gba:Other", "pub": None}
    a.run(f"rm -rf /tmp/qa-two; mkdir -p /tmp/qa-two; cp {shlex.quote(capbin)} /tmp/qa-two/cloud_capture; "
          f"cp {shlex.quote(srbin)} /tmp/qa-two/cloud_saves_root")
    a.write("/tmp/qa-two/cloud_device_id",
            ("#!/bin/sh\n"
             "if [ \"$1\" = --label ] && [ ! -e /tmp/qa-two/written ]; then\n"
             "    : > /tmp/qa-two/written\n"
             f"    m={shlex.quote(p.manifest)}\n"
             f"    [ -f \"$m\" ] && jq --argjson o {shlex.quote(json.dumps(other))} '.entries[\"gba/Other.srm\"] = $o' \"$m\" > \"$m.qa\" "
             "&& mv -f \"$m.qa\" \"$m\"\n"
             "fi\n"
             f"exec {shlex.quote(idbin)} \"$@\"\n").encode())
    a.run("chmod +x /tmp/qa-two/*")
    try:
        new = plant(a, root, rel, os.urandom(501))
        mark = log_mark(a)
        rc, _ = run_rc(a, f"/tmp/qa-two/cloud_capture --system gba --rom {shlex.quote(rom)} --emulator retroarch --core mgba --started 0")
        tail = log_since(a, mark)
        m = manifest_of(a) or {}
        f += not check(a.run("[ -e /tmp/qa-two/written ] && echo yes || echo no").strip() == "yes",
                       "the second writer landed between the run's load and its rename (the setup)",
                       "the shim never wrote: the race was not staged, and the checks below prove nothing")
        f += not check(rc == 0 and (entry(m, rel) or {}).get("sha256") == sha(new),
                       "the exit capture that lost the race exited 0 with its version recorded",
                       f"exit {rc}; entry sha {'is the new bytes' if (entry(m, rel) or {}).get('sha256') == sha(new) else 'IS NOT the new bytes -- a first version was dropped'}")
        f += not check((entry(m, "gba/Other.srm") or {}).get("sha256") == "f" * 64,
                       "and the winner's entry stands (the re-run built on the new document, not over it)",
                       "the other writer's entry is gone: the re-run clobbered the document it lost to")
        f += not check("re-running once" in tail, "the re-run was logged", f"no 're-running once' line: {tail.strip()[-100:]!r}")
        # --full does not retry: it is the writer an exit capture yields to.
        a.run("rm -f /tmp/qa-two/written")
        old = new
        plant(a, root, rel, os.urandom(502))
        n0 = failures_lines(a)
        rc, _ = run_rc(a, "/tmp/qa-two/cloud_capture --full")
        reason = a.run(f"tail -1 {CACHE}/capture-failures 2>/dev/null || true").strip()
        f += not check(rc == 1 and (entry(manifest_of(a), rel) or {}).get("sha256") == sha(old),
                       "--full that lost the race: exit 1 and its version not recorded (no retry; the next run's job)",
                       f"exit {rc}; entry {'still the previous version' if (entry(manifest_of(a), rel) or {}).get('sha256') == sha(old) else 'CHANGED'}")
        f += not check(failures_lines(a) > n0 and "manifest-moved" in reason, "capture-failures names manifest-moved",
                       f"capture-failures last line {reason!r}")
    finally:
        a.run("rm -rf /tmp/qa-two", check=False)
    return f


