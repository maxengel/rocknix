def sha(data):
    return hashlib.sha256(data).hexdigest()


def epath(remote_path):
    """The endpoint path of a cloud path, for `cloud-test-backend cat/put/ls`.
    On WebDAV the folder is the path; on S3 the first component is the
    bucket, which the backend's own commands already prefix -- passing it
    again doubled the path, and the seeding step read its note back from a
    place the device never looked."""
    path = remote_path.strip().lstrip("/")
    if backend("backend").strip() == "s3":
        path = path.split("/", 1)[1] if "/" in path else ""
    return path


def backend_bytes(path):
    p = subprocess.run([BACKEND, "cat", path], capture_output=True)
    return p.stdout if p.returncode == 0 else None


def backend_files(path):
    """Every file under an endpoint path, as paths relative to it."""
    out = subprocess.run([BACKEND, "ls", path], capture_output=True, text=True).stdout
    return [line.split(None, 1)[1] for line in out.splitlines() if len(line.split(None, 1)) == 2]


def backend_sizes(path):
    """Every file under an endpoint path with its size: {relative path: bytes}."""
    out = subprocess.run([BACKEND, "ls", path], capture_output=True, text=True).stdout
    sizes = {}
    for line in out.splitlines():
        parts = line.split(None, 1)
        if len(parts) == 2 and parts[0].isdigit():
            sizes[parts[1]] = int(parts[0])
    return sizes


def set_key(dev, key, val):
    dev.run(f"grep -q '^{key}=' {CONF} && sed -i 's|^{key}=.*|{key}=\"{val}\"|' {CONF} "
            f"|| echo '{key}=\"{val}\"' >> {CONF}")


def apply_settings(dev, settings):
    for key, val in settings.items():
        set_key(dev, key, val)


UNIT_MARK = re.compile(r"^>>> unit (.*)\|(\d*)\|(\d*)$")


def unit_protocol(out):
    """What the transfer page needs from a script's `>>> unit <item>|i|n`
    markers (#95): the page shows ITEM i OF n with the script's own n, so
    every n must be the same and equal to the number of announcements the
    run actually made, and i their running count, 1..n in order. A unit
    skipped without an announcement, or a stale n, reads on the page as a
    run that ended short (ITEM 2 OF 3). The saves scripts announce
    `SAVES||` and `SETTINGS||` with no numbers and let the page count; that
    shape passes when every marker in the run is unnumbered, and a mix does
    not. Returns (ok, items in order, a line for the message). A run with no
    marker at all is (True, [], ...) -- the caller says whether it expected one."""
    marks = [m.groups() for m in map(UNIT_MARK.match, out.splitlines()) if m]
    items = [item for item, _, _ in marks]
    detail = "announced " + ", ".join(f"{item}|{i}|{n}" for item, i, n in marks) if marks else "no unit announcement"
    if not marks:
        return True, items, detail
    if all(i == "" and n == "" for _, i, n in marks):
        return True, items, detail
    ok = (all(i.isdigit() and n.isdigit() for _, i, n in marks)
          and len({n for _, _, n in marks}) == 1
          and int(marks[0][2]) == len(marks)
          and [int(i) for _, i, _ in marks] == list(range(1, len(marks) + 1)))
    return ok, items, detail


def run_rc(dev, cmd, env=""):
    """Run a command the way its caller does; return (exit code, its output)."""
    out = dev.run(f"( {env} {cmd} ) >/tmp/qa-run.out 2>&1; echo rc=$?; cat /tmp/qa-run.out", check=False)
    first, _, rest = out.partition("\n")
    return (int(first[3:]) if first.startswith("rc=") else -1), rest


def touch_offset(dev, path, seconds):
    """Move a file's mtime relative to the device's clock -- the lever the
    shipped pipeline resolves by. busybox touch takes a date, not @epoch."""
    dev.run(f'touch -d "$(date -d @$(( $(date +%s) + ({seconds}) )) \'+%Y-%m-%d %H:%M:%S\')" {shlex.quote(path)}')


def log_mark(dev):
    return int(dev.run(f"wc -l < {LOG} 2>/dev/null || echo 0").strip() or 0)


def os_name(dev):
    """What every settings archive's name ends with: OS_NAME, read from the
    file /etc/profile reads it from, since an ssh session has run no profile."""
    return dev.run('. /etc/os-release 2>/dev/null; echo "$OS_NAME"', check=False).strip() or "ROCKNIX"


def log_since(dev, mark):
    return dev.run(f"tail -n +{mark + 1} {LOG} 2>/dev/null || true")


def name_of(digest, known):
    """Which planted version a hash is, for a message somebody can read."""
    for name, data in known.items():
        if digest == sha(data):
            return name
    return "absent" if digest is None else "neither (partial or foreign bytes)"


class Pair:
    def __init__(self, a, b, root, settings):
        self.a, self.b, self.root, self.settings = a, b, root, settings
        self.saves_remote = settings["SAVES_REMOTE"]
        self.spath = epath(self.saves_remote)

    def path(self, rel):
        return f"{self.root}/{rel}"

    def reset(self):
        """Empty the cloud and both saves trees, forget every stamp and
        record, put both devices back on the shared folder. Each fixture
        starts from nothing, so what one leaves behind cannot pass the next."""
        backend("reset")
        for d in (self.a, self.b):
            d.run(f"rm -rf {shlex.quote(self.root)} {CACHE}; mkdir -p {shlex.quote(self.root)} {CACHE}")
            apply_settings(d, self.settings)

    def cloud_sha(self, rel, folder=None):
        data = backend_bytes(f"{self.spath if folder is None else folder}/{rel}")
        return sha(data) if data is not None else None

    def agree(self, files):
        """The first pass: a backs up, b restores, both hold what the cloud holds."""
        for rel, data in files.items():
            self.a.write(self.path(rel), data)
        rc, _ = run_rc(self.a, "cloud_backup --yes --saves-only")
        rc2, _ = run_rc(self.b, "cloud_restore --yes --saves-only")
        wrong = [rel for rel, data in files.items()
                 if not (self.cloud_sha(rel) == sha(data) == self.b.sha(self.path(rel)))]
        if wrong:
            raise Fail(f"the first pass left {wrong} without agreement (backup exit {rc}, restore exit {rc2})")

    def both_changed(self, rel, h0, ha, hb, a_offset=3600):
        """Agreement on h0; b publishes hb; a edits to ha offline, its copy
        `a_offset` seconds newer (positive) or older than b's upload."""
        self.reset()
        self.agree({rel: h0})
        self.b.write(self.path(rel), hb)
        run_rc(self.b, "cloud_backup --yes --saves-only")
        if self.cloud_sha(rel) != sha(hb):
            raise Fail("b's publication did not reach the cloud")
        self.a.write(self.path(rel), ha)
        touch_offset(self.a, self.path(rel), a_offset)


def fx_a1(p):
    """A1: two devices agree on H0; b publishes HB; a edits to HA offline and
    runs every writer. Neither HA nor HB may be overwritten anywhere, and one
    conflict is reported. As shipped each writer is a recency resolver
    (blindspot 28): the cloud's copy or this device's is replaced, and
    nothing says so."""
    f = 0
    rel = "saves/Both Changed.srm"
    v = {"H0": b"H0: what both devices agreed on",
         "HA": b"HA: this device's edit, made offline, never seen by the cloud",
         "HB": b"HB: the other device's edit, already published"}
    for label, cmd in WRITERS:
        lost, rcs = [], []
        for timing, offset in (("this device's copy newer", 3600), ("the cloud's copy newer", -3600)):
            p.both_changed(rel, v["H0"], v["HA"], v["HB"], offset)
            rc, _ = run_rc(p.a, cmd)
            rcs.append(rc)
            cloud, local = p.cloud_sha(rel), p.a.sha(p.path(rel))
            if cloud != sha(v["HB"]):
                lost.append(f"{timing}: the cloud's HB became {name_of(cloud, v)}")
            if local != sha(v["HA"]):
                lost.append(f"{timing}: this device's HA became {name_of(local, v)}")
        f += not check(not lost, f"{label}: neither HA nor HB was overwritten",
                       f"{label}: " + "; ".join(lost) + " (blindspot 28)")
        f += not check(all(rc == 5 for rc in rcs),
                       f"{label}: reported one queued conflict (exit 5)",
                       f"{label}: no conflict reported (exit {rcs[0]} / {rcs[1]})")
    return f


def fx_a2(p):
    """A2: a failed push is retried at the next exit with nothing changed; an
    equal-size, equal-mtime byte change enters the changed set at the next
    full pass -- the hash catches what size and mtime cannot (#53's shape,
    on a save)."""
    f = 0
    rel = "saves/Retry.srm"
    v = {"H0": b"H0 agreed", "HA": b"HA: changed while the cloud was unreachable"}
    p.reset()
    p.agree({rel: v["H0"]})
    p.a.write(p.path(rel), v["HA"])
    # One push fails the way a lapsed sign-in does: the remote's password
    # (or S3 secret) wrong for that run, then put back. A closed port would
    # do too, but rclone retries a refused connection for ten minutes.
    good = p.a.run(f"cat {RCLONE_CONF}")
    p.a.run(f"sed -i \"s|^pass = .*|pass = $(rclone obscure wrong-password)|; s|^secret_access_key = .*|secret_access_key = wrong|\" {RCLONE_CONF}")
    rc1, _ = run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    p.a.write(RCLONE_CONF, good.encode())
    f += not check(rc1 != 0, f"the push failed while the cloud refused the sign-in (exit {rc1}; the setup)",
                   "a push the cloud refused reported success")
    rc2, _ = run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    f += not check(p.cloud_sha(rel) == sha(v["HA"]),
                   "the next exit, with nothing changed since, retried and published",
                   f"the failed push was not retried: the cloud holds {name_of(p.cloud_sha(rel), v)} (exit {rc2})")

    rel = "saves/Same Size.srm"
    one, two = b"version-one-of-this-save", b"version-two-of-this-save"
    assert len(one) == len(two)
    p.reset()
    p.agree({rel: one})
    # On b: new bytes, the same length, the mtime put back to what it was.
    q = shlex.quote(p.path(rel))
    p.b.run(f"cp -p {q} {q}.ref")
    p.b.write(p.path(rel), two)
    p.b.run(f"touch -r {q}.ref {q}; rm -f {q}.ref; sync")
    run_rc(p.b, "cloud_backup --yes --saves-only")
    run_rc(p.a, "cloud_restore --yes --saves-only")
    f += not check(p.a.sha(p.path(rel)) == sha(two),
                   "an equal-size, equal-mtime byte change entered the changed set at the full pass",
                   "an equal-size, equal-mtime byte change was never noticed: size and mtime matched "
                   "and nothing hashed, so a still holds version one (A2)")
    return f


def fx_a3(p):
    """A3: CHANGE CLOUD FOLDER to a folder holding different saves. Nothing
    downloads silently; identical pairs seed agreement; differing pairs
    queue. As shipped the pass after a re-link is the boot pair, which
    replaces this device's copy with the folder's newer one."""
    f = 0
    same, diff = "saves/Same In Both.srm", "saves/Differs.srm"
    v = {"H0": b"H0: in both folders", "X": b"X: this device's version",
         "Y": b"Y: the other folder's version, never seen here"}
    p.reset()
    p.agree({same: v["H0"], diff: v["X"]})
    second = p.saves_remote.rstrip("/") + "-second"
    set_key(p.b, "SAVES_REMOTE", second)
    p.b.write(p.path(same), v["H0"])
    p.b.write(p.path(diff), v["Y"])
    run_rc(p.b, "cloud_backup --yes --saves-only")
    set_key(p.b, "SAVES_REMOTE", p.saves_remote)
    if p.cloud_sha(diff, epath(second)) != sha(v["Y"]):
        raise Fail("b could not fill the second folder")
    # a changes folder the way CHANGE CLOUD FOLDER does; its differing copy is
    # older than the folder's, the shape recency gets wrong.
    rc, out = run_rc(p.a, f"cloud_setup --set-saves-remote {shlex.quote(second)}")
    if rc != 0:
        raise Fail(f"cloud_setup --set-saves-remote refused {second}: {out.strip()[-80:]}")
    touch_offset(p.a, p.path(diff), -3600)
    rc, _ = run_rc(p.a, BOOT_PAIR)
    got = p.a.sha(p.path(diff))
    f += not check(got == sha(v["X"]), "nothing on this device was replaced by the new folder's saves",
                   f"A SAVE WAS SILENTLY REPLACED after CHANGE CLOUD FOLDER: {diff} became {name_of(got, v)} (A3)")
    f += not check(p.a.sha(p.path(same)) == sha(v["H0"]), "the identical pair is untouched", "the identical pair changed")
    f += not check(rc == 5, "the differing pair was queued (exit 5)", f"no queue for the differing pair (exit {rc})")
    agreed = p.a.run(f"cat {CACHE}/agreed.json 2>/dev/null || true")
    f += not check(same in agreed and diff not in agreed,
                   "the identical pair seeded agreement and the differing one did not",
                   "no agreement record for the identical pair" if not agreed.strip()
                   else "the agreement record is wrong about which pair agrees")
    return f


def fx_a8(p):
    """A8: a publication interrupted after one member of an N64 pair (.eep and
    .mpk: one unit). No device installs the mixed set; an unrelated unit still
    moves; the hold clears when the second member lands.

    The pair sits beside the ROM (n64/Torn.eep, n64/Torn.mpk): every shipped
    mupen64plus.cfg has SaveSRAMPath = "/storage/roms/n64", so that is the
    layout the emulator writes and the unit capture can see (#21). It was
    n64/save/, a directory only the allowlist ever named."""
    f = 0
    eep, mpk, other = "n64/Torn.eep", "n64/Torn.mpk", "saves/Unrelated.srm"
    e = {"old": os.urandom(2048), "new": os.urandom(2560)}
    m = {"old": os.urandom(32768), "new": os.urandom(40960)}
    u0, u1 = b"unrelated, agreed", b"unrelated, changed on a meanwhile"
    p.reset()
    try:
        p.agree({eep: e["old"], mpk: m["old"], other: u0})
    except Fail as x:
        # The shipped allowlist admits n64/save/*.eep and **/*.srm, not the
        # .eep/.mpk the emulator writes beside the ROM, so until the includes
        # land (#89, the allowlist issue split from #21) the pair never
        # reaches the cloud and A8 cannot get past its first pass. Say so --
        # but only when the evidence is that shape: the .srm made it and
        # neither member of the pair did. A backend outage or a broken
        # cloud_backup is re-raised as itself, not dressed as the known gap.
        if p.cloud_sha(other) == sha(u0) and not p.cloud_sha(eep) and not p.cloud_sha(mpk):
            raise Fail(f"{x} -- a standalone N64 pair beside the ROM is not in the sync allowlist yet "
                       "(+ /**/*.eep, + /**/*.mpk: #89, the allowlist issue split from #21); A8 waits on it")
        raise
    p.b.write(p.path(eep), e["new"])
    p.b.write(p.path(mpk), m["new"])
    # b publishes one file at a time at 8 KiB/s; rclone is killed once the
    # .eep (first by name) has landed and the .mpk is still in flight.
    p.b.run("rm -f /tmp/qa-torn.out; (RCLONE_TRANSFERS=1 RCLONE_BWLIMIT=8k setsid cloud_backup --yes --saves-only "
            ">/tmp/qa-torn.out 2>&1 &)")
    for _ in range(120):
        time.sleep(0.25)
        if p.cloud_sha(eep) == sha(e["new"]):
            break
    p.b.run("pkill -9 -x rclone; for i in $(seq 40); do pgrep -x cloud_backup >/dev/null || break; sleep 0.25; done; true",
            check=False)
    torn = p.cloud_sha(eep) == sha(e["new"]) and p.cloud_sha(mpk) != sha(m["new"])
    f += not check(torn, "b's publication was interrupted after its first member (the setup)",
                   f"could not leave the publication torn: .eep is {name_of(p.cloud_sha(eep), e)}, "
                   f".mpk is {name_of(p.cloud_sha(mpk), m)}")
    if not torn:
        return f
    p.a.write(p.path(other), u1)
    run_rc(p.a, BOOT_PAIR)
    got = (name_of(p.a.sha(p.path(eep)), e), name_of(p.a.sha(p.path(mpk)), m))
    f += not check(got in {("old", "old"), ("new", "new")}, f"a installed no mixed set (its pair is {got[0]}/{got[1]})",
                   f"A MIXED SET WAS INSTALLED on a: .eep {got[0]}, .mpk {got[1]} (A8)")
    f += not check(p.cloud_sha(other) == sha(u1), "an unrelated unit still moved while the torn one was held",
                   "the unrelated unit did not move")
    run_rc(p.b, "cloud_backup --yes --saves-only")
    run_rc(p.a, BOOT_PAIR)
    got = (name_of(p.a.sha(p.path(eep)), e), name_of(p.a.sha(p.path(mpk)), m))
    f += not check(got == ("new", "new"), "the hold cleared when the second member landed",
                   f"after the second member landed a holds .eep {got[0]}, .mpk {got[1]}")
    return f


def fx_a9(p):
    """A9: delete and renumber on one device, sync repeatedly on the other; a
    retired hash put back; an unexplained rm; a saves root that is unmounted,
    empty, or pointed at an empty cloud folder, with agreement on record.

    The states live under savestates/gba/ and the save under gba/ -- the
    layout ES and RetroArch write, so the unit is one capture can see (#21).
    Where the deletion models the save-state manager's, `cloud_capture
    --retire` runs before the unlink, as GuiSaveState does, so the retired
    record #22 needs exists in the case that tests it (D-CLOUD-053)."""
    f = 0
    s = {"S1": os.urandom(3001), "S2": os.urandom(3002), "S3": os.urandom(3003)}
    st = lambda n: f"savestates/gba/Renumber.state{n}"
    p.reset()
    p.agree({st(1): s["S1"], st(2): s["S2"], st(3): s["S3"]})
    # a deletes slot 2 from the manager -- which records the deletion first
    # -- and ES renumbers: slot 3 becomes slot 2.
    rc, _ = run_rc(p.a, f"cloud_capture --retire {shlex.quote(p.path(st(2)))}")
    rows = [r for r in (manifest_of(p.a) or {}).get("retired") or [] if r.get("path") == st(2)]
    f += not check(rc == 0 and bool(rows) and rows[0].get("sha256") == sha(s["S2"]),
                   "the manager's deletion left a retired row for state2 with S2's sha (#21; the record #22 propagates)",
                   f"cloud_capture --retire exited {rc}; retired rows for state2: {[(r.get('sha256') or '')[:8] for r in rows]} "
                   "-- the #22 checks below would fail on a #21 precondition")
    p.a.run(f"rm -f {shlex.quote(p.path(st(2)))}; mv {shlex.quote(p.path(st(3)))} {shlex.quote(p.path(st(2)))}")
    run_rc(p.a, BOOT_PAIR)
    for _ in range(2):
        run_rc(p.b, BOOT_PAIR)

    def on(dev):
        out = dev.run(f"cd {shlex.quote(p.root)} && sha256sum savestates/gba/* 2>/dev/null || true")
        return sorted(name_of(line.split()[0], s) for line in out.splitlines() if line.strip())

    def in_cloud():
        return sorted(name_of(sha(backend_bytes(f"{p.spath}/{rel}") or b""), s)
                      for rel in backend_files(p.spath) if rel.startswith("savestates/"))

    f += not check(on(p.b) == ["S1", "S3"], "after repeated syncs b holds S1 and S3, each exactly once",
                   f"b holds {on(p.b)} (A9: each surviving version exactly once)")
    f += not check(in_cloud() == ["S1", "S3"], "and so does the cloud", f"the cloud holds {in_cloud()}")
    # The retired hash put back, as the discarded-saves tool would: a new
    # publication, which the old retired record must not consume.
    p.a.write(p.path(st(3)), s["S2"])
    run_rc(p.a, BOOT_PAIR)
    run_rc(p.b, BOOT_PAIR)
    f += not check(on(p.b) == ["S1", "S2", "S3"], "a retired hash put back reached b as a new publication",
                   f"b holds {on(p.b)} after the retired hash was put back")

    # An unexplained absence: rm, not ES's delete, so no retired record.
    gone, kept = "gba/Removed By Hand.srm", "saves/Kept.srm"
    g0 = b"removed by rm on a"
    p.reset()
    p.agree({gone: g0, kept: b"kept"})
    p.a.run(f"rm -f {shlex.quote(p.path(gone))}")
    rc, _ = run_rc(p.a, BOOT_PAIR)
    f += not check(p.a.sha(p.path(gone)) is None, "the file removed by hand was not put back on a",
                   "THE FILE REMOVED BY HAND CAME BACK: an absence was resolved by a download (A9)")
    f += not check(p.cloud_sha(gone) == sha(g0), "and the cloud's copy was not deleted",
                   "the cloud's copy was deleted on an unexplained absence")
    f += not check(rc == 5, "a question was queued (exit 5)", f"no question queued (exit {rc})")
    run_rc(p.b, BOOT_PAIR)
    f += not check(p.b.sha(p.path(gone)) == sha(g0), "b's copy was untouched", "b's copy was touched by a's unexplained absence")

    # Mass absence, with agreement on record: the root unmounted, then empty,
    # then the cloud folder empty. Every pass refuses and names the reason.
    p.reset()
    p.agree({"saves/On Record.srm": b"agreed and on record"})
    passes = WRITERS[:5]
    q = shlex.quote(p.root)
    p.a.run(f"mv {q} {q}.away")
    try:
        runs = [run_rc(p.a, c) for _, c in passes]
        rcs = [rc for rc, _ in runs]
        present = p.a.run(f"find {q} -type f 2>/dev/null | wc -l").strip()
    finally:
        p.a.run(f"rm -rf {q}; mv {q}.away {q}")
    f += not check(all(rc == 1 for rc in rcs), "with the saves root unmounted every pass refused (exit 1)",
                   f"passes on an unmounted root exited {rcs} (A9: refuse, reason named)")
    f += assert_message(runs[0][1], runs[0][0], label="the refusal (unmounted root): ")
    f += not check(present == "0", "and nothing was written where the root should be",
                   f"{present} file(s) were written into a root that was not mounted")
    p.a.run(f"mv {q} {q}.away; mkdir -p {q}")
    try:
        runs = [run_rc(p.a, c) for _, c in passes]
        rcs = [rc for rc, _ in runs]
        present = p.a.run(f"find {q} -type f 2>/dev/null | wc -l").strip()
    finally:
        p.a.run(f"rm -rf {q}; mv {q}.away {q}")
    f += not check(all(rc == 1 for rc in rcs), "with the saves root empty every pass refused (exit 1)",
                   f"passes on an empty root exited {rcs}")
    f += assert_message(runs[0][1], runs[0][0], label="the refusal (empty root): ")
    f += not check(present == "0", "and nothing was downloaded into it",
                   f"{present} file(s) were downloaded into an empty root with agreement on record")
    empty = p.saves_remote.rstrip("/") + "-empty"
    set_key(p.a, "SAVES_REMOTE", empty)
    runs = [run_rc(p.a, c) for _, c in passes]
    rcs = [rc for rc, _ in runs]
    set_key(p.a, "SAVES_REMOTE", p.saves_remote)
    f += assert_message(runs[0][1], runs[0][0], label="the refusal (empty cloud folder): ")
    uploaded = backend_files(epath(empty))
    f += not check(all(rc == 1 for rc in rcs), "with the cloud folder empty every pass refused (exit 1)",
                   f"passes against an empty cloud folder exited {rcs}")
    f += not check(not uploaded, "and nothing was uploaded to it",
                   f"{len(uploaded)} file(s) were uploaded into an empty cloud folder with agreement on record")
    queued = p.a.run(f"cat {CACHE}/queue.json 2>/dev/null || true").strip()
    f += not check(not queued, "no question was queued for a mass absence", "a mass absence queued questions")
    return f


def fx_a11(p):
    """A11: a cloned card -- the second device carries the first's identity.
    It refuses to publish with duplicate-device-id and transfers nothing."""
    f = 0
    rel = "saves/Cloned.srm"
    h0 = b"H0 published by the first card"
    a_id = p.a.run("cloud_device_id").strip()
    prev = p.b.run(f"cat {ID_FILE} 2>/dev/null || true")
    p.reset()
    p.agree({rel: h0})
    p.b.write(ID_FILE, (a_id + "\n").encode())
    try:
        p.b.write(p.path(rel), b"HB from the clone")
        mark = log_mark(p.b)
        rc, out = run_rc(p.b, "cloud_backup --yes --saves-only")
        said = "duplicate-device-id" in out + log_since(p.b, mark)
        f += not check(rc == 1 and said, "the clone was refused with duplicate-device-id",
                       f"THE CLONE PUBLISHED (exit {rc}, no duplicate-device-id refusal) (A11)")
        f += not check(p.cloud_sha(rel) == sha(h0), "and transferred nothing",
                       "the clone's copy replaced the first card's in the cloud")
    finally:
        p.b.write(ID_FILE, prev.encode())
    return f


def fx_a12(p):
    """A12 (D-CLOUD-040): an upgraded config carrying a legacy RESTOREPATH
    unlike BACKUPPATH. The helper migrates SAVESPATH from BACKUPPATH, drops
    RESTOREPATH and writes one WARN naming the ignored folder; nothing in that
    folder is touched; the passes proceed."""
    f = 0
    a = p.a
    other = SCRATCH + "-other"
    p.reset()
    p.agree({"saves/Agreed.srm": b"agreed before the upgrade"})
    untouched = b"lives in the folder RESTOREPATH named"
    a.write(f"{other}/saves/Untouched.srm", untouched)
    saved = a.run(f"cat {CONF}")
    keep = [l for l in saved.splitlines()
            if not re.match(r"^(SAVESPATH|SETTINGS_BACKUPS|SAVES_REMOTE|SETTINGS_REMOTE|CONTENT_REMOTE)=", l)]
    old = keep + [f'BACKUPPATH="{p.root}"', f'BACKUPFOLDER="{p.root}/backup"', f'RESTOREPATH="{other}"',
                  f'SYNCPATH="{p.settings["SAVES_REMOTE"]}"', f'SYNCPATH_BACKUP="{p.settings["SETTINGS_REMOTE"]}"',
                  f'CONTENTPATH="{p.settings["CONTENT_REMOTE"]}"', ""]
    a.write(CONF, "\n".join(old).encode())
    try:
        mark = log_mark(a)
        rc_h, out_h = run_rc(a, f"cloud_sync_helper {LOG}")
        f += assert_message(out_h, rc_h, label="the helper's migration: ")
        conf = a.run(f"cat {CONF}")
        warns = [l for l in log_since(a, mark).splitlines() if "WARN" in l and other in l]
        f += not check(f'SAVESPATH="{p.root}"' in conf, "SAVESPATH was migrated from BACKUPPATH",
                       "SAVESPATH was not carried from BACKUPPATH")
        f += not check("RESTOREPATH=" not in conf, "RESTOREPATH was dropped",
                       "RESTOREPATH is still in the config (A12: dropped, warned once)")
        f += not check(len(warns) == 1, "one WARN names the ignored folder",
                       f"{len(warns)} WARN line(s) name {other}; expected exactly one")
        rc, _ = run_rc(a, BOOT_PAIR)
        f += not check(rc == 0, "the pass proceeded (exit 0)", f"the pass refused (exit {rc}) instead of migrating")
        f += not check(a.sha(f"{other}/saves/Untouched.srm") == sha(untouched),
                       "nothing in the ignored folder was touched", "the ignored folder was touched")
    finally:
        a.write(CONF, saved.encode())
        a.run(f"rm -rf {shlex.quote(other)}")
    return f


def fx_a14(p):
    """A14: the manifest step, in two halves. #21's: a state (with its
    thumbnail) and a save planted on the unit layout, the producer run the way
    ES runs it at exit -- the working copy at /storage/.cache/cloud_sync holds
    an entry for both with the planted shas. #22's: the exit path pushes it,
    so the manifest is on the remote under savestates/.rocknix/ with the same
    sha256, remote_hash null on WebDAV and non-null on MinIO; and the
    ROMs-and-BIOS tier never sees the savestates directory. The remote checks
    stay, and stay failing, until #22 pushes the file.

    The paths carry a <system> component because no unit table can see
    savestates/Manifest Game.state1 or saves/Manifest Game.srm: without the
    layout and without a call to the producer, nothing would ever have
    written the entry this fixture asserted."""
    f = 0
    state, save = "savestates/gba/Manifest Game.state1", "gba/Manifest Game.srm"
    sbytes, vbytes = b"#RZIPv" + os.urandom(2000), os.urandom(512)
    p.reset()
    p.a.write(p.path(state), sbytes)
    p.a.write(p.path(state + ".png"), b"\x89PNG" + os.urandom(300))
    p.a.write(p.path(save), vbytes)
    rc, _ = capture(p.a, p.root, "gba", p.path("gba/Manifest Game.gba"))
    a_id = p.a.run("cloud_device_id").strip()
    local = manifest_of(p.a)
    got = {rel: (entry(local, rel) or {}).get("sha256") for rel in (state, save)}
    f += not check(rc == 0 and got[state] == sha(sbytes) and got[save] == sha(vbytes),
                   f"the working copy {CACHE}/manifest-{a_id}.json holds both entries with the planted shas (#21)",
                   f"exit {rc}; working copy {'absent' if local is None else 'present'}; entries "
                   f"{ {k: (v or '')[:8] for k, v in got.items()} } (#21)")
    run_rc(p.a, "cloud_backup --yes --saves-only --recent")
    mpath = f"{p.spath}/savestates/.rocknix/manifest-{a_id}.json"
    raw = backend_bytes(mpath)
    f += not check(raw is not None, "the manifest reached the cloud under savestates/.rocknix/",
                   f"no manifest at {mpath} after the exit path (A14)")
    if raw is not None:
        try:
            m = json.loads(raw)
        except ValueError:
            m = {}
        pushed = m.get("entries", {}).get(state) if isinstance(m, dict) else None
        f += not check(bool(pushed) and pushed.get("sha256") == sha(sbytes),
                       "its entry for the state carries the planted bytes' sha256 (#22)",
                       "the pushed manifest has no entry for the state, or its sha256 is not the planted bytes' (#22)")
        kind = backend("backend").strip()
        rh = (pushed or {}).get("remote_hash", "unset")
        f += not check((rh is None) if kind == "webdav" else rh not in (None, "unset"),
                       f"remote_hash is {'null' if kind == 'webdav' else 'non-null'} on {kind}",
                       f"remote_hash is {rh!r} on {kind}")
    listed = p.a.run("cloud_content_backup --list 2>/dev/null || true").split()
    f += not check("savestates" not in listed, "the ROMs-and-BIOS tier never offers savestates",
                   "the content tier offers the savestates directory (the manifest would ride twice)")
    return f


def fx_a5(p):
    """A5: a test-only reader answers "this game, newest first, thumbnail,
    producing device, winning side" from the cloud store alone, on a second
    device that never made the decision."""
    f = 0
    rel = "savestates/Decided.state1"
    p.both_changed(rel, os.urandom(4001), os.urandom(4002), os.urandom(4003))
    p.a.write(p.path(rel + ".png"), b"\x89PNG a's thumbnail")
    rc, _ = run_rc(p.a, APPLY.format(unit=shlex.quote(rel), side="left"))
    store = p.saves_remote.rstrip("/") + "-discarded"
    # The reader, on b: the store listed and every record read as one line;
    # nothing local consulted.
    reader = ("R=$(rclone listremotes 2>/dev/null | head -1); S=" + shlex.quote(store) + "; "
              "rclone lsf -R --files-only \"${R}${S}\" 2>/dev/null | while IFS= read -r r; do "
              "case \"$r\" in */record.json|record.json) rclone cat \"${R}${S}/${r}\" | jq -c . ;; "
              "*) echo \"MEMBER $r\" ;; esac; done")
    out = p.b.run(reader, check=False)
    records, members = [], []
    for line in out.splitlines():
        if line.startswith("MEMBER "):
            members.append(line[7:])
            continue
        try:
            records.append(json.loads(line))
        except ValueError:
            pass
    f += not check(bool(records), "b read a decision record from the store",
                   f"NO RECORD IN THE STORE at {epath(store)} (apply exit {rc}) (A5)")
    if records:
        r = sorted(records, key=lambda r: r.get("decided_at", ""), reverse=True)[0]
        want = {"decided_at": r.get("decided_at"),
                "producer": (r.get("loser") or {}).get("producer") or r.get("producer"),
                "winner side": (r.get("winner") or {}).get("side")}
        f += not check(all(want.values()), "the newest record names when, the producing device and the winning side",
                       f"the record lacks {[k for k, v in want.items() if not v]}")
        f += not check(any(m.endswith(".png") for m in members), "the loser's thumbnail travelled with it",
                       "no thumbnail beside the record")
    return f


def fx_retention(p):
    """The retention ordering (#22 R9): the loser and its record are verified
    in the cloud before the winner replaces anything. Killed between the two,
    the loser is in the store, the head is unchanged, the device's copy is
    still its own."""
    f = 0
    rel = "saves/Ordered.srm"
    v = {"H0": os.urandom(65536), "HA": os.urandom(65537), "HB": os.urandom(65538)}
    p.both_changed(rel, v["H0"], v["HA"], v["HB"])
    store = epath(p.saves_remote.rstrip("/") + "-discarded")
    # KEEP LEFT: the cloud's HB wins; a's HA is the loser, pushed to the store
    # first. At 8 KiB/s a 64 KiB transfer takes eight seconds, so the record
    # is on the remote well before the winner's replacement completes.
    p.a.run("rm -f /tmp/qa-apply.out; (RCLONE_BWLIMIT=8k setsid " + APPLY.format(unit=shlex.quote(rel), side="left")
            + " >/tmp/qa-apply.out 2>&1 &)")
    seen = False
    for _ in range(160):
        time.sleep(0.25)
        if any(r.endswith("record.json") for r in backend_files(store)):
            seen = True
            break
        if not p.a.run("pgrep -x cloud_reconcile >/dev/null && echo running", check=False).strip():
            break
    p.a.run("pkill -9 -x rclone; pkill -9 -x cloud_reconcile; true", check=False)
    tail = p.a.run("tail -c 120 /tmp/qa-apply.out 2>/dev/null || true", check=False).strip()
    f += not check(seen, "the loser's record appeared in the store (the kill point)",
                   f"no record.json ever appeared under {store} (apply said: {tail!r})")
    if seen:
        stored = [sha(backend_bytes(f"{store}/{r}") or b"") for r in backend_files(store) if not r.endswith("record.json")]
        f += not check(sha(v["HA"]) in stored, "the loser's bytes are in the store, hash-equal",
                       f"the store holds {[name_of(x, v) for x in stored]}, not HA")
    f += not check(p.cloud_sha(rel) == sha(v["HB"]), "the head is unchanged",
                   f"the head became {name_of(p.cloud_sha(rel), v)}")
    f += not check(p.a.sha(p.path(rel)) == sha(v["HA"]), "the device's copy was not replaced before the loser was verified",
                   f"the device's copy became {name_of(p.a.sha(p.path(rel)), v)}")
    return f


PAIR_FIXTURES = [
    ("A1", "both changed after a first pass: every writer, this device's copy newer and older", fx_a1),
    ("A2", "a failed push retried; an equal-size, equal-mtime change after a first pass", fx_a2),
    ("A3", "CHANGE CLOUD FOLDER to a folder holding different saves", fx_a3),
    ("A8", "a torn N64 pair: interrupted after one member, held, then cleared", fx_a8),
    ("A9", "delete and renumber; a retired hash put back; rm; an unmounted, empty, or empty-cloud root", fx_a9),
    ("A11", "a cloned device id refuses to publish", fx_a11),
    ("A12", "a legacy RESTOREPATH unlike BACKUPPATH: migrated, warned, nothing touched", fx_a12),
    ("A14", "the manifest step: under savestates/.rocknix/, sha256, remote_hash per backend, one tier", fx_a14),
    ("A5", "the discarded-saves reader, from the second device", fx_a5),
    ("RETENTION", "the retention ordering: killed after the loser is stored, before the winner replaces", fx_retention),
]


def run_pair(a, b, root, remote, args, settings):
    failures = 0
    only = {k.strip().upper() for k in args.only.split(",")} if args.only else None
    p = Pair(a, b, root, settings)
    # The cache directory holds each device's stamps and selections; the
    # fixtures wipe it between runs, so it is carried across and put back.
    had = {d: snapshot_cache(d) for d in (a, b)}
    try:
        for key, title, fn in PAIR_FIXTURES:
            if only and key not in only:
                continue
            step(f"{key} -- {title}")
            try:
                failures += fn(p)
            except Fail as e:
                failures += 1
                print(f"    FAIL  {e}")
            for which, d in (("a", a), ("b", b)):
                failures += litter_scan(d, settings, remote, label=f"{key} on {which}: ")
        if not only or "CONTRACT" in only:
            for kind in args.transport.split(","):
                failures += run_contract(p, kind.strip(), args)
    finally:
        p.reset()
        for d in (a, b):
            restore_cache(d, had[d])
    return failures


# ===========================================================================
# #86: where the device's identity comes from -- one device, and the cloud
# ===========================================================================
#
# The single-device suite proves what a device does with its id; this proves
# where the id comes from. Both handhelds printed the same hash, ee5013fc56,
# because every kernel that builds in the IPv6 sit tunnel has a sit0 that
# sorts before wlan0, `ethtool -P sit0` says "not set", and the old
# permanent_address accepted the string "notset" as a seed. The VM's kernel
# has sit as a module and its eth0 sorts first, so it never hit the trap by
# accident; here sit is loaded and the functions of the staged script are run
# with the interface list narrowed to sit0 -- by overriding usable_interfaces
# in the harness's own shell after sourcing the script, never through a hook
# in the product. A macvlan on eth0 stands in for an interface the name list
# does not know: it is ARPHRD_ETHER with no bus device behind it, so only the
# sysfs tests can refuse it. The restore half needs the QA endpoint, which is
# why this is its own registry and not a capture fixture.

# md5("notset|unknown")[:10]: the hash every affected device carried.
POISONED = hashlib.md5(b"notset|unknown").hexdigest()[:10]
assert POISONED == "ee5013fc56"

A15_DRIVER = "/tmp/qa-a15-fn"
A15_HOST = "A15HOST"
A15_PLANT = "/tmp/qa-a15-plant"
A15_ASIDE = "/tmp/qa-a15-aside"      # the device's own manifest working copies, for the run
A15_MACVLAN = "qa0mv"                # type 1, no device link: only the sysfs tests refuse it


def fx_a15(dev, root, remote, settings):
    """A15 (#86): the seed is a MAC or nothing.

    (a) With sit0 present, the old pipeline yields "notset" for it (the trap
        is real on this kernel); permanent_address yields nothing for sit0
        and a MAC for eth0; the product's own interface list omits sit0.
        A macvlan on eth0 is type 1 with no device link and matches no name
        pattern, so only the sysfs tests can refuse it: the list omits it
        too, and permanent_address reaches eth0 past it.
    (b) A planted <hostname>-ee5013fc56 -- the RG35XX SP's shape -- heals on
        one run to <label>-<md5(MAC|unknown)[:10]>, which is the hash this
        guest already had, so the recipe is unchanged; the old id is kept in
        .previous, the change is in the cloud-sync log and the journal (both
        marked before the run, so only this run's lines count), and
        --previous lists the recorded id, then <label>-ee5013fc56, then
        <hostname>-ee5013fc56 for a hostname unlike the label. cloud_capture
        --full then carries manifest-<old id>.json to the new name, once.
    (c) An archive planted under the old folder is found by cloud_restore
        through the --previous tier, and the log names the folder and why;
        an archive in the device's own folder wins over it. With the upload
        marker saying the local archive was already sent -- as an old build
        left it after uploading to the old folder -- a backup still lands in
        the healed folder, the marker then names that folder, and the run
        after has nothing to send; the old folder is neither written to nor
        trimmed.
    (d) A second run returns the healed id and rewrites nothing -- mtimes
        moved back first, so a same-content rewrite would show; a healthy id
        that does not match this hardware is returned unchanged.
    (e) With no usable adapter the poisoned id is returned unchanged and
        nothing is written.
    (f) Without sit0 the two guessed names leave --previous: a device that
        never had one could not have written under the constant."""
    f = 0
    tool = dev.run("command -v cloud_device_id 2>/dev/null || true").strip()
    if not tool:
        raise Fail("cloud_device_id does not resolve on the device")
    print(f"    under test: {tool}")

    # What the fixture disturbs, captured before anything is written.
    saved_id = dev.run(f"cat {ID_FILE} 2>/dev/null || true")
    had_prev = dev.run(f"[ -e {ID_FILE}.previous ] && echo yes || echo no").strip() == "yes"
    saved_prev = dev.run(f"cat {ID_FILE}.previous 2>/dev/null || true")
    had_sit = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "yes"
    hostname = dev.run("hostname").strip()
    opt_line = dev.run(f"grep -m1 '^BACKUPFILE_RESTORE_OPTION=' {CONF} 2>/dev/null || true").strip()
    marker = f"{CACHE}/settings-backup.uploaded"
    had_marker = dev.run(f"[ -e {marker} ] && echo yes || echo no").strip() == "yes"
    saved_marker = dev.run(f"cat {marker} 2>/dev/null || true")
    # What cloud_capture --full leaves in the cache besides the manifest: its
    # stamp and stage directory. Removed afterwards only if this run made them.
    capture_litter = [x for x in (f"{CACHE}/last-capture", f"{CACHE}/stage")
                      if dev.run(f"[ -e {x} ] && echo yes || echo no").strip() == "no"]
    # The device's manifest working copies, whatever their names: (b) plants
    # one under the poisoned id and expects it under the healed one, and a
    # real one under either name would be mistaken for the fixture's.
    dev.run(f"rm -rf {A15_ASIDE}; mkdir -p {A15_ASIDE}; "
            f"for m in {CACHE}/manifest-*.json; do [ -e \"$m\" ] && mv \"$m\" {A15_ASIDE}/; done; true", check=False)
    settings_remote = settings.get("SETTINGS_REMOTE") or settings.get("SYNCPATH_BACKUP") or ""
    if not settings_remote:
        raise Fail("no SETTINGS_REMOTE in the harness's settings; cannot plant a folder")
    base = f"{remote}:{settings_remote}"
    broot = f"{root}/backup"
    a15_save = f"{root}/saves/qa-a15.srm"
    folders = []
    mv_made = False

    # One function of the staged script, in a shell that has sourced every
    # definition but the final dispatch line. A15_IFACES, when set, replaces
    # usable_interfaces in that shell -- the narrowing lives here.
    driver = """#!/bin/bash
tool="$1"; fn="$2"; shift 2
eval "$(sed '/^main "\\$@"$/d' "${tool}")"
if [ -n "${A15_IFACES}" ]; then
    usable_interfaces() { tr ' ' '\\n' <<< "${A15_IFACES}"; }
fi
"${fn}" "$@"
"""
    dev.write(A15_DRIVER, driver.encode())
    dev.run(f"chmod +x {A15_DRIVER}")

    def fn(name, ifaces=None):
        env = f"A15_IFACES={shlex.quote(ifaces)}" if ifaces is not None else ""
        return run_rc(dev, f"{A15_DRIVER} {shlex.quote(tool)} {name}", env=env)

    def id_file():
        return dev.run(f"cat {ID_FILE} 2>/dev/null || true").strip()

    def prev_file():
        return dev.run(f"cat {ID_FILE}.previous 2>/dev/null || true").split()

    def mtime(path):
        # Nanoseconds. %Y is whole seconds, and a run that finishes in the
        # same second as the plant would hide a rewrite behind it.
        return dev.run(f"stat -c '%y' {shlex.quote(path)} 2>/dev/null || true", check=False).strip()

    def journal_mark():
        # Line count, as log_mark does for the file: every earlier A15 run
        # left an identical "healed" line in the journal, so a tail of the
        # journal matched with or without this run writing one.
        return int(dev.run("journalctl -t cloud_device_id -o cat --no-pager 2>/dev/null | wc -l",
                           check=False).strip() or 0)

    def journal_since(mark):
        return dev.run(f"journalctl -t cloud_device_id -o cat --no-pager 2>/dev/null | tail -n +{mark + 1}",
                       check=False)

    def plant(folder, name, body):
        dev.write(f"{A15_PLANT}/{name}", body)
        dev.run(f"rclone copyto {shlex.quote(f'{A15_PLANT}/{name}')} {shlex.quote(f'{folder}/{name}')}")
        if folder not in folders:
            folders.append(folder)

    def listing(folder):
        return dev.run(f"rclone lsf --files-only {shlex.quote(folder + '/')} 2>/dev/null || true", check=False).split()

    try:
        # --- (a) ---------------------------------------------------------------
        print("    -- (a) the guard: sit0 yields nothing, eth0 yields a MAC")
        if not had_sit:
            dev.run("modprobe sit 2>/dev/null || true", check=False)
        sit_now = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "yes"
        f += not check(sit_now, "sit0 is present (modprobe sit)",
                       "sit0 could not be created; the trap cannot be reproduced on this guest")
        raw = dev.run("ethtool -P sit0 2>/dev/null | sed 's/.*: //' | tr -d ' \\r\\n'").strip()
        f += not check(raw == "notset",
                       f"the old pipeline turns `ethtool -P sit0` into {raw!r} -- the string both handhelds hashed",
                       f"`ethtool -P sit0` became {raw!r}, not 'notset'; this kernel does not reproduce the trap")
        stype = dev.run("cat /sys/class/net/sit0/type 2>/dev/null; [ -e /sys/class/net/sit0/device ] && echo device || echo no-device").split()
        etype = dev.run("cat /sys/class/net/eth0/type 2>/dev/null; [ -e /sys/class/net/eth0/device ] && echo device || echo no-device").split()
        print(f"          sit0: type {stype[0] if stype else '?'}, {stype[1] if len(stype) > 1 else '?'}; "
              f"eth0: type {etype[0] if etype else '?'}, {etype[1] if len(etype) > 1 else '?'}")
        rc, out = fn("permanent_address", "sit0")
        f += not check(rc != 0 and not out.strip(),
                       f"permanent_address yields nothing for sit0 (exit {rc})",
                       f"permanent_address ACCEPTED sit0: exit {rc}, {out.strip()!r}")
        rc, out = fn("usable_interfaces")
        listed = out.split()
        f += not check("eth0" in listed and "sit0" not in listed and "lo" not in listed,
                       f"the script's own usable_interfaces lists {listed} with sit0 present",
                       f"usable_interfaces listed {listed}")
        mac = dev.run("ethtool -P eth0 2>/dev/null | sed 's/.*: //' | tr -d ' \\r\\n'").strip()
        rc, out = fn("permanent_address", "eth0")
        f += not check(rc == 0 and out.strip() == mac
                       and re.fullmatch(r"([0-9a-f]{2}:){5}[0-9a-f]{2}", mac, re.I) is not None,
                       f"permanent_address yields eth0's permanent address, {mac}",
                       f"permanent_address gave {out.strip()!r} (exit {rc}) for eth0, whose address is {mac!r}")
        if not mac:
            raise Fail("eth0 has no permanent address; the rest of the fixture cannot run")
        expected_hash = hashlib.md5(f"{mac}|unknown".encode()).hexdigest()[:10]
        rc, out = fn("poisoned_hash")
        f += not check(out.strip() == POISONED,
                       f"the script derives the poisoned constant as {out.strip()}",
                       f"the script's poisoned_hash is {out.strip()!r}, not {POISONED}")
        # The sysfs tests on their own. sit0 is refused by its name as well,
        # so a script with the two tests deleted still passed the checks
        # above. A macvlan matches no name pattern and is ARPHRD_ETHER with
        # no bus device behind it -- the only thing that can refuse it is
        # the device-link test; `ethtool -P` on it says "not set", which is
        # the trap's own string.
        dev.run(f"ip link del {A15_MACVLAN} 2>/dev/null || true", check=False)
        rc_mv, out_mv = run_rc(dev, f"ip link add {A15_MACVLAN} link eth0 type macvlan")
        mv_made = rc_mv == 0
        if mv_made:
            mtype = dev.run(f"cat /sys/class/net/{A15_MACVLAN}/type 2>/dev/null; "
                            f"[ -e /sys/class/net/{A15_MACVLAN}/device ] && echo device || echo no-device").split()
            f += not check(mtype[:2] == ["1", "no-device"],
                           f"{A15_MACVLAN} (a macvlan on eth0) is type 1 with no device link: no name pattern catches it, only the sysfs tests can",
                           f"{A15_MACVLAN} is {mtype}; it does not isolate the sysfs tests")
            rc, out = fn("usable_interfaces")
            listed = out.split()
            f += not check("eth0" in listed and A15_MACVLAN not in listed,
                           f"usable_interfaces omits {A15_MACVLAN} and keeps eth0: {listed}",
                           f"usable_interfaces listed {listed}: the device-link test did not refuse {A15_MACVLAN}")
            rc, out = fn("permanent_address", f"{A15_MACVLAN} eth0")
            f += not check(rc == 0 and out.strip() == mac,
                           f"with {A15_MACVLAN} sorting first, permanent_address still yields eth0's address (valid_mac refuses its 'not set')",
                           f"permanent_address gave {out.strip()!r} (exit {rc}) with the list {A15_MACVLAN} eth0")
        else:
            f += not check(False, "",
                           f"could not create a macvlan {A15_MACVLAN} on eth0 (exit {rc_mv}: {out_mv.strip()[-80:]}); the sysfs tests are unproven")

        # --- (b) ---------------------------------------------------------------
        print("    -- (b) a poisoned stored id heals once")
        label = dev.run("cloud_device_id --label").strip()
        if not label:
            raise Fail("cloud_device_id --label printed nothing")
        # The hostname shape: ROCKNIX-ee5013fc56 on the RG35XX SP, whose id
        # predates the label. The label shape (the RG SP's) is then the
        # guessed line of --previous, covered on its own below.
        poisoned = f"{hostname}-{POISONED}"
        label_p = f"{label}-{POISONED}"
        expected = f"{label}-{expected_hash}"
        if hostname == label:
            print(f"          (hostname and label are both {label}: the two shapes of the constant collapse here)")
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}; rm -f {ID_FILE}.previous")
        mark = log_mark(dev)
        jmark = journal_mark()
        rc, out = run_rc(dev, "cloud_device_id")
        new_id = out.strip()
        f += not check(rc == 0 and new_id == expected,
                       f"{poisoned} healed to {new_id}",
                       f"cloud_device_id printed {new_id!r} (exit {rc}); expected {expected}")
        f += not check(id_file() == expected, "the id file holds the healed id",
                       f"the id file holds {id_file()!r}")
        f += not check(prev_file() == [poisoned],
                       f"the .previous file holds the old id once",
                       f".previous holds {prev_file()}")
        # The hash, not the whole id: the guest's stored id was written by the
        # image's own cloud_device_id, whose label rule may be older than the
        # staged script's (GENERICX64 from the hostname against GENERIC-X64
        # from HW_DEVICE, 2026-09-08). The recipe under test is the hash.
        before = saved_id.strip()
        before_hash = before.rsplit("-", 1)[-1] if before else ""
        if before_hash and before_hash != POISONED:
            f += not check(expected_hash == before_hash,
                           f"the healed hash {expected_hash} is the one this guest generated before the change ({before}): the recipe is unchanged",
                           f"the healed hash {expected_hash} differs from the guest's own {before}: THE RECIPE CHANGED")
            if before != new_id:
                print(f"          (label {before.rsplit('-', 1)[0]} -> {label}: the label rule, not the hash)")
        else:
            print(f"    SKIP  recipe check - the guest's own id ({before or 'none'}) is not a healthy one to compare with")
        legacy = dev.run("cloud_device_id --legacy").strip()
        f += not check(legacy == f"{hostname}-{expected_hash}",
                       f"--legacy is {legacy}: the hostname and the same hash",
                       f"--legacy is {legacy!r}; expected {hostname}-{expected_hash}")
        tail = log_since(dev, mark)
        f += not check(poisoned in tail and expected in tail and "[cloud_device_id]" in tail,
                       "the cloud-sync log records old -> new under the cloud_device_id tag",
                       f"the cloud-sync log does not: {tail.strip()[-200:]!r}")
        journal = journal_since(jmark)
        f += not check(expected in journal and poisoned in journal,
                       "and so does the journal (logger -t cloud_device_id), in a line this run wrote",
                       f"the journal gained nothing saying so: {journal.strip()[-200:]!r}")
        rc, out = run_rc(dev, "cloud_device_id --previous")
        lines = out.split()
        want = [poisoned] if hostname == label else [poisoned, label_p]
        f += not check(lines == want,
                       f"--previous lists {lines}: the recorded id, then <label>-{POISONED}"
                       + (" (which is the recorded one here)" if hostname == label else f"; <hostname>-{POISONED} is the recorded one"),
                       f"--previous listed {lines}; expected {want}")
        dev.run(f"hostname {A15_HOST}")
        rc, out = run_rc(dev, "cloud_device_id --previous")
        dev.run(f"hostname {shlex.quote(hostname)}")
        lines2 = out.split()
        want2 = want + [f"{A15_HOST}-{POISONED}"]
        f += not check(lines2 == want2,
                       f"with the hostname {A15_HOST}, --previous adds {A15_HOST}-{POISONED} last",
                       f"--previous listed {lines2}; expected {want2}")

        # The working copy follows the id. The boot pass is `cloud_capture
        # --full`, whose first act is to call cloud_device_id -- so on the
        # handhelds this is where the heal happens and where the manifest
        # written under the old id would be orphaned.
        print("    -- (b) cloud_capture --full carries the working copy to the healed id")
        man_old = f"{CACHE}/manifest-{poisoned}.json"
        man_new = f"{CACHE}/manifest-{expected}.json"
        dev.write(man_old, b'{"schema":1,"entries":{},"units":{},"retired":[]}\n')
        dev.write(a15_save, b"a15")   # --full refuses an empty root
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_capture --full")
        tail = log_since(dev, mark)
        old_there = dev.run(f"[ -e {shlex.quote(man_old)} ] && echo yes || echo no").strip() == "yes"
        new_ok = dev.run(f"jq -e '.entries' {shlex.quote(man_new)} >/dev/null 2>&1 && echo yes || echo no",
                         check=False).strip() == "yes"
        f += not check(not old_there and new_ok and "adopted" in tail and poisoned in tail and expected in tail,
                       f"cloud_capture --full adopted manifest-{poisoned}.json as manifest-{expected}.json and said so (exit {rc})",
                       f"exit {rc}; old manifest {'still there' if old_there else 'gone'}, new one "
                       f"{'parses' if new_ok else 'absent or unparsable'}; log: {tail.strip()[-300:]!r}")
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_capture --full")
        tail = log_since(dev, mark)
        f += not check("adopted" not in tail and "could not adopt" not in tail,
                       "a second --full adopts nothing more (the current name exists)",
                       f"the second --full logged: {tail.strip()[-300:]!r}")

        # --- (c) ---------------------------------------------------------------
        print("    -- (c) the old folder stays restorable; backup and retention never touch it")
        osn = os_name(dev)
        old_folder = f"{base}/{poisoned}"
        new_folder = f"{base}/{expected}"
        old_archive = f"2026_01_01-000000-{osn}_SETTINGS.tar.gz"   # the pre-label shape the RG35XX SP's folder holds
        backend("reset")
        dev.run(f"rm -rf {A15_PLANT}; mkdir -p {A15_PLANT} {shlex.quote(broot)}")
        plant(old_folder, old_archive, b"written under the shared id")
        dev.run(f"grep -q '^BACKUPFILE_RESTORE_OPTION=' {CONF} "
                f"&& sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|BACKUPFILE_RESTORE_OPTION=\"yes\"|' {CONF} "
                f"|| echo 'BACKUPFILE_RESTORE_OPTION=\"yes\"' >> {CONF}")
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_restore --yes --system-only")
        local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
        tail = log_since(dev, mark)
        f += not check(old_archive in local,
                       f"cloud_restore found the archive under {poisoned} (the hostname shape) through the --previous tier (exit {rc})",
                       f"restore brought back {local or 'nothing'} (exit {rc})")
        f += not check(poisoned in tail and "shared constant" in tail,
                       "and the log names the folder it took and why",
                       f"the log did not name the folder: {tail.strip()[-300:]!r}")
        own_archive = f"2026_01_02-000000-{label}-{osn}_SETTINGS.tar.gz"
        plant(new_folder, own_archive, b"written under the healed id")
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        mark = log_mark(dev)
        run_rc(dev, "cloud_restore --yes --system-only")
        local = dev.run(f"ls -1 {shlex.quote(broot)}/ 2>/dev/null || true", check=False).split()
        tail = log_since(dev, mark)
        f += not check(own_archive in local and old_archive not in local,
                       "with an archive in its own folder, restore takes that one before the old folder's",
                       f"restore brought back {local or 'nothing'}")
        f += not check(f"own cloud folder ({expected})" in tail,
                       "and says it restored from the device's own folder",
                       f"the log did not: {tail.strip()[-300:]!r}")
        keep_raw = dev.run(f"grep -m1 '^CLOUD_BACKUP_KEEP=' {CONF} 2>/dev/null | cut -d= -f2 | tr -d '\"' || true").strip()
        keep = int(keep_raw) if keep_raw.isdigit() and 1 <= int(keep_raw) <= 20 else 3
        # More of this device's own labelled archives than retention keeps,
        # in the OLD folder: if retention reached it, some would go.
        old_own = [f"2026_01_{d:02d}-000000-{label}-{osn}_SETTINGS.tar.gz" for d in range(3, 3 + keep + 2)]
        for name in old_own:
            plant(old_folder, name, name.encode())
        old_before = sorted(listing(old_folder))
        upload = f"2026_02_01-000000-{label}-{osn}_SETTINGS.tar.gz"
        dev.run(f"rm -f {shlex.quote(broot)}/*.tar.gz {shlex.quote(broot)}/*.zip", check=False)
        dev.write(f"{broot}/{upload}", b"this run's archive")
        # The regression: the archive has not changed since it was last sent,
        # and the marker says so -- the bare hash an old build wrote after
        # uploading to the OLD folder. A game-exit backup on the new build
        # runs from exactly this state, and a marker that knew only what was
        # sent answered "nothing to send" and left the healed folder empty.
        # The hash is computed as cloud_backup computes it: md5 of the
        # md5sum listing of the archives at the root of SETTINGS_BACKUPS.
        local_sum = dev.run(f"md5sum {shlex.quote(broot)}/*.tar.gz | md5sum | cut -d' ' -f1").strip()
        dev.run(f"printf '%s\\n' {local_sum} > {marker}")
        mark = log_mark(dev)
        rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
        new_list = listing(new_folder)
        old_after = sorted(listing(old_folder))
        f += not check(rc == 0 and upload in new_list,
                       f"with the marker saying this archive was already sent (an old build's marker, from the old folder), the backup still landed in the healed folder {expected} (exit {rc})",
                       f"the backup did not land in {expected} (exit {rc}): {new_list}; log: {log_since(dev, mark).strip()[-200:]!r}")
        f += not check("device.json" in new_list,
                       "and wrote the healed folder's device.json",
                       f"no device.json in {expected}: {new_list}")
        now_marker = dev.run(f"cat {marker} 2>/dev/null || true").strip()
        f += not check(now_marker == f"{local_sum} {new_folder}",
                       f"the marker now records where as well as what: {now_marker}",
                       f"the marker reads {now_marker!r}; expected {local_sum} {new_folder}")
        mark = log_mark(dev)
        rc, _ = run_rc(dev, "cloud_backup --yes --system-only")
        tail = log_since(dev, mark)
        # The marker's own line, not the transfer banner (which names the
        # folder on every run), and no upload: a marker that never learnt
        # the new shape would send 17 MB on every game exit.
        f += not check(rc == 0 and f"unchanged since the last upload to {new_folder}" in tail and "Uploading" not in tail,
                       "and the run after that has nothing to send, and sends nothing",
                       f"the run after: exit {rc}, log {tail.strip()[-300:]!r}")
        f += not check(upload not in old_after and old_after == old_before
                       and all(n in old_after for n in [old_archive] + old_own),
                       f"nothing was written to or removed from {poisoned}: it still holds its {len(old_before)} archives",
                       f"THE OLD FOLDER CHANGED: before {old_before}, after {old_after}")

        # --- (d) ---------------------------------------------------------------
        print("    -- (d) a healthy stored id is left alone")
        touch_offset(dev, ID_FILE, -5)
        touch_offset(dev, f"{ID_FILE}.previous", -5)
        m_id, m_prev = mtime(ID_FILE), mtime(f"{ID_FILE}.previous")
        rc, out = run_rc(dev, "cloud_device_id")
        f += not check(out.strip() == expected and id_file() == expected and prev_file() == [poisoned]
                       and mtime(ID_FILE) == m_id and mtime(f"{ID_FILE}.previous") == m_prev,
                       "a second run returns the healed id and rewrites nothing (the id file and .previous keep their mtimes)",
                       f"second run: printed {out.strip()!r}, file {id_file()!r} (mtime {m_id} -> {mtime(ID_FILE)}), "
                       f".previous {prev_file()} (mtime {m_prev} -> {mtime(f'{ID_FILE}.previous')})")
        healthy = "Some-Other-Handheld-0123456789"
        dev.run(f"printf '%s\\n' {healthy} > {ID_FILE}")
        touch_offset(dev, ID_FILE, -5)
        m_id = mtime(ID_FILE)
        mark = log_mark(dev)
        rc, out = run_rc(dev, "cloud_device_id")
        f += not check(out.strip() == healthy and id_file() == healthy and prev_file() == [poisoned]
                       and mtime(ID_FILE) == m_id and healthy not in log_since(dev, mark),
                       "a healthy id that does not match this hardware is returned unchanged and not rewritten (the module-swap case)",
                       f"printed {out.strip()!r}, file {id_file()!r} (mtime {m_id} -> {mtime(ID_FILE)}), .previous {prev_file()}")

        # --- (e) ---------------------------------------------------------------
        print("    -- (e) no adapter, no healing")
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}; rm -f {ID_FILE}.previous")
        touch_offset(dev, ID_FILE, -5)
        stamp_before = mtime(ID_FILE)
        mark = log_mark(dev)
        rc, out = fn("main", "sit0")
        stamp_after = mtime(ID_FILE)
        f += not check(rc == 0 and out.strip() == poisoned,
                       f"with the interface list narrowed to sit0 the poisoned id is returned unchanged (exit {rc})",
                       f"printed {out.strip()!r} (exit {rc}); expected {poisoned}")
        untouched = (id_file() == poisoned and not prev_file()
                     and stamp_before == stamp_after
                     and "healed" not in log_since(dev, mark))
        f += not check(untouched, "and nothing was written: the id file keeps its mtime, no .previous, no log line",
                       f"file {id_file()!r} (mtime {stamp_before} -> {stamp_after}), .previous {prev_file()}")

        # --- (f) ---------------------------------------------------------------
        print("    -- (f) without sit0 the guessed names are not offered")
        # Under a hostname unlike the recorded id's, so that both guessed
        # names -- <label>-P and <hostname>-P -- would be new lines if the
        # gate let them through; with the real hostname the second collapses
        # into the recorded id and an ungated script passes by dedup.
        dev.run(f"printf '%s\\n' {shlex.quote(poisoned)} > {ID_FILE}.previous")
        rc_rm, out_rm = run_rc(dev, "rmmod sit")
        sit_gone = dev.run("[ -d /sys/class/net/sit0 ] && echo yes || echo no").strip() == "no"
        if sit_gone:
            dev.run(f"hostname {A15_HOST}")
            rc, out = run_rc(dev, "cloud_device_id --previous")
            dev.run(f"hostname {shlex.quote(hostname)}")
            lines = out.split()
            f += not check(lines == [poisoned],
                           f"with no sit0 (hostname {A15_HOST}), --previous lists {lines}: the recorded id only -- a device that never had a sit0 could not have hashed 'notset'",
                           f"--previous listed {lines} with no sit0; expected [{poisoned}]")
            if had_sit:
                dev.run("modprobe sit 2>/dev/null || true", check=False)
        else:
            f += not check(False, "", f"sit could not be unloaded (exit {rc_rm}: {out_rm.strip()[-80:]}); the sit0 gate is unproven")
    finally:
        # Everything back: the hostname, the identity, sit, the macvlan, the
        # settings-restore option, the upload marker, the manifests, the
        # planted folders, the scratch archives, the driver.
        dev.run(f"hostname {shlex.quote(hostname)}", check=False)
        if saved_id.strip():
            dev.write(ID_FILE, saved_id.encode())
        else:
            dev.run(f"rm -f {ID_FILE}", check=False)
        if had_prev:
            dev.write(f"{ID_FILE}.previous", saved_prev.encode())
        else:
            dev.run(f"rm -f {ID_FILE}.previous", check=False)
        if not had_sit:
            dev.run("rmmod sit 2>/dev/null || true", check=False)
        if mv_made:
