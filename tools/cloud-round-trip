        L.dev.write(ES_SETTINGS, es_s0.encode())
        L.dev.run(L.bash_profile("set_setting system.qa.kill13 1"))
        L.dev.run("sync")
        s0_es = parse_es(L.dev.run(f"cat {ES_SETTINGS}"))
        s0_sys = parse_syscfg(L.dev.run(f"cat {SYSCFG}"))
        marker_sys = {"system.qa.kill13": "1", "system.hostname": s0_sys.get("system.hostname", "")}
        sys_s0 = L.dev.run(f"cat {SYSCFG}", check=False)
        rec_sys = parse_syscfg(L.dev.run(f"cat {SYSCFG}.backup 2>/dev/null || true", check=False))
        gaps = [int(x) for x in str(L.args.cut_after_ms).split(",") if x.strip()][: max(0, L.args.power_cut_trials)]
        trials = [("sync control", None)] + [("cut", g) for g in gaps] + [("no-change control", 0)]
        print(f"    -- arm A: {len(trials)} trials: {[t[0] + (f' {t[1]}ms' if t[1] is not None else '') for t in trials]}; "
              "each starts from S0 planted in both files and a boot, so EmulationStation holds S0 and starts on the carousel")
        for kind, gap in trials:
