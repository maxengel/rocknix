def snapshot_cache(dev, where="/tmp/qa-cache.tgz"):
    """Archive /storage/.cache/cloud_sync before the fixtures wipe it. Returns
    whether the directory existed, which restore_cache needs to tell "nothing
    to put back" from "the snapshot failed". `where` is on /tmp by default;
    the KILL cells put it on /storage, because a power cut empties /tmp."""
    had = dev.run(f"[ -d {CACHE} ] && echo yes || echo no", check=False).strip() == "yes"
    dev.run(f"rm -f {where}; tar -C /storage/.cache -czf {where} cloud_sync 2>/dev/null || true", check=False)
    return had


def restore_cache(dev, had, where="/tmp/qa-cache.tgz"):
    """Put the cache directory back from the snapshot -- only when the
    snapshot exists. tar exiting non-zero for any reason but an absent
    directory (/tmp full, a read error) left no archive, and deleting the
    live directory then would drop the device's saves-root record and every
    last-* stamp on the strength of nothing: a guard that fails open."""
    have = dev.run(f"[ -s {where} ] && echo yes || echo no", check=False).strip() == "yes"
    if have:
        dev.run(f"rm -rf {CACHE}; tar -C /storage/.cache -xzf {where} 2>/dev/null; rm -f {where}", check=False)
    elif had:
        print(f"    WARN  cache snapshot missing; {CACHE} not restored -- the device's stamps and saves-root record "
              "are whatever the fixtures left", file=sys.stderr)
    else:
        dev.run(f"rm -rf {CACHE}", check=False)   # there was none before the run


def run_capture(dev, root, args, only):
    """The capture fixtures on one device. The cache directory holds the
    device's own stamps and its saves-root record; the fixtures wipe it, so
    it is carried across and put back, as run_pair does."""
    failures = 0
    p = Solo(dev, root)
    had = snapshot_cache(dev)
    try:
        for key, title, fn in CAPTURE_FIXTURES:
            if only and key not in only:
                continue
            step(f"{key} -- {title}")
            try:
                failures += fn(p)
            except Fail as e:
                failures += 1
                print(f"    FAIL  {e}")
            failures += litter_scan(dev, {"SAVESPATH": root}, label=f"{key}: ")
    finally:
        local_reset(dev, root)
        restore_cache(dev, had)
    return failures


# ===========================================================================
# #9's contract: the transport under the reconciler, on the pair
# ===========================================================================
#
# Each item runs under `bisync` (rclone bisync between the saves root and the
# shared folder, --conflict-resolve none, one explicit --resync as the
# recorded first run) and under `copy` -- the reconciler's own transport
# (I22): a stand-in classifier over sha256 against a local agreement record,
# then `rclone copy --files-from --ignore-times` per direction. The harness
# runs and records; reading each FAIL as upstream-shaped or architectural is
# Gate 11's job (#9).

RULES = "/storage/.config/cloud_sync-rules.txt"
BISYNC_STATE = "/storage/.cache/rclone/bisync"   # rclone's default workdir
AGREED = "/tmp/qa-agreed.json"                   # the stand-in's agreement record


def transferred(out):
    m = re.findall(r"Transferred:\s+(\d+) / (\d+)", out)
    return int(m[-1][0]) if m else 0


class Transport:
    def __init__(self, kind, pair, extra="", dump=None):
        self.kind, self.p, self.extra = kind, pair, extra
        self.last_cmd = ""
        self.dump, self.tag, self.seq = dump, "setup", 0

    def record(self, dev, cmd, rc, out):
        """The raw output of one run, on the host, named by item and order."""
        if not self.dump:
            return
        os.makedirs(self.dump, exist_ok=True)
        self.seq += 1
        who = "a" if dev is self.p.a else "b"
        with open(os.path.join(self.dump, f"{self.kind}-{self.tag}-{self.seq:02d}-{who}.log"), "w") as f:
            f.write(f"$ {cmd}\n# exit {rc}\n{out}")

    def remote(self, dev):
        return dev.run("rclone listremotes 2>/dev/null | head -1").strip() + self.p.saves_remote

    def clear(self, dev):
        dev.run(f"rm -rf {BISYNC_STATE} {AGREED}", check=False)

    def first(self, dev):
        """The maintainer-driven first run: the one explicit --resync, or the
        agreement record seeded from what both sides hold."""
        # The folder has to exist on the remote before bisync will look at it
        # (a missing path2 is fatal, exit 7); cloud_backup creates it the same way.
        dev.run(f"rclone mkdir {shlex.quote(self.remote(dev))}", check=False)
        if self.kind == "bisync":
            return self.bisync(dev, "--resync")
        return self.copy_pass(dev)

    def run(self, dev, hold=(), dry=False, env="", background=False):
        if self.kind == "bisync":
            flags = "--dry-run" if dry else ""
            if hold:
                # rclone refuses --files-from beside any other filter, so the
                # decided set replaces the allowlist for this run; whether
                # bisync then accepts a changed filter without --resync is
                # what the item records.
                dev.write("/tmp/qa-decided.txt", "\n".join(sorted(set(self.p.files) - set(hold))).encode() + b"\n")
                flags += " --files-from /tmp/qa-decided.txt"
                return self.bisync(dev, flags, env, background, filters=False)
            return self.bisync(dev, flags, env, background)
        return self.copy_pass(dev, hold, dry, env, background)

    def bisync(self, dev, flags, env="", background=False, filters=True):
        cmd = (f"rclone bisync {shlex.quote(self.p.root)} {shlex.quote(self.remote(dev))} "
               f"{'--filters-file ' + RULES if filters else ''} --conflict-resolve none --resilient --recover "
               f"--use-json-log -v {self.extra} {flags}")
        self.last_cmd = cmd
        if background:
            dev.run(f"rm -f /tmp/qa-bg.out; ({env} setsid {cmd} >/tmp/qa-bg.out 2>&1 &)")
            return {"rc": None, "out": "", "conflicts": [], "transferred": 0, "moved": []}
        rc, out = run_rc(dev, cmd, env)
        self.record(dev, cmd, rc, out)
        # A conflict is a file bisync queues under a conflict suffix, or a
        # non-zero count of differences -- not every line that mentions the
        # word ("Checking potential conflicts..." is printed on every run).
        # `moved` is every object rclone reports copying, renaming or
        # deleting, so a transfer count has names behind it.
        conflicts, moved, raw = [], [], None
        for line in out.splitlines():
            if not line.startswith("{"):
                continue
            try:
                j = json.loads(line)
            except ValueError:
                continue
            msg = j.get("msg", "")
            if re.search(r"\.conflict\d|[1-9]\d* differences found", msg):
                conflicts.append(re.sub(r"\x1b\[[0-9;]*m", "", msg).strip())
                raw = raw or line
            if j.get("object") and re.match(r"(Copied|Moved|Renamed|Deleted|Updated)", msg):
                moved.append(f"{j['object']}: {msg.split(' (')[0].split(':')[0]}")
        return {"rc": rc, "out": out, "conflicts": conflicts, "transferred": transferred(out), "moved": moved, "raw": raw}

    def hashes(self, dev, remote=False):
        """path -> sha256 of every allowlisted file on one side. The remote's
        are hashed after a fetch: the QA WebDAV offers none (#53)."""
        if remote:
            r = shlex.quote(self.remote(dev))
            cmd = (f"rclone lsf -R --files-only --filter-from {RULES} {r} 2>/dev/null | while IFS= read -r f; do "
                   f"printf '%s %s\\n' \"$(rclone cat {r}/\"$f\" 2>/dev/null | sha256sum | cut -c1-64)\" \"$f\"; done")
        else:
            cmd = (f"cd {shlex.quote(self.p.root)} 2>/dev/null && rclone lsf -R --files-only --filter-from {RULES} . "
                   f"2>/dev/null | while IFS= read -r f; do printf '%s %s\\n' \"$(sha256sum \"$f\" | cut -c1-64)\" \"$f\"; done")
        out = dev.run(cmd, check=False)
        return {line[65:]: line[:64] for line in out.splitlines() if len(line) > 65}

    def copy_pass(self, dev, hold=(), dry=False, env="", background=False):
        """The stand-in reconciler: identity by sha256 against agreement, then
        decided transfers only. Absences with agreement on record are
        questions, never transfers; an empty side with agreement on record
        refuses the pass (#22 R4)."""
        local, cloud = self.hashes(dev), self.hashes(dev, remote=True)
        try:
            agreed = json.loads(dev.run(f"cat {AGREED} 2>/dev/null || echo {{}}", check=False) or "{}")
        except ValueError:
            agreed = {}
        r = {"rc": 0, "out": "", "conflicts": [], "questions": [], "pushed": [], "fetched": [], "transferred": 0, "moved": []}
        if agreed and (not local or not cloud):
            r["rc"], r["out"] = 1, "refused: a side is empty with agreement on record"
            return r
        for path in sorted(set(local) | set(cloud)):
            if path in hold:
                continue
            l, c, a = local.get(path), cloud.get(path), agreed.get(path)
            if l == c:
                agreed[path] = l
            elif l and c:
                if c == a:
                    r["pushed"].append(path)
                elif l == a:
                    r["fetched"].append(path)
                else:
                    r["conflicts"].append(path)
            elif a is None:
                (r["pushed"] if l else r["fetched"]).append(path)
            else:
                r["questions"].append(path)
        if dry:
            r["out"] = f"dry-run: push {r['pushed']} fetch {r['fetched']} conflicts {r['conflicts']} questions {r['questions']}"
            return r
        root, remote = shlex.quote(self.p.root), shlex.quote(self.remote(dev))
        cmds = []
        if r["pushed"]:
            dev.write("/tmp/qa-push.txt", "\n".join(r["pushed"]).encode() + b"\n")
            cmds.append(f"rclone copy --files-from /tmp/qa-push.txt --ignore-times {root} {remote}")
        if r["fetched"]:
            dev.write("/tmp/qa-fetch.txt", "\n".join(r["fetched"]).encode() + b"\n")
            cmds.append(f"rclone copy --files-from /tmp/qa-fetch.txt --ignore-times {remote} {root}")
        self.last_cmd = " && ".join(cmds) or "(nothing to transfer)"
        if cmds:
            if background:
                dev.run(f"rm -f /tmp/qa-bg.out; ({env} setsid sh -c {shlex.quote(' && '.join(cmds))} >/tmp/qa-bg.out 2>&1 &)")
                r["rc"] = None
                return r
            r["rc"], r["out"] = run_rc(dev, " && ".join(cmds), env)
            self.record(dev, " && ".join(cmds), r["rc"], r["out"])
        if r["rc"] == 0:
            for path in r["pushed"]:
                agreed[path] = local[path]
            for path in r["fetched"]:
                agreed[path] = cloud[path]
        dev.write(AGREED, json.dumps(agreed).encode())
        r["transferred"] = len(r["pushed"]) + len(r["fetched"])
        r["moved"] = [f"{x}: pushed" for x in r["pushed"]] + [f"{x}: fetched" for x in r["fetched"]]
        if r["conflicts"]:
            r["rc"] = r["rc"] or 5
        return r


def run_contract(p, kind, args):
    f = 0
    t = Transport(kind, p, args.bisync_flags if kind == "bisync" else "", args.dump)
    p.files = []

    def fresh(files):
        """Agreement through the transport itself: a's first run publishes,
        b's first run receives."""
        p.reset()
        t.clear(p.a)
        t.clear(p.b)
        # Ballast: files that never change. A tree of one file makes every
        # change "all files changed", which bisync refuses outright as a
        # safety abort (seen on the first run); a saves tree with one save
        # would hit the same wall, which Gate 11 weighs from this output.
        files = {**{f"saves/Ballast {i}.srm": f"ballast {i}".encode() for i in range(3)}, **files}
        p.files = sorted(files)
        for rel, data in files.items():
            p.a.write(p.path(rel), data)
        ra, rb = t.first(p.a), t.first(p.b)
        wrong = [rel for rel, data in files.items() if not (p.cloud_sha(rel) == sha(data) == p.b.sha(p.path(rel)))]
        if wrong:
            tail = (rb["out"] or ra["out"]).strip().splitlines()[-3:]
            raise Fail(f"the first run under {kind} left {wrong} without agreement (a exit {ra['rc']}, b exit {rb['rc']}): "
                       + " | ".join(tail))

    def say(r):
        print(f"          {t.last_cmd}")
        print(f"          exit {r['rc']}, {r['transferred']} transferred, {len(r['conflicts'])} conflict line(s)"
              + (f", questions {r['questions']}" if r.get("questions") else ""))
        for m in r.get("moved", [])[:8]:
            print(f"          moved: {m[:160]}")
        for c in r["conflicts"][:2]:
            print(f"          conflict: {c[:200]}")
        if r.get("raw") and not getattr(say, "shown", False):
            # The shape of one conflict line as bytes, before any parsing
            # trusted it (the #35 futro asked for od -c; repr is the same
            # record in one line).
            say.shown = True
            print(f"          shape: {r['raw'][:400]!r}")
        if r["rc"]:
            # What the transport said went wrong: rclone's own words, the
            # last few, so a FAIL below can be read without a rerun.
            said = []
            for line in r["out"].splitlines():
                if line.startswith("{"):
                    try:
                        j = json.loads(line)
                    except ValueError:
                        continue
                    if j.get("level") in ("error", "critical", "notice") and "Transferred:" not in j.get("msg", ""):
                        said.append(j.get("msg", "").strip())
                elif line.strip() and "Transferred:" not in line and "Elapsed time" not in line and "Checks:" not in line:
                    said.append(line.strip())
            for s in said[-3:]:
                print(f"          > {s[:200]}")

    if kind == "bisync":
        print(f"\n    rclone on the guest: {p.a.run('rclone version 2>/dev/null | head -1').strip()}")

    def item(n, title):
        t.tag = f"item{n:02d}"
        step(f"#9 item {n} ({kind}) -- {title}")

    try:
        item(1, "reports, never resolves")
        rel = "saves/Contract Both.srm"
        v = {"H0": b"H0 agreed under the transport", "HA": b"HA: a's offline edit", "HB": b"HB: b's published edit"}
        fresh({rel: v["H0"]})
        p.b.write(p.path(rel), v["HB"])
        say(t.run(p.b))
        p.a.write(p.path(rel), v["HA"])
        touch_offset(p.a, p.path(rel), 3600)
        dry = t.run(p.a, dry=True)
        guard = "conflict" in dry["out"].lower() or bool(dry["conflicts"])
        # A reconciler refuses the wet run when the guard fires (item 2); the
        # wet run is made only when it does not, so the outcome is recorded.
        r = dry if guard else t.run(p.a)
        say(r)
        f += not check(guard or bool(r["conflicts"]), "the both-changed pair was reported in a parseable form",
                       f"no conflict reported (exit {r['rc']})")
        f += not check(p.cloud_sha(rel) == sha(v["HB"]) and p.a.sha(p.path(rel)) == sha(v["HA"]),
                       "and neither file changed",
                       f"a file changed: cloud {name_of(p.cloud_sha(rel), v)}, device {name_of(p.a.sha(p.path(rel)), v)}")

        item(2, "no renames on the saves tree")
        f += not check(guard, "the dry-run guard fired on the constructed conflict",
                       "the dry-run guard did not fire on a constructed conflict")
        renamed = [x for x in backend_files(p.spath) + p.a.run(f"ls -R {shlex.quote(p.root)}").split() if "conflict" in x.lower()]
        f += not check(not renamed, "no file on either side was renamed", f"RENAMED: {renamed}")

        item(3, "decided transfers only")
        u1, u2 = "saves/Decided.srm", "saves/Held.srm"
        fresh({u1: b"u1 v0", u2: b"u2 v0"})
        p.a.write(p.path(u1), b"u1 v1 decided")
        p.a.write(p.path(u2), b"u2 v1 held back by the reconciler")
        r = t.run(p.a, hold={u2})
        say(r)
        f += not check(p.cloud_sha(u1) == sha(b"u1 v1 decided"), "the decided unit moved", "the decided unit did not move")
        f += not check(p.cloud_sha(u2) == sha(b"u2 v0"), "the held unit did not", "THE HELD UNIT WAS TRANSFERRED")

        item(4, "hashless backend: an equal-size, equal-mtime change")
        rel = "saves/Same Size Contract.srm"
        one, two = b"contract-version-one", b"contract-version-two"
        fresh({rel: one})
        q = shlex.quote(p.path(rel))
        p.b.run(f"cp -p {q} {q}.ref")
        p.b.write(p.path(rel), two)
        p.b.run(f"touch -r {q}.ref {q}; rm -f {q}.ref; sync")
        say(t.run(p.b))
        say(t.run(p.a))
        f += not check(p.a.sha(p.path(rel)) == sha(two), "the byte change reached a",
                       "an equal-size, equal-mtime change was treated as identical")

        item(5, "external resolution without --resync")
        rel = "saves/Resolved Outside.srm"
        v = {"H0": b"H0 resolved-outside", "HA": b"HA: a's edit", "HB": b"HB: b's edit, the winner"}
        fresh({rel: v["H0"]})
        p.b.write(p.path(rel), v["HB"])
        t.run(p.b)
        p.a.write(p.path(rel), v["HA"])
        touch_offset(p.a, p.path(rel), 3600)
        dry = t.run(p.a, dry=True)
        if not ("conflict" in dry["out"].lower() or dry["conflicts"]):
            t.run(p.a)
        # The wizard installs the winner on a and pushes it (a decided transfer).
        p.a.write(p.path(rel), v["HB"])
        rem = shlex.quote(t.remote(p.a) + "/" + rel)
        run_rc(p.a, f"rclone copyto --ignore-times {shlex.quote(p.path(rel))} {rem}")
        if kind == "copy":
            agreed = json.loads(p.a.run(f"cat {AGREED} 2>/dev/null || echo {{}}", check=False) or "{}")
            agreed[rel] = sha(v["HB"])
            p.a.write(AGREED, json.dumps(agreed).encode())
        r = t.run(p.a)
        say(r)
        f += not check(not r["conflicts"] and not r["moved"] and (r["rc"] or 0) == 0,
                       "the next run neither re-flagged nor re-transferred the pair",
                       f"after an outside resolution: exit {r['rc']}, {len(r['moved'])} object(s) moved, {len(r['conflicts'])} conflict line(s)")

        item(6, "interruption: killed mid-transfer, completed by the next run")
        big = {f"saves/Big {i}.srm": os.urandom(98304) for i in range(4)}
        fresh({"saves/Seed.srm": b"seed"})
        for rel, data in big.items():
            p.a.write(p.path(rel), data)
        t.run(p.a, env="RCLONE_BWLIMIT=32k RCLONE_TRANSFERS=1", background=True)
        time.sleep(4)
        p.a.run("pkill -9 -x rclone; sleep 1; true", check=False)
        landed = [rel for rel, data in big.items() if p.cloud_sha(rel) == sha(data)]
        print(f"          killed after {len(landed)} of {len(big)} had landed")
        r = t.run(p.a)
        say(r)
        if r["rc"] and "lock file" in r["out"]:
            # bisync leaves its lock behind after a kill and refuses every
            # later run; a reconciler would clear it once no bisync process
            # remains. Whether the run then completes is measured too.
            print("          the killed run's lock was left behind; cleared, and the next run tried again:")
            p.a.run(f"pgrep -x rclone >/dev/null || rm -f {BISYNC_STATE}/*.lck", check=False)
            r = t.run(p.a)
            say(r)
        done = [rel for rel, data in big.items() if p.cloud_sha(rel) == sha(data)]
        f += not check(len(done) == len(big) and (r["rc"] or 0) == 0, "the next run completed the transfer, nothing lost",
                       f"{len(done)}/{len(big)} in the cloud after the next run (exit {r['rc']})")
        f += not check("resync" not in r["out"].lower(), "and did not ask for --resync",
                       "the next run demanded --resync after an interruption")

        item(7, "renumber: same hash, new slot")
        s = {"S1": os.urandom(3001), "S2": os.urandom(3002), "S3": os.urandom(3003)}
        st = lambda n: f"savestates/Contract.state{n}"
        fresh({st(1): s["S1"], st(2): s["S2"], st(3): s["S3"]})
        p.a.run(f"rm -f {shlex.quote(p.path(st(2)))}; mv {shlex.quote(p.path(st(3)))} {shlex.quote(p.path(st(2)))}")
        say(t.run(p.a))
        say(t.run(p.b))
        out = p.b.run(f"cd {shlex.quote(p.root)} && sha256sum savestates/* 2>/dev/null || true")
        on_b = sorted(name_of(line.split()[0], s) for line in out.splitlines() if line.strip())
        cloud = sorted(name_of(sha(backend_bytes(f"{p.spath}/{x}") or b""), s) for x in backend_files(p.spath) if x.startswith("savestates/"))
        print(f"          b holds {on_b}; the cloud holds {cloud}")
        f += not check("S1" in on_b and "S3" in on_b and "S1" in cloud and "S3" in cloud, "no surviving version was lost",
                       f"a surviving version is missing: b {on_b}, cloud {cloud}")
        f += not check(on_b.count("S3") == 1 and cloud.count("S3") == 1, "the moved version exists once on each side",
                       f"the moved version is duplicated: b {on_b}, cloud {cloud}")

        item(8, "absence never deletes without the reconciler's word")
        rel = "saves/Absent Root.srm"
        fresh({rel: b"kept in the cloud"})
        q = shlex.quote(p.root)
        p.a.run(f"mv {q} {q}.away")
        r = t.run(p.a)
        say(r)
        p.a.run(f"rm -rf {q}; mv {q}.away {q}")
        f += not check(p.cloud_sha(rel) == sha(b"kept in the cloud"), "an unmounted root deleted nothing in the cloud",
                       "AN UNMOUNTED ROOT DELETED THE CLOUD'S COPY")
        f += not check((r["rc"] or 0) != 0, f"the run refused (exit {r['rc']})", "the run did not refuse an unmounted root")

        item(9, "budget: a full pass with nothing changed")
        fresh({"saves/Idle.srm": b"idle"})
        # Every rclone the pass spawns is counted -- the transport's and the
        # stand-in classifier's listings and fetches alike -- by putting the
        # shim first on PATH for every command of the item, not only the
        # transfer. A `cat` is a download.
        p.a.run("mkdir -p /tmp/qa-shim; printf '#!/bin/sh\\necho \"$@\" >> /tmp/qa-spawns\\nexec /usr/bin/rclone \"$@\"\\n' > /tmp/qa-shim/rclone; "
                "chmod +x /tmp/qa-shim/rclone; rm -f /tmp/qa-spawns")
        prev_prefix = p.a.path_prefix
        p.a.path_prefix = "/tmp/qa-shim" + (f":{prev_prefix}" if prev_prefix else "")
        t0 = time.time()
        try:
            r = t.run(p.a)
        finally:
            p.a.path_prefix = prev_prefix
        secs = time.time() - t0
        spawned = p.a.run("cat /tmp/qa-spawns 2>/dev/null || true").splitlines()
        downloads = sum(1 for s in spawned if s.split()[:1] == ["cat"])
        p.a.run("rm -rf /tmp/qa-shim /tmp/qa-spawns")
        say(r)
        print(f"          {len(spawned)} rclone spawn(s) ({downloads} download(s)), {secs:.1f} s on the guest (a VM, not the H700)")
        f += not check(not r["moved"] and (r["rc"] or 0) == 0, "nothing transferred",
                       f"an idle pass moved {len(r['moved'])} object(s)")
        # --download-hash and the like report hash downloads in the same
        # Transferred: total; that is budget, not a copy, and it is recorded.
        if r["transferred"] and not r["moved"]:
            print(f"          {r['transferred']} download(s) for hashing on an idle pass -- the whole tree, every pass")

        item(10, "single authority: the transport's own state is not the agreement")
        rel = "saves/Authority.srm"
        fresh({rel: b"agreed"})
        p.a.run(f"rm -rf {BISYNC_STATE}")
        r = t.run(p.a)
        say(r)
        f += not check((r["rc"] or 0) == 0 and "resync" not in r["out"].lower() and not r["moved"],
                       "with the transport's listings gone the pass still ran from agreement alone",
                       f"without its own listings the transport could not run (exit {r['rc']}; resync demanded: {'resync' in r['out'].lower()})")
    except Fail as e:
        f += 1
        print(f"    FAIL  {e}")
    finally:
        # The transport's own state -- bisync's listings, the stand-in's
        # agreement record -- leaves with the run, on both guests.
        t.clear(p.a)
        t.clear(p.b)
    return f


# ===========================================================================
# #103: the network goes away mid-run -- one device, the QA endpoint, and
# the serial console that can cut the device's link
# ===========================================================================
#
# What #102 exposed is a failure mode nothing bounds: the link dropping
# *during* a cloud operation. The scripts probe reachability with short
# rclone timeouts and then run the copy itself on RCLONEOPTS, which sets
# none -- rclone's defaults are 60 s to connect, 5 min of idle I/O, three
# retries and ten low-level retries -- and the RG SP's startup sync sat on a
# dead connection with the launch gate held (#101). Each cell here starts an
# operation, waits for the phase it names, cuts the guest's link, restores it
# after --link-restore-after seconds (40), and asserts what a bounded
# operation must do: end within LINK_BOUND seconds of the cut with an honest
# exit (69, the no-network sentinel, or a plain failure -- never 0, never
# 75), leave no partial file and no truncated one on the receiving side,
# stamp the failure or nothing (never 0), keep the settings upload marker
# unless the archive completed, and complete on a plain re-run once the link
# is back. Time-to-exit is read in the guest's own monotonic clock: the
# detached wrapper writes `$? <uptime>` when the operation ends, and the cut
# records the uptime it happened at.
#
# Two channels, because the cut kills SSH. The operation is started detached
# over SSH (setsid nohup, stdout and stderr to a file, the exit code to
# another), the cut and the restore go over the serial console -- `ip link
# set eth0 down` / `up`, tools/vm-serial -- and the result is read over SSH
# once the link is back. A real handheld has no serial console, so these
# cells are skipped, with a line saying so, when the console is not there.
#
# Measured on the GENERIC_X64 guest (2026-09-09, build d574edf975, NM-managed
# eth0, the WebDAV endpoint throttled to 200k): after `ip link set eth0
# down` the routes are gone at once, the IPv4 address stays until
# NetworkManager notices and flushes it (~8 s, state `unavailable`), and an
# established TCP connection stalls -- it is not reset. After `up` the
# address, the default route and a ping to the endpoint are back within a
# second. A fresh connection on the dead link fails in 20 ms (`network is
# unreachable`; rclone does not retry it). So the hang lives in the transfer
# that was in flight: TCP retransmits on its doubling schedule, lands the
# moment the link is back (~51 s after a cut when the outage is 40 s), and an
# unbounded rclone then *completes*, exit 0, some 50 s after the cut. That is
# what an unbounded run looks like in these cells with the default outage:
# not a hang past the bound but a success reported for a run that waited the
# outage out. `--link-restore-after 120` makes the same run overshoot the
# bound (TCP's next retransmit is at ~205 s), which is #102's shape. Either
# way a bounded run ends with the link still down and exits 69.
#
# The endpoint must be throttled (CLOUD_QA_BWLIMIT), or nine MiB cross the
# loopback before the poll can see the transfer start; the cells refuse an
# unthrottled one rather than report "ended before the cut" seven times. The
# server's bwlimit is a token bucket with a 4 MiB burst, so three 3 MiB files
# spend about 25 s in flight. The two listing-bound cells (a compare with
# everything already in the cloud; the picker scan) run rclone under
# RCLONE_TPSLIMIT=2 -- two HTTP transactions a second, a stand-in for a
# provider whose listing is rate-limited -- because this endpoint lists
# twenty-five directories in well under a second and the cut would land
# after the compare had finished. The environment variable reaches rclone
# through the script under test unchanged; nothing in the scripts is edited.

LINK_DIR = "/tmp/qa-link"       # on the device: the detached run's out, rc and pid
LINK_MIB = 3                    # each transferred fixture file
LINK_FILES = 3                  # per transfer cell: 9 MiB, ~25 s in flight at 200k after the 4 MiB burst
LINK_BOUND = 90                 # seconds after the cut by which the run must have ended
LINK_HANG = 360                 # seconds after the cut before the run is called hung
LINK_GIVE_UP = 600              # after the hang verdict, how much longer it may take to finish before it is killed
LINK_TPS = 2                    # RCLONE_TPSLIMIT for the listing-bound cells
LINK_STAMPS = ("last-backup", "last-restore", "last-settings-backup", "last-settings-restore",
               "last-content-backup", "last-content-restore", "last-content-match")
LINK_MARKER_FILE = re.compile(r"^\s*\*\s+\S.*?:\s*\d+% /", re.M)   # rclone's per-file progress line
LINK_MARKER_CHECKS = re.compile(r"^Checks:\s+\d+ / \d+", re.M)       # the compare phase, in the stats block


def backend_throttled():
    """Whether the WebDAV endpoint runs with --bwlimit. Read off the server's
    own command line (its pid is beside its data directory), not off an
    environment variable this process may or may not share with the one
    that started it."""
    if backend("backend").strip() != "webdav":
        return False
    state = os.path.dirname(backend("path").strip())
    try:
        pid = open(os.path.join(state, "webdav.pid")).read().strip()
        return "--bwlimit" in open(f"/proc/{pid}/cmdline", "rb").read().replace(b"\0", b" ").decode(errors="replace")
    except OSError:
        return False


class Link:
    """One device, the QA endpoint, and the console that can cut the link."""

    def __init__(self, dev, serial, root, remote, settings, args):
        self.dev, self.serial, self.root, self.remote, self.settings, self.args = dev, serial, root, remote, settings, args
        self.restore_after = args.link_restore_after
        self.saves_remote = settings.get("SAVES_REMOTE") or settings.get("SYNCPATH")
        self.settings_remote = settings.get("SETTINGS_REMOTE") or settings.get("SYNCPATH_BACKUP")
        self.content_remote = settings.get("CONTENT_REMOTE") or settings.get("CONTENTPATH")
        # The interface that carries the default route -- eth0 on the VM,
        # wlan0 on a handheld -- read from the guest rather than assumed.
        self.iface = dev.run("ip -4 route show default 2>/dev/null | awk '{for (i=1;i<=NF;i++) if ($i==\"dev\") print $(i+1)}' | head -1").strip()
        if not self.iface:
            raise Fail("the device has no default route to cut")
        m = re.search(r"(?:url|endpoint)\s*=\s*\w+://([^/\s]+)", backend("rclone-conf"))
        if not m:
            raise Fail("cannot read the endpoint's host:port from the backend's rclone stanza")
        self.hostport = m.group(1)
        self.host_ip = self.hostport.split(":")[0]
        self.t_cut = None

    # -- the guard: the console must belong to the device on --host --------
    def assert_same_guest(self):
        nonce = hashlib.sha256(os.urandom(16)).hexdigest()[:16]
        self.dev.run(f"echo {nonce} > /tmp/qa-link-nonce")
        seen = self.serial.run("cat /tmp/qa-link-nonce 2>/dev/null").strip()
        self.dev.run("rm -f /tmp/qa-link-nonce", check=False)
        if seen != nonce:
            raise Fail(f"the serial console at {self.serial.socket} is not the device on --host "
                       f"(wrote {nonce} over ssh, read {seen or 'nothing'} over serial); refusing to cut a link")

    # -- planting ------------------------------------------------------------
    def big(self, name):
        return os.urandom(LINK_MIB * 1024 * 1024)

    def plant_device(self, base, files):
        for rel, data in files.items():
            self.dev.write(f"{base}/{rel}", data)

    def plant_cloud(self, files, endpoint_path):
        stage = subprocess.run(["mktemp", "-d"], capture_output=True, text=True).stdout.strip()
        for rel, data in files.items():
            path = os.path.join(stage, rel)
            os.makedirs(os.path.dirname(path), exist_ok=True)
            open(path, "wb").write(data)
        backend("put", stage, endpoint_path)
        subprocess.run(["rm", "-rf", stage])

    def content_dir(self):
        """/storage/roms/<CONTENT_DIR>, which the harness owns only if empty."""
        croot = f"/storage/roms/{CONTENT_DIR}"
        existing = self.dev.run(f"find {shlex.quote(croot)} -type f 2>/dev/null | head -3 || true").strip()
        if existing and not self.args.real_roms:
            raise Fail(f"{croot} holds files ({existing.splitlines()[0]} ...); refusing to use it as a fixture")
        self.dev.run(f"rm -rf {shlex.quote(croot)}; mkdir -p {shlex.quote(croot)}")
        return croot

    def reset(self):
        self.dev.run(f"rm -rf {shlex.quote(self.root)}; mkdir -p {shlex.quote(self.root)}; "
                     f"rm -rf /storage/roms/{shlex.quote(CONTENT_DIR)} {LINK_DIR}", check=False)
        backend("reset")

    # -- the detached run ----------------------------------------------------
    def start(self, cmd, env=""):
        self.dev.run(f"rm -rf {LINK_DIR}; mkdir -p {LINK_DIR}")
        inner = f"echo $$ > {LINK_DIR}/pid; {env} {cmd}; echo $? $(cut -d' ' -f1 /proc/uptime) > {LINK_DIR}/rc"
        self.dev.run(f"setsid nohup sh -c {shlex.quote(inner)} >{LINK_DIR}/out 2>&1 &")

    def status(self):
        """(out, rc line or '', established connections to the endpoint)."""
        out = self.dev.run(f"cat {LINK_DIR}/out 2>/dev/null; printf '\\n@@RC %s\\n' \"$(cat {LINK_DIR}/rc 2>/dev/null)\"; "
                           f"printf '@@CONN %s\\n' \"$(netstat -tn 2>/dev/null | grep -c '{self.hostport} .*ESTABLISHED')\"",
                           check=False)
        body, _, tail = out.partition("\n@@RC ")
        rc, _, conn = tail.partition("\n@@CONN ")
        return body, rc.strip(), int(conn.strip() or 0)

    def wait_marker(self, marker, timeout=120):
        """Until the run prints the marker (a regex) -- or, for marker None,
        holds a connection to the endpoint, which is the only sign a scan
        gives before it ends. (False, out) when the run ended first."""
        t0 = time.time()
        while time.time() - t0 < timeout:
            body, rc, conn = self.status()
            if marker is not None and marker.search(body):
                return True, body
            if marker is None and conn > 0:
                return True, body
            if rc:
                return False, body
            time.sleep(0.3)
        raise Fail(f"no marker in {timeout}s: {body.strip().splitlines()[-1][:120] if body.strip() else 'no output'}")

    def rc_line(self, text):
        parts = text.strip().split()
        return parts if len(parts) == 2 and parts[0].lstrip("-").isdigit() else None

    # -- the cut and the restore, over serial --------------------------------
    def cut(self):
        self.dev.disconnect()
        out = self.serial.run(f"ip link set {self.iface} down; cut -d' ' -f1 /proc/uptime")
        self.t_cut = time.time()
        return float(out.split()[-1])

    def restore(self):
        out = self.serial.run(f"ip link set {self.iface} up; cut -d' ' -f1 /proc/uptime")
        up = float(out.split()[-1])
        t = time.time()
        test = (f"ip -4 -o addr show {self.iface} | grep -q 'inet ' && ip -4 route show default | grep -q . "
                f"&& ping -c1 -W1 {self.host_ip} >/dev/null 2>&1 && echo NETOK")
        while time.time() - t < 90:
            if "NETOK" in self.serial.run(test):
                return up, time.time() - t
            time.sleep(1)
        raise Fail(f"{self.iface} did not regain an address, a default route and the endpoint within 90 s of `ip link set up`")

    def wait_exit(self, cut_up):
        """The run's `rc uptime` line: polled over serial while the link is
        down, over ssh after it is restored. None if it has not ended
        LINK_HANG seconds after the cut."""
        seen = None
        polls = 0
        while time.time() - self.t_cut < self.restore_after:
            time.sleep(min(5, max(0.5, self.restore_after - (time.time() - self.t_cut))))
            polls += 1
            if polls <= 2:
                # The first poll proves the cut took -- a guard that cannot
                # tell eth0 from the wrong interface has not cut anything --
                # and the second describes the state NetworkManager leaves
                # once it has noticed (it flushes the address ~8 s in).
                st = self.serial.run(f"ip -4 route show default 2>/dev/null | grep -c .; "
                                     f"nmcli -t -f DEVICE,STATE dev 2>/dev/null | grep '^{self.iface}:' | cut -d: -f2; "
                                     f"ip -4 -o addr show {self.iface} | grep -c 'inet '").split()
                routes, nm, addrs = (st + ["?", "?", "?"])[:3]
                if polls == 1 and routes != "0":
                    raise Fail(f"the cut did not take: {routes} default route(s) still present after `ip link set {self.iface} down`")
                if polls == 2:
                    print(f"          {time.time() - self.t_cut:.0f}s into the outage: default route gone; NetworkManager says "
                          f"{nm}; {'an address still' if addrs not in ('0', '?') else 'no address'} on {self.iface}")
            r = self.rc_line(self.serial.run(f"cat {LINK_DIR}/rc 2>/dev/null"))
            if r and seen is None:
                seen = r
                print(f"          ended {float(r[1]) - cut_up:.1f}s after the cut, with the link still down (rc {r[0]})")
        rest_up, back = self.restore()
        print(f"          link restored {rest_up - cut_up:.1f}s after the cut; address, default route and the endpoint back in {back:.1f}s")
        if seen:
            return seen
        deadline = self.t_cut + LINK_HANG
        while time.time() < deadline:
            r = self.rc_line(self.dev.run(f"cat {LINK_DIR}/rc 2>/dev/null", check=False))
            if r:
                return r
            time.sleep(2)
        return None

    def finish_or_kill(self):
        """After a hang verdict: the link is back, so let the run finish --
        the VM has to be clean for the next cell -- and kill its process
        group only when even that does not end it."""
        deadline = time.time() + LINK_GIVE_UP
        while time.time() < deadline:
            r = self.rc_line(self.dev.run(f"cat {LINK_DIR}/rc 2>/dev/null", check=False))
            if r:
                print(f"          (it finished on its own {time.time() - self.t_cut:.0f}s after the cut, rc {r[0]})")
                return r
            time.sleep(5)
        pid = self.dev.run(f"cat {LINK_DIR}/pid 2>/dev/null", check=False).strip()
        self.dev.run(f"kill -TERM -- -{pid} 2>/dev/null; sleep 2; kill -KILL -- -{pid} 2>/dev/null; true", check=False)
        print(f"          (killed process group {pid} {time.time() - self.t_cut:.0f}s after the cut; it never ended)")
        return None

    # -- what the receiving side holds ----------------------------------------
    def fingerprint(self, side):
        """{relpath: (size, sha256)} on the receiving side. Content, not
        size: rclone's local backend -- the QA server's store -- preallocates
        a file to its full length when the upload starts, so a PUT whose tail
        never arrived reads as whole by size (LINK5, 2026-09-09)."""
        kind, where = side
        if kind == "cloud":
            out = {}
            for rel, size in backend_sizes(where).items():
                data = backend_bytes(f"{where}/{rel}")
                out[rel] = (size, sha(data) if data is not None else None)
            return out
        raw = self.dev.run(f"cd {shlex.quote(where)} 2>/dev/null && find . -type f | while read -r f; do "
                           f"printf '%s %s %s\n' \"$(stat -c %s \"$f\")\" \"$(sha256sum \"$f\" | cut -d' ' -f1)\" \"$f\"; done; true",
                           check=False)
        out = {}
        for line in raw.splitlines():
            parts = line.split(" ", 2)
            if len(parts) == 3 and parts[0].isdigit() and parts[2].startswith("./"):
                out[parts[2][2:]] = (int(parts[0]), parts[1])
        return out

    def settle(self, side):
        """The receiving side's fingerprints once they have stopped changing:
        the server keeps taking bytes already in the buffers after the client
        is gone, and a comparison taken mid-drain reads as truncation."""
        last = self.fingerprint(side)
        for _ in range(40):
            time.sleep(3)
            now = self.fingerprint(side)
            if now == last:
                return now
            last = now
        return last

    def endpoint_quiet(self, limit=180):
        """Wait until the QA WebDAV server has finished taking the cut run's
        upload. The guest forgets the socket the moment rclone gives up, but
        QEMU's user-mode stack has already accepted the whole body and keeps
        feeding it to the server, which holds the destination file open and
        writes it to disk at the throttled rate -- and returns `423 Locked`
        to any PUT of that path meanwhile (proven on the host, 2026-09-09:
        fd open and one CLOSE-WAIT socket for the ~60 s a 16 MiB body takes at
        200k, PUT of the same name 423 throughout, 201 the instant the fd
        closed). So the ESTABLISHED socket clearing is not enough; wait for
        the server to hold no open fd under its data directory. WebDAV only
        -- a real provider resets an aborted PUT and has no such drain, and
        the check reads a local rclone serve's /proc. Returns how long it
        took."""
        if backend("backend").strip() != "webdav":
            return 0.0
        data = backend("path").strip()
        state = os.path.dirname(data)
        try:
            pid = open(os.path.join(state, "webdav.pid")).read().strip()
        except OSError:
            pid = ""
        port = self.hostport.rsplit(":", 1)[-1]
        t = time.time()
        while time.time() - t < limit:
            socks = subprocess.run(["ss", "-Htn", f"( sport = :{port} )"], capture_output=True, text=True).stdout
            busy = any(st in socks for st in ("ESTAB", "CLOSE-WAIT"))
            fds = "0"
            if pid:
                fds = subprocess.run(["bash", "-c", f"ls -l /proc/{pid}/fd 2>/dev/null | grep -c {shlex.quote(data)} || true"],
                                     capture_output=True, text=True).stdout.strip()
            if not busy and fds in ("0", ""):
                break
            time.sleep(2)
        return time.time() - t

    def stamps(self):
        out = self.dev.run(f"cd {CACHE} 2>/dev/null && for s in {' '.join(LINK_STAMPS)} settings-backup.uploaded; do "
                           f"printf '%s=%s\\n' \"$s\" \"$(cat $s 2>/dev/null)\"; done; true", check=False)
        return dict(line.split("=", 1) for line in out.splitlines() if "=" in line)

    # -- one cell -------------------------------------------------------------
    def keep(self, key, rerun_out):
        """Keep the cell's evidence: the detached run's out/rc/pid move to
        /tmp/qa-link-<KEY>/ on the guest (reset() wipes /tmp/qa-link for the
        next cell), the re-run's output beside them, and copies of both under
        --dump on the host when it is given. A FAIL with no output file is a
        FAIL nobody can read."""
        keep_dir = f"{LINK_DIR}-{key}"
        self.dev.write(f"{keep_dir}/rerun.out", rerun_out.encode())
        self.dev.run(f"cp {LINK_DIR}/out {LINK_DIR}/rc {LINK_DIR}/pid {keep_dir}/ 2>/dev/null; true", check=False)
        where = f"{keep_dir}/ on the guest"
        if self.args.dump:
            host_dir = os.path.join(self.args.dump, key)
            os.makedirs(host_dir, exist_ok=True)
            for name in ("out", "rc", "rerun.out"):
                data = self.dev.run(f"cat {keep_dir}/{name} 2>/dev/null; true", check=False)
                open(os.path.join(host_dir, name), "w").write(data)
            where += f", {host_dir}/ here"
        print(f"          outputs kept: {where}")

    def exercise(self, key, cmd, marker, receiving, sources, stamps, env="", rerun=None, verify=None, upload_marker=False):
        """Start `cmd` detached, cut at `marker`, restore after
        restore_after seconds, and assert the contract. `receiving` is
        ("cloud", endpoint path) or ("device", directory) -- where the
        operation writes; `sources` maps each file it moves to (size, sha256);
        `stamps` names the last-* files it may write. `verify(out)` replaces
        the file comparison after the re-run for an operation that moves
        nothing (the scan). Returns the number of failed checks."""
        f = 0
        before = self.stamps()
        self.start(cmd, env)
        landed, out = self.wait_marker(marker)
        if not landed:
            rc = self.rc_line(self.status()[1])
            return f + (not check(False, "", f"the run ended (rc {rc[0] if rc else '?'}) before the cut could land; "
                                            f"last line: {out.strip().splitlines()[-1][:100] if out.strip() else 'none'}"))
        cut_up = self.cut()
        where = out.strip().splitlines()[-1].strip()[:90] if out.strip() else "no output yet"
        print(f"          cut {self.iface} at guest uptime {cut_up:.2f} ({time.strftime('%H:%M:%S')}); last line: {where!r}")
        r = self.wait_exit(cut_up)
        hung = r is None
        if hung:
            f += not check(False, "", f"HANG: the run had not ended {LINK_HANG}s after the cut (bound {LINK_BOUND}s); "
                                      f"link restored {self.restore_after}s after it")
            r = self.finish_or_kill()
        if r:
            rc, tte = int(r[0]), float(r[1]) - cut_up
            if not hung:
                why = ("" if tte <= LINK_BOUND else
                       f": past the {LINK_BOUND}s bound" + (" -- it rode the outage out on rclone's defaults and completed once TCP retransmitted"
                                                            if rc == 0 else ""))
                f += not check(tte <= LINK_BOUND, f"ended {tte:.1f}s after the cut (bound {LINK_BOUND}s)",
                               f"ended {tte:.1f}s after the cut{why}")
            if rc == 69:
                what = "exit 69: SKIPPED - NO NETWORK CONNECTION, the sentinel"
            elif rc == 0 and tte < self.restore_after:
                what = f"exit 0 {tte:.1f}s after the cut, with the link still down: a success reported for a run that could not reach the cloud"
            elif rc == 0:
                what = (f"exit 0 {tte:.1f}s after the cut: a success reported for a run the network left -- it waited "
                        f"the {self.restore_after:.0f}s outage out on rclone's default timeouts instead of ending within its own bound")
            elif rc == 75:
                what = "exit 75: the lock sentinel, for a run nothing else held the lock against"
            else:
                what = f"exit {rc}: a plain failure"
            f += not check(rc == 69 or rc not in (0, 75), what, what)
        else:
            rc, tte = None, None
        # The receiving side, once quiet: nothing under a temporary name, and
        # nothing under a final name that is not the whole file.
        got = self.settle(receiving) if receiving else {}
        if receiving:
            partials = sorted(r for r in got if ".partial" in r)
            f += not check(not partials, "no *.partial left on the receiving side",
                           f"partial files left on the receiving side: {partials}")
            there = [r for r in got if r in sources]
            broken = {r: f"{got[r][0]} of {sources[r][0]} bytes{'' if got[r][0] != sources[r][0] else ', content differs'}"
                      for r in there if got[r] != sources[r]}
            f += not check(not broken, f"every file present on the receiving side is whole, by content ({len(there)} of {len(sources)} there)",
                           f"under a final name but not the file: {broken}")
        after = self.stamps()
        for s in stamps:
            if after.get(s, "") == before.get(s, ""):
                check(True, f"{s} unchanged ({after.get(s) or 'absent'})", "")
                continue
            parts = after.get(s, "").split()
            code = parts[1] if len(parts) == 2 else "?"
            f += not check(code not in ("0", "?"), f"{s} records the failure ({after.get(s)})",
                           f"{s} records success ({after.get(s)}) for a run the network left")
        if upload_marker:
            m0, m1 = before.get("settings-backup.uploaded", ""), after.get("settings-backup.uploaded", "")
            complete = all(got.get(r) == src for r, src in sources.items())
            f += not check(m1 == m0 or complete,
                           "settings-backup.uploaded unchanged" if m1 == m0 else "settings-backup.uploaded moved, and the archive is whole in the cloud",
                           f"settings-backup.uploaded moved ({m0 or 'absent'} -> {m1}) though the archive is not whole in the cloud")
        # The plain re-run, with the link back -- once the endpoint has let go
        # of the cut run. rclone gave up, but what it had already written is
        # still in flight: the guest kernel's orphaned socket, and behind it
        # QEMU's user-mode stack, which took LINK5's whole 16.5 MiB archive in
        # under a second and delivers it to the server at the server's pace
        # long after the guest has forgotten the socket. A second PUT of the
        # same name meanwhile gets `423 Locked` from rclone serve webdav
        # (2026-09-09, twice). A handheld buffers a few MiB at most
        # (tcp_wmem), so its window is seconds; it is printed here because it
        # is real, and a retry right after the link returns can fall into it.
        waited = self.endpoint_quiet()
        if waited > 2:
            print(f"          waited {waited:.0f}s for the endpoint to let go of the cut run before the re-run")
        # The re-run. On this QA server one case needs tolerating: the cut
        # run's copyto delivered the whole archive body through QEMU's slirp
        # buffer even as rclone reported failure (the receiving-side check
        # above finds it whole), and rclone serve webdav then holds that dated
        # filename's lock for a moment -- a PUT of the SAME name gets `423
        # Locked`. A real provider resets an aborted PUT and has no such lock;
        # this is the fixture, so retry only on that exact signature, only on
        # WebDAV, and say so. A genuine re-run failure carries no "423 Locked"
        # and is reported at once.
        webdav = backend("backend").strip() == "webdav"
        mark = log_mark(self.dev)
        rc2, out2 = run_rc(self.dev, rerun or cmd, env)
        self.keep(key, out2)
        # What the card and the page had to show for the cut run: its whole
        # stdout (re-read now that it has ended; `out` stopped at the cut) and
        # its exit. The vocabulary gate (#105, D-UI-028) judges that.
        f += assert_message(self.status()[0], rc, self.args.vocabulary, label="the cut run: ")
        # rclone's "423 Locked" goes to the --log-file, not to stdout, so the
        # log is where a lock shows. One case on this backend is not a script
        # fault and not the harness's to pass off as one: when the operation
        # re-PUTs a file under the SAME name (the settings archive), the QA
        # WebDAV server can still be holding that name's lock. The cut run's
        # copyto delivered the whole body through QEMU's slirp buffer -- which
        # is why the post-cut "whole in the cloud" check above passed -- but
        # rclone serve webdav keeps the PUT open, waiting for a request body
        # that never finishes (the guest's rclone exited with the link down,
        # so slirp never sees the connection close), and refuses a second PUT
        # of that name with 423 for as long as it waits. Both faces are the
        # same slirp artifact: on a real provider an aborted PUT leaves
        # nothing, and the re-run genuinely re-uploads and succeeds. So where
        # the archive is already whole and correct in the cloud and the only
        # thing stopping the re-run is that lock, this criterion is SKIPPED
        # with the reason, not FAILED -- and it wants MinIO/S3 or a real
        # provider to be asserted, which this run notes.
        locked = webdav and rc2 != 0 and "423 Locked" in log_since(self.dev, mark)
        archive_whole = receiving and all(got.get(r) == src for r, src in sources.items())
        telling = [l for l in out2.splitlines() if re.search(r"ERROR|WARN|Failed|failed|exit", l)]
        last = (telling or out2.strip().splitlines() or ["no output"])[-1].strip()[:160]
        if locked and archive_whole:
            print("    SKIP  the re-run is refused by the QA WebDAV server's stale-PUT lock (423 Locked) on the same "
                  "archive name -- a slirp artifact, not the script; the archive is already whole in the cloud. "
                  "Assert idempotency on MinIO/S3 or a real provider.")
        else:
            f += not check(rc2 == 0, "a plain re-run with the link back exits 0", f"the re-run exits {rc2}: {last!r}")
        if verify:
            ok, msg = verify(out2)
            f += not check(ok, msg, msg)
        elif receiving:
            got2 = self.settle(receiving)
            bad = [r for r in sources if got2.get(r) != sources[r]]
            f += not check(not bad, f"after the re-run all {len(sources)} files match on the receiving side",
                           f"after the re-run these do not match on the receiving side: {bad}")
        return f


# -- the cells -----------------------------------------------------------------

def link_files(prefix, n=LINK_FILES, ext="bin"):
    return {f"{prefix}{i}.{ext}": os.urandom(LINK_MIB * 1024 * 1024) for i in range(1, n + 1)}


def srcmap(files):
    """{rel: bytes} -> {rel: (size, sha256)}, what exercise compares against."""
    return {rel: (len(data), sha(data)) for rel, data in files.items()}


def fx_link1(L):
    """Saves restore, the startup sync's command, cut during the compare:
    everything already in the cloud, nothing to move, the listing in flight."""
    files = {f"saves/sys{d:02d}/game{g}.srm": f"save {d}-{g}".encode() for d in range(1, 25) for g in (1, 2)}
    L.plant_device(L.root, files)
    rc, out = run_rc(L.dev, "cloud_backup --yes --saves-only")
    if rc != 0 or len(backend_sizes(epath(L.saves_remote))) < len(files):
        raise Fail(f"seeding the cloud with the saves failed (rc {rc}); cannot stage a compare")
    print(f"          {len(files)} saves in 24 directories on both sides; RCLONE_TPSLIMIT={LINK_TPS} makes the compare last")
    return L.exercise("LINK1", "cloud_restore --yes --method=copy --update --saves-only", LINK_MARKER_CHECKS,
                      ("device", L.root), srcmap(files), ["last-restore"], env=f"RCLONE_TPSLIMIT={LINK_TPS}")


def fx_link2(L):
    """Saves backup, cut during the transfer."""
    files = link_files("savestates/link-", ext="state")
    L.plant_device(L.root, files)
    return L.exercise("LINK2", "cloud_backup --yes --saves-only", LINK_MARKER_FILE,
                      ("cloud", epath(L.saves_remote)), srcmap(files), ["last-backup"])


def fx_link3(L):
    """ROMs and BIOS back up a system, cut during the transfer."""
    croot = L.content_dir()
    files = link_files("link-")
    L.plant_device(croot, files)
    return L.exercise("LINK3", f"cloud_content_backup {shlex.quote(CONTENT_DIR)}", LINK_MARKER_FILE,
                      ("cloud", f"{epath(L.content_remote)}/ROMs/{CONTENT_DIR}"), srcmap(files), ["last-content-backup"])


def fx_link4(L):
    """ROMs and BIOS restore a system, cut during the transfer."""
    croot = L.content_dir()
    files = link_files("link-")
    L.plant_cloud(files, f"{epath(L.content_remote)}/ROMs/{CONTENT_DIR}")
    return L.exercise("LINK4", f"cloud_content_restore {shlex.quote(CONTENT_DIR)}", LINK_MARKER_FILE,
                      ("device", croot), srcmap(files), ["last-content-restore"])


def fx_link5(L):
    """The settings archive -- backuptool's own, then cloud_backup
    --system-only -- cut mid-upload. The upload marker must not move unless
    the archive completed."""
    broot = f"{L.root}/backup"
    rc, out = run_rc(L.dev, "backuptool backup")
    names = L.dev.run(f"cd {shlex.quote(broot)} 2>/dev/null && ls *.tar.gz *.zip 2>/dev/null; true", check=False).split()
    if rc != 0 or not names:
        raise Fail(f"backuptool backup wrote no archive under {broot} (rc {rc}): {out.strip().splitlines()[-1][:120] if out.strip() else ''}")
    name = names[0]
    size = int(L.dev.run(f"stat -c %s {shlex.quote(f'{broot}/{name}')}").strip())
    digest = L.dev.sha(f"{broot}/{name}")
    print(f"          archive {name}, {size / 1048576:.1f} MiB")
    folder = L.dev.run("cloud_device_id 2>/dev/null || true").strip()
    if not folder:
        raise Fail("cloud_device_id printed nothing; cannot name the archive's cloud folder")
    # The marker says what this device last sent and where; without it this
    # run wants to send the archive, which is the point of the cell.
    L.dev.run(f"rm -f {CACHE}/settings-backup.uploaded", check=False)
    return L.exercise("LINK5", "cloud_backup --yes --system-only", LINK_MARKER_FILE,
                      ("cloud", f"{epath(L.settings_remote)}/{folder}"), {name: (size, digest)},
                      ["last-settings-backup"], upload_marker=True)


def fx_link6(L):
    """The exit sync -- cloud_backup --yes --saves-only --recent -- cut
    during the transfer. A stamp of success before it, so --recent takes its
    filtered path."""
    files = link_files("savestates/link-", ext="state")
    L.plant_device(L.root, files)
    L.dev.run(f"mkdir -p {CACHE}; printf '%s 0\\n' $(( $(date +%s) - 600 )) > {CACHE}/last-backup")
    return L.exercise("LINK6", "cloud_backup --yes --saves-only --recent", LINK_MARKER_FILE,
                      ("cloud", epath(L.saves_remote)), srcmap(files), ["last-backup"])


def fx_link7(L):
    """The picker scan, cut mid-scan. Twenty-four systems and BIOS in the
    cloud, the listing paced to two transactions a second; the scan prints
    nothing until it is done, so the cut lands once it holds a connection.
    The re-run must name every planted system."""
    systems = [f"sys{d:02d}" for d in range(1, 25)]
    cloud = {f"ROMs/{s}/game.bin": f"rom {s}".encode() for s in systems}
    cloud["BIOS/bios.bin"] = b"bios"
    L.plant_cloud(cloud, epath(L.content_remote))

    def verify(out):
        names = {line.split("|")[0] for line in out.splitlines() if "|" in line}
        missing = sorted(set(systems + ["bios"]) - names)
        return (not missing, f"the re-run's scan names all {len(systems)} systems and bios"
                if not missing else f"the re-run's scan is missing {missing}")
    return L.exercise("LINK7", "cloud_content_restore --scan", None, None, {}, ["last-content-match", "last-content-restore"],
                      env=f"RCLONE_TPSLIMIT={LINK_TPS}", verify=verify)


LINK_FIXTURES = [
    ("LINK1", "saves restore (the startup sync's command), link cut during the compare", fx_link1),
    ("LINK2", "saves backup, link cut during the transfer", fx_link2),
    ("LINK3", "ROMs and BIOS backup, link cut during the transfer", fx_link3),
    ("LINK4", "ROMs and BIOS restore, link cut during the transfer", fx_link4),
    ("LINK5", "settings archive upload (backuptool backup; cloud_backup --system-only), link cut mid-upload", fx_link5),
    ("LINK6", "the exit sync (cloud_backup --yes --saves-only --recent), link cut during the transfer", fx_link6),
    ("LINK7", "the picker scan (cloud_content_restore --scan), link cut mid-scan", fx_link7),
]


def run_link(dev, root, remote, args, settings, serial, only):
    """The link-loss cells on one device (#103). Every cell resets the
    scratch tree and the endpoint first; the cache directory (stamps, upload
    marker, saves-root record) is carried across and put back, as run_pair
    does."""
    step("the link-loss cells: a serial console, a throttled endpoint, one guest")
    if args.real_roms:
        raise Fail("the link-loss cells empty the saves root between cells; they never run against real ROMs")
    if not check(backend_throttled(), "the endpoint is throttled (--bwlimit on the server)",
                 "the endpoint is not throttled: nine MiB cross the loopback before the transfer can be cut -- "
                 "`tools/cloud-test-backend down && CLOUD_QA_BWLIMIT=200k tools/cloud-test-backend up` (WebDAV only)"):
        return 1
    L = Link(dev, serial, root, remote, settings, args)
    L.assert_same_guest()
    check(True, f"the serial console is this device's; its default route runs over {L.iface}; the endpoint is {L.hostport}", "")
    print(f"    link restored {L.restore_after}s after each cut; a run must end within {LINK_BOUND}s of it")
    failures = 0
    had = snapshot_cache(dev)
    try:
        for key, title, fn in LINK_FIXTURES:
            if only and key not in only:
                continue
            step(f"{key} -- {title}")
            L.reset()
            try:
                failures += fn(L)
                failures += litter_scan(dev, settings, remote, label=f"{key}: ")
            except Fail as e:
                failures += 1
                print(f"    FAIL  {e}")
                # A Fail mid-cell may have left the link down, or a run going.
                try:
                    L.serial.run(f"ip link set {L.iface} up")
                    running = L.dev.run(f"[ -e {LINK_DIR}/pid ] && [ ! -e {LINK_DIR}/rc ] && echo yes || true",
                                        check=False).strip() == "yes"
                    if running:
                        L.finish_or_kill()
                except Fail as e2:
                    print(f"    WARN  could not tidy after the failure: {e2}", file=sys.stderr)
    finally:
        L.reset()
        restore_cache(dev, had)
    return failures


# ===========================================================================
# #105: a writer killed at every step, and the power cut (D-CLOUD-077/078/079)
# ===========================================================================
#
# D-CLOUD-078 asks every writer three things, in order: know that you
# succeeded; replace the old state only after that; remove the superseded
# record once, so exactly one last-known-good exists at rest. The rule in
# engineering-practices.md says how to test it: kill the writer at every step
# and assert the previous state is what remains. These cells do that, each
# against the shipped scripts and the running EmulationStation, and each was
# first committed with its failing output (the harness's rule).
#
# Four mechanisms, chosen per step (docs/audits/2026_09_10-graceful-
# degradation/kill-fixtures-design.md):
#
# * PG@marker -- SIGKILL (or SIGTERM) the detached run's process group when a
#   regex matches its stdout: rclone's per-file progress line, so the kill
#   lands mid-transfer (LINK's wait_marker).
# * watcher -- a guest-side script polling a filesystem condition every 20 ms
#   and killing the group the moment it holds. For a window inside one long
#   binary (tar over 20k files, gzip over 64 MiB) where no line is printed.
#   It is a file, not a pkill pattern, because of the self-match lesson.
# * shim -- a bash function of a command's name, exported so it wins over
#   PATH in every bash the run starts. backuptool and cloud_content_restore
#   source /etc/profile, which puts /usr/bin first, so a --path-prefix
#   directory is not enough; an exported function survives that (bash
#   imports BASH_FUNC_* on start, proven on the guest). set_setting is a
#   function of the calling shell, so its override is defined in that shell
#   after the profile is sourced.
# * plant -- the torn state written directly, standing for a kill inside a
#   builtin or a single write() syscall that no external signal lands in
#   deterministically. Labelled as such in the PASS/FAIL text.
# * reset -- HMP `system_reset` over QEMU's monitor: every dirty page in the
#   guest is gone, the disk holds exactly what the guest issued. It models a
#   battery dying. It cannot model an SD card's write cache or FTL, which is
#   what the RG SP's truncated system.cfg (#102) may have been; that is what
#   the VM cannot prove, and the cells say so.
#
# The record's name follows D-CLOUD-079, not the design's draft: the
# last-known-good copy of system.cfg keeps its name, `system.cfg.backup`, and
# es_settings.cfg gains `es_settings.cfg.backup`. The scans accept
# `.last-good` too, so a build carrying either name is judged on the rule.

import socket
import xml.etree.ElementTree as ET

