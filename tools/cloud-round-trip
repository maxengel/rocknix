            time.sleep(1)
            es = L.dev.run(f"cat {ES_SETTINGS} 2>/dev/null || true", check=False)
            parsed = parse_es(es)
            kept = parsed is not None and all(parsed.get(k) == v for k, v in marker_es.items())
            print(f"          ({shape}) es_log.txt mentions the parse error {parse_err} time(s) (Settings load before the log opens); "
                  f"a record {'exists' if rec else 'does not exist'}")
            f += not check(kept, f"({shape}) after boot and one save es_settings.cfg carries the last known good settings",
                           f"({shape}) after boot and one save es_settings.cfg is "
                           f"{'DEFAULTS: ' + str(len(parsed)) + ' key(s), the planted ones gone' if parsed is not None else 'unparsable'} "
                           "-- Settings.cpp:512-518 logs and continues on defaults, and the next save writes them over the torn file (D-CLOUD-079: restore from .backup)")
    finally:
        L.restore_configs(had)
    return f


def fx_kill15(L):
    """KILL15: `cloud_saves_root record` writes its one-line record in place
    (`echo >`, a builtin: no external kill lands in it), so the torn state is
    planted -- an empty saves-root. Asserted: `check` REFUSES an empty record
    (with the accept instruction), because `-s` false reads today as "no
    record" and the #83 guard is silently off (FAIL, fails open); the refusal
    text carries no CLI name (assert_message)."""
    f = 0
    rec = L.dev.run(f"cat {CACHE}/saves-root 2>/dev/null || true", check=False)
    if not rec.strip():
        rc0, _ = run_rc(L.dev, "cloud_saves_root record")
        rec = L.dev.run(f"cat {CACHE}/saves-root 2>/dev/null || true", check=False)
        if not rec.strip():
            raise Fail(f"cloud_saves_root record wrote no record (rc {rc0})")
    L.cleanups.append(lambda: L.dev.write(f"{CACHE}/saves-root", rec.encode()))
    L.dev.run(f"mkdir -p {CACHE}; : > {CACHE}/saves-root")
    rc, out = run_rc(L.dev, "cloud_saves_root check")
    f += not check(rc != 0, "an empty saves-root record is refused (exit 1) rather than read as none",
                   f"cloud_saves_root check exited {rc} on an EMPTY record: the #83 guard fails open (cloud_saves_root:109 tests -s)")
    f += assert_message(out, rc, L.args.vocabulary, label="check: ")
    rc2, out2 = run_rc(L.dev, "cloud_saves_root record")
    now = L.dev.run(f"cat {CACHE}/saves-root 2>/dev/null || true", check=False).strip()
    f += not check(rc2 == 0 and now == rec.strip(), f"record rewrites the identity ({now})", f"record (rc {rc2}) left {now!r}, expected {rec.strip()!r}")
    temps = L.dev.run(f"ls {CACHE}/saves-root.* {CACHE}/.saves-root* 2>/dev/null; true", check=False).split()
    f += not check(not temps, "no saves-root temp left", f"temps left: {temps}")
    return f


