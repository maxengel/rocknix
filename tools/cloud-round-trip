        print("    -- arm B: torn es_settings.cfg planted, power cut, then one page open/close to make ES save")
        for shape, body in (("empty", b""), ("cut inside a tag", es_s0.encode()[: int(len(es_s0) * 0.6)])):
            L.dev.write(ES_SETTINGS, body)
            L.dev.run("sync")
            L.power_cut()
            parse_err = L.count_in(ES_LOG, ES_PARSE_ERROR)
            rec = L.dev.run(f"for r in {ES_SETTINGS}.backup {ES_SETTINGS}.last-good; do [ -e $r ] && cat $r && break; done; true", check=False)
            mon = Monitor(L.monitor_path)
            try:
                run_walk(mon, steps_without_toggle(steps))   # to the page's last row, no toggle
                mon.sendkey("z")                # close: the save
                time.sleep(2)
