KILL_NEEDS_TEXT = {"backend": "QA endpoint", "minio": "MinIO", "serial": "serial", "monitor": "monitor"}




def run_kill(dev, root, remote, args, settings, serial, only, local_only):
    """The KILL cells on one device (#105). Each cell resets the scratch tree
    (and the endpoint, when there is one) first; the cache directory is
    carried across and put back, from a snapshot on /storage because a power
    cut empties /tmp. A cell whose channel is missing is skipped with a line
    naming it; the set never is."""
    step("the KILL cells: a writer killed at every step, the power cut, one record at rest (#105, D-CLOUD-078)")
    if args.real_roms:
        raise Fail("the KILL cells empty the saves root and the settings archives between cells; they never run against real ROMs")
    serial_ok = serial is not None and serial.usable()
    try:
        monitor_ok = stat.S_ISSOCK(os.stat(args.monitor_socket).st_mode)
    except OSError:
        monitor_ok = False
    throttled = (not local_only) and backend_throttled()
    L = Kill(dev, serial if serial_ok else None, root, remote, settings, args, monitor_path=args.monitor_socket, endpoint=not local_only)
    print(f"    device {L.device_id or 'no id'} ({L.label or 'no label'}); endpoint {'none (local cells only)' if local_only else L.hostport + (' throttled' if throttled else ' NOT throttled')}; "
          f"serial {'yes' if serial_ok else 'no'}; monitor {'yes' if monitor_ok else 'no'}")
    failures = 0
    had = snapshot_cache(dev, where="/storage/.cache/qa-kill-cache.tgz")
    try:
        for key, title, fn, needs in KILL_FIXTURES:
            if only and key not in only:
                continue
            missing = []
            if "backend" in needs and local_only:
                missing.append("the QA endpoint (this run prepared the device locally)")
            elif "backend" in needs and not throttled:
                missing.append("a throttled endpoint: `tools/cloud-test-backend down && CLOUD_QA_BWLIMIT=200k tools/cloud-test-backend up`")
            if "serial" in needs and not serial_ok:
                missing.append(f"a serial console at {args.serial_socket}")
            if "monitor" in needs and not monitor_ok:
                missing.append(f"a monitor socket at {args.monitor_socket} (--monitor-socket)")
            step(f"{key} -- {title}")
            if missing:
                print(f"    SKIP  {key} needs {'; '.join(missing)}")
                continue
            L.reset()
            L.cleanups = []
            t0 = time.time()
            try:
                failures += fn(L)
            except Fail as e:
                failures += 1
                print(f"    FAIL  {e}")
                try:
                    pgid = L.pid()
                    if pgid and L.group_pids(pgid):
                        L.dev.run(f"kill -KILL -- -{pgid} 2>/dev/null; true", check=False)
                except Fail:
                    pass
            failures += litter_scan(dev, settings, "" if local_only else remote, label=f"{key}: ")
            for c in L.cleanups:
                try:
                    c()
                except Fail as e:
                    print(f"    WARN  {key}: cleanup incomplete: {e}", file=sys.stderr)
            print(f"    ({key} took {time.time() - t0:.0f}s)")
    finally:
        L.reset()
        L.remove_scratch()
        dev.run(f"rm -rf {os.path.dirname(KILL_WATCH)}", check=False)
        restore_cache(dev, had, where="/storage/.cache/qa-kill-cache.tgz")
    return failures


def restore_device(p, args, archive):
    """Put the device back: its remote, its paths, the settings-restore
    option, the scratch tree, the fixture system -- on every exit. Its
    identity is not the harness's to touch: prepare never writes it (#91),
    and A11, which clones one on purpose, puts it back itself."""
    if args.keep:
        return
    dev, prev_paths, prev_rclone_conf = p.dev, p.prev_paths, p.prev_rclone_conf
    step(f"clean up {dev.host} port {dev.port}")
    try:
        dev.run(f"rm -f {shlex.quote(archive)}", check=False)
        # The settings-restore option is put back only when the suite saved
        # it: run_steps writes {CONF}.qa-prev, a --only run never does, and
        # "no saved value" is not "delete the device's line".
        if dev.run(f"[ -e {CONF}.qa-prev ] && echo yes || echo no", check=False).strip() == "yes":
            prev = dev.run(f"grep -m1 '^BACKUPFILE_RESTORE_OPTION=' {CONF}.qa-prev 2>/dev/null || true", check=False).strip()
            if prev:
                dev.run(f"sed -i 's|^BACKUPFILE_RESTORE_OPTION=.*|{prev}|' {CONF}", check=False)
            else:
                dev.run(f"sed -i '/^BACKUPFILE_RESTORE_OPTION=/d' {CONF}", check=False)
            dev.run(f"rm -f {CONF}.qa-prev", check=False)
        for key, line in prev_paths.items():
            if line:
                dev.run(f"sed -i 's|^{key}=.*|{line}|' {CONF}", check=False)
            else:
                dev.run(f"sed -i '/^{key}=/d' {CONF}", check=False)
        if not args.real_roms:
            # .away is where A9 and CAP8 park the root to test an unmounted
            # one; a Fail or a dropped ssh between the mv and its undo leaves
            # it behind, and nothing else knows the name.
            dev.run(f"rm -rf {shlex.quote(SCRATCH)} {shlex.quote(SCRATCH)}.away", check=False)
        if p.local_only:
            # A local prepare read no rclone.conf and created no content
            # fixture: putting back a blank remote would delete the device's
            # real one, and resetting the bucket would need a backend that
            # was never asked for.
            print("    scratch tree removed and the saves root put back; no remote or bucket was touched")
            return
        if not args.real_roms:
            dev.run(f"rm -rf /storage/roms/{shlex.quote(CONTENT_DIR)} /storage/roms/{shlex.quote(CONTENT_DIR)}-unselected", check=False)
        if prev_rclone_conf.strip():
            dev.write(RCLONE_CONF, prev_rclone_conf.encode())
        else:
            dev.run(f"rm -f {RCLONE_CONF}", check=False)
        backend("reset")
        print("    scratch tree and bucket emptied; the device's own remote, paths and "
              "settings-backup setting restored")
    except Fail as e:
        print(f"    WARN  clean-up incomplete: {e}", file=sys.stderr)

