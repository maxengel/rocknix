    exported `mkdir` function kills the group before the write, so the
    selection stands (PASS by construction). Plant arm: an empty file is a
    LEGAL answer ("none"), indistinguishable from a torn one by design, so
    the only fix is the writer: after `--set-systems a b` exactly two lines,
    no `content-systems.*` temp."""
    f = 0
    sel0 = L.dev.run(f"cat {CACHE}/content-systems 2>/dev/null || true", check=False)
    had = L.dev.run(f"[ -e {CACHE}/content-systems ] && echo yes || echo no", check=False).strip() == "yes"
    L.cleanups.append(lambda: (L.dev.write(f"{CACHE}/content-systems", sel0.encode()) if had
                               else L.dev.run(f"rm -f {CACHE}/content-systems", check=False)))
    rc0, _ = run_rc(L.dev, "cloud_content_restore --set-systems qa-a qa-b")
    if rc0 != 0:
        raise Fail(f"--set-systems qa-a qa-b exited {rc0}")
    prelude = Kill.shim("mkdir", 'case "$*" in *cloud_sync*) kill -KILL -- -$QA_PGID ;; esac; command mkdir "$@"')
    L.start("cloud_content_restore --set-systems qa-c qa-d", prelude=prelude, shell="bash")
    for _ in range(50):
        if not L.pid() or not L.group_pids(L.pid()):
            break
        time.sleep(0.1)
    sel = L.dev.run("cloud_content_restore --systems 2>/dev/null || true", check=False).split()
    f += not check(sel == ["qa-a", "qa-b"], "killed before the write (mkdir shim): the selection still reads qa-a qa-b",
                   f"the selection reads {sel} after a kill before the write")
    L.dev.run(f": > {CACHE}/content-systems")
    none = L.dev.run("cloud_content_restore --systems 2>/dev/null || true", check=False).split()
    print(f"          an empty file reads as {none or 'no systems'} -- legal by design (the picker's 'none'); a torn write is indistinguishable")
    rc2, out2 = run_rc(L.dev, "cloud_content_restore --set-systems qa-a qa-b")
    lines = [l for l in L.dev.run(f"cat {CACHE}/content-systems", check=False).splitlines() if l.strip()]
    temps = L.dev.run(f"ls {CACHE}/content-systems.* {CACHE}/.content-systems* 2>/dev/null; true", check=False).split()
    f += not check(rc2 == 0 and lines == ["qa-a", "qa-b"], "after --set-systems a b the file holds exactly those two lines",
                   f"after --set-systems (rc {rc2}) the file holds {lines}")
    f += not check(not temps, "no content-systems temp left", f"temps left: {temps}")
    return f


def fx_kill18(L):
    """KILL18: `backuptool restore` killed mid-`tar -xzf ... -C /`
    (backuptool:220). The archive holds a.cfg, then 20k small files, then
    b.cfg -- in that order -- so the watcher fires once a.cfg carries the
    archive's value while b.cfg is still live. Asserted: the tree is either
    wholly restored or as it was -- FAILS today (a.cfg from the archive, b.cfg
    live, half applied); the pre-restore state is kept somewhere (a
    PRE_RESTORE archive under archive/, D-CLOUD-078) -- FAILS today, kept
    nowhere; the re-run completes (its group is killed the moment the restore
    marker appears, before backuptool's `systemctl reboot`)."""
    f = 0
    L.make_scratch()
    had = L.snapshot_configs([RESTORE_PENDING, BACKUPTOOL_CONF])
    live = f"{L.root}/kill18-live"
    broot = L.backups
    try:
        L.dev.run(f"rm -rf {L.q(live)} {L.q(broot)}; mkdir -p {L.q(live)} {L.q(broot)}; "
                  f"echo LIVE > {L.q(live)}/a.cfg; echo LIVE > {L.q(live)}/b.cfg; rm -f {RESTORE_PENDING}")
        # The copy backuptool takes aside covers LOCATIONS, so the tree the
        # archive writes over has to be in them for the boot-time revert to
        # have anything to put back -- on a device the two are the same set.
        L.dev.write(BACKUPTOOL_CONF, f"LOCATIONS=(\n  {live}\n)\n".encode())
        rel = live.lstrip("/")
        stage = "/storage/cloud-qa-kill/stage18"
        name = f"2098_01_01-000000-{L.label + '-' if L.label else ''}{L.osn}_SETTINGS.tar.gz"
        L.dev.run(f"rm -rf {stage}; mkdir -p {stage}/{rel}; echo ARCHIVE > {stage}/{rel}/a.cfg; echo ARCHIVE > {stage}/{rel}/b.cfg; "
                  f"cp -r {KILL_SCRATCH}/many {stage}/{rel}/many; "
                  f"tar -czf {L.q(broot)}/{name} -C {stage} {rel}/a.cfg {rel}/many {rel}/b.cfg; rm -rf {stage}; sync")
        newest = L.finder()
        if os.path.basename(newest) != name:
            raise Fail(f"newest_backup finds {newest!r}, not the planted {name}")
        u_before = float(L.dev.run("cut -d' ' -f1 /proc/uptime").strip())
        cond = f"[ \"$(cat {shlex.quote(live)}/a.cfg 2>/dev/null)\" = ARCHIVE ] || [ -e {RESTORE_PENDING} ]"
        L.start("backuptool restore", shell="bash", watch=(cond, "KILL"))
        r = L.watch_result()
        a = L.dev.run(f"cat {L.q(live)}/a.cfg 2>/dev/null || true", check=False).strip()
        b = L.dev.run(f"cat {L.q(live)}/b.cfg 2>/dev/null || true", check=False).strip()
        many = L.dev.run(f"ls {L.q(live)}/many 2>/dev/null | wc -l", check=False).strip()
        pending = L.dev.run(f"[ -e {RESTORE_PENDING} ] && echo yes || echo no", check=False).strip() == "yes"
        f += not check(r[0] == "landed" and not pending, f"the kill landed mid-extract (a.cfg {a}, {many} of {KILL_MANY} small files, b.cfg {b})",
                       f"the kill did not land mid-extract: watcher {r}, restore marker {'set' if pending else 'unset'}")
        # tar writes over the live tree, so right after the kill the tree IS
        # half restored (a.cfg from the archive, b.cfg live); nothing running
        # can undo it. What must hold is that the copy taken aside exists and
        # that the next boot puts it back: backuptool leaves
        # .restore-in-progress naming the copy, and `chksysconfig verify`
        # (sysinit, rocknix-sysconfig.service) reads it. Run here as the boot
        # would (D-CLOUD-078; 2026-09-10).
        snap = L.dev.run(f"ls {L.q(broot)}/archive/ 2>/dev/null | grep -i 'PRE_RESTORE\\|pre-restore'; true", check=False).split()
        f += not check(bool(snap), f"the pre-restore state is kept ({snap}) while the tree is half restored (a.cfg {a}, b.cfg {b}, {many} of {KILL_MANY} files)",
                       "the pre-restore state is kept NOWHERE: a killed restore has nothing to revert to (D-CLOUD-078)")
        mark = L.dev.run("[ -e /storage/.config/.restore-in-progress ] && echo yes || echo no", check=False).strip()
        f += not check(mark == "yes", "the restore-in-progress marker names the copy for the next boot",
                       "no .restore-in-progress marker: the boot would not know a restore was cut off")
        L.dev.run(". /etc/profile >/dev/null 2>&1; chksysconfig verify >/dev/null 2>&1; true", check=False)
        a3 = L.dev.run(f"cat {L.q(live)}/a.cfg 2>/dev/null || true", check=False).strip()
        b3 = L.dev.run(f"cat {L.q(live)}/b.cfg 2>/dev/null || true", check=False).strip()
        said = L.dev.run("cat /storage/.config/.restore-reverted 2>/dev/null; rm -f /storage/.config/.restore-reverted", check=False).strip()
        mark2 = L.dev.run("[ -e /storage/.config/.restore-in-progress ] && echo yes || echo no", check=False).strip()
        f += not check((a3, b3) == ("LIVE", "LIVE") and said == "reverted" and mark2 == "no",
                       f"the boot-time check put the copy back (a.cfg {a3}, b.cfg {b3}), left 'reverted' for EmulationStation to say, and cleared the marker",
                       f"after chksysconfig verify: a.cfg {a3}, b.cfg {b3}; .restore-reverted {said!r}; marker {'still there' if mark2 == 'yes' else 'gone'}")
        u_now = float(L.dev.run("cut -d' ' -f1 /proc/uptime").strip())
        f += not check(u_now > u_before, "the guest did not reboot", "THE GUEST REBOOTED (backuptool restore's systemctl reboot ran)")
        # The re-run, stopped the instant its marker appears -- after tar,
        # before `sleep 5; systemctl reboot`.
        L.start("backuptool restore", shell="bash", watch=(f"[ -e {RESTORE_PENDING} ]", "KILL"))
        r2 = L.watch_result()
        out2 = L.dev.run(f"cat {LINK_DIR}/out 2>/dev/null || true", check=False)
        L.keep("KILL18", out2)
        a2 = L.dev.run(f"cat {L.q(live)}/a.cfg 2>/dev/null || true", check=False).strip()
        b2 = L.dev.run(f"cat {L.q(live)}/b.cfg 2>/dev/null || true", check=False).strip()
        f += not check(r2[0] == "landed" and (a2, b2) == ("ARCHIVE", "ARCHIVE"),
                       f"a re-run completes the restore (a.cfg {a2}, b.cfg {b2}; stopped before its reboot)",
                       f"the re-run left a.cfg {a2}, b.cfg {b2} (watcher {r2})")
        f += assert_message(out2, None, L.args.vocabulary, label="re-run: ")
    finally:
        L.dev.run(f"rm -f {RESTORE_PENDING}; rm -rf {L.q(live)}", check=False)
        L.restore_configs_quiet(had)
    return f


