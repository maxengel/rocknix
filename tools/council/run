#!/bin/bash
# Council runner: loads the provider keys from outside the repo and execs one
# of the council scripts (scaffold's export, at its own paths under scripts/;
# see .claude/skills/council/COUNCIL-BUNDLE.md). Keys live in
# ~/.config/council/env (0600) as export lines; they never appear on a command
# line or in shell history.
#
#   tools/council/run <command> <args…>
#
#   invoke    scripts/council-invoke.ts        one member, one prompt, one output + provenance
#   lint      scripts/lint-council-run.ts      completeness of a run directory, per step
#   start     scripts/council-run-start.ts     anchor a run's genesis (creates/pushes verification-anchors/<run_id>)
#   prompt    scripts/build-council-prompt.ts  compose a step prompt from the run manifest
#   seal      scripts/write-step-seal.ts       seal a completed step
#   summary   scripts/council-run-summary.ts   run-summary.{json,md} from the provenance siblings
#   verify-pins | verify-chain | verify-seals | efforts | drift
#   test      the toolchain, routing and seat-effort tests (no provider calls)
set -euo pipefail
HERE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT="$(cd "$HERE/../.." && pwd)"
ENV_FILE="${COUNCIL_ENV_FILE:-$HOME/.config/council/env}"
if [ -r "$ENV_FILE" ]; then
    mode="$(stat -c %a "$ENV_FILE")"
    if [ "$mode" != "600" ]; then
        echo "refusing: $ENV_FILE is mode $mode, expected 600" >&2; exit 2
    fi
    set -a; . "$ENV_FILE"; set +a
fi
TSX="$HERE/node_modules/.bin/tsx"
cmd="${1:-}"; shift || true
cd "$ROOT"
case "$cmd" in
    invoke)       s=council-invoke.ts ;;
    lint)         s=lint-council-run.ts ;;
    start)        s=council-run-start.ts ;;
    prompt)       s=build-council-prompt.ts ;;
    seal)         s=write-step-seal.ts ;;
    summary)      s=council-run-summary.ts ;;
    verify-pins)  s=verify-pins.ts ;;
    verify-chain) s=verify-chain.ts ;;
    verify-seals) s=verify-seals.ts ;;
    efforts)      s=lint-council-seat-efforts.ts ;;
    drift)        s=check-stale-blob-drift.ts ;;
    test)
        node --test scripts/council-toolchain.node-test.mjs
        "$TSX" --test scripts/__tests__/council-invoke-routing.node-test.ts
        node --test scripts/__tests__/lint-council-seat-efforts.node-test.ts
        exit 0 ;;
    *) sed -n '3,18p' "$0" >&2; exit 2 ;;
esac
exec "$TSX" "scripts/$s" "$@"
