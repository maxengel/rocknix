#
# Are the instruction files what instruction-files.md says they are?
#
#   tools/rules-check            # every check, one line each; exit 1 on any failure
#   tools/rules-check --quiet    # failures only (the push guard and the fork CI)
#   tools/rules-check --write-agents   # regenerate the rule list in AGENTS.md from the front matter
#
# Checks, each a thing that was found wrong on 2026-09-25 (#269, D-WORKFLOW-045):
#   front    every .claude/rules/*.md opens with front matter: `---`, a one-line
#            `description:` first, then an optional `paths:` list (with `#`
#            comments), then `---`; nothing before it. ceremonies.md had none.
#   always   a rule with no `paths:` says so in its first paragraph (the word
#            "session"), as the front-matter standard asks.
#   index    the index table in instruction-files.md names every file in the
#            directory and nothing that is not there. Three files were missing.
#   count    a sentence in CLAUDE.md or AGENTS.md that says "All N" of the rules
#            says the number the directory has. Both said 24 of 27.
#   agents   AGENTS.md and CLAUDE.md exist, and AGENTS.md is within Codex's
#            project-doc budget (32 KiB) so it is read whole.
#   list     the block between the rules-index markers in AGENTS.md is exactly
#            what --write-agents generates from the front matter (Codex loads
#            no rule on its own, so the list is how it learns they exist).
#   mention  every rule file is named in CLAUDE.md as well.
#
# The guard for the shape "an instruction file nobody can find is one nobody
# applies" (instruction-files.md § The index); run by tools/ceremony-check
# --gate and .github/workflows/fork-checks.yml.

import os
import re
import sys

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
RULES = os.path.join(ROOT, '.claude', 'rules')
INDEX = os.path.join(RULES, 'instruction-files.md')
CODEX_DOC_BUDGET = 32 * 1024
BEGIN = '<!-- rules-index:begin (generated by tools/rules-check --write-agents; do not edit by hand) -->'
END = '<!-- rules-index:end -->'


def rules_block(files):
    """The generated list: every-session rules first, then scoped, each with its description."""
    every, scoped = [], []
    for f in files:
        desc, paths, _, err = front_matter(os.path.join(RULES, f))
        if err:
            continue
        if paths is None or paths == ['**']:
            every.append((f, desc))
        else:
            scoped.append((f, desc, paths))
    out = ['**Every session** (no `paths:` glob, or `**`):', '']
    for f, d in every:
        out.append('- `%s` -- %s' % (f, d))
    out += ['', '**Scoped** (open before touching the paths):', '']
    for f, d, p in scoped:
        out.append('- `%s` -- %s (paths: %s)' % (f, d, ', '.join('`%s`' % x for x in p)))
    return '\n'.join(out)


def front_matter(path):
    """(description, paths_or_None, body_lines, error)."""
    lines = open(path, encoding='utf-8').read().split('\n')
    if not lines or lines[0].strip() != '---':
        return None, None, lines, 'no front matter (the file must open with ---)'
    if len(lines) < 2 or not lines[1].startswith('description:'):
        return None, None, lines, 'description is not the first key of the front matter'
    desc = lines[1][len('description:'):].strip().strip('"\'')
    i = 2
    paths = None
    while i < len(lines) and lines[i].strip() != '---':
        s = lines[i]
        if s.startswith('paths:'):
            paths = []
        elif s.strip().startswith('#'):
            pass
        elif s.startswith('  - ') or s.startswith('- '):
            if paths is None:
                return desc, None, lines, 'a list item outside paths: in the front matter'
            paths.append(s.strip()[2:].strip('"\''))
        elif s.strip() == '':
            pass
        else:
            return desc, paths, lines, 'front matter line is not description/paths/comment: %r' % s[:60]
        i += 1
    if i >= len(lines):
        return desc, paths, lines, 'front matter never closes'
    if not desc:
        return desc, paths, lines, 'description is empty'
    if paths is not None and not paths:
        return desc, paths, lines, 'paths: is present but lists nothing'
    return desc, paths, lines[i + 1:], None


def first_paragraph(body):
    out = []
    started = False
    for l in body:
        if not started:
            if l.strip() == '' or l.startswith('#'):
                continue
            started = True
        if l.strip() == '':
            break
        out.append(l)
    return ' '.join(out)


def main():
    quiet = '--quiet' in sys.argv
    fails = []
    notes = []

    def ok(msg):
        if not quiet:
            print('ok    ' + msg)

    def fail(msg):
        fails.append(msg)
        print('FAIL  ' + msg)

    files = sorted(f for f in os.listdir(RULES) if f.endswith('.md'))
    # front + always
    for f in files:
        desc, paths, body, err = front_matter(os.path.join(RULES, f))
        if err:
            fail('front   %s: %s' % (f, err))
            continue
        ok('front   %s' % f)
        if paths is None:
            para = first_paragraph(body).lower()
            if 'session' not in para:
                fail('always  %s has no paths: and its first paragraph does not say it loads every session' % f)
            else:
                ok('always  %s says it loads every session' % f)
    # index
    text = open(INDEX, encoding='utf-8').read()
    m = re.search(r'^## The index\n(.*?)^## ', text, re.S | re.M)
    section = m.group(1) if m else ''
    rows = re.findall(r'^\| `([a-z0-9-]+\.md)` \|', section, re.M)
    listed = set(rows)
    have = set(files)
    for f in sorted(have - listed):
        fail('index   %s is in .claude/rules/ and not in the index table of instruction-files.md' % f)
    for f in sorted(listed - have):
        fail('index   the index names %s, which is not in .claude/rules/' % f)
    dup = sorted(r for r in listed if rows.count(r) > 1)
    for f in dup:
        fail('index   %s appears twice in the index' % f)
    if have == listed and not dup:
        ok('index   %d files, %d rows, the same set' % (len(have), len(rows)))
    # count
    for name in ('CLAUDE.md', 'AGENTS.md'):
        p = os.path.join(ROOT, name)
        if not os.path.exists(p):
            fail('agents  %s is missing' % name)
            continue
        t = open(p, encoding='utf-8').read()
        for n in re.findall(r'\bAll (\d+)(?: of them|,)', t):
            if int(n) != len(files):
                fail('count   %s says "All %s" of the rules; the directory holds %d' % (name, n, len(files)))
            else:
                ok('count   %s says All %s, and there are %d' % (name, n, len(files)))
        if name == 'AGENTS.md':
            size = os.path.getsize(p)
            if size > CODEX_DOC_BUDGET:
                fail('agents  AGENTS.md is %d bytes, over the %d-byte project-doc budget Codex reads whole' % (size, CODEX_DOC_BUDGET))
            else:
                ok('agents  AGENTS.md is %d bytes (budget %d)' % (size, CODEX_DOC_BUDGET))
    # list: the generated block in AGENTS.md
    ap = os.path.join(ROOT, 'AGENTS.md')
    if os.path.exists(ap):
        t = open(ap, encoding='utf-8').read()
        want = rules_block(files)
        if BEGIN in t and END in t:
            head, rest = t.split(BEGIN, 1)
            cur, tail = rest.split(END, 1)
            if '--write-agents' in sys.argv:
                open(ap, 'w', encoding='utf-8').write(head + BEGIN + '\n' + want + '\n' + END + tail)
                print('wrote the rule list into AGENTS.md (%d rules)' % len(files))
                cur = '\n' + want + '\n'
            if cur.strip('\n') != want:
                fail('list    the rule list in AGENTS.md is stale: run tools/rules-check --write-agents')
            else:
                ok('list    AGENTS.md carries the generated rule list')
        else:
            fail('list    AGENTS.md has no rules-index markers')
    # mention: CLAUDE.md names every rule too
    cp = os.path.join(ROOT, 'CLAUDE.md')
    if os.path.exists(cp):
        t = open(cp, encoding='utf-8').read()
        missing = [f for f in files if f[:-3] not in t]
        if missing:
            fail('mention CLAUDE.md does not name: %s' % ', '.join(missing))
        else:
            ok('mention CLAUDE.md names every rule')
    if fails:
        print('rules-check: %d failure(s)' % len(fails))
        return 1
    if not quiet:
        print('rules-check: %d rule files, every one front-mattered and indexed' % len(files))
    return 0


if __name__ == '__main__':
    sys.exit(main())
